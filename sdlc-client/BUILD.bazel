# The SDLC client (README.md): upstream legend-sdlc's records and lite's text routes (design S15), ONE
# typed client over a fetch, and the page's SDLC (design S21, level 0): sdlc-server's Java rules compiled
# to WebAssembly, behind an adapter that persists to IndexedDB. Plain TypeScript, no npm dependency.
load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")

js_library(
    name = "sdlc_client",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    visibility = ["//visibility:public"],
)

# The same suite against sdlc-server over HTTP, its repository then checked by git itself.
js_test(
    name = "server_test",
    size = "medium",
    chdir = package_name(),
    data = [
        ":sdlc_client",
        "test/conformance.ts",
        "test/server.test.ts",
        "//sdlc-server:server",
    ],
    entry_point = "test/server.test.ts",
    node_options = [
        "--experimental-strip-types",
        "--disable-warning=ExperimentalWarning",
        "--test-reporter=spec",
        "--test-reporter-destination=stdout",
    ],
)

# The one suite against the page's SDLC: sdlc-server's rules in WebAssembly (//sdlc-server:page).
js_test(
    name = "wasm_test",
    size = "small",
    chdir = package_name(),
    data = [
        ":sdlc_client",
        "test/conformance.ts",
        "test/wasm.test.ts",
        "//sdlc-server:page",
    ],
    entry_point = "test/wasm.test.ts",
    node_options = [
        "--experimental-strip-types",
        "--experimental-wasm-exnref",
        "--disable-warning=ExperimentalWarning",
        "--test-reporter=spec",
        "--test-reporter-destination=stdout",
    ],
)

# every test here: the local gate and CI run it (gates/BUILD.bazel)
test_suite(
    name = "tests",
    tests = [
        ":server_test",
        ":wasm_test",
    ],
)
