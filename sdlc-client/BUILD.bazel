# The SDLC client (README.md): upstream legend-sdlc's records and lite's text routes (design S15), ONE
# typed client over a fetch, and the page's SDLC (design S21, level 0): sdlc-server's Java rules compiled
# to WebAssembly, behind an adapter that persists to IndexedDB. Plain TypeScript, no npm dependency.
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/guards:defs.bzl", "guards_package")
load("//tools/js:defs.bzl", "node_test")
load("//tools/runfiles:defs.bzl", "executable_of")

js_library(
    name = "sdlc_client",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    visibility = ["//visibility:public"],
)

# The same suite against sdlc-server over HTTP, started here over a fresh repository.
node_test(
    name = "server_test",
    size = "medium",
    data = [
        ":sdlc_client",
        ":sdlc_server",
        ":server_helper",
        "test/conformance.ts",
        "test/server.test.ts",
        "//sdlc-server:server",
    ],
    entry_point = "test/server.test.ts",
    env = {"SDLC_SERVER": "$(rlocationpath :sdlc_server)"},
)

# The one suite against the page's SDLC: sdlc-server's rules in WebAssembly (//sdlc-server:page).
node_test(
    name = "wasm_test",
    size = "small",
    data = [
        ":sdlc_client",
        "test/conformance.ts",
        "test/wasm.test.ts",
        "//sdlc-server:page_dir",
    ],
    entry_point = "test/wasm.test.ts",
    env = {"SDLC_PAGE": "$(rlocationpath //sdlc-server:page_dir)"},
    node_options = ["--experimental-wasm-exnref"],  # the flag only: this test loads the SDLC page, not the planner
)

# sdlc-server's launcher, exactly one file, for a test to start by runfiles path (SDLC_SERVER; Bazel workplan P1-24)
executable_of(
    name = "sdlc_server",
    testonly = True,
    binary = "//sdlc-server:server",
    visibility = [
        "//depot-client:__pkg__",
        "//studio:__pkg__",
    ],
)

# Starting and stopping that server in a test: here, depot-client's server_test and studio's verify_test
js_library(
    name = "server_helper",
    testonly = True,
    srcs = ["test/sdlc-server.ts"],
    visibility = [
        "//depot-client:__pkg__",
        "//studio:__pkg__",
    ],
)

# every test here: the local gate and CI run it (gates/BUILD.bazel)
test_suite(
    name = "tests",
    tests = [
        ":server_test",
        ":wasm_test",
    ],
)

guards_package()
