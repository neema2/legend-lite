_LANE_LEDGER = "src/test/java/org/finos/legend/lite/pct/Test_LegendLite_%s_%sFunctions_PCT.java"

[junit_test(
    name = "pct_channel_b_%s_%s" % (lane, s.lower()),
    memory_mb = 2048,
    data = [_LANE_LEDGER % (cls, s)] + [_LANE_MANIFEST % (d, d, d, s) for d in ([] if db == None else [db])] + data,
    env = {"LEGENDLITE_PCT_BACKEND": lane},
    env_inherit = inherit,
    jvm_flags = [
        "-Dpct.suite.%s=$(rlocationpath %s)" % (s, _LANE_LEDGER % (cls, s)),
    ] + ["-Dpct.oracle.%s=$(rlocationpath %s)" % (s, _LANE_MANIFEST % (d, d, d, s)) for d in ([] if db == None else [db])] + flags,
    select = ["--select-class=org.finos.legend.lite.pct.channelb.ChannelB%sTest" % s],
    tags = tags,
    target_compatible_with = compat,
    upstream = True,
    runtime_deps = [":pct_tests_lib"] + deps,
) for lane, (cls, suites, db, data, flags, deps, tags, inherit, compat) in _CHANNEL_B_LANES.items() for s in suites]

[test_suite(
    name = "pct_channel_b_" + lane,
    tags = ["manual"],
    tests = [":pct_channel_b_%s_%s" % (lane, s.lower()) for s in suites],
) for lane, (_, suites, _, _, _, _, _, _, _) in _CHANNEL_B_LANES.items()]

# PCT'S MEASURED RATCHET VALUES (PctRatchets; Bazel workplan P2-16, D9): each Channel B suite's discovery count,
# measured by running the suite into ratchets.tsv. Manual, at the suites' cost (the platform compiled per suite); the
# Channel B tests compare their live discovery with the committed copy, so gate 9 fails when it is stale.
java_run(
    name = "ratchets",
    testonly = True,
    srcs = UPSTREAM_TREES,
    outs = ["generated/ratchets.tsv"],
    arguments = ["{OUT}"],
    jvm_flags = program_jvm_flags("pct"),
    main_class = "org.finos.legend.lite.pct.channelb.PctRatchets",
    memory_mb = 2048,
    mnemonic = "Generate",
    roots = UPSTREAM_ROOTS,
    tags = ["manual"],
    deps = [
        ":pct_tests_lib",
        "//core:drivers",
    ],
)

write_source_files(
    name = "update_ratchets",
    testonly = True,
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nA Channel B discovery count moved -- bazel run //pct:update_ratchets, with the reason in the commit",
    files = {"src/test/resources/org/finos/legend/lite/pct/channelb/ratchets.tsv": ":ratchets"},
    tags = ["manual"],
    # //:update_generated runs it too (a bump moves discovery); its diff test stays manual, gate 9 holds the file
    visibility = ["//:__pkg__"],
)

guards_package()
