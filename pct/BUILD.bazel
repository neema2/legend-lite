# pct — Pure Compatibility Testing: legend-engine's PCT framework runs the engine's
# own function tests (Pure) through legend-lite, via an adapter written in Pure
# (src/main/resources) and a native bridge in Java (src/test/java/.../extension).
# Every upstream jar is a TEST input from @maven_upstream: core never sees one.

load("//tools/junit:defs.bzl", "junit_test")
load("//tools/java:defs.bzl", "legend_java_library")
load("//tools/mariadb:defs.bzl", "EMBEDDED_MARIADB_COMPATIBLE")
load("//tools/mysql:defs.bzl", "EMBEDDED_MYSQL_COMPATIBLE")
load("//tools/clickhouse:defs.bzl", "EMBEDDED_CLICKHOUSE_COMPATIBLE")
load("//tools/postgres:defs.bzl", "EMBEDDED_POSTGRES_COMPATIBLE")
load("//tools/mongodb:defs.bzl", "EMBEDDED_MONGODB_COMPATIBLE")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/generators:defs.bzl", "UPSTREAM_ROOTS", "UPSTREAM_TREES", "program_jvm_flags")
load("//tools/java_run:defs.bzl", "java_run")
load("//tools/guards:defs.bzl", "guards_package")
load("//tools/jars:defs.bzl", "file_list")

# sources exported for the guard tests that walk every module
filegroup(
    name = "srcs",
    srcs = glob(["src/**"]),
    visibility = ["//core:__pkg__", "//parser-equivalence:__pkg__"],
)

# the test sources as files: parser-equivalence's own corpus is the Pure snippets they embed (InlineSnippets reads
# src/test/**/*.java and nothing else; Bazel workplan P3-07)
filegroup(
    name = "test_java",
    srcs = glob(["src/test/**/*.java"]),
    visibility = ["//parser-equivalence:__pkg__"],
)

# THE ADAPTER'S PAR: the Pure adapter compiled against the engine's platform, the
# form the interpreted runtime loads it in (it refuses to start without it). What
# legend-pure-maven-generation-par's build-pure-jar goal did, by the same call —
# //tools/par.
_DEFINITION = "src/main/resources/core_legend_lite_pct.definition.json"

java_run(
    name = "adapter_par",
    testonly = True,
    srcs = glob(["src/main/resources/**"]),
    outs = ["pure-core_legend_lite_pct.par"],
    arguments = [
        "core_legend_lite_pct",
        "$(execpath %s)" % _DEFINITION,
        "{SRC}",
        "{OUT}",
    ],
    main_class = "com.legend.tools.par.ParGenerator",
    # peaks at 2,099 MB live (-Xlog:gc, macOS arm64, 2026-10-04)
    memory_mb = 4096,
    mnemonic = "PureParGenerator",
    roots = {_DEFINITION: "{SRC}"},
    deps = ["//tools/par:par_generator"],
)

# the adapter on the classpath: its Pure source and definition, and its PAR at
# the classpath root, where the runtime looks it up by name
legend_java_library(
    name = "adapter",
    testonly = True,
    resources = glob(["src/main/resources/**"]),
    runtime_deps = [":adapter_par_jar"],
)

legend_java_library(
    name = "adapter_par_jar",
    testonly = True,
    resources = [":adapter_par"],
    resource_strip_prefix = package_name(),
)

legend_java_library(
    name = "pct_tests_lib",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    testonly = True,
    # PctDisciplineTest is :pct_discipline's alone (a source scan with no PCT runtime)
    srcs = glob(
        ["src/test/java/**/*.java"],
        exclude = ["src/test/java/org/finos/legend/lite/pct/PctDisciplineTest.java"],
    ),
    resources = glob(["src/test/resources/**"]),
    runtime_deps = [
        "//core:shadow_binding",
        ":adapter",
        # the three function universes and their interpreted natives
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_runtime_java_extension_interpreted_functions_relation",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_runtime_java_extension_interpreted_functions_standard",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_runtime_java_extension_interpreted_functions_unclassified",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_runtime_java_extension_interpreted_dsl_tds",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m2_dsl_tds_pure",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_runtime_java_engine_compiled",
    ],
    deps = [
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_functions_unclassified_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_functions_standard_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_functions_relation_pure",
        "//core",
        "//core:test_backends",
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
        "@maven_upstream//:junit_junit",
        "@maven_upstream//:org_eclipse_collections_eclipse_collections",
        "@maven_upstream//:org_eclipse_collections_eclipse_collections_api",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_test_framework",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m3_core",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m4",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_runtime_java_engine_interpreted",
    ],
)

_SUITES = [
    "Essential",
    "Grammar",
    "Relation",
    "Standard",
    "Unclassified",
]

# GATE 6 — the five PCT suites on DuckDB, ONE JVM PER SUITE (Bazel workplan P3-09, D2, D6): each suite is judged on
# its own traffic (PctCensusGate's per-suite ceilings), so its verdict does not depend on which suites share its JVM.
# The composite lane (all five and the discipline guard in one JVM, 9 GB) is gone; the label is a suite.
# memory_mb 4096, not the rule's 4352 (live peak 2878 MB, the relation suite, measured 2026-10-04): CI's 7 GB macOS runner runs this
# lane, and ran it green at -Xmx4g from 2026-09-23 to 2026-10-04 (Bazel workplan P1-21).
[junit_test(
    name = "pct_duckdb_" + s.lower(),
    memory_mb = 4096,
    select = ["--select-class=org.finos.legend.lite.pct.Test_LegendLite_%sFunctions_PCT" % s],
    runtime_deps = [
        ":pct_tests_lib",
        "//core:drivers",
    ],
) for s in _SUITES]

# the module's discipline guard (no comparison machinery in Java), in gate 6 (G-02)
# its own library, so the light //gates:local does not build the PCT adapter's 4 GB PAR to run a source scan
# the module's files, as the discipline scan reads them: a declared list (SourceFiles; Bazel workplan P3-27b)
file_list(
    name = "discipline_sources",
    testonly = True,
    srcs = [":srcs"],
)

junit_test(
    name = "pct_discipline",
    memory_mb = 768,
    size = "small",
    srcs = ["src/test/java/org/finos/legend/lite/pct/PctDisciplineTest.java"],
    # a source scan: it reads the whole module, by its declared list (whose files ride in its runfiles)
    data = [":discipline_sources"],
    jvm_flags = ["-Dlegend.sources=$(rlocationpath :discipline_sources)"],
    select = ["--select-class=org.finos.legend.lite.pct.PctDisciplineTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

test_suite(
    name = "pct_duckdb",
    tests = [":pct_duckdb_" + s.lower() for s in _SUITES] + [":pct_discipline"],
)

# GATE 7 — the relation suite on H2 2.4.240 (LEGENDLITE_PCT_BACKEND=h2 selects
# the H2 execution dialect), with H2's OWN expected failures: every failing test
# named and pinned by its message in Test_LegendLite_H2_RelationFunctions_PCT —
# legend-engine's shape — so a fix, or a failure swapping for another, fails the
# run. Given the modern H2 and NO other: two H2s on one classpath would be a
# coin toss.
# memory_mb 4096, not the rule's 4864 (live peak 3180 MB, measured 2026-10-04): CI's 7 GB macOS runner runs this
# lane, and ran it green at -Xmx4g from 2026-09-23 to 2026-10-04 (Bazel workplan P1-21).
junit_test(
    name = "pct_h2",
    memory_mb = 4096,
    env = {"LEGENDLITE_PCT_BACKEND": "h2"},
    select = ["--select-class=org.finos.legend.lite.pct.Test_LegendLite_H2_RelationFunctions_PCT"],
    runtime_deps = [
        ":pct_tests_lib",
        "@h2_modern//jar",
    ],
)

# GATE 7P — the five suites on POSTGRES 16 (leg P2; LEGENDLITE_PCT_BACKEND=postgres selects the
# Postgres execution dialect), on a real server this JVM starts from the pinned binaries Bazel unpacked
# (@embedded_postgres, //testing EmbeddedPostgres): no Docker. Each suite carries Postgres's OWN expected
# failures (Test_LegendLite_Postgres_*Functions_PCT), legend-engine's shape, as gate 7's H2: a fix, or a
# failure swapping for another, fails the run. Postgres's JDBC driver comes as every lane's driver does:
# //core:drivers, the product's own driver set, so no second copy of any jar.
_POSTGRES_DATA = [
    "@embedded_postgres//:postgres",
    "@embedded_postgres//:pg/PG_ROOT",
]

_POSTGRES_FLAGS = ["-Dembedded.postgres.root=$(rlocationpath @embedded_postgres//:pg/PG_ROOT)"]

_POSTGRES_DEPS = [
    ":pct_tests_lib",
    "//core:drivers",
]

# ONE JVM PER SUITE (Bazel workplan P3-09), as gate 6; the label is a suite.
# memory_mb 4096, not the rule's 4352 (live peak 2874 MB, the relation suite, measured 2026-10-04): CI's 7 GB macOS runner runs this
# lane, and ran it green at -Xmx4g from 2026-09-23 to 2026-10-04 (Bazel workplan P1-21).
[junit_test(
    name = "pct_postgres_" + s.lower(),
    memory_mb = 4096,
    data = _POSTGRES_DATA,
    env = {"LEGENDLITE_PCT_BACKEND": "postgres"},
    jvm_flags = _POSTGRES_FLAGS,
    select = ["--select-class=org.finos.legend.lite.pct.Test_LegendLite_Postgres_%sFunctions_PCT" % s],
    runtime_deps = _POSTGRES_DEPS,
    target_compatible_with = EMBEDDED_POSTGRES_COMPATIBLE,
) for s in _SUITES]

test_suite(
    name = "pct_postgres",
    tests = [":pct_postgres_" + s.lower() for s in _SUITES],
)

# THE SQLITE LANES — the five suites on SQLite (LEGENDLITE_PCT_BACKEND=sqlite), in-process and in memory through the
# product's own driver (//core:drivers), with SQLite's OWN expected failures (Test_LegendLite_SQLite_*Functions_PCT),
# as gate 7P's. Manual, in //gates:heavy (docs/CLOUD_BACKENDS_PCT_2026_10_11.md §12): a per-push lane is the user's
