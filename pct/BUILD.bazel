    tags = ["manual"],
    runtime_deps = [
        ":pct_tests_lib",
        "//core:drivers",
    ],
) for s in _SUITES]

test_suite(
    name = "pct_sqlite",
    tags = ["manual"],
    tests = [":pct_sqlite_" + s.lower() for s in _SUITES],
)

