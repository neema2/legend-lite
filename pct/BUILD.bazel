# THE CLOUD LANES — the five suites on a real Databricks, Snowflake and BigQuery account
# (docs/CLOUD_BACKENDS_PCT_2026_10_11.md; LEGENDLITE_PCT_BACKEND selects the cloud). Each suite carries the cloud's
# OWN expected failures (Test_LegendLite_<Cloud>_*Functions_PCT), as gate 7P's. The account's coordinates and
# credentials come from the properties file LEGENDLITE_PCT_CLOUD_PROPERTIES names, inherited from the caller's
# environment and never written into the repository or an action's key. So every target is:
#   manual    -- out of //... and //gates:local: it needs an account, and a run costs money;
#   external  -- never cached: its verdict is the account's, today;
#   local     -- no sandbox and no remote execution: it reads that file and reaches the warehouse.
# Their drivers are product jars used by this package alone until the server opens these databases. Arrow (both
# Databricks' and Snowflake's result format) reads direct buffers, which JDK 17+ opens only on request.
_CLOUD_DRIVERS = {
    "bigquery": "@bigquery_jdbc//jar",
    "databricks": "@databricks_jdbc//jar",
    "snowflake": "@snowflake_jdbc//jar",
}

_CLOUD_CLASSES = {
    "bigquery": "BigQuery",
    "databricks": "Databricks",
    "snowflake": "Snowflake",
}

[junit_test(
    name = "pct_%s_%s" % (cloud, s.lower()),
    memory_mb = 4096,
    env = {"LEGENDLITE_PCT_BACKEND": cloud},
    env_inherit = ["LEGENDLITE_PCT_CLOUD_PROPERTIES"],
    jvm_flags = ["--add-opens=java.base/java.nio=ALL-UNNAMED"],
    select = ["--select-class=org.finos.legend.lite.pct.Test_LegendLite_%s_%sFunctions_PCT" % (_CLOUD_CLASSES[cloud], s)],
    tags = [
        "external",
        "local",
        "manual",
    ],
    runtime_deps = [
        ":pct_tests_lib",
        "//core:drivers",
        driver,
    ],
) for cloud, driver in _CLOUD_DRIVERS.items() for s in _SUITES]

[test_suite(
    name = "pct_" + cloud,
    tags = ["manual"],
    tests = [":pct_%s_%s" % (cloud, s.lower()) for s in _SUITES],
) for cloud in _CLOUD_DRIVERS]

# GATE 9 — channel B: lite's own compiler runs the PCT sources straight from the
# pinned legend-pure / legend-engine trees, and its verdicts are diffed against
# channel A's ledgers and the engine's manifests.
# The engine's own DuckDB manifests at the pinned release, read from the pinned tree (Bazel workplan P2-11; they were
# vendored snapshots of 2026-08-06, 943d38b3).
_ENGINE_MANIFEST = "@legend_engine_src//:legend-engine-xts-relationalStore/legend-engine-xt-relationalStore-dbExtension/legend-engine-xt-relationalStore-duckdb/legend-engine-xt-relationalStore-duckdb-PCT/src/main/resources/pct-manifests/relational-duckdb/%sFunctions_manifest.json"

# ONE JVM PER CLASS (Bazel workplan P3-09, A17), as the suites: a channel B verdict does not depend on which classes
# share its JVM; the label is a suite.
[junit_test(
    name = "pct_channel_b_" + s.lower(),
    memory_mb = 768,
    # exactly what it reads as files: its suite's PCT class and oracle manifest (Bazel workplan P3-07)
    data = [
        "src/test/java/org/finos/legend/lite/pct/Test_LegendLite_%sFunctions_PCT.java" % s,
        _ENGINE_MANIFEST % s,
    ],
    # its suite's PCT class and oracle manifest, by runfiles path (Bazel workplan P1-05)
    jvm_flags = [
        "-Dpct.suite.%s=$(rlocationpath src/test/java/org/finos/legend/lite/pct/Test_LegendLite_%sFunctions_PCT.java)" % (s, s),
        "-Dpct.oracle.%s=$(rlocationpath %s)" % (s, _ENGINE_MANIFEST % s),
    ],
    select = ["--select-class=org.finos.legend.lite.pct.channelb.ChannelB%sTest" % s],
    upstream = True,
    runtime_deps = [
        ":pct_tests_lib",
        "//core:drivers",
    ],
) for s in _SUITES]

test_suite(
    name = "pct_channel_b",
    tests = [":pct_channel_b_" + s.lower() for s in _SUITES],
)

# CHANNEL B ON EVERY LANE (2026-10-11, the user's ask): the same runner on each database a channel A lane runs on
# (LEGENDLITE_PCT_BACKEND, PctBackend), diffed against THAT lane's channel A ledger and, where legend-engine publishes
# one, its PCT manifest for the same database (none for SQLite, MariaDB, MySQL or BigQuery). Each lane is judged by its
# own measured numbers (channelb.ChannelBLane). Each target carries what its channel A lane carries: the server Bazel
# unpacked, the driver, the cloud's properties file. Manual, as their channel A lanes: the server lanes in
# //gates:heavy, the cloud lanes outside every gate (a run needs the account and costs money).
_LANE_MANIFEST = "@legend_engine_src//:legend-engine-xts-relationalStore/legend-engine-xt-relationalStore-dbExtension/legend-engine-xt-relationalStore-%s/legend-engine-xt-relationalStore-%s-PCT/src/main/resources/pct-manifests/relational-%s/%sFunctions_manifest.json"

_CLOUD_TAGS = [
    "external",
    "local",
    "manual",
]

# lane -> (its ledger classes' name, its suites, the engine's manifest directory or None, data, jvm_flags, deps, tags,
# env_inherit, target_compatible_with)
