<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.legend</groupId>
        <artifactId>legend-lite</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>legend-lite-pct</artifactId>
    <packaging>jar</packaging>
    <name>Legend Lite - PCT</name>
    <description>Pure Compatibility Testing for Legend Lite using legend-engine's PCT framework.</description>

    <properties>
        <!-- direct pin beats core's transitive 2.1.214: run the modern
             profile with -Dh2.version=2.4.240 (PV4) -->
        <h2.version>2.1.214</h2.version>
        <!-- ONE JVM PER SUITE, or one for all five? A PCT suite's Pure graph
             is a 2.0-2.8 GB live set it never releases, so five suites in one
             fork stack past 8 GB. That is fatal on the macOS CI runner, which
             has 3 vCPU and 7 GB TOTAL (GitHub-hosted arm64 spec; ubuntu and
             windows have 16 GB), and it is why the shared fork died with
             OutOfMemoryError in the Pure graph loader at both 3 GB and 4 GB.
             It is NOT a problem on a developer machine with room to spare, and
             the isolation costs ~15s of JVM starts and graph reloads.
             So: SHARED by default (local speed), and CI sets
             -Dpct.reuseForks=false to buy the isolation it actually needs.
             Validating the CI envelope locally means passing that flag too —
             see docs/GATES.md. -->
        <pct.reuseForks>true</pct.reuseForks>
        <!-- legend.engine.version / legend.pure.version come from the ROOT
             pom (one release, tools/oracle-pins.env): the PCT jars here are
             the SAME release the source checkouts pin, so channel A (jars,
             gates 6/7) and channel B (checkout walk, gate 9) referee ONE
             universe. 4.133.0/5.88.0 until 2026-09-10 — 7 tests apart. -->
        <eclipse.collections.version>10.2.0</eclipse.collections.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Legend-Lite Engine (the code we're testing) -->
        <dependency>
            <groupId>com.legend</groupId>
            <artifactId>legend-lite-core</artifactId>
        </dependency>

        <!-- Legend Pure M3/M4 core -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-m3-core</artifactId>
            <version>${legend.pure.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-m4</artifactId>
            <version>${legend.pure.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- PCT Framework -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-runtime-java-engine-compiled</artifactId>
            <version>${legend.pure.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Legend Engine Test Framework -->
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-test-framework</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ReportScopes (PCT test definitions for relation functions) -->
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-pure-functions-relation-pure</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>
        
        <!-- Standard Functions ReportScope -->
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-pure-functions-standard-pure</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>
        
        <!-- Unclassified Functions ReportScope -->
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-pure-functions-unclassified-pure</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Interpreted Runtime (for native function registration) -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-runtime-java-engine-interpreted</artifactId>
            <version>${legend.pure.version}</version>
            <scope>test</scope>
        </dependency>
        
        <!-- m3-core test-jar (provides PureTestBuilderInterpreted) -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-m3-core</artifactId>
            <version>${legend.pure.version}</version>
            <scope>test</scope>
            <type>test-jar</type>
        </dependency>
        
        <!-- Interpreted relation function extensions -->
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-pure-runtime-java-extension-interpreted-functions-relation</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>
        
        <!-- Interpreted standard function extensions -->
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-pure-runtime-java-extension-interpreted-functions-standard</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>
        
        <!-- Interpreted unclassified function extensions -->
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-pure-runtime-java-extension-interpreted-functions-unclassified</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>
        
        <!-- TDS DSL Interpreted Extension (provides stringToTDS native function) -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-runtime-java-extension-interpreted-dsl-tds</artifactId>
            <version>${legend.pure.version}</version>
            <scope>test</scope>
        </dependency>
        
        <!-- TDS DSL Pure definitions (provides stringToTDS Pure signature) -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-m2-dsl-tds-pure</artifactId>
            <version>${legend.pure.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Eclipse Collections -->
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections</artifactId>
            <version>${eclipse.collections.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections-api</artifactId>
            <version>${eclipse.collections.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 4 (required by PCT framework); version managed by the root
             pom at the engine release's own junit (INV-5) -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compile Pure code to PAR format for interpreted runtime -->
            <plugin>
                <groupId>org.finos.legend.pure</groupId>
                <artifactId>legend-pure-maven-generation-par</artifactId>
                <version>${legend.pure.version}</version>
                <configuration>
                    <sourceDirectory>${project.basedir}/src/main/resources</sourceDirectory>
                    <purePlatformVersion>${legend.pure.version}</purePlatformVersion>
                    <repositories>
                        <repository>core_legend_lite_pct</repository>
                    </repositories>
                    <extraRepositories>
                        <extraRepository>${project.basedir}/src/main/resources/core_legend_lite_pct.definition.json</extraRepository>
                    </extraRepositories>
                </configuration>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>build-pure-jar</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.finos.legend.engine</groupId>
                        <artifactId>legend-engine-pure-code-compiled-core</artifactId>
                        <version>${legend.engine.version}</version>
                    </dependency>
                    <!-- TDS DSL Pure (provides stringToTDS) -->
                    <dependency>
                        <groupId>org.finos.legend.pure</groupId>
                        <artifactId>legend-pure-m2-dsl-tds-pure</artifactId>
                        <version>${legend.pure.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useSystemClassLoader>false</useSystemClassLoader>
                    <!-- see the pct.reuseForks property above: shared by
                         default, per-suite in CI where 7 GB of macOS runner
                         cannot hold five Pure graphs at once -->
                    <reuseForks>${pct.reuseForks}</reuseForks>
                    <!-- PCT failures FAIL the build: known divergences are
                         LEDGERED as expectedFailures pins (reference-adapter
                         parity), never swallowed here. -->
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
