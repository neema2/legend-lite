load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//core:stress.bzl", "LINKED_PROJECTS", "STRESS_GENERATED")
load("//tools/guards:defs.bzl", "guards_package")

# THE STRESS-CORPUS GENERATORS (spike S5). Ten committed files in
# core/src/test/resources/stress are their outputs; //core:update_stress_corpus writes them
# back and diff-tests them. Every input is declared: the hand-written stress sources
# (//core:stress_sources -- the generated eleven excluded), the linked projects, and the
# hand-written queries 92 is generated from.

# Every corpus module: the gates' library (the generators run on their own closures, below). Stdlib only, except
# zoneinfo's data.
py_library(
    name = "corpus",
    srcs = [
        "aggregate.py",
        "aggregates.py",
        "battery.py",
        "combos.py",
        "deepstack.py",
        "dense_mapping.py",
        "dense_store.py",
        "density.py",
        "emit.py",
        "emptiness.py",
        "exactmath.py",
        "executed.py",
        "expand.py",
        "flat.py",
        "functest.py",
        "graphs.py",
        "hier.py",
        "intraday.py",
        "literals.py",
        "model.py",
        "oracle.py",
        "partition.py",
        "quarantine.py",
        "query.py",
        "rhs.py",
        "seed.py",
        "selective.py",
        "spines.py",
        "spread.py",
        "stacking.py",
        "stacks.py",
        "taxonomy.py",
        "tomany.py",
        "views.py",
    ],
    # the modules import each other by bare name (`import model`)
    imports = ["."],
    # oracle's convertTimeZone reads zoneinfo; the action empties PYTHONTZPATH so the zone
    # data is this pinned package, never the machine's /usr/share/zoneinfo
    deps = ["@pypi//tzdata"],
)

# Each generator's own import closure (function-local imports included), so editing a module reruns only the
# generators that import it. The gates below keep :corpus (their own closures are 12 to 24 modules; narrowing them is
# later work).
_BUILD_MODULES = [
    "aggregate",
    "aggregates",
    "battery",
    "combos",
    "deepstack",
    "density",
    "emit",
    "emptiness",
    "exactmath",
    "executed",
    "expand",
    "flat",
    "functest",
    "graphs",
    "hier",
    "intraday",
    "literals",
    "model",
    "oracle",
    "partition",
    "quarantine",
    "query",
    "rhs",
    "seed",
    "selective",
    "spines",
    "spread",
    "stacking",
    "stacks",
    "taxonomy",
    "tomany",
    "views",
]

_DENSE_MODULES = [
    "aggregate",
    "aggregates",
    "battery",
    "combos",
    "deepstack",
    "dense_mapping",
    "dense_store",
    "emptiness",
    "exactmath",
    "expand",
    "flat",
    "graphs",
    "literals",
    "model",
    "oracle",
    "partition",
    "query",
    "rhs",
    "seed",
    "selective",
    "spines",
    "stacks",
    "views",
]

_DIFFERENTIAL_MODULES = [
    "aggregate",
    "aggregates",
    "battery",
    "combos",
    "deepstack",
    "emptiness",
    "exactmath",
    "expand",
    "flat",
    "graphs",
    "literals",
    "model",
    "oracle",
    "partition",
    "quarantine",
    "query",
    "rhs",
    "seed",
    "selective",
    "spines",
    "stacks",
    "views",
]

[py_library(
    name = name,
    srcs = [m + ".py" for m in modules],
    imports = ["."],
    deps = ["@pypi//tzdata"],
) for name, modules in [
    ("corpus_build", _BUILD_MODULES),
    ("corpus_dense", _DENSE_MODULES),
    ("corpus_differential", _DIFFERENTIAL_MODULES),
]]

py_binary(
    name = "build",
    srcs = ["build.py"],
    deps = [":corpus_build"],
)

py_binary(
    name = "differential",
    srcs = ["differential.py"],
    deps = [":corpus_differential"],
)

py_binary(
    name = "dense_build",
    srcs = ["dense_build.py"],
    deps = [":corpus_dense"],
)

# The action environment: the root is the execroot (declared inputs only), zone data from the
# pinned tzdata package, and a fixed hash seed so no set order can reach the output.
_ENV = {
    "CORPUS_ROOT": ".",
    # the layout as core/stress.bzl gives it NOW (not the committed copy, which one update also rewrites)
    "STRESS_LAYOUT": "$(execpath //core:stress_layout)",
    # every text read is UTF-8 on every platform (Windows would otherwise decode as cp1252)
    "PYTHONUTF8": "1",
    "PYTHONHASHSEED": "0",
    "PYTHONTZPATH": "",
    "LC_ALL": "C.UTF-8",
}

# Only what the generators read (Bazel workplan P2-03): the queries, the layout, the hand-written stress files and
# the LINKED projects, not every project. The .pure files are also passed as --inputs, the only files read.
_LINKED = ["//projects:%s_files" % p for p in LINKED_PROJECTS]

_SOURCES = [
    "//core:stress_layout",
    "//core:stress_sources",
] + _LINKED

_DECLARED = ["--inputs", "$(execpaths //core:stress_sources)"] + ["$(execpaths %s)" % p for p in _LINKED]

# the generators' outputs, from the one list (core/stress.bzl)
DENSE = sorted([f for f, gen in STRESS_GENERATED.items() if gen == "dense"])

STRESS = sorted([f for f, gen in STRESS_GENERATED.items() if gen == "stress"])

run_binary(
    name = "gen_dense",
    # the dense builders never read the queries (only build.py's 92 does)
    srcs = _SOURCES,
    outs = ["dense/" + f for f in DENSE],
    args = [
        "--out",
        "$(RULEDIR)/dense",
    ] + _DECLARED,
    env = _ENV,
    tool = ":dense_build",
    visibility = ["//core:__pkg__"],
)

# build.py reads the dense generator's OUTPUTS, not the committed 59/60/64, so a dense change
# reaches 92-98 in the same update.
run_binary(
    name = "gen_stress",
    srcs = _SOURCES + [
        "queries.pure",
        ":gen_dense",
    ],
    outs = ["stress/" + f for f in STRESS],
    args = [
        "--dense",
        "$(RULEDIR)/dense",
        "--out",
        "$(RULEDIR)/stress",
    ] + _DECLARED,
    env = _ENV,
    tool = ":build",
    visibility = ["//core:__pkg__"],
)

# THE ONE TRADING MODEL AS ONE TEXT (docs/DEEPHAVEN_TRADER_DEMOS_2026_10_24.md DH34, on the Deephaven line; taken as it
# is for the timeseries' charts over classes, docs/DATACUBE_TIMESERIES_DESIGN_2026_10_25.md §11 Phase 6): what a page
# holds to plan the corpus's classes through stress::AllMapping -- the linked projects and the committed stress files
# (the generated ones included: their runtimes), in StressCorpus's order, without legend-lite's exclusions, the services
# or the test data.
py_binary(
    name = "trading_model_tool",
    srcs = ["trading_model.py"],
    main = "trading_model.py",
)

run_binary(
    name = "trading_model",
    srcs = [
        "//core:src/test/java/com/legend/integration/StressExclusions.java",
        "//core:src/test/resources/com/legend/integration/stress-layout.json",
        "//core:stress_files",
    ] + _LINKED,
    outs = ["trading-model.pure"],
    args = [
        "--out",
        "$(execpath trading-model.pure)",
        "--exclusions",
        "$(execpath //core:src/test/java/com/legend/integration/StressExclusions.java)",
        "--inputs",
        "$(execpaths //core:stress_files)",
    ] + ["$(execpaths %s)" % p for p in _LINKED],
    env = {
        "STRESS_LAYOUT": "$(execpath //core:src/test/resources/com/legend/integration/stress-layout.json)",
        "PYTHONUTF8": "1",
    },
    tool = ":trading_model_tool",
    visibility = ["//core:__pkg__", "//datacube:__pkg__", "//python:__pkg__"],
)

# THE CORPUS RATCHETS (Bazel workplan P2-04): each `--gate` of the corpus's own measures as a test, over the
# committed corpus (every stress file, the linked projects, the queries). Each ratchet constant stays a hand-owned,
# dated pin in its script (density.py MAX_PLAIN_RATIO/MAX_ABSENT, executed.py's baseline, stacking.py
# SURFACE_BASELINE; D9). They run from the runfiles tree, so they read only what is declared here.
_GATE_DATA = [
    "queries.pure",
    "//core:src/test/resources/com/legend/integration/stress-layout.json",
    "//core:stress_files",
] + _LINKED

_GATE_ENV = {
    "CORPUS_ROOT": ".",
    "PYTHONUTF8": "1",
    "PYTHONHASHSEED": "0",
    "PYTHONTZPATH": "",
}

[py_test(
    name = gate + "_gate",
    size = "medium",
    srcs = [gate + ".py"],
    args = ["--gate"],
    data = _GATE_DATA,
    env = _GATE_ENV,
    main = gate + ".py",
    deps = [":corpus"],
) for gate in ["density", "executed", "stacking"]]

# the engine-surface and function inventories' ratchets (Bazel workplan P2-04, D3 row 7): every construct the engine
# can express is written by the corpus or recorded as blocked; every implemented function was run against the engine
_INVENTORIES = {
    "scoreboard": ["//docs:ENGINE_SURFACE.tsv", "//docs:SURFACE_BLOCKED.tsv"],
    "functions": ["//docs:ENGINE_FUNCTIONS.tsv", "//docs:FUNCTIONS_EXECUTED.tsv"],
}

[py_test(
    name = gate + "_gate",
    size = "medium",
    srcs = [gate + ".py"],
    args = ["--gate"],
    data = _GATE_DATA + docs,
    env = _GATE_ENV,
    main = gate + ".py",
    deps = [":corpus"],
) for gate, docs in _INVENTORIES.items()]

# THE ENGINE VERDICT (Bazel workplan P3-25, Exec-2; docs/STRESS_CORPUS_PLAN_2026_10_19.md Phase 0): the committed
# corpus through legend-engine at the pinned release (//tools/engine-runner:testable), judged against quarantine.py.
# `bazel run :run -- --only <file>` runs a batch's services; :engine_stress is the whole corpus, manual and sharded
# (//gates:heavy): its trigger is a corpus or quarantine change or a legend-engine bump, never a change to lite.
_ENGINE_DATA = [
    "//core:src/test/resources/com/legend/integration/stress-layout.json",
    "//core:stress_files",
    "//tools/engine-runner:testable",
] + _LINKED

_ENGINE_ENV = dict(
    _GATE_ENV,
    ENGINE_RUNNER = "$(rlocationpath //tools/engine-runner:testable)",
)

py_library(
    name = "run_lib",
    srcs = ["run.py"],
    imports = ["."],
    deps = [
        ":corpus",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "run",
    testonly = True,
    srcs = ["run.py"],
    data = _ENGINE_DATA,
    env = _ENGINE_ENV,
    # a tool, built when run: //... never builds it
    tags = ["manual"],
    deps = [":run_lib"],
)

# The function probes (the Bazel workplan's P7-03, for the two the stress corpus plan's Phase 4 re-runs): each puts
# functions in front of the engine at the pin through run.py's launcher, compares with the oracle, and refreshes its
# rows of docs/FUNCTIONS_EXECUTED.tsv in the checkout. Tools, built when run.
[py_binary(
    name = probe,
    testonly = True,
    # the collection probe records its rows through the scalar probe's merge
    srcs = [
        "probe_collection.py",
        "probe_functions.py",
    ],
    data = _ENGINE_DATA,
    env = _ENGINE_ENV,
    main = probe + ".py",
    tags = ["manual"],
    deps = [":run_lib"],
) for probe in [
    "probe_collection",
    "probe_functions",
]]

# 4,735 testables, every eighth to a shard, in batches of 200, one JVM at a time per shard. Measured 2026-10-21 on a
# Windows desk with four JVMs at once: about 3 s a testable (graph fetch up to 17 s) and 40 s to parse and compile the
# corpus, so a shard takes about half of the enormous test's hour. Each JVM holds the compiled corpus (-Xmx6g, about
# 4 GB resident).
py_test(
    name = "engine_stress",
    size = "enormous",
    srcs = ["engine_stress.py"],
    data = _ENGINE_DATA,
    env = _ENGINE_ENV,
    main = "engine_stress.py",
    shard_count = 8,
    tags = [
        "manual",
        "resources:memory:7168",
    ],
    deps = [":run_lib"],
)

# run.py's batch loop over a stand-in JVM: a hang, a crash and a JVM that reports nothing (no engine is run)
py_test(
    name = "run_test",
    size = "small",
    srcs = ["run_test.py"],
    data = ["//core:src/test/resources/com/legend/integration/stress-layout.json"],
    env = _GATE_ENV,
    main = "run_test.py",
    deps = [":run_lib"],
)

# The testables a batch runs on the engine: the services whose text or expected result differs from the committed
# corpus, or every testable when anything else changed (`bazel run :changed -- --out <file>`, then :run --only). It
# reads the checkout and git, so it runs only under `bazel run`.
py_binary(
    name = "changed",
    srcs = ["changed.py"],
    tags = ["manual"],
    deps = [":corpus"],
)

py_test(
    name = "changed_test",
    size = "small",
    srcs = [
        "changed.py",
        "changed_test.py",
    ],
    env = _GATE_ENV,
    # the test imports changed by bare name, as the corpus modules import each other
    imports = ["."],
    main = "changed_test.py",
)

# the two hand tools above are manual, so a wildcard build leaves them out: this keeps them compiling (PHASE_8.md
# Gen-5, as //tools/census:tools_build_test)
build_test(
    name = "tools_build_test",
    targets = [
        ":changed",
        ":probe_collection",
        ":probe_functions",
        ":run",
    ],
)

# this package's hand-written .pure, for the keyword census (//scripts/parser:keyword_coverage, P2-20)
filegroup(
    name = "pure_sources",
    srcs = glob(["**/*.pure"]),
    visibility = ["//scripts/parser:__pkg__"],
)

# THE CROSS-ENGINE DIFFERENTIAL's data (Bazel workplan P3-18, D3 row 4: wired): the oracle's answers over the
# committed stress corpus and the seed they are computed on, as one tree, the data of //core:corpus_differential_test.
run_binary(
    name = "gen_differential",
    testonly = True,
    # what the oracle reads (model.py): the hand-written stress files, the committed dense three, the layout, the
    # queries and the linked projects; not the generated 92-98, which it leaves out
    srcs = [
        "queries.pure",
        "//core:src/test/resources/com/legend/integration/stress-layout.json",
        "//core:stress_dense",
        "//core:stress_sources",
    ] + _LINKED,
    # seed.json a file of its own, so a test resolves IT by runfiles path and takes expected/ beside it (a directory
    # resolves only under a runfiles tree, never by the Windows manifest: com.legend.testing.Runfile)
    outs = ["diff/seed.json"],
    out_dirs = ["diff/expected"],
    args = [
        "--out",
        "$(RULEDIR)/diff",
        "--inputs",
        "$(execpaths //core:stress_sources)",
        "$(execpaths //core:stress_dense)",
    ] + ["$(execpaths %s)" % p for p in _LINKED],
    env = dict(_GATE_ENV, LC_ALL = "C.UTF-8"),
    tool = ":differential",
    visibility = ["//core:__pkg__"],
)

guards_package()
