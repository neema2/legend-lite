// A relation groupBy over a group whose values are all absent: count is 0, and sum and joinStrings are absent. All
// three services pass, and they assert legend-engine's own definition.
//
//   bazel run //tools/engine-runner:testable -- scripts/corpus/repro/aggregate-over-nothing/model.pure //       --testable=demo::Count --testable=demo::Sum --testable=demo::JoinStrings
//
// legend-engine's groupBy is a native, and both of its Pure runtimes drop the absent values and answer nothing for a
// group with none left, never handing the reducer an empty collection (compiled
// RelationNativeImplementation.performMapReduce, interpreted AggregationShared); PCT
// test_Extend_Filter_Select_Pivot_GroupBy_Extend_Sort asserts it for `plus()`. legend-engine 4.145.0's DuckDB SQL
// (SUM, STRING_AGG) agrees: G2's sum and joinStrings are null. Its count is 0 (SQL's COUNT; Pure's count of nothing).
//
// Recorded as a defect, F75, from 2026-10-28, when the corpus's oracle read the group as reducing an empty collection
// (sum 0, joinStrings ''); withdrawn on 2026-10-29, when the improvement plan's D8 was reversed on the natives' and the
// PCT's evidence.
###Pure
Class demo::Row
{
  id: String[1];
  g: String[1];
  i: Integer[0..1];
  s: String[0..1];
}

###Relational
Database demo::DB
(
  Table T (ID VARCHAR(4) PRIMARY KEY, G VARCHAR(4), I INTEGER, S VARCHAR(20))
)

###Mapping
Mapping demo::M
(
  demo::Row: Relational
  {
    ~primaryKey ( [demo::DB]T.ID )
    ~mainTable [demo::DB]T
    id: [demo::DB]T.ID,
    g: [demo::DB]T.G,
    i: [demo::DB]T.I,
    s: [demo::DB]T.S
  }
)

###Connection
RelationalDatabaseConnection demo::Conn
{ store: demo::DB; type: DuckDB; specification: DuckDB { }; auth: Test; }

###Runtime
Runtime demo::RT { mappings: [ demo::M ]; connections: [ demo::DB: [ env: demo::Conn ] ]; }

###Data
Data demo::Seed
{
  Relational
  #{
    default.T:
      'ID,G,I,S\n' +
      'R1,G1,1,a\n' +
      'R2,G1,2,b\n' +
      'R3,G2,,\n' +
      'R4,G2,,\n';
  }#
}

###Service
Service demo::Count
{
  pattern: '/demo/count';
  documentation: '';
  execution: Single
  {
    query: |demo::Row.all()->project(~[g:x|$x.g, i:x|$x.i])->groupBy(~[g], ~[r: x|$x.i : y|$y->count()])->sort(~g->ascending());
    mapping: demo::M;
    runtime: demo::RT;
  }
  testSuites:
  [
    Count_suite:
    {
      data: [ connections: [ env: Reference #{ demo::Seed }# ] ]
      tests:
      [
        pure:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts: [ a: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json';
            data: '[ {"g":"G1","r":2}, {"g":"G2","r":0} ]'; }#; }# ]
        }
      ]
    }
  ]
}

###Service
Service demo::Sum
{
  pattern: '/demo/sum';
  documentation: '';
  execution: Single
  {
    query: |demo::Row.all()->project(~[g:x|$x.g, i:x|$x.i])->groupBy(~[g], ~[r: x|$x.i : y|$y->sum()])->sort(~g->ascending());
    mapping: demo::M;
    runtime: demo::RT;
  }
  testSuites:
  [
    Sum_suite:
    {
      data: [ connections: [ env: Reference #{ demo::Seed }# ] ]
      tests:
      [
        pure:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts: [ a: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json';
            data: '[ {"g":"G1","r":3}, {"g":"G2","r":null} ]'; }#; }# ]
        }
      ]
    }
  ]
}

###Service
Service demo::JoinStrings
{
  pattern: '/demo/joinstrings';
  documentation: '';
  execution: Single
  {
    query: |demo::Row.all()->project(~[g:x|$x.g, s:x|$x.s])->groupBy(~[g], ~[r: x|$x.s : y|$y->joinStrings(',')])->sort(~g->ascending());
    mapping: demo::M;
    runtime: demo::RT;
  }
  testSuites:
  [
    JoinStrings_suite:
    {
      data: [ connections: [ env: Reference #{ demo::Seed }# ] ]
      tests:
      [
        pure:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts: [ a: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json';
            data: '[ {"g":"G1","r":"a,b"}, {"g":"G2","r":null} ]'; }#; }# ]
        }
      ]
    }
  ]
}
