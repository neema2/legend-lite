// `!=` against a NULL column: does the row survive the filter? It does, and should.
//
// SQL is three-valued -- `NULL <> 'x'` is UNKNOWN, and a WHERE clause keeps only rows for
// which the predicate is TRUE, so SQL would EXCLUDE a NULL row. Pure is not: a comparison
// over an absent value is false (legend-pure's greaterThan documents it) and `==` is
// collection equality, so `[] != 'x'`, the negation of `[] == 'x'`, is true and the row is
// KEPT. All three services below assert Pure's reading, and legend-engine passes them.
//
// R3 below has a NULL NAME: kept by `!=`, dropped by `==` and by `>`.
//
// Recorded as a defect, F28, until 2026-10-23, when the corpus's oracle still read `!=` as
// SQL does; withdrawn when the improvement plan's Phase 1 checked legend-pure's definition.
//
// Found by the combination matrix rather than aimed at: the seeder began putting a NULL in
// every nullable column instead of only the first, and four generated services that filter
// with `!=` diverged at once. Until then no `!=` predicate in the corpus had ever met a
// NULL, so the rule had never been exercised.
Class demo::Thing
{
  id: String[1];
  name: String[0..1];
  tag: String[0..1];
}

###Relational
Database demo::DB
(
  Table THING (ID VARCHAR(20) PRIMARY KEY, NAME VARCHAR(50), TAG VARCHAR(50))
)

###Mapping
Mapping demo::M
(
  demo::Thing: Relational
  {
    ~primaryKey ( [demo::DB] THING.ID )
    ~mainTable [demo::DB] THING
    id: [demo::DB] THING.ID,
    name: [demo::DB] THING.NAME,
    tag: [demo::DB] THING.TAG
  }
)

###Connection
RelationalDatabaseConnection demo::Conn
{ store: demo::DB; type: H2; specification: LocalH2 { }; auth: DefaultH2; }

###Runtime
Runtime demo::RT
{ mappings: [ demo::M ]; connections: [ demo::DB: [ env: demo::Conn ] ]; }

###Data
Data demo::Seed
{
  Relational
  #{
    default.THING:
      'ID,NAME,TAG\n' +
      'R1,alpha,keep\n' +
      'R2,none,keep\n' +
      'R3,,keep\n';
  }#
}

###Service
Service demo::NotEqualsNull
{
  pattern: '/notEqualsNull';
  documentation: 'Under SQL three-valued logic NULL <> none is UNKNOWN and R3 is excluded; under Pure collection semantics [] != none is TRUE and R3 is kept. This asserts the Pure reading (F28, withdrawn 2026-10-23).';
  execution: Single
  {
    query: |demo::Thing.all()->filter(t | $t.name != 'none')->project(~[id:t|$t.id]);
    mapping: demo::M;
    runtime: demo::RT;
  }
  testSuites:
  [
    s:
    {
      data: [ connections: [ env: Reference #{ demo::Seed }# ] ]
      tests:
      [
        t:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            a: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json';
                 data: '[{"id":"R1"},{"id":"R3"}]'; }#; }#
          ]
        }
      ]
    }
  ]
}

Service demo::EqualsNull
{
  pattern: '/equalsNull';
  documentation: 'The complement. Both readings agree here -- R3 is excluded either way -- which is why no == predicate ever showed the question.';
  execution: Single
  {
    query: |demo::Thing.all()->filter(t | $t.name == 'none')->project(~[id:t|$t.id]);
    mapping: demo::M;
    runtime: demo::RT;
  }
  testSuites:
  [
    s:
    {
      data: [ connections: [ env: Reference #{ demo::Seed }# ] ]
      tests:
      [
        t:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            a: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json';
                 data: '[{"id":"R2"}]'; }#; }#
          ]
        }
      ]
    }
  ]
}

Service demo::GreaterNull
{
  pattern: '/greaterNull';
  documentation: 'An ORDERED comparison against a NULL: never satisfied by an absent value, so R3 is excluded, as by ==.';
  execution: Single
  {
    query: |demo::Thing.all()->filter(t | $t.name > 'alpha')->project(~[id:t|$t.id]);
    mapping: demo::M;
    runtime: demo::RT;
  }
  testSuites:
  [
    s:
    {
      data: [ connections: [ env: Reference #{ demo::Seed }# ] ]
      tests:
      [
        t:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            a: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json';
                 data: '[{"id":"R2"}]'; }#; }#
          ]
        }
      ]
    }
  ]
}
