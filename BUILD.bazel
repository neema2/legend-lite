load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/deps:pools.bzl", "POOLS")
load("//tools/guards:defs.bzl", "guards_package")
load("//tools/jars:defs.bzl", "java_runtime_jars")

# Root package. Exists so the jar pools' lock files are labels rules_jvm_external
# can read (MODULE.bazel says which pool is whose; tools/deps/pools.bzl lists them),
# and as the home for workspace-wide targets later.
exports_files(["MODULE.bazel", "release.MODULE.bazel"] + ["%s_install.json" % pool for pool in POOLS])

# the project's licence, its notice (Apache-2.0; legend-pure, legend-engine and legend-studio credited) and the
# third-party software it redistributes, shipped in its packages (//python:wheel, //site:dist)
exports_files(
    ["LICENSE", "NOTICE", "THIRD_PARTY_NOTICES.md"],
    visibility = [
        "//python:__pkg__",
        "//site:__pkg__",
    ],
)

# the module as Bazel reads it: MODULE.bazel and the segments it include()s (release.MODULE.bazel), for the tests that
# read the pools' definitions (//tools/deps:pools_list_test checks that every included segment is here)
filegroup(
    name = "module_files",
    srcs = ["MODULE.bazel"] + glob(["*.MODULE.bazel"]),
    visibility = [
        "//tools/deps:__pkg__",
        "//tools/guards:__pkg__",
    ],
)

# THE BUILD (docs/BUILD_REBUILD_DESIGN_2026_10_05.md, step 1): what we ship, by kind. Building one of these compiles
# that kind of product and runs nothing else: no generator, test, check or measurement. The first four are compiles,
# and //tools/guards:compile_only_test fails if one of them gains any other kind of action. The everyday build is
# `bazel build //:java //:web`.

# The Java the three servers run with: every jar of each one's runtime classpath (the engine, the database server, and
# SDLC with Depot's rules), except each server's own class jar, which is empty because the servers have no sources. It
# follows the servers' dependencies, so it is never edited by hand.
java_runtime_jars(
    name = "java",
    binaries = [
        "//core:server",
        "//sdlc-server:server",
        "//warehouse:server",
    ],
    visibility = ["//tools/guards:__pkg__"],
)

# The browser bundles each app ships (each app's own :bundles names them).
filegroup(
    name = "web",
    srcs = [
        "//datacube:bundles",
        "//engine-client:bundles",
        "//query:bundles",
        "//studio:bundles",
    ],
    visibility = ["//tools/guards:__pkg__"],
)

# Our Java compiled to WebAssembly for the browser: the engine's planner, and SDLC with Depot (Studio's page).
filegroup(
    name = "wasm",
    srcs = [
        "//sdlc-server:page",
        "//wasm:planner",
    ],
    visibility = ["//tools/guards:__pkg__"],
)

# The database server as a native executable (GraalVM).
filegroup(
    name = "native",
    srcs = ["//warehouse:server_native"],
    visibility = ["//tools/guards:__pkg__"],
)

# The site: every app from one origin, as a folder for any static host. Packaging, not a compile: it copies what the
# tiers above built, plus two DataCube bundles //:web does not name yet (remote_bundle and stress, its harnesses'
# fixtures; docs/BUILD_REBUILD_DESIGN_2026_10_05.md, D5).
filegroup(
    name = "sites",
    srcs = ["//site:dist"],
)


# EVERY committed generated file's diff test, in one suite: what CI's checks lane runs
# (`bazel test //:generated`). Each package's write_source_files makes its own suite; a package
# that adds generated files adds its suite here. A missing suite fails the build, not silently.
test_suite(
    name = "generated",
    tests = [
        "//core:update_generated_tests",
        "//core:update_ladder_tests",
        "//core:update_stress_corpus_tests",
        "//datacube:update_generated_tests",
        "//engine-client:update_generated_tests",
        "//docs:update_generated_tests",
        "//fixtures/saved-queries:update_generated_tests",
        "//parser-equivalence:update_generated_tests",
        "//legend-art:update_generated_tests",
        "//parser-equivalence:update_ratchets_tests",
        "//scripts/parser:update_keyword_coverage_tests",
        "//spec:update_ratchets_tests",
        "//tools/engine-runner:update_vocab_tests",
        "//warehouse:update_reachability_metadata_tests",
    ],
)

# EVERY generated file in the repository, written into the checkout from the pinned
# upstream release: `bazel run //:update_generated`. Each package's own list is
# the source of truth; this only runs them all.
# One exception: the corpus rosters (//spec:update_rcorpus_duckdb, //spec:update_rcorpus_h2) are re-blessed only
# deliberately, lane by lane, never as a side effect of regenerating something else: a newly failing test must be a
# decision (Bazel workplan P2-15, D9). Their diff tests run in the corpus lanes, not in //:generated.
# Manual (2026-10-07, the build rebuild's first landing, PHASE_8.md OD-10): a writer runs when a person runs it, and a
# wildcard build (`bazel build //...`) no longer builds what it lists, the 2 GB //pct:ratchets among them.
write_source_files(
    name = "update_generated",
    testonly = True,
    tags = ["manual"],
    additional_update_targets = [
        "//core:update_generated",
        "//core:update_ladder",
        "//core:update_stress_corpus",
        "//datacube:update_generated",
        "//engine-client:update_generated",
        "//docs:update_generated",
        "//fixtures/saved-queries:update_generated",
        "//parser-equivalence:update_generated",
        "//legend-art:update_generated",
        "//parser-equivalence:update_ratchets",
        "//pct:update_ratchets",
        "//scripts/parser:update_keyword_coverage",
        "//spec:update_ratchets",
        "//tools/engine-runner:update_vocab",
        "//warehouse:update_reachability_metadata",
    ],
)

# the CI workflows, for their linter (//tools/guards:workflows_test): the root package owns .github (no BUILD file
# below it)
filegroup(
    name = "workflows",
    srcs = glob([".github/workflows/*.yml"]),
    visibility = ["//tools/guards:__pkg__"],
)

guards_package()
