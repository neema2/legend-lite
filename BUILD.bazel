load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/deps:pools.bzl", "POOLS")
load("//tools/guards:defs.bzl", "guards_package")

# Root package. Exists so the jar pools' lock files are labels rules_jvm_external
# can read (MODULE.bazel says which pool is whose; tools/deps/pools.bzl lists them),
# and as the home for workspace-wide targets later.
exports_files(["MODULE.bazel", "release.MODULE.bazel"] + ["%s_install.json" % pool for pool in POOLS])

# the module as Bazel reads it: MODULE.bazel and the segments it include()s (release.MODULE.bazel), for the tests that
# read the pools' definitions (//tools/deps:pools_list_test checks that every included segment is here)
filegroup(
    name = "module_files",
    srcs = ["MODULE.bazel"] + glob(["*.MODULE.bazel"]),
    visibility = [
        "//tools/deps:__pkg__",
        "//tools/guards:__pkg__",
    ],
)


# EVERY committed generated file's diff test, in one suite: what CI's checks lane runs
# (`bazel test //:generated`). Each package's write_source_files makes its own suite; a package
# that adds generated files adds its suite here. A missing suite fails the build, not silently.
test_suite(
    name = "generated",
    tests = [
        "//core:update_generated_tests",
        "//core:update_ladder_tests",
        "//core:update_stress_corpus_tests",
        "//datacube:update_generated_tests",
        "//engine-client:update_generated_tests",
        "//docs:update_generated_tests",
        "//fixtures/saved-queries:update_generated_tests",
        "//parser-equivalence:update_generated_tests",
        "//query:update_generated_tests",
        "//tools/engine-runner:update_vocab_tests",
    ],
)

# EVERY generated file in the repository, written into the checkout from the pinned
# upstream release: `bazel run //:update_generated`. Each package's own list is
# the source of truth; this only runs them all.
write_source_files(
    name = "update_generated",
    testonly = True,
    additional_update_targets = [
        "//core:update_generated",
        "//core:update_ladder",
        "//core:update_stress_corpus",
        "//datacube:update_generated",
        "//engine-client:update_generated",
        "//docs:update_generated",
        "//fixtures/saved-queries:update_generated",
        "//parser-equivalence:update_generated",
        "//query:update_generated",
        "//tools/engine-runner:update_vocab",
    ],
)

guards_package()
