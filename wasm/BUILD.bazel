# legend-lite's planner, compiled ahead of time to WebAssembly (TeaVM), and the
# differential that holds it to the JVM. See README.md.
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//tools/js:defs.bzl", "node_test")
load("//tools/java:defs.bzl", "legend_java_library")

load("//tools/java_run:defs.bzl", "java_run")
load("//tools/teavm:defs.bzl", "teavm_wasm")
load("//tools/guards:defs.bzl", "guards_package")

# DataCube's guardrail requires the differential behind its second transport
js_library(
    name = "differential",
    srcs = ["differential.mjs"],
    visibility = ["//datacube:__pkg__"],
)

# The TeaVM surface the tab's adapter names at COMPILE time only: @JSExport
# (jso) and the ResourceSupplier SPI (core, the compiler's). neverlink — on a JVM the
# annotation is inert and nothing loads the SPI, so no JVM classpath carries them.
legend_java_library(
    name = "teavm_api",
    neverlink = True,
    exports = [
        "@maven_teavm//:org_teavm_teavm_core",
        "@maven_teavm//:org_teavm_teavm_jso",
    ],
)

# THE BOUNDARY (planner.Boundary, docs/PROTOCOL_PROGRAM_2026_10_05.md invariant 5): the operations every embedded
# host runs -- the tab and Python -- plain Java, no host's annotations, each once; and the one text encoding both
# strings-only hosts answer with (planner.Folded). Built to WebAssembly through the tab's adapter, and native
# through Python's (//native:compiler).
legend_java_library(
    name = "boundary",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = [
        "src/main/java/planner/Boundary.java",
        "src/main/java/planner/Folded.java",
    ],
    visibility = ["//native:__pkg__"],
    deps = [
        # the plan side only (C2a): the embedded planner carries no execution library, no database, no driver
        "//core:plan_side",
        "//json",
    ],
)

# THE TAB'S ADAPTER: TeaVM's entry class (planner.TabExports, its @JSExport functions the module's exports, each a
# delegation to the boundary) and the resources TeaVM's class library embeds (PreludeResources).
legend_java_library(
    name = "tab",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = [
        "src/main/java/planner/PreludeResources.java",
        "src/main/java/planner/TabExports.java",
    ],
    resources = ["src/main/resources/META-INF/services/org.teavm.classlib.ResourceSupplier"],
    resource_strip_prefix = "wasm/src/main/resources",
    # the round trip in the tab: its JVM half asks these same exports (//parser-equivalence:tab_round_trip)
    visibility = ["//parser-equivalence:__pkg__"],
    deps = [
        ":boundary",
        ":teavm_api",
        "//core:plan_side",
    ],
)

# The module: the tab's adapter and all it reaches, with the class library TeaVM
# substitutes for the JDK's.
teavm_wasm(
    name = "planner",
    main_class = "planner.TabExports",
    visibility = ["//visibility:public"],
    deps = [
        ":tab",
        "@maven_teavm//:org_teavm_teavm_classlib",
        "@maven_teavm//:org_teavm_teavm_jso",
    ],
)

# The planner as ONE directory (classes.wasm beside its runtime), so a test names it with one $(rlocationpath)
# (node_test's WASM_PLANNER, Bazel workplan P1-24).
copy_to_directory(
    name = "planner_dir",
    srcs = [":planner"],
    root_paths = ["wasm/planner"],
    visibility = ["//visibility:public"],
)

# The JVM halves of the differentials: the corpus, and the timezone probe. Target-
# configuration libraries run by java_run (//tools/java_run), so core is compiled
# once for them and for the module.
legend_java_library(
    name = "jvm_main",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = ["src/main/java/planner/JvmMain.java"],
    visibility = ["//visibility:public"],
    # the tab's own exports, so the differential compares the tab's answers across the two builds
    deps = [":tab"],
)

legend_java_library(
    name = "zone_main",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = ["src/main/java/planner/ZoneMain.java"],
    deps = ["//core:lowering"],
)

# THE DIFFERENTIAL. The JVM's answers are a build output — a function of the
# planner's source and the corpus, cached until either changes — and the test
# plans the same corpus in the module and compares, refusals included.
java_run(
    name = "jvm_answers",
    testonly = True,
    srcs = [
        "corpus/model.pure",
        "corpus/queries.tsv",
    ],
    outs = ["jvm_answers.txt"],
    arguments = [
        "$(execpath corpus/model.pure)",
        "$(execpath corpus/queries.tsv)",
        "trades::RT",
        "{OUT}",
    ],
    main_class = "planner.JvmMain",
    # the native build is held to the same answers (//python:bindings_test)
    visibility = ["//python:__pkg__"],
    deps = [":jvm_main"],
)

# the corpus itself, for the native build's differential
exports_files(
    ["corpus/model.pure", "corpus/queries.tsv"],
    visibility = [
        "//python:__pkg__",
        "//tools/metrics:__pkg__",
    ],
)

node_test(
    name = "differential_test",
    wasm = True,
    # loads the WebAssembly planner, as datacube's _WASM_TESTS do: seconds alone, but past `small`'s 60 s under a full
    # local gate beside the corpus lanes (2026-10-05) and on CI's Windows runner (main's CI run 37214692462)
    size = "medium",
    data = [
        ":planner",
        "corpus/model.pure",
        "corpus/queries.tsv",
        ":jvm_answers",
    ],
    entry_point = ":differential",
)

# THE ROUND TRIP IN THE TAB (docs/PROTOCOL_PROGRAM_2026_10_05.md §4, leg 5): the module asked what the tab asks
# pure/v1 for over every input of the JVM's round-trip proof, its answers held to the JVM's byte for byte (by digest).
node_test(
    name = "round_trip_test",
    wasm = True,
    size = "large",
    data = ["//parser-equivalence:tab_round_trip"],
    entry_point = "round_trip.mjs",
    env = {"TAB_ROUND_TRIP": "$(rlocationpath //parser-equivalence:tab_round_trip)"},
)

# THE TIMEZONE DIFFERENTIAL: a tz database is a resource, not code, so only the
# built module can say whether it survived. ZoneMain's answers are the cases.
java_run(
    name = "zone_jvm",
    testonly = True,
    outs = ["zone_jvm.txt"],
    arguments = ["{OUT}"],
    main_class = "planner.ZoneMain",
    deps = [":zone_main"],
)

node_test(
    name = "zone_test",
    wasm = True,
    size = "small",
    data = [
        ":planner",
        ":zone_jvm",
    ],
    entry_point = "zoneprobe.mjs",
)

# `bazel run //wasm:startup`: where the module's cold start goes, phase by phase.
# It TIMES things — run it on an idle machine, never as a test. Manual (2026-10-07, PHASE_8.md Gen-5): a hand tool,
# built when run; CI's product job still analyses it by name.
js_binary(
    name = "startup",
    data = [
        "corpus/model.pure",
        "corpus/queries.tsv",
        ":planner",
    ],
    entry_point = "startup.mjs",
    node_options = ["--experimental-wasm-exnref"],
    tags = ["manual"],
)

# the hand tool compiles (the build rebuild's L1b): the checks lane builds it, nothing runs
build_test(
    name = "tools_build_test",
    targets = [":startup"],
)

guards_package()
