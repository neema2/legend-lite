# legend-lite's planner, compiled ahead of time to WebAssembly (TeaVM), and the
# differential that holds it to the JVM. See README.md.
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//tools/js:defs.bzl", "node_test")
load("//tools/java:defs.bzl", "legend_java_library")

load("//tools/java_run:defs.bzl", "java_run")
load("//tools/teavm:defs.bzl", "teavm_wasm")
load("//tools/guards:defs.bzl", "guards_package")

# DataCube's guardrail requires the differential behind its second transport
js_library(
    name = "differential",
    srcs = ["differential.mjs"],
    visibility = ["//datacube:__pkg__"],
)

# the planner's sources, as files: core's database-name guards read them (the dialect program's Phase 7, 2026-10-18;
# the conformance harness beside it tests the JDK's classes, not a database)
filegroup(
    name = "planner_java",
    # the edge's entries too (src/edge: the separation census's A1, 2026-11-17)
    srcs = glob(["src/main/java/planner/*.java", "src/edge/java/**/*.java"]),
    # and the planned-SQL guard: who reaches the authored door (the C final audit's H1, 2026-11-12)
    visibility = ["//core:__pkg__", "//tools/guards:__pkg__"],
)

# THE BOUNDARY (planner.Boundary, docs/PROTOCOL_PROGRAM_2026_10_05.md invariant 5): the operations every embedded
# host runs -- the tab and Python -- plain Java, no host's annotations, each once; and the one text encoding both
# strings-only hosts answer with (planner.Folded). Built to WebAssembly through the tab's adapter, and native
# through Python's (//native:compiler).
legend_java_library(
    name = "boundary",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = [
        "src/main/java/planner/Boundary.java",
        "src/main/java/planner/Folded.java",
        "src/main/java/planner/HostOperationsJson.java",
    ],
    # //core: the guard of who reaches the authored door, by class (ArchitectureTest.theAuthoredDoorIsReachedFromTheBoundaryAlone,
    # the third re-audit's SHOULD-FIX 5, 2026-11-12)
    visibility = ["//core:__pkg__", "//native:__pkg__"],
    deps = [
        # the plan side only (C2a): the embedded planner carries no execution library, no database, no driver
        "//core:plan_side",
        # (no //core:edge: legend-engine's routes and execute's halves are :edge_boundary's, the census's A1, 2026-11-17)
        "//json",
    ],
)

# THE EDGE'S ENTRIES FOR THE EMBEDDED HOSTS (the separation census's A1, 2026-11-17): legend-engine's pure/v1 route and
# execute's plan and answer halves (com.legend.edge.wasm.EdgeBoundary), through //core:edge as the server answers
# them. The tab's module and Python's library carry it, rooted at the edge as the server is (the orchestrator's
# extension of ruling A4); lite's own operations stay :boundary's.
legend_java_library(
    name = "edge_boundary",
    nullaway = False,
    srcs = ["src/edge/java/com/legend/edge/wasm/EdgeBoundary.java"],
    visibility = ["//core:__pkg__", "//native:__pkg__"],
    deps = [
        ":boundary",
        "//core:edge",
        "//core:plan_side",
        "//json",
    ],
)

# THE TAB'S ADAPTER: TeaVM's entry class (planner.TabExports, its @JSExport functions the module's exports, each a
# delegation to the boundary) and the resources TeaVM's class library embeds (PreludeResources). A PRODUCT ROOT again
# (the user's K2 ruling, ~06:00 2026-11-18: "Product root, edge opt-in"): from F's census line A1 (2026-11-17) until K2
# the entry class was the edge's (com.legend.edge.wasm.TabExports, :edge_tab), four of its exports legend-engine's
# routes; those are the engine module's now (:engine_planner), and this target depends on no edge target.
legend_java_library(
    name = "tab",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = [
        "src/main/java/planner/PreludeResources.java",
        "src/main/java/planner/TabExports.java",
    ],
    resources = ["src/main/resources/META-INF/services/org.teavm.classlib.ResourceSupplier"],
    resource_strip_prefix = "wasm/src/main/resources",
    # the round trip in the tab: its JVM half asks these same exports (//parser-equivalence:tab_round_trip); //core:
    # the guard of who reaches the authored door, by class (the third re-audit's SHOULD-FIX 5, 2026-11-12)
    visibility = ["//core:__pkg__", "//parser-equivalence:__pkg__", "//tools/deps:__pkg__"],
    deps = [
        ":boundary",
        "//core:plan_side",
        # the module's main reads query/parse's answer (lite API v1, 2026-11-17)
        "//json",
        # TeaVM's annotations, at compile time only
        "//tools/teavm:api",
    ],
)

# THE ENGINE MODULE'S ENTRY CLASS, AT THE EDGE (the user's K2 ruling, ~06:00 2026-11-18; the orchestrator's option A):
# com.legend.edge.wasm.EngineExports, its @JSExport functions legend-engine's four routes in the tab (pureV1 and
# execute's halves, :edge_boundary), moved from the product module's entry unchanged. It depends on the product (the
# boundary, and :tab for the class library's resources), never the reverse.
legend_java_library(
    name = "edge_tab",
    nullaway = False,
    srcs = ["src/edge/java/com/legend/edge/wasm/EngineExports.java"],
    visibility = ["//core:__pkg__", "//parser-equivalence:__pkg__", "//tools/deps:__pkg__"],
    deps = [
        ":boundary",
        ":edge_boundary",
        ":tab",
        "//tools/teavm:api",
    ],
)

# The module: the tab's adapter and all it reaches, with the class library TeaVM
# substitutes for the JDK's. lite's own entry: no edge entry (K2, 2026-11-18; //wasm:product_module_test).
teavm_wasm(
    name = "planner",
    main_class = "planner.TabExports",
    visibility = ["//visibility:public"],
    deps = [
        ":tab",
        "@maven_teavm//:org_teavm_teavm_classlib",
        "@maven_teavm//:org_teavm_teavm_jso",
    ],
)

# THE ENGINE MODULE (K2, 2026-11-18, option A): legend-engine's routes in the tab, a module of their own, loaded beside
# the planner only where an app is configured `engine: 'legend-engine'` (engine-client's engine-module.ts refuses any
# other word by name). Its answers are the ones //wasm:planner gave before the split, byte for byte
# (//wasm:engine_routes_test).
teavm_wasm(
    name = "engine_planner",
    main_class = "com.legend.edge.wasm.EngineExports",
    visibility = ["//visibility:public"],
    deps = [
        ":edge_tab",
        "@maven_teavm//:org_teavm_teavm_classlib",
        "@maven_teavm//:org_teavm_teavm_jso",
    ],
)

# The planner as ONE directory (classes.wasm beside its runtime), so a test names it with one $(rlocationpath)
# (node_test's WASM_PLANNER, Bazel workplan P1-24).
copy_to_directory(
    name = "planner_dir",
    srcs = [":planner"],
    root_paths = ["wasm/planner"],
    visibility = ["//visibility:public"],
)

# the engine module as ONE directory, as :planner_dir is (node_test's WASM_ENGINE_PLANNER, `engine = True`)
copy_to_directory(
    name = "engine_planner_dir",
    srcs = [":engine_planner"],
    root_paths = ["wasm/engine_planner"],
    visibility = ["//visibility:public"],
)

# The JVM halves of the differentials: the corpus, and the timezone probe. Target-
# configuration libraries run by java_run (//tools/java_run), so core is compiled
# once for them and for the module.
legend_java_library(
    name = "jvm_main",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = ["src/main/java/planner/JvmMain.java"],
    visibility = ["//visibility:public"],
    # the tab's own exports' compositions over the boundary (lite API v1: queryParse, then queryPlan), so the differential
    # compares the tab's answers across the two builds
    deps = [
        ":boundary",
        "//json",
    ],
)

legend_java_library(
    name = "zone_main",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = ["src/main/java/planner/ZoneMain.java"],
    # read by core's guards as a host's door (//core:authored_door_jars, the GUARD stream's C.5, 2026-11-17)
    visibility = ["//core:__pkg__"],
    deps = ["//core:lowering"],
)

# THE DIFFERENTIAL. The JVM's answers are a build output — a function of the
# planner's source and the corpus, cached until either changes — and the test
# plans the same corpus in the module and compares, refusals included.
java_run(
    name = "jvm_answers",
    testonly = True,
    srcs = [
        "corpus/model.pure",
        "corpus/queries.tsv",
    ],
    outs = ["jvm_answers.txt"],
    arguments = [
        "$(execpath corpus/model.pure)",
        "$(execpath corpus/queries.tsv)",
        "trades::RT",
        "{OUT}",
    ],
    main_class = "planner.JvmMain",
    # the native build is held to the same answers (//python:bindings_test)
    visibility = ["//python:__pkg__"],
    deps = [":jvm_main"],
)

# the corpus itself, for the native build's differential
exports_files(
    ["corpus/model.pure", "corpus/queries.tsv"],
    visibility = [
        "//python:__pkg__",
        "//tools/metrics:__pkg__",
    ],
)

node_test(
    name = "differential_test",
    wasm = True,
    # loads the WebAssembly planner, as datacube's _WASM_TESTS do: seconds alone, but past `small`'s 60 s under a full
    # local gate beside the corpus lanes (2026-10-05) and on CI's Windows runner (main's CI run 37214692462)
    size = "medium",
    data = [
        ":planner",
        "corpus/model.pure",
        "corpus/queries.tsv",
        ":jvm_answers",
    ],
    entry_point = ":differential",
)

# THE ROUND TRIP IN THE TAB (docs/PROTOCOL_PROGRAM_2026_10_05.md §4, leg 5): the module asked what the tab asks
# pure/v1 for over every input of the JVM's round-trip proof, its answers held to the JVM's byte for byte (by digest).
# The engine module's since the user's K2 ruling (2026-11-18): pure/v1 in the tab is legend-engine's route.
node_test(
    name = "round_trip_test",
    engine = True,
    size = "large",
    data = ["//parser-equivalence:tab_round_trip"],
    entry_point = "round_trip.mjs",
    env = {"TAB_ROUND_TRIP": "$(rlocationpath //parser-equivalence:tab_round_trip)"},
)

# PRODUCT ROOT, EDGE OPT-IN (the user's K2 ruling, ~06:00 2026-11-18; the orchestrator's option A): the planner module
# runs alone and exports no legend-engine route (edge off); the engine module answers legend-engine's routes as the
# planner module did before the split, byte for byte, by pins captured then (edge on).
node_test(
    name = "product_module_test",
    wasm = True,
    # loads the WebAssembly planner, as :differential_test does
    size = "medium",
    entry_point = "product_module.mjs",
)

node_test(
    name = "engine_routes_test",
    engine = True,
    size = "medium",
    data = ["engine-routes.json"],
    entry_point = "engine_routes.mjs",
    env = {"ENGINE_ROUTES_PINS": "$(rlocationpath engine-routes.json)"},
)

# THE TIMEZONE DIFFERENTIAL: a tz database is a resource, not code, so only the
# built module can say whether it survived. ZoneMain's answers are the cases.
java_run(
    name = "zone_jvm",
    testonly = True,
    outs = ["zone_jvm.txt"],
    arguments = ["{OUT}"],
    main_class = "planner.ZoneMain",
    deps = [":zone_main"],
)

node_test(
    name = "zone_test",
    wasm = True,
    size = "small",
    data = [
        ":planner",
        ":zone_jvm",
    ],
    entry_point = "zoneprobe.mjs",
)

# THE CONFORMANCE DIFFERENTIAL (docs/WEB_IMAGE_SPIKE_2026_10_10.md, step 1): TeaVM's class library held to the JDK's
# over what lite's browser code calls -- a number's text both ways, Character and String, the formats and regular
# expressions lite writes, time and zones, the order hashed collections iterate in, the codecs. The families
# (src/main/java/conformance) are compiled twice, as the zone probe is: run on the JVM as a build action, and by TeaVM
# into a module of their own; conformance.mjs compares the two line by line.
legend_java_library(
    name = "conformance",
    srcs = glob(["src/main/java/conformance/*.java"]),
    deps = ["//tools/teavm:api"],
)

java_run(
    name = "conformance_jvm",
    testonly = True,
    outs = ["conformance_jvm.txt"],
    arguments = ["{OUT}"],
    main_class = "conformance.ConformanceJvm",
    deps = [":conformance"],
)

teavm_wasm(
    name = "conformance_module",
    testonly = True,
    main_class = "conformance.ConformanceExports",
    deps = [
        ":conformance",
        "@maven_teavm//:org_teavm_teavm_classlib",
        "@maven_teavm//:org_teavm_teavm_jso",
    ],
)

# the module as ONE directory, named by one $(rlocationpath), as :planner_dir is
copy_to_directory(
    name = "conformance_dir",
    testonly = True,
    srcs = [":conformance_module"],
    root_paths = ["wasm/conformance_module"],
)

node_test(
    name = "conformance_test",
    size = "medium",
    data = [
        "conformance-known.tsv",
        ":conformance_dir",
        ":conformance_jvm",
    ],
    entry_point = "conformance.mjs",
    env = {
        "CONFORMANCE_JVM": "$(rlocationpath :conformance_jvm)",
        "CONFORMANCE_KNOWN": "$(rlocationpath conformance-known.tsv)",
        "CONFORMANCE_MODULE": "$(rlocationpath :conformance_dir)",
    },
    # TeaVM emits the newer exception-handling opcodes (differential.mjs)
    node_options = ["--experimental-wasm-exnref"],
)

# `bazel run //wasm:startup`: where the module's cold start goes, phase by phase.
# It TIMES things — run it on an idle machine, never as a test. Manual (2026-10-07, PHASE_8.md Gen-5): a hand tool,
# built when run; CI's product job still analyses it by name.
js_binary(
    name = "startup",
    data = [
        "corpus/model.pure",
        "corpus/queries.tsv",
        ":planner",
    ],
    entry_point = "startup.mjs",
    node_options = ["--experimental-wasm-exnref"],
    tags = ["manual"],
)

# the hand tool compiles (the build rebuild's L1b): the checks lane builds it, nothing runs
build_test(
    name = "tools_build_test",
    targets = [":startup"],
)

guards_package()
