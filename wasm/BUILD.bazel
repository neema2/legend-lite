# legend-lite's planner, compiled ahead of time to WebAssembly (TeaVM), and the
# differential that holds it to the JVM. See README.md.
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")
load("@rules_java//java:defs.bzl", "java_library")
load("//tools/java_run:defs.bzl", "java_run")
load("//tools/teavm:defs.bzl", "teavm_wasm")

# DataCube's guardrail requires the differential behind its second transport
js_library(
    name = "differential",
    srcs = ["differential.mjs"],
    visibility = ["//datacube:__pkg__"],
)

# The TeaVM surface the boundary class names at COMPILE time only: @JSExport
# (jso) and the ResourceSupplier SPI (core, the compiler's). neverlink — on a JVM the
# annotation is inert and nothing loads the SPI, so no JVM classpath carries them.
java_library(
    name = "teavm_api",
    neverlink = True,
    exports = [
        "@maven_teavm//:org_teavm_teavm_core",
        "@maven_teavm//:org_teavm_teavm_jso",
    ],
)

# THE BOUNDARY: one class both targets run — TeaVM compiles it, JvmMain calls it —
# so the differential compares two builds of one source.
java_library(
    name = "boundary",
    srcs = [
        "src/main/java/planner/PreludeResources.java",
        "src/main/java/planner/Wasm.java",
    ],
    resources = ["src/main/resources/META-INF/services/org.teavm.classlib.ResourceSupplier"],
    resource_strip_prefix = "wasm/src/main/resources",
    deps = [
        ":teavm_api",
        "//core",
    ],
)

# The module: planner.Wasm and all it reaches, with the class library TeaVM
# substitutes for the JDK's.
teavm_wasm(
    name = "planner",
    main_class = "planner.Wasm",
    visibility = ["//visibility:public"],
    deps = [
        ":boundary",
        "@maven_teavm//:org_teavm_teavm_classlib",
        "@maven_teavm//:org_teavm_teavm_jso",
    ],
)

# The JVM halves of the differentials: the corpus, and the timezone probe. Target-
# configuration libraries run by java_run (//tools/java_run), so core is compiled
# once for them and for the module.
java_library(
    name = "jvm_main",
    srcs = ["src/main/java/planner/JvmMain.java"],
    visibility = ["//visibility:public"],
    deps = [":boundary"],
)

java_library(
    name = "zone_main",
    srcs = ["src/main/java/planner/ZoneMain.java"],
    deps = [":boundary"],
)

# THE DIFFERENTIAL. The JVM's answers are a build output — a function of the
# planner's source and the corpus, cached until either changes — and the test
# plans the same corpus in the module and compares, refusals included.
java_run(
    name = "jvm_answers",
    srcs = [
        "corpus/model.pure",
        "corpus/queries.tsv",
    ],
    outs = ["jvm_answers.txt"],
    arguments = [
        "$(execpath corpus/model.pure)",
        "$(execpath corpus/queries.tsv)",
        "trades::RT",
        "{OUT}",
    ],
    main_class = "planner.JvmMain",
    deps = [":jvm_main"],
)

js_test(
    name = "differential_test",
    size = "small",
    data = [
        "corpus/model.pure",
        "corpus/queries.tsv",
        ":jvm_answers",
        ":planner",
    ],
    entry_point = ":differential",
    node_options = ["--experimental-wasm-exnref"],
)

# THE TIMEZONE DIFFERENTIAL: a tz database is a resource, not code, so only the
# built module can say whether it survived. ZoneMain's answers are the cases.
java_run(
    name = "zone_jvm",
    outs = ["zone_jvm.txt"],
    arguments = ["{OUT}"],
    main_class = "planner.ZoneMain",
    deps = [":zone_main"],
)

js_test(
    name = "zone_test",
    size = "small",
    data = [
        ":planner",
        ":zone_jvm",
    ],
    entry_point = "zoneprobe.mjs",
    node_options = ["--experimental-wasm-exnref"],
)

# `bazel run //wasm:startup`: where the module's cold start goes, phase by phase.
# It TIMES things — run it on an idle machine, never as a test.
js_binary(
    name = "startup",
    data = [
        "corpus/model.pure",
        "corpus/queries.tsv",
        ":planner",
    ],
    entry_point = "startup.mjs",
    node_options = ["--experimental-wasm-exnref"],
)
