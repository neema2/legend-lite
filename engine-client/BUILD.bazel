# The engine client (README.md): where a query runs, for every app here -- the QueryEngine interface,
# results and receipts, the one reader of a column's type, legend-engine's pure/v1 client and its
# executor, DuckDB in the tab, and the warehouse. Moved out of datacube/ (2026-10-04) so DataCube, Query
# and Studio share it instead of reaching into one another. Its npm packages are its own lock (MODULE.bazel
# `npm_engine_client`): Apache Arrow, for the warehouse's result chunks and an engine's Arrow answers, and fzstd, the
# zstd frame those answers come in.
load("//tools/guards:defs.bzl", "guards_package")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/js:defs.bzl", "node_test")
load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@npm_engine_client//:defs.bzl", "npm_link_all_packages")
load("//tools/js:esbuild.bzl", "esbuild_bundle")
load("//tools/java:defs.bzl", "legend_java_library")
load("//tools/java_run:defs.bzl", "java_run")

npm_link_all_packages(name = "node_modules")

exports_files(["pnpm-lock.yaml", "package.json"])

js_library(
    name = "engine_client",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    visibility = [
        "//datacube:__pkg__",
        "//query:__pkg__",
        "//studio:__pkg__",
    ],
    deps = [
        # pure/v1's queries are built and read as protocol JSON
        "//pure-protocol:pure_protocol",
        # DuckDB in the tab (duckdb-wasm.ts re-exports it for the apps), and the Arrow it brings -- the
        # one copy every bundle carries, which the warehouse's Arrow IPC chunks are read with too
        ":node_modules/@duckdb/duckdb-wasm",
        ":node_modules/apache-arrow",
        # fzstd 0.1.1, exact (2026-10-08, the user's approval): legend-engine's Arrow answer to execute (ARROW_IPC) is
        # ALWAYS one zstd frame (RelationalResultToArrowIPCSerializer wraps its stream in a ZstdOutputStream; measured,
        # core/src/test/resources/upstream-api/e8-arrow-groupby-sort.json), Python's engine answers the same bytes so
        # one reader serves both, and the browser's DecompressionStream reads no zstd (the pinned Chromium 153,
        # measured). A decoder, pure JavaScript, MIT, no dependencies, loaded on the first Arrow answer only
        # (pure-v1.ts arrowIpcStream: the bundles that never meet one do not carry it).
        ":node_modules/fzstd",
    ],
)

# legend-lite's planner in a worker (src/legend/planner-worker.ts), one bundle for every app that runs it in the
# tab, answering the one planner protocol (src/legend/planner-protocol.ts; docs/ONE_PLATFORM_PROGRAM_2026_10_12.md C2):
# DataCube, Query and Studio serve it as their ./planner-worker.js, next to //wasm:planner's module.
esbuild_bundle(
    name = "planner_worker",
    srcs = [
        "src/legend/planner-answer.ts",
        "src/legend/planner-protocol.ts",
        "src/legend/planner-worker.ts",
    ],
    outs = ["planner-worker.js"],
    args = [
        "src/legend/planner-worker.ts",
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--log-level=warning",
        "--outfile=planner-worker.js",
    ],
    visibility = [
        "//datacube:__pkg__",
        "//query:__pkg__",
        "//studio:__pkg__",
    ],
)

# THE BUNDLES ENGINE-CLIENT SHIPS (//:web; docs/BUILD_REBUILD_DESIGN_2026_10_05.md, D10): the planner's worker, which
# Query and Studio copy into their sites
filegroup(
    name = "bundles",
    srcs = [":planner_worker"],
    visibility = ["//:__pkg__"],
)

# Every TypeScript file here, the tests too, for DataCube's typecheck (strict tsc: this package has no TypeScript of
# its own, so it borrows DataCube's rather than a second lock; its sources are also checked through each app's imports)
js_library(
    name = "typescript_sources",
    srcs = glob(["src/**/*.ts", "test/**/*.ts"]) + ["package.json"],
    visibility = ["//datacube:__pkg__"],
)

# LITE'S FACTS (DataCube decision D1, docs/DATACUBE_TYPES_TO_SERVER_2026_09_27.md): the type families and
# the pivot separator, generated by RUNNING legend-lite (a Java program over Type.Primitive and its
# constants), never by reading its source; a diff test on the committed copy:
# `bazel run //engine-client:update_generated`.
legend_java_library(
    name = "type_facts_main",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = ["tools/typefacts/TypeFacts.java"],
    deps = ["//core:compiler_element_type"],
)

java_run(
    name = "lite_facts",
    outs = ["generated/lite-facts.gen.ts"],
    arguments = [
        "ts",
        "{OUT}",
    ],
    main_class = "typefacts.TypeFacts",
    deps = [":type_facts_main"],
)

# the same table for Python's reading of a column's type (python/legend_lite/_types.py,
# docs/PYTHON_ASKS_DATACUBE_2026_10_15.md item 4): committed and diff-tested by //python:update_generated
java_run(
    name = "lite_facts_py",
    outs = ["generated/type_facts.gen.py"],
    arguments = [
        "py",
        "{OUT}",
    ],
    main_class = "typefacts.TypeFacts",
    visibility = ["//python:__pkg__"],
    deps = [":type_facts_main"],
)

write_source_files(
    name = "update_generated",
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nlegend-lite changed a fact the engine client mirrors -- regenerate: bazel run //engine-client:update_generated, then read the diff (a changed Pure kind or pivot separator changes what a grid shows)",
    files = {
        "src/generated/lite-facts.ts": ":lite_facts",
    },
    visibility = ["//:__pkg__"],
)

# a model's test data in DuckDB (model-data.ts, plan A2): made and filled by the server's statements, which the planner
# (WebAssembly) gives for a model's text
node_test(
    name = "model_data_test",
    # 7.5 s measured on a desk, the planner loaded (2026-10-08)
    size = "small",
    data = [
        ":engine_client",
        ":node_modules/@duckdb/duckdb-wasm",
        "test/planner.ts",
    ],
    entry_point = "test/model-data.test.ts",
    wasm = True,
)

# rows a page makes, as Arrow (arrow-ipc.ts arrowIpcStream: DataCube's demo trades), read back by DuckDB-WASM's own
# reader
node_test(
    name = "arrow_ipc_test",
    size = "small",
    data = [
        ":engine_client",
        ":node_modules/@duckdb/duckdb-wasm",
    ],
    entry_point = "test/arrow-ipc.test.ts",
)

# DuckDB in a Node test (src/node-require.ts startNodeDuckDb): the pinned extensions only, none fetched (node_test gives
# a test that takes DuckDB-WASM the pinned files)
node_test(
    name = "node_duckdb_test",
    size = "small",
    data = [
        ":engine_client",
        ":node_modules/@duckdb/duckdb-wasm",
    ],
    entry_point = "test/node-duckdb.test.ts",
)

# Snap's engine half (plan A6, moved from DataCube): freezing rows into the tab's DuckDB, the stamp, the refusals
node_test(
    name = "snap_test",
    # 2 s measured on a desk (2026-10-07); the planner loaded since D5 (it writes the copy's statements)
    size = "small",
    data = [
        ":engine_client",
        ":node_modules/@duckdb/duckdb-wasm",
        "test/planner.ts",
    ],
    entry_point = "test/snap.test.ts",
    wasm = True,
)

# A write's execution plan (the planner's executionPlan) run by the host's plan runner on DuckDB-WASM, in one
# transaction (plan-runner.ts; docs/DATACUBE_FLOW_MODE_2026_10_24.md M6)
node_test(
    name = "plan_runner_test",
    size = "small",
    data = [
        ":engine_client",
        ":node_modules/@duckdb/duckdb-wasm",
        "test/planner.ts",
    ],
    entry_point = "test/plan-runner.test.ts",
    wasm = True,
)

# The tab's warehouse driver held to the one corpus (docs/ONE_PLATFORM_PROGRAM_2026_10_12.md C3): each recorded scenario
# run against its answers through the binding's own module, the driver making exactly the recorded calls
node_test(
    name = "warehouse_corpus_test",
    # medium: it loads the binding's module (WebAssembly), as //query-store:wasm_test does
    size = "medium",
    data = [
        ":engine_client",
        ":node_modules/apache-arrow",
        "//warehouse:sqlapi_corpus",
        "//warehouse:sqlapi_page_dir",
    ],
    entry_point = "test/warehouse-corpus.test.ts",
    env = {
        "SQLAPI_CORPUS": "$(rlocationpath //warehouse:sqlapi_corpus)",
        "SQLAPI_PAGE": "$(rlocationpath //warehouse:sqlapi_page_dir)",
    },
    # the flag only: this test loads the binding's module, not the planner
    node_options = ["--experimental-wasm-exnref"],
)

# THE TAB'S DUCKDB EXTENSIONS, served by each site at vendor/duckdb-extensions/ (MODULE.bazel pins them): the layout
# DuckDB-WASM asks a custom extension repository for, <its version>/<its build>/<name>.duckdb_extension.wasm, so the
# tab never fetches one from extensions.duckdb.org (startDuckDbInTab, DataCube's boot.ts: custom_extension_repository).
# ICU, which the session's time zone loads (setUpSession); JSON and Parquet, which a file of either reads with; httpfs,
# a remote file's.
_DUCKDB_EXTENSIONS = [
    "httpfs",
    "icu",
    "json",
    "parquet",
]

# The DuckDB version this DuckDB-WASM asks a repository for (package.json's @duckdb/duckdb-wasm 1.33.1-dev57.0 is
# DuckDB v1.5.4): MODULE.bazel's URLs spell it too, and move with it (a .bzl file cannot be loaded there). A stale one
# fails loudly: the tab asks for another folder, and ICU's load fails every page's start.
_DUCKDB_VERSION = "v1.5.4"

# one per extension, for the one browser build the apps ship -- DuckDB's with WebAssembly exception handling (wasm_eh;
# duckdb-tab.ts refuses a browser without it) -- where DuckDB-WASM asks for it
[copy_file(
    name = "duckdb_extension_" + extension + "_wasm_eh",
    src = "@duckdb_wasm_" + extension + "_extension_wasm_eh//file",
    out = "duckdb-extensions/" + _DUCKDB_VERSION + "/wasm_eh/" + extension + ".duckdb_extension.wasm",
) for extension in _DUCKDB_EXTENSIONS]

filegroup(
    name = "duckdb_extensions",
    srcs = [":duckdb_extension_" + extension + "_wasm_eh" for extension in _DUCKDB_EXTENSIONS],
    visibility = [
        "//datacube:__pkg__",
        "//query:__pkg__",
        "//studio:__pkg__",
    ],
)

# the tab's warehouse driver held to the corpus Python's driver is held to too: //datacube:one_api_ledger_test (L12)
# names it as the warehouse's proof on both hosts, so reads it (copied to the output tree, where a JavaScript test reads
# its data: rules_js)
copy_to_bin(
    name = "warehouse_corpus_test_source",
    srcs = ["test/warehouse-corpus.test.ts"],
    visibility = ["//datacube:__pkg__"],
)

# every test here: the local gate and CI's `ui` lane run it
test_suite(
    name = "tests",
    tests = [
        ":arrow_ipc_test",
        ":model_data_test",
        ":node_duckdb_test",
        ":plan_runner_test",
        ":snap_test",
        ":update_generated_test",
        ":warehouse_corpus_test",
    ],
)
guards_package()
