# The engine client (README.md): where a query runs, for every app here -- the QueryEngine interface,
# results and receipts, the one reader of a column's type, legend-engine's pure/v1 client and its
# executor, DuckDB in the tab, and the warehouse. Moved out of datacube/ (2026-10-04) so DataCube, Query
# and Studio share it instead of reaching into one another. Its npm packages are its own lock (MODULE.bazel
# `npm_engine_client`): Apache Arrow, for the warehouse's result chunks and an engine's Arrow answers, and fzstd, the
# zstd frame those answers come in.
load("//tools/guards:defs.bzl", "guards_package")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/js:defs.bzl", "node_test")
load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@npm_engine_client//:defs.bzl", "npm_link_all_packages")
load("//tools/js:esbuild.bzl", "esbuild_bundle")
load("//tools/java:defs.bzl", "legend_java_library")
load("//tools/java_run:defs.bzl", "java_run")

npm_link_all_packages(name = "node_modules")

exports_files(["pnpm-lock.yaml", "package.json"])

# THE TARGETS, Java's shape (C5-T, 2026-11-15: the TypeScript split of plan and run; docs/TOTAL_WALL_START_HERE_2026_11_11.md
# section 6.1). The files stay where they are; each target lists its own, and every source is in exactly one (the load
# fails otherwise). Their direct deps are pinned by tools/deps/ts-layers.txt (//tools/deps:ts_layering_test, a
# genquery per target, as core-layers.txt pins Java's), and the run and planner targets are each typechecked alone
# (//tools/deps:layers_alone):
# - records: the shapes both sides read -- no send, no plan (Java's execution_plan, sql and result records);
# - engine_api: what can run -- the engines' interfaces and the run frame that opens a run; run, doors and apps reach
#   it, no planner and no server (2026-11-15, the C5-T final audit's MUST 1);
# - run: what sends a plan's statements and reads their rows: records and npm only, NO planner, no server, no door;
# - planner: legend-lite's planner in the tab and its planning client (no execute): records and the protocol only;
# - server: legend-engine's API clients, whose execute is the SERVER's door;
# - doors: the one target over both -- each asks the planner, then runs the answer in a run frame (run-frame.ts);
# - edge: legend-engine's API in TypeScript (H11, 2026-11-17) -- its wire shapes, its refusal, its Grammar and Engine,
#   their HTTP clients and their tab bindings -- over the layers above; no product layer and no app reaches it.
_RECORDS = [
    # the raises the plans declare (phase D's option (D), 2026-11-15): a plan reader of either side declares them, the
    # run side words a failure from them -- no send, no plan
    "src/declared-raises.ts",
    # the planner's folded answers, read and written once (H4's P3, 2026-11-19): a record both sides read
    "src/folded.ts",
    # lite's error kinds and their statuses (H4's P2, 2026-11-19), generated: the record lite-error.ts reads
    "src/generated/lite-errors.ts",
    "src/generated/lite-facts.ts",
    # a product raise's envelope marks (#104's M2(b)): facts both sides may read
    "src/generated/lite-raise.ts",
    "src/json-unknown.ts",
    # lite's one error shape (lite's API v1 spec §3, 2026-11-17): a record both bindings read
    "src/lite-error.ts",
    "src/legend/pmcd.ts",
    "src/legend/wire.ts",
    "src/locale.ts",
    "src/plan-guard.ts",
    "src/plan-params.ts",
    "src/planned-sql.ts",
    "src/receipt.ts",
    "src/relation-type.ts",
    "src/requests.ts",
    "src/result.ts",
    "src/sha256.ts",
    "src/types.ts",
    "src/values.ts",
]

# THE ENGINE'S API (2026-11-15, the C5-T final audit's MUST 1): what can RUN -- the engines' interfaces, whose methods
# send (QueryEngine, HeldConnection, PointedEngine, LiveWarehouse), and the run frame, which opens a run. Out of the
# records (the last round's T1 had put them there, so a planner or a server layer could take an engine and run on it):
# run, doors and apps reach it; no planner or server layer does (tools/deps/ts-layers.txt). The planner's check of the
# frame is a record (plan-guard.ts), which reads the run this module installs and cannot open one.
_ENGINE_API = [
    "src/query-engine.ts",
    "src/run-frame.ts",
    "src/warehouse-session.ts",
]

_RUN = [
    "src/arrow-ipc.ts",
    "src/connection-settings.ts",
    "src/duckdb-tab.ts",
    "src/duckdb-wasm.ts",
    "src/duckdb.ts",
    "src/engine.ts",
    "src/host-operations.ts",
    "src/model-data.ts",
    "src/plan-runner.ts",
    "src/project-data.ts",
    # a send's failure worded (#104's M2(b)): the run side's
    "src/raised.ts",
    "src/warehouse.ts",
]

# 2026-11-15 (the C5-T audit's item 3): the planner's protocol (PlannerWorker, its requests) and Grammar out of the
# records, which handed the run side a typed way into the planner
_PLANNER = [
    "src/legend/planner-answer.ts",
    "src/legend/planner-protocol.ts",
    "src/legend/planner-worker.ts",
    "src/legend/wasm-grammar.ts",
    "src/planner-sources.ts",
]

# the multi-step doors kept in place (the orchestrator's note 3: each made one keyed plan later, the backlog of
# docs/records/c5-typescript-2026-11-15.md)
_DOORS = glob(["src/doors/**/*.ts"]) + [
    # a remote executor's shape, the product's (H11, 2026-11-17: out of engine-remote.ts, which is the edge's)
    "src/remote-executor.ts",
    "src/legend/browser-engine.ts",
    "src/snap.ts",
    "src/tab-data.ts",
]

# LEGEND-ENGINE'S API, THE EDGE'S (H11, 2026-11-17: the orchestrator's go; lite's API v1 spec §6, "no product module
# depends on the edge"): its wire shapes (engine-wire.ts, out of wire.ts, whose model input stays the product's), its
# refusal (engine-api.ts, out of the records), its Grammar and HTTP planning client (grammar.ts, planning-client.ts, out
# of the planner), its engines (engine.ts, out of the server layer), and its tab bindings over the product's planner and
# runner (wasm-edge.ts, out of the planner; edge-engine.ts's BrowserEngine, out of browser-engine.ts). Over the layers
# above, never under them: no product target depends on it -- an app's compat entry alone, loaded when configured
# `engine: legend-engine` (the orchestrator's alignment, the same day; tools/deps/ts-layers.txt, TsLayeringTest
# EDGE_ENTRIES and noAppReachesTheEdge) -- no product module imports one of its files (//tools/deps:app_runs_test), and
# the aggregate below does not carry it: a test that builds legend-engine's engines names it.
_EDGE = [
    "src/legend/edge-engine.ts",
    "src/legend/engine-api.ts",
    # legend-engine's routes in the tab, the engine module (the user's K2 ruling, 2026-11-18: "Product root, edge opt-in")
    "src/legend/engine-module.ts",
    "src/legend/engine-wire.ts",
    "src/legend/engine.ts",
    "src/legend/grammar.ts",
    "src/legend/planning-client.ts",
    "src/legend/wasm-edge.ts",
    # (H11's moves, DataCube's half, 2026-11-17: legend-engine's pure/v1 client and its planning half, out of the server
    # and planner layers -- the server layer, emptied, is deleted -- and its executor, out of the doors; each file at its
    # own path, as this BUILD's convention keeps them)
    "src/engine-remote.ts",
    "src/pure-v1-planning.ts",
    "src/pure-v1.ts",
]

# NODE'S HOST, for code run in Node alone -- tests, benchmarks and harnesses: a require rooted in this package, and
# DuckDB-WASM's blocking build started with the pinned extensions (node-require.ts). No layer: no product module imports
# it, and the run layer, which the browser bundles carry, holds no require door (the C5-T audit's item 8, 2026-11-15)
_NODE_HOST = ["src/node-require.ts"]

_ASSIGNED = _RECORDS + _ENGINE_API + _RUN + _PLANNER + _DOORS + _EDGE + _NODE_HOST

[fail("engine-client/%s is in no target of engine-client/BUILD.bazel: add it to the one whose layer it is" % f) for f in glob(["src/**/*.ts"]) if f not in _ASSIGNED]

[fail("engine-client/%s is listed twice in engine-client/BUILD.bazel's targets" % f) for i, f in enumerate(_ASSIGNED) if f in _ASSIGNED[:i]]

_APPS = [
    "//datacube:__pkg__",
    "//query:__pkg__",
    "//studio:__pkg__",
]

js_library(
    name = "records",
    srcs = _RECORDS,
    visibility = _APPS + ["//tools/deps:__pkg__"],
    # pure/v1's queries and the model's text are built and read as protocol JSON
    deps = ["//pure-protocol:pure_protocol"],
)

js_library(
    name = "engine_api",
    srcs = _ENGINE_API,
    visibility = _APPS + ["//tools/deps:__pkg__"],
    deps = [":records"],
)

js_library(
    name = "run",
    srcs = _RUN,
    visibility = _APPS + ["//tools/deps:__pkg__"],
    deps = [
        ":engine_api",
        ":records",
        # DuckDB in the tab (duckdb-wasm.ts re-exports it for the apps), and the Arrow it brings -- the one copy every
        # bundle carries, which the warehouse's Arrow IPC chunks are read with too
        ":node_modules/@duckdb/duckdb-wasm",
        ":node_modules/apache-arrow",
    ],
)

js_library(
    name = "planner",
    srcs = _PLANNER,
    visibility = _APPS + ["//tools/deps:__pkg__"],
    deps = [
        ":records",
        "//pure-protocol:pure_protocol",
    ],
)

js_library(
    name = "doors",
    srcs = _DOORS,
    visibility = _APPS + ["//tools/deps:__pkg__"],
    deps = [
        ":engine_api",
        ":planner",
        ":records",
        ":run",
        "//pure-protocol:pure_protocol",
        ":node_modules/apache-arrow",
    ],
)

js_library(
    name = "edge",
    srcs = _EDGE,
    # the tests that build legend-engine's engines (DataCube's python-engine execute, Studio's engine and modules) and
    # the layering census; no app's product target (tools/deps/ts-layers.txt)
    visibility = [
        "//datacube:__pkg__",
        "//studio:__pkg__",
        "//tools/deps:__pkg__",
    ],
    deps = [
        ":doors",
        ":engine_api",
        ":planner",
        ":records",
        ":run",
        "//pure-protocol:pure_protocol",
        # legend-engine's executor reads its Arrow answers (engine-remote.ts), its client their zstd frame (pure-v1.ts;
        # fzstd 0.1.1, exact, the user's approval of 2026-10-08: legend-engine's Arrow answer to execute is ALWAYS one
        # zstd frame, RelationalResultToArrowIPCSerializer; moved here from the deleted server layer, H11 2026-11-17)
        ":node_modules/apache-arrow",
        ":node_modules/fzstd",
    ],
)

js_library(
    name = "node_host",
    srcs = _NODE_HOST,
    visibility = _APPS + ["//tools/deps:__pkg__"],
    # what it starts in Node: DuckDB-WASM's blocking build (required at run time, rooted here)
    deps = [":node_modules/@duckdb/duckdb-wasm"],
)

# every layer at once, what the apps depend on (their own layers name the one they reach: tools/deps/ts-layers.txt),
# and Node's host for their Node tests and harnesses -- never the edge (H11, 2026-11-17: an app that took this would
# take legend-engine's API with it)
js_library(
    name = "engine_client",
    srcs = ["package.json"],
    visibility = _APPS,
    deps = [
        ":doors",
        ":engine_api",
        ":node_host",
        ":planner",
        ":records",
        ":run",
    ],
)

# every source of the package, as files, for a scanner that reads them by $(rlocationpaths) (DataCube's guardrails and
# run wall): the layers' own files are each layer's, and the aggregate above has none of its own. A js_library, so a
# test of another package takes them (rules_js copies a source to the output tree only from its own package); no
# product target depends on it (tools/deps/ts-layers.txt pins every layer's deps)
js_library(
    name = "sources",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    # (2026-11-15, the C5-T last round's T1: the apps' census follows a re-export through the engine client's modules)
    visibility = [
        "//datacube:__pkg__",
        "//tools/deps:__pkg__",
    ],
)

# each layer's direct deps, as Bazel resolves them: //tools/deps:ts_layering_test holds them to tools/deps/ts-layers.txt
[genquery(
    name = "layer_" + layer,
    expression = "labels(deps, //engine-client:%s)" % layer,
    scope = [":" + layer],
    visibility = ["//tools/deps:__pkg__"],
) for layer in ["records", "engine_api", "run", "planner", "doors", "edge", "node_host"]]

filegroup(
    name = "layer_queries",
    srcs = [":layer_" + layer for layer in ["records", "engine_api", "run", "planner", "doors", "edge", "node_host"]],
    visibility = ["//tools/deps:__pkg__"],
)

# legend-lite's planner in a worker (src/legend/planner-worker.ts), one bundle for every app that runs it in the
# tab, answering the one planner protocol (src/legend/planner-protocol.ts; docs/ONE_PLATFORM_PROGRAM_2026_10_12.md C2):
# DataCube, Query and Studio serve it as their ./planner-worker.js, next to //wasm:planner's module.
esbuild_bundle(
    name = "planner_worker",
    # the planner layer whole, its records with it (2026-11-15, the C5-T final audit's finding from the Java worker's
    # gate: three files named by hand left out what planner-answer.ts imports -- run-frame.ts on main, plan-guard.ts here
    # -- and esbuild found it outside the sandbox only when another action had copied it; //tools/deps:bundle_inputs_test)
    srcs = [":planner"],
    outs = ["planner-worker.js"],
    args = [
        "src/legend/planner-worker.ts",
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--log-level=warning",
        "--outfile=planner-worker.js",
    ],
    visibility = [
        "//datacube:__pkg__",
        "//query:__pkg__",
        "//studio:__pkg__",
    ],
)

# the load runners' shared conformance fixture (B3, 2026-11-11): the tab's runLoad and Python's run_load run it alike
exports_files(
    ["test/fixtures/run-load-conformance.json"],
    visibility = ["//python:__pkg__"],
)

# the keyed expansion's one fixture (the C final audit's H8, 2026-11-12): Java's PlanRunner.expand, the tab's
# expandKeyed and Python's _keyed_text each read it
exports_files(
    ["test/fixtures/keyed-expansion.json"],
    visibility = ["//core:__pkg__", "//python:__pkg__"],
)

# a product raise's envelope, one set of cases (#104's M2(b), 2026-11-15): Java's RaisedErrors, the tab's raised.ts and
# Python's _raised.py each read it and must agree
exports_files(
    ["test/fixtures/raise-envelopes.json"],
    visibility = ["//core:__pkg__", "//python:__pkg__"],
)

# lite API v1's conformance suite (docs/records/lite-api-v1-2026-11-17.md §5, the user's go of 2026-11-17): one set of
# cases the three bindings answer alike -- the browser's (//core:lite_api_conformance_test), the server's and Python's
exports_files(
    ["test/fixtures/lite-api-cases.json"],
    visibility = ["//core:__pkg__", "//python:__pkg__"],
)

# the host sources the data mechanism census reads (DataMechanismCensusTest: a deleted mechanism's host spellings read
# zero here too -- the B checkpoint's tenets audit, M4, 2026-11-11)
filegroup(
    name = "census_src",
    srcs = glob(["src/**/*.ts"]),
    visibility = ["//core:__pkg__"],
)

# THE BUNDLES ENGINE-CLIENT SHIPS (//:web; docs/BUILD_REBUILD_DESIGN_2026_10_05.md, D10): the planner's worker, which
# Query and Studio copy into their sites
filegroup(
    name = "bundles",
    srcs = [":planner_worker"],
    visibility = ["//:__pkg__"],
)

# Every TypeScript file here, the tests too, for DataCube's typecheck (strict tsc: this package has no TypeScript of
# its own, so it borrows DataCube's rather than a second lock; its sources are also checked through each app's imports)
js_library(
    name = "typescript_sources",
    srcs = glob(["src/**/*.ts", "test/**/*.ts"]) + ["package.json"],
    visibility = ["//datacube:__pkg__"],
)

# LITE'S FACTS (DataCube decision D1, docs/DATACUBE_TYPES_TO_SERVER_2026_09_27.md): the type families and
# the pivot separator, generated by RUNNING legend-lite (a Java program over Type.Primitive and its
# constants), never by reading its source; a diff test on the committed copy:
# `bazel run //engine-client:update_generated`.
legend_java_library(
    name = "type_facts_main",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = ["tools/typefacts/TypeFacts.java"],
    # a product raise's envelope (#104's M2(b), 2026-11-15): exec.RaisedErrors's marks and sql.RaiseKind's; its words
    # are the plans' own since 2026-11-15 (PlanJson.raises, phase D's option (D)), so error.ErrorKind is not read here
    # lite's error kinds and their statuses (H4's P2, 2026-11-19): lite.LiteWire.Kind; lite's Arrow metadata keys
    # (H4's P10): result.ArrowKeys; the plan format (H4's P8): executionplan.PlanJson.VERSION
    deps = ["//core:compiler_element_type", "//core:exec", "//core:execution_plan", "//core:lite_wire", "//core:result",
            "//core:sql"],
)

java_run(
    name = "lite_facts",
    outs = ["generated/lite-facts.gen.ts"],
    arguments = [
        "ts",
        "{OUT}",
    ],
    main_class = "typefacts.TypeFacts",
    deps = [":type_facts_main"],
)

# a product raise's envelope marks (#104's M2(b), 2026-11-15), a module of their own that raised.ts reads; the words are
# the plans' own since phase D's option (D) (PlanJson.raises, declared-raises.ts)
java_run(
    name = "lite_raise",
    outs = ["generated/lite-raise.gen.ts"],
    arguments = [
        "raise-ts",
        "{OUT}",
    ],
    main_class = "typefacts.TypeFacts",
    deps = [":type_facts_main"],
)

# lite's error kinds and the HTTP status each is answered with (H4's P2, the user's CP-13 of 2026-11-19), a module of
# their own that lite-error.ts reads: never a hand list
java_run(
    name = "lite_errors",
    outs = ["generated/lite-errors.gen.ts"],
    arguments = [
        "errors-ts",
        "{OUT}",
    ],
    main_class = "typefacts.TypeFacts",
    deps = [":type_facts_main"],
)

# the same table for Python's reading of a column's type (python/legend_lite/_types.py,
# docs/PYTHON_ASKS_DATACUBE_2026_10_15.md item 4): committed and diff-tested by //python:update_generated
java_run(
    name = "lite_facts_py",
    outs = ["generated/type_facts.gen.py"],
    arguments = [
        "py",
        "{OUT}",
    ],
    main_class = "typefacts.TypeFacts",
    visibility = ["//python:__pkg__"],
    deps = [":type_facts_main"],
)

write_source_files(
    name = "update_generated",
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nlegend-lite changed a fact the engine client mirrors -- regenerate: bazel run //engine-client:update_generated, then read the diff (a changed Pure kind or pivot separator changes what a grid shows)",
    files = {
        "src/generated/lite-errors.ts": ":lite_errors",
        "src/generated/lite-facts.ts": ":lite_facts",
        "src/generated/lite-raise.ts": ":lite_raise",
    },
    visibility = ["//:__pkg__"],
)

