###Relational

Database pricing::Store
(
   Table PR_CURVE_KNOT
   (
      SCENARIO_ID VARCHAR(40) PRIMARY KEY,
      CURVE_ID VARCHAR(40) PRIMARY KEY,
      KNOT_IDX SMALLINT PRIMARY KEY,
      KNOT_T FLOAT NOT NULL,
      ZERO_RATE FLOAT NOT NULL,
      INTERP_METHOD VARCHAR(20) NOT NULL
   )

   Table PR_CASHFLOW
   (
      TRADE_ID VARCHAR(40) PRIMARY KEY,
      LEG_ID VARCHAR(20) PRIMARY KEY,
      CF_IDX SMALLINT PRIMARY KEY,
      INSTRUMENT_TYPE VARCHAR(20) NOT NULL,
      CCY CHAR(3) NOT NULL,
      CSA VARCHAR(40) NOT NULL,
      DISCOUNT_CURVE_ID VARCHAR(40) NOT NULL,
      PROJ_CURVE_ID VARCHAR(40),
      ACCRUAL_START_T FLOAT NOT NULL,
      ACCRUAL_END_T FLOAT NOT NULL,
      PAY_T FLOAT NOT NULL,
      DCF FLOAT NOT NULL,
      NOTIONAL FLOAT NOT NULL,
      FIXED_RATE FLOAT NOT NULL,
      SPREAD FLOAT NOT NULL,
      IS_FLOAT BIT NOT NULL,
      PAY_RECEIVE FLOAT NOT NULL
   )
)
