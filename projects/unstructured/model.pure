      asOfDate: [store::Corpus]CO_PASSAGE.AS_OF_DATE
   }

)

###Connection
// The path is relative to the repository root; tools/unstructured-corpus/load.py writes this file. All four stores live in it.
RelationalDatabaseConnection connection::DuckDb
{
   type: DuckDB;
   specification: DuckDB { path: 'projects/unstructured/corpus/unstructured.duckdb'; };
   auth: Test;
}

// load.py takes its server from PG_URL. These coordinates are this runtime's, and lite's PostgresConnector opens them
// without credentials.
RelationalDatabaseConnection connection::Postgres
{
   type: Postgres;
   specification: Static { name: 'unstructured'; host: 'localhost'; port: 5432; };
   auth: Test;
}

###Runtime
Runtime runtime::DuckDb
{
   mappings:
   [
      mapping::Edgar,
      mapping::Sales,
      mapping::Lending,
      mapping::Corpus
   ];
   connections:
   [
      store::Edgar: [ environment: connection::DuckDb ],
      store::Sales: [ environment: connection::DuckDb ],
      store::Lending: [ environment: connection::DuckDb ],
      store::Corpus: [ environment: connection::DuckDb ]
   ];
}

Runtime runtime::Postgres
{
   mappings:
   [
      mapping::Edgar,
      mapping::Sales,
      mapping::Lending,
      mapping::Corpus
   ];
   connections:
   [
      store::Edgar: [ environment: connection::Postgres ],
      store::Sales: [ environment: connection::Postgres ],
      store::Lending: [ environment: connection::Postgres ],
      store::Corpus: [ environment: connection::Postgres ]
   ];
}
