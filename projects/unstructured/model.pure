   {
      ~primaryKey ( [store::Corpus]CO_PASSAGE.SOURCE, [store::Corpus]CO_PASSAGE.FILE_PATH, [store::Corpus]CO_PASSAGE.ORDINAL )
      ~mainTable [store::Corpus]CO_PASSAGE
      source: EnumerationMapping CorpusSourceMap: [store::Corpus]CO_PASSAGE.SOURCE,
      path: [store::Corpus]CO_PASSAGE.FILE_PATH,
      sectionOrDoc: [store::Corpus]CO_PASSAGE.SECTION_OR_DOC,
      ordinal: [store::Corpus]CO_PASSAGE.ORDINAL,
      charStart: [store::Corpus]CO_PASSAGE.CHAR_START,
