# The unstructured study's model. Its own package, outside //projects' PROJECT_DEPS graph: it is a study, not one of the
# firm-model projects CONTRACT.md governs, and it links nothing from them.
load("//tools/guards:defs.bzl", "guards_package")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/legend:defs.bzl", "legend_library")

legend_library(
    name = "unstructured",
    srcs = ["model.pure"],
)

# The model over the loaded corpus. Manual, outside //gates:local: the filings are never committed, so a checkout has none
# until someone rebuilds them, and this FAILS without them, naming the rebuild. "local" because the test finds the corpus
# through its source file's real path.
junit_test(
    name = "corpus_test",
    size = "medium",
    data = [
        "evals/DECISIONS.md",
        "evals/answer_key.yaml",
        "model.pure",
    ],
    env = {
        "UNSTRUCTURED_ANSWER_KEY": "$(rlocationpaths :evals/answer_key.yaml)",
        "UNSTRUCTURED_DECISIONS": "$(rlocationpaths :evals/DECISIONS.md)",
        "UNSTRUCTURED_MODEL": "$(rlocationpaths :model.pure)",
    },
    memory_mb = 1024,
    select = ["--select-class=com.legend.tools.legend.UnstructuredCorpusTest"],
    tags = [
        "local",
        "manual",
    ],
    runtime_deps = [
        "//core:drivers",
        "//tools/legend:unstructured_corpus_test_lib",
    ],
)

guards_package()
