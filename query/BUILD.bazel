# Legend Query, rebuilt light (docs/QUERY_APP_DESIGN_2026_09_30.md): plain TypeScript and DOM,
# bundled by esbuild, tested with node's own runner. Its npm packages are its own lock
# (MODULE.bazel `npm_query`), so DataCube's lock never moves for it.
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("//tools/js:defs.bzl", "node_test")
load("//tools/browser:defs.bzl", "browser_test")
load("//tools/runfiles:defs.bzl", "executable_of")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@npm_query//:defs.bzl", "npm_link_all_packages")
load("//tools/js:esbuild.bzl", "esbuild_bundle")
load("@npm_query//query:typescript/package_json.bzl", typescript = "bin")
load("//tools/guards:defs.bzl", "guards_package")

npm_link_all_packages(name = "node_modules")

exports_files(["pnpm-lock.yaml", "package.json"])

# The trading project's model and seed: DataCube serves them too, to open a saved query over them.
exports_files(
    glob(["demo/models/*"]),
    visibility = [
        "//datacube:__pkg__",
        "//fixtures/saved-queries:__pkg__",
    ],
)

js_library(
    name = "src",
    srcs = glob(["src/**/*.ts", "src/**/*.css"]) + ["package.json", "tsconfig.json"],
    deps = [
        # projects opened by name: the model home (the page's SDLC and Depot, or servers) and its Depot (by-name.ts)
        "//depot-client:depot_client",
        # upstream Legend's icons, shared with Studio (legend-art/src/icons.ts)
        "//legend-art:legend_art",
        "//pure-protocol:pure_protocol",
        # saved queries: the one client, and the store answered in the page (query-store/README.md)
        "//query-store:query_store",
        # DataCube's grid, for the results (datacube/src/embed.ts)
        "//datacube:src",
        # where queries run: DuckDB-WASM, the warehouse, legend-engine's pure/v1 (engine-client/README.md)
        "//engine-client:engine_client",
    ],
)

# entry point -> bundle
_BUNDLES = {
    "demo/main.ts": "demo/bundle.js",
    "../engine-client/src/legend/planner-worker.ts": "demo/planner-worker.js",
}

[esbuild_bundle(
    name = "bundle_" + out[len("demo/"):-len(".js")].replace("-", "_"),
    srcs = glob(["demo/**/*.ts"]) + [":src", "//engine-client:node_modules/@duckdb/duckdb-wasm"],
    outs = [out],
    args = [
        entry,
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--log-level=warning",
        "--outfile=" + out,
    ],
) for entry, out in _BUNDLES.items()]

# THE BUNDLES QUERY SHIPS (//:web; docs/BUILD_REBUILD_DESIGN_2026_10_05.md, D10): the app and the planner's worker.
filegroup(
    name = "bundles",
    srcs = [
        ":bundle_bundle",
        ":bundle_planner_worker",
    ],
    visibility = ["//:__pkg__"],
)

# The two WebAssembly runtimes the page loads from ./vendor/: legend-lite's planner (grammar,
# typing, SQL in the tab) and DuckDB's (where queries run in the browser).
copy_to_directory(
    name = "vendor",
    srcs = [
        "//engine-client:node_modules/@duckdb/duckdb-wasm",
        # upstream Legend Query's type (legend-art _fonts.scss): Roboto, Roboto Mono, Raleway 900
        # for the type letters -- from legend-art (the pinned @fontsource), served with the site, no font CDN (OFL-1.1)
        "//legend-art:fonts",
        "//legend-art:styles",
        "//sdlc-server:page",
        "//wasm:planner",
    ],
    out = "demo/vendor",
    include_srcs_patterns = [
        "wasm/planner/classes.wasm",
        "wasm/planner/wasm-gc-module-runtime.js",
        "sdlc-server/page/classes.wasm",
        "sdlc-server/page/wasm-gc-module-runtime.js",
        "**/dist/duckdb-mvp.wasm",
        "**/dist/duckdb-eh.wasm",
        "**/dist/duckdb-browser-mvp.worker.js",
        "**/dist/duckdb-browser-eh.worker.js",
        "legend-art/fonts/roboto-latin-300-normal.woff2",
        "legend-art/fonts/roboto-latin-400-normal.woff2",
        "legend-art/fonts/roboto-latin-500-normal.woff2",
        "legend-art/fonts/roboto-latin-700-normal.woff2",
        "legend-art/fonts/roboto-latin-900-normal.woff2",
        "legend-art/fonts/roboto-mono-latin-400-normal.woff2",
        "legend-art/fonts/roboto-mono-latin-700-normal.woff2",
        "legend-art/fonts/raleway-latin-900-normal.woff2",
        "legend-art/fonts/LICENSE-*.txt",
        "legend-art/src/*.css",
    ],
    replace_prefixes = {
        "wasm/planner/": "",
        "sdlc-server/page/": "sdlc/",
        "**/dist/": "",
        "legend-art/fonts/": "fonts/",
        "legend-art/src/": "legend-art/",
    },
)

# DataCube's stylesheets, as ./cube/: the results grid is a CubeApp (theme.css, grid/grid.css, app.css).
copy_to_directory(
    name = "cube_styles",
    srcs = ["//datacube:styles"],
    out = "demo/cube",
    root_paths = ["datacube/src"],
)

# Everything a browser fetches.
filegroup(
    name = "site",
    # served beside the other app from one origin (//site): they share the browser's query store
    visibility = ["//site:__pkg__"],
    srcs = glob([
        "demo/*.html",
        "demo/*.json",
        "demo/*.css",
        "demo/models/*.pure",
        "demo/models/*.sql",
        "src/**/*.css",
    ]) + [":bundle_" + out[len("demo/"):-len(".js")].replace("-", "_") for out in _BUNDLES.values()] + [":vendor", ":cube_styles"],
)

# `bazel run //query:serve [-- --port 8100]`: the site, on loopback. A hand tool: manual (2026-10-07, PHASE_8.md
# Gen-5), built by :tools_build_test.
js_binary(
    name = "serve",
    data = [":site"],
    entry_point = "demo/serve.mjs",
    tags = ["manual"],
)

# THE APP END TO END, AS A TEST (the build rebuild's L1b, 2026-10-07): in the pinned Chromium, in the browser, against a
# legend-lite server and against a warehouse the test starts, both on port 0. CI runs it on Linux only (the tag;
# gates-run.yml filters it on macOS and Windows: the browser part is the same on every platform, and live-vs-snap
# already checks x86_64 against the arm64 desks); a desk runs it anywhere.
# legend-lite's server's launcher, exactly one file (server.exe on Windows), for the test to start by runfiles path
# (Bazel workplan P1-24; as //query-store:lite_test does)
executable_of(
    name = "legend_server",
    testonly = True,
    binary = "//core:server",
)

_VERIFY_DATA = [
    # named itself: SITE is its runfiles path, from which the site's directory follows
    "demo/index.html",
    ":site",
    ":node_modules/playwright",
    # legend-lite's server: its launcher's runfiles (the hermetic JDK, the jars) through the target itself, and the
    # one launcher file to start through :legend_server
    "//core:server",
    ":legend_server",
    # the warehouse, as DataCube's live_snap_test runs it: the native image and its DuckDB
    "//warehouse:duckdb_library",
    "//warehouse:server_native",
]

# every input by its runfiles path (tools/js/runfiles.mts), never by path arithmetic
_VERIFY_ENV = {
    "LEGEND_SERVER": "$(rlocationpath :legend_server)",
    "SITE": "$(rlocationpath demo/index.html)",
    "WAREHOUSE_BINARY": "$(rlocationpath //warehouse:server_native)",
    "WAREHOUSE_DUCKDB_LIBRARY": "$(rlocationpath //warehouse:duckdb_library)",
}

browser_test(
    name = "verify_test",
    size = "large",
    data = _VERIFY_DATA,
    entry_point = "demo/verify.mjs",
    env = _VERIFY_ENV,
    tags = ["ci-linux-only"],
)

# `bazel run //query:verify`: the same by hand (manual, 2026-10-07; it writes under the checkout's .scratch/); test
# tooling, so testonly like the server file it starts
js_binary(
    name = "verify",
    testonly = True,
    data = _VERIFY_DATA + [
        # it imports pinned-chromium.mjs first, a no-op under bazel run
        "//tools/browser:pinned_chromium",
        # the runfiles helper (a node_test has it already)
        "//tools/js:runfiles",
    ],
    entry_point = "demo/verify.mjs",
    env = _VERIFY_ENV,
    tags = ["manual"],
)

# every hand tool of this package compiles (the build rebuild's L1b): built, nothing runs. In the ui lane, and on
# Linux only in CI like the test (:verify's closure holds the native image, which that lane builds there anyway).
build_test(
    name = "tools_build_test",
    tags = ["ci-linux-only"],
    targets = [
        ":serve",
        ":verify",
    ],
)

_TESTS = glob(["test/*.test.ts"])

_WASM_TESTS = [
    "build",
    "load",
    "saved-queries",
]

# the demo's models, by runfiles path for the tests that read them (QUERY_MODELS; Bazel workplan P1-24)
filegroup(
    name = "demo_models",
    srcs = glob(["demo/models/*.pure"]),
)

[node_test(
    name = t[len("test/"):-len(".test.ts")].replace("-", "_") + "_test",
    size = "small",
    data = [
        ":src",
        # the saved-query records Query writes and DataCube reads (fixtures/saved-queries/README.md)
        "//fixtures/saved-queries:records",
        ":demo_models",
    ] + glob(["test/*.ts"], exclude = ["test/*.test.ts"]) + (
        ["//pure-protocol:pure_protocol", "//query-store:query_store"] if t[len("test/"):-len(".test.ts")] in _WASM_TESTS else []
    ),
    entry_point = t,
    env = {
        "QUERY_MODELS": "$(rlocationpaths :demo_models)",
        "SAVED_QUERIES": "$(rlocationpaths //fixtures/saved-queries:records)",
    },
    wasm = t[len("test/"):-len(".test.ts")] in _WASM_TESTS,
) for t in _TESTS]

typescript.tsc_test(
    name = "typecheck_test",
    size = "small",
    args = ["-p", package_name() + "/tsconfig.json"],
    data = glob([
        "src/**/*.ts",
        "test/**/*.ts",
        "demo/**/*.ts",
    ]) + [
        "//tools/js:runfiles",
        "package.json",
        "tsconfig.json",
        "//pure-protocol:pure_protocol",
        "//query-store:query_store",
        "//datacube:src",
        "//engine-client:engine_client",
        "//depot-client:depot_client",
        "//legend-art:legend_art",
        "//sdlc-client:sdlc_client",
        "//engine-client:node_modules/@duckdb/duckdb-wasm",
        ":node_modules/@types/node",
    ],
)

test_suite(
    name = "tests",
    tests = [t[len("test/"):-len(".test.ts")].replace("-", "_") + "_test" for t in _TESTS] + [":typecheck_test"],
)

guards_package()
