# One JDK for everyone, from the build: nothing depends on the machine's java.
common --enable_bzlmod
# Bytecode is Java 21 (root pom maven.compiler.target); tests RUN on JDK 25, the
# JDK the gates run on (.github/actions/gate-env: java-version "25"). The two
# differ observably: BigDecimal.valueOf(NaN)'s message, which the PCT
# expected-failure pins record (Test_LegendLite_EssentialFunctions_PCT).
build --java_language_version=21
build --java_runtime_version=remotejdk_25
build --tool_java_language_version=21
build --tool_java_runtime_version=remotejdk_21
# the engine's test clock (root pom surefire argLine) — one clock, everywhere
test --test_env=TZ=GMT
test --jvmopt=-Duser.timezone=GMT
