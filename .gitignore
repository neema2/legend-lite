# IDE

# IntelliJ and its Bazel plugin
.idea/
*.iml
.bazelbsp/

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# DuckDB artifacts (at the root only: `null` alone also hid the TCK's features/expressions/null/ directory from git, 2026-10-16)
/null
/null.wal
runs/
core/javac.*.args

# Python bytecode caches: build artifacts, and they bake an absolute path into git.
__pycache__/
*.pyc

# Bazel
/bazel-*

# The EDGAR corpus is a pointer corpus: filings are rebuilt locally by tools/edgar-corpus and never committed or
# redistributed. The manifest is the repository's record (2026-11-08).
projects/unstructured/corpus/edgar/**
!projects/unstructured/corpus/edgar/manifest.yaml
!projects/unstructured/corpus/edgar/README.md
