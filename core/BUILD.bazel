# core, as targets. It began as ONE java_library (the Bazel migration's first
# step, 2026-09-22: "can Bazel compile this at all" before "is the graph right");
# on 2026-09-26 (execution plan step 0c) it became one target per package group
# — see "CORE AS TARGETS" below — with `:core` kept as the umbrella consumers
# depend on. Bazel now refuses a back-edge at compile time.

load("@rules_java//java:defs.bzl", "java_test")
load("//tools/java:defs.bzl", "legend_java_binary", "legend_java_library")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/clickhouse:defs.bzl", "EMBEDDED_CLICKHOUSE_COMPATIBLE")
load("//tools/postgres:defs.bzl", "EMBEDDED_POSTGRES_COMPATIBLE")
load("//tools/mongodb:defs.bzl", "EMBEDDED_MONGODB_COMPATIBLE")
load("//tools/java_run:defs.bzl", "java_run")
load("//tools/jars:defs.bzl", "file_list", "java_jars")
load("//tools/guards:defs.bzl", "guards_package")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//tools/runfiles:defs.bzl", "executable_of")
load("//tools/platforms:defs.bzl", "compatible_with")
load(":layers.bzl", "core_layer_queries")
load(":stress.bzl", "LINKED_PROJECTS", "STRESS_GENERATED", "stress_index", "stress_layout")
load(":edge_tests.bzl", "EDGE_TEST_SRCS", "edge_test_classes", "product_tests_closure")

# PRIVATE BY DEFAULT (Bazel workplan P1-20): a target is visible outside core only where it says to whom.
package(default_visibility = ["//visibility:private"])

# legend-engine's own Arrow answer to execute (4.145.0, recorded with upstream-api/e8-arrow-groupby-sort.json): DataCube's
# remote client reads it in //datacube:python_engine_test, as it reads Python's engine
exports_files(
    ["src/test/resources/upstream-api/e8-arrow-groupby-sort.arrows.zst"],
    visibility = ["//datacube:__pkg__"],
)

# core's sources, exported for spec's generator parity checks (they compare the
# committed generated files — prelude.pure, Pure.java's signature text — against
# what upstream says they should be).
filegroup(
    name = "srcs",
    srcs = glob(["src/**"], exclude = ["**/*.md"]),
    visibility = ["//parser-equivalence:__pkg__", "//spec:__pkg__"],
)

# the main sources and resources as files: what spec's parity tests read (CoreTree; Bazel workplan P3-07)
filegroup(
    name = "main_srcs",
    srcs = glob(["src/main/**"], exclude = ["**/*.md"]),
    # the planned-SQL guard reads who reaches the authored door (the C final audit's H1, 2026-11-12)
    visibility = ["//spec:__pkg__", "//tools/guards:__pkg__"],
)

# the test sources as files: parser-equivalence's own corpus is the Pure snippets they embed (InlineSnippets reads
# src/test/**/*.java and nothing else; Bazel workplan P3-07)
filegroup(
    name = "test_java",
    srcs = glob(["src/test/**/*.java"]),
    visibility = ["//parser-equivalence:__pkg__"],
)


# THE NULL GATE: every library is a legend_java_library (//tools/java, Bazel workplan P1-20), which adds
# NullAway's plugin and flags (//tools/nullaway) unless the target says `nullaway = False`.

# CORE AS TARGETS (execution plan step 0c, 2026-09-26). One java_library per
# package group, each naming its direct dependencies, so a reference from a
# lower layer to a higher one is a build error in the file being written — not
# an ArchUnit finding after the fact. The grouping is the dependency graph's:
# every package is its own target except the four sanctioned pairs/quartet
# (protocol+spec, parser+section, server+serial, and the compiler quartet —
# compiler, element, spec, spec.typed — which is still one cycle of 208 classes
# and splits at step G). `:core` below is the umbrella every consumer keeps
# depending on; it exports all of these. Deps are listed low to high.

# every target below is private (legend_java_library's default): consumers depend on the umbrella `:core`
# until they choose a narrower target deliberately.

legend_java_library(name = "spi", srcs = glob(["src/main/java/com/legend/spi/*.java"]))
legend_java_library(name = "cache", srcs = glob(["src/main/java/com/legend/cache/*.java"]), deps = ["//base"])
legend_java_library(name = "values", srcs = glob(["src/main/java/com/legend/values/*.java"]), deps = ["//base"])
# THE EXECUTION PLAN's records and the lite plan format (docs/EXECUTION_PLAN_BOUNDARY_2026_10_05.md): what the planner
# produces and exec runs -- read by both sides, depending on neither
# :error since 2026-11-15 (phase D's option (D)): a plan words its raises from ErrorKind, the one source (PlanJson.raises)
legend_java_library(name = "execution_plan", srcs = glob(["src/main/java/com/legend/executionplan/*.java"]), deps = ["//base", "//json", ":cache", ":error", ":sql"])
# THE TEST PLAN'S RECORDS (docs/PLAN_AS_DATA_2026_11_07.md 2.1, 2.4, 2.9; the design's steps 2 and 3, 2026-11-08): a test
# body's plan as data, around the product's (:execution_plan) -- its steps, its verdict groups and branches, an error known
# at planning (Failure) -- and its JSON. Data alone: it depends on no planning or runtime library.
legend_java_library(name = "test_plan", srcs = glob(["src/main/java/com/legend/testexecutionplan/*.java"]), deps = ["//base", "//json", ":error", ":execution_plan", ":sql", ":values"])
# a plan's TYPED RESULT as a stream of batches, and the writers at the edge (docs/RESULT_BOUNDARY_PROGRAM_2026_10_26.md
# R3, R8; 2026-10-27): the plan side, so the browser's and Python's planners write the answers the server writes
# result reaches //arrow_ipc (track A, 2026-10-29: ArrowWriter frames a result's batches as Arrow IPC); so does
# lite_v1 below (the ARROW_IPC execute); the layer map tools/deps/core-layers.txt carries the same two rows
legend_java_library(name = "result", srcs = glob(["src/main/java/com/legend/result/**/*.java"]), deps = ["//arrow_ipc", "//base", "//json", ":error", ":execution_plan", ":values"])
legend_java_library(name = "error", srcs = glob(["src/main/java/com/legend/error/*.java"]), deps = ["//base"])
# THE COMPATIBILITY FORMS A RUN IS HANDED (phase D's W9/W10, 2026-11-16): the hook the edge implements and the planner
# and the test planner read -- interfaces only
# the diagnostics switchboard (-Dlegend.diagnostics, Bazel workplan P3-13): what lowering, exec and driver may turn on
# parser-equivalence's corpus machinery reads one switch of it (Corpus.load)
legend_java_library(name = "diagnostics", srcs = glob(["src/main/java/com/legend/diagnostics/*.java"]), deps = ["//base"], visibility = ["//parser-equivalence:__pkg__"])
legend_java_library(name = "lexer", srcs = glob(["src/main/java/com/legend/lexer/*.java"]), deps = ["//base"])
# //engine-client: the raise kind's mark, for the hosts' words of a product raise (#104's M2(b), 2026-11-15)
legend_java_library(name = "sql", srcs = glob(["src/main/java/com/legend/sql/*.java"]), visibility = ["//engine-client:__pkg__"], deps = ["//base"])
# legend-engine's query store's rules (/api/pure/v1/query) over a records interface
# (docs/ONE_PLATFORM_PROGRAM_2026_10_12.md B5): the one implementation legend-lite's server, Python's native library
# and the page's module answer with, the storage each host's own (a directory, or the page's records handed in).
# //base and //json only: it compiles to WebAssembly (//query-store:page).
legend_java_library(
    name = "saved_queries",
    srcs = glob(["src/main/java/com/legend/queries/*.java"]),
    deps = ["//base", "//json"],
    visibility = ["//native:__pkg__", "//query-store:__pkg__"],
)
# visible to //datacube: its catalog corpus and offer facts generators read the protocol directly
# legend-engine's sentence of a query store's refusal (the P2 checkpoint audit's M2, 2026-11-16): the edge's, its own
# target so the query-store page (TeaVM) words upstream's path with it and carries no server or planner
legend_java_library(
    name = "edge_store_words",
    srcs = ["src/main/java/com/legend/edge/StoreWords.java"],
    deps = ["//json", ":saved_queries"],
    visibility = ["//native:__pkg__", "//query-store:__pkg__"],
)
legend_java_library(name = "protocol", srcs = glob(["src/main/java/com/legend/protocol/**/*.java"]), deps = ["//base", "//json", ":values"], visibility = ["//datacube:__pkg__"])
legend_java_library(name = "model", srcs = glob(["src/main/java/com/legend/model/*.java"]), deps = ["//base", ":protocol"])
legend_java_library(
    name = "parser",
    srcs = glob(["src/main/java/com/legend/parser/**/*.java"]),
    visibility = ["//datacube:__pkg__"],
    deps = ["//base", ":error", ":lexer", ":protocol", ":spi", ":values"],
)

# THE TEXT'S DOOR (docs/PROTOCOL_PROGRAM_2026_10_05.md, leg 8's last step): a text's records (the parser's) made the
# compiler's model (ModelFromProtocol) -- the one place the two meet, so the parser depends on no model
legend_java_library(name = "door", srcs = glob(["src/main/java/com/legend/door/*.java"]), deps = ["//base", ":model", ":parser", ":protocol"])

# the platform's declarations, generated from the pinned upstream; the four
# resources (prelude, handler surface, imports, membership) ride here because
# this is the code that loads them
legend_java_library(
    name = "builtin",
    srcs = glob(["src/main/java/com/legend/builtin/*.java"]),
    # native-claims.tsv is generated here under the drift test but READ only by
    # the spec module's claim tests: it is not product data (retiring at step 5)
    resources = glob(
        ["src/main/resources/**"],
        exclude = ["src/main/resources/com/legend/builtin/native-claims.tsv"],
    ),
    deps = ["//base", ":door", ":error", ":model", ":parser", ":protocol"],
)
# :error since 2026-10-09 (build rebuild Phase 3b, item 1b): PlatformPure.adopt refuses a declaration whose parameter
# names differ from the platform's own version with a ModelException, the model error it is
legend_java_library(name = "platform", srcs = glob(["src/main/java/com/legend/platform/*.java"]), deps = ["//base", ":builtin", ":error", ":model"])
legend_java_library(
    name = "compiler_element_type",
    visibility = ["//datacube:__pkg__", "//engine-client:__pkg__"],
    srcs = glob(["src/main/java/com/legend/compiler/element/type/*.java"]),
    deps = ["//base", ":builtin", ":model", ":platform", ":protocol", ":sql"],
)
legend_java_library(
    name = "sql_dialect",
    srcs = glob(["src/main/java/com/legend/sql/dialect/*.java"]),
    visibility = ["//datacube:__pkg__"],
    deps = ["//base", ":sql"],
)

# THE plan-side owner of every per-database decision (C3 of
# docs/PLAN_EXECUTION_SPLIT_AND_DATABASE_OWNER_2026_10_03.md): a declared DatabaseType -> its dialect, which
# answers its plan facts (the dialect program's Phase 5, 2026-10-16). No JDBC: the browser planner carries it.
legend_java_library(
    name = "database",
    srcs = glob(["src/main/java/com/legend/database/*.java"]),
    visibility = ["//datacube:__pkg__"],
    deps = ["//base", ":error", ":model", ":sql", ":sql_dialect"],
)

# the compiler quartet: resolver-of-names, element compiler, typer, typed tree
legend_java_library(
    name = "compiler",
    visibility = ["//datacube:__pkg__"],
    srcs = glob(["src/main/java/com/legend/compiler/**/*.java"], exclude = ["src/main/java/com/legend/compiler/element/type/*.java"]),
    # :door since 2026-11-15 (C5-J's last round, A1): an island's text (#SQL, #IQ, #TS, #Cypher) is read through the
    # parse doors, which ask the run's wall; its readers sit in the protocol layer, which cannot ask (invariant 7b)
    deps = ["//base", ":builtin", ":compiler_element_type", ":door", ":error", ":model", ":platform", ":protocol", ":sql", ":values"],
)
legend_java_library(
    name = "normalizer",
    srcs = glob(["src/main/java/com/legend/normalizer/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol"],
)
legend_java_library(
    name = "lineage",
    srcs = glob(["src/main/java/com/legend/lineage/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol", ":sql"],
)
legend_java_library(
    name = "validation",
    srcs = glob(["src/main/java/com/legend/validation/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":protocol"],
)
legend_java_library(
    name = "lowering",
    visibility = ["//wasm:__pkg__"],
    srcs = glob(["src/main/java/com/legend/lowering/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol", ":sql", ":values"],
)
legend_java_library(
    name = "plan",
    visibility = ["//datacube:__pkg__"],
    srcs = glob(["src/main/java/com/legend/plan/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":execution_plan", ":lineage", ":model", ":sql"],
)
legend_java_library(
    name = "resolver",
    srcs = glob(["src/main/java/com/legend/resolver/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":plan", ":platform", ":sql", ":values"],
)
# A CONNECTION'S SETUP, as text and rows (docs/EXECUTION_PLAN_BOUNDARY_2026_10_05.md §9, moved out of exec 2026-10-08):
# a declared connection's test data and the store's DDL, spelled by the target's dialect. No connection: the planner
# writes it into the plan, the browser planner hands the tab the server's exact statements, exec runs it (SetupRunner)
legend_java_library(
    name = "setup",
    srcs = glob(["src/main/java/com/legend/setup/*.java"]),
    deps = ["//base", ":cache", ":compiler", ":error", ":execution_plan", ":model", ":protocol", ":sql", ":sql_dialect"],
)
legend_java_library(
    name = "exec",
    # the program runner is its own target, the package's (below)
    srcs = glob(["src/main/java/com/legend/exec/*.java"], exclude = ["src/main/java/com/legend/exec/ProgramRunner.java"]),
    # //engine-client: a product raise's envelope marks, for the hosts' words of one (#104's M2(b), 2026-11-15)
    visibility = ["//engine-client:__pkg__"],
    # THE WALL (D72, 2026-10-30, the seam-and-wall program's B2; D71 the day before took the judges and the probes out):
    # the runtime depends on no planning library -- not the compiler, not lowering, not a dialect, not the plan side's
    # setup or database facts. A plan and a session in, typed rows out: the plan records (:execution_plan) carry every
    # type and spelling fact the runtime reads, the connector every driver fact. ArchitectureTest.execReachesNoPlanning
    # says it at the class level; tools/deps/core-layers.txt pins this list.
    deps = ["//base", "//json", ":cache", ":diagnostics", ":error", ":execution_plan", ":result", ":sql", ":values"],
)
# THE PROGRAM RUNNER (docs/PLAN_AS_DATA_2026_11_07.md 2.8 and 2.9, the user's ruling of 2026-11-08: its own target, the
# exec package's): a program's steps in order on one session, a step exec does not know a callback at its place (a test
# body's verdict group or branch), reading only what it declared. A product caller that runs plans (the server, the query
# door) reaches none of it: they depend on :exec alone.
legend_java_library(
    name = "exec_program",
    srcs = ["src/main/java/com/legend/exec/ProgramRunner.java"],
    deps = ["//base", ":error", ":exec", ":execution_plan", ":result"],
)
# THE TEST'S RUN (docs/PLAN_AS_DATA_2026_11_07.md 2.9 and section 11's slice 5, 2026-11-09): a test plan run on its
# sessions and judged -- the run sink, the root loop, the agreement rule, the held appeals, the host judge's
# comparisons (equality, the asserts, the TDS compare, the canonical form), the verdict row's reading. It replaced
# `judge` (D71's verdict layer) and the run half of the driver. It depends on no planning library -- not the compiler,
# lowering, the resolver, the planner, testplan, a dialect, the database facts -- pinned here, in
# tools/deps/core-layers.txt, and by ArchitectureTest's split rules: the plan's data and the database's rows are all it
# reads.
legend_java_library(
    name = "testexec",
    srcs = glob(["src/main/java/com/legend/testexec/*.java"]),
    deps = ["//base", "//json", ":diagnostics", ":error", ":exec", ":exec_program", ":execution_plan", ":result", ":sql",
            ":test_plan", ":values"],
)
legend_java_library(
    name = "probe",
    srcs = glob(["src/main/java/com/legend/probe/*.java"]),
    deps = ["//base", ":builtin", ":lowering", ":model", ":platform"],
)
legend_java_library(
    name = "testdatagen",
    srcs = glob(["src/main/java/com/legend/testdatagen/*.java"]),
    # planning alone since slice 5 (2026-11-09); since B2d.2 (2026-11-11) the generator is one planned read-only
    # statement (TestDataPlanner) on the test road, and its interleaved run (the tests' TestDataGeneratorRun) is deleted
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":lineage", ":model", ":plan", ":protocol", ":test_plan", ":sql", ":sql_dialect", ":values"],
)

# THE PLANNER (C2a, docs/PLAN_EXECUTION_SPLIT_AND_DATABASE_OWNER_2026_10_03.md): the root package's plan side --
# model text to a compiled model, a query to its SQL. No :exec, no :testdatagen: planning never touches a database
# (the build enforces it; a plan-only consumer carries no driver).
# step C (D73, 2026-10-30): the root package holds the five public doors alone -- the planner's three here, the driver's two
# (Execution, ExecuteOptions) in :driver -- and the machinery is its own package on each side (com.legend.planner,
# com.legend.driver), so the planner-driver wall is the language's as well as the build's.
_PLANNER_DOORS = [
    "src/main/java/com/legend/Compiler.java",
    # the models a host holds, compiled once and planned against many times (docs/DATACUBE_MODEL_DESIGN_2026_10_10.md §9)
    "src/main/java/com/legend/HeldModels.java",
    "src/main/java/com/legend/TypedQuery.java",
]
_PLANNER_SRCS = _PLANNER_DOORS + glob(["src/main/java/com/legend/planner/*.java"])

legend_java_library(
    name = "planner",
    visibility = ["//datacube:__pkg__"],
    srcs = _PLANNER_SRCS,
    deps = [
        "//base", ":builtin", ":cache", ":compiler", ":compiler_element_type", ":database", ":door", ":error",
        ":execution_plan", ":lineage", ":lowering", ":model", ":normalizer", ":parser", ":plan", ":platform",
        ":protocol", ":resolver", ":setup", ":sql", ":sql_dialect", ":validation", ":values",
    ],
)

# THE TWO DOORS (docs/PLAN_AS_DATA_2026_11_07.md section 11, slice 5, 2026-11-09), each its own library and each thin:
# a method is one planning call and one run call (ArchitectureTest.theDoorsOnlyCompose). Until slice 5 one library
# held both, and before it `driver`, holding the body driver, the judges' arms and the router between the doors,
# planning and running in one package; that package is deleted.
# THE PRODUCT'S DOOR: a query planned by its one planning entry (TypedQuery.executionPlan) and run by exec's product
# run (ProductRun). It carries none of the test's machinery: the server depends on it alone.
legend_java_library(
    name = "execution",
    srcs = [
        "src/main/java/com/legend/Execution.java",
        "src/main/java/com/legend/package-info.java",
    ],
    deps = ["//base", ":compiler", ":database", ":exec", ":execution_plan", ":planner", ":platform", ":result"],
)
# THE TEST BODY'S DOOR and its options: a body planned by testplan's entry (TestPlanner), run by testexec's
# (TestRunner) -- the one library that sees both halves of a test.
legend_java_library(
    name = "test_execution",
    srcs = [
        "src/main/java/com/legend/ExecuteOptions.java",
        "src/main/java/com/legend/TestExecution.java",
    ],
    deps = [
        "//base", ":database", ":exec", ":execution_plan", ":planner", ":platform", ":result", ":test_plan",
        ":testexec", ":testplan",
    ],
)
# THE TEST-PLANNING LIBRARY (the test-is-the-product plan's B4, brought forward to M3 by R17 C7; brief B12 items 1
# and 3): the test door (TestDoor) and the kinds only a test's program holds -- effects, seeds, the eager run, asserts
# -- planned on the product's program road through the planner's extension point (planner.ProgramKinds). Not on the
# plan side: the WebAssembly and native planners, and the product's query door, carry none of it
# (ArchitectureTest.theTestPlanningLibraryIsTheDriversAlone).
legend_java_library(
    name = "testplan",
    srcs = glob(["src/main/java/com/legend/testplan/*.java"]),
    # the effects' statements (EffectPlanner, M3d): the store model, the DDL and the dialects that write them; the
    # seeds' content key (Seeds, M3e): :cache's Hash
    # since slice 5 (2026-11-09) every planning class of a test body (the asserts' planners, the arms, the router's
    # classify-and-plan, the verdict batch): it reaches no runtime library -- not exec, not testexec, not the door
    deps = [
        "//base", "//json", ":builtin", ":cache", ":compiler", ":compiler_element_type", ":database", ":diagnostics",
        ":door", ":error", ":execution_plan", ":lineage", ":lowering", ":model", ":normalizer", ":parser", ":plan",
        ":planner", ":platform", ":protocol", ":resolver", ":setup", ":sql", ":sql_dialect", ":test_plan",
        ":testdatagen", ":validation", ":values",
    ],
)
legend_java_library(name = "ide", srcs = glob(["src/main/java/com/legend/ide/*.java"]), deps = ["//base", ":door", ":lexer", ":model", ":parser"])
# legend-engine's service tests at the compatibility edge (phase D's D1.4, 2026-11-15): the service test runner and its
# writer of legend-engine's PURE_TDSOBJECT, moved from //core:test and //core:result -- a run of a Legend service's
# test, so its own library beside the edge's planning half (as edge_server is), reaching exec as //core:test does.
legend_java_library(
    name = "edge_service_tests",
    srcs = [
        "src/main/java/com/legend/edge/ServiceTestRunner.java",
        "src/main/java/com/legend/edge/TdsObjectsWriter.java",
    ],
    deps = ["//base", "//json", ":compiler", ":edge", ":error", ":exec", ":test_execution", ":execution_plan", ":testexec", ":model", ":planner", ":protocol", ":result", ":sql", ":test", ":test_plan", ":values"],
)
legend_java_library(
    name = "test",
    srcs = glob(["src/main/java/com/legend/test/*.java"]),
    # track Z, 2026-10-29: the service test runner spells a cell through the boundary's writer (result's CellText),
    # never by rules of its own
    # 2026-11-08 (docs/PLAN_AS_DATA_2026_11_07.md §11, slice 3, hole 4): the test runner reads the stores a body's planned
    # appeals name from the plan's data (PlannedAppeals.stores) and seeds them between the body's plan and its run
    deps = ["//base", "//json", ":compiler", ":error", ":exec", ":test_execution", ":execution_plan", ":testexec", ":model", ":planner", ":protocol", ":result", ":sql", ":test_plan", ":values"],
)
# legend-lite's own API (server/LiteV1Api.java; B7, 2026-11-17: its legend-engine content moved to the edge): THE PLAN SIDE -- no database and
# no driver, so the compiler's boundary (//wasm:boundary, and Python's engine through //native:compiler) answers
# with the same code as the server. execute's run is its host's: the server hands in its product door under its file
# fence (ConnectionResolver.runner(sources); ConnectionResolver.RUNNER is the library's, any file).
legend_java_library(
    name = "lite_v1",
    srcs = [
        "src/main/java/com/legend/server/CreateAssociation.java",
        "src/main/java/com/legend/server/CreateClass.java",
        "src/main/java/com/legend/server/CreateDataSpace.java",
        "src/main/java/com/legend/server/ModelChanges.java",
        # (ModelInput.java: legend-engine's request model context, moved to the edge 2026-11-18 -- J40.ModelInput)
        "src/main/java/com/legend/server/LiteV1Api.java",
        # lite's own grammar and typing routes (the HOST stream, 2026-11-17)
        "src/main/java/com/legend/server/LiteV1Planning.java",
        "src/main/java/com/legend/server/TsTree.java",
    ],
    # door (C5-J item 1, 2026-11-15): its parses through the parse doors, which ask the run's wall
    deps = ["//arrow_ipc", "//base", "//json", ":compiler", ":compiler_element_type", ":database", ":door", ":error", ":execution_plan", ":model", ":parser", ":plan", ":planner", ":protocol", ":result", ":sql", ":sql_dialect", ":testdatagen"],
)
legend_java_library(
    name = "server_lib",
    srcs = glob(
        ["src/main/java/com/legend/server/**/*.java"],
        exclude = [
