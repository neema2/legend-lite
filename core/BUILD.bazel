# core, as targets. It began as ONE java_library (the Bazel migration's first
# step, 2026-09-22: "can Bazel compile this at all" before "is the graph right");
# on 2026-09-26 (execution plan step 0c) it became one target per package group
# — see "CORE AS TARGETS" below — with `:core` kept as the umbrella consumers
# depend on. Bazel now refuses a back-edge at compile time.

load("@rules_java//java:defs.bzl", "java_test")
load("//tools/java:defs.bzl", "legend_java_binary", "legend_java_library")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/postgres:defs.bzl", "EMBEDDED_POSTGRES_COMPATIBLE")
load("//tools/java_run:defs.bzl", "java_run")
load("//tools/jars:defs.bzl", "file_list", "java_jars")
load("//tools/guards:defs.bzl", "guards_package")
load(":layers.bzl", "core_layer_queries")
load(":stress.bzl", "LINKED_PROJECTS", "STRESS_GENERATED", "stress_index", "stress_layout")

# PRIVATE BY DEFAULT (Bazel workplan P1-20): a target is visible outside core only where it says to whom.
package(default_visibility = ["//visibility:private"])

# legend-engine's own Arrow answer to execute (4.145.0, recorded with upstream-api/e8-arrow-groupby-sort.json): DataCube's
# remote client reads it in //datacube:python_engine_test, as it reads Python's engine
exports_files(
    ["src/test/resources/upstream-api/e8-arrow-groupby-sort.arrows.zst"],
    visibility = ["//datacube:__pkg__"],
)

# core's sources, exported for spec's generator parity checks (they compare the
# committed generated files — prelude.pure, Pure.java's signature text — against
# what upstream says they should be).
filegroup(
    name = "srcs",
    srcs = glob(["src/**"], exclude = ["**/*.md"]),
    visibility = ["//parser-equivalence:__pkg__", "//spec:__pkg__"],
)

# the main sources and resources as files: what spec's parity tests read (CoreTree; Bazel workplan P3-07)
filegroup(
    name = "main_srcs",
    srcs = glob(["src/main/**"], exclude = ["**/*.md"]),
    visibility = ["//spec:__pkg__"],
)

# the test sources as files: parser-equivalence's own corpus is the Pure snippets they embed (InlineSnippets reads
# src/test/**/*.java and nothing else; Bazel workplan P3-07)
filegroup(
    name = "test_java",
    srcs = glob(["src/test/**/*.java"]),
    visibility = ["//parser-equivalence:__pkg__"],
)


# THE NULL GATE: every library is a legend_java_library (//tools/java, Bazel workplan P1-20), which adds
# NullAway's plugin and flags (//tools/nullaway) unless the target says `nullaway = False`.

# CORE AS TARGETS (execution plan step 0c, 2026-09-26). One java_library per
# package group, each naming its direct dependencies, so a reference from a
# lower layer to a higher one is a build error in the file being written — not
# an ArchUnit finding after the fact. The grouping is the dependency graph's:
# every package is its own target except the four sanctioned pairs/quartet
# (protocol+spec, parser+section, server+serial, and the compiler quartet —
# compiler, element, spec, spec.typed — which is still one cycle of 208 classes
# and splits at step G). `:core` below is the umbrella every consumer keeps
# depending on; it exports all of these. Deps are listed low to high.

# every target below is private (legend_java_library's default): consumers depend on the umbrella `:core`
# until they choose a narrower target deliberately.

legend_java_library(name = "spi", srcs = glob(["src/main/java/com/legend/spi/*.java"]))
legend_java_library(name = "cache", srcs = glob(["src/main/java/com/legend/cache/*.java"]), deps = ["//base"])
legend_java_library(name = "values", srcs = glob(["src/main/java/com/legend/values/*.java"]), deps = ["//base"])
# THE EXECUTION PLAN's records and the lite plan format (docs/EXECUTION_PLAN_BOUNDARY_2026_10_05.md): what the planner
# produces and exec runs -- read by both sides, depending on neither
legend_java_library(name = "execution_plan", srcs = glob(["src/main/java/com/legend/executionplan/*.java"]), deps = ["//base", "//json", ":model", ":sql"])
legend_java_library(name = "error", srcs = glob(["src/main/java/com/legend/error/*.java"]), deps = ["//base"])
# the diagnostics switchboard (-Dlegend.diagnostics, Bazel workplan P3-13): what lowering, exec and driver may turn on
# parser-equivalence's corpus machinery reads one switch of it (Corpus.load)
legend_java_library(name = "diagnostics", srcs = glob(["src/main/java/com/legend/diagnostics/*.java"]), deps = ["//base"], visibility = ["//parser-equivalence:__pkg__"])
legend_java_library(name = "lexer", srcs = glob(["src/main/java/com/legend/lexer/*.java"]), deps = ["//base"])
legend_java_library(name = "sql", srcs = glob(["src/main/java/com/legend/sql/*.java"]), deps = ["//base"])
# legend-engine's query store's rules (/api/pure/v1/query) over a records interface
# (docs/ONE_PLATFORM_PROGRAM_2026_10_12.md B5): the one implementation legend-lite's server, Python's native library
# and the page's module answer with, the storage each host's own (a directory, or the page's records handed in).
# //base and //json only: it compiles to WebAssembly (//query-store:page).
legend_java_library(
    name = "saved_queries",
    srcs = glob(["src/main/java/com/legend/queries/*.java"]),
    deps = ["//base", "//json"],
    visibility = ["//native:__pkg__", "//query-store:__pkg__"],
)
# visible to //datacube: its catalog corpus and offer facts generators read the protocol directly
legend_java_library(name = "protocol", srcs = glob(["src/main/java/com/legend/protocol/**/*.java"]), deps = ["//base", "//json", ":values"], visibility = ["//datacube:__pkg__"])
legend_java_library(name = "model", srcs = glob(["src/main/java/com/legend/model/*.java"]), deps = ["//base", ":protocol"])
legend_java_library(
    name = "parser",
    srcs = glob(["src/main/java/com/legend/parser/**/*.java"]),
    visibility = ["//datacube:__pkg__"],
    deps = ["//base", ":error", ":lexer", ":protocol", ":spi", ":values"],
)

# THE TEXT'S DOOR (docs/PROTOCOL_PROGRAM_2026_10_05.md, leg 8's last step): a text's records (the parser's) made the
# compiler's model (ModelFromProtocol) -- the one place the two meet, so the parser depends on no model
legend_java_library(name = "door", srcs = glob(["src/main/java/com/legend/door/*.java"]), deps = ["//base", ":model", ":parser", ":protocol"])

# the platform's declarations, generated from the pinned upstream; the four
# resources (prelude, handler surface, imports, membership) ride here because
# this is the code that loads them
legend_java_library(
    name = "builtin",
    srcs = glob(["src/main/java/com/legend/builtin/*.java"]),
    # native-claims.tsv is generated here under the drift test but READ only by
    # the spec module's claim tests: it is not product data (retiring at step 5)
    resources = glob(
        ["src/main/resources/**"],
        exclude = ["src/main/resources/com/legend/builtin/native-claims.tsv"],
    ),
    deps = ["//base", ":door", ":error", ":model", ":parser", ":protocol"],
)
# :error since 2026-10-09 (build rebuild Phase 3b, item 1b): PlatformPure.adopt refuses a declaration whose parameter
# names differ from the platform's own version with a ModelException, the model error it is
legend_java_library(name = "platform", srcs = glob(["src/main/java/com/legend/platform/*.java"]), deps = ["//base", ":builtin", ":error", ":model"])
legend_java_library(
    name = "compiler_element_type",
    visibility = ["//datacube:__pkg__", "//engine-client:__pkg__"],
    srcs = glob(["src/main/java/com/legend/compiler/element/type/*.java"]),
    deps = ["//base", ":builtin", ":model", ":platform", ":protocol", ":sql"],
)
legend_java_library(
    name = "sql_dialect",
    srcs = glob(["src/main/java/com/legend/sql/dialect/*.java"]),
    visibility = ["//datacube:__pkg__"],
    deps = ["//base", ":sql"],
)

# THE plan-side owner of every per-database decision (C3 of
# docs/PLAN_EXECUTION_SPLIT_AND_DATABASE_OWNER_2026_10_03.md): a declared DatabaseType -> its dialect, which
# answers its plan facts (the dialect program's Phase 5, 2026-10-16). No JDBC: the browser planner carries it.
legend_java_library(
    name = "database",
    srcs = glob(["src/main/java/com/legend/database/*.java"]),
    visibility = ["//datacube:__pkg__"],
    deps = ["//base", ":error", ":model", ":sql_dialect"],
)

# the compiler quartet: resolver-of-names, element compiler, typer, typed tree
legend_java_library(
    name = "compiler",
    visibility = ["//datacube:__pkg__"],
    srcs = glob(["src/main/java/com/legend/compiler/**/*.java"], exclude = ["src/main/java/com/legend/compiler/element/type/*.java"]),
    deps = ["//base", ":builtin", ":compiler_element_type", ":error", ":model", ":platform", ":protocol", ":sql", ":values"],
)
legend_java_library(
    name = "normalizer",
    srcs = glob(["src/main/java/com/legend/normalizer/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol"],
)
legend_java_library(
    name = "lineage",
    srcs = glob(["src/main/java/com/legend/lineage/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol", ":sql"],
)
legend_java_library(
    name = "validation",
    srcs = glob(["src/main/java/com/legend/validation/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":protocol"],
)
legend_java_library(
    name = "lowering",
    visibility = ["//wasm:__pkg__"],
    srcs = glob(["src/main/java/com/legend/lowering/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol", ":sql", ":values"],
)
legend_java_library(
    name = "plan",
    visibility = ["//datacube:__pkg__"],
    srcs = glob(["src/main/java/com/legend/plan/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":lineage", ":model", ":sql"],
)
legend_java_library(
    name = "resolver",
    srcs = glob(["src/main/java/com/legend/resolver/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":lowering", ":model", ":plan", ":platform", ":sql", ":values"],
)
# A CONNECTION'S SETUP, as text and rows (docs/EXECUTION_PLAN_BOUNDARY_2026_10_05.md §9, moved out of exec 2026-10-08):
# a declared connection's test data and the store's DDL, spelled by the target's dialect. No connection: the planner
# writes it into the plan, the browser planner hands the tab the server's exact statements, exec runs it (SetupRunner)
legend_java_library(
    name = "setup",
    srcs = glob(["src/main/java/com/legend/setup/*.java"]),
    deps = ["//base", ":cache", ":compiler", ":execution_plan", ":model", ":protocol", ":sql", ":sql_dialect"],
)
legend_java_library(
    name = "exec",
    srcs = glob(["src/main/java/com/legend/exec/*.java"]),
    deps = ["//base", ":cache", ":compiler", ":compiler_element_type", ":database", ":diagnostics", ":error", ":execution_plan", ":lowering", ":model", ":plan", ":platform", ":setup", ":sql", ":sql_dialect", ":values"],
)
legend_java_library(
    name = "probe",
    srcs = glob(["src/main/java/com/legend/probe/*.java"]),
    deps = ["//base", ":builtin", ":lowering", ":model", ":platform"],
)
legend_java_library(
    name = "testdatagen",
    srcs = glob(["src/main/java/com/legend/testdatagen/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":exec", ":lineage", ":model", ":plan", ":protocol", ":resolver", ":setup", ":sql", ":sql_dialect", ":values"],
)

# THE PLANNER (C2a, docs/PLAN_EXECUTION_SPLIT_AND_DATABASE_OWNER_2026_10_03.md): the root package's plan side --
# model text to a compiled model, a query to its SQL. No :exec, no :testdatagen: planning never touches a database
# (the build enforces it; a plan-only consumer carries no driver).
_PLANNER_SRCS = [
    "src/main/java/com/legend/Compiler.java",
    "src/main/java/com/legend/CrossStoreGuard.java",
    # the models a host holds, compiled once and planned against many times (docs/DATACUBE_MODEL_DESIGN_2026_10_10.md §9)
    "src/main/java/com/legend/HeldModels.java",
    "src/main/java/com/legend/PlanMaker.java",
    "src/main/java/com/legend/ProgramFacts.java",
    "src/main/java/com/legend/QueryParameters.java",
    "src/main/java/com/legend/TypedQuery.java",
]

legend_java_library(
    name = "planner",
    visibility = ["//datacube:__pkg__"],
    srcs = _PLANNER_SRCS,
    deps = [
        "//base", ":builtin", ":cache", ":compiler", ":compiler_element_type", ":database", ":door", ":error",
        ":execution_plan", ":lineage", ":lowering", ":model", ":normalizer", ":parser", ":plan", ":platform",
        ":protocol", ":resolver", ":setup", ":sql", ":sql_dialect", ":validation", ":values",
    ],
)

# the root package's execution side: Execution (the front door), StatementExecutor, the judges
legend_java_library(
    name = "driver",
    srcs = glob(["src/main/java/com/legend/*.java"], exclude = _PLANNER_SRCS),
    deps = [
        "//base", ":builtin", ":cache", ":compiler", ":compiler_element_type", ":database", ":diagnostics", ":error", ":exec",
        ":lineage", ":lowering", ":model", ":normalizer", ":parser", ":plan", ":planner", ":platform",
        ":protocol", ":resolver", ":setup", ":sql", ":sql_dialect", ":testdatagen", ":validation", ":values",
    ],
)
legend_java_library(name = "ide", srcs = glob(["src/main/java/com/legend/ide/*.java"]), deps = ["//base", ":door", ":lexer", ":model", ":parser"])
legend_java_library(
    name = "test",
    srcs = glob(["src/main/java/com/legend/test/*.java"]),
    deps = ["//base", ":compiler", ":driver", ":error", ":exec", ":model", ":planner", ":protocol", ":sql", ":values"],
)
# legend-engine's pure/v1 API as legend-lite answers it (server/PureV1Api.java): THE PLAN SIDE -- no database and
# no driver, so the compiler's boundary (//wasm:boundary, and Python's engine through //native:compiler) answers
# with the same code as the server. execute's run is its host's: the server hands in its driver (QueryService).
legend_java_library(
    name = "pure_v1",
    srcs = [
        "src/main/java/com/legend/server/CreateAssociation.java",
        "src/main/java/com/legend/server/CreateClass.java",
        "src/main/java/com/legend/server/CreateDataSpace.java",
        "src/main/java/com/legend/server/ModelChanges.java",
        "src/main/java/com/legend/server/ModelInput.java",
        "src/main/java/com/legend/server/PureV1Api.java",
    ],
    deps = ["//base", "//json", ":compiler", ":compiler_element_type", ":database", ":error", ":parser", ":plan", ":planner", ":protocol", ":sql_dialect"],
)
legend_java_library(
    name = "server_lib",
    srcs = glob(
        ["src/main/java/com/legend/server/**/*.java"],
        exclude = [
            "src/main/java/com/legend/server/CreateAssociation.java",
            "src/main/java/com/legend/server/CreateClass.java",
            "src/main/java/com/legend/server/CreateDataSpace.java",
            "src/main/java/com/legend/server/ModelChanges.java",
            "src/main/java/com/legend/server/ModelInput.java",
            "src/main/java/com/legend/server/PureV1Api.java",
        ],
    ),
    deps = ["//base", "//json", ":cache", ":compiler", ":compiler_element_type", ":database", ":driver", ":error", ":exec", ":lowering", ":model", ":parser", ":plan", ":planner", ":protocol", ":pure_v1", ":saved_queries", ":setup", ":sql_dialect"],
)

_CORE_TARGETS = [
    "//base", "//json", ":spi", ":cache", ":values", ":error", ":diagnostics", ":lexer", ":sql", ":protocol", ":model", ":parser", ":door",
    ":builtin", ":platform", ":compiler_element_type", ":sql_dialect", ":database", ":compiler", ":normalizer",
    ":lineage", ":validation", ":lowering", ":plan", ":resolver", ":setup", ":exec", ":probe", ":testdatagen",
    ":execution_plan", ":planner", ":pure_v1", ":saved_queries", ":driver", ":ide", ":test", ":server_lib",
]

# THE PLAN SIDE (C2a, docs/PLAN_EXECUTION_SPLIT_AND_DATABASE_OWNER_2026_10_03.md): the planner and every library it
# stands on, and none of execution (exec, testdatagen, driver, probe, ide, test, server_lib). A plan-only consumer
# depends on this, so the build proves it carries no database and no driver.
_PLAN_SIDE_TARGETS = [
    "//base", "//json", ":spi", ":cache", ":values", ":error", ":diagnostics", ":lexer", ":sql", ":protocol", ":model", ":parser", ":door",
    ":builtin", ":platform", ":compiler_element_type", ":sql_dialect", ":database", ":compiler", ":normalizer",
    ":lineage", ":validation", ":lowering", ":plan", ":resolver", ":setup", ":execution_plan", ":planner", ":pure_v1",
]

legend_java_library(
    name = "plan_side",
    exports = _PLAN_SIDE_TARGETS,
    # //sdlc-server/grammar: the SDLC's one door to the compiler (the protocol program's leg 7, 2026-10-10)
    visibility = ["//sdlc-server/grammar:__pkg__", "//wasm:__pkg__"],
)

# THE UMBRELLA: what every consumer depends on today and keeps depending on.
# It compiles nothing; it exports the targets above. A consumer that needs only
# the front end may later depend on `:parser` and stop carrying exec and server.
legend_java_library(
    name = "core",
    exports = _CORE_TARGETS,
    # //datacube, //engine-client and //wasm name narrower targets (the build rebuild's Phase 1), so the whole of core
    # is not theirs to reach again by accident; nor SDLC-lite's, whose compiler is //sdlc-server/grammar's, on the plan
    # side (the protocol program's leg 7, 2026-10-10)
    visibility = ["//parser-equivalence:__pkg__", "//pct:__pkg__", "//spec:__pkg__", "//tools/census:__pkg__", "//tools/engine-runner:__pkg__", "//tools/legend:__pkg__"],
)

# THE JDBC DRIVERS, as their own target. core never compiles against a driver: it
# speaks java.sql, and names driver classes only as strings (Executor's
# "org.duckdb.JsonNode"). So a driver is a RUNTIME choice made by whatever runs
# core — a test, a server, a CLI — not a dependency of the product. A target that
# executes queries depends on this; one that only plans (a WASM or native planner)
# does not, and then carries no external jar at all.
legend_java_library(
    name = "drivers",
    runtime_deps = [
        ":duckdb_load",
        "@duckdb_jdbc//jar",
        "@h2//jar",
        "@postgresql//jar",
        "@sqlite_jdbc//jar",
    ],
    visibility = ["//datacube:__pkg__", "//pct:__pkg__", "//spec:__pkg__"],
)

# DuckDB's bulk load (its Appender) behind core's BulkLoad seam, found by
# ServiceLoader: it rides with the drivers, so core still compiles against none.
legend_java_library(
    name = "duckdb_load",
    srcs = glob(["src/main/duckdb/**/*.java"]),
    resources = glob(["src/main/duckdb/META-INF/**"]),
    resource_strip_prefix = "core/src/main/duckdb",
    deps = [
        ":core",
        "@duckdb_jdbc//jar",
    ],
)

# THE PRODUCT, runnable: the HTTP server (LSP, query execution, SQL, diagrams) with
# the JDBC drivers. `bazel run //core:server` (port 8080, or $PORT);
# `bazel build //core:server_deploy.jar` is the one self-contained jar to ship.
legend_java_binary(
    name = "server",
    main_class = "com.legend.server.LegendHttpServer",
    runtime_deps = [
        ":core",
        ":drivers",
    ],
    visibility = [
        "//:__pkg__",
        "//fixtures/saved-queries:__pkg__",
        "//query:__pkg__",
        "//query-store:__pkg__",
    ],
)

# every file a core test reads by path, declared, so it exists in runfiles and
# nothing is read by accident. Behaviour tests read core's own tree; the stress
# lanes also read the corpus's linked projects; the CENSUS lane (below) reads
# every module it walks.
# (no .md: prose is never a test input, so CI's docs-only paths-ignore stays true)
# core's whole source tree, as the source guards scan it (their declared lists below)
_CORE_READS = glob(["src/**"], exclude = ["**/*.md"])

_CENSUS_READS = _CORE_READS + [
    "//parser-equivalence:srcs",
    "//pct:srcs",
    "//spec:srcs",
    "//native:main_java",
    "//testing:main_java",
    "//warehouse:main_java",
    "//warehouse:test_java",
    "//wasm:planner_java",
]

# core's tests, compiled ONCE; every lane below runs from this library.
legend_java_library(
    name = "core_tests_lib",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    testonly = True,
    # PostgresArmTest, SqlIslandPostgresTest, SqlParityPostgresTest and HostOperationsPostgresTest are their own
    # targets' alone: they need the embedded Postgres in their runfiles
    srcs = glob(
        ["src/test/java/**/*.java"],
        exclude = [
            "src/test/java/com/legend/server/PostgresArmTest.java",
            "src/test/java/com/legend/server/SqlIslandPostgresTest.java",
            "src/test/java/com/legend/server/SqlParityPostgresTest.java",
            "src/test/java/com/legend/sql/dialect/HostOperationsPostgresTest.java",
            "src/test/java/com/legend/FixtureAsidePostgresTest.java",
            "src/test/java/com/legend/integration/SqlParityTest.java",
            # the #IQ{...}# island's parity lanes are :iq_parity_test's and :iq_parity_postgres_test's, its syntax-case
            # ratchet :iq_syntax_cases_test's
            "src/test/java/com/legend/integration/IqParityTest.java",
            "src/test/java/com/legend/server/IqParityPostgresTest.java",
            # the corpus lane is :iq_corpus_test's alone (manual): it fails without -Diq.corpus.root (2026-10-16)
            "src/test/java/com/legend/integration/IqCorpusTest.java",
            # the regression suite's corpus lane is :pg_regress_corpus_test's alone (manual): it fails without
            # -Dsql.corpus.regress (2026-10-17)
            "src/test/java/com/legend/integration/PostgresRegressCorpusTest.java",
            # the #Cypher{...}# island's parity lanes are :cypher_parity_test's and :cypher_parity_postgres_test's
            "src/test/java/com/legend/integration/CypherParityTest.java",
            "src/test/java/com/legend/server/CypherParityPostgresTest.java",
            "src/test/java/com/legend/protocol/sql/iq/IqSyntaxCasesTest.java",
            # the shared test cases are :test_cases's
            "src/test/java/com/legend/testcases/*.java",
            # the tests' databases are :test_backends's
            "src/test/java/com/legend/testbackend/*.java",
            # the toy section grammar and its test are :toy_grammar's and :section_grammar_registry_test's (P3-04)
            "src/test/java/com/legend/parser/SectionGrammarRegistryTest.java",
            "src/test/java/com/legend/parser/ToySectionGrammar.java",
        ],
    ),
    # the stress corpus is read ONE way, as classpath resources (Bazel workplan P3-05, A11): its files (under
    # src/test/resources), their table of contents, and the linked projects' files (resource paths projects/<p>/...)
    resources = [":stress_index"] + ["//projects:%s_files" % p for p in LINKED_PROJECTS] + glob(
        ["src/test/resources/**"],
        # the shadow binding rides :shadow_binding, once; prose is never a test input
        exclude = [
            "**/*.md",
            # upstream's Postgres parity corpus's answers and ledger: :sql_parity_test's and :sql_parity_postgres_test's
            # data, read as files
            "src/test/resources/sql-parity/**",
            # the #IQ{...}# island's cases, schema, snapped answers and ledger: :iq_parity_test's and
            # :iq_parity_postgres_test's data, read as files
            "src/test/resources/iq-parity/**",
            # the #Cypher{...}# island's cases, the TCK, the snapped answers and the ledger: :cypher_parity_test's and
            # :cypher_parity_postgres_test's data, read as files
            "src/test/resources/cypher-parity/**",
            "src/test/resources/META-INF/services/com.legend.builtin.DecisionProbe",
            # the toy section grammar's binding is :toy_grammar's, so no other core test loads it (P3-04)
