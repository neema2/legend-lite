    testonly = True,
    expression = "rdeps(deps(set(" + " ".join(_SHIPPED_ARTIFACTS + _PLANTED_ARTIFACTS) + ")), (" +
                 _EDGE_TARGETS + ") except set(" + " ".join(_EDGE_OPT_IN) + "), 1) except (" + _EDGE_TARGETS + ")",
    opts = ["--noimplicit_deps"],
    scope = _SHIPPED_ARTIFACTS + _EDGE_TARGET_LIST + _OPT_IN_SCOPE + _PLANTED_ARTIFACTS,
)

genquery(
