]

# The declared opt-in modules: legend-engine's, loaded only when configured. The server's (E-P5's K2 half: //core:server
# keeps :edge_server in its one artifact, looked up by ServiceLoader when the engine is asked for); the tab's engine
# module's entry (2026-11-18, the orchestrator's ruling on K2's wasm half: //wasm:engine_planner ships in //:wasm as the
# declared opt-in, its entry library :edge_tab, loaded beside the planner only for engine: 'legend-engine' -- engine-
# client's engine-module.ts); the Python host's engine library (2026-11-18, K2's native half for train 20: //native:engine,
# libcompiler_engine, rooted at :edge_entry, loaded by legend_lite.edge alone and shipped by the legend-lite-engine wheel,
# the [engine] extra; //native:compiler the product library, rooted at :entry).
_EDGE_OPT_IN = ["//core:edge_server", "//native:engine", "//wasm:edge_tab"]

# (//query-store:edge_page_entry: gone with H6, 2026-11-17 -- the queries page answers lite's own route from
# :page_entry; dropped here 2026-11-18 at the host train's merge of train 18, as _EDGE_TARGETS above)
_EDGE_TARGET_LIST = ["//core:edge", "//core:edge_server", "//core:edge_service_tests", "//core:edge_store_words",
                     "//native:edge_entry", "//wasm:edge_boundary", "//wasm:edge_tab"]

# the declared opt-in modules the edge's list does not name, in every query's scope: //native:engine, a shipped opt-in
# artifact of its own (K2's native half, 2026-11-18)
_OPT_IN_SCOPE = [t for t in _EDGE_OPT_IN if t not in _EDGE_TARGET_LIST]

# a shipped artifact's direct reach of an edge target that is no opt-in module
genquery(
    name = "shipped_edge_reach",
    testonly = True,
    expression = "rdeps(deps(set(" + " ".join(_SHIPPED_ARTIFACTS) + ")), (" + _EDGE_TARGETS + ") except set(" +
                 " ".join(_EDGE_OPT_IN) + "), 1) except (" + _EDGE_TARGETS + ")",
    opts = ["--noimplicit_deps"],
    scope = _SHIPPED_ARTIFACTS + _EDGE_TARGET_LIST + _OPT_IN_SCOPE,
)

# a target in a shipped artifact's closure whose main class is the edge's -- but a declared opt-in module (2026-11-18,
# the orchestrator's ruling on K2's wasm half: "ROOTS exempts declared opt-in modules"): a module DECLARED here whose
# own direct dependency is a declared opt-in library (_EDGE_OPT_IN), as the tab's engine module's is (:edge_tab).
# Narrowed by the GUARD stream the same day (train 19/20's batch): the TS host's first form exempted every artifact
# directly carrying an opt-in library -- //core:server among them (it carries :edge_server), so its main class could
# have turned the edge's unseen; now a product artifact carrying an opt-in library is still checked
# (:planted_opt_in_carrier bites), and a listed module that carries none is not exempt either.
_EDGE_ROOTED = "attr(main_class, '^com\\.legend\\.edge\\.', deps(set(%s)))"

# the declared opt-in modules, each an artifact whose main class is the edge's by design (2026-11-18): the tab's engine
# module (the orchestrator's ruling on K2's wasm half). The Python host's //native:engine is a declared opt-in LIBRARY
# (_EDGE_OPT_IN) but no module here: a native_image shared library with no main class, never named by the roots query
_EDGE_OPT_IN_MODULES = ["//wasm:engine_planner"]

_OPT_IN_MODULES = ("(set(" + " ".join(_EDGE_OPT_IN_MODULES) + ") intersect rdeps(deps(set(%s)), set(" +
                   " ".join(_EDGE_OPT_IN) + "), 1))")

genquery(
    name = "shipped_edge_roots",
    testonly = True,
    expression = (_EDGE_ROOTED + " except " + _OPT_IN_MODULES) % (" ".join(_SHIPPED_ARTIFACTS), " ".join(_SHIPPED_ARTIFACTS)),
    opts = ["--noimplicit_deps"],
    scope = _SHIPPED_ARTIFACTS + _EDGE_TARGET_LIST + _OPT_IN_SCOPE,
)

# THE ROOT CHECK'S BITE: a planted shipped artifact rooted at the edge, its main class EdgeServer and its runtime the
# edge's library -- found by the planted queries alone (ShippedArtifactRootsTest.theRootCheckBites)
legend_java_binary(
