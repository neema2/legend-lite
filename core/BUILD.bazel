    testonly = True,
    # the same expression as :shipped_edge_roots, the opt-in exemption included (2026-11-18): the planted artifact
    # reaches the edge through :edge, no declared opt-in, so it is found; the planted carrier reaches it through a
    # declared opt-in library but is no declared opt-in module, so it is found too
    expression = (_EDGE_ROOTED + " except " + _OPT_IN_MODULES) % (
        " ".join(_SHIPPED_ARTIFACTS + _PLANTED_ARTIFACTS),
        " ".join(_SHIPPED_ARTIFACTS + _PLANTED_ARTIFACTS),
    ),
    opts = ["--noimplicit_deps"],
