    testonly = True,
    main_class = "com.legend.edge.EdgeServer",
    runtime_deps = [":edge_server"],
    tags = ["edge_test"],
)

_PLANTED_ARTIFACTS = ["//core:planted_edge_rooted_artifact", "//core:planted_opt_in_carrier"]

genquery(
