# core, as targets. It began as ONE java_library (the Bazel migration's first
# step, 2026-09-22: "can Bazel compile this at all" before "is the graph right");
# on 2026-09-26 (execution plan step 0c) it became one target per package group
# — see "CORE AS TARGETS" below — with `:core` kept as the umbrella consumers
# depend on. Bazel now refuses a back-edge at compile time.
load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("//tools/nullaway:defs.bzl", "NULLAWAY_OPTS", "NULLAWAY_PLUGIN")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/junit:defs.bzl", "junit_test")

package(default_visibility = ["//visibility:public"])

# core's sources, exported for spec's generator parity checks (they compare the
# committed generated files — prelude.pure, Pure.java's signature text — against
# what upstream says they should be).
filegroup(
    name = "srcs",
    srcs = glob(["src/**"]),
)

# THE NULL GATE: NullAway's plugin and flags live in //tools/nullaway, shared with every
# other Java module.

# CORE AS TARGETS (execution plan step 0c, 2026-09-26). One java_library per
# package group, each naming its direct dependencies, so a reference from a
# lower layer to a higher one is a build error in the file being written — not
# an ArchUnit finding after the fact. The grouping is the dependency graph's:
# every package is its own target except the four sanctioned pairs/quartet
# (protocol+spec, parser+section, server+serial, and the compiler quartet —
# compiler, element, spec, spec.typed — which is still one cycle of 208 classes
# and splits at step G). `:core` below is the umbrella every consumer keeps
# depending on; it exports all of these. Deps are listed low to high.

# every target below: NULLAWAY_OPTS, the plugin, and PRIVATE visibility —
# consumers depend on the umbrella `:core` until they choose a narrower target
# deliberately. (BUILD files allow no **kwargs, so the three lines repeat.)
_PRIVATE = ["//visibility:private"]

java_library(name = "spi", srcs = glob(["src/main/java/com/legend/spi/*.java"]), javacopts = NULLAWAY_OPTS, plugins = [NULLAWAY_PLUGIN], visibility = _PRIVATE)
java_library(name = "cache", srcs = glob(["src/main/java/com/legend/cache/*.java"]), deps = ["//base"], javacopts = NULLAWAY_OPTS, plugins = [NULLAWAY_PLUGIN], visibility = _PRIVATE)
java_library(name = "values", srcs = glob(["src/main/java/com/legend/values/*.java"]), deps = ["//base"], javacopts = NULLAWAY_OPTS, plugins = [NULLAWAY_PLUGIN], visibility = _PRIVATE)
java_library(name = "error", srcs = glob(["src/main/java/com/legend/error/*.java"]), deps = ["//base"], javacopts = NULLAWAY_OPTS, plugins = [NULLAWAY_PLUGIN], visibility = _PRIVATE)
java_library(name = "lexer", srcs = glob(["src/main/java/com/legend/lexer/*.java"]), deps = ["//base"], javacopts = NULLAWAY_OPTS, plugins = [NULLAWAY_PLUGIN], visibility = _PRIVATE)
java_library(name = "sql", srcs = glob(["src/main/java/com/legend/sql/*.java"]), deps = ["//base"], javacopts = NULLAWAY_OPTS, plugins = [NULLAWAY_PLUGIN], visibility = _PRIVATE)
java_library(name = "protocol", srcs = glob(["src/main/java/com/legend/protocol/**/*.java"]), deps = ["//base", "//json", ":values"], javacopts = NULLAWAY_OPTS, plugins = [NULLAWAY_PLUGIN], visibility = _PRIVATE)
java_library(name = "model", srcs = glob(["src/main/java/com/legend/model/*.java"]), deps = ["//base", ":protocol"], javacopts = NULLAWAY_OPTS, plugins = [NULLAWAY_PLUGIN], visibility = _PRIVATE)
java_library(
    name = "parser",
    srcs = glob(["src/main/java/com/legend/parser/**/*.java"]),
    deps = ["//base", ":error", ":lexer", ":model", ":protocol", ":spi", ":values"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)

# the platform's declarations, generated from the pinned upstream; the four
# resources (prelude, handler surface, imports, membership) ride here because
# this is the code that loads them
java_library(
    name = "builtin",
    srcs = glob(["src/main/java/com/legend/builtin/*.java"]),
    # native-claims.tsv is generated here under the drift test but READ only by
    # the spec module's claim tests: it is not product data (retiring at step 5)
    resources = glob(
        ["src/main/resources/**"],
        exclude = ["src/main/resources/com/legend/builtin/native-claims.tsv"],
    ),
    deps = ["//base", ":error", ":model", ":parser", ":protocol"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(name = "platform", srcs = glob(["src/main/java/com/legend/platform/*.java"]), deps = ["//base", ":builtin", ":model"], javacopts = NULLAWAY_OPTS, plugins = [NULLAWAY_PLUGIN], visibility = _PRIVATE)
java_library(
    name = "compiler_element_type",
    srcs = glob(["src/main/java/com/legend/compiler/element/type/*.java"]),
    deps = ["//base", ":builtin", ":model", ":platform", ":protocol", ":sql"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(
    name = "sql_dialect",
    srcs = glob(["src/main/java/com/legend/sql/dialect/*.java"]),
    deps = ["//base", ":compiler_element_type", ":sql"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)

# the compiler quartet: resolver-of-names, element compiler, typer, typed tree
java_library(
    name = "compiler",
    srcs = glob(["src/main/java/com/legend/compiler/**/*.java"], exclude = ["src/main/java/com/legend/compiler/element/type/*.java"]),
    deps = ["//base", ":builtin", ":compiler_element_type", ":error", ":model", ":platform", ":protocol", ":sql", ":values"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(
    name = "normalizer",
    srcs = glob(["src/main/java/com/legend/normalizer/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(
    name = "lineage",
    srcs = glob(["src/main/java/com/legend/lineage/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol", ":sql"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(
    name = "validation",
    srcs = glob(["src/main/java/com/legend/validation/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":protocol"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(
    name = "lowering",
    srcs = glob(["src/main/java/com/legend/lowering/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol", ":sql", ":values"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(
    name = "plan",
    srcs = glob(["src/main/java/com/legend/plan/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":lineage", ":model", ":sql"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(
    name = "resolver",
    srcs = glob(["src/main/java/com/legend/resolver/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":lowering", ":model", ":plan", ":platform", ":sql", ":values"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(
    name = "exec",
    srcs = glob(["src/main/java/com/legend/exec/*.java"]),
    deps = ["//base", ":compiler", ":compiler_element_type", ":error", ":lowering", ":model", ":platform", ":sql", ":sql_dialect", ":values"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(
    name = "probe",
    srcs = glob(["src/main/java/com/legend/probe/*.java"]),
    deps = ["//base", ":builtin", ":lowering", ":model", ":platform"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(
    name = "testdatagen",
    srcs = glob(["src/main/java/com/legend/testdatagen/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":exec", ":lineage", ":model", ":plan", ":protocol", ":resolver", ":sql_dialect", ":values"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)

# the root package: the driver (Compiler, StatementExecutor, the judges)
java_library(
    name = "driver",
    srcs = glob(["src/main/java/com/legend/*.java"]),
    deps = [
        "//base", ":builtin", ":cache", ":compiler", ":compiler_element_type", ":error", ":exec",
        ":lineage", ":lowering", ":model", ":normalizer", ":parser", ":plan", ":platform",
        ":protocol", ":resolver", ":sql", ":sql_dialect", ":testdatagen", ":validation", ":values",
    ],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(name = "ide", srcs = glob(["src/main/java/com/legend/ide/*.java"]), deps = ["//base", ":lexer", ":model", ":parser"], javacopts = NULLAWAY_OPTS, plugins = [NULLAWAY_PLUGIN], visibility = _PRIVATE)
java_library(
    name = "test",
    srcs = glob(["src/main/java/com/legend/test/*.java"]),
    deps = ["//base", ":compiler", ":driver", ":error", ":exec", ":model", ":protocol", ":sql", ":values"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)
java_library(
    name = "server_lib",
    srcs = glob(["src/main/java/com/legend/server/**/*.java"]),
    deps = ["//base", "//json", ":cache", ":compiler_element_type", ":driver", ":error", ":exec", ":lowering", ":model", ":protocol", ":sql_dialect"],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    visibility = _PRIVATE,
)

_CORE_TARGETS = [
    "//base", "//json", ":spi", ":cache", ":values", ":error", ":lexer", ":sql", ":protocol", ":model", ":parser",
    ":builtin", ":platform", ":compiler_element_type", ":sql_dialect", ":compiler", ":normalizer",
    ":lineage", ":validation", ":lowering", ":plan", ":resolver", ":exec", ":probe", ":testdatagen",
    ":driver", ":ide", ":test", ":server_lib",
]

# THE UMBRELLA: what every consumer depends on today and keeps depending on.
# It compiles nothing; it exports the targets above. A consumer that needs only
# the front end may later depend on `:parser` and stop carrying exec and server.
java_library(
    name = "core",
    exports = _CORE_TARGETS,
)

# THE JDBC DRIVERS, as their own target. core never compiles against a driver: it
# speaks java.sql, and names driver classes only as strings (Executor's
# "org.duckdb.JsonNode"). So a driver is a RUNTIME choice made by whatever runs
# core — a test, a server, a CLI — not a dependency of the product. A target that
# executes queries depends on this; one that only plans (a WASM or native planner)
# does not, and then carries no external jar at all.
java_library(
    name = "drivers",
    runtime_deps = [
        ":duckdb_load",
        "@maven_core//:com_h2database_h2",
        "@maven_core//:org_duckdb_duckdb_jdbc",
        "@maven_core//:org_xerial_sqlite_jdbc",
    ],
)

# DuckDB's bulk load (its Appender) behind core's BulkLoad seam, found by
# ServiceLoader: it rides with the drivers, so core still compiles against none.
java_library(
    name = "duckdb_load",
    srcs = glob(["src/main/duckdb/**/*.java"]),
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    resources = glob(["src/main/duckdb/META-INF/**"]),
    resource_strip_prefix = "core/src/main/duckdb",
    deps = [
        ":core",
        "@maven_core//:org_duckdb_duckdb_jdbc",
    ],
)

# THE PRODUCT, runnable: the HTTP server (LSP, query execution, SQL, diagrams) with
# the JDBC drivers. `bazel run //core:server` (port 8080, or $PORT);
# `bazel build //core:server_deploy.jar` is the one self-contained jar to ship.
java_binary(
    name = "server",
    main_class = "com.legend.server.LegendHttpServer",
    runtime_deps = [
        ":core",
        ":drivers",
    ],
)

# every file a core test reads by path, declared, so it exists in runfiles and
# nothing is read by accident. Behaviour tests read core's own tree; the stress
# lanes also read the corpus's linked projects; the CENSUS lane (below) reads
# every module it walks.
_CORE_READS = glob(["src/**"])

_STRESS_READS = _CORE_READS + ["//projects:srcs"]

_CENSUS_READS = _CORE_READS + [
    "//parser-equivalence:srcs",
    "//pct:srcs",
    "//projects:srcs",
    "//spec:srcs",
]

# core's tests, compiled ONCE; every lane below runs from this library.
java_library(
    name = "core_tests_lib",
    testonly = True,
    srcs = glob(["src/test/java/**/*.java"]),
    resources = glob(
        ["src/test/resources/**"],
        # the shadow binding rides :shadow_binding, once
        exclude = ["src/test/resources/META-INF/services/com.legend.builtin.DecisionProbe"],
    ),
    runtime_deps = [":shadow_binding"],
    deps = [
        ":core",
        "//testing",
        "@maven_test//:com_tngtech_archunit_archunit",
        "@maven_core//:com_h2database_h2",
        "@maven_test//:com_tngtech_archunit_archunit_junit5",
        "@maven_core//:org_duckdb_duckdb_jdbc",
        "@maven_test//:org_junit_jupiter_junit_jupiter",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
        "@maven_test//:org_junit_jupiter_junit_jupiter_params",
        "@maven_core//:org_xerial_sqlite_jdbc",
    ],
)

# The step-3 shadow diff's binding (untangle, docs/UPSTREAM_BOUNDARY_PROGRAM.md §3 D):
# the ServiceLoader file that makes com.legend.platform.Shadow the DecisionProbe. A
# test-lane resource on the suites' libraries — never the product jar's, so a planner
# build (//wasm) carries no probe and its loader is empty. Deleted at step 4.
java_library(
    name = "shadow_binding",
    testonly = True,
    resources = ["src/test/resources/META-INF/services/com.legend.builtin.DecisionProbe"],
    resource_strip_prefix = "core/src/test/resources",
    visibility = ["//spec:__pkg__", "//pct:__pkg__"],
)

# Maven gate 1: every core BEHAVIOUR test — everything but the heavy and stress
# groups and the source checks below — JUnit's own console launcher selecting by
# package.
junit_test(
    name = "core_tests",
    size = "enormous",
    data = _CORE_READS,
    select = ["--select-package=com.legend"],
    exclude_tags = [
        "census",
        "guardrail",
        "heavy",
        "stress",
    ],
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
)

# THE SOURCE CHECKS: tests whose subject is the code, not what it does — the
# guardrails (a hard rule: file and method size, layer boundaries), the ratchets
# (a count that may only fall: SQL built as text, JDBC accessor sites) and the
# ledgers (every instance registered with its reason). Their own targets, so a
# static check reports as one and is not carried by the behaviour suite. Tagged
# on the class: @Tag("guardrail") reads core's own tree, @Tag("census") walks
# other modules too — which is why only IT declares them.
junit_test(
    name = "guardrails",
    size = "medium",
    data = _CORE_READS,
    select = [
        "--select-package=com.legend",
        "--include-tag=guardrail",
    ],
    runtime_deps = [":core_tests_lib"],
)

junit_test(
    name = "census",
    size = "medium",
    data = _CENSUS_READS,
    select = [
        "--select-package=com.legend",
        "--include-tag=census",
    ],
    runtime_deps = [":core_tests_lib"],
)

# THE SCALE TESTS: generated models far past the 1K baseline (StressTest, in
# core_tests) — 10K, 100K, dense links, complex multi-hop queries, 50K chaotic
# classes, and the 100K parse-vs-compile profile. Named explicitly: none of these
# class names matches a test-name pattern, so no default discovery (Maven's
# surefire included) ever ran them.
_SCALE = [
    "StressTest10K",
    "StressTest100K",
    "StressTestDense",
    "StressTestComplexQueries",
    "StressTestChaotic",
    "ProfileBuildCost",
]

[junit_test(
    name = "scale_" + c.lower(),
    size = "enormous",
    data = _STRESS_READS,
    select = [
        "--select-class=com.legend.integration." + c,
        "--include-classname=.*",
    ],
    tags = ["manual"],
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
) for c in _SCALE]

# Maven gate 10: THE STRESS CORPUS — every stress service suite on DuckDB shared
# sessions, held by the MIN_PASS ratchet inside StressServiceSuitesTest. Its own
# lane: the stress group is what gate 1 leaves out.
junit_test(
    name = "stress_suites",
    size = "enormous",
    data = _STRESS_READS,
    select = ["--select-class=com.legend.integration.StressServiceSuitesTest"],
    exclude_tags = ["heavy"],
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
)

# ── GENERATED FILES ─────────────────────────────────────────────────────────────
# Committed files that are generator OUTPUTS (their generators: //spec, "THE
# GENERATORS"). `bazel run //core:update_generated` (or //:update_generated)
# writes them; `bazel test` fails when a committed copy differs, naming the command.
_GENERATED = {
    "src/main/java/com/legend/builtin/DynaFn.java": "//spec:gen_dynafn",
    "src/main/java/com/legend/builtin/Pure.java": "//spec:gen_natives",
    "src/main/java/com/legend/compiler/NameResolver.java": "//spec:gen_imports",
    "src/main/resources/com/legend/builtin/engine-handlers.tsv": "//spec:gen_engine_handlers",
    "src/main/resources/com/legend/builtin/native-claims.tsv": "//spec:gen_claims",
    "src/main/resources/com/legend/builtin/prelude.pure": "//spec:gen_prelude",
}

# the committed copies are also generator INPUTS (a generator splices its part
# in), as is the hand-owned membership list natives reads
exports_files(list(_GENERATED.keys()) + [
    "src/main/resources/com/legend/builtin/native-membership.tsv",
])

# core's main Java sources as TEXT — the prelude generator reads what the
# platform's own code names
filegroup(
    name = "main_java",
    srcs = glob(["src/main/java/**"]),
)

write_source_files(
    name = "update_generated",
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nThis file is generated from the pinned upstream release — regenerate: bazel run //:update_generated",
    files = _GENERATED,
)

# CORE AS THE GENERATORS REWRITE IT: the generated Java and prelude in place of
# the committed copies. Only the claims generator runs on it — the one generator
# that reads the COMPILED registries the others rewrite. At a fixpoint (every
# committed file current) it is core, byte for byte.
java_library(
    name = "core_next",
    srcs = glob(
        ["src/main/java/**/*.java"],
        exclude = [
            "src/main/java/com/legend/builtin/DynaFn.java",
            "src/main/java/com/legend/builtin/Pure.java",
            "src/main/java/com/legend/compiler/NameResolver.java",
        ],
    ) + [
        "//spec:gen_dynafn",
        "//spec:gen_imports",
        "//spec:gen_natives",
    ],
    # core's sources import the two modules below core (null annotations, the JSON codec)
    deps = [
        "//base",
        "//json",
    ],
    javacopts = NULLAWAY_OPTS,
    plugins = [NULLAWAY_PLUGIN],
    resources = glob(
        ["src/main/resources/**"],
        exclude = ["src/main/resources/com/legend/builtin/prelude.pure"],
    ),
    visibility = ["//spec:__pkg__"],
    runtime_deps = [":core_next_prelude"],
)

java_library(
    name = "core_next_prelude",
    resource_strip_prefix = "spec/generated",
    resources = ["//spec:gen_prelude"],
)

