# core, as targets. It began as ONE java_library (the Bazel migration's first
# step, 2026-09-22: "can Bazel compile this at all" before "is the graph right");
# on 2026-09-26 (execution plan step 0c) it became one target per package group
# — see "CORE AS TARGETS" below — with `:core` kept as the umbrella consumers
# depend on. Bazel now refuses a back-edge at compile time.

load("@rules_java//java:defs.bzl", "java_test")
load("//tools/java:defs.bzl", "legend_java_binary", "legend_java_library")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/postgres:defs.bzl", "EMBEDDED_POSTGRES_COMPATIBLE")
load("//tools/java_run:defs.bzl", "java_run")
load("//tools/jars:defs.bzl", "file_list", "java_jars")
load("//tools/guards:defs.bzl", "guards_package")
load(":layers.bzl", "core_layer_queries")
load(":stress.bzl", "LINKED_PROJECTS", "STRESS_GENERATED", "stress_index", "stress_layout")

# PRIVATE BY DEFAULT (Bazel workplan P1-20): a target is visible outside core only where it says to whom.
package(default_visibility = ["//visibility:private"])

# core's sources, exported for spec's generator parity checks (they compare the
# committed generated files — prelude.pure, Pure.java's signature text — against
# what upstream says they should be).
filegroup(
    name = "srcs",
    srcs = glob(["src/**"], exclude = ["**/*.md"]),
    visibility = ["//parser-equivalence:__pkg__", "//spec:__pkg__"],
)

# the main sources and resources as files: what spec's parity tests read (CoreTree; Bazel workplan P3-07)
filegroup(
    name = "main_srcs",
    srcs = glob(["src/main/**"], exclude = ["**/*.md"]),
    visibility = ["//spec:__pkg__"],
)

# the test sources as files: parser-equivalence's own corpus is the Pure snippets they embed (InlineSnippets reads
# src/test/**/*.java and nothing else; Bazel workplan P3-07)
filegroup(
    name = "test_java",
    srcs = glob(["src/test/**/*.java"]),
    visibility = ["//parser-equivalence:__pkg__"],
)


# THE NULL GATE: every library is a legend_java_library (//tools/java, Bazel workplan P1-20), which adds
# NullAway's plugin and flags (//tools/nullaway) unless the target says `nullaway = False`.

# CORE AS TARGETS (execution plan step 0c, 2026-09-26). One java_library per
# package group, each naming its direct dependencies, so a reference from a
# lower layer to a higher one is a build error in the file being written — not
# an ArchUnit finding after the fact. The grouping is the dependency graph's:
# every package is its own target except the four sanctioned pairs/quartet
# (protocol+spec, parser+section, server+serial, and the compiler quartet —
# compiler, element, spec, spec.typed — which is still one cycle of 208 classes
# and splits at step G). `:core` below is the umbrella every consumer keeps
# depending on; it exports all of these. Deps are listed low to high.

# every target below is private (legend_java_library's default): consumers depend on the umbrella `:core`
# until they choose a narrower target deliberately.

legend_java_library(name = "spi", srcs = glob(["src/main/java/com/legend/spi/*.java"]))
legend_java_library(name = "cache", srcs = glob(["src/main/java/com/legend/cache/*.java"]), deps = ["//base"])
legend_java_library(name = "values", srcs = glob(["src/main/java/com/legend/values/*.java"]), deps = ["//base"])
legend_java_library(name = "error", srcs = glob(["src/main/java/com/legend/error/*.java"]), deps = ["//base"])
# the diagnostics switchboard (-Dlegend.diagnostics, Bazel workplan P3-13): what lowering, exec and driver may turn on
legend_java_library(name = "diagnostics", srcs = glob(["src/main/java/com/legend/diagnostics/*.java"]), deps = ["//base"])
legend_java_library(name = "lexer", srcs = glob(["src/main/java/com/legend/lexer/*.java"]), deps = ["//base"])
legend_java_library(name = "sql", srcs = glob(["src/main/java/com/legend/sql/*.java"]), deps = ["//base"])
legend_java_library(name = "protocol", srcs = glob(["src/main/java/com/legend/protocol/**/*.java"]), deps = ["//base", "//json", ":values"])
legend_java_library(name = "model", srcs = glob(["src/main/java/com/legend/model/*.java"]), deps = ["//base", ":protocol"])
legend_java_library(
    name = "parser",
    srcs = glob(["src/main/java/com/legend/parser/**/*.java"]),
    deps = ["//base", ":error", ":lexer", ":model", ":protocol", ":spi", ":values"],
)

# the platform's declarations, generated from the pinned upstream; the four
# resources (prelude, handler surface, imports, membership) ride here because
# this is the code that loads them
legend_java_library(
    name = "builtin",
    srcs = glob(["src/main/java/com/legend/builtin/*.java"]),
    # native-claims.tsv is generated here under the drift test but READ only by
    # the spec module's claim tests: it is not product data (retiring at step 5)
    resources = glob(
        ["src/main/resources/**"],
        exclude = ["src/main/resources/com/legend/builtin/native-claims.tsv"],
    ),
    deps = ["//base", ":error", ":model", ":parser", ":protocol"],
)
legend_java_library(name = "platform", srcs = glob(["src/main/java/com/legend/platform/*.java"]), deps = ["//base", ":builtin", ":model"])
legend_java_library(
    name = "compiler_element_type",
    srcs = glob(["src/main/java/com/legend/compiler/element/type/*.java"]),
    deps = ["//base", ":builtin", ":model", ":platform", ":protocol", ":sql"],
)
legend_java_library(
    name = "sql_dialect",
    srcs = glob(["src/main/java/com/legend/sql/dialect/*.java"]),
    deps = ["//base", ":sql"],
)

# THE plan-side owner of every per-database decision (C3 of
# docs/PLAN_EXECUTION_SPLIT_AND_DATABASE_OWNER_2026_10_03.md): a declared DatabaseType -> its dialect,
# legend-engine's text for it, its plan facts. No JDBC: the browser planner carries it.
legend_java_library(
    name = "database",
    srcs = glob(["src/main/java/com/legend/database/*.java"]),
    deps = ["//base", ":error", ":model", ":sql_dialect"],
)

# the compiler quartet: resolver-of-names, element compiler, typer, typed tree
legend_java_library(
    name = "compiler",
    srcs = glob(["src/main/java/com/legend/compiler/**/*.java"], exclude = ["src/main/java/com/legend/compiler/element/type/*.java"]),
    deps = ["//base", ":builtin", ":compiler_element_type", ":error", ":model", ":platform", ":protocol", ":sql", ":values"],
)
legend_java_library(
    name = "normalizer",
    srcs = glob(["src/main/java/com/legend/normalizer/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol"],
)
legend_java_library(
    name = "lineage",
    srcs = glob(["src/main/java/com/legend/lineage/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol", ":sql"],
)
legend_java_library(
    name = "validation",
    srcs = glob(["src/main/java/com/legend/validation/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":protocol"],
)
legend_java_library(
    name = "lowering",
    srcs = glob(["src/main/java/com/legend/lowering/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":model", ":platform", ":protocol", ":sql", ":values"],
)
legend_java_library(
    name = "plan",
    srcs = glob(["src/main/java/com/legend/plan/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":database", ":error", ":lineage", ":model", ":sql"],
)
legend_java_library(
    name = "resolver",
    srcs = glob(["src/main/java/com/legend/resolver/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":lowering", ":model", ":plan", ":platform", ":sql", ":values"],
)
legend_java_library(
    name = "exec",
    srcs = glob(["src/main/java/com/legend/exec/*.java"]),
    deps = ["//base", ":compiler", ":compiler_element_type", ":database", ":diagnostics", ":error", ":lowering", ":model", ":plan", ":platform", ":sql", ":sql_dialect", ":values"],
)
legend_java_library(
    name = "probe",
    srcs = glob(["src/main/java/com/legend/probe/*.java"]),
    deps = ["//base", ":builtin", ":lowering", ":model", ":platform"],
)
legend_java_library(
    name = "testdatagen",
    srcs = glob(["src/main/java/com/legend/testdatagen/*.java"]),
    deps = ["//base", ":builtin", ":compiler", ":compiler_element_type", ":error", ":exec", ":lineage", ":model", ":plan", ":protocol", ":resolver", ":sql_dialect", ":values"],
)

# THE PLANNER (C2a, docs/PLAN_EXECUTION_SPLIT_AND_DATABASE_OWNER_2026_10_03.md): the root package's plan side --
# model text to a compiled model, a query to its SQL. No :exec, no :testdatagen: planning never touches a database
# (the build enforces it; a plan-only consumer carries no driver).
_PLANNER_SRCS = [
    "src/main/java/com/legend/Compiler.java",
    "src/main/java/com/legend/CrossStoreGuard.java",
    "src/main/java/com/legend/ProgramFacts.java",
    "src/main/java/com/legend/TypedQuery.java",
]

legend_java_library(
    name = "planner",
    srcs = _PLANNER_SRCS,
    deps = [
        "//base", ":builtin", ":cache", ":compiler", ":compiler_element_type", ":database", ":error",
        ":lineage", ":lowering", ":model", ":normalizer", ":parser", ":plan", ":platform",
        ":protocol", ":resolver", ":sql", ":sql_dialect", ":validation", ":values",
    ],
)

# the root package's execution side: Execution (the front door), StatementExecutor, the judges
legend_java_library(
    name = "driver",
    srcs = glob(["src/main/java/com/legend/*.java"], exclude = _PLANNER_SRCS),
    deps = [
        "//base", ":builtin", ":cache", ":compiler", ":compiler_element_type", ":database", ":diagnostics", ":error", ":exec",
        ":lineage", ":lowering", ":model", ":normalizer", ":parser", ":plan", ":planner", ":platform",
        ":protocol", ":resolver", ":sql", ":sql_dialect", ":testdatagen", ":validation", ":values",
    ],
)
legend_java_library(name = "ide", srcs = glob(["src/main/java/com/legend/ide/*.java"]), deps = ["//base", ":lexer", ":model", ":parser"])
legend_java_library(
    name = "test",
    srcs = glob(["src/main/java/com/legend/test/*.java"]),
    deps = ["//base", ":compiler", ":driver", ":error", ":exec", ":model", ":planner", ":protocol", ":sql", ":values"],
)
legend_java_library(
    name = "server_lib",
    srcs = glob(["src/main/java/com/legend/server/**/*.java"]),
    deps = ["//base", "//json", ":cache", ":compiler", ":compiler_element_type", ":database", ":driver", ":error", ":exec", ":lowering", ":model", ":parser", ":plan", ":planner", ":protocol", ":sql_dialect"],
)

_CORE_TARGETS = [
    "//base", "//json", ":spi", ":cache", ":values", ":error", ":diagnostics", ":lexer", ":sql", ":protocol", ":model", ":parser",
    ":builtin", ":platform", ":compiler_element_type", ":sql_dialect", ":database", ":compiler", ":normalizer",
    ":lineage", ":validation", ":lowering", ":plan", ":resolver", ":exec", ":probe", ":testdatagen",
    ":planner", ":driver", ":ide", ":test", ":server_lib",
]

# THE PLAN SIDE (C2a, docs/PLAN_EXECUTION_SPLIT_AND_DATABASE_OWNER_2026_10_03.md): the planner and every library it
# stands on, and none of execution (exec, testdatagen, driver, probe, ide, test, server_lib). A plan-only consumer
# depends on this, so the build proves it carries no database and no driver.
_PLAN_SIDE_TARGETS = [
    "//base", "//json", ":spi", ":cache", ":values", ":error", ":diagnostics", ":lexer", ":sql", ":protocol", ":model", ":parser",
    ":builtin", ":platform", ":compiler_element_type", ":sql_dialect", ":database", ":compiler", ":normalizer",
    ":lineage", ":validation", ":lowering", ":plan", ":resolver", ":planner",
]

legend_java_library(
    name = "plan_side",
    exports = _PLAN_SIDE_TARGETS,
    visibility = ["//wasm:__pkg__"],
)

# THE UMBRELLA: what every consumer depends on today and keeps depending on.
# It compiles nothing; it exports the targets above. A consumer that needs only
# the front end may later depend on `:parser` and stop carrying exec and server.
legend_java_library(
    name = "core",
    exports = _CORE_TARGETS,
    visibility = ["//datacube:__pkg__", "//engine-client:__pkg__", "//parser-equivalence:__pkg__", "//pct:__pkg__", "//sdlc-server:__pkg__", "//spec:__pkg__", "//tools/census:__pkg__", "//tools/engine-runner:__pkg__", "//tools/legend:__pkg__", "//wasm:__pkg__"],
)

# THE JDBC DRIVERS, as their own target. core never compiles against a driver: it
# speaks java.sql, and names driver classes only as strings (Executor's
# "org.duckdb.JsonNode"). So a driver is a RUNTIME choice made by whatever runs
# core — a test, a server, a CLI — not a dependency of the product. A target that
# executes queries depends on this; one that only plans (a WASM or native planner)
# does not, and then carries no external jar at all.
legend_java_library(
    name = "drivers",
    runtime_deps = [
        ":duckdb_load",
        "@maven_core//:com_h2database_h2",
        "@maven_core//:org_duckdb_duckdb_jdbc",
        "@maven_core//:org_xerial_sqlite_jdbc",
        "@maven_core//:org_postgresql_postgresql",
    ],
    visibility = ["//datacube:__pkg__", "//pct:__pkg__", "//spec:__pkg__"],
)

# DuckDB's bulk load (its Appender) behind core's BulkLoad seam, found by
# ServiceLoader: it rides with the drivers, so core still compiles against none.
legend_java_library(
    name = "duckdb_load",
    srcs = glob(["src/main/duckdb/**/*.java"]),
    resources = glob(["src/main/duckdb/META-INF/**"]),
    resource_strip_prefix = "core/src/main/duckdb",
    deps = [
        ":core",
        "@maven_core//:org_duckdb_duckdb_jdbc",
    ],
)

# THE PRODUCT, runnable: the HTTP server (LSP, query execution, SQL, diagrams) with
# the JDBC drivers. `bazel run //core:server` (port 8080, or $PORT);
# `bazel build //core:server_deploy.jar` is the one self-contained jar to ship.
legend_java_binary(
    name = "server",
    main_class = "com.legend.server.LegendHttpServer",
    runtime_deps = [
        ":core",
        ":drivers",
    ],
    visibility = ["//fixtures/saved-queries:__pkg__", "//query:__pkg__", "//query-store:__pkg__"],
)

# every file a core test reads by path, declared, so it exists in runfiles and
# nothing is read by accident. Behaviour tests read core's own tree; the stress
# lanes also read the corpus's linked projects; the CENSUS lane (below) reads
# every module it walks.
# (no .md: prose is never a test input, so CI's docs-only paths-ignore stays true)
# core's whole source tree, as the source guards scan it (their declared lists below)
_CORE_READS = glob(["src/**"], exclude = ["**/*.md"])

_CENSUS_READS = _CORE_READS + [
    "//parser-equivalence:srcs",
    "//pct:srcs",
    "//spec:srcs",
    "//warehouse:test_java",
]

# core's tests, compiled ONCE; every lane below runs from this library.
legend_java_library(
    name = "core_tests_lib",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    testonly = True,
    # PostgresArmTest is :postgres_arm_test's alone: it needs the embedded Postgres in its runfiles
    srcs = glob(
        ["src/test/java/**/*.java"],
        exclude = [
            "src/test/java/com/legend/server/PostgresArmTest.java",
            # the toy section grammar and its test are :toy_grammar's and :section_grammar_registry_test's (P3-04)
            "src/test/java/com/legend/parser/SectionGrammarRegistryTest.java",
            "src/test/java/com/legend/parser/ToySectionGrammar.java",
        ],
    ),
    # the stress corpus is read ONE way, as classpath resources (Bazel workplan P3-05, A11): its files (under
    # src/test/resources), their table of contents, and the linked projects' files (resource paths projects/<p>/...)
    resources = [":stress_index"] + ["//projects:%s_files" % p for p in LINKED_PROJECTS] + glob(
        ["src/test/resources/**"],
        # the shadow binding rides :shadow_binding, once; prose is never a test input
        exclude = [
            "**/*.md",
            "src/test/resources/META-INF/services/com.legend.builtin.DecisionProbe",
            # the toy section grammar's binding is :toy_grammar's, so no other core test loads it (P3-04)
            "src/test/resources/META-INF/services/com.legend.spi.SectionGrammar",
        ],
    ),
    # :duckdb_load: the bulk-load path RowLoadTest judges, declared, not borrowed from :drivers (P3-02)
    runtime_deps = [
        ":duckdb_load",
        ":shadow_binding",
    ],
    deps = [
        ":core",
        "//testing",
        "@maven_test//:com_tngtech_archunit_archunit",
        # H2VersionPinTest reads org.h2.engine.Constants.VERSION
        "@maven_core//:com_h2database_h2",
        "@maven_test//:com_tngtech_archunit_archunit_junit5",
        "@maven_test//:org_junit_jupiter_junit_jupiter",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
        "@maven_test//:org_junit_jupiter_junit_jupiter_params",
    ],
)

# The step-3 shadow diff's binding (untangle, docs/UPSTREAM_BOUNDARY_PROGRAM.md §3 D):
# the ServiceLoader file that makes com.legend.platform.Shadow the DecisionProbe. A
# test-lane resource on the suites' libraries — never the product jar's, so a planner
# build (//wasm) carries no probe and its loader is empty. Deleted at step 4.
legend_java_library(
    name = "shadow_binding",
    testonly = True,
    resources = ["src/test/resources/META-INF/services/com.legend.builtin.DecisionProbe"],
    resource_strip_prefix = "core/src/test/resources",
    visibility = ["//spec:__pkg__", "//pct:__pkg__"],
)

# A toy section grammar and its ServiceLoader binding, for the registry's own test only: as a resource of
# core_tests_lib it was loaded by every core test (Bazel workplan P3-04).
legend_java_library(
    name = "toy_grammar",
    # not yet written to the null discipline (Bazel workplan P1-20), as core_tests_lib it came from
    nullaway = False,
    testonly = True,
    srcs = ["src/test/java/com/legend/parser/ToySectionGrammar.java"],
    resources = ["src/test/resources/META-INF/services/com.legend.spi.SectionGrammar"],
    resource_strip_prefix = "core/src/test/resources",
    deps = [":core"],
)

junit_test(
    name = "section_grammar_registry_test",
    memory_mb = 768,
    size = "small",
    srcs = ["src/test/java/com/legend/parser/SectionGrammarRegistryTest.java"],
    select = ["--select-class=com.legend.parser.SectionGrammarRegistryTest"],
    deps = [
        ":core",
        ":core_tests_lib",
        ":toy_grammar",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
    visibility = ["//gates:__pkg__"],
)

# Gate 1: every core BEHAVIOUR test — everything but the stress group and the source checks below — one junit_test
# per test package (Bazel workplan P3-05), so a change re-runs only the packages whose tests it reaches, and the
# root package's own classes in one more. No data: what a behaviour test reads is on its classpath (the stress corpus
# included). `core_tests` is their suite.
_CORE_TEST_PACKAGES = [
    "architecture",
    "builtin",
    "cache",
    "compiler",
    "exec",
    "ide",
    "integration",
    "ladder",
    "lexer",
    "lineage",
    "lowering",
    "model",
    "normalizer",
    "parser",
    "platform",
    "protocol",
    "resolver",
    "server",
    "sql",
    "test",
    "testdatagen",
    "testing",
    "values",
]

# Measured 2026-10-05: every package's live heap peak is under 342 MB (the largest, root, 264 MB), so P1-21's rule
# (the live peak plus half again, at least 512 MB, rounded up to 256 MB) gives each 512 MB. The longest, integration,
# runs 31 s on a desk: no shards, and `medium` (300 s) leaves CI's slower runners room.
_CORE_TEST_MEMORY_MB = 512

_CORE_TEST_EXCLUDED_TAGS = [
    "census",
    "differential",
    "guardrail",
    "stress",
]

[junit_test(
    name = "core_tests_" + p,
    memory_mb = _CORE_TEST_MEMORY_MB,
    size = "medium",
    select = ["--select-package=com.legend." + p] + (
        # A7: the differential runs in //core:corpus_differential_test alone, where its data is declared
        ["--exclude-classname=.*CorpusDifferentialTest"] if p == "integration" else []
    ),
    exclude_tags = _CORE_TEST_EXCLUDED_TAGS,
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
) for p in _CORE_TEST_PACKAGES]

# the root package's own classes: com.legend, less every package above
junit_test(
    name = "core_tests_root",
    memory_mb = _CORE_TEST_MEMORY_MB,
    size = "medium",
    select = ["--select-package=com.legend"] + ["--exclude-package=com.legend." + p for p in _CORE_TEST_PACKAGES],
    exclude_tags = _CORE_TEST_EXCLUDED_TAGS,
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
)

test_suite(
    name = "core_tests",
    tests = [":core_tests_" + p for p in _CORE_TEST_PACKAGES + ["root"]],
    visibility = ["//gates:__pkg__"],
)

# THE CROSS-ENGINE DIFFERENTIAL (Bazel workplan P3-18, D3 row 4): legend-lite's SQL over the seed, against the
# oracle's answers, both generated by //scripts/corpus:gen_differential from the committed stress corpus. It ran in
# no build until 2026-10-05 (an Assumptions skip on a Maven directory); now it runs and asserts on every build.
junit_test(
    name = "corpus_differential_test",
    memory_mb = 768,
    data = [
        "//scripts/corpus:diff/seed.sql",
        "//scripts/corpus:gen_differential",
    ],
    jvm_flags = ["-Dcorpus.differential.seed=$(rlocationpath //scripts/corpus:diff/seed.sql)"],
    select = ["--select-class=com.legend.integration.CorpusDifferentialTest"],
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
    visibility = ["//gates:__pkg__"],
)

# THE PLANNER RUNS ON java.base ALONE (Bazel workplan P3-19): PlanOnJavaBase plans a DuckDB and a Postgres query in a
# JVM whose only module is java.base, and exits non-zero when a check fails. A plain java_test, G16's one allowlisted
# non-junit_test (tools/guards/defs.bzl): its verdict is the JVM's own module limit, which a test runner on the class
# path cannot have; until 2026-10-05 a junit test started it as a child JVM of itself.
java_test(
    name = "planner_on_java_base_test",
    size = "small",
    jvm_flags = ["--limit-modules=java.base"],
    main_class = "com.legend.PlanOnJavaBase",
    use_testrunner = False,
    runtime_deps = [":core_tests_lib"],
)

# THE BULK-LOAD PATH, on its own (Bazel workplan P3-02): DuckDB's Appender is found through ServiceLoader
# (:duckdb_load) and lands exactly the rows the insert text lands; RowLoadTest asserts the Appender ran.
junit_test(
    name = "duckdb_load_test",
    memory_mb = 768,
    size = "small",
    select = ["--select-class=com.legend.exec.RowLoadTest"],
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
)

# THE SERVER'S POSTGRES ARM (Bazel workplan P0-08): a type: Postgres connection resolves through
# ConnectionResolver and the product's own driver set (:drivers), against the Postgres 16 that
# gate 7P starts (@embedded_postgres, //testing EmbeddedPostgres). Light: one class, one query.
junit_test(
    name = "postgres_arm_test",
    memory_mb = 768,
    size = "medium",
    srcs = ["src/test/java/com/legend/server/PostgresArmTest.java"],
    data = [
        "@embedded_postgres//:pg/PG_ROOT",
        "@embedded_postgres//:postgres",
    ],
    jvm_flags = ["-Dembedded.postgres.root=$(rlocationpath @embedded_postgres//:pg/PG_ROOT)"],
    select = ["--select-class=com.legend.server.PostgresArmTest"],
    runtime_deps = [":drivers"],
    target_compatible_with = EMBEDDED_POSTGRES_COMPATIBLE,
    deps = [
        ":core",
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
    visibility = ["//gates:__pkg__"],
)

# THE SOURCE CHECKS: tests whose subject is the code, not what it does — the
# guardrails (a hard rule: file and method size, layer boundaries), the ratchets
# (a count that may only fall: SQL built as text, JDBC accessor sites) and the
# ledgers (every instance registered with its reason). Their own targets, so a
# static check reports as one and is not carried by the behaviour suite. Tagged
# on the class: @Tag("guardrail") reads core's own tree, @Tag("census") walks
# other modules too — which is why only IT declares them.
junit_test(
    name = "guardrails",
    memory_mb = 1280,
    size = "medium",
    # exactly what the guards read (P3-05, A11): the declared source list (its files ride in its runfiles), the two
    # single files, and the jar lists
    data = [
        "src/main/java/com/legend/compiler/spec/LiteralUnroll.java",
        "src/main/java/com/legend/sql/dialect/DuckDb.java",
        ":core_test_jar",
        ":guardrails_sources",
        ":product_jars",
    ],
    # the two single files a guard reads, by runfiles path (Bazel workplan P1-05), and every file the source guards
    # read, as one declared list (SourceFiles, P3-27): no guard walks a directory
    jvm_flags = [
        "-Dcore.literal_unroll=$(rlocationpath src/main/java/com/legend/compiler/spec/LiteralUnroll.java)",
        "-Dcore.duckdb_dialect=$(rlocationpath src/main/java/com/legend/sql/dialect/DuckDb.java)",
        "-Dlegend.sources=$(rlocationpath :guardrails_sources)",
        "-Dlegend.product.jars=$(rlocationpath :product_jars)",
        "-Dlegend.test.jars=$(rlocationpath :core_test_jar)",
    ],
    select = [
        "--select-package=com.legend",
        "--include-tag=guardrail",
    ],
    # :duckdb_load too: ArchitectureTest judges every product library (theImportIsEveryProductLibrary)
    runtime_deps = [
        ":core_tests_lib",
        ":duckdb_load",
    ],
    visibility = ["//gates:__pkg__"],
)

# THE PRODUCT'S JARS, declared: what ArchitectureTest imports and NoEagerTypeReferencesTest loads (Bazel workplan
# P3-27), never found from a class's code source or a directory listing beside it
java_jars(
    name = "product_jars",
    testonly = True,
    rlocation_paths = True,
    transitive = False,
    deps = _CORE_TARGETS + [":duckdb_load"],
)

# core's test classes, for the one rule that checks them too (ArchitectureTest.upstreamJavaNeverEntersCore)
java_jars(
    name = "core_test_jar",
    testonly = True,
    rlocation_paths = True,
    transitive = False,
    deps = [":core_tests_lib"],
)

# what the source guards and censuses read, declared (SourceFiles; Bazel workplan P3-27)
file_list(
    name = "guardrails_sources",
    testonly = True,
    srcs = _CORE_READS,
)

file_list(
    name = "census_sources",
    testonly = True,
    srcs = _CENSUS_READS,
)

junit_test(
    name = "census",
    memory_mb = 1024,
    size = "medium",
    # the declared source list; its files ride in its runfiles (P3-05, A11)
    data = [":census_sources"],
    jvm_flags = ["-Dlegend.sources=$(rlocationpath :census_sources)"],
    select = [
        "--select-package=com.legend",
        "--include-tag=census",
    ],
    runtime_deps = [":core_tests_lib"],
    visibility = ["//gates:__pkg__"],
)

# THE SCALE BENCHMARK (Bazel workplan P3-05, A11): generated models far past the 1K baseline — 10K, 100K, dense links,
# complex multi-hop queries, 100K chaotic classes, and the 100K parse-vs-compile profile. They assert nothing beyond "no
# failures" and print timings, so they are one program, not tests:
#   bazel run //core:scale -- 10k | 100k | dense | complex | chaotic | profile
# Its heap is the largest one's (StressTestChaotic: live peak measured 2026-10-04 plus half again, 6656 MB).
legend_java_library(
    name = "scale_lib",
    testonly = True,
    srcs = ["src/scale/java/com/legend/integration/Scale.java"],
    deps = [
        "@maven_test//:org_junit_platform_junit_platform_engine",
        "@maven_test//:org_junit_platform_junit_platform_launcher",
    ],
)

legend_java_binary(
    name = "scale",
    testonly = True,
    jvm_flags = [
        "-Xmx6656m",
        "-Duser.timezone=GMT",
    ],
    main_class = "com.legend.integration.Scale",
    tags = ["manual"],
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
        ":scale_lib",
        "@maven_test//:org_junit_jupiter_junit_jupiter_engine",
    ],
)

# Gate 10: THE STRESS CORPUS — every stress service suite on DuckDB shared
# sessions, held by the MIN_PASS ratchet inside StressServiceSuitesTest (no -D modes: the knobs are
# //core:stress_tool's). Its own lane: the stress group is what gate 1 leaves out.
junit_test(
    name = "stress_suites",
    memory_mb = 768,
    size = "enormous",
    select = ["--select-class=com.legend.integration.StressServiceSuitesTest"],
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
)

# Gate 10 on H2 (Bazel workplan P3-12): the same suites on H2, a fresh, freshly seeded session per test (the engine's
# shape), held by MIN_PASS_H2 (StressServiceSuitesH2Test). Until 2026-10-05 the H2 floor was enforced by no lane.
junit_test(
    name = "stress_suites_h2",
    # live peak 232 MB, 692 MB before a collection (measured 2026-10-05 at -Xmx1024m): stress_suites' 768 holds it
    memory_mb = 768,
    size = "enormous",
    select = ["--select-class=com.legend.integration.StressServiceSuitesH2Test"],
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
)

# The stress corpus's measuring tool (StressTool: data overrides, row dumps, one service, a session policy):
#   bazel run //core:stress_tool -- [--backend duckdb|h2] [--sessions fresh|shared] [--only NAME] [--data F.pure,...]
#       [--rows DIR] [--out DIR]
legend_java_binary(
    name = "stress_tool",
    testonly = True,
    # the corpus is core_tests_lib's classpath resources (P3-05)
    jvm_flags = ["-Duser.timezone=GMT"],
    main_class = "com.legend.integration.StressTool",
    tags = ["manual"],
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
)

# ── GENERATED FILES ─────────────────────────────────────────────────────────────
# Committed files that are generator OUTPUTS (their generators: //spec, "THE
# GENERATORS"). `bazel run //core:update_generated` (or //:update_generated)
# writes them; `bazel test` fails when a committed copy differs, naming the command.
_GENERATED = {
    "src/main/java/com/legend/builtin/DynaFn.java": "//spec:gen_dynafn",
    "src/main/java/com/legend/builtin/Pure.java": "//spec:gen_natives",
    "src/main/java/com/legend/compiler/NameResolver.java": "//spec:gen_imports",
    "src/main/resources/com/legend/builtin/engine-handlers.tsv": "//spec:gen_engine_handlers",
    "src/main/resources/com/legend/builtin/native-claims.tsv": "//spec:gen_claims",
    "src/main/resources/com/legend/builtin/prelude.pure": "//spec:gen_prelude",
}

# the committed copies are also generator INPUTS (a generator splices its part
# in), as is the hand-owned membership list natives reads
exports_files(
    list(_GENERATED.keys()) + [
        "src/main/resources/com/legend/builtin/native-membership.tsv",
    ],
    visibility = ["//spec:__pkg__"],
)

# core's main Java sources as TEXT — the prelude generator reads what the
# platform's own code names
filegroup(
    name = "main_java",
    srcs = glob(["src/main/java/**"]),
    visibility = ["//spec:__pkg__"],
)

# THE STRESS CORPUS'S GENERATED FILES (Bazel workplan P2-01, from spike S5): ten files in the stress directory
# are outputs of //scripts/corpus's Bazel actions, diff-tested in //:generated. They are never generator INPUTS: the generators read
# :stress_sources, which leaves all ten out.
stress_layout(
    name = "stress_layout",
    visibility = ["//scripts/corpus:__pkg__"],
)

# the committed layout (core/stress.bzl as JSON), read by the corpus generators
exports_files(
    ["src/test/resources/com/legend/integration/stress-layout.json"],
    visibility = ["//scripts/corpus:__pkg__"],
)

# every .pure under the test resources: the keyword census's share of "the .pure this repository owns" (P2-20)
filegroup(
    name = "test_pure",
    srcs = glob(["src/test/resources/**/*.pure"]),
    visibility = ["//scripts/parser:__pkg__"],
)

# the stress files' table of contents, a resource beside stress-layout.json (StressCorpus)
stress_index(
    name = "stress_index",
    srcs = glob(["src/test/resources/stress/*.pure"]),
    out = "src/test/resources/com/legend/integration/stress-index.txt",
)

# every stress file, the generated ten included: what the corpus ratchets measure (//scripts/corpus, P2-04)
filegroup(
    name = "stress_files",
    srcs = glob(["src/test/resources/stress/*.pure"]),
    visibility = ["//scripts/corpus:__pkg__"],
)

filegroup(
    name = "stress_sources",
    srcs = glob(
        ["src/test/resources/stress/*.pure"],
        exclude = ["src/test/resources/stress/" + f for f in STRESS_GENERATED],
    ),
    visibility = ["//scripts/corpus:__pkg__"],
)

write_source_files(
    name = "update_stress_corpus",
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nThis stress file is generated by scripts/corpus -- regenerate: bazel run //core:update_stress_corpus",
    visibility = ["//:__pkg__"],
    files = {
        "src/test/resources/stress/" + f: "//scripts/corpus:%s/%s" % (d, f)
        for f, d in STRESS_GENERATED.items()
    } | {
        # the layout itself, for the readers that are not Starlark (model.py, StressCorpus.java)
        "src/test/resources/com/legend/integration/stress-layout.json": ":stress_layout",
    },
)

write_source_files(
    name = "update_generated",
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nThis file is generated from the pinned upstream release — regenerate: bazel run //:update_generated",
    files = _GENERATED,
    visibility = ["//:__pkg__"],
)

# THE LEAN SQL LADDER's current emission (P2-13): LadderRender runs each rung in database mode on DuckDB and writes
# what it sent; the pins in src/test/resources/ladder change only through `bazel run //core:update_ladder`, and
# //core:update_ladder_test (in //:generated) fails when the emission moves. The <rung>.lean.sql beside them are
# hand-written targets. LadderRender checks this list against the model's rungs.
_LADDER_RUNGS = [
    "r01_constant",
    "r02_literalListSize",
    "r03_stringConstant",
    "r04_countNoLet",
    "r05_countOneLet",
    "r06_columnVsList",
    "r07_projectRows",
    "r08_positionalCell",
    "r09_twoAssertsOneLet",
    "r10_twoLets",
    "r11_floatLeniency",
    "r12_classLetManyReaders",
]

java_run(
    name = "ladder_report",
    testonly = True,
    outs = ["ladder/%s.current.sql" % r for r in _LADDER_RUNGS],
    arguments = ["{OUT_DIR}"] + _LADDER_RUNGS,
    main_class = "com.legend.ladder.LadderRender",
    mnemonic = "Generate",
    deps = [
        ":core_tests_lib",
        ":drivers",
    ],
)

write_source_files(
    name = "update_ladder",
    testonly = True,
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nThe lean SQL ladder's emission moved -- if the shape change is deliberate, re-pin: bazel run //core:update_ladder, and review the diff",
    files = {"src/test/resources/ladder/%s.current.sql" % r: ":ladder/%s.current.sql" % r for r in _LADDER_RUNGS},
    visibility = ["//:__pkg__"],
)

# NOT a generated file: native-membership.tsv is hand-owned (membership is OURS). This writes a DRAFT from
# Pure.java's constants over it for a person to finish (git diff shows what moved); NativeSignatureGeneratorTest is
# the check. Outside //:update_generated, with no diff test (the docs:draft_own_corpus_ledger pattern; P2-17).
write_source_files(
    name = "draft_native_membership",
    diff_test = False,
    files = {"src/main/resources/com/legend/builtin/native-membership.tsv": "//spec:native_membership_draft"},
)

# CORE AS THE GENERATORS REWRITE IT: the generated Java and prelude in place of
# the committed copies. Only the claims generator runs on it — the one generator
# that reads the COMPILED registries the others rewrite. At a fixpoint (every
# committed file current) it is core, byte for byte.
legend_java_library(
    name = "core_next",
    srcs = glob(
        ["src/main/java/**/*.java"],
        exclude = [
            "src/main/java/com/legend/builtin/DynaFn.java",
            "src/main/java/com/legend/builtin/Pure.java",
            "src/main/java/com/legend/compiler/NameResolver.java",
        ],
    ) + [
        "//spec:gen_dynafn",
        "//spec:gen_imports",
        "//spec:gen_natives",
    ],
    # core's sources import the two modules below core (null annotations, the JSON codec)
    deps = [
        "//base",
        "//json",
    ],
    resources = glob(
        ["src/main/resources/**"],
        exclude = ["src/main/resources/com/legend/builtin/prelude.pure"],
    ),
    visibility = ["//spec:__pkg__"],
    runtime_deps = [":core_next_prelude"],
)

legend_java_library(
    name = "core_next_prelude",
    resource_strip_prefix = "spec/generated",
    resources = ["//spec:gen_prelude"],
)

# THE LAYERS OF //core (execution plan rule 0.12; Bazel workplan P2-12): a query of each library's direct deps, made
# from the libraries above; tools/deps/core-layers.txt is the policy they are held to.
core_layer_queries(not_layers = {
    "core": "the umbrella every consumer depends on: it exports the layers",
    "core_next": "core as the generators rewrite it, for the claims generator (spec)",
    "core_next_prelude": "core_next's regenerated prelude resource",
    "core_tests_lib": "the tests' library, not product code",
    "drivers": "the JDBC drivers a running core is given (//tools/deps:drivers_closure holds them)",
    "duckdb_load": "the drivers' bulk loader, beside the layers",
    "plan_side": "the plan-only umbrella: it exports the planner's layers, none of execution (C2a)",
    "scale_lib": "the scale benchmark's launcher (//core:scale), not product code",
    "shadow_binding": "a test-lane ServiceLoader resource",
    "toy_grammar": "a toy section grammar for the registry's own test (section_grammar_registry_test)",
})

guards_package()
