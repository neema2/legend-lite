# Measured 2026-10-05: every package's live heap peak is under 342 MB (the largest, root, 264 MB), so P1-21's rule
# (the live peak plus half again, at least 512 MB, rounded up to 256 MB) gives each 512 MB. The longest, integration,
# ran 31 s on a desk then: no shards, and `medium` (300 s) left CI's slower runners room. 2026-10-18: integration has
# grown to 95-100 s on a Linux desk, and on CI's Windows runner it reached its 300 s limit, timing out on main's own
# push run of da2dd235 (300.3 s) and on #54's first run (300.8 s), passing on re-runs of the same commits: it is
# `large` (900 s); the other packages stay `medium`.
_CORE_TEST_MEMORY_MB = 512

# the packages whose run outgrew `medium`'s 300 s on CI's slowest runner (above)
_CORE_TEST_LARGE = ["integration"]

_CORE_TEST_EXCLUDED_TAGS = [
    "census",
    "differential",
    "guardrail",
    "stress",
]

[junit_test(
    name = "core_tests_" + p,
    memory_mb = _CORE_TEST_MEMORY_MB,
    size = "large" if p in _CORE_TEST_LARGE else "medium",
    select = ["--select-package=com.legend." + p] + (
        # A7: the differential runs in //core:corpus_differential_test alone, where its data is declared
        ["--exclude-classname=.*CorpusDifferentialTest"] if p == "integration" else []
    ),
    exclude_tags = _CORE_TEST_EXCLUDED_TAGS,
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
) for p in _CORE_TEST_PACKAGES]

# the root package's own classes: com.legend, less every package above
junit_test(
    name = "core_tests_root",
    memory_mb = _CORE_TEST_MEMORY_MB,
    size = "medium",
    select = ["--select-package=com.legend"] + ["--exclude-package=com.legend." + p for p in _CORE_TEST_PACKAGES],
    exclude_tags = _CORE_TEST_EXCLUDED_TAGS,
    runtime_deps = [
        ":core_tests_lib",
        ":drivers",
    ],
)

test_suite(
    name = "core_tests",
    tests = [":core_tests_" + p for p in _CORE_TEST_PACKAGES + ["root"]],
    visibility = ["//gates:__pkg__"],
)

