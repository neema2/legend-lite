# class. ShippedArtifactRootsTest reads both answers; each artifact still the edge's is pinned there as K2's, by its
# owner, and goes as it re-roots (the GUARD stream, 2026-11-18).
_SHIPPED_ARTIFACTS = [
    "//:java",
    "//:native",
