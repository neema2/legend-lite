    deps = ["//base", "//json", ":compiler", ":compiler_element_type", ":database", ":error", ":execution", ":execution_plan", ":model", ":parser", ":plan", ":planner", ":protocol", ":lite_v1", ":result", ":saved_queries", ":sql_dialect"],
)

_CORE_TARGETS = [
    "//base", "//json", ":spi", ":cache", ":values", ":error", ":diagnostics", ":lexer", ":sql", ":protocol", ":model", ":parser", ":door",
    ":builtin", ":platform", ":compiler_element_type", ":sql_dialect", ":database", ":compiler", ":normalizer",
    ":lineage", ":validation", ":lowering", ":plan", ":resolver", ":setup", ":exec", ":testexec", ":probe", ":testdatagen",
    ":execution_plan", ":result", ":planner", ":lite_v1", ":saved_queries", ":testplan", ":execution",
    ":test_execution", ":ide", ":test",
    ":server_lib", ":test_plan", ":exec_program",
]

# THE PLAN SIDE (C2a, docs/PLAN_EXECUTION_SPLIT_AND_DATABASE_OWNER_2026_10_03.md): the planner and every library it
# stands on, and none of execution (exec, testdatagen, driver, probe, ide, test, server_lib). A plan-only consumer
# depends on this, so the build proves it carries no database and no driver.
_PLAN_SIDE_TARGETS = [
    "//base", "//json", ":spi", ":cache", ":values", ":error", ":diagnostics", ":lexer", ":sql", ":protocol", ":model", ":parser", ":door",
    ":builtin", ":platform", ":compiler_element_type", ":sql_dialect", ":database", ":compiler", ":normalizer",
    ":lineage", ":validation", ":lowering", ":plan", ":resolver", ":setup", ":execution_plan", ":result", ":planner", ":lite_v1",
]

legend_java_library(
    name = "plan_side",
    exports = _PLAN_SIDE_TARGETS,
    # //sdlc-server/grammar: the SDLC's one door to the compiler (the protocol program's leg 7, 2026-10-10)
    visibility = ["//sdlc-server/grammar:__pkg__", "//wasm:__pkg__"],
)

# THE UMBRELLA: what every consumer depends on today and keeps depending on.
# It compiles nothing; it exports the targets above. A consumer that needs only
# the front end may later depend on `:parser` and stop carrying exec and server.
legend_java_library(
    name = "core",
    exports = _CORE_TARGETS,
    # //datacube, //engine-client and //wasm name narrower targets (the build rebuild's Phase 1), so the whole of core
    # is not theirs to reach again by accident; nor SDLC-lite's, whose compiler is //sdlc-server/grammar's, on the plan
    # side (the protocol program's leg 7, 2026-10-10)
    visibility = ["//parser-equivalence:__pkg__", "//pct:__pkg__", "//spec:__pkg__", "//tools/census:__pkg__", "//tools/engine-runner:__pkg__", "//tools/legend:__pkg__"],
)

# THE JDBC DRIVERS, as their own target. core never compiles against a driver: it
# speaks java.sql, and names driver classes only as strings (a DriverCells provider names its own
# "org.duckdb.JsonNode"). So a driver is a RUNTIME choice made by whatever runs
# core — a test, a server, a CLI — not a dependency of the product. A target that
# executes queries depends on this; one that only plans (a WASM or native planner)
# does not, and then carries no external jar at all.
legend_java_library(
    name = "drivers",
    runtime_deps = [
        ":duckdb_cells",
        # MongoDB's connector rides with the drivers (2026-10-17, docs/MONGODB_PLAN_2026_10_16.md D12): a running core
        # is given its connectors as it is given its drivers, by ServiceLoader
        ":mongodb_connector",
        # Postgres's JSON cells (jsonb as JSON text) behind the DriverCells seam, as DuckDB's (step 9, 2026-10-19)
        ":postgres_cells",
        "@duckdb_jdbc//jar",
        "@h2//jar",
        "@postgresql//jar",
        "@sqlite_jdbc//jar",
    ],
    visibility = ["//datacube:__pkg__", "//pct:__pkg__", "//spec:__pkg__"],
)

# Postgres's JSON cells (a json or jsonb PGobject as its JSON text) behind core's DriverCells seam, found by
# ServiceLoader: it rides with the drivers, so core still compiles against none (step 9, 2026-10-19).
legend_java_library(
    name = "postgres_cells",
    srcs = glob(["src/main/postgres/**/*.java"]),
    resources = glob(["src/main/postgres/META-INF/**"]),
    resource_strip_prefix = "core/src/main/postgres",
    deps = [
        ":core",
        "@postgresql//jar",
    ],
)

# THE COMPATIBILITY EDGE (docs/PLAN_AS_DATA_2026_11_07.md 2.7, the plan-as-data design's step 8, 2026-11-08): the
# records a run under the compatibility rules plans into a test plan (the referee's ledger texts) and the edge a harness
# hands the run; its codec registered for the test plan's format through META-INF/services. The product depends on no
# edge (G5): only the harnesses that run under the compatibility rules do.
legend_java_library(
    name = "edge",
    srcs = glob(["src/main/java/com/legend/edge/*.java"], exclude = [
        "src/main/java/com/legend/edge/EdgeServer.java",
        "src/main/java/com/legend/edge/EngineMount.java",
        "src/main/java/com/legend/edge/ServiceTestRunner.java",
        "src/main/java/com/legend/edge/TdsObjectsWriter.java",
        "src/main/java/com/legend/edge/StoreWords.java",
    ]),
    # //wasm (D1.0b, 2026-11-12): the compiler's boundary answers legend-engine's routes in the tab and Python
    visibility = ["//parser-equivalence:__pkg__", "//spec:__pkg__", "//pct:__pkg__", "//tools/census:__pkg__", "//wasm:__pkg__"],
    resources = glob(["src/main/edge/META-INF/**"]),
    resource_strip_prefix = "core/src/main/edge",
    # the plan's records (B2b, 2026-11-11): a seed's referee's copy is a load, its steps written by the plan's codec;
    # the dialect source and the declared database type (D1.0, 2026-11-12): the edge's dialects, PureText
    # pure/v1's upstream routes (D1.0b, 2026-11-12): legend-engine's API, planned through the edge's dialects over the
    # product's API kit (lite_v1) and its compiler, protocol and test-data generator
    # the parse door (main's C5-J item 1, merged 2026-11-15): pure/v1's grammar routes, moved here by D1.0b, parse
    # through it as the run's wall asks
    # values (W8, 2026-11-16): legend-engine's and legend-pure's cell text (Presenter) reads a date's own value
    deps = ["//arrow_ipc", "//base", "//json", ":compiler", ":compiler_element_type", ":database", ":door", ":error",
            ":execution_plan", ":model", ":parser", ":plan", ":planner", ":protocol", ":lite_v1", ":result", ":sql",
            ":sql_dialect", ":test_plan", ":testdatagen", ":testplan", ":values", ":setup", ":resolver", ":platform", ":lowering", ":lineage", ":builtin",
            # the compatibility appeals' run and their referee (census C2, 2026-11-17): the run's hook EdgeRun and
            # the rows they read after the body's run
            ":testexec", ":exec", ":diagnostics"],
)

# THE SHIPPED SERVER'S ROOT (phase D's D1.0b, 2026-11-12): lite's own server with legend-engine's API mounted beside
# it (edge/EdgeServer.java), its run the product's door in the edge's dialects. Its own target: the edge's routes are
# the plan side's (the compiler's boundary answers them in the tab and Python), the root runs a server.
legend_java_library(
    name = "edge_server",
    srcs = ["src/main/java/com/legend/edge/EdgeServer.java", "src/main/java/com/legend/edge/EngineMount.java"],
    # legend-engine's module, registered for the product's server to find only when configured (K2's server half,
    # the user's ruling of 2026-11-18: "Product root, edge opt-in"; com.legend.server.MountProvider)
    resources = glob(["src/main/edge_server/META-INF/**"]),
    resource_strip_prefix = "core/src/main/edge_server",
    visibility = ["//spec:__pkg__", "//pct:__pkg__"],
    deps = ["//base", ":edge", ":edge_store_words", ":execution", ":lite_v1", ":saved_queries", ":server_lib"],
)

# MONGODB'S CONNECTOR (docs/MONGODB_PLAN_2026_10_16.md §5.2, D12; 2026-10-17): a session on a MongoDBConnection, and
# the statements that run the pipelines the MongoDb dialect writes, behind core's DatabaseConnector seam, found by
# ServiceLoader as the bulk loader is. The one source set that compiles against the MongoDB driver: core compiles
# against no client library.
legend_java_library(
    name = "mongodb_connector",
    srcs = glob(["src/main/mongodb/**/*.java"]),
    resources = glob(["src/main/mongodb/META-INF/**"]),
    resource_strip_prefix = "core/src/main/mongodb",
    deps = [
        "//base",
        "//json",
        ":error",
        ":exec",
        ":execution_plan",
        ":result",
        ":values",
        "@bson//jar",
        "@mongodb_driver_core//jar",
        "@mongodb_driver_sync//jar",
    ],
    runtime_deps = ["@bson_record_codec//jar"],
)

# DuckDB's own cell types behind core's DriverCells seam, found by ServiceLoader: it rides with the drivers, so core
# still compiles against none. Until A2 (2026-11-10, docs/DATA_DELIVERY_DESIGN_2026_11_10.md) it was :duckdb_load and
# held DuckDB's bulk load too (its Appender behind a BulkLoad seam), deleted with the plan's rows step: the model's
# data is statements in the plan.
legend_java_library(
    name = "duckdb_cells",
    srcs = glob(["src/main/duckdb/**/*.java"]),
    resources = glob(["src/main/duckdb/META-INF/**"]),
    resource_strip_prefix = "core/src/main/duckdb",
    deps = [
        ":core",
        "@duckdb_jdbc//jar",
    ],
)

# THE PRODUCT, runnable: the HTTP server (LSP, query execution, SQL, diagrams) with
# the JDBC drivers. `bazel run //core:server` (port 8080, or $PORT);
# `bazel build //core:server_deploy.jar` is the one self-contained jar to ship. Its root is the PRODUCT's (K2's server
# half, the user's ruling of 2026-11-18: "Product root, edge opt-in"): lite's own server, legend-engine's API
# (edge/EdgeServer.java, edge/EngineMount.java) carried in the same jar and mounted only with --engine legend-engine.
legend_java_binary(
    name = "server",
    # the product's own entry (K2's server half, the user's ruling of 2026-11-18: "Product root, edge opt-in"):
    # legend-engine's module (:edge_server) ships in the same artifact, mounted only when the configuration names it
    # (--engine legend-engine; com.legend.server.MountProvider, found by ServiceLoader)
    main_class = "com.legend.server.LegendHttpServer",
    runtime_deps = [
        ":core",
        ":drivers",
        ":edge_server",
    ],
    visibility = [
        "//:__pkg__",
        "//fixtures/saved-queries:__pkg__",
        "//query:__pkg__",
        "//query-store:__pkg__",
    ],
)

