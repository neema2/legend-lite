Service stress::TQ_OrNegatives_Root
{
    pattern: '/stress/typed/tq_ornegatives_root';
    documentation: '`||` of three comparisons with zero, on three number types. On the optional properties.';
    execution: Single
    {
    query: |typedvalues::TypedValue.all()
        ->filter({x|(($x.amountOpt < 0D) || ($x.quantityOpt < 0) || ($x.rateOpt < 0.0))})
        ->project(~[
            valueId:x|$x.valueId,
            amount:x|$x.amountOpt,
            quantity:x|$x.quantityOpt,
            rate:x|$x.rateOpt
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TQ_OrNegatives_Root_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"valueId":"TV-06","amount":-2.5,"quantity":-5,"rate":-1.5},{"valueId":"TV-10","amount":0.1,"quantity":2147483647,"rate":-0.25},{"valueId":"TV-13","amount":1.00000000000000009,"quantity":-2147483648,"rate":7.75}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::TQ_NotOrNe_Root
{
    pattern: '/stress/typed/tq_notorne_root';
