Service stress::TQ_PresentNotGt_Root
{
    pattern: '/stress/typed/tq_presentnotgt_root';
    documentation: '`isNotEmpty` and `!` over `>` on a Number. On the optional properties.';
    execution: Single
    {
    query: |typedvalues::TypedValue.all()
        ->filter({x|($x.metricOpt->isNotEmpty() && !($x.metricOpt > 2))})
        ->project(~[
            valueId:x|$x.valueId,
            metric:x|$x.metricOpt
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TQ_PresentNotGt_Root_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"valueId":"TV-01","metric":2.0000},{"valueId":"TV-03","metric":-1.0000},{"valueId":"TV-08","metric":1.5000},{"valueId":"TV-15","metric":1.0000}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

