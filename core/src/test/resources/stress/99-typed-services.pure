          [
            p = [typedvalues::Grade.PRIME, typedvalues::Grade.STANDARD]
          ]
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0003","value":"WATCH"},{"tradeId":"TRD-0004","value":"DEFAULTED"},{"tradeId":"TRD-0007","value":"WATCH"},{"tradeId":"TRD-0009","value":"DEFAULTED"},{"tradeId":"TRD-0012","value":"WATCH"},{"tradeId":"TRD-0013","value":null},{"tradeId":"TRD-0015","value":null},{"tradeId":"TRD-0016","value":null},{"tradeId":"TRD-0017","value":null},{"tradeId":"TRD-0018","value":null},{"tradeId":"TRD-0019","value":null},{"tradeId":"TRD-0020","value":null}]';
                  }#;
              }#
          ]
        },
        one:
        {
          parameters:
          [
            p = [typedvalues::Grade.DEFAULTED]
          ]
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","value":"PRIME"},{"tradeId":"TRD-0002","value":"STANDARD"},{"tradeId":"TRD-0003","value":"WATCH"},{"tradeId":"TRD-0005","value":"STANDARD"},{"tradeId":"TRD-0006","value":"PRIME"},{"tradeId":"TRD-0007","value":"WATCH"},{"tradeId":"TRD-0008","value":"STANDARD"},{"tradeId":"TRD-0010","value":"PRIME"},{"tradeId":"TRD-0011","value":"STANDARD"},{"tradeId":"TRD-0012","value":"WATCH"},{"tradeId":"TRD-0013","value":null},{"tradeId":"TRD-0014","value":"PRIME"},{"tradeId":"TRD-0015","value":null},{"tradeId":"TRD-0016","value":null},{"tradeId":"TRD-0017","value":null},{"tradeId":"TRD-0018","value":null},{"tradeId":"TRD-0019","value":null},{"tradeId":"TRD-0020","value":null}]';
