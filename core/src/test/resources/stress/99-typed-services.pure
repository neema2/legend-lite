}

Service stress::TL_AmountScale18_Eq_Root
{
    pattern: '/stress/typed/tl_amountscale18_eq_root';
    documentation: 'A Decimal literal with 18 fractional digits. Its twin, the parameter, must return the same row (F61: the engine rounds the literal to scale 16).';
    execution: Single
    {
    query: |typedvalues::TypedValue.all()
        ->filter({x|($x.amountOpt == 1.000000000000000001D)})
        ->project(~[
            valueId:x|$x.valueId,
            value:x|$x.amountOpt
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TL_AmountScale18_Eq_Root_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"valueId":"TV-08","value":1.000000000000000001}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::TP_AmountScale18_Eq_Root
{
    pattern: '/stress/typed/tp_amountscale18_eq_root';
    documentation: 'The same comparand as a Decimal parameter, which the engine binds exactly.';
    execution: Single
    {
    query: {p: Decimal[1]|typedvalues::TypedValue.all()
        ->filter({x|($x.amountOpt == $p)})
        ->project(~[
            valueId:x|$x.valueId,
            value:x|$x.amountOpt
        ])};
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TP_AmountScale18_Eq_Root_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 absent cells.
        expected_rows:
        {
          parameters:
          [
            p = 1.000000000000000001D
          ]
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"valueId":"TV-08","value":1.000000000000000001}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

