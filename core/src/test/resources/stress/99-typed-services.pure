Service stress::TO_Grade_Eq
{
    pattern: '/stress/typed/to_grade_eq';
    documentation: 'An optional typedvalues::Grade parameter: `$p->isEmpty() || ($x.gradeOpt == $p->toOne())`. Given, it filters; absent, every row is kept.';
    execution: Single
    {
    query: {p: typedvalues::Grade[0..1]|typedvalues::TypedValue.all()
        ->filter({x|($p->isEmpty() || ($x.gradeOpt == $p->toOne()))})
        ->project(~[
            valueId:x|$x.valueId,
            value:x|$x.gradeOpt
        ])};
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
