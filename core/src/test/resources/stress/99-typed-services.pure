    {
    query: |typedvalues::TypedValue.all()
        ->filter({x|((($x.valueDateOpt >= %2024-06-03) || ($x.tradeDateOpt == %2024-02-29)) && !($x.nameOpt == 'beta'))})
        ->project(~[
            valueId:x|$x.valueId,
            valueDate:x|$x.valueDateOpt,
            tradeDate:x|$x.tradeDateOpt,
            name:x|$x.nameOpt
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
