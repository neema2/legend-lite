Service stress::TV_TimeAndOctet_Root
{
    pattern: '/stress/typed/tv_timeandoctet_root';
    documentation: 'The StrictTime and Byte properties projected, the control for the Cutoff services.';
    execution: Single
    {
    query: |typedvalues::TimeAndOctet.all()
        ->project(~[
            valueId:x|$x.valueId,
            cutoff:x|$x.cutoff,
            cutoffOpt:x|$x.cutoffOpt,
            octet:x|$x.octet,
            octetOpt:x|$x.octetOpt
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TV_TimeAndOctet_Root_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 15 rows; 6 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"valueId":"TV-01","cutoff":"17:30:00","cutoffOpt":"17:30:00","octet":-128,"octetOpt":-128},{"valueId":"TV-02","cutoff":"17:29:59","cutoffOpt":null,"octet":0,"octetOpt":null},{"valueId":"TV-03","cutoff":"17:30:01","cutoffOpt":"17:30:01","octet":127,"octetOpt":127},{"valueId":"TV-04","cutoff":"00:00:00","cutoffOpt":"00:00:00","octet":1,"octetOpt":1},{"valueId":"TV-05","cutoff":"23:59:59","cutoffOpt":"23:59:59","octet":-1,"octetOpt":0},{"valueId":"TV-06","cutoff":"12:00:00","cutoffOpt":"12:00:00","octet":64,"octetOpt":64},{"valueId":"TV-07","cutoff":"17:30:00","cutoffOpt":"17:30:00","octet":7,"octetOpt":7},{"valueId":"TV-08","cutoff":"09:00:00","cutoffOpt":null,"octet":0,"octetOpt":0},{"valueId":"TV-09","cutoff":"17:30:00","cutoffOpt":"09:00:00","octet":100,"octetOpt":100},{"valueId":"TV-10","cutoff":"08:30:00","cutoffOpt":"08:30:00","octet":-100,"octetOpt":null},{"valueId":"TV-11","cutoff":"16:00:00","cutoffOpt":"17:29:59","octet":12,"octetOpt":12},{"valueId":"TV-12","cutoff":"18:00:00","cutoffOpt":"18:00:00","octet":13,"octetOpt":13},{"valueId":"TV-13","cutoff":"06:00:00","cutoffOpt":null,"octet":99,"octetOpt":99},{"valueId":"TV-14","cutoff":"17:00:00","cutoffOpt":"17:00:00","octet":42,"octetOpt":null},{"valueId":"TV-15","cutoff":"20:00:00","cutoffOpt":"20:00:00","octet":5,"octetOpt":5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::TV_TimeAndOctet_Hop
{
    pattern: '/stress/typed/tv_timeandoctet_hop';
    documentation: 'The StrictTime and Byte properties projected one hop from a trade.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            valueId:x|$x.timeAndOctet.valueId,
            cutoff:x|$x.timeAndOctet.cutoff,
            cutoffOpt:x|$x.timeAndOctet.cutoffOpt,
            octet:x|$x.timeAndOctet.octet,
            octetOpt:x|$x.timeAndOctet.octetOpt
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TV_TimeAndOctet_Hop_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 40 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","valueId":"TV-01","cutoff":"17:30:00","cutoffOpt":"17:30:00","octet":-128,"octetOpt":-128},{"tradeId":"TRD-0002","valueId":"TV-02","cutoff":"17:29:59","cutoffOpt":null,"octet":0,"octetOpt":null},{"tradeId":"TRD-0003","valueId":"TV-03","cutoff":"17:30:01","cutoffOpt":"17:30:01","octet":127,"octetOpt":127},{"tradeId":"TRD-0004","valueId":"TV-04","cutoff":"00:00:00","cutoffOpt":"00:00:00","octet":1,"octetOpt":1},{"tradeId":"TRD-0005","valueId":"TV-05","cutoff":"23:59:59","cutoffOpt":"23:59:59","octet":-1,"octetOpt":0},{"tradeId":"TRD-0006","valueId":"TV-06","cutoff":"12:00:00","cutoffOpt":"12:00:00","octet":64,"octetOpt":64},{"tradeId":"TRD-0007","valueId":"TV-07","cutoff":"17:30:00","cutoffOpt":"17:30:00","octet":7,"octetOpt":7},{"tradeId":"TRD-0008","valueId":"TV-08","cutoff":"09:00:00","cutoffOpt":null,"octet":0,"octetOpt":0},{"tradeId":"TRD-0009","valueId":"TV-09","cutoff":"17:30:00","cutoffOpt":"09:00:00","octet":100,"octetOpt":100},{"tradeId":"TRD-0010","valueId":"TV-10","cutoff":"08:30:00","cutoffOpt":"08:30:00","octet":-100,"octetOpt":null},{"tradeId":"TRD-0011","valueId":"TV-11","cutoff":"16:00:00","cutoffOpt":"17:29:59","octet":12,"octetOpt":12},{"tradeId":"TRD-0012","valueId":"TV-12","cutoff":"18:00:00","cutoffOpt":"18:00:00","octet":13,"octetOpt":13},{"tradeId":"TRD-0013","valueId":null,"cutoff":null,"cutoffOpt":null,"octet":null,"octetOpt":null},{"tradeId":"TRD-0014","valueId":"TV-13","cutoff":"06:00:00","cutoffOpt":null,"octet":99,"octetOpt":99},{"tradeId":"TRD-0015","valueId":null,"cutoff":null,"cutoffOpt":null,"octet":null,"octetOpt":null},{"tradeId":"TRD-0016","valueId":null,"cutoff":null,"cutoffOpt":null,"octet":null,"octetOpt":null},{"tradeId":"TRD-0017","valueId":null,"cutoff":null,"cutoffOpt":null,"octet":null,"octetOpt":null},{"tradeId":"TRD-0018","valueId":null,"cutoff":null,"cutoffOpt":null,"octet":null,"octetOpt":null},{"tradeId":"TRD-0019","valueId":null,"cutoff":null,"cutoffOpt":null,"octet":n