        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"valueId":"TV-01","valueDate":"2024-06-03","tradeDate":"2024-02-29","name":"alpha"},{"valueId":"TV-03","valueDate":"2024-06-04","tradeDate":"2024-03-01","name":"ALPHA"},{"valueId":"TV-08","valueDate":"2024-06-03","tradeDate":"2023-03-01","name":"O\'Neil"},{"valueId":"TV-11","valueDate":"2024-06-01","tradeDate":"2024-02-29","name":"alpha"},{"valueId":"TV-12","valueDate":"2024-07-03","tradeDate":"2024-03-31","name":"alphabet"},{"valueId":"TV-14","valueDate":"2024-06-30","tradeDate":"2020-02-29","name":"mu"},{"valueId":"TV-15","valueDate":"2025-01-01","tradeDate":null,"name":"aleph"}]';
