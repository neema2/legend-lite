{
    pattern: '/stress/semi/sj/explode';
    documentation: 'Explode on H2: each leg\'s hop joined to SEMI_HOP, one row per joined leg; a leg naming no hop drops out, and a document with none is one row with no hop.';
    execution: Single
    {
    query: |semi::SjRoute.all()
        ->project(
            [
                x|$x.docKey,
                x|$x.hops.hopId,
                x|$x.hops.label
            ],
