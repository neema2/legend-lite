// Semi-structured documents: booking payloads in a SEMISTRUCTURED column, read by extractFromSemiStructured
// along dotted, indexed and bracket-quoted paths, by a store Filter, through a Binding (its keys, a nested object,
// and a to-many flattened one row per element), by a join that explodes a document's array, and, on the DuckDB side
// alone, by wildcard paths and the array_* functions (8118-semi.pure). SJ_ services answer a TDS, so legend-engine
// runs their tests on H2, over 66-store-surface.pure's SURFACE_TYPES.C_SEMI; SD_ services answer a Relation, which
// it runs on DuckDB, over SEMI_DOC. The reference evaluator navigates each document -- see scripts/corpus/semi.py.
//
// GENERATED by scripts/corpus/build.py -- do not edit by hand.

###Data
Data semi::SurfaceData
{
  Relational
  #{
    default.SEMI_HOP:
      'HOP_ID,LABEL\n' +
      'HP-1,NYSE primary\n' +
      'HP-2,Nasdaq sweep\n' +
      'HP-3,LSE auction\n' +
      'HP-4,BATS route\n' +
      'HP-5,Nasdaq odd lot\n' +
      'HP-7,unused route\n';
    default.SURFACE_TYPES:
      'TK,TK2,C_SEMI,C_JSON\n' +
      'ST-01,A,"{"ref":"TKT-1001","qty":400,"px":187.25,"fee":12.5,"live":true,"dates":{"trade":"2024-06-03","stamp":"2024-06-03T09:30:15"},"legs":[{"hop":"HP-1","venue":"XNYS","qty":300},{"hop":"HP-2","venue":"XNAS","qty":100}],"grid":[[1,2],[3,4]],"desk info":{"book.code":"EQ-NY"}}",\n' +
      'ST-02,A,"{"ref":"TKT-1002","qty":50,"px":0.75,"fee":0.25,"live":false,"dates":{"trade":"2024-06-04","stamp":"2024-06-04T16:59:59"},"legs":[{"hop":"HP-3","venue":"XLON","qty":50}],"grid":[[9,8]],"desk info":{"book.code":"EQ-LN"}}",\n' +
      'ST-03,B,"{"ref":null,"qty":0,"px":-12.5,"live":false,"legs":[],"grid":[]}",\n' +
      'ST-04,A,"{"ref":"TKT-1004","qty":120,"legs":[{"hop":"HP-9","venue":null,"qty":20},{"hop":"HP-4","venue":"BATS","qty":100},{"hop":"HP-5","venue":"XNAS","qty":0}]}",\n' +
      'ST-05,C,{},\n';
  }#
}

###Data
Data semi::DuckData
{
  Relational
  #{
    default.SEMI_DOC:
      'DOC_ID,DOC\n' +
      'SD-01,"{""ref"":""TKT-1001"",""qty"":400,""px"":187.25,""fee"":12.5,""live"":true,""dates"":{""trade"":""2024-06-03"",""stamp"":""2024-06-03T09:30:15""},""legs"":[{""hop"":""HP-1"",""venue"":""XNYS"",""qty"":300},{""hop"":""HP-2"",""venue"":""XNAS"",""qty"":100}],""grid"":[[1,2],[3,4]],""desk info"":{""book.code"":""EQ-NY""}}"\n' +
      'SD-02,"{""ref"":""TKT-1002"",""qty"":50,""px"":0.75,""fee"":0.25,""live"":false,""dates"":{""trade"":""2024-06-04"",""stamp"":""2024-06-04T16:59:59""},""legs"":[{""hop"":""HP-3"",""venue"":""XLON"",""qty"":50}],""grid"":[[9,8]],""desk info"":{""book.code"":""EQ-LN""}}"\n' +
      'SD-03,"{""ref"":null,""qty"":0,""px"":-12.5,""live"":false,""legs"":[],""grid"":[]}"\n' +
      'SD-04,"{""ref"":""TKT-1004"",""qty"":120,""legs"":[{""hop"":""HP-9"",""venue"":null,""qty"":20},{""hop"":""HP-4"",""venue"":""BATS"",""qty"":100},{""hop"":""HP-5"",""venue"":""XNAS"",""qty"":0}]}"\n' +
      'SD-05,{}\n' +
      'SD-06,\n';
    default.SEMI_HOP:
      'HOP_ID,LABEL\n' +
      'HP-1,NYSE primary\n' +
      'HP-2,Nasdaq sweep\n' +
      'HP-3,LSE auction\n' +
      'HP-4,BATS route\n' +
      'HP-5,Nasdaq odd lot\n' +
      'HP-7,unused route\n';
  }#
}

###Service
Service stress::SJ_Text
{
    pattern: '/stress/semi/sj/text';
    documentation: 'Navigation to a string, as VARCHAR and as STRING, on H2: a JSON null and an absent key are both absent.';
    execution: Single
    {
    query: |semi::SjDoc.all()
        ->project(
            [
                x|$x.docKey,
                x|$x.ref,
                x|$x.refName
            ],
            ['docKey', 'ref', 'refName']
        );
        mapping: semi::SurfaceDocs;
        runtime: semi::SurfaceRT;
    }
  testSuites:
  [
    SJ_Text_suite:
    {
      data:
      [
        connections:
        [
          semiEnv:
            Reference
            #{
              semi::SurfaceData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 4 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"docKey":"ST-01","ref":"TKT-1001","refName":"TKT-1001"},{"docKey":"ST-02","ref":"TKT-1002","refName":"TKT-1002"},{"docKey":"ST-03","ref":null,"refName":null},{"docKey":"ST-04","ref":"TKT-1004","refName":"TKT-1004"},{"docKey":"ST-05","ref":null,"refName":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

