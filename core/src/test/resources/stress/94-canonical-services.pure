                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"identifier":"TRD-0001","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":190500.0}},{"identifier":"TRD-0002","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":477500.0}},{"identifier":"TRD-0003","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":250000.0}},{"identifier":"TRD-0004","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":250000.0}},{"identifier":"TRD-0005","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":250000.0}},{"identifier":"TRD-0006","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":250000.0}},{"identifier":"TRD-0007","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":282000.0}},{"identifier":"TRD-0008","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":18975.0}},{"identifier":"TRD-0009","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":576750.0}},{"identifier":"TRD-0010","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":498000.0}},{"identifier":"TRD-0011","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":167300.0}},{"identifier":"TRD-0012","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":369000.0}},{"identifier":"TRD-0013","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":171250.0}},{"identifier":"TRD-0014","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":69000.0}},{"identifier":"TRD-0015","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":35000.0}},{"identifier":"TRD-0016","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":264600.0}},{"identifier":"TRD-0017","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":385000.0}},{"identifier":"TRD-0018","amount":