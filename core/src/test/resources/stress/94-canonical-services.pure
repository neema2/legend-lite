###Service
Service stress::M1_TradeCanonical
{
    pattern: '/stress/m1';
    documentation: 'M2M invariance, canonical side: the same facts through relational -> source model -> M2M -> canonical model, with every property renamed on the way.';
    execution: Single
    {
    query: |canonical::CanonicalTrade.all()
        ->project(
            [
                x|$x.identifier,
                x|$x.executedOn,
                x|$x.unitPrice,
                x|$x.units,
                x|$x.state,
                x|$x.grossValue
            ],
            ['identifier', 'executedOn', 'unitPrice', 'units', 'state', 'grossValue']
        );
        mapping: canonical::M2MMapping;
        runtime: stress::CanonicalRT;
    }
  testSuites:
  [
    M1_TradeCanonical_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"identifier":"TRD-0001","executedOn":"2024-06-03","unitPrice":190.5,"units":1000.0,"state":"EXECUTED","grossValue":190500.0},{"identifier":"TRD-0002","executedOn":"2024-06-03","unitPrice":191.0,"units":2500.0,"state":"EXECUTED","grossValue":477500.0},{"identifier":"TRD-0003","executedOn":"2024-06-03","unitPrice":500.0,"units":500.0,"state":"EXECUTED","grossValue":250000.0},{"identifier":"TRD-0004","executedOn":"2024-06-03","unitPrice":200.0,"units":1250.0,"state":"EXECUTED","grossValue":250000.0},{"identifier":"TRD-0005","executedOn":"2024-06-03","unitPrice":125.0,"units":2000.0,"state":"EXECUTED","grossValue":250000.0},{"identifier":"TRD-0006","executedOn":"2024-06-03","unitPrice":312.5,"units":800.0,"state":"EXECUTED","grossValue":250000.0},{"identifier":"TRD-0007","executedOn":"2024-06-03","unitPrice":188.0,"units":1500.0,"state":"EXECUTED","grossValue":282000.0},{"identifier":"TRD-0008","executedOn":"2024-06-04","unitPrice":189.75,"units":100.0,"state":"CANCELLED","grossValue":18975.0},{"identifier":"TRD-0009","executedOn":"2024-06-04","unitPrice":192.25,"units":3000.0,"state":"EXECUTE","grossValue":576750.0},{"identifier":"TRD-0010","executedOn":"2024-06-04","unitPrice":415.0,"units":1200.0,"state":"EXECUTED","grossValue":498000.0},{"identifier":"TRD-0011","executedOn":"2024-06-04","unitPrice":418.25,"units":400.0,"state":"EXECUTED","grossValue":167300.0},{"identifier":"TRD-0012","executedOn":"2024-06-05","unitPrice":410.0,"units":900.0,"state":"PENDING","grossValue":369000.0},{"identifier":"TRD-0013","executedOn":"2024-06-05","unitPrice":6.85,"units":25000.0,"state":"EXECUTED","grossValue":171250.0},{"identifier":"TRD-0014","executedOn":"2024-06-05","unitPrice":6.9,"units":10000.0,"state":"EXECUTED","grossValue":69000.0},{"identifier":"TRD-0015","executedOn":"2024-06-06","unitPrice":7.0,"units":5000.0,"state":"SETTLED","grossValue":35000.0},{"identifier":"TRD-0016","executedOn":"2024-06-06","unitPrice":176.4,"units":1500.0,"state":