      [
        // the service's expected rows: 7
        expected_rows:
        {
          data:
          [
            store::DB:
              Reference
              #{
                stress::TestData
              }#
          ];
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
