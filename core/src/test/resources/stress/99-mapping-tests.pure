    Q2_PnLBookDeskTrader:
    {
      function: |pnl::DailyPnL.all()
          ->project(~[
              pnlId:x|$x.pnlId,
              pnlDate:x|$x.pnlDate,
              totalPnL:x|$x.totalPnL,
              realizedPnL:x|$x.realizedPnL,
