Mapping stress::MT_CheckMapping
(
  include checks::CheckMapping

  testSuites:
  [
    CK_DealChecked:
    {
      function: |checks::CkDeal.all()
          ->graphFetchChecked(#{
    checks::CkDeal
    {
      dealId,
      state,
      kind,
      ccy
    }
  }#)
          ->serialize(#{
    checks::CkDeal
    {
      dealId,
      state,
      kind,
      ccy
    }
  }#);
      tests:
      [
        // the service's expected rows: 15
        expected_rows:
        {
          data:
          [
            checks::CheckDB:
              Reference
              #{
                checks::CheckData
              }#
          ];
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
