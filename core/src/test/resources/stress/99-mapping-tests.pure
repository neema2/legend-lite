              newTradePnL:x|$x.newTradePnL,
              carryPnL:x|$x.carryPnL,
              fxPnL:x|$x.fxPnL,
              commissions:x|$x.commissions,
              fees:x|$x.fees,
              currency:x|$x.currency,
              isOfficial:x|$x.isOfficial,
              publishedTime:x|$x.publishedTime,
              version:x|$x.version,
              bkId:x|$x.book.bookId,
              bkName:x|$x.book.name,
              bkCurrency:x|$x.book.currency,
              bkType:x|$x.book.bookType,
              bkStrategy:x|$x.book.strategy,
              bkIsActive:x|$x.book.isActive,
              bkOpenDate:x|$x.book.openDate,
              bkLegalEntity:x|$x.book.legalEntity,
              bkPnlYTD:x|$x.book.pnlYTD,
              deskId:x|$x.book.desk.deskId,
              deskName:x|$x.book.desk.name,
              deskType:x|$x.book.desk.deskType,
              deskAssetClass:x|$x.book.desk.assetClass,
              deskRegion:x|$x.book.desk.region,
              deskIsActive:x|$x.book.desk.isActive,
              deskHeadTrader:x|$x.book.desk.headTrader,
              deskCostCenter:x|$x.book.desk.costCenter,
              deskFloor:x|$x.book.desk.floor,
              traderId:x|$x.trader.traderId,
              traderFirst:x|$x.trader.firstName,
              traderLast:x|$x.trader.lastName,
              traderSeniority:x|$x.trader.seniority,
              traderEmail:x|$x.trader.email,
              traderIsActive:x|$x.trader.isActive,
              traderHireDate:x|$x.trader.hireDate,
              traderLicense:x|$x.trader.license,
              deskId2:x|$x.desk.deskId,
              deskName2:x|$x.desk.name,
              deskRegion2:x|$x.desk.region,
              deskAsset2:x|$x.desk.assetClass,
              deskActive2:x|$x.desk.isActive
          ]);
