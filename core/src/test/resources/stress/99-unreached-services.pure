Service stress::UO_JoinChain
{
    pattern: '/stress/unreached/joinchain';
    documentation: 'The store\'s two joins as one chain, OP_A to the OP_B its NEXT_K names and on to OP_C: a hop that lands twice, on an absent value, from a NULL key and an orphan.';
    execution: Single
    {
    query: |surface::OpLink.all()
        ->project(~[
            k:x|$x.k,
            nextV:x|$x.nextV,
            nextCode:x|$x.nextCode
        ]);
        mapping: surface::OperationSurface;
        runtime: surface::OpRT;
    }
  testSuites:
  [
    UO_JoinChain_suite:
    {
      data:
      [
        connections:
        [
          opEnv:
            Reference
            #{
              surface::OpData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 6 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"k":"OA-0001","nextV":null,"nextCode":null},{"k":"OA-0002","nextV":null,"nextCode":null},{"k":"OA-0003","nextV":"V-001","nextCode":"V-001"},{"k":"OA-0004","nextV":"V-002","nextCode":"V-002"},{"k":"OA-0005","nextV":null,"nextCode":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

