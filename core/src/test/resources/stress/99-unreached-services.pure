      ]
      tests:
      [
        // 5 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"k":"OB-0001","firstOf":"V-001"},{"k":"OB-0002","firstOf":"V-002"},{"k":"OB-0003","firstOf":"OB-0003"},{"k":"OB-0004","firstOf":"V-004"},{"k":"OB-0005","firstOf":"V-005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

