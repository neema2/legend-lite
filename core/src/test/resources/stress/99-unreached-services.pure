Service stress::UO_Merge
{
    pattern: '/stress/unreached/merge';
    documentation: 'The merge operation, projected: its two sets concatenated, each row absent where its own set maps nothing, though each table holds a value there.';
    execution: Single
    {
    query: |surface::MergeTgt.all()
        ->project(~[
            k:x|$x.k,
            a:x|$x.a,
            b:x|$x.b
        ]);
        mapping: surface::LastSurface;
        runtime: surface::LastRT;
    }
