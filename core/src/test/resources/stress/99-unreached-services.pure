Service stress::UO_RouterUnionTree
{
    pattern: '/stress/unreached/routeruniontree';
    documentation: 'The router union, fetched as a graph.';
    execution: Single
    {
    query: |surface::Op.all()
        ->graphFetch(#{
  surface::Op
  {
    k,
    v
  }
}#)
        ->serialize(#{
  surface::Op
  {
    k,
    v
  }
}#);
        mapping: surface::OperationSurface;
        runtime: surface::OpRT;
    }
  testSuites:
  [
    UO_RouterUnionTree_suite:
    {
      data:
      [
        connections:
        [
          opEnv:
            Reference
            #{
              surface::OpData
            }#
        ]
      ]
      tests:
      [
        // 10 rows; 2 absent cells.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"k":"OA-0001","v":"V-001"},{"k":"OA-0002","v":"V-002"},{"k":"OA-0003","v":null},{"k":"OA-0004","v":"V-004"},{"k":"OA-0005","v":"V-005"},{"k":"OB-0001","v":"V-001"},{"k":"OB-0002","v":"V-002"},{"k":"OB-0003","v":null},{"k":"OB-0004","v":"V-004"},{"k":"OB-0005","v":"V-005"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

