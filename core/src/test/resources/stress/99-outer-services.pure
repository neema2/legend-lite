// Explicit join types in a mapping's join chains: a property's chain whose second hop is (OUTER) or (INNER),
// and a ~filter through one hop or two, typed OUTER, INNER, mixed or untyped, over seed rows on one side only at
// each hop (8119-outer.pure). The pinned engine writes no full or right outer join in a mapping; each typing that
// it does write answers its own rows, which the reference evaluator computes hop by hop -- see
// scripts/corpus/outer.py.
//
// GENERATED by scripts/corpus/build.py -- do not edit by hand.

###Data
Data outer::OuterData
{
  Relational
  #{
    default.OJ_ACCOUNT:
      'ACCOUNT_ID,LABEL\n' +
      'AC-1,Prime brokerage\n' +
      'AC-3,Custody\n' +
      'AC-4,Dormant\n' +
      'AC-6,\n';
    default.OJ_ALLOC:
      'ALLOC_ID,ACCOUNT_ID\n' +
      'AL-1,AC-1\n' +
      'AL-2,AC-9\n' +
      'AL-3,AC-3\n' +
      'AL-5,\n' +
      'AL-6,AC-6\n';
    default.OJ_ORDER:
      'ORDER_ID,ALLOC_ID\n' +
      'OR-1,AL-1\n' +
      'OR-2,AL-2\n' +
      'OR-3,AL-9\n' +
      'OR-4,\n' +
      'OR-5,AL-5\n' +
      'OR-6,AL-6\n';
  }#
}

###Service
Service stress::OJT_Booked
{
    pattern: '/stress/outer/ojt/booked';
    documentation: 'A property chain, its second hop (OUTER): the account\'s label, NULL where either hop lands on nothing. On H2.';
    execution: Single
    {
    query: |outer::OjBooked.all()
        ->project(
            [
                x|$x.orderId,
                x|$x.accountLabel
            ],
            ['orderId', 'accountLabel']
        );
        mapping: outer::OuterMapping;
        runtime: outer::OuterRT;
    }
  testSuites:
  [
    OJT_Booked_suite:
    {
      data:
      [
        connections:
        [
          outerEnv:
            Reference
            #{
              outer::OuterData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 5 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"orderId":"OR-1","accountLabel":"Prime brokerage"},{"orderId":"OR-2","accountLabel":null},{"orderId":"OR-3","accountLabel":null},{"orderId":"OR-4","accountLabel":null},{"orderId":"OR-5","accountLabel":null},{"orderId":"OR-6","accountLabel":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

