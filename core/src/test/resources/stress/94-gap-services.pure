Service stress::MX_TradeLinkTier
{
    pattern: '/stress/m2m/tradelinktier';
    documentation: 'A passed-through object\'s enumeration-mapped property: the source\'s relational enumeration mapping, reached through the chain.';
    execution: Single
    {
    query: |m2m::TradeLink.all()
        ->graphFetch(#{
  m2m::TradeLink
  {
    dealId,
    party
    {
      partyId,
      tier
    }
  }
}#)
        ->serialize(#{
  m2m::TradeLink
  {
    dealId,
    party
    {
      partyId,
      tier
    }
  }
}#);
        mapping: m2m::GapViews;
        runtime: m2m::GapViewsRT;
    }
  testSuites:
  [
    MX_TradeLinkTier_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"dealId":"TRD-0001","party":{"partyId":"CP-0001","tier":"PRIME"}},{"dealId":"TRD-0002","party":{"partyId":"CP-0001","tier":"PRIME"}},{"dealId":"TRD-0003","party":{"partyId":"CP-0002","tier":"PRIME"}},{"dealId":"TRD-0004","party":{"partyId":"CP-0002","tier":"PRIME"}},{"dealId":"TRD-0005","party":{"partyId":"CP-0003","tier":"CORE"}},{"dealId":"TRD-0006","party":{"partyId":"CP-0001","tier":"PRIME"}},{"dealId":"TRD-0007","party":null},{"dealId":"TRD-0008","party":{"partyId":"CP-0001","tier":"PRIME"}},{"dealId":"TRD-0009","party":{"partyId":"CP-0002","tier":"PRIME"}},{"dealId":"TRD-0010","party":{"partyId":"CP-0001","tier":"PRIME"}},{"dealId":"TRD-0011","party":{"partyId":"CP-0003","tier":"CORE"}},{"dealId":"TRD-0012","party":{"partyId":"CP-0002","tier":"PRIME"}},{"dealId":"TRD-0013","party":{"partyId":"CP-0002","tier":"PRIME"}},{"dealId":"TRD-0014","party":{"partyId":"CP-0004","tier":"EDGE"}},{"dealId":"TRD-0015","party":{"partyId":"CP-0003","tier":"CORE"}},{"dealId":"TRD-0016","party":{"partyId":"CP-0003","tier":"CORE"}},{"dealId":"TRD-0017","party":{"partyId":"CP-0004","tier":"EDGE"}},{"dealId":"TRD-0018","party":{"partyId":"CP-0002","tier":"PRIME"}},{"dealId":"TRD-0019","party":{"partyId":"CP-0001","tier":"PRIME"}},{"dealId":"TRD-0020","party":{"partyId":"CP-0002","tier":"PRIME"}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MXR_LocalProperty
{
    pattern: '/stress/m2m/twin/localproperty';
    documentation: 'GAP\'s rows straight from SQL, the local property\'s value computed in the query.';
    execution: Single
    {
    query: |surface::GapSrc.all()
        ->project(~[
            k:x|$x.k,
            v:x|$x.v,
            localTag:x|$x.v->map(v|$v->toLower())
        ]);
        mapping: surface::GapSourceMapping;
        runtime: surface::GapSourceRT;
    }
  testSuites:
  [
    MXR_LocalProperty_suite:
    {
      data:
      [
        connections:
        [
          gapEnv:
            Reference
            #{
              surface::GapData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"k":"G-0001","v":"A-001","localTag":"a-001"},{"k":"G-0002","v":"A-002","localTag":"a-002"},{"k":"G-0003","v":null,"localTag":null},{"k":"G-0004","v":"A-004","localTag":"a-004"},{"k":"G-0005","v":"A-005","localTag":"a-005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MX_LocalProperty
{
    pattern: '/stress/m2m/localproperty';
    documentation: 'A local mapping property, `+localTag`, projected through the M2M mapping that declares it.';
    execution: Single
    {
    query: |surface::GapTgt.all()
        ->project(
            [
                x|$x.k,
                x|$x.v,
                x|$x.localTag
            ],
            ['k', 'v', 'localTag']
        );
        mapping: surface::GapPureSurface;
        runtime: surface::GapPureRT;
    }
  testSuites:
  [
    MX_LocalProperty_suite:
    {
      data:
      [
        connections:
        [
          gapEnv:
            Reference
            #{
              surface::GapData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"k":"G-0001","v":"A-001","localTag":"a-001"},{"k":"G-0002","v":"A-002","localTag":"a-002"},{"k":"G-0003","v":null,"localTag":null},{"k":"G-0004","v":"A-004","localTag":"a-004"},{"k":"G-0005","v":"A-005","localTag":"a-005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

