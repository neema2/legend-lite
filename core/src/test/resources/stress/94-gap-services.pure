// The M2M services over the mappings legend-lite refuses to load: the enumeration transforms and the complex
// property passthrough of 8115-m2m-gaps.pure, and the local property of 75-surface-gaps.pure (`+localTag`) with its
// relational twin. Apart from 99-m2m-services.pure because lite excludes those files and so these with them (core
// StressExclusions); the engine's run reads every file. See scripts/corpus/m2m.py.
//
// GENERATED by scripts/corpus/build.py -- do not edit by hand.

###Data
Data surface::GapData
{
  Relational
  #{
    default.GAP:
      'K,A,B,N\n' +
      'G-0001,A-001,B-001,318\n' +
      'G-0002,A-002,B-002,325\n' +
      'G-0003,,B-003,332\n' +
      'G-0004,A-004,,339\n' +
      'G-0005,A-005,B-005,\n';
  }#
}

###Service
Service stress::MX_DealSide
{
    pattern: '/stress/m2m/dealside';
    documentation: 'An M2M enumeration transform of a String code, two of whose codes (B, BOT) collapse onto one value.';
    execution: Single
    {
    query: |m2m::DealSide.all()
        ->project(
            [
                x|$x.dealId,
                x|$x.side
            ],
            ['dealId', 'side']
        );
        mapping: m2m::GapViews;
        runtime: m2m::GapViewsRT;
    }
  testSuites:
  [
    MX_DealSide_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 19 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0001","side":"BUY"},{"dealId":"TRD-0002","side":"BUY"},{"dealId":"TRD-0003","side":"BUY"},{"dealId":"TRD-0004","side":"SELL"},{"dealId":"TRD-0005","side":"BUY"},{"dealId":"TRD-0006","side":"BUY"},{"dealId":"TRD-0007","side":"BUY"},{"dealId":"TRD-0008","side":"BUY"},{"dealId":"TRD-0009","side":"BUY"},{"dealId":"TRD-0010","side":"BUY"},{"dealId":"TRD-0011","side":"BUY"},{"dealId":"TRD-0013","side":"SELL"},{"dealId":"TRD-0014","side":"BUY"},{"dealId":"TRD-0015","side":"BUY"},{"dealId":"TRD-0016","side":"BUY"},{"dealId":"TRD-0017","side":"SELL"},{"dealId":"TRD-0018","side":"BUY"},{"dealId":"TRD-0019","side":"BUY"},{"dealId":"TRD-0020","side":"BUY"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

