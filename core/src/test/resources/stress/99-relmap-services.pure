Service stress::RM_UnionTds
{
    pattern: '/stress/relmap/uniontds';
    documentation: 'The union projected as a TDS.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->project(
            [
                x|$x.dealId,
                x|$x.bookId,
                x|$x.notional,
                x|$x.status,
                x|$x.tradeType
            ],
            ['dealId', 'bookId', 'notional', 'status', 'tradeType']
        );
        mapping: relmap::Unioned;
        runtime: relmap::UnionedRT;
    }
  testSuites:
  [
    RM_UnionTds_suite:
