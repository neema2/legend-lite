Service stress::RMR_PricedTop
{
    pattern: '/stress/relmap/twin/pricedtop';
    documentation: 'The three largest doubled notionals.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->project(~[
            dealId:x|$x.dealId,
            doubled:x|($x.notional * 2.0)
        ])
        ->sort([~doubled->descending(), ~dealId->ascending()])
        ->limit(3);
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
    }
  testSuites:
  [
    RMR_PricedTop_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0018","doubled":9825000.0},{"dealId":"TRD-0019","doubled":3920000.0},{"dealId":"TRD-0020","doubled":1950000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

