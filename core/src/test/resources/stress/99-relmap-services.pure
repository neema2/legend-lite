Service stress::RMR_Union
{
    pattern: '/stress/relmap/twin/union';
    documentation: 'The principal deals and BK-VOL-01\'s, which no principal deal is in.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->filter({x|(($x.tradeType == 'PRINCIPAL') || ($x.bookId == 'BK-VOL-01'))})
        ->project(~[
            dealId:x|$x.dealId,
            bookId:x|$x.bookId,
            notional:x|$x.notional,
            status:x|$x.status,
            tradeType:x|$x.tradeType
        ]);
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
    }
  testSuites:
  [
    RMR_Union_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 8 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0004","bookId":"BK-CASH-US","notional":250000.0,"status":"EXECUTED","tradeType":"PRINCIPAL"},{"dealId":"TRD-0005","bookId":"BK-VOL-01","notional":250000.0,"status":"EXECUTED","tradeType":"AGENCY"},{"dealId":"TRD-0012","bookId":"BK-VOL-01","notional":369000.0,"status":"PENDING","tradeType":"AGENCY"},{"dealId":"TRD-0013","bookId":"BK-CASH-EU","notional":171250.0,"status":"EXECUTED","tradeType":"PRINCIPAL"},{"dealId":"TRD-0017","bookId":"BK-CASH-EU","notional":385000.0,"status":"EXECUTED","tradeType":"PRINCIPAL"},{"dealId":"TRD-0018","bookId":"BK-VOL-01","notional":4912500.0,"status":"EXECUTED","tradeType":"AGENCY"},{"dealId":"TRD-0019","bookId":"BK-VOL-01","notional":1960000.0,"status":"EXECUTED","tradeType":"AGENCY"},{"dealId":"TRD-0020","bookId":"BK-VOL-01","notional":975000.0,"status":"REJECTED","tradeType":"AGENCY"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::RM_Union
