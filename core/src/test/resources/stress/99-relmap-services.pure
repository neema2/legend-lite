Service stress::RMR_MixedUnion
{
    pattern: '/stress/relmap/twin/mixedunion';
    documentation: 'The principal deals, then every deal again: a union keeps both.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->filter({x|($x.tradeType == 'PRINCIPAL')})
        ->project(~[
            dealId:x|$x.dealId,
            notional:x|$x.notional,
            status:x|$x.status
        ])
        ->concatenate(relmap::RmDeal.all() ->project(~[ dealId:x|$x.dealId, notional:x|$x.notional, status:x|$x.status ]));
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
    }
  testSuites:
  [
    RMR_MixedUnion_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 23 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0004","notional":250000.0,"status":"EXECUTED"},{"dealId":"TRD-0013","notional":171250.0,"status":"EXECUTED"},{"dealId":"TRD-0017","notional":385000.0,"status":"EXECUTED"},{"dealId":"TRD-0001","notional":190500.0,"status":"EXECUTED"},{"dealId":"TRD-0002","notional":477500.0,"status":"EXECUTED"},{"dealId":"TRD-0003","notional":250000.0,"status":"EXECUTED"},{"dealId":"TRD-0004","notional":250000.0,"status":"EXECUTED"},{"dealId":"TRD-0005","notional":250000.0,"status":"EXECUTED"},{"dealId":"TRD-0006","notional":250000.0,"status":"EXECUTED"},{"dealId":"TRD-0007","notional":282000.0,"status":"EXECUTED"},{"dealId":"TRD-0008","notional":18975.0,"status":"CANCELLED"},{"dealId":"TRD-0009","notional":576750.0,"status":"EXECUTE"},{"dealId":"TRD-0010","notional":498000.0,"status":"EXECUTED"},{"dealId":"TRD-0011","notional":167300.0,"status":"EXECUTED"},{"dealId":"TRD-0012","notional":369000.0,"status":"PENDING"},{"dealId":"TRD-0013","notional":171250.0,"status":"EXECUTED"},{"dealId":"TRD-0014","notional":69000.0,"status":"EXECUTED"},{"dealId":"TRD-0015","notional":35000.0,"status":"SETTLED"},{"dealId":"TRD-0016","notional":264600.0,"status":"EXECUTED"},{"dealId":"TRD-0017","notional":385000.0,"status":"EXECUTED"},{"dealId":"TRD-0018","notional":4912500.0,"status":"EXECUTED"},{"dealId":"TRD-0019","notional":1960000.0,"status":"EXECUTED"},{"dealId":"TRD-0020","notional":975000.0,"status":"REJECTED"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

