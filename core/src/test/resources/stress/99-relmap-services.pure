Service stress::RMR_PricedLarge
{
    pattern: '/stress/relmap/twin/pricedlarge';
    documentation: 'The deals in the large band.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->filter({x|(if(($x.notional > 300000.0), |'large', |'small') == 'large')})
        ->project(~[
            dealId:x|$x.dealId,
            band:x|if(($x.notional > 300000.0), |'large', |'small')
        ]);
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
