          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0001","bookId":"BK-CASH-US","notional":190500.0,"rank":8},{"dealId":"TRD-0002","bookId":"BK-CASH-US","notional":477500.0,"rank":3},{"dealId":"TRD-0003","bookId":"BK-CASH-US","notional":250000.0,"rank":5},{"dealId":"TRD-0004","bookId":"BK-CASH-US","notional":250000.0,"rank":5},{"dealId":"TRD-0005","bookId":"BK-VOL-01","notional":250000.0,"rank":5},{"dealId":"TRD-0006","bookId":"BK-CASH-US","notional":250000.0,"rank":5},{"dealId":"TRD-0007","bookId":"BK-CASH-US","notional":282000.0,"rank":4},{"dealId":"TRD-0008","bookId":"BK-CASH-US","notional":18975.0,"rank":10},{"dealId":"TRD-0009","bookId":"BK-CASH-US","notional":576750.0,"rank":1},{"dealId":"TRD-0010","bookId":"BK-CASH-US","notional":498000.0,"rank":2},{"dealId":"TRD-0011","bookId":"BK-CASH-US","notional":167300.0,"rank":9},{"dealId":"TRD-0012","bookId":"BK-VOL-01","notional":369000.0,"rank":4},{"dealId":"TRD-0013","bookId":"BK-CASH-EU","notional":171250.0,"rank":3},{"dealId":"TRD-0014","bookId":"BK-CASH-EU","notional":69000.0,"rank":4},{"dealId":"TRD-0015","bookId":"BK-CASH-EU","notional":35000.0,"rank":5},{"dealId":"TRD-0016","bookId":"BK-CASH-EU","notional":264600.0,"rank":2},{"dealId":"TRD-0017","bookId":"BK-CASH-EU","notional":385000.0,"rank":1},{"dealId":"TRD-0018","bookId":"BK-VOL-01","notional":4912500.0,"rank":1},{"dealId":"TRD-0019","bookId":"BK-VOL-01","notional":1960000.0,"rank":2},{"dealId":"TRD-0020","bookId":"BK-VOL-01","notional":975000.0,"rank":3}]';
