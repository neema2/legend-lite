Service stress::RMR_IssuerFlags
{
    pattern: '/stress/relmap/twin/issuerflags';
    documentation: 'Each issuer\'s profile flag through hier::IssuerMapping\'s Binding transformer; HI-0005 has no profile.';
    execution: Single
    {
    query: |hier::Issuer.all()
        ->project(~[
            issuerId:x|$x.issuerId,
            flagged:x|$x.profile.flagged
        ]);
        mapping: hier::IssuerMapping;
        runtime: relmap::IssuerTwinRT;
    }
  testSuites:
  [
    RMR_IssuerFlags_suite:
    {
      data:
      [
        connections:
        [
          issuerEnv:
            Reference
            #{
              hier::IssuerData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"issuerId":"HI-0001","flagged":true},{"issuerId":"HI-0002","flagged":false},{"issuerId":"HI-0003","flagged":true},{"issuerId":"HI-0004","flagged":false},{"issuerId":"HI-0005","flagged":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::RM_IssuerFlags
{
    pattern: '/stress/relmap/issuerflags';
    documentation: 'A binding transformer in a relation mapping, `profile: Binding hier::ProfileBinding: PROFILE_JSON`: the Boolean leaf, which the engine reads back as it is (F27 turns the others into their JSON tokens).';
    execution: Single
    {
    query: |hier::Issuer.all()
        ->project(~[
            issuerId:x|$x.issuerId,
            flagged:x|$x.profile.flagged
