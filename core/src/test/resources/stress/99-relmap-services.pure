Service stress::RMR_DeskActivity
{
    pattern: '/stress/relmap/twin/deskactivity';
    documentation: 'Whether each book has deals: six of nine have none.';
    execution: Single
    {
    query: |relmap::RmDesk.all()
        ->project(~[
            bookId:x|$x.bookId,
            name:x|$x.name,
            hasDeals:x|$x.deals->isNotEmpty()
        ]);
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
    }
  testSuites:
  [
    RMR_DeskActivity_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 9 rows; 6 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"bookId":"BK-CASH-US","name":"US Cash Equity","hasDeals":true},{"bookId":"BK-CASH-EU","name":"EMEA Cash Equity","hasDeals":true},{"bookId":"BK-VOL-01","name":"Volatility Arb","hasDeals":true},{"bookId":"BK-LEGACY","name":"Legacy Wind-down","hasDeals":false},{"bookId":"BK-EQ","name":"Equity derivatives","hasDeals":false},{"bookId":"BK-FX","name":"FX trading","hasDeals":false},{"bookId":"BK-RATES","name":"Rates trading","hasDeals":false},{"bookId":"BK-CREDIT","name":"Credit trading","hasDeals":false},{"bookId":"BK-CREDIT-SP1","name":"Credit trading","hasDeals":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

