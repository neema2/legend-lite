Service stress::RM_InlineLarge
{
    pattern: '/stress/relmap/inlinelarge';
    documentation: 'A query filter through the inline embedded property.';
    execution: Single
    {
    query: |relmap::RmFill.all()
        ->filter({x|($x.terms.qty > 2000.0)})
        ->project(~[
            dealId:x|$x.dealId,
            qty:x|$x.terms.qty
        ]);
        mapping: relmap::Inlined;
        runtime: relmap::InlinedRT;
    }
  testSuites:
  [
    RM_InlineLarge_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 9 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0002","qty":2500.0},{"dealId":"TRD-0009","qty":3000.0},{"dealId":"TRD-0013","qty":25000.0},{"dealId":"TRD-0014","qty":10000.0},{"dealId":"TRD-0015","qty":5000.0},{"dealId":"TRD-0017","qty":2200.0},{"dealId":"TRD-0018","qty":5000000.0},{"dealId":"TRD-0019","qty":2000000.0},{"dealId":"TRD-0020","qty":1000000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::RMR_FillTop
{
    pattern: '/stress/relmap/twin/filltop';
    documentation: 'The four largest quantities.';
    execution: Single
    {
    query: |relmap::RmFill.all()
        ->project(~[
            dealId:x|$x.dealId,
            qty:x|$x.terms.qty
        ])
        ->sort([~qty->descending(), ~dealId->ascending()])
        ->limit(4);
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
    }
  testSuites:
  [
    RMR_FillTop_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0018","qty":5000000.0},{"dealId":"TRD-0019","qty":2000000.0},{"dealId":"TRD-0020","qty":1000000.0},{"dealId":"TRD-0013","qty":25000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

