Service stress::RMR_Ranked
{
    pattern: '/stress/relmap/twin/ranked';
    documentation: 'Each deal\'s rank by notional within its book, largest first: three of BK-CASH-US\'s deals tie at 250,000.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->project(~[
            dealId:x|$x.dealId,
            bookId:x|$x.bookId,
            notional:x|$x.notional
        ])
        ->extend(over(~[bookId], [~notional->descending()]), ~[rank:{p,w,r|$p->rank($w, $r)}]);
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
    }
  testSuites:
  [
    RMR_Ranked_suite:
