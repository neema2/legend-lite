Service stress::RM_JoinedDealDesk
{
    pattern: '/stress/relmap/joineddealdesk';
    documentation: 'A ModelJoin over the same local property.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->project(~[
            dealId:x|$x.dealId,
            deskName:x|$x.desk.name,
            deskCurrency:x|$x.desk.currency
        ]);
        mapping: relmap::Joined;
        runtime: relmap::JoinedRT;
    }
  testSuites:
  [
    RM_JoinedDealDesk_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0001","deskName":"US Cash Equity","deskCurrency":"USD"},{"dealId":"TRD-0002","deskName":"US Cash Equity","deskCurrency":"USD"},{"dealId":"TRD-0003","deskName":"US Cash Equity","deskCurrency":"USD"},{"dealId":"TRD-0004","deskName":"US Cash Equity","deskCurrency":"USD"},{"dealId":"TRD-0005","deskName":"Volatility Arb","deskCurrency":"USD"},{"dealId":"TRD-0006","deskName":"US Cash Equity","deskCurrency":"USD"},{"dealId":"TRD-0007","deskName":"US Cash Equity","deskCurrency":"USD"},{"dealId":"TRD-0008","deskName":"US Cash Equity","deskCurrency":"USD"},{"dealId":"TRD-0009","deskName":"US Cash Equity","deskCurrency":"USD"},{"dealId":"TRD-0010","deskName":"US Cash Equity","deskCurrency":"USD"},{"dealId":"TRD-0011","deskName":"US Cash Equity","deskCurrency":"USD"},{"dealId":"TRD-0012","deskName":"Volatility Arb","deskCurrency":"USD"},{"dealId":"TRD-0013","deskName":"EMEA Cash Equity","deskCurrency":"EUR"},{"dealId":"TRD-0014","deskName":"EMEA Cash Equity","deskCurrency":"EUR"},{"dealId":"TRD-0015","deskName":"EMEA Cash Equity","deskCurrency":"EUR"},{"dealId":"TRD-0016","deskName":"EMEA Cash Equity","deskCurrency":"EUR"},{"dealId":"TRD-0017","deskName":"EMEA Cash Equity","deskCurrency":"EUR"},{"dealId":"TRD-0018","deskName":"Volatility Arb","deskCurrency":"USD"},{"dealId":"TRD-0019","deskName":"Volatility Arb","deskCurrency":"USD"},{"dealId":"TRD-0020","deskName":"Volatility Arb","deskCurrency":"USD"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::RMR_EurDeals
{
    pattern: '/stress/relmap/twin/eurdeals';
    documentation: 'The deals booked in a EUR book.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->filter({x|($x.desk.currency == 'EUR')})
        ->project(~[
            dealId:x|$x.dealId,
            notional:x|$x.notional
        ]);
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
    }
  testSuites:
  [
    RMR_EurDeals_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0013","notional":171250.0},{"dealId":"TRD-0014","notional":69000.0},{"dealId":"TRD-0015","notional":35000.0},{"dealId":"TRD-0016","notional":264600.0},{"dealId":"TRD-0017","notional":385000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

