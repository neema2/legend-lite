        ->project(~[
            dealId:x|$x.dealId,
            bookId:x|$x.bookId,
            qty:x|$x.qty,
            px:x|$x.px,
            notional:x|$x.notional,
            status:x|$x.status,
            tradeType:x|$x.tradeType,
            currency:x|$x.currency,
            tradeDate:x|$x.tradeDate,
            fees:x|$x.fees
        ]);
        mapping: relmap::KeyedPair;
        runtime: relmap::KeyedPairRT;
    }
  testSuites:
  [
    RM_KeyedPairDeals_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0001","bookId":"BK-CASH-US","qty":1000.0,"px":190.5,"notional":190500.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-03","fees":12.1},{"dealId":"TRD-0002","bookId":"BK-CASH-US","qty":2500.0,"px":191.0,"notional":477500.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-03","fees":30.25},{"dealId":"TRD-0003","bookId":"BK-CASH-US","qty":500.0,"px":500.0,"notional":250000.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-03","fees":null},{"dealId":"TRD-0004","bookId":"BK-CASH-US","qty":1250.0,"px":200.0,"notional":250000.0,"status":"EXECUTED","tradeType":"PRINCIPAL","currency":"USD","tradeDate":"2024-06-03","fees":15.0},{"dealId":"TRD-0005","bookId":"BK-VOL-01","qty":2000.0,"px":125.0,"notional":250000.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-03","fees":11.5},{"dealId":"TRD-0006","bookId":"BK-CASH-US","qty":800.0,"px":312.5,"notional":250000.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-03","fees":9.0},{"dealId":"TRD-0007","bookId":"BK-CASH-US","qty":1500.0,"px":188.0,"notional":282000.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-03","fees":18.0},{"dealId":"TRD-0008","bookId":"BK-CASH-US","qty":100.0,"px":189.75,"notional":18975.0,"status":"CANCELLED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-04","fees":1.0},{"dealId":"TRD-0009","bookId":"BK-CASH-US","qty":3000.0,"px":192.25,"notional":576750.0,"status":"EXECUTE","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-04","fees":36.0},{"dealId":"TRD-0010","bookId":"BK-CASH-US","qty":1200.0,"px":415.0,"notional":498000.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-04","fees":31.5},{"dealId":"TRD-0011","bookId":"BK-CASH-US","qty":400.0,"px":418.25,"notional":167300.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-04","fees":5.25},{"dealId":"TRD-0012","bookId":"BK-VOL-01","qty":900.0,"px":410.0,"notional":369000.0,"status":"PENDING","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-05","fees":11.0},{"dealId":"TRD-0013","bookId":"BK-CASH-EU","qty":25000.0,"px":6.85,"notional":171250.0,"status":"EXECUTED","tradeType":"PRINCIPAL","currency":"USD","tradeDate":"2024-06-05","fees":22.0},{"dealId":"TRD-0014","bookId":"BK-CASH-EU","qty":10000.0,"px":6.9,"notional":69000.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-05","fees":8.75},{"dealId":"TRD-0015","bookId":"BK-CASH-EU","qty":5000.0,"px":7.0,"notional":35000.0,"status":"SETTLED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-06","fees":4.5},{"dealId":"TRD-0016","bookId":"BK-CASH-EU","qty":1500.0,"px":176.4,"notional":264600.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-06","fees":16.8},{"dealId":"TRD-0017","bookId":"BK-CASH-EU","qty":2200.0,"px":175.0,"notional":385000.0,"status":"EXECUTED","tradeType":"PRINCIPAL","currency":"USD","tradeDate":"2024-06-06","fees":24.5},{"dealId":"TRD-0018","bookId":"BK-VOL-01","qty":5000000.0,"px":0.9825,"notional":4912500.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-07","fees":250.0},{"dealId":"TRD-0019","bookId":"BK-VOL-01","qty":2000000.0,"px":0.98,"notional":1960000.0,"status":"EXECUTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-07","fees":98.0},{"dealId":"TRD-0020","bookId":"BK-VOL-01","qty":1000000.0,"px":0.975,"notional":975000.0,"status":"REJECTED","tradeType":"AGENCY","currency":"USD","tradeDate":"2024-06-07","fees":null}]';
