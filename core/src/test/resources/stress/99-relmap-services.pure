Service stress::RMR_DealsTop
{
    pattern: '/stress/relmap/twin/dealstop';
    documentation: 'The five largest notionals.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->project(~[
            dealId:x|$x.dealId,
            notional:x|$x.notional
        ])
        ->sort([~notional->descending(), ~dealId->ascending()])
        ->limit(5);
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
    }
  testSuites:
  [
    RMR_DealsTop_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0018","notional":4912500.0},{"dealId":"TRD-0019","notional":1960000.0},{"dealId":"TRD-0020","notional":975000.0},{"dealId":"TRD-0009","notional":576750.0},{"dealId":"TRD-0010","notional":498000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

