Service stress::RMR_Priced
{
    pattern: '/stress/relmap/twin/priced';
    documentation: 'The deal\'s notional doubled, its derived reference, its band and its status lower-cased, computed in the query.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->project(~[
            dealId:x|$x.dealId,
            doubled:x|($x.notional * 2.0),
            ref:x|$x.ref,
            band:x|if(($x.notional > 300000.0), |'large', |'small'),
            statusLower:x|$x.status->toLower()
        ]);
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
    }
  testSuites:
  [
    RMR_Priced_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0001","doubled":381000.0,"ref":"TRD-0001:EXECUTED","band":"small","statusLower":"executed"},{"dealId":"TRD-0002","doubled":955000.0,"ref":"TRD-0002:EXECUTED","band":"large","statusLower":"executed"},{"dealId":"TRD-0003","doubled":500000.0,"ref":"TRD-0003:EXECUTED","band":"small","statusLower":"executed"},{"dealId":"TRD-0004","doubled":500000.0,"ref":"TRD-0004:EXECUTED","band":"small","statusLower":"executed"},{"dealId":"TRD-0005","doubled":500000.0,"ref":"TRD-0005:EXECUTED","band":"small","statusLower":"executed"},{"dealId":"TRD-0006","doubled":500000.0,"ref":"TRD-0006:EXECUTED","band":"small","statusLower":"executed"},{"dealId":"TRD-0007","doubled":564000.0,"ref":"TRD-0007:EXECUTED","band":"small","statusLower":"executed"},{"dealId":"TRD-0008","doubled":37950.0,"ref":"TRD-0008:CANCELLED","band":"small","statusLower":"cancelled"},{"dealId":"TRD-0009","doubled":1153500.0,"ref":"TRD-0009:EXECUTE","band":"large","statusLower":"execute"},{"dealId":"TRD-0010","doubled":996000.0,"ref":"TRD-0010:EXECUTED","band":"large","statusLower":"executed"},{"dealId":"TRD-0011","doubled":334600.0,"ref":"TRD-0011:EXECUTED","band":"small","statusLower":"executed"},{"dealId":"TRD-0012","doubled":738000.0,"ref":"TRD-0012:PENDING","band":"large","statusLower":"pending"},{"dealId":"TRD-0013","doubled":342500.0,"ref":"TRD-0013:EXECUTED","band":"small","statusLower":"executed"},{"dealId":"TRD-0014","doubled":138000.0,"ref":"TRD-0014:EXECUTED","band":"small","statusLower":"executed"},{"dealId":"TRD-0015","doubled":70000.0,"ref":"TRD-0015:SETTLED","band":"small","statusLower":"settled"},{"dealId":"TRD-0016","doubled":529200.0,"ref":"TRD-0016:EXECUTED","band":"small","statusLower":"executed"},{"dealId":"TRD-0017","doubled":770000.0,"ref":"TRD-0017:EXECUTED","band":"large","statusLower":"executed"},{"dealId":"TRD-0018","doubled":9825000.0,"ref":"TRD-0018:EXECUTED","band":"large","statusLower":"executed"},{"dealId":"TRD-0019","doubled":3920000.0,"ref":"TRD-0019:EXECUTED","band":"large","statusLower":"executed"},{"dealId":"TRD-0020","doubled":1950000.0,"ref":"TRD-0020:REJECTED","band":"large","statusLower":"rejected"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

