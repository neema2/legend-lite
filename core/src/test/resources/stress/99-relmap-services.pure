Service stress::RMR_ExecutedByBook
{
    pattern: '/stress/relmap/twin/executedbybook';
    documentation: 'The executed deals counted and their notional summed per book.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->filter({x|($x.status == 'EXECUTED')})
        ->project(~[
            dealId:x|$x.dealId,
            bookId:x|$x.bookId,
            notional:x|$x.notional
        ])
        ->groupBy(~[bookId], ~[
            deals: x|$x.dealId : agg|$agg->count(),
            total: x|$x.notional : agg|$agg->sum()
        ]);
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
    }
  testSuites:
  [
    RMR_ExecutedByBook_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
