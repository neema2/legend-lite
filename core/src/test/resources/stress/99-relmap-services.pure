Service stress::RM_ExecutedByBook
{
    pattern: '/stress/relmap/executedbybook';
    documentation: 'The filtered source grouped in the query.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->project(~[
            dealId:x|$x.dealId,
            bookId:x|$x.bookId,
            notional:x|$x.notional
        ])
        ->groupBy(~[bookId], ~[
            deals: x|$x.dealId : agg|$agg->count(),
            total: x|$x.notional : agg|$agg->sum()
        ]);
        mapping: relmap::Executed;
        runtime: relmap::ExecutedRT;
    }
  testSuites:
  [
    RM_ExecutedByBook_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"bookId":"BK-CASH-US","deals":8,"total":2365300.0},{"bookId":"BK-VOL-01","deals":3,"total":7122500.0},{"bookId":"BK-CASH-EU","deals":4,"total":889850.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

