Service stress::RMR_DealDeskTop
{
    pattern: '/stress/relmap/twin/dealdesktop';
    documentation: 'The first five deals by book name, then id.';
    execution: Single
    {
    query: |relmap::RmDeal.all()
        ->project(~[
            dealId:x|$x.dealId,
            deskName:x|$x.desk.name
        ])
        ->sort([~deskName->ascending(), ~dealId->ascending()])
        ->limit(5);
        mapping: relmap::Twins;
        runtime: relmap::TwinsRT;
    }
  testSuites:
  [
    RMR_DealDeskTop_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0013","deskName":"EMEA Cash Equity"},{"dealId":"TRD-0014","deskName":"EMEA Cash Equity"},{"dealId":"TRD-0015","deskName":"EMEA Cash Equity"},{"dealId":"TRD-0016","deskName":"EMEA Cash Equity"},{"dealId":"TRD-0017","deskName":"EMEA Cash Equity"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

