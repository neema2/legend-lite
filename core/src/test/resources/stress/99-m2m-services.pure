Service stress::MXR_OpenTrade
{
    pattern: '/stress/m2m/twin/opentrade';
    documentation: 'The executed deals.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->filter({x|($x.status == 'EXECUTED')})
        ->project(~[
            dealId:x|$x.dealId,
            notional:x|$x.notional,
            status:x|$x.status
        ]);
        mapping: m2m::SourceMapping;
        runtime: m2m::SourceRT;
    }
