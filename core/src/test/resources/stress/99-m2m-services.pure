Service stress::MXR_DealSideBuys
{
    pattern: '/stress/m2m/twin/dealsidebuys';
    documentation: 'The buys, by the relational enumeration mapping.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->filter({x|($x.sideCode != 'ZZ') && ($x.side == trading::Side.BUY)})
        ->project(~[
