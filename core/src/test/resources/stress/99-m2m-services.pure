Service stress::MX_TradeRefTree
{
    pattern: '/stress/m2m/tradereftree';
    documentation: 'A derived source property fetched as a graph: the engine answers it absent for every row (F84).';
    execution: Single
    {
    query: |m2m::TradeRef.all()
        ->graphFetch(#{
  m2m::TradeRef
  {
    dealId,
    ref
  }
}#)
        ->serialize(#{
  m2m::TradeRef
  {
    dealId,
    ref
  }
}#);
        mapping: m2m::Views;
        runtime: m2m::ViewsRT;
    }
  testSuites:
  [
    MX_TradeRefTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"dealId":"TRD-0001","ref":"TRD-0001:USD"},{"dealId":"TRD-0002","ref":"TRD-0002:USD"},{"dealId":"TRD-0003","ref":"TRD-0003:USD"},{"dealId":"TRD-0004","ref":"TRD-0004:USD"},{"dealId":"TRD-0005","ref":"TRD-0005:USD"},{"dealId":"TRD-0006","ref":"TRD-0006:USD"},{"dealId":"TRD-0007","ref":"TRD-0007:USD"},{"dealId":"TRD-0008","ref":"TRD-0008:USD"},{"dealId":"TRD-0009","ref":"TRD-0009:USD"},{"dealId":"TRD-0010","ref":"TRD-0010:USD"},{"dealId":"TRD-0011","ref":"TRD-0011:USD"},{"dealId":"TRD-0012","ref":"TRD-0012:USD"},{"dealId":"TRD-0013","ref":"TRD-0013:USD"},{"dealId":"TRD-0014","ref":"TRD-0014:USD"},{"dealId":"TRD-0015","ref":"TRD-0015:USD"},{"dealId":"TRD-0016","ref":"TRD-0016:USD"},{"dealId":"TRD-0017","ref":"TRD-0017:USD"},{"dealId":"TRD-0018","ref":"TRD-0018:USD"},{"dealId":"TRD-0019","ref":"TRD-0019:USD"},{"dealId":"TRD-0020","ref":"TRD-0020:USD"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

