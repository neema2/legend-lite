":0.9825},{"dealId":"TRD-0019","partyName":"Meridian Asset Management","deskName":"Volatility Arb","qty":2000000.0,"px":0.98},{"dealId":"TRD-0020","partyName":"Halberd Securities","deskName":"Volatility Arb","qty":1000000.0,"px":0.975}]';
