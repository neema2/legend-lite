Service stress::M2_CanonicalWithEnum
{
    pattern: '/stress/m2';
    documentation: 'The M2M chain projecting the enum-mapped `side`. The relational mapping translates \'B\' to BUY; through a ModelChainConnection the raw code arrives instead. Isolated from M1 so one defect does not mask an unrelated invariance.';
    execution: Single
    {
    query: |canonical::CanonicalTrade.all()
        ->project(
            [
                x|$x.identifier,
                x|$x.side
            ],
            ['identifier', 'side']
        );
        mapping: canonical::M2MMapping;
        runtime: stress::CanonicalRT;
    }
