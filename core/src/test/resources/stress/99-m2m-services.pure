Service stress::MXR_TradeViewFiltered
{
    pattern: '/stress/m2m/twin/tradeviewfiltered';
    documentation: 'Deals whose gross exceeds 300,000.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->filter({x|($x.gross > 300000.0)})
        ->project(~[
            dealId:x|$x.dealId,
            gross:x|$x.gross,
            band:x|if(($x.notional > 1000000.0), |'large', |'small')
        ]);
        mapping: m2m::SourceMapping;
        runtime: m2m::SourceRT;
