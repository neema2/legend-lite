Service stress::MXR_UsdDeskCount
{
    pattern: '/stress/m2m/twin/usddeskcount';
    documentation: 'Deals counted per USD book.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->filter({x|($x.desk.currency == 'USD')})
        ->project(~[
            dealId:x|$x.dealId,
            deskName:x|$x.desk.name
        ])
        ->groupBy(~[deskName], ~[
            deals: x|$x.dealId : agg|$agg->count()
        ]);
        mapping: m2m::SourceMapping;
        runtime: m2m::SourceRT;
    }
  testSuites:
  [
    MXR_UsdDeskCount_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"deskName":"US Cash Equity","deals":10},{"deskName":"Volatility Arb","deals":5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

