          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0001","deskName":"US Cash Equity"},{"dealId":"TRD-0002","deskName":"US Cash Equity"},{"dealId":"TRD-0003","deskName":"US Cash Equity"},{"dealId":"TRD-0004","deskName":"US Cash Equity"}]';
