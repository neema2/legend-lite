Service stress::MX_TradeViewExecuted
{
    pattern: '/stress/m2m/tradeviewexecuted';
    documentation: 'A query filter on a function\'s transform of a value.';
    execution: Single
    {
    query: |m2m::TradeView.all()
        ->filter({x|($x.statusLower == 'executed')})
        ->project(
            [
                x|$x.dealId,
                x|$x.statusLower
            ],
            ['dealId', 'statusLower']
        );
        mapping: m2m::Views;
        runtime: m2m::ViewsRT;
    }
  testSuites:
  [
    MX_TradeViewExecuted_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 15 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0001","statusLower":"executed"},{"dealId":"TRD-0002","statusLower":"executed"},{"dealId":"TRD-0003","statusLower":"executed"},{"dealId":"TRD-0004","statusLower":"executed"},{"dealId":"TRD-0005","statusLower":"executed"},{"dealId":"TRD-0006","statusLower":"executed"},{"dealId":"TRD-0007","statusLower":"executed"},{"dealId":"TRD-0010","statusLower":"executed"},{"dealId":"TRD-0011","statusLower":"executed"},{"dealId":"TRD-0013","statusLower":"executed"},{"dealId":"TRD-0014","statusLower":"executed"},{"dealId":"TRD-0016","statusLower":"executed"},{"dealId":"TRD-0017","statusLower":"executed"},{"dealId":"TRD-0018","statusLower":"executed"},{"dealId":"TRD-0019","statusLower":"executed"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MXR_TradeRef
{
    pattern: '/stress/m2m/twin/traderef';
    documentation: 'The source\'s derived and qualified properties, evaluated in SQL.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->project(~[
            dealId:x|$x.dealId,
            gross:x|$x.gross,
            ref:x|$x.ref,
            large:x|$x.large,
            scaled:x|$x.scaled(2.0)
        ]);
        mapping: m2m::SourceMapping;
        runtime: m2m::SourceRT;
    }
  testSuites:
  [
    MXR_TradeRef_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0001","gross":190500.0,"ref":"TRD-0001:USD","large":false,"scaled":381000.0},{"dealId":"TRD-0002","gross":477500.0,"ref":"TRD-0002:USD","large":false,"scaled":955000.0},{"dealId":"TRD-0003","gross":250000.0,"ref":"TRD-0003:USD","large":false,"scaled":500000.0},{"dealId":"TRD-0004","gross":250000.0,"ref":"TRD-0004:USD","large":false,"scaled":500000.0},{"dealId":"TRD-0005","gross":250000.0,"ref":"TRD-0005:USD","large":false,"scaled":500000.0},{"dealId":"TRD-0006","gross":250000.0,"ref":"TRD-0006:USD","large":false,"scaled":500000.0},{"dealId":"TRD-0007","gross":282000.0,"ref":"TRD-0007:USD","large":false,"scaled":564000.0},{"dealId":"TRD-0008","gross":18975.0,"ref":"TRD-0008:USD","large":false,"scaled":37950.0},{"dealId":"TRD-0009","gross":576750.0,"ref":"TRD-0009:USD","large":false,"scaled":1153500.0},{"dealId":"TRD-0010","gross":498000.0,"ref":"TRD-0010:USD","large":false,"scaled":996000.0},{"dealId":"TRD-0011","gross":167300.0,"ref":"TRD-0011:USD","large":false,"scaled":334600.0},{"dealId":"TRD-0012","gross":369000.0,"ref":"TRD-0012:USD","large":false,"scaled":738000.0},{"dealId":"TRD-0013","gross":171250.0,"ref":"TRD-0013:USD","large":false,"scaled":342500.0},{"dealId":"TRD-0014","gross":69000.0,"ref":"TRD-0014:USD","large":false,"scaled":138000.0},{"dealId":"TRD-0015","gross":35000.0,"ref":"TRD-0015:USD","large":false,"scaled":70000.0},{"dealId":"TRD-0016","gross":264600.0,"ref":"TRD-0016:USD","large":false,"scaled":529200.0},{"dealId":"TRD-0017","gross":385000.0,"ref":"TRD-0017:USD","large":false,"scaled":770000.0},{"dealId":"TRD-0018","gross":4912500.0,"ref":"TRD-0018:USD","large":true,"scaled":9825000.0},{"dealId":"TRD-0019","gross":1960000.0,"ref":"TRD-0019:USD","large":true,"scaled":3920000.0},{"dealId":"TRD-0020","gross":975000.0,"ref":"TRD-0020:USD","large":false,"scaled":1950000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

