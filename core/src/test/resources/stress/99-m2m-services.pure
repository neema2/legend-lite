            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"identifier":"TRD-0001","side":"BUY"},{"identifier":"TRD-0002","side":"BUY"},{"identifier":"TRD-0003","side":"BUY"},{"identifier":"TRD-0004","side":"SELL"},{"identifier":"TRD-0005","side":"BUY"},{"identifier":"TRD-0006","side":"BUY"},{"identifier":"TRD-0007","side":"BUY"},{"identifier":"TRD-0008","side":"BUY"},{"identifier":"TRD-0009","side":"BUY"},{"identifier":"TRD-0010","side":"BUY"},{"identifier":"TRD-0011","side":"BUY"},{"identifier":"TRD-0012","side":null},{"identifier":"TRD-0013","side":"SELL"},{"identifier":"TRD-0014","side":"BUY"},{"identifier":"TRD-0015","side":"BUY"},{"identifier":"TRD-0016","side":"BUY"},{"identifier":"TRD-0017","side":"SELL"},{"identifier":"TRD-0018","side":"BUY"},{"identifier":"TRD-0019","side":"BUY"},{"identifier":"TRD-0020","side":"BUY"}]';
                  }#;
