        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0001","notional":190500.0,"status":"EXECUTED"},{"dealId":"TRD-0002","notional":477500.0,"status":"EXECUTED"},{"dealId":"TRD-0003","notional":250000.0,"status":"EXECUTED"},{"dealId":"TRD-0004","notional":250000.0,"status":"EXECUTED"},{"dealId":"TRD-0005","notional":250000.0,"status":"EXECUTED"},{"dealId":"TRD-0006","notional":250000.0,"status":"EXECUTED"},{"dealId":"TRD-0007","notional":282000.0,"status":"EXECUTED"},{"dealId":"TRD-0010","notional":498000.0,"status":"EXECUTED"},{"dealId":"TRD-0011","notional":167300.0,"status":"EXECUTED"},{"dealId":"TRD-0013","notional":171250.0,"status":"EXECUTED"},{"dealId":"TRD-0014","notional":69000.0,"status":"EXECUTED"},{"dealId":"TRD-0016","notional":264600.0,"status":"EXECUTED"},{"dealId":"TRD-0017","notional":385000.0,"status":"EXECUTED"},{"dealId":"TRD-0018","notional":4912500.0,"status":"EXECUTED"},{"dealId":"TRD-0019","notional":1960000.0,"status":"EXECUTED"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

