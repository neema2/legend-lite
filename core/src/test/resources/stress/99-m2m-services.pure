Service stress::MXR_TradeRefTop
{
    pattern: '/stress/m2m/twin/tradereftop';
    documentation: 'The three largest gross amounts and their derived references.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->project(~[
            dealId:x|$x.dealId,
            gross:x|$x.gross,
            ref:x|$x.ref
        ])
        ->sort([~gross->descending(), ~dealId->ascending()])
        ->limit(3);
        mapping: m2m::SourceMapping;
        runtime: m2m::SourceRT;
    }
  testSuites:
  [
    MXR_TradeRefTop_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0018","gross":4912500.0,"ref":"TRD-0018:USD"},{"dealId":"TRD-0019","gross":1960000.0,"ref":"TRD-0019:USD"},{"dealId":"TRD-0020","gross":975000.0,"ref":"TRD-0020:USD"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MX_TradeRefTop
{
    pattern: '/stress/m2m/tradereftop';
    documentation: 'The target ordered on a derived source property and cut.';
    execution: Single
    {
    query: |m2m::TradeRef.all()
        ->project(
            [
                x|$x.dealId,
                x|$x.gross,
                x|$x.ref
            ],
            ['dealId', 'gross', 'ref']
        )
        ->sort([desc('gross'), asc('dealId')])
        ->take(3);
        mapping: m2m::Views;
        runtime: m2m::ViewsRT;
    }
  testSuites:
  [
    MX_TradeRefTop_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0018","gross":4912500.0,"ref":"TRD-0018:USD"},{"dealId":"TRD-0019","gross":1960000.0,"ref":"TRD-0019:USD"},{"dealId":"TRD-0020","gross":975000.0,"ref":"TRD-0020:USD"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MXR_TradeRefGroups
{
    pattern: '/stress/m2m/twin/traderefgroups';
    documentation: 'Deals counted and their gross summed by the derived Boolean.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->project(~[
            dealId:x|$x.dealId,
            gross:x|$x.gross,
            large:x|$x.large
        ])
        ->groupBy(~[large], ~[
            deals: x|$x.dealId : agg|$agg->count(),
            total: x|$x.gross : agg|$agg->sum()
        ]);
        mapping: m2m::SourceMapping;
        runtime: m2m::SourceRT;
    }
  testSuites:
  [
    MXR_TradeRefGroups_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"large":false,"deals":18,"total":5479875.0},{"large":true,"deals":2,"total":6872500.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MX_TradeRefGroups
{
    pattern: '/stress/m2m/traderefgroups';
