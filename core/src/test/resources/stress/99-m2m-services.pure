// M2M: model-to-model mappings chained over relational sources through a ModelChainConnection -- the m2m::
// pack's transforms, derived source properties, enumeration transforms, nested sets, passthrough, target
// instantiation, ~filter, union and merge (8114-m2m.pure), and the canonical chain (55-canonical-chain.pure). Each
// M2M service (MX_, M1_, M2_) mirrors a relational twin (MXR_, M0_) that computes the same values from the source;
// the twin's expectation comes from the reference evaluator -- see scripts/corpus/m2m.py.
//
// GENERATED by scripts/corpus/build.py -- do not edit by hand.

###Service
Service stress::M1_TradeCanonical
{
    pattern: '/stress/m1';
    documentation: 'M2M invariance, canonical side: the same facts through relational -> source model -> M2M -> canonical model, with every property renamed on the way.';
    execution: Single
    {
    query: |canonical::CanonicalTrade.all()
        ->project(
            [
                x|$x.identifier,
                x|$x.executedOn,
                x|$x.unitPrice,
                x|$x.units,
                x|$x.state,
                x|$x.grossValue
            ],
            ['identifier', 'executedOn', 'unitPrice', 'units', 'state', 'grossValue']
        );
        mapping: canonical::M2MMapping;
        runtime: stress::CanonicalRT;
    }
  testSuites:
  [
    M1_TradeCanonical_suite:
