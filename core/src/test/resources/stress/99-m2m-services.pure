Service stress::MXR_UsdDeskTradeTop
{
    pattern: '/stress/m2m/twin/usddesktradetop';
    documentation: 'The first four deals in a USD book, by book name, then id.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->filter({x|($x.desk.currency == 'USD')})
        ->project(~[
            dealId:x|$x.dealId,
            deskName:x|$x.desk.name
        ])
        ->sort([~deskName->ascending(), ~dealId->ascending()])
        ->limit(4);
        mapping: m2m::SourceMapping;
        runtime: m2m::SourceRT;
