}

Service stress::MXR_TradeViewTop
{
    pattern: '/stress/m2m/twin/tradeviewtop';
    documentation: 'The five largest gross amounts.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->project(~[
            dealId:x|$x.dealId,
            gross:x|$x.gross
        ])
        ->sort([~gross->descending(), ~dealId->ascending()])
        ->limit(5);
        mapping: m2m::SourceMapping;
        runtime: m2m::SourceRT;
    }
