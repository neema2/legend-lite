Service stress::MXR_TradeView
{
    pattern: '/stress/m2m/twin/tradeview';
    documentation: 'The source\'s columns, derived and qualified properties, and functions applied in the query: what m2m::TradeView\'s inline transforms must compute.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->project(~[
            dealId:x|$x.dealId,
            day:x|$x.tradeDate,
            gross:x|$x.gross,
            ref:x|$x.ref,
            large:x|$x.large,
            scaled:x|$x.scaled(2.0),
            statusLower:x|$x.status->toLower(),
            venueUpper:x|$x.venue->map(v|$v->toUpper()),
            feesDoubled:x|$x.fees->map(v|($v * 2.0)),
            band:x|if(($x.notional > 1000000.0), |'large', |'small')
        ]);
        mapping: m2m::SourceMapping;
        runtime: m2m::SourceRT;
    }
