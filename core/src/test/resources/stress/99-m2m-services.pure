Service stress::MXR_TradeViewBands
{
    pattern: '/stress/m2m/twin/tradeviewbands';
    documentation: 'Deals counted and their gross summed per band.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->project(~[
            dealId:x|$x.dealId,
            gross:x|$x.gross,
            band:x|if(($x.notional > 1000000.0), |'large', |'small')
        ])
        ->groupBy(~[band], ~[
            deals: x|$x.dealId : agg|$agg->count(),
            total: x|$x.gross : agg|$agg->sum()
        ]);
        mapping: m2m::SourceMapping;
        runtime: m2m::SourceRT;
    }
  testSuites:
  [
    MXR_TradeViewBands_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"band":"small","deals":18,"total":5479875.0},{"band":"large","deals":2,"total":6872500.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

