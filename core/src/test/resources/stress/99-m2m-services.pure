Service stress::MXR_OpenTradeTop
{
    pattern: '/stress/m2m/twin/opentradetop';
    documentation: 'The three largest executed notionals.';
    execution: Single
    {
    query: |m2m::src::Deal.all()
        ->filter({x|($x.status == 'EXECUTED')})
        ->project(~[
            dealId:x|$x.dealId,
            notional:x|$x.notional
        ])
        ->sort([~notional->descending(), ~dealId->ascending()])
        ->limit(3);
        mapping: m2m::SourceMapping;
        runtime: m2m::SourceRT;
    }
  testSuites:
  [
    MXR_OpenTradeTop_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"TRD-0018","notional":4912500.0},{"dealId":"TRD-0019","notional":1960000.0},{"dealId":"TRD-0010","notional":498000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

