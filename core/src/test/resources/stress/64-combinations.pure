      HOP2_CODE VARCHAR(64)
   )
   Table COMBO_HOP2
   (
      HOP2_CODE VARCHAR(64) PRIMARY KEY,
      H2_S_NN1 VARCHAR(200) NOT NULL,
      H2_S_NN2 VARCHAR(200) NOT NULL,
      H2_S_NL1 VARCHAR(200),
      H2_S_NL2 VARCHAR(200),
      H2_C_NN1 CHAR(12) NOT NULL,
      H2_C_NN2 CHAR(12) NOT NULL,
      H2_C_NL1 CHAR(12),
      H2_C_NL2 CHAR(12),
      H2_I_NN1 INTEGER NOT NULL,
      H2_I_NN2 INTEGER NOT NULL,
      H2_I_NL1 INTEGER,
      H2_I_NL2 INTEGER,
      H2_BI_NN1 BIGINT NOT NULL,
      H2_BI_NN2 BIGINT NOT NULL,
      H2_BI_NL1 BIGINT,
      H2_BI_NL2 BIGINT,
      H2_SI_NN1 SMALLINT NOT NULL,
      H2_SI_NN2 SMALLINT NOT NULL,
      H2_SI_NL1 SMALLINT,
      H2_SI_NL2 SMALLINT,
      H2_F_NN1 DOUBLE NOT NULL,
      H2_F_NN2 DOUBLE NOT NULL,
      H2_F_NL1 DOUBLE,
      H2_F_NL2 DOUBLE,
      H2_DE_NN1 DECIMAL(18,4) NOT NULL,
      H2_DE_NN2 DECIMAL(18,4) NOT NULL,
      H2_DE_NL1 DECIMAL(18,4),
      H2_DE_NL2 DECIMAL(18,4),
      H2_B_NN1 BIT NOT NULL,
      H2_B_NN2 BIT NOT NULL,
      H2_B_NL1 BIT,
      H2_B_NL2 BIT,
      H2_DT_NN1 DATE NOT NULL,
      H2_DT_NN2 DATE NOT NULL,
      H2_DT_NL1 DATE,
      H2_DT_NL2 DATE,
      H2_TS_NN1 TIMESTAMP NOT NULL,
      H2_TS_NN2 TIMESTAMP NOT NULL,
      H2_TS_NL1 TIMESTAMP,
      H2_TS_NL2 TIMESTAMP,
      H2_CU_NN1 DOUBLE NOT NULL,
      H2_CU_NL1 DOUBLE
   )

   // Reached by the JOIN FORMS below rather than by a foreign key. Its rows are
   // derived from COMBO_ROOT's so each form pairs deterministically and to-one --
   // see combos.derive_alt. The four derivation columns exist only to be the far
   // side of one form each.
   Table COMBO_ALT
   (
      ALT_CODE VARCHAR(64) PRIMARY KEY,
      A_KEY VARCHAR(200),
      A_LOW INTEGER,
      A_CAT VARCHAR(400),
      A_UP VARCHAR(200),
      A_S_NN1 VARCHAR(200) NOT NULL,
      A_S_NN2 VARCHAR(200) NOT NULL,
      A_S_NL1 VARCHAR(200),
      A_S_NL2 VARCHAR(200),
      A_C_NN1 CHAR(12) NOT NULL,
      A_C_NN2 CHAR(12) NOT NULL,
      A_C_NL1 CHAR(12),
      A_C_NL2 CHAR(12),
      A_I_NN1 INTEGER NOT NULL,
      A_I_NN2 INTEGER NOT NULL,
      A_I_NL1 INTEGER,
      A_I_NL2 INTEGER,
      A_BI_NN1 BIGINT NOT NULL,
      A_BI_NN2 BIGINT NOT NULL,
      A_BI_NL1 BIGINT,
      A_BI_NL2 BIGINT,
      A_SI_NN1 SMALLINT NOT NULL,
      A_SI_NN2 SMALLINT NOT NULL,
      A_SI_NL1 SMALLINT,
      A_SI_NL2 SMALLINT,
      A_F_NN1 DOUBLE NOT NULL,
      A_F_NN2 DOUBLE NOT NULL,
      A_F_NL1 DOUBLE,
      A_F_NL2 DOUBLE,
      A_DE_NN1 DECIMAL(18,4) NOT NULL,
      A_DE_NN2 DECIMAL(18,4) NOT NULL,
      A_DE_NL1 DECIMAL(18,4),
      A_DE_NL2 DECIMAL(18,4),
      A_B_NN1 BIT NOT NULL,
      A_B_NN2 BIT NOT NULL,
      A_B_NL1 BIT,
      A_B_NL2 BIT,
      A_DT_NN1 DATE NOT NULL,
      A_DT_NN2 DATE NOT NULL,
      A_DT_NL1 DATE,
      A_DT_NL2 DATE,
      A_TS_NN1 TIMESTAMP NOT NULL,
      A_TS_NN2 TIMESTAMP NOT NULL,
      A_TS_NL1 TIMESTAMP,
      A_TS_NL2 TIMESTAMP
   )

   // A SCHEMA. Every other table in this corpus sits in the default schema, so a
   // schema-qualified reference had never been resolved by anything -- not by a
   // mapping, which writes `[db]schema.TABLE.COL`, and not by a ###Data element,
   // which keys its rows `schema.TABLE`. Both were probed against the engine
   // first; a Schema that only ever appears in a Database block is a declaration,
   // not a tested feature.
   Schema analytics
   (
      Table COMBO_SUMMARY
      (
         SUMMARY_ID VARCHAR(64) PRIMARY KEY,
         // A real FOREIGN KEY, so the schema-qualified table can be REACHED.
         // Without one it is an island: nothing navigates to it, and `Schema`
         // appears only in the single service rooted at it. The first attempt
         // joined on the numeric suffix of the two ids instead --
         // right(ROOT_ID,4) = right(SUMMARY_ID,4) -- which is correct, needs no
         // schema change, and cannot use an index: a dynafunction on both sides
         // of a join is a cross-product, and it took the suite from thirteen
         // minutes to over fifty. A column is cheaper than cleverness.
         ROOT_ID VARCHAR(64),
         SM_S_NN1 VARCHAR(200) NOT NULL,
         SM_S_NN2 VARCHAR(200) NOT NULL,
         SM_S_NL1 VARCHAR(200),
         SM_S_NL2 VARCHAR(200),
         SM_C_NN1 CHAR(12) NOT NULL,
         SM_C_NN2 CHAR(12) NOT NULL,
         SM_C_NL1 CHAR(12),
         SM_C_NL2 CHAR(12),
         SM_I_NN1 INTEGER NOT NULL,
         SM_I_NN2 INTEGER NOT NULL,
         SM_I_NL1 INTEGER,
         SM_I_NL2 INTEGER,
         SM_BI_NN1 BIGINT NOT NULL,
         SM_BI_NN2 BIGINT NOT NULL,
         SM_BI_NL1 BIGINT,
         SM_BI_NL2 BIGINT,
         SM_SI_NN1 SMALLINT NOT NULL,
         SM_SI_NN2 SMALLINT NOT NULL,
         SM_SI_NL1 SMALLINT,
         SM_SI_NL2 SMALLINT,
         SM_F_NN1 DOUBLE NOT NULL,
         SM_F_NN2 DOUBLE NOT NULL,
         SM_F_NL1 DOUBLE,
         SM_F_NL2 DOUBLE,
         SM_DE_NN1 DECIMAL(18,4) NOT NULL,
         SM_DE_NN2 DECIMAL(18,4) NOT NULL,
         SM_DE_NL1 DECIMAL(18,4),
         SM_DE_NL2 DECIMAL(18,4),
         SM_B_NN1 BIT NOT NULL,
         SM_B_NN2 BIT NOT NULL,
         SM_B_NL1 BIT,
         SM_B_NL2 BIT,
         SM_DT_NN1 DATE NOT NULL,
         SM_DT_NN2 DATE NOT NULL,
         SM_DT_NL1 DATE,
         SM_DT_NL2 DATE,
         SM_TS_NN1 TIMESTAMP NOT NULL,
         SM_TS_NN2 TIMESTAMP NOT NULL,
         SM_TS_NL1 TIMESTAMP,
         SM_TS_NL2 TIMESTAMP
      )
   )

   Join Combo_Summary(COMBO_ROOT.ROOT_ID = analytics.COMBO_SUMMARY.ROOT_ID)
   Join Combo_Hop1(COMBO_ROOT.HOP1_CODE = COMBO_HOP1.HOP1_CODE)
   Join Combo_Hop2(COMBO_HOP1.HOP2_CODE = COMBO_HOP2.HOP2_CODE)

   // MULTI-COLUMN: two equalities joined by `and`.
   Join Combo_Multi(COMBO_ROOT.HOP1_CODE = COMBO_ALT.ALT_CODE and COMBO_ROOT.R_S_NN1 = COMBO_ALT.A_KEY)
   // NON-EQUALITY. A_LOW is seeded so exactly one ALT row sits below every root
   // value and the rest sit above, which keeps the navigation to-one; the root
   // column is NULLABLE, so the row where it is NULL matches nothing and the
   // no-match case is exercised too.
   Join Combo_Ineq(COMBO_ROOT.R_I_NL1 > COMBO_ALT.A_LOW)
   // `or`, with BOTH branches reachable: the equality matches for a root row whose
   // key resolves, and the null branch matches the sentinel row for the root whose
   // key is absent. Parenthesised because and/or are equal-precedence and
   // right-associative, so `A and B or C` would parse as `A and (B or C)`.
   Join Combo_Or((COMBO_ROOT.HOP1_CODE = COMBO_ALT.ALT_CODE) or (COMBO_ROOT.HOP1_CODE is null and COMBO_ALT.ALT_CODE = 'ALT-SENTINEL'))
   // DYNAFUNCTION on one side, and on both.
   Join Combo_Dyna1(concat(COMBO_ROOT.R_S_NN1, COMBO_ROOT.R_S_NN2) = COMBO_ALT.A_CAT)
   Join Combo_Dyna2(toUpper(COMBO_ROOT.R_S_NN1) = toUpper(COMBO_ALT.A_UP))

   // The DIRECT filter. It tests the foreign key rather than one of the columns
   // the matrix cells read, for two reasons: the seeder GUARANTEES an absent key
   // (property A2) so the filter provably excludes a row, and filtering on a cell's
   // own source column would remove the very NULL that the `nullable` cells on this
   // class exist to meet -- making that pair vacuous while looking covered.
   //
   // The first version tested `R_MEMO is not null` and excluded NOTHING, because the
   // seeder nulls only the FIRST nullable column of a table. A filter matching every
   // row is indistinguishable from no filter at all.
   Filter ComboLinked(COMBO_ROOT.HOP1_CODE is not null)
   // The chain filter's predicate, on the far end of two joins. It names a NOT
   // NULL column deliberately: what this cell tests is that the FILTER FOLLOWS THE
   // CHAIN, so the rows it must exclude are the ones whose chain breaks -- an
   // absent key, a dangling key -- not the ones failing a predicate. Pointing it
   // at a nullable column instead excluded every row, which the vacuity guard
   // caught: a filter matching nothing asserts as little as one matching
   // everything.
   Filter ComboNamedHop2(COMBO_HOP2.H2_S_NN1 is not null)
   // A MultiGrainFilter. A mapping references it exactly as it references a Filter
   // -- the distinction is consumed by the planner, for join elision -- so nothing
   // about the reference tells you which kind it is. It is in the matrix because a
   // construct that can only be DECLARED is a construct nobody has run: the
   // generated dense store declared one and referenced it nowhere.
   MultiGrainFilter ComboGrain(COMBO_ROOT.R_S_NL1 is not null)
)

