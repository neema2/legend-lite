// Carries an embedded property with an `Otherwise` fallback. Its inline columns
// are NOT NULL for every row, so the inline branch always applies and the
// fallback is never reached -- which is the half F13 does not break.
Class combo::WithOtherwise
{
   rootId: String[1];
   inline: combo::OtherwiseTarget[0..1];
}

Class combo::OtherwiseTarget
{
   code: String[1];
   label: String[0..1];
}

