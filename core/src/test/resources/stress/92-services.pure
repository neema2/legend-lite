Service stress::Q3_SettlementTradeInstrCptyCountry
{
    pattern: '/stress/q3';
    documentation: 'Settlement -> Trade -> Instrument + Counterparty -> Country (52 props, 4-hop)';
    execution: Single
    {
    query: |settlement::Settlement.all()
        ->project(~[
            settlementId:x|$x.settlementId,
            settlementDate:x|$x.settlementDate,
            amount:x|$x.amount,
            currency:x|$x.currency,
            status:x|$x.status,
            settledDate:x|$x.settledDate,
            settlementMethod:x|$x.settlementMethod,
            custodian:x|$x.custodian,
            depository:x|$x.depository,
            settledAmount:x|$x.settledAmount,
            failReason:x|$x.failReason,
            isPartial:x|$x.isPartial,
            priority:x|$x.priority,
            lastUpdated:x|$x.lastUpdated,
            trdId:x|$x.trade.tradeId,
            trdDate:x|$x.trade.tradeDate,
            trdQty:x|$x.trade.quantity,
            trdPrice:x|$x.trade.price,
            trdNotional:x|$x.trade.notional,
            trdSide:x|$x.trade.side,
            trdStatus:x|$x.trade.status,
            trdType:x|$x.trade.tradeType,
            trdCcy:x|$x.trade.currency,
            trdComm:x|$x.trade.commission,
            trdFees:x|$x.trade.fees,
            trdVenue:x|$x.trade.executionVenue,
            trdIsBlock:x|$x.trade.isBlock,
            trdCreated:x|$x.trade.createdTime,
            instrId:x|$x.trade.instrument.instrumentId,
            instrName:x|$x.trade.instrument.name,
            instrTicker:x|$x.trade.instrument.ticker,
            instrAsset:x|$x.trade.instrument.assetClass,
            instrCcy:x|$x.trade.instrument.currency,
            instrIsin:x|$x.trade.instrument.isin,
            instrActive:x|$x.trade.instrument.isActive,
            instrType:x|$x.trade.instrument.productType,
            cptyId:x|$x.counterparty.counterpartyId,
            cptyName:x|$x.counterparty.legalName,
            cptyLei:x|$x.counterparty.lei,
            cptyType:x|$x.counterparty.counterpartyType,
            cptyDomicile:x|$x.counterparty.domicile,
            cptyCreditRating:x|$x.counterparty.creditRating,
            cptyTier:x|$x.counterparty.tier,
            cptyCountry:x|$x.counterparty.country.countryCode,
            cptyCountryName:x|$x.counterparty.country.name,
            cptyCountryRegion:x|$x.counterparty.country.region
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
