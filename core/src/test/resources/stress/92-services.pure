Service stress::Q4_ConfirmTradeInstrSector
{
    pattern: '/stress/q4';
    documentation: 'Confirmation -> Trade -> Instrument -> Sector (40 props, 4-hop: ops->trading->products->refdata)';
    execution: Single
    {
    query: |ops::Confirmation.all()
        ->project(~[
            confirmId:x|$x.confirmId,
            status:x|$x.status,
            confirmMethod:x|$x.confirmMethod,
            isElectronic:x|$x.isElectronic,
            version:x|$x.version,
            sentDate:x|$x.sentDate,
            affirmedDate:x|$x.affirmedDate,
            daysOutstanding:x|$x.daysOutstanding,
            isOverdue:x|$x.isOverdue,
            counterpartyRef:x|$x.counterpartyRef,
            trdId:x|$x.trade.tradeId,
            trdDate:x|$x.trade.tradeDate,
            trdQty:x|$x.trade.quantity,
            trdPrice:x|$x.trade.price,
            trdSide:x|$x.trade.side,
            trdStatus:x|$x.trade.status,
            trdCcy:x|$x.trade.currency,
            trdComm:x|$x.trade.commission,
            trdVenue:x|$x.trade.executionVenue,
            trdIsBlock:x|$x.trade.isBlock,
            instrId:x|$x.trade.instrument.instrumentId,
            instrName:x|$x.trade.instrument.name,
            instrTicker:x|$x.trade.instrument.ticker,
            instrAsset:x|$x.trade.instrument.assetClass,
            instrCcy:x|$x.trade.instrument.currency,
            instrIsin:x|$x.trade.instrument.isin,
            instrType:x|$x.trade.instrument.productType,
            instrActive:x|$x.trade.instrument.isActive,
            instrNotional:x|$x.trade.instrument.notionalAmount,
            instrMaturity:x|$x.trade.instrument.maturityDate,
            secName:x|$x.trade.instrument.sector.name,
            secGics:x|$x.trade.instrument.sector.gicsCode,
            secLevel:x|$x.trade.instrument.sector.level,
            secActive:x|$x.trade.instrument.sector.isActive,
            cptyId:x|$x.trade.counterparty.counterpartyId,
            cptyName:x|$x.trade.counterparty.legalName,
            cptyLei:x|$x.trade.counterparty.lei,
            cptyType:x|$x.trade.counterparty.counterpartyType,
            cptyDomicile:x|$x.trade.counterparty.domicile,
            cptyCreditRating:x|$x.trade.counterparty.creditRating
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    Q4_ConfirmTradeInstrSector_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 15 rows x 40 columns, 49 NULL cells from orphan/absent foreign keys
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
