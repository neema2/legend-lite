Service stress::Q5_SalesCreditTradeBookDesk
{
    pattern: '/stress/q5';
    documentation: 'SalesCredit -> Trade -> Book -> Desk (42 props, 4-hop: sales->trading->positions->org)';
    execution: Single
    {
    query: |sales::SalesCredit.all()
        ->project(~[
            creditId:x|$x.creditId,
            creditAmount:x|$x.creditAmount,
            creditDate:x|$x.creditDate,
            creditType:x|$x.creditType,
            currency:x|$x.currency,
            splitPct:x|$x.splitPct,
            status:x|$x.status,
            isOverride:x|$x.isOverride,
            overrideBy:x|$x.overrideBy,
            originalAmount:x|$x.originalAmount,
            region:x|$x.region,
            productArea:x|$x.productArea,
            trdId:x|$x.trade.tradeId,
            trdDate:x|$x.trade.tradeDate,
            trdQty:x|$x.trade.quantity,
            trdPrice:x|$x.trade.price,
            trdNotional:x|$x.trade.notional,
            trdCcy:x|$x.trade.currency,
            trdSide:x|$x.trade.side,
            trdStatus:x|$x.trade.status,
            bkId:x|$x.trade.book.bookId,
            bkName:x|$x.trade.book.name,
            bkCcy:x|$x.trade.book.currency,
            bkType:x|$x.trade.book.bookType,
            bkStrategy:x|$x.trade.book.strategy,
            bkLegalEntity:x|$x.trade.book.legalEntity,
            bkActive:x|$x.trade.book.isActive,
            deskId:x|$x.trade.book.desk.deskId,
            deskName:x|$x.trade.book.desk.name,
            deskType:x|$x.trade.book.desk.deskType,
            deskAsset:x|$x.trade.book.desk.assetClass,
            deskRegion:x|$x.trade.book.desk.region,
            deskActive:x|$x.trade.book.desk.isActive,
            instrId:x|$x.trade.instrument.instrumentId,
            instrName:x|$x.trade.instrument.name,
            instrTicker:x|$x.trade.instrument.ticker,
            instrAsset:x|$x.trade.instrument.assetClass,
            instrCcy:x|$x.trade.instrument.currency,
            instrType:x|$x.trade.instrument.productType,
            cptyId:x|$x.trade.counterparty.counterpartyId,
            cptyName:x|$x.trade.counterparty.legalName,
            cptyLei:x|$x.trade.counterparty.lei
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    Q5_SalesCreditTradeBookDesk_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 12 rows x 42 columns, 24 NULL cells from orphan/absent foreign keys
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
