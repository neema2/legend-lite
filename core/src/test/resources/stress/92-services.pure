// Stress test queries as portable Service definitions, each carrying a testSuite whose
// expectation was computed by the reference evaluator in scripts/corpus/oracle.py from
// the seed data in 93-testdata.pure -- NOT captured from engine output.
//
// GENERATED by scripts/corpus/build.py -- do not edit by hand. Edit the seed or the
// queries and regenerate, so the expectation can never drift from the data.

###Service
Service stress::Q0_TradeInstrSectorCptyTraderBook
{
    pattern: '/stress/q0';
    documentation: 'Trade -> Instrument -> Sector + Counterparty + Trader + Book (48 props, 3-hop)';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeDate:x|$x.tradeDate,
            settlementDate:x|$x.settlementDate,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            side:x|$x.side,
            status:x|$x.status,
            tradeType:x|$x.tradeType,
            currency:x|$x.currency,
            commission:x|$x.commission,
            fees:x|$x.fees,
            executionVenue:x|$x.executionVenue,
            isBlock:x|$x.isBlock,
            createdTime:x|$x.createdTime,
            lastModifiedTime:x|$x.lastModifiedTime,
            instrName:x|$x.instrument.name,
            instrTicker:x|$x.instrument.ticker,
            instrAssetClass:x|$x.instrument.assetClass,
            instrCurrency:x|$x.instrument.currency,
            instrIsin:x|$x.instrument.isin,
            instrCusip:x|$x.instrument.cusip,
            instrSedol:x|$x.instrument.sedol,
            instrProductType:x|$x.instrument.productType,
            instrIsActive:x|$x.instrument.isActive,
            instrNotional:x|$x.instrument.notionalAmount,
            instrListingDate:x|$x.instrument.listingDate,
            instrMaturityDate:x|$x.instrument.maturityDate,
            instrDescription:x|$x.instrument.description,
            instrIssueDate:x|$x.instrument.issueDate,
            sectorName:x|$x.instrument.sector.name,
            sectorGics:x|$x.instrument.sector.gicsCode,
            sectorLevel:x|$x.instrument.sector.level,
            sectorIsActive:x|$x.instrument.sector.isActive,
            cptyId:x|$x.counterparty.counterpartyId,
            cptyName:x|$x.counterparty.legalName,
            cptyLei:x|$x.counterparty.lei,
            cptyType:x|$x.counterparty.counterpartyType,
            cptyDomicile:x|$x.counterparty.domicile,
            cptyTier:x|$x.counterparty.tier,
            cptyIsActive:x|$x.counterparty.isActive,
            cptyCreditRating:x|$x.counterparty.creditRating,
            traderFirst:x|$x.trader.firstName,
            traderLast:x|$x.trader.lastName,
            traderId:x|$x.trader.traderId,
            traderSeniority:x|$x.trader.seniority,
            bookId:x|$x.book.bookId,
            bookName:x|$x.book.name,
            bookCurrency:x|$x.book.currency,
            bookType:x|$x.book.bookType
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
