Service stress::Q2_PnLBookDeskTrader
{
    pattern: '/stress/q2';
    documentation: 'DailyPnL -> Book -> Desk + Trader (45 props, 3-hop: pnl->positions->org)';
    execution: Single
    {
    query: |pnl::DailyPnL.all()
        ->project(~[
            pnlId:x|$x.pnlId,
            pnlDate:x|$x.pnlDate,
            totalPnL:x|$x.totalPnL,
            realizedPnL:x|$x.realizedPnL,
            unrealizedPnL:x|$x.unrealizedPnL,
            newTradePnL:x|$x.newTradePnL,
            carryPnL:x|$x.carryPnL,
            fxPnL:x|$x.fxPnL,
            commissions:x|$x.commissions,
            fees:x|$x.fees,
            currency:x|$x.currency,
            isOfficial:x|$x.isOfficial,
            publishedTime:x|$x.publishedTime,
            version:x|$x.version,
            bkId:x|$x.book.bookId,
            bkName:x|$x.book.name,
            bkCurrency:x|$x.book.currency,
            bkType:x|$x.book.bookType,
            bkStrategy:x|$x.book.strategy,
            bkIsActive:x|$x.book.isActive,
            bkOpenDate:x|$x.book.openDate,
