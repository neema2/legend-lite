Service stress::Q1_TradeBookDeskInstrTrader
{
    pattern: '/stress/q1';
    documentation: 'Trade -> Book -> Desk + Instrument + Trader (50 props, 3-hop)';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeDate:x|$x.tradeDate,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            side:x|$x.side,
            status:x|$x.status,
            tradeType:x|$x.tradeType,
            currency:x|$x.currency,
            commission:x|$x.commission,
            fees:x|$x.fees,
            executionVenue:x|$x.executionVenue,
            isBlock:x|$x.isBlock,
            createdTime:x|$x.createdTime,
            bkId:x|$x.book.bookId,
            bkName:x|$x.book.name,
            bkCurrency:x|$x.book.currency,
            bkType:x|$x.book.bookType,
            bkStrategy:x|$x.book.strategy,
            bkIsActive:x|$x.book.isActive,
            bkOpenDate:x|$x.book.openDate,
            bkLegalEntity:x|$x.book.legalEntity,
            bkPnlYTD:x|$x.book.pnlYTD,
            bkDescription:x|$x.book.description,
            deskId:x|$x.book.desk.deskId,
            deskName:x|$x.book.desk.name,
            deskType:x|$x.book.desk.deskType,
            deskAssetClass:x|$x.book.desk.assetClass,
            deskRegion:x|$x.book.desk.region,
            deskIsActive:x|$x.book.desk.isActive,
            deskHeadTrader:x|$x.book.desk.headTrader,
            deskCostCenter:x|$x.book.desk.costCenter,
            deskFloor:x|$x.book.desk.floor,
            deskBuilding:x|$x.book.desk.building,
            deskPhone:x|$x.book.desk.phone,
            deskRiskLimit:x|$x.book.desk.riskLimit,
            deskPnlTarget:x|$x.book.desk.pnlTarget,
            instrId:x|$x.instrument.instrumentId,
            instrName:x|$x.instrument.name,
            instrTicker:x|$x.instrument.ticker,
            instrAsset:x|$x.instrument.assetClass,
            instrCcy:x|$x.instrument.currency,
            instrIsin:x|$x.instrument.isin,
            instrActive:x|$x.instrument.isActive,
            instrNotional:x|$x.instrument.notionalAmount,
            instrMaturity:x|$x.instrument.maturityDate,
            instrType:x|$x.instrument.productType,
            traderId:x|$x.trader.traderId,
            traderFirst:x|$x.trader.firstName,
            traderLast:x|$x.trader.lastName,
            traderSeniority:x|$x.trader.seniority,
            traderSpecialization:x|$x.trader.specialization,
            traderIsActive:x|$x.trader.isActive,
            traderEmail:x|$x.trader.email,
            traderBadge:x|$x.trader.badge
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    Q1_TradeBookDeskInstrTrader_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows x 55 columns, 68 NULL cells from orphan/absent foreign keys
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
