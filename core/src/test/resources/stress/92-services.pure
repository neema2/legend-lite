Service stress::Q7_TradeReportTradeInstrBookCpty
{
    pattern: '/stress/q7';
    documentation: 'TradeReport -> Trade -> Instrument + Book + Counterparty (46 props, 4-hop)';
    execution: Single
    {
    query: |regulatory::TradeReport.all()
        ->project(~[
            reportId:x|$x.reportId,
            reportType:x|$x.reportType,
            status:x|$x.status,
            submissionDate:x|$x.submissionDate,
            reportingEntity:x|$x.reportingEntity,
            regime:x|$x.regime,
            uti:x|$x.uti,
            usi:x|$x.usi,
