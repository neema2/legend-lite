Service stress::Q11_TradeMonster9Joins
{
    pattern: '/stress/q11';
    documentation: 'THE MONSTER - 9 disjoint JOINs from Trade across 6 domains, 60 props';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeDate:x|$x.tradeDate,
