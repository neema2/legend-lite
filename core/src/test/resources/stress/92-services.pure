Service stress::Q9_PositionInstrSectorCurrency
{
    pattern: '/stress/q9';
    documentation: 'Position -> Instrument -> Sector + Currency (40 props, 3-hop)';
    execution: Single
    {
    query: |positions::Position.all()
        ->project(~[
            positionId:x|$x.positionId,
            quantity:x|$x.quantity,
            averageCost:x|$x.averageCost,
            marketValue:x|$x.marketValue,
            unrealizedPnL:x|$x.unrealizedPnL,
            realizedPnL:x|$x.realizedPnL,
            currency:x|$x.currency,
            positionDate:x|$x.positionDate,
            direction:x|$x.direction,
            costBasis:x|$x.costBasis,
            accruedInterest:x|$x.accruedInterest,
            lastUpdated:x|$x.lastUpdated,
            isOpen:x|$x.isOpen,
            settlementDate:x|$x.settlementDate,
            instrId:x|$x.instrument.instrumentId,
            instrName:x|$x.instrument.name,
            instrTicker:x|$x.instrument.ticker,
            instrAsset:x|$x.instrument.assetClass,
            instrCcy:x|$x.instrument.currency,
            instrIsin:x|$x.instrument.isin,
            instrType:x|$x.instrument.productType,
            instrActive:x|$x.instrument.isActive,
            instrNotional:x|$x.instrument.notionalAmount,
            instrMaturity:x|$x.instrument.maturityDate,
