            retryCount:x|$x.retryCount,
            isLateReport:x|$x.isLateReport,
            dueDate:x|$x.dueDate,
            trdId:x|$x.trade.tradeId,
            trdDate:x|$x.trade.tradeDate,
            trdQty:x|$x.trade.quantity,
            trdPrice:x|$x.trade.price,
            trdNotional:x|$x.trade.notional,
            trdSide:x|$x.trade.side,
            trdStatus:x|$x.trade.status,
            trdCcy:x|$x.trade.currency,
            trdComm:x|$x.trade.commission,
            trdVenue:x|$x.trade.executionVenue,
            trdIsBlock:x|$x.trade.isBlock,
            instrId:x|$x.trade.instrument.instrumentId,
            instrName:x|$x.trade.instrument.name,
            instrTicker:x|$x.trade.instrument.ticker,
            instrAsset:x|$x.trade.instrument.assetClass,
            instrCcy:x|$x.trade.instrument.currency,
            instrIsin:x|$x.trade.instrument.isin,
            instrType:x|$x.trade.instrument.productType,
            instrActive:x|$x.trade.instrument.isActive,
            bkId:x|$x.trade.book.bookId,
            bkName:x|$x.trade.book.name,
            bkCcy:x|$x.trade.book.currency,
            bkType:x|$x.trade.book.bookType,
            bkStrategy:x|$x.trade.book.strategy,
            cptyId:x|$x.trade.counterparty.counterpartyId,
            cptyName:x|$x.trade.counterparty.legalName,
            cptyLei:x|$x.trade.counterparty.lei,
            cptyType:x|$x.trade.counterparty.counterpartyType,
