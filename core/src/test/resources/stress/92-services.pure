Service stress::Q8_CollateralCptyCountry
{
    pattern: '/stress/q8';
    documentation: 'CollateralAgreement -> Counterparty -> Country (40 props, 3-hop)';
    execution: Single
    {
    query: |collateral::CollateralAgreement.all()
        ->project(~[
            agreementId:x|$x.agreementId,
            agreementType:x|$x.agreementType,
            threshold:x|$x.threshold,
            minimumTransferAmount:x|$x.minimumTransferAmount,
            currency:x|$x.currency,
            effectiveDate:x|$x.effectiveDate,
            terminationDate:x|$x.terminationDate,
            independentAmount:x|$x.independentAmount,
            roundingAmount:x|$x.roundingAmount,
            valuationFrequency:x|$x.valuationFrequency,
            disputeResolutionDays:x|$x.disputeResolutionDays,
            isActive:x|$x.isActive,
            eligibleCollateral:x|$x.eligibleCollateral,
            governingLaw:x|$x.governingLaw,
            cptyId:x|$x.counterparty.counterpartyId,
            cptyName:x|$x.counterparty.legalName,
            cptyLei:x|$x.counterparty.lei,
            cptyType:x|$x.counterparty.counterpartyType,
            cptyDomicile:x|$x.counterparty.domicile,
            cptyCreditRating:x|$x.counterparty.creditRating,
            cptyRatingAgency:x|$x.counterparty.ratingAgency,
            cptyTier:x|$x.counterparty.tier,
            cptyIndustry:x|$x.counterparty.industry,
            cptyIsActive:x|$x.counterparty.isActive,
            cptyOnboard:x|$x.counterparty.onboardDate,
            countryCode:x|$x.counterparty.country.countryCode,
            countryName:x|$x.counterparty.country.name,
            countryRegion:x|$x.counterparty.country.region,
            countryIso3:x|$x.counterparty.country.iso3Code,
            countrySubRegion:x|$x.counterparty.country.subRegion,
            countryContinent:x|$x.counterparty.country.continent,
            countryCapital:x|$x.counterparty.country.capitalCity,
            countryTimezone:x|$x.counterparty.country.timeZone,
            countryGdp:x|$x.counterparty.country.gdp,
            countryPopulation:x|$x.counterparty.country.population,
            countryIsEU:x|$x.counterparty.country.isEU,
            countryIsOECD:x|$x.counterparty.country.isOECD
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    Q8_CollateralCptyCountry_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows x 37 columns, 31 NULL cells from orphan/absent foreign keys
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"agreementId":"CSA-0001","agreementType":"CSA","threshold":1000000.0,"minimumTransferAmount":250000.0,"currency":"USD","effectiveDate":"2015-03-01","terminationDate":null,"independentAmount":0.0,"roundingAmount":10000.0,"valuationFrequency":"DAILY","disputeResolutionDays":2,"isActive":true,"eligibleCollateral":"CASH;UST","governingLaw":"NY","cptyId":"CP-0001","cptyName":"Meridian Asset Management","cptyLei":"5493001KJTIIGC8Y1R12","cptyType":"ASSET_MANAGER","cptyDomicile":"US","cptyCreditRating":"AA-","cptyRatingAgency":"S&P","cptyTier":"1","cptyIndustry":"Investment Management","cptyIsActive":true,"cptyOnboard":"2015-02-09","countryCode":"US","countryName":"United States","countryRegion":"Americas","countryIso3":"USA","countrySubRegion":"Northern America","countryContinent":"North America","countryCapital":"Washington","countryTimezone":"America/New_York","countryGdp":25462700.0,"countryPopulation":331000000,"countryIsEU":false,"countryIsOECD":true},{"agreementId":"CSA-0002","agreementType":"CSA","threshold":0.0,"minimumTransferAmount":100000.0,"currency":"GBP","effectiveDate":"2013-09-15","terminationDate":null,"independentAmount":5000000.0,"roundingAmount":25000.0,"valuationFrequency":"DAILY","disputeResolutionDays":1,"isActive":true,"eligibleCollateral":"CASH;GILT","governingLaw":"ENGLISH","cptyId":"CP-0002","cptyName":"Halberd Securities","cptyLei":"213800WAVVOPS85N2205","cptyType":"BROKER_DEALER","cptyDomicile":"GB","cptyCreditRating":"A+","cptyRatingAgency":"Moody\'s","cptyTier":"1","cptyIndustry":"Broker Dealer","cptyIsActive":true,"cptyOnboard":"2013-08-22","countryCode":"GB","countryName":"United Kingdom","countryRegion":"EMEA","countryIso3":"GBR","countrySubRegion":"Northern Europe","countryContinent":"Europe","countryCapital":"London","countryTimezone":"Europe/London","countryGdp":3070600.0,"countryPopulation":67000000,"countryIsEU":false,"countryIsOECD":true},{"agreementId":"CSA-0003","agreementType":"GMRA","threshold":null,"minimumTransferAmount":null,"currency":"EUR","effectiveDate":"2019-06-03","terminationDate":"2024-12-31","independentAmount":null,"roundingAmount":null,"valuationFrequency":"WEEKLY","disputeResolutionDays":5,"isActive":false,"eligibleCollateral":null,"governingLaw":"GERMAN","cptyId":"CP-0003","cptyName":"O\'Neill Capital Partners","cptyLei":"529900T8BM49AURSDO55","cptyType":"HEDGE_FUND","cptyDomicile":"DE","cptyCreditRating":"BBB","cptyRatingAgency":"Fitch","cptyTier":"2","cptyIndustry":"Hedge Fund","cptyIsActive":true,"cptyOnboard":"2019-05-30","countryCode":"DE","countryName":"Germany","countryRegion":"EMEA","countryIso3":"DEU","countrySubRegion":"Western Europe","countryContinent":"Europe","countryCapital":"Berlin","countryTimezone":"Europe/Berlin","countryGdp":4072200.0,"countryPopulation":83000000,"countryIsEU":true,"countryIsOECD":true},{"agreementId":"CSA-0004","agreementType":"ISDA","threshold":500000.0,"minimumTransferAmount":50000.0,"currency":"JPY","effectiveDate":"2020-01-10","terminationDate":null,"independentAmount":0.0,"roundingAmount":1000000.0,"valuationFrequency":"MONTHLY","disputeResolutionDays":10,"isActive":true,"eligibleCollateral":"CASH;JGB","governingLaw":"JAPANESE","cptyId":null,"cptyName":null,"cptyLei":null,"cptyType":null,"cptyDomicile":null,"cptyCreditRating":null,"cptyRatingAgency":null,"cptyTier":null,"cptyIndustry":null,"cptyIsActive":null,"cptyOnboard":null,"countryCode":null,"countryName":null,"countryRegion":null,"countryIso3":null,"countrySubRegion":null,"countryContinent":null,"countryCapital":null,"countryTimezone":null,"countryGdp":null,"countryPopulation":null,"countryIsEU":null,"countryIsOECD":null}]';
                  }#;
