Service stress::Q6_GreeksPositionInstr
{
    pattern: '/stress/q6';
    documentation: 'Greeks -> Position -> Instrument + Instrument (44 props, 3-hop: risk->positions->products)';
    execution: Single
    {
    query: |risk::Greeks.all()
        ->project(~[
            greeksId:x|$x.greeksId,
            calcDate:x|$x.calcDate,
            delta:x|$x.delta,
            gamma:x|$x.gamma,
            vega:x|$x.vega,
            theta:x|$x.theta,
            rho:x|$x.rho,
            charm:x|$x.charm,
            vanna:x|$x.vanna,
            volga:x|$x.volga,
            currency:x|$x.currency,
            model:x|$x.model,
            isEOD:x|$x.isEOD,
            underlyingPrice:x|$x.underlyingPrice,
            posId:x|$x.position.positionId,
            posQty:x|$x.position.quantity,
            posMarketVal:x|$x.position.marketValue,
            posCcy:x|$x.position.currency,
            posCostBasis:x|$x.position.costBasis,
            posAvgCost:x|$x.position.averageCost,
            posDirection:x|$x.position.direction,
            posIsOpen:x|$x.position.isOpen,
            posDate:x|$x.position.positionDate,
            posLastUpdated:x|$x.position.lastUpdated,
            instrId:x|$x.position.instrument.instrumentId,
            instrName:x|$x.position.instrument.name,
            instrTicker:x|$x.position.instrument.ticker,
            instrAsset:x|$x.position.instrument.assetClass,
            instrCcy:x|$x.position.instrument.currency,
            instrIsin:x|$x.position.instrument.isin,
            instrType:x|$x.position.instrument.productType,
            instrActive:x|$x.position.instrument.isActive,
            instrNotional:x|$x.position.instrument.notionalAmount,
            secName:x|$x.position.instrument.sector.name,
            secGics:x|$x.position.instrument.sector.gicsCode,
            secLevel:x|$x.position.instrument.sector.level,
            gInstrId:x|$x.instrument.instrumentId,
            gInstrName:x|$x.instrument.name,
            gInstrTicker:x|$x.instrument.ticker,
            gInstrAsset:x|$x.instrument.assetClass
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    Q6_GreeksPositionInstr_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows x 40 columns, 40 NULL cells from orphan/absent foreign keys
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"greeksId":"GRK-0001","calcDate":"2024-06-07","delta":0.62,"gamma":0.014,"vega":112.5,"theta":-8.25,"rho":4.1,"charm":-0.002,"vanna":0.008,"volga":0.11,"currency":"USD","model":"BLACK_SCHOLES","isEOD":true,"underlyingPrice":190.42,"posId":"POS-0001","posQty":9150.0,"posMarketVal":1742343.0,"posCcy":"USD","posCostBasis":1742343.0,"posAvgCost":190.42,"posDirection":"LONG","posIsOpen":true,"posDate":"2024-06-07","posLastUpdated":"2024-06-07T18:00:00.000000000+0000","instrId":"INST-AAPL","instrName":"Apple Inc","instrTicker":"AAPL","instrAsset":"EQUITY","instrCcy":"USD","instrIsin":"US0378331005","instrType":"COMMON_STOCK","instrActive":true,"instrNotional":null,"secName":"Information Technology","secGics":"45","secLevel":1,"gInstrId":"INST-AAPL","gInstrName":"Apple Inc","gInstrTicker":"AAPL","gInstrAsset":"EQUITY"},{"greeksId":"GRK-0002","calcDate":"2024-06-07","delta":0.48,"gamma":0.009,"vega":88.0,"theta":-5.4,"rho":2.75,"charm":-0.001,"vanna":0.005,"volga":0.07,"currency":"USD","model":"BLACK_SCHOLES","isEOD":true,"underlyingPrice":415.81,"posId":"POS-0002","posQty":1600.0,"posMarketVal":665296.0,"posCcy":"USD","posCostBasis":665296.0,"posAvgCost":415.81,"posDirection":"LONG","posIsOpen":true,"posDate":"2024-06-07","posLastUpdated":"2024-06-07T18:01:00.000000000+0000","instrId":"INST-MSFT","instrName":"Microsoft Corp","instrTicker":"MSFT","instrAsset":"EQUITY","instrCcy":"USD","instrIsin":"US5949181045","instrType":"COMMON_STOCK","instrActive":true,"instrNotional":null,"secName":"Information Technology","secGics":"45","secLevel":1,"gInstrId":"INST-MSFT","gInstrName":"Microsoft Corp","gInstrTicker":"MSFT","gInstrAsset":"EQUITY"},{"greeksId":"GRK-0003","calcDate":"2024-06-07","delta":null,"gamma":null,"vega":null,"theta":null,"rho":null,"charm":null,"vanna":null,"volga":null,"currency":"GBP","model":"NOT_RUN","isEOD":false,"underlyingPrice":null,"posId":"POS-0005","posQty":7000000.0,"posMarketVal":6872600.0,"posCcy":"GBP","posCostBasis":68