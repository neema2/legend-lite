Service stress::CB_AssocSetIds
{
    pattern: '/stress/cb_assoc_setids';
    documentation: 'Navigates combo::RootHop from combo::C0, whose AssociationMapping names an explicit SOURCE and TARGET set id on each end. The ids are load-bearing: COMBO_ROOT carries eight set implementations, so an unqualified end would be ambiguous. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C0.all()
        ->project(~[
            rootId:x|$x.rootId,
            hopCode:x|$x.hop.hopCode,
            hopLeaf:x|$x.hop.h1_s_nn1
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_AssocSetIds_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 2 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0001","hopCode":null,"hopLeaf":null},{"rootId":"CR-0002","hopCode":null,"hopLeaf":null},{"rootId":"CR-0003","hopCode":"CH-0001","hopLeaf":"H1-S-NN1-001"},{"rootId":"CR-0004","hopCode":"CH-0002","hopLeaf":"H1-S-NN1-002"},{"rootId":"CR-0005","hopCode":"CH-0003","hopLeaf":"H1-S-NN1-003"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CB_Otherwise
{
    pattern: '/stress/cb_otherwise';
    documentation: 'Reads the embedded property on combo::WithOtherwise, mapped with an `Otherwise` fallback that never applies because the inline columns are NOT NULL. The fallback half is pinned by O1_CounterpartyOtherwise under F13. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::WithOtherwise.all()
        ->project(~[
            rootId:x|$x.rootId,
            code:x|$x.inline.code,
            label:x|$x.inline.label
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_Otherwise_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 2 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0001","code":"AA","label":"OTW-LABEL-001"},{"rootId":"CR-0002","code":"BB","label":"OTW-LABEL-002"},{"rootId":"CR-0003","code":"CC","label":"OTW-LABEL-003"},{"rootId":"CR-0004","code":"DD","label":"OTW-LABEL-004"},{"rootId":"CR-0005","code":"EE","label":"OTW-LABEL-005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
