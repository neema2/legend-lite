          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":null,"sm_b_nl1":false,"sm_b_nn1":false,"sm_bi_nl1":52,"sm_bi_nn1":52,"sm_c_nl1":"SM-C-NL1-001","sm_c_nn1":"SM-C-NN1-001","sm_de_nl1":325.0,"sm_de_nn1":325.0,"sm_dt_nl1":"2024-07-07","sm_dt_nn1":"2024-07-07","sm_f_nl1":325.0,"sm_f_nn1":325.0,"sm_i_nl1":52,"sm_i_nn1":52,"sm_s_nl1":"SM-S-NL1-001","sm_s_nn1":"SM-S-NN1-001","sm_si_nl1":null,"sm_si_nn1":52,"sm_ts_nl1":null,"sm_ts_nn1":"2024-07-07T06:15:00.000000000+0000","summaryId":"CS-0001"},{"rootId":"CR-0001-GONE","sm_b_nl1":null,"sm_b_nn1":true,"sm_bi_nl1":59,"sm_bi_nn1":59,"sm_c_nl1":"SM-C-NL1-002","sm_c_nn1":"SM-C-NN1-002","sm_de_nl1":362.5,"sm_de_nn1":362.5,"sm_dt_nl1":"2024-08-08","sm_dt_nn1":"2024-08-08","sm_f_nl1":362.5,"sm_f_nn1":362.5,"sm_i_nl1":null,"sm_i_nn1":59,"sm_s_nl1":"SM-S-NL1-002","sm_s_nn1":"SM-S-NN1-002","sm_si_nl1":59,"sm_si_nn1":59,"sm_ts_nl1":"2024-08-08T07:15:00.000000000+0000","sm_ts_nn1":"2024-08-08T07:15:00.000000000+0000","summaryId":"CS-0002"},{"rootId":"CR-0001","sm_b_nl1":true,"sm_b_nn1":true,"sm_bi_nl1":66,"sm_bi_nn1":66,"sm_c_nl1":"SM-C-NL1-003","sm_c_nn1":"SM-C-NN1-003","sm_de_nl1":400.0,"sm_de_nn1":400.0,"sm_dt_nl1":"2024-09-09","sm_dt_nn1":"2024-09-09","sm_f_nl1":null,"sm_f_nn1":400.0,"sm_i_nl1":66,"sm_i_nn1":66,"sm_s_nl1":null,"sm_s_nn1":"SM-S-NN1-003","sm_si_nl1":66,"sm_si_nn1":66,"sm_ts_nl1":"2024-09-09T08:15:00.000000000+0000","sm_ts_nn1":"2024-09-09T08:15:00.000000000+0000","summaryId":"CS-0003"},{"rootId":"CR-0002","sm_b_nl1":false,"sm_b_nn1":false,"sm_bi_nl1":null,"sm_bi_nn1":73,"sm_c_nl1":"SM-C-NL1-004","sm_c_nn1":"SM-C-NN1-004","sm_de_nl1":437.5,"sm_de_nn1":437.5,"sm_dt_nl1":null,"sm_dt_nn1":"2024-10-10","sm_f_nl1":437.5,"sm_f_nn1":437.5,"sm_i_nl1":73,"sm_i_nn1":73,"sm_s_nl1":"SM-S-NL1-004","sm_s_nn1":"SM-S-NN1-004","sm_si_nl1":73,"sm_si_nn1":73,"sm_ts_nl1":"2024-10-10T09:15:00.000000000+0000","sm_ts_nn1":"2024-10-10T09:15:00.000000000+0000","summaryId":"CS-0004"},{"rootId":"CR-0003","sm_b_nl1":true,"sm_b_nn1":true,"sm_bi_nl1":80,"sm_bi