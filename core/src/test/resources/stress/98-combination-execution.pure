###Service
Service stress::CB_C0
{
    pattern: '/stress/cb_c0';
    documentation: 'Combination matrix cell: class filter=none, extends=no. Projects every property cell dealt to this class -- each a distinct (reach, transform, nullability, host) combination. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C0.all()
        ->project(~[
            rootId:x|$x.rootId,
            col_string_none_notnull_embedded:x|$x.nested.col_string_none_notnull_embedded,
            col_string_none_notnull_top:x|$x.col_string_none_notnull_top,
            chain1_string_none_notnull_top:x|$x.chain1_string_none_notnull_top,
            chain2_string_none_notnull_top:x|$x.chain2_string_none_notnull_top,
            col_bigint_none_notnull_top:x|$x.col_bigint_none_notnull_top,
            col_bool_none_notnull_top:x|$x.col_bool_none_notnull_top,
            col_char_none_notnull_top:x|$x.col_char_none_notnull_top,
            col_date_none_notnull_top:x|$x.col_date_none_notnull_top,
            col_decimal_none_notnull_top:x|$x.col_decimal_none_notnull_top,
