Service stress::CB_NotEqualsNull
{
    pattern: '/stress/cb_notequalsnull';
    documentation: 'Comparison `!=` against a column that is NULL in some rows. The row whose operand is NULL is KEPT: Pure compares an absent value as false, so `!=`, its negation, is true. SQL three-valued logic would drop it. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C1.all()
        ->filter({x|($x.multicol_string_none_nullable_top != ' none')})
        ->project(~[
            rootId:x|$x.rootId,
            multicol_string_none_nullable_top:x|$x.multicol_string_none_nullable_top
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_NotEqualsNull_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 1 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0001","multicol_string_none_nullable_top":null},{"rootId":"CR-0002","multicol_string_none_nullable_top":null},{"rootId":"CR-0003","multicol_string_none_nullable_top":"A-S-NL1-003"},{"rootId":"CR-0004","multicol_string_none_nullable_top":"A-S-NL1-004"},{"rootId":"CR-0005","multicol_string_none_nullable_top":"A-S-NL1-005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CB_EqualsNull
{
    pattern: '/stress/cb_equalsnull';
    documentation: 'Comparison `==` against a column that is NULL in some rows. The complement: an absent value is not equal, so the NULL row is dropped, as SQL would drop it too. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C1.all()
        ->filter({x|($x.multicol_string_none_nullable_top == ' none')})
        ->project(~[
            rootId:x|$x.rootId,
            multicol_string_none_nullable_top:x|$x.multicol_string_none_nullable_top
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_EqualsNull_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 1 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CB_GreaterNull
{
    pattern: '/stress/cb_greaternull';
    documentation: 'Comparison `>` against a column that is NULL in some rows. An ORDERED comparison against the same NULL: never satisfied by an absent value, so dropped -- while `!=` keeps it. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C1.all()
        ->filter({x|($x.multicol_string_none_nullable_top > ' ')})
        ->project(~[
            rootId:x|$x.rootId,
            multicol_string_none_nullable_top:x|$x.multicol_string_none_nullable_top
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_GreaterNull_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 1 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0003","multicol_string_none_nullable_top":"A-S-NL1-003"},{"rootId":"CR-0004","multicol_string_none_nullable_top":"A-S-NL1-004"},{"rootId":"CR-0005","multicol_string_none_nullable_top":"A-S-NL1-005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CB_SchemaQualified
{
    pattern: '/stress/cb_schema';
    documentation: 'Reads combo::Summary, whose every reference is schema-qualified. The corpus declared a Schema and mapped over none, so a schema-qualified reference had never been resolved by a mapping and a schema-qualified ###Data key had never seeded anything. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::Summary.all()
        ->project(~[
            rootId:x|$x.rootId,
            sm_b_nl1:x|$x.sm_b_nl1,
            sm_b_nn1:x|$x.sm_b_nn1,
            sm_bi_nl1:x|$x.sm_bi_nl1,
            sm_bi_nn1:x|$x.sm_bi_nn1,
            sm_c_nl1:x|$x.sm_c_nl1,
            sm_c_nn1:x|$x.sm_c_nn1,
            sm_de_nl1:x|$x.sm_de_nl1,
            sm_de_nn1:x|$x.sm_de_nn1,
            sm_dt_nl1:x|$x.sm_dt_nl1,
            sm_dt_nn1:x|$x.sm_dt_nn1,
            sm_f_nl1:x|$x.sm_f_nl1,
            sm_f_nn1:x|$x.sm_f_nn1,
            sm_i_nl1:x|$x.sm_i_nl1,
            sm_i_nn1:x|$x.sm_i_nn1,
            sm_s_nl1:x|$x.sm_s_nl1,
            sm_s_nn1:x|$x.sm_s_nn1,
            sm_si_nl1:x|$x.sm_si_nl1,
            sm_si_nn1:x|$x.sm_si_nn1,
            sm_ts_nl1:x|$x.sm_ts_nl1,
            sm_ts_nn1:x|$x.sm_ts_nn1,
            summaryId:x|$x.summaryId
        ])
        ->sort(~summaryId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_SchemaQualified_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
