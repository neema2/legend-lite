Service stress::CB_SchemaReach
{
    pattern: '/stress/cb_schema_reach';
    documentation: 'Navigates combo::RootSummary from combo::C0 to the schema-qualified analytics.COMBO_SUMMARY. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C0.all()
        ->project(~[
            rootId:x|$x.rootId,
            summaryId:x|$x.summary.summaryId,
            summaryLeaf:x|$x.summary.sm_s_nn1
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_SchemaReach_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 2 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0001","summaryId":"CS-0003","summaryLeaf":"SM-S-NN1-003"},{"rootId":"CR-0002","summaryId":"CS-0004","summaryLeaf":"SM-S-NN1-004"},{"rootId":"CR-0003","summaryId":"CS-0005","summaryLeaf":"SM-S-NN1-005"},{"rootId":"CR-0004","summaryId":null,"summaryLeaf":null},{"rootId":"CR-0005","summaryId":null,"summaryLeaf":null}]';
                  }#;
