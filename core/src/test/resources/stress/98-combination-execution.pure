          ]
        }
      ]
    }
  ]
}

Service stress::CB_Scoped
{
    pattern: '/stress/cb_scoped';
    documentation: 'Reads combo::Scoped, whose property mappings sit inside `scope([db]TABLE)` and name their columns BARE. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::Scoped.all()
        ->project(~[
            r_b_nl1:x|$x.r_b_nl1,
            r_b_nn1:x|$x.r_b_nn1,
            r_bi_nl1:x|$x.r_bi_nl1,
            r_bi_nn1:x|$x.r_bi_nn1,
            r_c_nl1:x|$x.r_c_nl1,
            r_c_nn1:x|$x.r_c_nn1,
            r_de_nl1:x|$x.r_de_nl1,
            r_de_nn1:x|$x.r_de_nn1,
            r_dt_nl1:x|$x.r_dt_nl1,
            r_dt_nn1:x|$x.r_dt_nn1,
            r_f_nl1:x|$x.r_f_nl1,
            r_f_nn1:x|$x.r_f_nn1,
            r_i_nl1:x|$x.r_i_nl1,
            r_i_nn1:x|$x.r_i_nn1,
            r_s_nl1:x|$x.r_s_nl1,
            r_s_nn1:x|$x.r_s_nn1,
            r_si_nl1:x|$x.r_si_nl1,
            r_si_nn1:x|$x.r_si_nn1,
            r_ts_nl1:x|$x.r_ts_nl1,
            r_ts_nn1:x|$x.r_ts_nn1,
            rootId:x|$x.rootId
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_Scoped_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 20 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"r_b_nl1":false,"r_b_nn1":false,"r_bi_nl1":31,"r_bi_nn1":31,"r_c_nl1":"R-C-NL1-001","r_c_nn1":"R-C-NN1-001","r_de_nl1":212.5,"r_de_nn1":212.5,"r_dt_nl1":"2024-04-04","r_dt_nn1":"2024-04-04","r_f_nl1":212.5,"r_f_nn1":212.5,"r_i_nl1":31,"r_i_nn1":31,"r_s_nl1":"R-S-NL1-001","r_s_nn1":"R-S-NN1-001","r_si_nl1":null,"r_si_nn1":31,"r_ts_nl1":null,"r_ts_nn1":"2024-04-04T03:15:00.000000000+0000","rootId":"CR-0001"},{"r_b_nl1":null,"r_b_nn1":true,"r_bi_nl1":38,"r_bi_nn1":38,"r_c_nl1":"R-C-NL1-002","r_c_nn1":"R-C-NN1-002","r_de_nl1":250.0,"r_de_nn1":250.0,"r_dt_nl1":"2024-05-05","r_dt_nn1":"2024-05-05","r_f_nl1":250.0,"r_f_nn1":250.0,"r_i_nl1":null,"r_i_nn1":38,"r_s_nl1":"R-S-NL1-002","r_s_nn1":"R-S-NN1-002","r_si_nl1":38,"r_si_nn1":38,"r_ts_nl1":"2024-05-05T04:15:00.000000000+0000","r_ts_nn1":"2024-05-05T04:15:00.000000000+0000","rootId":"CR-0002"},{"r_b_nl1":true,"r_b_nn1":true,"r_bi_nl1":45,"r_bi_nn1":45,"r_c_nl1":"R-C-NL1-003","r_c_nn1":"R-C-NN1-003","r_de_nl1":287.5,"r_de_nn1":287.5,"r_dt_nl1":"2024-06-06","r_dt_nn1":"2024-06-06","r_f_nl1":null,"r_f_nn1":287.5,"r_i_nl1":45,"r_i_nn1":45,"r_s_nl1":null,"r_s_nn1":"R-S-NN1-003","r_si_nl1":45,"r_si_nn1":45,"r_ts_nl1":"2024-06-06T05:15:00.000000000+0000","r_ts_nn1":"2024-06-06T05:15:00.000000000+0000","rootId":"CR-0003"},{"r_b_nl1":false,"r_b_nn1":false,"r_bi_nl1":null,"r_bi_nn1":52,"r_c_nl1":"R-C-NL1-004","r_c_nn1":"R-C-NN1-004","r_de_nl1":325.0,"r_de_nn1":325.0,"r_dt_nl1":null,"r_dt_nn1":"2024-07-07","r_f_nl1":325.0,"r_f_nn1":325.0,"r_i_nl1":52,"r_i_nn1":52,"r_s_nl1":"R-S-NL1-004","r_s_nn1":"R-S-NN1-004","r_si_nl1":52,"r_si_nn1":52,"r_ts_nl1":"2024-07-07T06:15:00.000000000+0000","r_ts_nn1":"2024-07-07T06:15:00.000000000+0000","rootId":"CR-0004"},{"r_b_nl1":true,"r_b_nn1":true,"r_bi_nl1":59,"r_bi_nn1":59,"r_c_nl1":null,"r_c_nn1":"R-C-NN1-005","r_de_nl1":null,"r_de_nn1":362.5,"r_dt_nl1":"2024-08-08","r_dt_nn1":"2024-08-08","r_f_nl1":362.5,"r_f_nn1":362.5,"r_i_nl1":59,"r_i_nn1":59,"r_s_nl1":"R-S-NL1-005","r_s_nn1":"R-S-NN1-005","r_si_nl1":59,"r_si_nn1":59,"r_ts_nl1":"2024-08-08T07:15:00.000000000+0000","r_ts_nn1":"2024-08-08T07:15:00.000000000+0000","rootId":"CR-0005"}]';
