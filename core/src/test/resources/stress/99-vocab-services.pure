Service stress::VR_JoinInner
{
    pattern: '/stress/vocab/vr_joininner';
    documentation: 'Each trade with the typed value naming it, inner, over a Relation.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            id:x|$x.tradeId,
            n:x|$x.notional
        ])
        ->join(typedvalues::TypedValue.all() ->filter({x|$x.valuedTrade.tradeId->isNotEmpty()}) ->project(~[ vid:x|$x.valueId, vq:x|$x.quantity, tid:x|$x.valuedTrade.tradeId ]), JoinKind.INNER, {a, b|$a.id == $b.tid})
        ->sort([~id->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
