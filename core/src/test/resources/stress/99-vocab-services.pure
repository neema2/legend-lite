Service stress::VC_ExistsTrade
{
    pattern: '/stress/vocab/vc_existstrade';
    documentation: 'The books with a trade over 400,000: `exists` over a to-many.';
    execution: Single
    {
    query: |positions::Book.all()
        ->filter({x|$x.trades->exists(c|($c.notional > 400000.0))})
        ->project(~[
            bookId:x|$x.bookId
        ])
        ->sort(~bookId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    VC_ExistsTrade_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"bookId":"BK-CASH-US"},{"bookId":"BK-VOL-01"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::VC_NotExistsTrade
{
    pattern: '/stress/vocab/vc_notexiststrade';
    documentation: 'The books with no trade over 400,000, or none.';
