Service stress::VGN_AverageAmount
{
    pattern: '/stress/vocab/vgn_averageamount';
    documentation: '`average()` over the optional `amountOpt`, grouped by `active`, whose groups each hold absent and present values. Compared with 1000000.0, as its value is inexact.';
    execution: Single
    {
    query: |typedvalues::TypedValue.all()
        ->project(~[
            k:x|$x.active,
            v:x|$x.amountOpt
        ])
        ->groupBy(~[k], ~[
            r: x|$x.v : agg|$agg->average()->greaterThan(1000000.0)
        ])
        ->sort(~k->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    VGN_AverageAmount_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"k":false,"r":false},{"k":true,"r":true}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

