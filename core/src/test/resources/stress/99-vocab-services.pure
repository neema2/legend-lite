    documentation: 'Two of three columns kept, over a TDS.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(
            [
                x|$x.tradeId,
                x|$x.tradeDate,
                x|$x.notional
            ],
            ['id', 'd', 'n']
        )
        ->restrict(['id', 'n'])
        ->sort([asc('id')]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    VT_Select_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":"TRD-0001","n":190500.0},{"id":"TRD-0002","n":477500.0},{"id":"TRD-0003","n":250000.0},{"id":"TRD-0004","n":250000.0},{"id":"TRD-0005","n":250000.0},{"id":"TRD-0006","n":250000.0},{"id":"TRD-0007","n":282000.0},{"id":"TRD-0008","n":18975.0},{"id":"TRD-0009","n":576750.0},{"id":"TRD-0010","n":498000.0},{"id":"TRD-0011","n":167300.0},{"id":"TRD-0012","n":369000.0},{"id":"TRD-0013","n":171250.0},{"id":"TRD-0014","n":69000.0},{"id":"TRD-0015","n":35000.0},{"id":"TRD-0016","n":264600.0},{"id":"TRD-0017","n":385000.0},{"id":"TRD-0018","n":4912500.0},{"id":"TRD-0019","n":1960000.0},{"id":"TRD-0020","n":975000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

