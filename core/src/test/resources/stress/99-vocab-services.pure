Service stress::VG_CountName
{
    pattern: '/stress/vocab/vg_countname';
    documentation: '`count()` over the required `name`, grouped by `active`.';
    execution: Single
    {
    query: |typedvalues::TypedValue.all()
        ->project(~[
            k:x|$x.active,
            v:x|$x.name
        ])
        ->groupBy(~[k], ~[
            r: x|$x.v : agg|$agg->count()
        ])
        ->sort(~k->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    VG_CountName_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"k":false,"r":6},{"k":true,"r":9}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

