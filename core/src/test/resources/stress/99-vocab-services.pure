Service stress::VR_Concatenate
{
    pattern: '/stress/vocab/vr_concatenate';
    documentation: 'The notionals over 400,000 followed by those under 100,000, over a Relation.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->filter({x|($x.notional > 400000.0)})
        ->project(~[
            id:x|$x.tradeId,
            n:x|$x.notional
        ])
        ->concatenate(trading::Trade.all() ->filter({x|($x.notional < 100000.0)}) ->project(~[ id:x|$x.tradeId, n:x|$x.notional ]))
        ->sort([~id->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
