Service stress::VT_Concatenate
{
    pattern: '/stress/vocab/vt_concatenate';
    documentation: 'The notionals over 400,000 followed by those under 100,000, over a TDS.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->filter({x|($x.notional > 400000.0)})
        ->project(
            [
                x|$x.tradeId,
                x|$x.notional
            ],
            ['id', 'n']
        )
        ->concatenate(trading::Trade.all() ->filter({x|($x.notional < 100000.0)}) ->project( [ x|$x.tradeId, x|$x.notional ], ['id', 'n'] ))
        ->sort([asc('id')]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    VT_Concatenate_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 9 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":"TRD-0002","n":477500.0},{"id":"TRD-0008","n":18975.0},{"id":"TRD-0009","n":576750.0},{"id":"TRD-0010","n":498000.0},{"id":"TRD-0014","n":69000.0},{"id":"TRD-0015","n":35000.0},{"id":"TRD-0018","n":4912500.0},{"id":"TRD-0019","n":1960000.0},{"id":"TRD-0020","n":975000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::VT_JoinInner
{
    pattern: '/stress/vocab/vt_joininner';
    documentation: 'Each trade with the typed value naming it, inner, over a TDS.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(
            [
                x|$x.tradeId,
                x|$x.notional
            ],
            ['id', 'n']
        )
        ->join(typedvalues::TypedValue.all() ->filter({x|$x.valuedTrade.tradeId->isNotEmpty()}) ->project( [ x|$x.valueId, x|$x.quantity, x|$x.valuedTrade.tradeId ], ['vid', 'vq', 'tid'] ), meta::relational::metamodel::join::JoinType.INNER, {a, b|$a.getString('id') == $b.getString('tid')})
        ->sort([asc('id')]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    VT_JoinInner_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 13 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":"TRD-0001","n":190500.0,"vid":"TV-01","vq":42,"tid":"TRD-0001"},{"id":"TRD-0002","n":477500.0,"vid":"TV-02","vq":41,"tid":"TRD-0002"},{"id":"TRD-0003","n":250000.0,"vid":"TV-03","vq":43,"tid":"TRD-0003"},{"id":"TRD-0004","n":250000.0,"vid":"TV-04","vq":42,"tid":"TRD-0004"},{"id":"TRD-0005","n":250000.0,"vid":"TV-05","vq":0,"tid":"TRD-0005"},{"id":"TRD-0006","n":250000.0,"vid":"TV-06","vq":-1,"tid":"TRD-0006"},{"id":"TRD-0007","n":282000.0,"vid":"TV-07","vq":-5,"tid":"TRD-0007"},{"id":"TRD-0008","n":18975.0,"vid":"TV-08","vq":1,"tid":"TRD-0008"},{"id":"TRD-0009","n":576750.0,"vid":"TV-09","vq":100,"tid":"TRD-0009"},{"id":"TRD-0010","n":498000.0,"vid":"TV-10","vq":2147483647,"tid":"TRD-0010"},{"id":"TRD-0011","n":167300.0,"vid":"TV-11","vq":-2147483648,"tid":"TRD-0011"},{"id":"TRD-0012","n":369000.0,"vid":"TV-12","vq":7,"tid":"TRD-0012"},{"id":"TRD-0014","n":69000.0,"vid":"TV-13","vq":42,"tid":"TRD-0014"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

