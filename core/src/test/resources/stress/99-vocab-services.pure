Service stress::VC_IfCompare
{
    pattern: '/stress/vocab/vc_ifcompare';
    documentation: '`if` over a comparison of the required `quantity`, projected.';
    execution: Single
    {
    query: |typedvalues::TypedValue.all()
        ->project(~[
            valueId:x|$x.valueId,
            r:x|if(($x.quantity > 42), |'above', |'not above')
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    VC_IfCompare_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 15 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"valueId":"TV-01","r":"not above"},{"valueId":"TV-02","r":"not above"},{"valueId":"TV-03","r":"above"},{"valueId":"TV-04","r":"not above"},{"valueId":"TV-05","r":"not above"},{"valueId":"TV-06","r":"not above"},{"valueId":"TV-07","r":"not above"},{"valueId":"TV-08","r":"not above"},{"valueId":"TV-09","r":"above"},{"valueId":"TV-10","r":"above"},{"valueId":"TV-11","r":"not above"},{"valueId":"TV-12","r":"not above"},{"valueId":"TV-13","r":"not above"},{"valueId":"TV-14","r":"not above"},{"valueId":"TV-15","r":"above"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

