Service stress::VT_WindowSum
{
    pattern: '/stress/vocab/vt_windowsum';
    documentation: '`sum` of each trade date\'s notionals, on every trade, over a TDS.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(
            [
                x|$x.tradeId,
                x|$x.tradeDate,
                x|$x.notional
