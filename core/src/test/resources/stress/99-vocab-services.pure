Service stress::VG_AverageAmount
{
    pattern: '/stress/vocab/vg_averageamount';
    documentation: '`average()` over the required `amount`, grouped by `active`. Compared with 1000000.0, as its value is inexact.';
    execution: Single
    {
    query: |typedvalues::TypedValue.all()
        ->project(~[
            k:x|$x.active,
            v:x|$x.amount
        ])
        ->groupBy(~[k], ~[
            r: x|$x.v : agg|$agg->average()->greaterThan(1000000.0)
        ])
        ->sort(~k->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    VG_AverageAmount_suite:
