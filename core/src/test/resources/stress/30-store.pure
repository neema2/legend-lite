    Join Series_Observation(TIME_SERIES.SERIES_ID = TS_OBSERVATION.SERIES_ID)
    Join Series_Revision(TIME_SERIES.SERIES_ID = TS_REVISION_BI.SERIES_ID)

    // What a curve monitor reads: one row per curve and date, over the twelve pillars.
    View CURVE_SUMMARY
    (
      ~groupBy
      (
        RATE_CURVE_POINT.CURVE_ID,
        RATE_CURVE_POINT.COB_DATE
      )
      CURVE_ID: RATE_CURVE_POINT.CURVE_ID PRIMARY KEY,
      COB_DATE: RATE_CURVE_POINT.COB_DATE PRIMARY KEY,
      PILLAR_COUNT: count(RATE_CURVE_POINT.TENOR_LABEL),
      HIGHEST_RATE: max(RATE_CURVE_POINT.ZERO_RATE),
      LOWEST_RATE: min(RATE_CURVE_POINT.ZERO_RATE)
    )

    // The boundary join: a corpus pillar's tenor into a PROJECT's bucket. A range,
    // deliberately -- a key equality that lowers wrongly returns nothing and is
    // obvious, where a range returns the wrong band and looks reasonable.
    // A corpus counterparty to a PROJECT's milestoned ratings. The join names no date
    // column: the engine supplies the milestoning predicate, and that is the thing
    // under test -- it has to still do so when the temporal class is in another project.
    Join Counterparty_RatingVersion(COUNTERPARTY.COUNTERPARTY_ID = CR_RATING_MS.ENTITY_ID)
    // A corpus trade to a PROJECT's FX rate, on the rate's FULL three-column key.
    //
    // Joining on PAIR_CODE alone was the obvious first attempt and is unsound: CFX_RATE is
    // keyed by (pair, date, type), so one pair carries a SPOT row and a FIXING row and the
    // navigation is not to-one. The corpus's own oracle refused it -- "targets
    // CFX_RATE.PAIR_CODE which is not unique (value 'EURUSD')" -- rather than quietly
    // returning whichever row came first.
    //
    // So the corpus carries a pricing INSTRUCTION per trade: which pair to value it at, on
    // which date, at which rate type. That is also what a valuation actually needs, and it
    // makes the boundary a three-column cross-project join.
    Join PricedTrade_Trade(PROJECTLINK_TRADE_FX.TRADE_ID = TRADE.TRADE_ID)
    Join Trade_FxRate(PROJECTLINK_TRADE_FX.PAIR_CODE = CFX_RATE.PAIR_CODE and PROJECTLINK_TRADE_FX.COB_DATE = CFX_RATE.COB_DATE and PROJECTLINK_TRADE_FX.RATE_TYPE = CFX_RATE.RATE_TYPE)

    Join Pillar_TenorBucket(RATE_CURVE_POINT.TENOR_DAYS >= CTN_BUCKET.MIN_DAYS and RATE_CURVE_POINT.TENOR_DAYS < CTN_BUCKET.MAX_DAYS)

    // A trade's typed value (8112-typedvalues.pure): one or none, so the navigation is to-one.
    Join Trade_TypedValue(TRADE.TRADE_ID = TYPED_VALUE.TRADE_ID)

    Filter QuotedPillarRows(RATE_CURVE_POINT.IS_INTERPOLATED = 0)

    // A RANGE join: which band the notional falls in. No key, and none possible.
    // A RANGE join FROM a milestoned table. The engine adds the milestoning
    // predicate; the band membership is the join's own condition.
    Join TierVersion_Trade(TRADE.NOTIONAL >= BROKERAGE_TIER_MS.MIN_NOTIONAL and TRADE.NOTIONAL < BROKERAGE_TIER_MS.MAX_NOTIONAL)
    Filter ReportableLineRows(regrpt.EXPOSURE_LINE.PCT_OF_CAPITAL >= 5.0)

    // A RANGE join from a composite-key table: which band applies is a
    // property of the percentage, and there is no key to join on.
    Join Line_ThresholdBand(regrpt.EXPOSURE_LINE.PCT_OF_CAPITAL >= regrpt.EXPOSURE_THRESHOLD.FLOOR_PCT and regrpt.EXPOSURE_LINE.PCT_OF_CAPITAL < regrpt.EXPOSURE_THRESHOLD.CEILING_PCT)
    // A DISJUNCTION: a rule attaches to a counterparty or to a country.
    Join Line_ExemptionRule(regrpt.EXPOSURE_LINE.COUNTERPARTY_ID = regrpt.EXEMPTION_RULE.EXEMPT_CPTY_ID or regrpt.EXPOSURE_LINE.COUNTRY_CODE = regrpt.EXEMPTION_RULE.EXEMPT_COUNTRY)

    Join Trade_BrokerageTier(TRADE.NOTIONAL >= BROKERAGE_TIER.MIN_NOTIONAL and TRADE.NOTIONAL < BROKERAGE_TIER.MAX_NOTIONAL)
    // Matched on venue OR on product: a route rule carries one or the other.
    Join Trade_ClearingRoute(TRADE.EXECUTION_VENUE = CLEARING_ROUTE.VENUE_CODE or TRADE.TRADE_TYPE = CLEARING_ROUTE.PRODUCT_CODE)
    Join Curve_Benchmark(RATE_CURVE.BENCHMARK_SERIES_ID = TIME_SERIES.SERIES_ID)
    Join Curve_Summary(RATE_CURVE.CURVE_ID = CURVE_SUMMARY.CURVE_ID)
    // Explicit override else default: the pillar's own series where it has
    // one, the curve's benchmark where it does not. An `or`, because that
    // is what a fallback is.
    Join Pillar_EffectiveSeries(RATE_CURVE_POINT.SOURCE_SERIES_ID = TIME_SERIES.SERIES_ID or RATE_CURVE_POINT.CURVE_BENCHMARK_ID = TIME_SERIES.SERIES_ID)
    Join Curve_Point(RATE_CURVE.CURVE_ID = RATE_CURVE_POINT.CURVE_ID)
    Join Pillar_Series(RATE_CURVE_POINT.SOURCE_SERIES_ID = TIME_SERIES.SERIES_ID)
    // Same curve, same date, longer tenor. Three columns and the third
    // an inequality -- the join a forward rate is computed across.
    Join Pillar_LongerPillar(RATE_CURVE_POINT.CURVE_ID = {target}.CURVE_ID and RATE_CURVE_POINT.COB_DATE = {target}.COB_DATE and RATE_CURVE_POINT.TENOR_DAYS < {target}.TENOR_DAYS)

    Filter EqxAutocallableRows(EQ_EXOTIC_PAYOFF.RECORD_TYPE = 'AUTOCALLABLE')
