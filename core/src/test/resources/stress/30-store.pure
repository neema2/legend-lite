    Filter TrfQuantityFieldRows(TRANSACTION_REPORT_FIELD.RECORD_TYPE = 'QUANTITY_FIELD')
    Filter TrfShortSellingIndicatorRows(TRANSACTION_REPORT_FIELD.RECORD_TYPE = 'SHORT_SELLING_INDICATOR')
    Filter TrfWaiverIndicatorRows(TRANSACTION_REPORT_FIELD.RECORD_TYPE = 'WAIVER_INDICATOR')
    Filter TrfOtcPostTradeFlagRows(TRANSACTION_REPORT_FIELD.RECORD_TYPE = 'OTC_POST_TRADE_FLAG')
    Filter TrfCommodityDerivativeIndRows(TRANSACTION_REPORT_FIELD.RECORD_TYPE = 'COMMODITY_DERIVATIVE_IND')
    Filter TrfSecuritiesFinancingFlagRows(TRANSACTION_REPORT_FIELD.RECORD_TYPE = 'SECURITIES_FINANCING_FLAG')
    Filter TrfRejectionFeedbackRows(TRANSACTION_REPORT_FIELD.RECORD_TYPE = 'REJECTION_FEEDBACK')

    Filter CsiSovereignAaaRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'SOVEREIGN_AAA')
    Filter CsiSovereignSubIgRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'SOVEREIGN_SUB_IG')
    Filter CsiSupranationalEligRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'SUPRANATIONAL_ELIG')
    Filter CsiAgencyMbsEligRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'AGENCY_MBS_ELIG')
    Filter CsiCorporateIgEligRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'CORPORATE_IG_ELIG')
    Filter CsiCorporateHyEligRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'CORPORATE_HY_ELIG')
    Filter CsiEquityIndexEligRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'EQUITY_INDEX_ELIG')
    Filter CsiEtfEligRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'ETF_ELIG')
    Filter CsiCashEligRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'CASH_ELIG')
    Filter CsiMoneyMarketFundEligRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'MONEY_MARKET_FUND_ELIG')
    Filter CsiGoldEligRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'GOLD_ELIG')
    Filter CsiConcentrationIssuerRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'CONCENTRATION_ISSUER')
    Filter CsiConcentrationAssetClassRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'CONCENTRATION_ASSET_CLASS')
    Filter CsiWrongWayExclusionRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'WRONG_WAY_EXCLUSION')
    Filter CsiFxHaircutAddOnRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'FX_HAIRCUT_ADD_ON')
    Filter CsiScheduleAmendmentRows(COLLATERAL_SCHEDULE_ITEM.RECORD_TYPE = 'SCHEDULE_AMENDMENT')

    Filter NetBilateralNettingSetRows(NETTING_SET_ITEM.RECORD_TYPE = 'BILATERAL_NETTING_SET')
    Filter NetCrossProductNettingRows(NETTING_SET_ITEM.RECORD_TYPE = 'CROSS_PRODUCT_NETTING')
    Filter NetClearedNettingSetRows(NETTING_SET_ITEM.RECORD_TYPE = 'CLEARED_NETTING_SET')
    Filter NetMarginedSetRows(NETTING_SET_ITEM.RECORD_TYPE = 'MARGINED_SET')
    Filter NetUnmarginedSetRows(NETTING_SET_ITEM.RECORD_TYPE = 'UNMARGINED_SET')
    Filter NetOneWayCsaRows(NETTING_SET_ITEM.RECORD_TYPE = 'ONE_WAY_CSA')
    Filter NetThresholdSetRows(NETTING_SET_ITEM.RECORD_TYPE = 'THRESHOLD_SET')
    Filter NetIndependentAmountSetRows(NETTING_SET_ITEM.RECORD_TYPE = 'INDEPENDENT_AMOUNT_SET')
    Filter NetNoNettingOpinionRows(NETTING_SET_ITEM.RECORD_TYPE = 'NO_NETTING_OPINION')
    Filter NetSubNettingSetRows(NETTING_SET_ITEM.RECORD_TYPE = 'SUB_NETTING_SET')
    Filter NetMultiBranchSetRows(NETTING_SET_ITEM.RECORD_TYPE = 'MULTI_BRANCH_SET')
    Filter NetCollateralEligibleSetRows(NETTING_SET_ITEM.RECORD_TYPE = 'COLLATERAL_ELIGIBLE_SET')
    Filter NetCloseOutNettingRows(NETTING_SET_ITEM.RECORD_TYPE = 'CLOSE_OUT_NETTING')
    Filter NetSetOffRightRows(NETTING_SET_ITEM.RECORD_TYPE = 'SET_OFF_RIGHT')
    Filter NetDisputedNettingRows(NETTING_SET_ITEM.RECORD_TYPE = 'DISPUTED_NETTING')
    Filter NetStaleAgreementRows(NETTING_SET_ITEM.RECORD_TYPE = 'STALE_AGREEMENT')

    Filter PnlDeltaPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'DELTA_PNL')
    Filter PnlGammaPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'GAMMA_PNL')
    Filter PnlVegaPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'VEGA_PNL')
    Filter PnlThetaPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'THETA_PNL')
    Filter PnlRhoPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'RHO_PNL')
    Filter PnlCrossGammaPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'CROSS_GAMMA_PNL')
    Filter PnlNewTradePnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'NEW_TRADE_PNL')
    Filter PnlAmendedTradePnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'AMENDED_TRADE_PNL')
    Filter PnlCarryPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'CARRY_PNL')
    Filter PnlFundingPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'FUNDING_PNL')
    Filter PnlReserveMovementRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'RESERVE_MOVEMENT')
    Filter PnlFxTranslationPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'FX_TRANSLATION_PNL')
    Filter PnlUnexplainedPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'UNEXPLAINED_PNL')
    Filter PnlHypotheticalPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'HYPOTHETICAL_PNL')
    Filter PnlRiskTheoreticalPnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'RISK_THEORETICAL_PNL')
    Filter PnlModelChangePnlRows(PNL_EXPLAIN_ITEM.RECORD_TYPE = 'MODEL_CHANGE_PNL')

    Filter ClsProspectRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'PROSPECT')
    Filter ClsInitialScreeningRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'INITIAL_SCREENING')
    Filter ClsKycCollectionRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'KYC_COLLECTION')
    Filter ClsBeneficialOwnershipRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'BENEFICIAL_OWNERSHIP')
    Filter ClsRiskRatingRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'RISK_RATING')
    Filter ClsCreditApprovalRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'CREDIT_APPROVAL')
    Filter ClsDocumentationNegotiationRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'DOCUMENTATION_NEGOTIATION')
    Filter ClsAccountOpeningRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'ACCOUNT_OPENING')
    Filter ClsFirstTradeRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'FIRST_TRADE')
    Filter ClsPeriodicReviewRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'PERIODIC_REVIEW')
    Filter ClsTriggerReviewRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'TRIGGER_REVIEW')
    Filter ClsDormancyRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'DORMANCY')
    Filter ClsReactivationRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'REACTIVATION')
    Filter ClsOffboardingNoticeRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'OFFBOARDING_NOTICE')
    Filter ClsPositionUnwindRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'POSITION_UNWIND')
    Filter ClsRecordRetentionRows(CLIENT_LIFECYCLE_STAGE.RECORD_TYPE = 'RECORD_RETENTION')

    Filter MdeExchangeHaltRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'EXCHANGE_HALT')
    Filter MdeLimitUpLimitDownRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'LIMIT_UP_LIMIT_DOWN')
    Filter MdeAuctionExtensionRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'AUCTION_EXTENSION')
    Filter MdeEarlyClosureRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'EARLY_CLOSURE')
    Filter MdePriceSourceDisruptionRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'PRICE_SOURCE_DISRUPTION')
    Filter MdeFxInconvertibilityRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'FX_INCONVERTIBILITY')
    Filter MdeFxNonTransferabilityRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'FX_NON_TRANSFERABILITY')
    Filter MdeNationalisationRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'NATIONALISATION')
    Filter MdeInsolvencyFilingRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'INSOLVENCY_FILING')
    Filter MdeDelistingEventRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'DELISTING_EVENT')
    Filter MdeMergerEventRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'MERGER_EVENT')
    Filter MdeTenderOfferEventRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'TENDER_OFFER_EVENT')
    Filter MdeHedgingDisruptionRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'HEDGING_DISRUPTION')
    Filter MdeIncreasedCostHedgingRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'INCREASED_COST_HEDGING')
    Filter MdeChangeInLawRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'CHANGE_IN_LAW')
    Filter MdeCalculationAgentDeterminationRows(MARKET_DISRUPTION_EVENT.RECORD_TYPE = 'CALCULATION_AGENT_DETERMINATION')

    Join Counterparty_Ssi(COUNTERPARTY.COUNTERPARTY_ID = BO_SSI.COUNTERPARTY_ID)
    Join Ssi_Payment(BO_SSI.SSI_ID = PAYMENT.SSI_ID)
    Join OtcTrade_Payment(OTC_TRADE.OTC_ID = PAYMENT.OTC_ID)
    Join Nostro_Movement(BO_NOSTRO.NOSTRO_ID = NOSTRO_MOVEMENT.NOSTRO_ID)
    Join Nostro_ReconItem(BO_NOSTRO.NOSTRO_ID = RECON_ITEM.NOSTRO_ID)
    Join ReconItem_Payment(RECON_ITEM.PAYMENT_ID = PAYMENT.PAYMENT_ID)
    Join ReconItem_Movement(RECON_ITEM.MOVEMENT_ID = NOSTRO_MOVEMENT.MOVEMENT_ID)

    Filter PaySwiftMt202Rows(PAYMENT.PAYMENT_TYPE = 'SWIFT_MT202')
    Filter PayTarget2Rows(PAYMENT.PAYMENT_TYPE = 'TARGET2')
    Filter PayFedwireRows(PAYMENT.PAYMENT_TYPE = 'FEDWIRE')
    Filter PayBookTransferRows(PAYMENT.PAYMENT_TYPE = 'BOOK_TRANSFER')
    Filter RecMatchedRows(RECON_ITEM.ITEM_TYPE = 'MATCHED')
    Filter RecUnmatchedStatementRows(RECON_ITEM.ITEM_TYPE = 'UNMATCHED_STATEMENT')
    Filter RecUnmatchedLedgerRows(RECON_ITEM.ITEM_TYPE = 'UNMATCHED_LEDGER')
    Filter RecValueDateMismatchRows(RECON_ITEM.ITEM_TYPE = 'VALUE_DATE_MISMATCH')

    Join OtcTrade_LifecycleEvent(OTC_TRADE.OTC_ID = LIFECYCLE_EVENT.OTC_ID)
    Join OtcTrade_ConfirmationMo(OTC_TRADE.OTC_ID = CONFIRMATION_MO.OTC_ID)
    Join OtcTrade_Break(OTC_TRADE.OTC_ID = TRADE_BREAK.OTC_ID)

    // Lifecycle event and break discriminators.
    Filter EvtNewTradeRows(LIFECYCLE_EVENT.EVENT_TYPE = 'NEW_TRADE')
    Filter EvtAmendmentRows(LIFECYCLE_EVENT.EVENT_TYPE = 'AMENDMENT')
    Filter EvtPartialTerminationRows(LIFECYCLE_EVENT.EVENT_TYPE = 'PARTIAL_TERMINATION')
    Filter EvtFullTerminationRows(LIFECYCLE_EVENT.EVENT_TYPE = 'FULL_TERMINATION')
    Filter EvtNovationRows(LIFECYCLE_EVENT.EVENT_TYPE = 'NOVATION')
    Filter EvtCompressionRows(LIFECYCLE_EVENT.EVENT_TYPE = 'COMPRESSION')
    Filter EvtIncreaseRows(LIFECYCLE_EVENT.EVENT_TYPE = 'INCREASE')
    Filter EvtRateResetRows(LIFECYCLE_EVENT.EVENT_TYPE = 'RATE_RESET')
    Filter EvtFixingRows(LIFECYCLE_EVENT.EVENT_TYPE = 'FIXING')
    Filter EvtExerciseRows(LIFECYCLE_EVENT.EVENT_TYPE = 'EXERCISE')
    Filter EvtCreditEventRows(LIFECYCLE_EVENT.EVENT_TYPE = 'CREDIT_EVENT')
    Filter BrkEconomicBreakRows(TRADE_BREAK.BREAK_TYPE = 'ECONOMIC_BREAK')
    Filter BrkConfirmationBreakRows(TRADE_BREAK.BREAK_TYPE = 'CONFIRMATION_BREAK')
    Filter BrkSettlementBreakRows(TRADE_BREAK.BREAK_TYPE = 'SETTLEMENT_BREAK')
    Filter BrkReferenceDataBreakRows(TRADE_BREAK.BREAK_TYPE = 'REFERENCE_DATA_BREAK')
    Filter BrkValuationBreakRows(TRADE_BREAK.BREAK_TYPE = 'VALUATION_BREAK')
    Filter BrkCollateralBreakRows(TRADE_BREAK.BREAK_TYPE = 'COLLATERAL_BREAK')

    Join RiskRun_Sensitivity(RISK_RUN.RUN_ID = SENSITIVITY.RUN_ID)
    Join RiskRun_Measure(RISK_RUN.RUN_ID = RISK_MEASURE.RUN_ID)
    Join RiskRun_ScenarioResult(RISK_RUN.RUN_ID = SCENARIO_RESULT.RUN_ID)
    Join Scenario_Result(MR_STRESS_SCENARIO.SCENARIO_ID = SCENARIO_RESULT.SCENARIO_ID)
    Join Sensitivity_Factor(SENSITIVITY.FACTOR_ID = MR_RISK_FACTOR.FACTOR_ID)
    Join Sensitivity_OtcTrade(SENSITIVITY.OTC_ID = OTC_TRADE.OTC_ID)

    // Discriminators for the risk-measure taxonomy. A historical VaR and a parametric VaR
    // answer the same question with different models and belong to different classes.
    Filter RiskHistoricalVarRows(RISK_MEASURE.MEASURE_TYPE = 'HISTORICAL_VAR')
    Filter RiskParametricVarRows(RISK_MEASURE.MEASURE_TYPE = 'PARAMETRIC_VAR')
    Filter RiskMonteCarloVarRows(RISK_MEASURE.MEASURE_TYPE = 'MONTE_CARLO_VAR')
    Filter RiskExpectedShortfallRows(RISK_MEASURE.MEASURE_TYPE = 'EXPECTED_SHORTFALL')
    Filter RiskStressedVarRows(RISK_MEASURE.MEASURE_TYPE = 'STRESSED_VAR')
    Filter RiskCvaRows(RISK_MEASURE.MEASURE_TYPE = 'CVA')
    Filter RiskDvaRows(RISK_MEASURE.MEASURE_TYPE = 'DVA')
    Filter RiskFvaRows(RISK_MEASURE.MEASURE_TYPE = 'FVA')
    Filter RiskPfeRows(RISK_MEASURE.MEASURE_TYPE = 'PFE')
    Filter SensDv01Rows(SENSITIVITY.MEASURE_TYPE = 'DV01')
    Filter SensCs01Rows(SENSITIVITY.MEASURE_TYPE = 'CS01')
    Filter SensVegaRows(SENSITIVITY.MEASURE_TYPE = 'VEGA')
    Filter SensFxDeltaRows(SENSITIVITY.MEASURE_TYPE = 'FX_DELTA')
    Filter SensEquityDeltaRows(SENSITIVITY.MEASURE_TYPE = 'EQUITY_DELTA')
    Filter SensCommodityDeltaRows(SENSITIVITY.MEASURE_TYPE = 'COMMODITY_DELTA')

    Join OtcTrade_Leg(OTC_TRADE.OTC_ID = OTC_SWAP_LEG.OTC_ID)
    Join OtcTrade_OptionTerms(OTC_TRADE.OTC_ID = OTC_OPTION_TERMS.OTC_ID)
    Join OtcTrade_Counterparty(OTC_TRADE.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)

    // The product-type discriminators. One per class in the taxonomy, which is what makes
    // thirteen subclasses over one table possible.
    Filter OtcIrsRows(OTC_TRADE.PRODUCT_TYPE = 'IRS')
    Filter OtcOisRows(OTC_TRADE.PRODUCT_TYPE = 'OIS')
    Filter OtcBasisSwapRows(OTC_TRADE.PRODUCT_TYPE = 'BASIS_SWAP')
    Filter OtcFraRows(OTC_TRADE.PRODUCT_TYPE = 'FRA')
    Filter OtcSwaptionRows(OTC_TRADE.PRODUCT_TYPE = 'SWAPTION')
    Filter OtcCapRows(OTC_TRADE.PRODUCT_TYPE = 'CAP')
    Filter OtcCdsRows(OTC_TRADE.PRODUCT_TYPE = 'CDS')
    Filter OtcCdsIndexRows(OTC_TRADE.PRODUCT_TYPE = 'CDS_INDEX')
    Filter OtcNdfRows(OTC_TRADE.PRODUCT_TYPE = 'NDF')
    Filter OtcFxOptionRows(OTC_TRADE.PRODUCT_TYPE = 'FX_OPTION')
    Filter OtcEquitySwapRows(OTC_TRADE.PRODUCT_TYPE = 'EQUITY_SWAP')
    Filter OtcVarianceSwapRows(OTC_TRADE.PRODUCT_TYPE = 'VARIANCE_SWAP')
    Filter OtcCommoditySwapRows(OTC_TRADE.PRODUCT_TYPE = 'COMMODITY_SWAP')

    // The exotic book. Fifty-eight more product types over the same base table -- the
    // taxonomy a derivatives firm actually carries, most of which it is not holding today.
    Filter OtcConstantMaturitySwapRows(OTC_TRADE.PRODUCT_TYPE = 'CONSTANT_MATURITY_SWAP')
    Filter OtcInflationSwapRows(OTC_TRADE.PRODUCT_TYPE = 'INFLATION_SWAP')
    Filter OtcCrossCurrencySwapRows(OTC_TRADE.PRODUCT_TYPE = 'CROSS_CURRENCY_SWAP')
    Filter OtcAmortisingSwapRows(OTC_TRADE.PRODUCT_TYPE = 'AMORTISING_SWAP')
    Filter OtcAccretingSwapRows(OTC_TRADE.PRODUCT_TYPE = 'ACCRETING_SWAP')
    Filter OtcRollercoasterSwapRows(OTC_TRADE.PRODUCT_TYPE = 'ROLLERCOASTER_SWAP')
    Filter OtcZeroCouponSwapRows(OTC_TRADE.PRODUCT_TYPE = 'ZERO_COUPON_SWAP')
    Filter OtcArrearsSwapRows(OTC_TRADE.PRODUCT_TYPE = 'ARREARS_SWAP')
    Filter OtcCallableSwapRows(OTC_TRADE.PRODUCT_TYPE = 'CALLABLE_SWAP')
    Filter OtcRangeAccrualRows(OTC_TRADE.PRODUCT_TYPE = 'RANGE_ACCRUAL')
    Filter OtcCmsSpreadOptionRows(OTC_TRADE.PRODUCT_TYPE = 'CMS_SPREAD_OPTION')
    Filter OtcBermudanSwaptionRows(OTC_TRADE.PRODUCT_TYPE = 'BERMUDAN_SWAPTION')
    Filter OtcMidcurveSwaptionRows(OTC_TRADE.PRODUCT_TYPE = 'MIDCURVE_SWAPTION')
    Filter OtcFloorRows(OTC_TRADE.PRODUCT_TYPE = 'FLOOR')
    Filter OtcCollarRows(OTC_TRADE.PRODUCT_TYPE = 'COLLAR')
    Filter OtcDigitalCapRows(OTC_TRADE.PRODUCT_TYPE = 'DIGITAL_CAP')
    Filter OtcCdsTrancheRows(OTC_TRADE.PRODUCT_TYPE = 'CDS_TRANCHE')
    Filter OtcFirstToDefaultRows(OTC_TRADE.PRODUCT_TYPE = 'FIRST_TO_DEFAULT')
    Filter OtcNthToDefaultRows(OTC_TRADE.PRODUCT_TYPE = 'NTH_TO_DEFAULT')
    Filter OtcRecoverySwapRows(OTC_TRADE.PRODUCT_TYPE = 'RECOVERY_SWAP')
    Filter OtcCreditLinkedNoteRows(OTC_TRADE.PRODUCT_TYPE = 'CREDIT_LINKED_NOTE')
    Filter OtcConstantMaturityCdsRows(OTC_TRADE.PRODUCT_TYPE = 'CONSTANT_MATURITY_CDS')
    Filter OtcLoanCdsRows(OTC_TRADE.PRODUCT_TYPE = 'LOAN_CDS')
    Filter OtcSovereignCdsRows(OTC_TRADE.PRODUCT_TYPE = 'SOVEREIGN_CDS')
    Filter OtcFxSwapRows(OTC_TRADE.PRODUCT_TYPE = 'FX_SWAP')
    Filter OtcFxBarrierOptionRows(OTC_TRADE.PRODUCT_TYPE = 'FX_BARRIER_OPTION')
    Filter OtcFxDigitalRows(OTC_TRADE.PRODUCT_TYPE = 'FX_DIGITAL')
    Filter OtcFxAsianOptionRows(OTC_TRADE.PRODUCT_TYPE = 'FX_ASIAN_OPTION')
    Filter OtcFxAccumulatorRows(OTC_TRADE.PRODUCT_TYPE = 'FX_ACCUMULATOR')
    Filter OtcFxTarfRows(OTC_TRADE.PRODUCT_TYPE = 'FX_TARF')
    Filter OtcQuantoForwardRows(OTC_TRADE.PRODUCT_TYPE = 'QUANTO_FORWARD')
    Filter OtcNdsRows(OTC_TRADE.PRODUCT_TYPE = 'NDS')
    Filter OtcEquityOptionOtcRows(OTC_TRADE.PRODUCT_TYPE = 'EQUITY_OPTION_OTC')
    Filter OtcDividendSwapRows(OTC_TRADE.PRODUCT_TYPE = 'DIVIDEND_SWAP')
    Filter OtcTotalReturnSwapRows(OTC_TRADE.PRODUCT_TYPE = 'TOTAL_RETURN_SWAP')
    Filter OtcAutocallableRows(OTC_TRADE.PRODUCT_TYPE = 'AUTOCALLABLE')
    Filter OtcReverseConvertibleRows(OTC_TRADE.PRODUCT_TYPE = 'REVERSE_CONVERTIBLE')
    Filter OtcCliquetRows(OTC_TRADE.PRODUCT_TYPE = 'CLIQUET')
    Filter OtcLookbackOptionRows(OTC_TRADE.PRODUCT_TYPE = 'LOOKBACK_OPTION')
    Filter OtcBasketOptionRows(OTC_TRADE.PRODUCT_TYPE = 'BASKET_OPTION')
    Filter OtcRainbowOptionRows(OTC_TRADE.PRODUCT_TYPE = 'RAINBOW_OPTION')
    Filter OtcVolatilitySwapRows(OTC_TRADE.PRODUCT_TYPE = 'VOLATILITY_SWAP')
    Filter OtcCorridorVarianceSwapRows(OTC_TRADE.PRODUCT_TYPE = 'CORRIDOR_VARIANCE_SWAP')
    Filter OtcGammaSwapRows(OTC_TRADE.PRODUCT_TYPE = 'GAMMA_SWAP')
    Filter OtcEquityRepoRows(OTC_TRADE.PRODUCT_TYPE = 'EQUITY_REPO')
    Filter OtcCommodityOptionRows(OTC_TRADE.PRODUCT_TYPE = 'COMMODITY_OPTION')
    Filter OtcCommoditySpreadRows(OTC_TRADE.PRODUCT_TYPE = 'COMMODITY_SPREAD')
    Filter OtcCommodityAsianRows(OTC_TRADE.PRODUCT_TYPE = 'COMMODITY_ASIAN')
    Filter OtcWeatherDerivativeRows(OTC_TRADE.PRODUCT_TYPE = 'WEATHER_DERIVATIVE')
    Filter OtcFreightForwardRows(OTC_TRADE.PRODUCT_TYPE = 'FREIGHT_FORWARD')
    Filter OtcEmissionsForwardRows(OTC_TRADE.PRODUCT_TYPE = 'EMISSIONS_FORWARD')
    Filter OtcPrdcRows(OTC_TRADE.PRODUCT_TYPE = 'PRDC')
    Filter OtcCallableRangeAccrualRows(OTC_TRADE.PRODUCT_TYPE = 'CALLABLE_RANGE_ACCRUAL')
    Filter OtcConvertibleAssetSwapRows(OTC_TRADE.PRODUCT_TYPE = 'CONVERTIBLE_ASSET_SWAP')
    Filter OtcEquityLinkedNoteRows(OTC_TRADE.PRODUCT_TYPE = 'EQUITY_LINKED_NOTE')
    Filter OtcInflationLinkedSwapRows(OTC_TRADE.PRODUCT_TYPE = 'INFLATION_LINKED_SWAP')
    Filter OtcLongevitySwapRows(OTC_TRADE.PRODUCT_TYPE = 'LONGEVITY_SWAP')
    Filter OtcMortgageTbaRows(OTC_TRADE.PRODUCT_TYPE = 'MORTGAGE_TBA')

    Join Security_CouponPeriod(DEBT_SECURITY.SECURITY_ID = COUPON_PERIOD.SECURITY_ID)
    Join CouponPeriod_Payment(COUPON_PERIOD.PERIOD_ID = COUPON_PAYMENT.PERIOD_ID)
    // Reach the MILESTONED tables from the entities they describe. Both were islands, so the
    // only services carrying `milestoning` and `composite PK` were the nine rooted at them,
    // and each construct sat at five of its forty possible pairs. The FROM_Z/THRU_Z columns
    // are not in the condition: milestoning supplies them, and putting them here would be
    // asserting the temporal semantics by hand instead of letting the engine apply them.
    Join Counterparty_RatingMS(COUNTERPARTY.COUNTERPARTY_ID = CPTY_RATING_MS.COUNTERPARTY_ID)
    Join Instrument_RatingBI(INSTRUMENT.INSTRUMENT_ID = INSTR_RATING_BI.INSTRUMENT_ID)

    Join TradeFlatPartial_Counterparty(TRADE_FLAT_PARTIAL.CPTY_FK = COUNTERPARTY.COUNTERPARTY_ID)

    Filter ExecutedTrades(TRADE.STATUS = 'EXECUTED')
)
