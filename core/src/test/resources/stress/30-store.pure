// The ONE store::DB — merged from the per-domain store files.
// Engine-lite silently UNIONED same-named Database declarations across
// sources; real Legend (and core) treats a duplicate FQN as an error,
// so the tables/joins live in this single declaration.

###Relational
Database store::DB
(
    // The project dependency graph, one project of it, made executable. See
    // 8111-projectlink.pure for why this line exists.
    //
    // FIRST in the body, and that is a grammar requirement rather than a
    // convention: an `include` after a Table declaration fails with a bare
    // `Unexpected token` from RelationalParserGrammar.definition, naming no
    // file, no line and no element.
    include core_tenor::Store
    include core_fx::Store
    include core_ratings::Store
    // fee_core::Store ITSELF includes core_tenor::Store, which is included directly above.
    // So this is a DIAMOND rather than a chain, and whether the same store reached by two
    // paths is merged or duplicated is a question only execution answers.
    include fee_core::Store
    // 23 classes over THREE tables: one wide instrument master, a subtype hierarchy three
    // levels deep told apart by ~filter, and twenty filters in a namespace that is global
    // across the whole graph.
    include core_instrument::Store
    // Carries a VIEW with a ~groupBy, CC_HOLIDAY_COUNT, which is the ~mainTable of a
    // mapped class. No DDL is created for it and nothing seeds it.
    include core_calendar::Store
    // Every table of this one lives in the `uom` SCHEMA, so its columns are reached as
    // [db]uom.TABLE.COL -- including from the corpus store that includes it.
    include core_units::Store
    // Every join in this one is TWO columns, because an account is keyed by institution
    // and number and a branch code is unique only within an institution.
    include core_account::Store
    // The first linked project whose edges are ASSOCIATIONS rather than properties over
    // a join -- ten of them, including a many-to-many through a link table.
    include core_geo::Store
    // TWO already-executable parents: it joins into core-instrument and core-geo from the
    // same class, and one of its ~groupBy views groups on the key into core-geo.
    include index_core::Store
    // Not a linked project: the typed-values pack's own store (8112-typedvalues.pure), included the same
    // way so this connection seeds it and the join from TRADE below sees both tables.
    include typedvalues::TypedStore
    // The intraday milestoning pack's store (8113-intraday.pure), included the same way.
    include intraday::IntradayStore

    // ---- taxonomy edges, added by scripts/corpus/add_taxonomy_edges.py ----
    // Every taxonomy table carries BOOK_ID and joined to nothing; these are
    // the edges that make 1811 otherwise-flat roots navigable.
    Join LitigationBaseBook(LEGAL_MATTER.BOOK_ID = BOOK.BOOK_ID)
    Join ApidistributionBaseBook(DISTRIBUTION_CHANNEL.BOOK_ID = BOOK.BOOK_ID)
    Join EntitlementsBaseBook(ACCESS_ENTITLEMENT.BOOK_ID = BOOK.BOOK_ID)
    Join YearendprocessBaseBook(PERIOD_END_TASK.BOOK_ID = BOOK.BOOK_ID)
    Join MifidfieldsBaseBook(TRANSACTION_REPORT_FIELD.BOOK_ID = BOOK.BOOK_ID)
    Join AgencylendingBaseBook(COLLATERAL_SCHEDULE_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join NettingsetsBaseBook(NETTING_SET_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join BookclosureBaseBook(PNL_EXPLAIN_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join ClientlifecycleBaseBook(CLIENT_LIFECYCLE_STAGE.BOOK_ID = BOOK.BOOK_ID)
    Join MarketeventsBaseBook(MARKET_DISRUPTION_EVENT.BOOK_ID = BOOK.BOOK_ID)
    Join EqexoticsBaseBook(EQ_EXOTIC_PAYOFF.BOOK_ID = BOOK.BOOK_ID)
    Join FxexoticsBaseBook(FX_EXOTIC_STRUCTURE.BOOK_ID = BOOK.BOOK_ID)
    Join RatesexoticsBaseBook(RATES_EXOTIC.BOOK_ID = BOOK.BOOK_ID)
    Join CreditstructuresBaseBook(CREDIT_STRUCTURE.BOOK_ID = BOOK.BOOK_ID)
    Join SecuritisationBaseBook(SECURITISATION_TRANCHE.BOOK_ID = BOOK.BOOK_ID)
    Join StructurednotesBaseBook(STRUCTURED_NOTE_WRAPPER.BOOK_ID = BOOK.BOOK_ID)
    Join RepotypesBaseBook(REPO_ARRANGEMENT.BOOK_ID = BOOK.BOOK_ID)
    Join FundtypesBaseBook(FUND_VEHICLE.BOOK_ID = BOOK.BOOK_ID)
    Join CapitalinstrumentsBaseBook(CAPITAL_INSTRUMENT.BOOK_ID = BOOK.BOOK_ID)
    Join PaymenttypesBaseBook(PAYMENT_INSTRUCTION.BOOK_ID = BOOK.BOOK_ID)
    Join SettlementfailsBaseBook(SETL_FAIL_REASON.BOOK_ID = BOOK.BOOK_ID)
    Join SurveillanceBaseBook(SURVEILLANCE_ALERT.BOOK_ID = BOOK.BOOK_ID)
    Join FundingsourcesBaseBook(FUNDING_SOURCE.BOOK_ID = BOOK.BOOK_ID)
    Join BalancesheetBaseBook(BALANCE_SHEET_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join ImpairmentBaseBook(IMPAIRMENT_STAGE.BOOK_ID = BOOK.BOOK_ID)
    Join ModelriskBaseBook(MODEL_INVENTORY_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join AuditfindingsBaseBook(AUDIT_FINDING.BOOK_ID = BOOK.BOOK_ID)
    Join DataqualityBaseBook(DATA_QUALITY_RULE.BOOK_ID = BOOK.BOOK_ID)
    Join RegimesBaseBook(REGULATORY_REGIME.BOOK_ID = BOOK.BOOK_ID)
    Join BookinglocationsBaseBook(BOOKING_LOCATION.BOOK_ID = BOOK.BOOK_ID)
    Join EmployeerolesBaseBook(EMPLOYEE_ROLE.BOOK_ID = BOOK.BOOK_ID)
    Join ClientaccessBaseBook(CLIENT_ACCESS_ARRANGEMENT.BOOK_ID = BOOK.BOOK_ID)
    Join IncidentsBaseBook(OPS_INCIDENT_EVENT.BOOK_ID = BOOK.BOOK_ID)
    Join HedgeaccountingBaseBook(HEDGE_RELATIONSHIP.BOOK_ID = BOOK.BOOK_ID)
    Join OrdertypesBaseBook(ORDER_HANDLING_TYPE.BOOK_ID = BOOK.BOOK_ID)
    Join FeetypesBaseBook(FEE_CHARGE_TYPE.BOOK_ID = BOOK.BOOK_ID)
    Join IndexrulesBaseBook(INDEX_METHODOLOGY.BOOK_ID = BOOK.BOOK_ID)
    Join RatingscalesBaseBook(RATING_ASSIGNMENT.BOOK_ID = BOOK.BOOK_ID)
    Join CommoditiesBaseBook(COMMODITY_CONTRACT.BOOK_ID = BOOK.BOOK_ID)
    Join InsurancelinkedBaseBook(INSURANCE_LINKED_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join DigitalassetsBaseBook(DIGITAL_ASSET_POSITION.BOOK_ID = BOOK.BOOK_ID)
    Join IslamicfinanceBaseBook(SHARIAH_STRUCTURE.BOOK_ID = BOOK.BOOK_ID)
    Join TradefinanceBaseBook(TRADE_FINANCE_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join WealthproductsBaseBook(WEALTH_PRODUCT.BOOK_ID = BOOK.BOOK_ID)
    Join PensionsitemsBaseBook(PENSION_SCHEME_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join RealassetsBaseBook(REAL_ASSET_HOLDING.BOOK_ID = BOOK.BOOK_ID)
    Join IdentifiersBaseBook(INSTRUMENT_IDENTIFIER.BOOK_ID = BOOK.BOOK_ID)
    Join CorpactionsxBaseBook(CORPORATE_EVENT_TYPE.BOOK_ID = BOOK.BOOK_ID)
    Join ProxyvotingBaseBook(PROXY_VOTE_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join TaxlotsBaseBook(TAX_LOT_METHOD.BOOK_ID = BOOK.BOOK_ID)
    Join ClearingmembersBaseBook(CLEARING_ARRANGEMENT.BOOK_ID = BOOK.BOOK_ID)
    Join ValuationadjBaseBook(XVA_ADJUSTMENT.BOOK_ID = BOOK.BOOK_ID)
    Join StresstestsBaseBook(STRESS_TEST_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join MarketmakingBaseBook(MARKET_MAKING_OBLIGATION.BOOK_ID = BOOK.BOOK_ID)
    Join BankingproductsBaseBook(BANKING_PRODUCT.BOOK_ID = BOOK.BOOK_ID)
    Join LendingcovenantsBaseBook(LOAN_COVENANT.BOOK_ID = BOOK.BOOK_ID)
    Join SwiftmessagesBaseBook(SWIFT_MESSAGE.BOOK_ID = BOOK.BOOK_ID)
    Join RecontypesBaseBook(RECONCILIATION_TYPE.BOOK_ID = BOOK.BOOK_ID)
    Join LegalagreementsBaseBook(LEGAL_AGREEMENT.BOOK_ID = BOOK.BOOK_ID)
    Join FrtbdesksBaseBook(FRTB_DESK_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join CbrelationshipsBaseBook(CORRESPONDENT_RELATIONSHIP.BOOK_ID = BOOK.BOOK_ID)
    Join ProspectusBaseBook(PROSPECTUS_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join CashmanagementBaseBook(CASH_MANAGEMENT_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join OutsourcingBaseBook(OUTSOURCING_ARRANGEMENT.BOOK_ID = BOOK.BOOK_ID)
    Join ClientreportingBaseBook(CLIENT_REPORT.BOOK_ID = BOOK.BOOK_ID)
    Join IssuanceprocessBaseBook(ISSUANCE_STAGE.BOOK_ID = BOOK.BOOK_ID)
    Join ShortsellingBaseBook(SHORT_POSITION_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join BenchmarkreformBaseBook(BENCHMARK_TRANSITION_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join AppetitemetricsBaseBook(RISK_APPETITE_METRIC.BOOK_ID = BOOK.BOOK_ID)
    Join GreenfinanceBaseBook(SUSTAINABLE_FINANCE_ITEM.BOOK_ID = BOOK.BOOK_ID)
    Join CollateraltransformBaseBook(COLLATERAL_TRANSFORMATION.BOOK_ID = BOOK.BOOK_ID)
    Join SecuritieslendingBaseBook(SEC_LENDING_ITEM.BOOK_ID = BOOK.BOOK_ID)

    // ---- from 31-products-store.pure ----
    Table INSTRUMENT (INSTRUMENT_ID VARCHAR(200) PRIMARY KEY, TICKER VARCHAR(200), NAME VARCHAR(200), ISIN VARCHAR(200), CUSIP VARCHAR(200), SEDOL VARCHAR(200), ASSET_CLASS VARCHAR(200), PRODUCT_TYPE VARCHAR(200), IS_ACTIVE BIT, LISTING_DATE DATE, MATURITY_DATE DATE, NOTIONAL_AMOUNT DOUBLE, CURRENCY VARCHAR(200), DESCRIPTION VARCHAR(200), ISSUE_DATE DATE, EQUITY_ID VARCHAR(200), BOND_ID VARCHAR(200), FUTURE_ID VARCHAR(200), FX_FORWARD_ID VARCHAR(200), SWAP_ID VARCHAR(200), CDS_ID VARCHAR(200), STRUCTURED_PRODUCT_ID VARCHAR(200), ETF_ID VARCHAR(200), CURRENCY_CODE VARCHAR(200), EXCHANGE_MIC VARCHAR(200), SECTOR_ID VARCHAR(200))
    Table EQUITY (EQUITY_ID VARCHAR(200) PRIMARY KEY, TICKER VARCHAR(200), COMPANY_NAME VARCHAR(200), SHARE_CLASS VARCHAR(200), MARKET_CAP DOUBLE, SHARES_OUTSTANDING DOUBLE, DIVIDEND_YIELD DOUBLE, PE_RATIO DOUBLE, BETA DOUBLE, PRIMARY_EXCHANGE VARCHAR(200), IS_ADR BIT, LOT_SIZE INTEGER, LAST_PRICE DOUBLE, PRICE_DATE DATE, INSTRUMENT_ID VARCHAR(200))
    Table BOND (BOND_ID VARCHAR(200) PRIMARY KEY, ISSUER_NAME VARCHAR(200), COUPON_RATE DOUBLE, COUPON_FREQUENCY INTEGER, FACE_VALUE DOUBLE, MATURITY_DATE DATE, ISSUE_DATE DATE, CREDIT_RATING VARCHAR(200), YIELD_TO_MATURITY DOUBLE, DURATION DOUBLE, CONVEXITY DOUBLE, IS_CALLABLE BIT, CALL_DATE DATE, CALL_PRICE DOUBLE, BOND_TYPE VARCHAR(200), CURRENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200), ISSUER_ID VARCHAR(200))
    Table OPTION (OPTION_ID VARCHAR(200) PRIMARY KEY, OPTION_TYPE VARCHAR(200), STRIKE_PRICE DOUBLE, EXPIRATION_DATE DATE, PREMIUM DOUBLE, IMPLIED_VOLATILITY DOUBLE, DELTA DOUBLE, GAMMA DOUBLE, THETA DOUBLE, VEGA DOUBLE, EXERCISE_STYLE VARCHAR(200), IS_IN_THE_MONEY BIT, UNDERLYING_PRICE DOUBLE, CONTRACT_SIZE INTEGER, OPEN_INTEREST INTEGER, UNDERLYING_ID VARCHAR(200))
    Table FUTURE (FUTURE_ID VARCHAR(200) PRIMARY KEY, CONTRACT_NAME VARCHAR(200), CONTRACT_MONTH VARCHAR(200), CONTRACT_YEAR INTEGER, TICK_SIZE DOUBLE, CONTRACT_SIZE INTEGER, LAST_TRADING_DATE DATE, FIRST_NOTICE_DATE DATE, SETTLEMENT_TYPE VARCHAR(200), MARGIN_REQUIRED DOUBLE, DAILY_LIMIT DOUBLE, OPEN_INTEREST INTEGER, INSTRUMENT_ID VARCHAR(200))
    Table FX_FORWARD (FORWARD_ID VARCHAR(200) PRIMARY KEY, BASE_CURRENCY VARCHAR(200), QUOTE_CURRENCY VARCHAR(200), FORWARD_RATE DOUBLE, SPOT_RATE DOUBLE, FORWARD_POINTS DOUBLE, NOTIONAL_BASE DOUBLE, NOTIONAL_QUOTE DOUBLE, VALUE_DATE DATE, TRADE_DATE DATE, TENOR VARCHAR(200), IS_NDF BIT, INSTRUMENT_ID VARCHAR(200))
    Table SWAP (SWAP_ID VARCHAR(200) PRIMARY KEY, SWAP_TYPE VARCHAR(200), NOTIONAL DOUBLE, FIXED_RATE DOUBLE, FLOATING_INDEX VARCHAR(200), FLOATING_SPREAD DOUBLE, START_DATE DATE, END_DATE DATE, PAYMENT_FREQUENCY VARCHAR(200), DAY_COUNT_CONVENTION VARCHAR(200), CURRENCY VARCHAR(200), IS_CLEARED BIT, CLEARING_HOUSE VARCHAR(200), CURRENT_NPV DOUBLE, INSTRUMENT_ID VARCHAR(200))
    Table CREDIT_DEFAULT_SWAP (CDS_ID VARCHAR(200) PRIMARY KEY, REFERENCE_ENTITY VARCHAR(200), NOTIONAL DOUBLE, SPREAD DOUBLE, PREMIUM_LEG DOUBLE, PROTECTION_LEG DOUBLE, MATURITY_DATE DATE, EFFECTIVE_DATE DATE, RECOVERY_RATE DOUBLE, IS_TRIGGERED BIT, TRIGGER_DATE DATE, CURRENCY VARCHAR(200), SENIORITY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table STRUCTURED_PRODUCT (PRODUCT_ID VARCHAR(200) PRIMARY KEY, PRODUCT_NAME VARCHAR(200), UNDERLYING_TYPE VARCHAR(200), NOTIONAL DOUBLE, ISSUE_DATE DATE, MATURITY_DATE DATE, KNOCK_IN_BARRIER DOUBLE, KNOCK_OUT_BARRIER DOUBLE, PARTICIPATION_RATE DOUBLE, COUPON_RATE DOUBLE, PRINCIPAL_PROTECTION DOUBLE, CURRENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table ETF (ETF_ID VARCHAR(200) PRIMARY KEY, TICKER VARCHAR(200), FUND_NAME VARCHAR(200), ASSET_CLASS VARCHAR(200), EXPENSE_RATIO DOUBLE, TOTAL_ASSETS DOUBLE, NAV DOUBLE, NAV_DATE DATE, TRACKING_ERROR DOUBLE, INDEX_NAME VARCHAR(200), IS_LEVERAGED BIT, LEVERAGE_MULTIPLE DOUBLE, DIVIDEND_FREQUENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))

    Join Equity_Instrument(EQUITY.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Bond_Instrument(BOND.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Option_Underlying(OPTION.UNDERLYING_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Future_Instrument(FUTURE.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join FxForward_Instrument(FX_FORWARD.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Swap_Instrument(SWAP.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join CDS_Instrument(CREDIT_DEFAULT_SWAP.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join StructuredProduct_Instrument(STRUCTURED_PRODUCT.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join ETF_Instrument(ETF.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)

    // ---- from 32-refdata-store.pure ----
    Table CURRENCY (CODE VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), NUMERIC_CODE INTEGER, MINOR_UNIT INTEGER, SYMBOL VARCHAR(200), IS_ACTIVE BIT, REGION VARCHAR(200), IS_MAJOR BIT, CENTRAL_BANK VARCHAR(200), FIXING_SOURCE VARCHAR(200), COUNTRY_ID VARCHAR(200))
    Table EXCHANGE (MIC VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), CITY VARCHAR(200), TIMEZONE VARCHAR(200), OPEN_TIME VARCHAR(200), CLOSE_TIME VARCHAR(200), IS_ELECTRONIC BIT, OPERATING_MIC VARCHAR(200), WEBSITE VARCHAR(200), REGULATORY_BODY VARCHAR(200), COUNTRY_ID VARCHAR(200))
    Table SECTOR (SECTOR_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), GICS_CODE VARCHAR(200), LEVEL INTEGER, DESCRIPTION VARCHAR(200), IS_ACTIVE BIT, PARENT_SECTOR_ID VARCHAR(200), MARKET_CAP_WEIGHT DOUBLE, NUMBER_OF_COMPANIES INTEGER, LAST_UPDATED DATE)
    Table INDUSTRY (INDUSTRY_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), SIC_CODE VARCHAR(200), NAICS_CODE VARCHAR(200), DESCRIPTION VARCHAR(200), IS_ACTIVE BIT, SUB_INDUSTRY_OF VARCHAR(200), AVERAGE_PE DOUBLE, AVERAGE_DIVIDEND_YIELD DOUBLE, LAST_UPDATED DATE, SECTOR_ID VARCHAR(200))
    Table ISSUER (ISSUER_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), LEI VARCHAR(200), TICKER VARCHAR(200), CREDIT_RATING VARCHAR(200), RATING_AGENCY VARCHAR(200), DOMICILE VARCHAR(200), ISSUER_TYPE VARCHAR(200), IS_ACTIVE BIT, INCORPORATION_DATE DATE, TOTAL_DEBT_OUTSTANDING DOUBLE, WEBSITE VARCHAR(200), COUNTRY_ID VARCHAR(200))
    Table COUNTRY (COUNTRY_CODE VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), ISO3_CODE VARCHAR(200), REGION VARCHAR(200), SUB_REGION VARCHAR(200), CONTINENT VARCHAR(200), CAPITAL_CITY VARCHAR(200), TIME_ZONE VARCHAR(200), GDP DOUBLE, POPULATION INTEGER, IS_EU BIT, IS_OECD BIT)
    Table CALENDAR (CALENDAR_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), CALENDAR_TYPE VARCHAR(200), YEAR INTEGER, NUMBER_OF_HOLIDAYS INTEGER, IS_ACTIVE BIT, SOURCE VARCHAR(200), LAST_UPDATED DATE, DESCRIPTION VARCHAR(200), TIMEZONE VARCHAR(200), COUNTRY_ID VARCHAR(200))
    Table RATING (RATING_ID VARCHAR(200) PRIMARY KEY, AGENCY VARCHAR(200), RATING_VALUE VARCHAR(200), RATING_DATE DATE, OUTLOOK VARCHAR(200), WATCH_STATUS VARCHAR(200), IS_INVESTMENT_GRADE BIT, PREVIOUS_RATING VARCHAR(200), PREVIOUS_DATE DATE, RATING_TYPE VARCHAR(200), SECTOR VARCHAR(200), ISSUER_ID VARCHAR(200))
    Table INDEX (INDEX_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), TICKER VARCHAR(200), PROVIDER VARCHAR(200), ASSET_CLASS VARCHAR(200), GEOGRAPHY VARCHAR(200), CURRENCY VARCHAR(200), NUMBER_OF_CONSTITUENTS INTEGER, LAUNCH_DATE DATE, REBALANCE_FREQUENCY VARCHAR(200), METHODOLOGY VARCHAR(200), LAST_LEVEL DOUBLE, LAST_LEVEL_DATE DATE)
    Table INDEX_CONSTITUENT (CONSTITUENT_ID VARCHAR(200) PRIMARY KEY, EFFECTIVE_DATE DATE, WEIGHT DOUBLE, SHARES_HELD DOUBLE, MARKET_CAP DOUBLE, FREE_FLOAT_FACTOR DOUBLE, ADDED_DATE DATE, REMOVED_DATE DATE, IS_ACTIVE BIT, SECTOR VARCHAR(200), INDEX_ID VARCHAR(200))

    Join Sector_Industry(INDUSTRY.SECTOR_ID = SECTOR.SECTOR_ID)
    Join Country_Exchange(EXCHANGE.COUNTRY_ID = COUNTRY.COUNTRY_CODE)
    Join Issuer_Country(ISSUER.COUNTRY_ID = COUNTRY.COUNTRY_CODE)
    Join Index_IndexConstituent(INDEX_CONSTITUENT.INDEX_ID = INDEX.INDEX_ID)
    Join Rating_Issuer(RATING.ISSUER_ID = ISSUER.ISSUER_ID)
    Join Calendar_Country(CALENDAR.COUNTRY_ID = COUNTRY.COUNTRY_CODE)
    Join Currency_Country(CURRENCY.COUNTRY_ID = COUNTRY.COUNTRY_CODE)

    // ---- from 33-counterparty-store.pure ----
    Table COUNTERPARTY (COUNTERPARTY_ID VARCHAR(200) PRIMARY KEY, LEGAL_NAME VARCHAR(200), SHORT_NAME VARCHAR(200), LEI VARCHAR(200), COUNTERPARTY_TYPE VARCHAR(200), DOMICILE VARCHAR(200), INCORPORATION_COUNTRY VARCHAR(200), IS_ACTIVE BIT, ONBOARD_DATE DATE, CREDIT_RATING VARCHAR(200), RATING_AGENCY VARCHAR(200), TIER VARCHAR(200), PARENT_ENTITY_ID VARCHAR(200), INDUSTRY VARCHAR(200), WEBSITE VARCHAR(200), CLASSIFICATION_ID VARCHAR(200), COUNTRY_CODE VARCHAR(200))
    Table CONTACT (CONTACT_ID VARCHAR(200) PRIMARY KEY, FIRST_NAME VARCHAR(200), LAST_NAME VARCHAR(200), EMAIL VARCHAR(200), PHONE VARCHAR(200), ROLE VARCHAR(200), DEPARTMENT VARCHAR(200), IS_PRIMARY BIT, IS_ACTIVE BIT, LAST_CONTACT_DATE DATE, PREFERRED_CHANNEL VARCHAR(200), TITLE VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table CREDIT_RATING (RATING_ID VARCHAR(200) PRIMARY KEY, AGENCY VARCHAR(200), LONG_TERM_RATING VARCHAR(200), SHORT_TERM_RATING VARCHAR(200), OUTLOOK VARCHAR(200), RATING_DATE DATE, PREVIOUS_RATING VARCHAR(200), PREVIOUS_DATE DATE, WATCH_STATUS VARCHAR(200), IS_INVESTMENT_GRADE BIT, REVIEW_DATE DATE, ANALYST_NAME VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table AGREEMENT (AGREEMENT_ID VARCHAR(200) PRIMARY KEY, AGREEMENT_TYPE VARCHAR(200), EFFECTIVE_DATE DATE, TERMINATION_DATE DATE, GOVERNING_LAW VARCHAR(200), STATUS VARCHAR(200), VERSION INTEGER, SIGNED_DATE DATE, LAST_AMEND_DATE DATE, THRESHOLD DOUBLE, MINIMUM_TRANSFER_AMOUNT DOUBLE, INDEPENDENT_AMOUNT DOUBLE, CURRENCY VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table CLASSIFICATION (CLASSIFICATION_ID VARCHAR(200) PRIMARY KEY, CLASSIFICATION_TYPE VARCHAR(200), MIFID_CLASSIFICATION VARCHAR(200), DODDF_FRANK_CLASSIFICATION VARCHAR(200), EMIR_CLASSIFICATION VARCHAR(200), IS_FINANCIAL_COUNTERPARTY BIT, IS_SMALL_FINANCIAL BIT, EFFECTIVE_DATE DATE, REVIEW_DATE DATE, APPROVED_BY VARCHAR(200), NOTES VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table ACCOUNT (ACCOUNT_ID VARCHAR(200) PRIMARY KEY, ACCOUNT_NAME VARCHAR(200), ACCOUNT_TYPE VARCHAR(200), CURRENCY VARCHAR(200), STATUS VARCHAR(200), OPEN_DATE DATE, CLOSE_DATE DATE, CUSTODIAN VARCHAR(200), BROKER_ID VARCHAR(200), CLEARING_MEMBER_ID VARCHAR(200), MARGIN_TYPE VARCHAR(200), IS_SEGREGATED BIT, COUNTERPARTY_ID VARCHAR(200))
    Table BENEFICIAL_OWNER (OWNER_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), OWNERSHIP_PERCENTAGE DOUBLE, NATIONALITY VARCHAR(200), DATE_OF_BIRTH DATE, IS_PEP BIT, IS_VERIFIED BIT, VERIFICATION_DATE DATE, ID_TYPE VARCHAR(200), ID_NUMBER VARCHAR(200), ADDRESS VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table COUNTERPARTY_LIMIT (LIMIT_ID VARCHAR(200) PRIMARY KEY, LIMIT_TYPE VARCHAR(200), LIMIT_AMOUNT DOUBLE, CURRENT_UTILIZATION DOUBLE, UTILIZATION_PCT DOUBLE, CURRENCY VARCHAR(200), EFFECTIVE_DATE DATE, EXPIRY_DATE DATE, STATUS VARCHAR(200), APPROVED_BY VARCHAR(200), APPROVAL_DATE DATE, BREACH_COUNT INTEGER, COUNTERPARTY_ID VARCHAR(200))
    Table KYCRECORD (KYC_ID VARCHAR(200) PRIMARY KEY, STATUS VARCHAR(200), RISK_RATING VARCHAR(200), DUE_DILIGENCE_LEVEL VARCHAR(200), LAST_REVIEW_DATE DATE, NEXT_REVIEW_DATE DATE, REVIEWED_BY VARCHAR(200), APPROVED_BY VARCHAR(200), APPROVAL_DATE DATE, DOCUMENT_COUNT INTEGER, IS_COMPLETE BIT, EXPIRY_DATE DATE, NOTES VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table SANCTIONS_CHECK (CHECK_ID VARCHAR(200) PRIMARY KEY, CHECK_DATE TIMESTAMP, SCREENING_PROVIDER VARCHAR(200), RESULT VARCHAR(200), MATCH_COUNT INTEGER, FALSE_POSITIVE_COUNT INTEGER, TRUE_MATCH_COUNT INTEGER, STATUS VARCHAR(200), RESOLVED_DATE TIMESTAMP, RESOLVED_BY VARCHAR(200), LIST_CHECKED VARCHAR(200), IS_CLEARED BIT, COUNTERPARTY_ID VARCHAR(200))

    Join Counterparty_Contact(CONTACT.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_CreditRating(CREDIT_RATING.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_Agreement(AGREEMENT.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_Classification(CLASSIFICATION.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_Account(ACCOUNT.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_BeneficialOwner(BENEFICIAL_OWNER.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_CounterpartyLimit(COUNTERPARTY_LIMIT.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_KYC(KYCRECORD.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_SanctionsCheck(SANCTIONS_CHECK.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)

    // ---- from 34-org-store.pure ----
    Table DESK (DESK_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), DESK_TYPE VARCHAR(200), ASSET_CLASS VARCHAR(200), REGION VARCHAR(200), IS_ACTIVE BIT, HEAD_TRADER VARCHAR(200), COST_CENTER VARCHAR(200), FLOOR VARCHAR(200), BUILDING VARCHAR(200), PHONE VARCHAR(200), RISK_LIMIT DOUBLE, PNL_TARGET DOUBLE, BUSINESS_UNIT_ID VARCHAR(200))
    Table TRADER (TRADER_ID VARCHAR(200) PRIMARY KEY, FIRST_NAME VARCHAR(200), LAST_NAME VARCHAR(200), BADGE VARCHAR(200), EMAIL VARCHAR(200), HIRE_DATE DATE, SENIORITY VARCHAR(200), IS_ACTIVE BIT, SPECIALIZATION VARCHAR(200), LICENSE VARCHAR(200), MAX_NOTIONAL DOUBLE, PNL_YTD DOUBLE, PHONE VARCHAR(200), DESK_ID VARCHAR(200), MANAGER_ID VARCHAR(200))
    Table PORTFOLIO_MANAGER (PM_ID VARCHAR(200) PRIMARY KEY, FIRST_NAME VARCHAR(200), LAST_NAME VARCHAR(200), EMAIL VARCHAR(200), STRATEGY VARCHAR(200), AUM DOUBLE, HIRE_DATE DATE, IS_ACTIVE BIT, PERFORMANCE_YTD DOUBLE, BENCHMARK VARCHAR(200), RISK_BUDGET DOUBLE, INVESTMENT_STYLE VARCHAR(200), CFA BIT, DESK_ID VARCHAR(200))
    Table BUSINESS_UNIT (BU_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), HEAD VARCHAR(200), DIVISION VARCHAR(200), IS_ACTIVE BIT, HEADCOUNT INTEGER, BUDGET DOUBLE, COST_CENTER VARCHAR(200), REGION VARCHAR(200), ESTABLISHED_DATE DATE, DESCRIPTION VARCHAR(200), LEGAL_ENTITY_ID VARCHAR(200))
    Table LEGAL_ENTITY (LE_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), JURISDICTION VARCHAR(200), LEI VARCHAR(200), ENTITY_TYPE VARCHAR(200), INCORPORATION_DATE DATE, REGISTRATION_NUMBER VARCHAR(200), REGULATORY_STATUS VARCHAR(200), IS_ACTIVE BIT, CAPITAL_BASE DOUBLE, PARENT_ENTITY_ID VARCHAR(200), TAX_ID VARCHAR(200), REGION_ID VARCHAR(200))
    Table REGION (REGION_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), CODE VARCHAR(200), TIMEZONE VARCHAR(200), HEAD_OF_REGION VARCHAR(200), IS_ACTIVE BIT, HEADCOUNT INTEGER, REVENUE_TARGET DOUBLE, COST_TARGET DOUBLE, DESCRIPTION VARCHAR(200))
    Table COST_CENTER (COST_CENTER_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), DEPARTMENT VARCHAR(200), BUDGET_AMOUNT DOUBLE, SPENT_AMOUNT DOUBLE, REMAINING_AMOUNT DOUBLE, FISCAL_YEAR INTEGER, MANAGER VARCHAR(200), IS_ACTIVE BIT, APPROVAL_THRESHOLD DOUBLE, CURRENCY VARCHAR(200))
    Table DEPARTMENT (DEPARTMENT_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), HEAD VARCHAR(200), HEADCOUNT INTEGER, IS_ACTIVE BIT, BUDGET DOUBLE, FLOOR VARCHAR(200), BUILDING VARCHAR(200), PHONE VARCHAR(200), ESTABLISHED_DATE DATE, PARENT_DEPARTMENT_ID VARCHAR(200), COST_CENTER_ID VARCHAR(200), BUSINESS_UNIT_ID VARCHAR(200))
    Table TEAM (TEAM_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), LEAD VARCHAR(200), TEAM_SIZE INTEGER, IS_ACTIVE BIT, FOCUS VARCHAR(200), FORMATION_DATE DATE, OBJECTIVE VARCHAR(200), PERFORMANCE_RATING DOUBLE, SLACK_CHANNEL VARCHAR(200), DEPARTMENT_ID VARCHAR(200))
    Table APPROVER (APPROVER_ID VARCHAR(200) PRIMARY KEY, FIRST_NAME VARCHAR(200), LAST_NAME VARCHAR(200), EMAIL VARCHAR(200), APPROVAL_LEVEL INTEGER, MAX_APPROVAL_AMOUNT DOUBLE, DEPARTMENT VARCHAR(200), IS_ACTIVE BIT, DELEGATE_TO VARCHAR(200), TITLE VARCHAR(200), CURRENCY VARCHAR(200), TEAM_ID VARCHAR(200))

    Join Desk_Trader(TRADER.DESK_ID = DESK.DESK_ID)
    Join Desk_BusinessUnit(DESK.BUSINESS_UNIT_ID = BUSINESS_UNIT.BU_ID)
    Join BusinessUnit_LegalEntity(BUSINESS_UNIT.LEGAL_ENTITY_ID = LEGAL_ENTITY.LE_ID)
    Join LegalEntity_Region(LEGAL_ENTITY.REGION_ID = REGION.REGION_ID)
    Join Department_Team(TEAM.DEPARTMENT_ID = DEPARTMENT.DEPARTMENT_ID)
    Join Department_CostCenter(DEPARTMENT.COST_CENTER_ID = COST_CENTER.COST_CENTER_ID)
    Join BusinessUnit_Department(DEPARTMENT.BUSINESS_UNIT_ID = BUSINESS_UNIT.BU_ID)
    Join Team_Approver(APPROVER.TEAM_ID = TEAM.TEAM_ID)

    // ---- from 35-positions-store.pure ----
    Table BOOK (BOOK_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200) NOT NULL, BOOK_TYPE VARCHAR(200), CURRENCY VARCHAR(200) NOT NULL, IS_ACTIVE BIT, OPEN_DATE DATE, CLOSE_DATE DATE, LEGAL_ENTITY VARCHAR(200), STRATEGY VARCHAR(200), PNL_YTD DOUBLE, POSITION_COUNT INTEGER, RISK_LIMIT DOUBLE, DESCRIPTION VARCHAR(200), DESK_ID VARCHAR(200))
    Table POSITION (POSITION_ID VARCHAR(200) PRIMARY KEY, QUANTITY DOUBLE, AVERAGE_COST DOUBLE, MARKET_VALUE DOUBLE, UNREALIZED_PN_L DOUBLE, REALIZED_PN_L DOUBLE, CURRENCY VARCHAR(200), POSITION_DATE DATE, DIRECTION VARCHAR(200), COST_BASIS DOUBLE, ACCRUED_INTEREST DOUBLE, LAST_UPDATED TIMESTAMP, IS_OPEN BIT, SETTLEMENT_DATE DATE, BOOK_ID VARCHAR(200), PORTFOLIO_ID VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table PORTFOLIO (PORTFOLIO_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), STRATEGY VARCHAR(200), INCEPTION DATE, AUM DOUBLE, CURRENCY VARCHAR(200), BENCHMARK VARCHAR(200), IS_ACTIVE BIT, NAV DOUBLE, NAV_DATE DATE, RETURN_YTD DOUBLE, RETURN_MTD DOUBLE, SHARPE_RATIO DOUBLE, MAX_DRAWDOWN DOUBLE, PM_ID VARCHAR(200))
    Table CASH_BALANCE (BALANCE_ID VARCHAR(200) PRIMARY KEY, BALANCE DOUBLE, CURRENCY VARCHAR(200), BALANCE_DATE DATE, BALANCE_TYPE VARCHAR(200), ACCOUNT_ID VARCHAR(200), AVAILABLE_BALANCE DOUBLE, PENDING_AMOUNT DOUBLE, IS_OVERDRAWN BIT, OVERDRAFT_LIMIT DOUBLE, LAST_UPDATED TIMESTAMP, BOOK_ID VARCHAR(200))
    Table INVENTORY (INVENTORY_ID VARCHAR(200) PRIMARY KEY, AVAILABLE_QUANTITY DOUBLE, LOCKED_QUANTITY DOUBLE, BORROWED_QUANTITY DOUBLE, LENT_QUANTITY DOUBLE, TOTAL_QUANTITY DOUBLE, INVENTORY_DATE DATE, SOURCE VARCHAR(200), LOCATION_TYPE VARCHAR(200), IS_SETTLED BIT, LAST_UPDATED TIMESTAMP, CUSTODIAN VARCHAR(200), BOOK_ID VARCHAR(200))
    Table LOT_POSITION (LOT_ID VARCHAR(200) PRIMARY KEY, QUANTITY DOUBLE, COST_PRICE DOUBLE, COST_BASIS DOUBLE, ACQUIRE_DATE DATE, LOT_TYPE VARCHAR(200), IS_OPEN BIT, CLOSE_DATE DATE, CLOSE_PRICE DOUBLE, REALIZED_GAIN DOUBLE, HOLDING_PERIOD INTEGER, TAX_METHOD VARCHAR(200), POSITION_ID VARCHAR(200))
    Table BOOK_TRANSFER (TRANSFER_ID VARCHAR(200) PRIMARY KEY, FROM_BOOK_ID VARCHAR(200), TO_BOOK_ID VARCHAR(200), QUANTITY DOUBLE, PRICE DOUBLE, TRANSFER_DATE DATE, REASON VARCHAR(200), STATUS VARCHAR(200), APPROVED_BY VARCHAR(200), APPROVAL_DATE DATE, CURRENCY VARCHAR(200), NOTIONAL DOUBLE, SOURCE_BOOK_ID VARCHAR(200))
    Table POSITION_BREAK (BREAK_ID VARCHAR(200) PRIMARY KEY, BREAK_TYPE VARCHAR(200), EXPECTED_QUANTITY DOUBLE, ACTUAL_QUANTITY DOUBLE, DIFFERENCE DOUBLE, BREAK_DATE DATE, STATUS VARCHAR(200), PRIORITY VARCHAR(200), ASSIGNED_TO VARCHAR(200), RESOLVED_DATE DATE, RESOLUTION VARCHAR(200), AGE_IN_DAYS INTEGER, POSITION_ID VARCHAR(200))
    Table RECONCILIATION_ITEM (RECON_ID VARCHAR(200) PRIMARY KEY, SOURCE VARCHAR(200), TARGET VARCHAR(200), SOURCE_VALUE DOUBLE, TARGET_VALUE DOUBLE, DIFFERENCE DOUBLE, RECON_DATE DATE, STATUS VARCHAR(200), MATCH_TYPE VARCHAR(200), IS_MATCHED BIT, COMMENT VARCHAR(200), RESOLVED_BY VARCHAR(200), POSITION_ID VARCHAR(200))
    Table POSITION_SNAPSHOT (SNAPSHOT_ID VARCHAR(200) PRIMARY KEY, SNAPSHOT_DATE DATE, SNAPSHOT_TIME TIMESTAMP, QUANTITY DOUBLE, MARKET_VALUE DOUBLE, UNREALIZED_PN_L DOUBLE, COST_BASIS DOUBLE, CURRENCY VARCHAR(200), SOURCE VARCHAR(200), IS_EOD BIT, VERSION INTEGER, POSITION_ID VARCHAR(200))

    Join Position_Book(POSITION.BOOK_ID = BOOK.BOOK_ID)
    Join Portfolio_Position(POSITION.PORTFOLIO_ID = PORTFOLIO.PORTFOLIO_ID)
    Join CashBalance_Book(CASH_BALANCE.BOOK_ID = BOOK.BOOK_ID)
    Join Inventory_Book(INVENTORY.BOOK_ID = BOOK.BOOK_ID)
    Join LotPosition_Position(LOT_POSITION.POSITION_ID = POSITION.POSITION_ID)
    Join BookTransfer_Book(BOOK_TRANSFER.SOURCE_BOOK_ID = BOOK.BOOK_ID)
    Join PositionBreak_Position(POSITION_BREAK.POSITION_ID = POSITION.POSITION_ID)
    Join ReconciliationItem_Position(RECONCILIATION_ITEM.POSITION_ID = POSITION.POSITION_ID)
    Join PositionSnapshot_Position(POSITION_SNAPSHOT.POSITION_ID = POSITION.POSITION_ID)

    // ---- L5: a real pre-aggregated table, for AggregationAware ----
    // Unlike NOTIONAL_BY_BOOK (a Legend View, which the engine inlines as a GROUP BY),
    // this is a PHYSICAL table a warehouse job would populate overnight. An
    // AggregationAware mapping lets a query hit it INSTEAD of the detail table when the
    // query's shape matches -- same answer, far less work.
    //
    // Its rows are derived from TRADE by scripts/corpus/aggregate.py, so detail and
    // aggregate agree by construction. A hand-written aggregate that disagreed would make
    // "which table did it read" observable, but would also mean the corpus asserts
    // something false; the SQL is inspected instead.
    Table TRADE_BY_BOOK (BOOK_ID VARCHAR(200) PRIMARY KEY, TOTAL_NOTIONAL DOUBLE, TRADE_COUNT INTEGER)

    // ---- L4: the rollup View ----
    // Notional by book — the standard warehouse rollup, and the thing a risk report
    // actually reads. This is a Legend View, not a database view: no DDL is created for
    // it, the engine inlines the GROUP BY into the query it generates.
    //
    // Worth contrasting with F2_BookChildCounts, which counts trades per book by OUTER
    // JOINING from BOOK. That returns a row for BK-LEGACY with a count. This groups the
    // TRADE table, so BK-LEGACY -- which has no trades -- produces NO GROUP AT ALL and is
    // simply absent. Two defensible answers to "trades per book" that differ on exactly
    // the empty case, both asserted.
    View NOTIONAL_BY_BOOK
    (
      ~groupBy
      (
        TRADE.BOOK_ID
      )
      BOOK_ID: TRADE.BOOK_ID PRIMARY KEY,
      TRADE_COUNT: count(TRADE.TRADE_ID),
      TOTAL_NOTIONAL: sum(TRADE.NOTIONAL),
      MAX_NOTIONAL: max(TRADE.NOTIONAL)
    )

    // ---- L3b: BITEMPORAL reference data ----
    // Business time answers "when was this true?"; processing time answers "when did we
    // BELIEVE it?". Both together answer the question a regulator actually asks: what did
    // we know on date P about date B -- and, crucially, what did a CORRECTION change.
    //
    // Both specs live in one milestoning block, comma-separated, and their predicates AND
    // together. The primary key spans the entity plus BOTH from-columns.
    Table INSTR_RATING_BI
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z, INFINITY_DATE = %9999-12-31),
        processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31)
      )
      INSTRUMENT_ID VARCHAR(200) PRIMARY KEY,
      FROM_Z DATE PRIMARY KEY,
      IN_Z DATE PRIMARY KEY,
      THRU_Z DATE,
      OUT_Z DATE,
      CREDIT_RATING VARCHAR(20),
      SOURCE VARCHAR(50)
    )

    // ---- L4: the partitioned trade history ----
    // Real trade stores are partitioned; this one splits by asset class, which is the
    // shape that survives when a firm's rates and equities businesses run on different
    // platforms. The three partitions are UNIONED back into one class by an Operation
    // mapping, and TRADE_FX is deliberately EMPTY -- a union leg contributing no rows is
    // the case that breaks naive union implementations.
    //
    // Contents are DERIVED from TRADE by scripts/corpus/partition.py, so
    // HistTrade.all() and Trade.all() must return the same rows by construction.
    Table TRADE_EQ (TRADE_ID VARCHAR(200) PRIMARY KEY, TRADE_DATE DATE, QUANTITY DOUBLE, PRICE DOUBLE, NOTIONAL DOUBLE, SIDE VARCHAR(200), STATUS VARCHAR(200), CURRENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table TRADE_RATES (TRADE_ID VARCHAR(200) PRIMARY KEY, TRADE_DATE DATE, QUANTITY DOUBLE, PRICE DOUBLE, NOTIONAL DOUBLE, SIDE VARCHAR(200), STATUS VARCHAR(200), CURRENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table TRADE_FX (TRADE_ID VARCHAR(200) PRIMARY KEY, TRADE_DATE DATE, QUANTITY DOUBLE, PRICE DOUBLE, NOTIONAL DOUBLE, SIDE VARCHAR(200), STATUS VARCHAR(200), CURRENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))

    // ---- L5: partially-denormalized reporting table, for Otherwise ----
    // The realistic shape Otherwise exists for: a reporting table CACHES the counterparty
    // inline, but the cache is not always populated. CPTY_FK is always present; the two
    // CPTY_*_INLINE columns are blank for some rows. An Otherwise mapping uses the inline
    // columns when they are there and falls back to a real join when they are not, so the
    // answer is complete either way.
    //
    // The embedded block's ~primaryKey is what decides "is the inline data present" --
    // it must be a column that is NULL exactly when the cache is empty, which is why the
    // fallback FK is a SEPARATE column.
    Table TRADE_FLAT_PARTIAL (TRADE_ID VARCHAR(200) PRIMARY KEY, NOTIONAL DOUBLE, STATUS VARCHAR(200), CPTY_FK VARCHAR(200), CPTY_ID_INLINE VARCHAR(200), CPTY_NAME_INLINE VARCHAR(200), CPTY_LEI_INLINE VARCHAR(200))

    // ---- Reference-data taxonomies: corporate actions, securities, order tickets ----
    Table CA_EVENT (ACTION_ID VARCHAR(60) PRIMARY KEY, ACTION_TYPE VARCHAR(60), SECURITY_ID VARCHAR(60), ANNOUNCED_DATE DATE, EX_DATE DATE, RECORD_DATE DATE, PAY_DATE DATE, STATUS VARCHAR(60), IS_MANDATORY BIT, CASH_RATE DECIMAL(18,4), RATIO_OLD INTEGER, RATIO_NEW INTEGER, CURRENCY VARCHAR(60))

    Table SECURITY_MASTER (SECURITY_KEY VARCHAR(60) PRIMARY KEY, SECURITY_TYPE VARCHAR(60), DESCRIPTION VARCHAR(60), ISSUER_NAME VARCHAR(60), CURRENCY VARCHAR(60), ISSUE_DATE DATE, MATURITY_DATE DATE, FACE_VALUE DECIMAL(18,4), IS_LISTED BIT, EXCHANGE_MIC VARCHAR(60), ASSET_CLASS VARCHAR(60))

    Table ORDER_TICKET (TICKET_ID VARCHAR(60) PRIMARY KEY, ORDER_TYPE VARCHAR(60), SECURITY_ID VARCHAR(60), SIDE VARCHAR(60), QUANTITY INTEGER, LIMIT_PRICE DECIMAL(18,4), TIME_IN_FORCE VARCHAR(60), VENUE VARCHAR(60), PLACED_AT TIMESTAMP, STATUS VARCHAR(60), FILLED_QUANTITY INTEGER, TRADER_ID VARCHAR(60))

    Table COLLATERAL_TYPE_HOLDING (HOLDING_ID VARCHAR(60) PRIMARY KEY, COLLATERAL_TYPE VARCHAR(60), COUNTERPARTY_ID VARCHAR(60), MARKET_VALUE DECIMAL(18,4), HAIRCUT_PCT DECIMAL(18,4), CURRENCY VARCHAR(60), VALUATION_DATE DATE, IS_ELIGIBLE BIT, CUSTODIAN VARCHAR(60), MATURITY_DATE DATE)

    Table REG_SUBMISSION (SUBMISSION_ID VARCHAR(60) PRIMARY KEY, REPORT_TYPE VARCHAR(60), REGIME VARCHAR(60), AUTHORITY VARCHAR(60), REPORTING_DATE DATE, SUBMITTED_AT TIMESTAMP, RECORD_COUNT INTEGER, STATUS VARCHAR(60), ACKNOWLEDGED_AT TIMESTAMP, REJECTION_REASON VARCHAR(60), IS_LATE BIT)

    Table RISK_LIMIT_DEF (LIMIT_ID VARCHAR(60) PRIMARY KEY, LIMIT_TYPE VARCHAR(60), SCOPE VARCHAR(60), SCOPE_VALUE VARCHAR(60), LIMIT_AMOUNT DECIMAL(18,4), UTILISATION DECIMAL(18,4), CURRENCY VARCHAR(60), EFFECTIVE_FROM DATE, APPROVED_BY VARCHAR(60), BREACHED_ON DATE, IS_HARD BIT)

    Table ACCOUNT_REGISTER (ACCOUNT_ID VARCHAR(60) PRIMARY KEY, ACCOUNT_TYPE VARCHAR(60), ACCOUNT_NAME VARCHAR(60), CURRENCY VARCHAR(60), BALANCE DECIMAL(18,4), OPENED_ON DATE, IS_SEGREGATED BIT, OWNER_ID VARCHAR(60), CUSTODIAN VARCHAR(60), CLOSED_ON DATE)

    Table FEE_CHARGE (CHARGE_ID VARCHAR(60) PRIMARY KEY, FEE_TYPE VARCHAR(60), COUNTERPARTY_ID VARCHAR(60), GROSS_AMOUNT DECIMAL(18,4), TAX_AMOUNT DECIMAL(18,4), CURRENCY VARCHAR(60), CHARGED_ON DATE, IS_REBATABLE BIT, INVOICE_REF VARCHAR(60), BASIS_POINTS DECIMAL(18,4))

    Table MARKET_DATA_POINT (POINT_ID VARCHAR(60) PRIMARY KEY, DATA_TYPE VARCHAR(60), INSTRUMENT_REF VARCHAR(60), COB_DATE DATE, VALUE DECIMAL(18,4), CURRENCY VARCHAR(60), SOURCE VARCHAR(60), IS_STALE BIT, TENOR VARCHAR(60), PREVIOUS_VALUE DECIMAL(18,4))

    Table SEC_LENDING_TRADE (LOAN_ID VARCHAR(60) PRIMARY KEY, LOAN_TYPE VARCHAR(60), SECURITY_ID VARCHAR(60), COUNTERPARTY_ID VARCHAR(60), QUANTITY INTEGER, LOAN_VALUE DECIMAL(18,4), FEE_RATE_BP DECIMAL(18,4), START_DATE DATE, IS_OPEN BIT, END_DATE DATE)

    Table KYC_CHECK (CHECK_ID VARCHAR(60) PRIMARY KEY, CHECK_TYPE VARCHAR(60), ENTITY_ID VARCHAR(60), PERFORMED_ON DATE, OUTCOME VARCHAR(60), RISK_RATING VARCHAR(60), PERFORMED_BY VARCHAR(60), IS_BLOCKING BIT, EXPIRES_ON DATE, FINDINGS VARCHAR(60))

    Table LEDGER_ENTRY (ENTRY_ID VARCHAR(60) PRIMARY KEY, ENTRY_TYPE VARCHAR(60), ACCOUNT_CODE VARCHAR(60), DEBIT_AMOUNT DECIMAL(18,4), CREDIT_AMOUNT DECIMAL(18,4), CURRENCY VARCHAR(60), POSTING_DATE DATE, IS_REVERSAL BIT, SOURCE_REF VARCHAR(60), PREPARED_BY VARCHAR(60))

    Table VALUATION_MODEL_RUN (RUN_ID VARCHAR(60) PRIMARY KEY, MODEL_TYPE VARCHAR(60), INSTRUMENT_REF VARCHAR(60), COB_DATE DATE, PRESENT_VALUE DECIMAL(18,4), CURRENCY VARCHAR(60), ELAPSED_MS INTEGER, MODEL_VERSION VARCHAR(60), IS_APPROVED BIT, CALIBRATION_ERROR DECIMAL(18,4))

    Table PROCESSING_EXCEPTION (EXCEPTION_ID VARCHAR(60) PRIMARY KEY, EXCEPTION_TYPE VARCHAR(60), SOURCE_SYSTEM VARCHAR(60), SEVERITY VARCHAR(60), RAISED_AT TIMESTAMP, ENTITY_REF VARCHAR(60), STATUS VARCHAR(60), IS_AUTO_RETRIED BIT, RESOLVED_AT TIMESTAMP, MESSAGE VARCHAR(60))

    Table LEGAL_DOCUMENT (DOCUMENT_ID VARCHAR(60) PRIMARY KEY, DOCUMENT_TYPE VARCHAR(60), COUNTERPARTY_ID VARCHAR(60), EXECUTED_ON DATE, GOVERNING_LAW VARCHAR(60), STATUS VARCHAR(60), VERSION VARCHAR(60), IS_EXECUTED BIT, EXPIRES_ON DATE, CUSTODY_REF VARCHAR(60))

    Table CLIENT_ENTITY (CLIENT_ID VARCHAR(60) PRIMARY KEY, CLIENT_TYPE VARCHAR(60), LEGAL_NAME VARCHAR(60), DOMICILE VARCHAR(60), CLASSIFICATION VARCHAR(60), ONBOARDED_ON DATE, AUM_USD DECIMAL(18,4), IS_ACTIVE BIT, LEI VARCHAR(60), TERMINATED_ON DATE)

    Table TRADING_VENUE (VENUE_ID VARCHAR(60) PRIMARY KEY, VENUE_TYPE VARCHAR(60), VENUE_NAME VARCHAR(60), MIC VARCHAR(60), COUNTRY VARCHAR(60), TIMEZONE VARCHAR(60), IS_ACTIVE BIT, DAILY_VOLUME_USD DECIMAL(18,4), OPERATOR VARCHAR(60), CLOSES_AT VARCHAR(60))

    Table LIQUIDITY_METRIC (METRIC_ID VARCHAR(60) PRIMARY KEY, METRIC_TYPE VARCHAR(60), COB_DATE DATE, ENTITY VARCHAR(60), VALUE DECIMAL(18,4), REGULATORY_MINIMUM DECIMAL(18,4), CURRENCY VARCHAR(60), IS_BREACHED BIT, HORIZON_DAYS INTEGER, COMMENTARY VARCHAR(60))

    Table BENCHMARK_INDEX (INDEX_ID VARCHAR(60) PRIMARY KEY, INDEX_TYPE VARCHAR(60), INDEX_NAME VARCHAR(60), ASSET_CLASS VARCHAR(60), CURRENCY VARCHAR(60), WEIGHTING_SCHEME VARCHAR(60), LEVEL DECIMAL(18,4), CONSTITUENT_COUNT INTEGER, PROVIDER VARCHAR(60), PREVIOUS_LEVEL DECIMAL(18,4))

    Table TAX_REGIME_APPLICATION (APPLICATION_ID VARCHAR(60) PRIMARY KEY, REGIME_TYPE VARCHAR(60), JURISDICTION VARCHAR(60), COUNTERPARTY_ID VARCHAR(60), GROSS_AMOUNT DECIMAL(18,4), TAX_RATE_PCT DECIMAL(18,4), TAX_WITHHELD DECIMAL(18,4), CURRENCY VARCHAR(60), APPLIED_ON DATE, RECLAIMABLE_AMOUNT DECIMAL(18,4))

    Table PORTFOLIO_REGISTER (PORTFOLIO_ID VARCHAR(60) PRIMARY KEY, PORTFOLIO_TYPE VARCHAR(60), PORTFOLIO_NAME VARCHAR(60), BASE_CURRENCY VARCHAR(60), NAV_USD DECIMAL(18,4), INCEPTION_DATE DATE, BENCHMARK_ID VARCHAR(60), IS_ACTIVE BIT, MANAGER_ID VARCHAR(60), CLOSED_ON DATE)

    Table CUSTODY_INSTRUCTION (INSTRUCTION_ID VARCHAR(60) PRIMARY KEY, INSTRUCTION_TYPE VARCHAR(60), ACCOUNT_ID VARCHAR(60), SECURITY_ID VARCHAR(60), QUANTITY INTEGER, VALUE_DATE DATE, STATUS VARCHAR(60), CUSTODIAN VARCHAR(60), IS_URGENT BIT, SETTLED_ON DATE)

    Table ESG_METRIC (METRIC_ID VARCHAR(60) PRIMARY KEY, METRIC_TYPE VARCHAR(60), ISSUER_ID VARCHAR(60), REPORTING_YEAR INTEGER, VALUE DECIMAL(18,4), UNIT VARCHAR(60), DATA_SOURCE VARCHAR(60), IS_ESTIMATED BIT, ASSURANCE_LEVEL VARCHAR(60), PEER_MEDIAN DECIMAL(18,4))

    Table INBOUND_MESSAGE (MESSAGE_ID VARCHAR(60) PRIMARY KEY, MESSAGE_TYPE VARCHAR(60), PROTOCOL VARCHAR(60), SENDER_BIC VARCHAR(60), RECEIVED_AT TIMESTAMP, BYTE_COUNT INTEGER, STATUS VARCHAR(60), IS_DUPLICATE BIT, PARSED_AT TIMESTAMP, ERROR_DETAIL VARCHAR(60))

    Table PRICE_SOURCE_RECORD (RECORD_ID VARCHAR(60) PRIMARY KEY, SOURCE_TYPE VARCHAR(60), INSTRUMENT_REF VARCHAR(60), COB_DATE DATE, PRICE DECIMAL(18,4), CURRENCY VARCHAR(60), CONFIDENCE_SCORE DECIMAL(18,4), IS_PRIMARY BIT, CONTRIBUTOR_COUNT INTEGER, CHALLENGED_BY VARCHAR(60))

    // emitted by refdata for margincalls
    Table MGN_CALL (CALL_ID VARCHAR(60) PRIMARY KEY, CALL_TYPE VARCHAR(60), COUNTERPARTY_ID VARCHAR(60), CALL_AMOUNT DECIMAL(18,4), AGREED_AMOUNT DECIMAL(18,4), CURRENCY VARCHAR(60), CALLED_ON DATE, STATUS VARCHAR(60), IS_DISPUTED BIT, SETTLED_ON DATE)

    // ---- The brokerage schedule, versioned ----
    Table BROKERAGE_TIER_MS
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z, INFINITY_DATE = %9999-12-31)
      )
      TIER_ID VARCHAR(20) PRIMARY KEY,
      FROM_Z DATE PRIMARY KEY,
      THRU_Z DATE,
      TIER_NAME VARCHAR(30),
      MIN_NOTIONAL DECIMAL(18,2),
      MAX_NOTIONAL DECIMAL(18,2),
      BPS_RATE DECIMAL(18,4),
      MINIMUM_FEE DECIMAL(18,2)
    )

    // One pricing instruction per trade: the pair, date and rate type to value it at.
    Table PROJECTLINK_TRADE_FX (TRADE_ID VARCHAR(200) PRIMARY KEY, PAIR_CODE VARCHAR(6), COB_DATE DATE, RATE_TYPE VARCHAR(10))

    // ---- Large exposures: a SCHEMA, and four datatypes nothing had declared ----
    //
    // A regulatory extract is not a trading table, so it lives in its own schema. Nothing in
    // this corpus had ever MAPPED a schema-qualified table: the one Schema that existed was
    // declared in the dense store and read by nothing.
    Schema regrpt
    (
       Table EXPOSURE_LINE
       (
          REPORT_ID VARCHAR(20) PRIMARY KEY,
          COB_DATE DATE PRIMARY KEY,
          LINE_NO SMALLINT PRIMARY KEY,
          COUNTERPARTY_ID VARCHAR(20),
          GROUP_ID VARCHAR(20),
          COUNTRY_CODE CHAR(2),
          EXPOSURE_CLASS VARCHAR(16),
          GROSS_EXPOSURE NUMERIC(20,2),
          CRM_EFFECT NUMERIC(20,2),
          NET_EXPOSURE NUMERIC(20,2),
          PCT_OF_CAPITAL FLOAT,
          REPORTED_AT TIMESTAMP,
          IS_EXEMPT BIT
       )

       Table EXPOSURE_THRESHOLD
       (
          BAND_ID VARCHAR(12) PRIMARY KEY,
          BAND_NAME VARCHAR(40),
          FLOOR_PCT FLOAT,
          CEILING_PCT FLOAT,
          IS_REPORTABLE BIT,
          IS_BREACH BIT,
          NOTE VARCHAR(80)
       )

       Table EXEMPTION_RULE
       (
          RULE_ID VARCHAR(12) PRIMARY KEY,
          EXEMPT_CPTY_ID VARCHAR(20),
          EXEMPT_COUNTRY CHAR(2),
          BASIS VARCHAR(30),
          NOTE VARCHAR(80)
       )
    )

    // ---- Brokerage tiers and clearing routes ----
    Table BROKERAGE_TIER (TIER_ID VARCHAR(20) PRIMARY KEY, TIER_NAME VARCHAR(30),
                          MIN_NOTIONAL DECIMAL(18,2), MAX_NOTIONAL DECIMAL(18,2),
                          BPS_RATE DECIMAL(18,4), MINIMUM_FEE DECIMAL(18,2))

    Table CLEARING_ROUTE (ROUTE_ID VARCHAR(20) PRIMARY KEY, VENUE_CODE VARCHAR(10),
                          PRODUCT_CODE VARCHAR(20), CLEARING_HOUSE VARCHAR(20),
                          SETTLEMENT_CYCLE VARCHAR(6), IS_NETTED BIT)

    // ---- Market data: series, observations, revisions ----
    Table TIME_SERIES (SERIES_ID VARCHAR(20) PRIMARY KEY, SERIES_NAME VARCHAR(60),
                       SOURCE_CODE VARCHAR(20), FREQUENCY VARCHAR(12), UNIT VARCHAR(12),
                       CURRENCY VARCHAR(4), ASSET_CLASS VARCHAR(12), DECIMAL_PLACES INTEGER,
                       FIRST_OBS_DATE DATE, IS_ACTIVE BIT)

    Table TS_OBSERVATION (OBS_ID VARCHAR(30) PRIMARY KEY, SERIES_ID VARCHAR(20),
                          OBS_DATE DATE, OBS_VALUE DECIMAL(18,4), PRIOR_VALUE DECIMAL(18,4),
                          STATUS VARCHAR(12), IS_INTERPOLATED BIT)

    Table TS_REVISION_BI
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z, INFINITY_DATE = %9999-12-31),
        processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31)
      )
      SERIES_ID VARCHAR(20) PRIMARY KEY,
      FROM_Z DATE PRIMARY KEY,
      IN_Z DATE PRIMARY KEY,
      THRU_Z DATE,
      OUT_Z DATE,
      REVISED_VALUE DECIMAL(18,4),
      REVISION_REASON VARCHAR(30)
    )

    // ---- Yield curves: the composite-key domain ----
    Table RATE_CURVE (CURVE_ID VARCHAR(20) PRIMARY KEY, CURVE_NAME VARCHAR(40),
                       CURRENCY VARCHAR(4), CURVE_TYPE VARCHAR(12),
                       INTERPOLATION VARCHAR(16), DAY_COUNT_BASIS VARCHAR(10), IS_ACTIVE BIT,
                      BENCHMARK_SERIES_ID VARCHAR(20))

    // Keyed by all three of CURVE_ID, COB_DATE and TENOR_LABEL. The last three columns are
    // the curve's own, denormalized onto the point so the embedded mapping has something to
    // bind to -- which is what a curve store does, for the same reason.
    Table RATE_CURVE_POINT (CURVE_ID VARCHAR(20) PRIMARY KEY, COB_DATE DATE PRIMARY KEY,
                       TENOR_LABEL VARCHAR(6) PRIMARY KEY, TENOR_DAYS INTEGER,
                       ZERO_RATE DECIMAL(18,4), DISCOUNT_FACTOR DECIMAL(18,8),
                       IS_INTERPOLATED BIT, SOURCE_SERIES_ID VARCHAR(20),
                       CURVE_NAME VARCHAR(40), CURVE_CURRENCY VARCHAR(4),
