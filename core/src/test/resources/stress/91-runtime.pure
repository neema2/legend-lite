
###Connection
RelationalDatabaseConnection store::Conn
{
    type: DuckDB;
    specification: DuckDB { };
    auth: Test;
}


###Runtime
Runtime stress::RT
{
    mappings:
    [
        stress::AllMapping
    ];
    connections:
    [
        store::DB: [ environment: store::Conn ]
    ];
}

Runtime stress::FlatRT
{
    mappings:
    [
        reporting::FlatMapping
    ];
    connections:
    [
        store::DB: [ environment: store::Conn ]
    ];
}

Runtime stress::EmbeddedFlatRT
{
    mappings:
    [
        reporting::EmbeddedFlatMapping
    ];
    connections:
    [
        store::DB: [ environment: store::Conn ]
    ];
}

Runtime stress::DenseRT
{
    // stress::DenseMapping (59-dense-mapping.pure), which the flat mapping's queries run through too (the
    // improvement plan's Phase 7, scripts/corpus/unreached.py).
    mappings:
    [
        stress::DenseMapping
    ];
    connections:
    [
        store::DB: [ environment: store::Conn ]
    ];
}

Runtime stress::ExecutedRT
{
    mappings:
    [
        trading::ExecutedMapping
    ];
    connections:
    [
        store::DB: [ environment: store::Conn ]
    ];
}
