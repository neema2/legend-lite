// The Money measure's M2M mapping and its runtime. Its M2M mapping without a measure, the ModelChainConnection both
// runtimes chain to and stress::CanonicalRT moved to 55-canonical-chain.pure on 2026-10-30 (the improvement plan's
// Phase 5), so that legend-lite, which cannot load a Measure's units, excludes this file alone.
###Mapping
Mapping canonical::MoneyMapping
(
    // Composing a unit from a plain number: newUnit(<measure>~<unit>, value) then cast.
    // The cast is required -- newUnit returns the Measure type, not the Unit type.
    *canonical::MonetaryTrade: Pure
    {
        ~src trading::Trade
        identifier: $src.tradeId,
        amount: newUnit(stress::Money~USD, $src.notional)->cast(@stress::Money~USD)
    }
)


###Runtime
Runtime stress::MoneyRT
{
    mappings:
    [
        canonical::MoneyMapping
    ];
    connections:
    [
        ModelStore:
        [
            chain: stress::TradeChain
        ],
        store::DB:
        [
            environment: store::Conn
        ]
    ];
}
