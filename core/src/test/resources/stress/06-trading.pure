// ============================================================
// Trading Domain — Orders, trades, executions, allocations
// 10 classes, ~15 properties each + enums
// ============================================================

Enum trading::Side
{
    BUY,
    SELL
}

Enum trading::OrderType
{
    MARKET,
    LIMIT,
    STOP,
    STOP_LIMIT,
    IOC,
    FOK
}

Enum trading::OrderStatus
{
    NEW,
    PARTIALLY_FILLED,
    FILLED,
    CANCELLED,
    REJECTED,
    EXPIRED
}

Class trading::Trade
[
    // Rules a trade-capture system would actually enforce. Every seeded trade satisfies
    // these, deliberately: whether a VIOLATING row is rejected, dropped or ignored during
    // relational execution is a separate question, isolated in repro/constraint-violation/
    // rather than mixed into the corpus where it would take every service down with it.
    //
    // Each comparison is fully parenthesised on purpose. Pure binds && tighter than the
    // comparison operators, so `$this.a > 0 && $this.a < 150` parses as
    // `(($this.a > 0) && $this.a) < 150` and fails with and(Boolean[1],Integer[1]).
    quantityIsPositive: ($this.quantity > 0.0),
    priceIsNonNegative: ($this.price >= 0.0)
]
{
    tradeId: String[1];
    tradeDate: StrictDate[1];
    settlementDate: StrictDate[0..1];   // unsettled trades have none
    quantity: Float[1];
    price: Float[1];
    notional: Float[1];
    side: trading::Side[1];
    status: String[1];
    tradeType: String[1];
    currency: String[1];
    commission: Float[0..1];
    fees: Float[0..1];
    executionVenue: String[0..1];
    isBlock: Boolean[1];
    createdTime: DateTime[1];
    lastModifiedTime: DateTime[0..1];

    // Derived properties — the questions a user actually asks of a trade.
    // Total-safe: quantity and price are both [1].
    grossAmount() { $this.quantity * $this.price } : Float[1];
    // A QUALIFIED property — same shape, but parameterised. Converting a notional to a
    // reporting currency is the archetypal reason a real model needs one: the answer
    // depends on an argument the caller supplies, not only on the row.
    grossAmountIn(fxRate: Float[1]) { ($this.quantity * $this.price) * $fxRate } : Float[1];
    // A netCost() over the two OPTIONAL measures belongs here and is absent on purpose.
    //   - `$this.commission + $this.fees` does not compile: both are [0..1] and plus
    //     requires [1] ("Collection element must have a multiplicity [1] ... Applying
    //     plus"). Pure makes you discharge optionality explicitly rather than letting
    //     NULL propagate, which is a real and defensible design choice.
    //   - the natural way to discharge it in USER code is `coalesce($this.commission, 0.0)`
    //     — the idiom the engine's own relational test corpus uses 120 times and never
    //     `orElse`, which is an engine-internal convenience (docs/UPSTREAM_FINDINGS.md F7).
    //     This property stays withdrawn only because it was never part of the differential.
    // An isSettled() { $this.settlementDate->isNotEmpty() } belongs here and is absent
    // for the same structural reason as netCost: it makes the corpus uncompilable in one
    // engine. legend-lite refuses it over a [0..1] receiver --
    //   "derived property 'isSettled' over a [0..1] receiver has a body outside the
    //    null-strict whitelist -- empty-receiver semantics needs the presence-guarded
    //    emission (roadmap)"
    // -- which is the RIGHT posture: it knows it cannot emit correct empty-receiver
    // semantics and declines rather than guessing. legend-engine compiles it and returns
    // a definite `false` for a settlement that has no trade at all, which is wrong and is
    // recorded as F8. The evidence lives in repro/derived-on-absent/ so that withdrawing
    // it here costs nothing.
}

Class trading::Order
{
    orderId: String[1];
    orderDate: StrictDate[1];
    side: String[1];
    quantity: Float[1];
    filledQuantity: Float[0..1];
    remainingQuantity: Float[0..1];
    limitPrice: Float[0..1];
    stopPrice: Float[0..1];
    timeInForce: String[1];
    status: String[1];
    priority: Integer[0..1];
    createdTime: DateTime[1];
    lastModifiedTime: DateTime[0..1];
    expiryDate: StrictDate[0..1];
    isAlgoOrder: Boolean[1];
    algoStrategy: String[0..1];
}

Class trading::Execution
{
    executionId: String[1];
    executionTime: DateTime[1];
    filledQuantity: Float[1];
    fillPrice: Float[1];
    venue: String[1];
    broker: String[0..1];
    commission: Float[0..1];
    fillType: String[1];
    executionAlgo: String[0..1];
    arrivalPrice: Float[0..1];
    slippage: Float[0..1];
    marketImpact: Float[0..1];
    isPartialFill: Boolean[1];
    sequenceNumber: Integer[1];
    lastMarket: String[0..1];
}

Class trading::Allocation
{
    allocationId: String[1];
    quantity: Float[1];
    price: Float[1];
    notional: Float[1];
    account: String[1];
    allocationDate: StrictDate[1];
    status: String[1];
    commission: Float[0..1];
    fees: Float[0..1];
    settlementDate: StrictDate[0..1];
    currency: String[1];
    isConfirmed: Boolean[1];
}

Class trading::TradeLifecycleEvent
{
    eventId: String[1];
    eventType: String[1];
    eventDate: DateTime[1];
    reason: String[0..1];
    previousValue: String[0..1];
    newValue: String[0..1];
    fieldChanged: String[0..1];
    performedBy: String[1];
    isSystemGenerated: Boolean[1];
    approvedBy: String[0..1];
    approvalDate: DateTime[0..1];
    comment: String[0..1];
}

Class trading::Block
{
    blockId: String[1];
    blockDate: StrictDate[1];
    totalQuantity: Float[1];
    averagePrice: Float[1];
    totalNotional: Float[1];
    numberOfAllocations: Integer[1];
    status: String[1];
    side: String[1];
    currency: String[1];
    broker: String[0..1];
    isComplete: Boolean[1];
    completedTime: DateTime[0..1];
}

Class trading::OrderRoute
{
    routeId: String[1];
    routeDate: DateTime[1];
    destination: String[1];
    routeQuantity: Float[1];
    routedPrice: Float[0..1];
    status: String[1];
    routeType: String[1];
    priority: Integer[0..1];
    latencyMs: Integer[0..1];
    isSmartRouted: Boolean[1];
    rejectReason: String[0..1];
    broker: String[0..1];
}

Class trading::FillDetail
{
    fillId: String[1];
    fillTime: DateTime[1];
    fillQuantity: Float[1];
    fillPrice: Float[1];
    venue: String[1];
    counterpartyId: String[0..1];
    liquidityType: String[1];
    isMidpoint: Boolean[1];
    isDarkPool: Boolean[1];
    sequenceNumber: Integer[1];
    fees: Float[0..1];
    rebate: Float[0..1];
}

Class trading::TradeCorrection
{
    correctionId: String[1];
    correctionDate: DateTime[1];
    correctionType: String[1];
    originalValue: String[1];
    correctedValue: String[1];
    fieldCorrected: String[1];
    reason: String[1];
    performedBy: String[1];
    approvedBy: String[0..1];
    status: String[1];
    isReversed: Boolean[1];
}

Class trading::AveragePriceTrade
{
    avgTradeId: String[1];
    avgPrice: Float[1];
    totalQuantity: Float[1];
    totalNotional: Float[1];
    numberOfFills: Integer[1];
    vwapPrice: Float[0..1];
    twapPrice: Float[0..1];
    arrivalPrice: Float[0..1];
    closePrice: Float[0..1];
    tradeDate: StrictDate[1];
    side: String[1];
    currency: String[1];
}

// A REQUEST FOR QUOTE: a client asking the desk to price a currency pair -- quoted or not, done or missed. An FX desk's
// hit ratio is its DONE requests over those it quoted; its response time how fast it answered.
Class trading::Rfq
{
    rfqId: String[1];
    requestTime: DateTime[1];
    currencyPair: String[1];
    side: String[1];
    notional: Float[1];
    tenor: String[1];
    quotedRate: Float[0..1];   // none when the desk did not quote
    spreadBps: Float[0..1];
    status: String[1];         // DONE, MISSED, EXPIRED, DECLINED
    responseTimeMs: Integer[0..1];
    isHit: Boolean[1];
}

// ---- Intra-domain Associations ----

Association trading::Order_Trade
{
    order: trading::Order[0..1];
    trades: trading::Trade[*];
}

Association trading::Order_Execution
{
    order: trading::Order[1];
    executions: trading::Execution[*];
}

Association trading::Trade_Allocation
{
    trade: trading::Trade[1];
    allocations: trading::Allocation[*];
}

Association trading::Trade_LifecycleEvent
{
    trade: trading::Trade[1];
    lifecycleEvents: trading::TradeLifecycleEvent[*];
}

Association trading::Trade_Block
{
    block: trading::Block[0..1];
    trades: trading::Trade[*];
}

Association trading::Order_OrderRoute
{
    order: trading::Order[1];
    routes: trading::OrderRoute[*];
}

Association trading::Execution_FillDetail
{
    execution: trading::Execution[1];
    fillDetails: trading::FillDetail[*];
}

Association trading::Trade_TradeCorrection
{
    trade: trading::Trade[1];
    corrections: trading::TradeCorrection[*];
}

Association trading::Trade_AveragePriceTrade
{
    avgPriceTrade: trading::AveragePriceTrade[0..1];
    trades: trading::Trade[*];
}
