###Pure
// Intraday milestoning: versions superseded at a time of day, read at a time of day.
//
// Every milestoned query in the corpus was day-grained: the processing columns were DATEs with a StrictDate
// infinity date, and every date passed to all() or to a milestoned property was a StrictDate or %latest
// (docs/stress-corpus-feature-report-2026-09-29, section 3, Milestoning). A risk system records a change when
// it happens, and the question it is asked is "what was in force at 09:21", so the processing columns here are
// TIMESTAMPs with a DateTime infinity date, and the seed changes versions within a day, twice in one day, and
// exactly at midnight (scripts/corpus/seed.py, BOOK_LIMIT_PT). The services over it are generated by
// scripts/corpus/intraday.py into 99-intraday-services.pure (docs/STRESS_CORPUS_PLAN_2026_10_19.md, Phase 3).
//
// The interval is [in, out): a version is in force from the instant it was recorded up to, and not
// including, the instant it was superseded. So at the instant of a change the new version answers and the
// old one does not, which is the boundary these services ask about. A StrictDate passed where the column is
// a TIMESTAMP reads as midnight of that day.
//
// As with every milestoned class here there are no in/out PROPERTIES: the engine supplies the predicate.

// A book's trading limit, as the risk system recorded it: processing time alone. A limit is cut and raised
// during the day, reset at midnight, withdrawn, and missing for an hour; one book never had one.
Class <<temporal.processingtemporal>> intraday::BookLimit
{
   bookId: String[1];
   limitAmount: Float[1];
   currency: String[1];
   revision: Integer[1];
   approvedBy: String[0..1];
}

// A book's trading state, recorded on the same clock and changing at its own instants: a halt that begins
// between two limit changes and ends exactly at one of them.
Class <<temporal.processingtemporal>> intraday::BookStatus
{
   bookId: String[1];
   state: String[1];
   reason: String[0..1];
}

// An instrument's end-of-day mark: business time is the day the mark is for (a DATE), processing time is
// when it was believed (a TIMESTAMP). A mark is published as preliminary, made official minutes later, and
// restated at midnight by the overnight batch.
Class <<temporal.bitemporal>> intraday::MarkRevision
{
   instrumentId: String[1];
   price: Float[1];
   source: String[0..1];
}

// A pre-trade limit check: a request for an amount against a book, at an instant. Not milestoned, so a
// milestoned property from it needs its date, and the date that matters is its own:
// `$x.bookLimit($x.checkedAt)`, the limit in force when the check ran.
//
// The navigations start here and at ValuationRun rather than at trading::Trade: a milestoned property on
// Trade makes legend-engine 4.145.0 fail to compile external::EntityMapping's XStore association on it
// (docs/UPSTREAM_FINDINGS.md, F66), and that one mapping failing stops the whole corpus compiling.
Class intraday::LimitCheck
{
   checkId: String[1];
   bookId: String[0..1];
   checkedAt: DateTime[1];
   requestedAmount: Float[1];
}

// A valuation run: an instrument valued for a business date, at an instant. The mark it read is the one for
// its date as believed when it ran, both dates from the row: `$x.mark($x.runAt, $x.valuationDate)`.
Class intraday::ValuationRun
{
   runId: String[1];
   instrumentId: String[1];
   valuationDate: StrictDate[1];
   runAt: DateTime[1];
}

// The limit of a check's book. To-one: a book has at most one limit in force at any instant (seed.check
// proves the versions of a book never overlap).
Association intraday::CheckBookLimit
{
   limitChecks: intraday::LimitCheck[*];
   bookLimit: intraday::BookLimit[0..1];
}

// Processing-temporal to processing-temporal: from a dated limit, `$x.status` takes the limit's own
// processing date, which is how a date propagates along a milestoned navigation.
Association intraday::LimitStatus
{
   statusOfLimits: intraday::BookLimit[*];
   status: intraday::BookStatus[0..1];
}

// The mark of a run's instrument, which needs both dates: `$x.mark(%p, %b)`.
Association intraday::RunMark
{
   valuationRuns: intraday::ValuationRun[*];
   mark: intraday::MarkRevision[0..1];
}

###Relational
// Its own store, included by store::DB (30-store.pure) as typedvalues::TypedStore is, so the main connection
// seeds it.
Database intraday::IntradayStore
(
    Table BOOK_LIMIT_PT
    (
      milestoning
      (
        processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
      )
      BOOK_ID VARCHAR(20) PRIMARY KEY,
      IN_Z TIMESTAMP PRIMARY KEY,
      OUT_Z TIMESTAMP,
      LIMIT_AMOUNT DOUBLE NOT NULL,
      CURRENCY VARCHAR(3) NOT NULL,
      REVISION INTEGER NOT NULL,
      APPROVED_BY VARCHAR(40)
    )

    Table BOOK_STATUS_PT
    (
      milestoning
      (
        processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
      )
      BOOK_ID VARCHAR(20) PRIMARY KEY,
      IN_Z TIMESTAMP PRIMARY KEY,
      OUT_Z TIMESTAMP,
      STATE VARCHAR(10) NOT NULL,
      REASON VARCHAR(40)
    )

    // Business in DATEs, processing in TIMESTAMPs: each dimension at its own grain.
    Table MARK_REVISION_BI
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z, INFINITY_DATE = %9999-12-31),
        processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
      )
      INSTRUMENT_ID VARCHAR(200) PRIMARY KEY,
      FROM_Z DATE PRIMARY KEY,
      IN_Z TIMESTAMP PRIMARY KEY,
      THRU_Z DATE,
      OUT_Z TIMESTAMP,
      PRICE DOUBLE NOT NULL,
      SOURCE VARCHAR(20)
    )

    Table LIMIT_CHECK (CHECK_ID VARCHAR(12) PRIMARY KEY, BOOK_ID VARCHAR(20), CHECKED_AT TIMESTAMP NOT NULL,
                       REQUESTED_AMOUNT DOUBLE NOT NULL)

    Table VALUATION_RUN (RUN_ID VARCHAR(12) PRIMARY KEY, INSTRUMENT_ID VARCHAR(200) NOT NULL,
                         VALUATION_DATE DATE NOT NULL, RUN_AT TIMESTAMP NOT NULL)

    // The milestoning columns are not in a condition: the engine adds them for the date the navigation
    // takes. Each join matches every version of its target, and that date makes it to-one.
    Join BookLimit_Status(BOOK_LIMIT_PT.BOOK_ID = BOOK_STATUS_PT.BOOK_ID)
    Join LimitCheck_BookLimit(LIMIT_CHECK.BOOK_ID = BOOK_LIMIT_PT.BOOK_ID)
    Join ValuationRun_Mark(VALUATION_RUN.INSTRUMENT_ID = MARK_REVISION_BI.INSTRUMENT_ID)
)

###Mapping
Mapping intraday::IntradayMapping
(
   intraday::BookLimit: Relational
   {
      ~primaryKey ( [intraday::IntradayStore]BOOK_LIMIT_PT.BOOK_ID, [intraday::IntradayStore]BOOK_LIMIT_PT.IN_Z )
      ~mainTable [intraday::IntradayStore]BOOK_LIMIT_PT
      bookId: [intraday::IntradayStore]BOOK_LIMIT_PT.BOOK_ID,
      limitAmount: [intraday::IntradayStore]BOOK_LIMIT_PT.LIMIT_AMOUNT,
      currency: [intraday::IntradayStore]BOOK_LIMIT_PT.CURRENCY,
      revision: [intraday::IntradayStore]BOOK_LIMIT_PT.REVISION,
      approvedBy: [intraday::IntradayStore]BOOK_LIMIT_PT.APPROVED_BY
   }

   intraday::BookStatus: Relational
   {
      ~primaryKey ( [intraday::IntradayStore]BOOK_STATUS_PT.BOOK_ID, [intraday::IntradayStore]BOOK_STATUS_PT.IN_Z )
      ~mainTable [intraday::IntradayStore]BOOK_STATUS_PT
      bookId: [intraday::IntradayStore]BOOK_STATUS_PT.BOOK_ID,
      state: [intraday::IntradayStore]BOOK_STATUS_PT.STATE,
      reason: [intraday::IntradayStore]BOOK_STATUS_PT.REASON
   }

   intraday::MarkRevision: Relational
   {
      ~primaryKey ( [intraday::IntradayStore]MARK_REVISION_BI.INSTRUMENT_ID, [intraday::IntradayStore]MARK_REVISION_BI.FROM_Z, [intraday::IntradayStore]MARK_REVISION_BI.IN_Z )
      ~mainTable [intraday::IntradayStore]MARK_REVISION_BI
      instrumentId: [intraday::IntradayStore]MARK_REVISION_BI.INSTRUMENT_ID,
      price: [intraday::IntradayStore]MARK_REVISION_BI.PRICE,
      source: [intraday::IntradayStore]MARK_REVISION_BI.SOURCE
   }

   intraday::LimitCheck: Relational
   {
      ~primaryKey ( [intraday::IntradayStore]LIMIT_CHECK.CHECK_ID )
      ~mainTable [intraday::IntradayStore]LIMIT_CHECK
      checkId: [intraday::IntradayStore]LIMIT_CHECK.CHECK_ID,
      bookId: [intraday::IntradayStore]LIMIT_CHECK.BOOK_ID,
      checkedAt: [intraday::IntradayStore]LIMIT_CHECK.CHECKED_AT,
      requestedAmount: [intraday::IntradayStore]LIMIT_CHECK.REQUESTED_AMOUNT
   }

   intraday::ValuationRun: Relational
   {
      ~primaryKey ( [intraday::IntradayStore]VALUATION_RUN.RUN_ID )
      ~mainTable [intraday::IntradayStore]VALUATION_RUN
      runId: [intraday::IntradayStore]VALUATION_RUN.RUN_ID,
      instrumentId: [intraday::IntradayStore]VALUATION_RUN.INSTRUMENT_ID,
      valuationDate: [intraday::IntradayStore]VALUATION_RUN.VALUATION_DATE,
      runAt: [intraday::IntradayStore]VALUATION_RUN.RUN_AT
   }

   // No set ids named: each end resolves to its class's default one, as typedvalues::TypedValueMapping's do.
   intraday::CheckBookLimit: Relational
   {
      AssociationMapping
      (
         bookLimit: [intraday::IntradayStore]@LimitCheck_BookLimit,
         limitChecks: [intraday::IntradayStore]@LimitCheck_BookLimit
      )
   }

   intraday::LimitStatus: Relational
   {
      AssociationMapping
      (
         status: [intraday::IntradayStore]@BookLimit_Status,
         statusOfLimits: [intraday::IntradayStore]@BookLimit_Status
      )
   }

   intraday::RunMark: Relational
   {
      AssociationMapping
      (
         mark: [intraday::IntradayStore]@ValuationRun_Mark,
         valuationRuns: [intraday::IntradayStore]@ValuationRun_Mark
      )
   }
)
