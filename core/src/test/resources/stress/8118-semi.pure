// ============================================================
// The semi-structured pack (the improvement plan's Phase 9): JSON documents navigated, flattened and exploded
// ============================================================
// One booking payload per row: in 66-store-surface.pure's SURFACE_TYPES.C_SEMI, which the H2 side reads, and in this
// store's SEMI_DOC.DOC, which the DuckDB side reads (the seed, `_SEMI_DOCS` in scripts/corpus/seed.py, puts the same
// five documents in both, and a NULL document in SEMI_DOC alone). legend-engine 4.145.0 runs a service's tests on H2
// when its query answers a TDS or a graph, and on DuckDB when it answers a Relation (ServiceTestRunner's
// isRelationReturnType hint); DuckDB cannot create SURFACE_TYPES, whose REAL and OTHER columns it has no type for, so
// the Relation services read SEMI_DOC. The two sides map the same properties, each through its own classes (the
// corpus's reader keys a property's column by class), and each construct on a class of its own, so that a reader
// refusing one refuses only its services (lite compiles a class mapping whole, 2026-10-31):
//   Sj/SdDoc     NAVIGATION: extractFromSemiStructured in property mappings, every scalar type of the whitelist the
//                services read, along a dotted path, an index, consecutive indices and bracket-quoted keys;
//   Sj/SdBig     the same in a store Filter, which the class mapping's ~filter names;
//   Sj/SdBound   a Binding over the semi-structured column: its keys, a nested object, and a to-many, which the
//                planner flattens laterally, one row per element;
//   Sj/SdRoute   EXPLODE: a join that fans a document's legs into rows of SEMI_HOP;
//   SdArrays     WILDCARD PATHS and the array_* functions over them, on the DuckDB side alone (the pin's H2 plans
//                neither).
// Each construct was probed on the pinned release before its services were written (scripts/corpus/semi.py's header).
// C_JSON, the JSON-typed column beside C_SEMI, is mapped by nothing: neither test database loads a value into a JSON
// column at the pin (docs/UPSTREAM_FINDINGS.md, F91), so the seed leaves it NULL.
###Pure
Class semi::SjDoc
{
   docKey: String[1];
   docVariant: String[1];
   ref: String[0..1];
   refName: String[0..1];
   qty: Integer[0..1];
   px: Float[0..1];
   fee: Decimal[0..1];
   live: Boolean[0..1];
   tradeDate: StrictDate[0..1];
   stamp: DateTime[0..1];
   stampAt: DateTime[0..1];
   firstHop: String[0..1];
   secondVenue: String[0..1];
   cell: Integer[0..1];
   lowerCell: Integer[0..1];
   book: String[0..1];
}

Class semi::SjBig
{
   docKey: String[1];
   ref: String[0..1];
}

Class semi::SjBound
{
   docKey: String[1];
   body: semi::SjBody[0..1];
}

Class semi::SjBody
{
   ref: String[0..1];
   qty: Integer[0..1];
   px: Float[0..1];
   live: Boolean[0..1];
   dates: semi::SjDates[0..1];
   legs: semi::SjLeg[*];
}

Class semi::SjDates
{
   trade: StrictDate[0..1];
}

Class semi::SjLeg
{
   hop: String[1];
   venue: String[0..1];
   qty: Integer[0..1];
}

Class semi::SjRoute
{
   docKey: String[1];
   hops: semi::SjHop[*];
}

Class semi::SjHop
{
   hopId: String[1];
   label: String[0..1];
}

Class semi::SdDoc
{
   docId: String[1];
   ref: String[0..1];
   refName: String[0..1];
   qty: Integer[0..1];
   px: Float[0..1];
   fee: Decimal[0..1];
   live: Boolean[0..1];
   tradeDate: StrictDate[0..1];
   stamp: DateTime[0..1];
   stampAt: DateTime[0..1];
   firstHop: String[0..1];
   secondVenue: String[0..1];
   cell: Integer[0..1];
   lowerCell: Integer[0..1];
   book: String[0..1];
}

Class semi::SdBig
{
   docId: String[1];
   ref: String[0..1];
}

Class semi::SdBound
{
   docId: String[1];
   body: semi::SdBody[0..1];
}

Class semi::SdBody
{
   ref: String[0..1];
   qty: Integer[0..1];
   px: Float[0..1];
   live: Boolean[0..1];
   dates: semi::SdDates[0..1];
   legs: semi::SdLeg[*];
}

Class semi::SdDates
{
   trade: StrictDate[0..1];
}

Class semi::SdLeg
{
   hop: String[1];
   venue: String[0..1];
