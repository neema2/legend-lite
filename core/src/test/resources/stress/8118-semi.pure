###ExternalFormat
Binding semi::SjBinding
{
   contentType: 'application/json';
   modelIncludes:
   [
      semi::SjBody,
      semi::SjDates,
      semi::SjLeg
   ];
}

Binding semi::SdBinding
{
   contentType: 'application/json';
   modelIncludes:
   [
      semi::SdBody,
      semi::SdDates,
      semi::SdLeg
   ];
}

###Relational
Database semi::SemiDB
(
   // SURFACE_TYPES through the include: its documents, for the H2 side.
   include surface::SurfaceDB

   Table SEMI_DOC
   (
      DOC_ID VARCHAR(16) PRIMARY KEY,
      DOC SEMISTRUCTURED
   )
   Table SEMI_HOP
   (
      HOP_ID VARCHAR(16) PRIMARY KEY,
      LABEL VARCHAR(64)
   )

   // EXPLODE: a document's legs fanned into rows, each leg's hop equi-joined to SEMI_HOP. A leg whose hop SEMI_HOP
   // lacks drops out, and a document with no legs lands on nothing. The operand must be a plain column.
   Join SjRoute_Hop(extractFromSemiStructured(explodeSemiStructured(SURFACE_TYPES.C_SEMI, 'legs', 'SEMISTRUCTURED'), 'hop', 'VARCHAR') = SEMI_HOP.HOP_ID)
   Join SdRoute_Hop(extractFromSemiStructured(explodeSemiStructured(SEMI_DOC.DOC, 'legs', 'SEMISTRUCTURED'), 'hop', 'VARCHAR') = SEMI_HOP.HOP_ID)

   // A store filter deciding row inclusion by a value read out of the document.
   Filter SjBigQty(extractFromSemiStructured(SURFACE_TYPES.C_SEMI, 'qty', 'INTEGER') > 100)
   Filter SdBigQty(extractFromSemiStructured(SEMI_DOC.DOC, 'qty', 'INTEGER') > 100)
)

###Mapping
Mapping semi::SurfaceDocs
(
   semi::SjDoc[sjDoc]: Relational
   {
      ~mainTable [semi::SemiDB]SURFACE_TYPES
      docKey: [semi::SemiDB]SURFACE_TYPES.TK,
      docVariant: [semi::SemiDB]SURFACE_TYPES.TK2,
      // NAVIGATION, one property per type of the extraction whitelist the services read.
      ref: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'ref', 'VARCHAR'),
      refName: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'ref', 'STRING'),
      qty: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'qty', 'INTEGER'),
      px: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'px', 'FLOAT'),
      fee: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'fee', 'DECIMAL'),
      live: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'live', 'BOOLEAN'),
      tradeDate: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'dates.trade', 'DATE'),
      stamp: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'dates.stamp', 'TIMESTAMP'),
      stampAt: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'dates.stamp', 'DATETIME'),
      // ARRAY INDEX: an element of an object array, one past the end for a one-leg document, and consecutive indices
      // into an array of arrays.
      firstHop: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'legs[0].hop', 'VARCHAR'),
      secondVenue: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'legs[1].venue', 'VARCHAR'),
      cell: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'grid[0][1]', 'INTEGER'),
      lowerCell: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'grid[1][0]', 'INTEGER'),
      // Keys holding a space and a dot, reachable only bracket-quoted.
      book: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, '["desk info"]["book.code"]', 'VARCHAR')
   }

   semi::SjBig[sjBig]: Relational
   {
      ~filter [semi::SemiDB]SjBigQty
      ~mainTable [semi::SemiDB]SURFACE_TYPES
      docKey: [semi::SemiDB]SURFACE_TYPES.TK,
      ref: extractFromSemiStructured([semi::SemiDB]SURFACE_TYPES.C_SEMI, 'ref', 'VARCHAR')
   }

   semi::SjBound[sjBound]: Relational
   {
      ~mainTable [semi::SemiDB]SURFACE_TYPES
      docKey: [semi::SemiDB]SURFACE_TYPES.TK,
      body: Binding semi::SjBinding : [semi::SemiDB]SURFACE_TYPES.C_SEMI
   }

   semi::SjRoute[sjRoute]: Relational
   {
      ~mainTable [semi::SemiDB]SURFACE_TYPES
      docKey: [semi::SemiDB]SURFACE_TYPES.TK,
      hops[sjHop]: [semi::SemiDB]@SjRoute_Hop
   }

   semi::SjHop[sjHop]: Relational
   {
      ~mainTable [semi::SemiDB]SEMI_HOP
      hopId: [semi::SemiDB]SEMI_HOP.HOP_ID,
      label: [semi::SemiDB]SEMI_HOP.LABEL
   }
)

Mapping semi::DuckDocs
(
   semi::SdDoc[sdDoc]: Relational
   {
      ~mainTable [semi::SemiDB]SEMI_DOC
      docId: [semi::SemiDB]SEMI_DOC.DOC_ID,
      ref: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'ref', 'VARCHAR'),
      refName: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'ref', 'STRING'),
      qty: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'qty', 'INTEGER'),
      px: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'px', 'FLOAT'),
      fee: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'fee', 'DECIMAL'),
      live: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'live', 'BOOLEAN'),
      tradeDate: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'dates.trade', 'DATE'),
      stamp: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'dates.stamp', 'TIMESTAMP'),
      stampAt: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'dates.stamp', 'DATETIME'),
      firstHop: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'legs[0].hop', 'VARCHAR'),
      secondVenue: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'legs[1].venue', 'VARCHAR'),
      cell: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'grid[0][1]', 'INTEGER'),
      lowerCell: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'grid[1][0]', 'INTEGER'),
      book: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, '["desk info"]["book.code"]', 'VARCHAR')
   }

   semi::SdBig[sdBig]: Relational
   {
      ~filter [semi::SemiDB]SdBigQty
      ~mainTable [semi::SemiDB]SEMI_DOC
      docId: [semi::SemiDB]SEMI_DOC.DOC_ID,
      ref: extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'ref', 'VARCHAR')
   }

   semi::SdBound[sdBound]: Relational
   {
      ~mainTable [semi::SemiDB]SEMI_DOC
      docId: [semi::SemiDB]SEMI_DOC.DOC_ID,
      body: Binding semi::SdBinding : [semi::SemiDB]SEMI_DOC.DOC
   }

   semi::SdRoute[sdRoute]: Relational
   {
      ~mainTable [semi::SemiDB]SEMI_DOC
      docId: [semi::SemiDB]SEMI_DOC.DOC_ID,
      hops[sdHop]: [semi::SemiDB]@SdRoute_Hop
   }

   semi::SdHop[sdHop]: Relational
   {
      ~mainTable [semi::SemiDB]SEMI_HOP
      hopId: [semi::SemiDB]SEMI_HOP.HOP_ID,
      label: [semi::SemiDB]SEMI_HOP.LABEL
   }

   semi::SdArrays[sdArrays]: Relational
   {
      ~mainTable [semi::SemiDB]SEMI_DOC
      docId: [semi::SemiDB]SEMI_DOC.DOC_ID,
      // WILDCARD PATHS and the ARRAY FUNCTIONS over them.
      hopList: array_to_string(extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'legs[*].hop', 'VARCHAR[]'), ','),
      legCount: array_size(extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'legs[*]', 'SEMISTRUCTURED[]')),
      maxQty: array_max(extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'legs[*].qty', 'INTEGER[]')),
      sumQty: array_sum(extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'legs[*].qty', 'INTEGER[]')),
      onXnas: array_contains(extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'legs[*].venue', 'VARCHAR[]'), 'XNAS'),
      sortedHops: array_to_string(array_sort(extractFromSemiStructured([semi::SemiDB]SEMI_DOC.DOC, 'legs[*].hop', 'VARCHAR[]')), ',')
   }
)

###Connection
RelationalDatabaseConnection semi::SemiConn
{
   store: semi::SemiDB;
   type: DuckDB;
   specification: DuckDB { };
   auth: Test;
}

###Runtime
Runtime semi::SurfaceRT
{
   mappings:
   [
      semi::SurfaceDocs
   ];
   connections:
   [
      semi::SemiDB: [ semiEnv: semi::SemiConn ]
   ];
}

Runtime semi::DuckRT
{
   mappings:
   [
      semi::DuckDocs
   ];
   connections:
   [
      semi::SemiDB: [ semiEnv: semi::SemiConn ]
   ];
}
