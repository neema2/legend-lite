// The remaining STORE constructs, and the model primitives the corpus never used. Since 2026-10-29 (the improvement
// plan's Phase 7) the join conditions below are mapped and run: surface::JoinSurface reads each from J1, over the
// seed's rows (J1 in seed.py; J2, J3 and MapDB's LEG the expansion's), in scripts/corpus/unreached.py's UJ_ services.
###Pure
// NO documentation string on this class. `classDefinition: documentation? CLASS ...` is in
// the domain grammar exactly as it is in the relational one, and a leading string is
// rejected in both -- as a single-quoted string and as a text block alike (F33). Whatever
// the documentation slot is for, it is not writable.
Class surface::Primitives
{
   k: String[1];
   // The primitive types the corpus never wrote. Float and StrictDate it had; these it did
   // not, and several are distinct engine types rather than spellings of one -- Decimal is
   // not Float, and Number is the abstract supertype of both.
   dec: Decimal[0..1];
   num: Number[0..1];
   dt: Date[0..1];
   b: Byte[*];
   // A precise primitive: a type carrying its own parameters.
   v: meta::pure::precisePrimitives::Varchar(200)[0..1];
}

// J1's row, reading J2, J3 and LEG through each join condition: a to-one value per condition, and the to-many end
// the range condition reaches.
Class surface::JoinHost
{
   k: String[1];
   n: Integer[0..1];
   nullLeg: Integer[0..1];
   notNullTail: Integer[0..1];
   constLeg: Integer[0..1];
   listedLeg: Integer[0..1];
   dynaLeg: Integer[0..1];
   nextN: Integer[0..1];
   tailN: Integer[0..1];
   legLabel: String[0..1];
   neLeg: Integer[0..1];
   ansiNeLeg: Integer[0..1];
}

Class surface::JoinLeg
{
   k: String[1];
   n: Integer[0..1];
}

// The range condition's rows: every J2 whose N is at or below the host's.
Association surface::JoinHostRange
{
   rangeHosts: surface::JoinHost[*];
   atOrBelow: surface::JoinLeg[*];
}

###Relational
Database surface::JoinDB
(
   // A typed store include, and stereotypes plus tagged values on a Table.
   include surface::MapDB

   Table <<meta::pure::profiles::typemodifiers.abstract>> {doc.doc = 'joined from three sides'} J1
   (
      K VARCHAR(64) PRIMARY KEY,
      N INTEGER,
      NEXT_K VARCHAR(64),
      LEG_ID VARCHAR(64)
   )
   Table J2 ( K VARCHAR(64) PRIMARY KEY, N INTEGER, NEXT_K VARCHAR(64) )
   Table J3 ( K VARCHAR(64) PRIMARY KEY, N INTEGER )

   // Every remaining JOIN CONDITION form.
   Join j_GreaterEqual(J1.N >= J2.N)
   Join j_IsNull(J1.NEXT_K is null and J2.K = J1.K)
   Join j_IsNotNull(J1.NEXT_K is not null and J3.K = J1.K)
   Join j_NumericConst(J1.N = -5 and J2.K = J1.K)
   // The array argument is the CALL form `in(x, [...])`; the infix `x in [...]` that
   // reads naturally is rejected.
   Join j_ArrayArg(in(J1.N, [1, 2, 3]) and J2.K = J1.K)
   Join j_NestedDyna(concat(toUpper(J1.K), J1.NEXT_K) = J2.K)
   // The hops a THREE-LINK chain needs.
   Join j_1to2(J1.NEXT_K = J2.K)
   Join j_2to3(J2.NEXT_K = J3.K)
   // A join whose two sides are in DIFFERENT databases, for a cross-store chain hop. JoinDB includes MapDB, so the
   // two are one physical database (F26 is two). J1's own LEG_ID since 2026-10-29: J3's key, which it read before,
   // shares no value with a LEG_ID, so the hop could only land on nothing.
   Join j_CrossDb([surface::JoinDB]J1.LEG_ID = [surface::MapDB]LEG.LEG_ID)
   // The two NOT-EQUAL operators, != (test) and <> (ANSI), moved here 2026-10-29 from 66-store-surface.pure, where
   // they joined two tables no row was ever seeded into. A join condition is SQL, so a NULL on either side matches
   // nothing.
   Join j_NotEqual(J1.NEXT_K = J2.K and J2.NEXT_K != J1.K)
   Join j_AnsiNotEqual(J1.NEXT_K = J2.K and J2.NEXT_K <> J1.K)
)

###Mapping
Mapping surface::JoinSurface
(
   *surface::JoinHost[joinHost]: Relational
   {
      ~primaryKey ( [surface::JoinDB]J1.K )
      ~mainTable [surface::JoinDB]J1
      k: [surface::JoinDB]J1.K,
      n: [surface::JoinDB]J1.N,
      nullLeg: [surface::JoinDB]@j_IsNull | [surface::JoinDB]J2.N,
      notNullTail: [surface::JoinDB]@j_IsNotNull | [surface::JoinDB]J3.N,
      constLeg: [surface::JoinDB]@j_NumericConst | [surface::JoinDB]J2.N,
      listedLeg: [surface::JoinDB]@j_ArrayArg | [surface::JoinDB]J2.N,
      dynaLeg: [surface::JoinDB]@j_NestedDyna | [surface::JoinDB]J2.N,
      nextN: [surface::JoinDB]@j_1to2 | [surface::JoinDB]J2.N,
      tailN: [surface::JoinDB]@j_1to2 > @j_2to3 | [surface::JoinDB]J3.N,
      legLabel: [surface::JoinDB]@j_CrossDb | [surface::MapDB]LEG.LABEL,
      neLeg: [surface::JoinDB]@j_NotEqual | [surface::JoinDB]J2.N,
      ansiNeLeg: [surface::JoinDB]@j_AnsiNotEqual | [surface::JoinDB]J2.N
   }

   *surface::JoinLeg[joinLeg]: Relational
   {
      ~primaryKey ( [surface::JoinDB]J2.K )
      ~mainTable [surface::JoinDB]J2
      k: [surface::JoinDB]J2.K,
      n: [surface::JoinDB]J2.N
   }

   surface::JoinHostRange: Relational
   {
      AssociationMapping
      (
         rangeHosts[joinLeg, joinHost]: [surface::JoinDB]@j_GreaterEqual,
         atOrBelow[joinHost, joinLeg]: [surface::JoinDB]@j_GreaterEqual
      )
   }
)

###Connection
RelationalDatabaseConnection surface::JoinConn
{
   store: surface::JoinDB;
   type: DuckDB;
   specification: DuckDB { };
   auth: Test;
}

###Runtime
Runtime surface::JoinRT
{
   mappings:
   [
      surface::JoinSurface
   ];
   connections:
   [
      surface::JoinDB: [ joinEnv: surface::JoinConn ]
   ];
}
