###Pure
// Typed values: one property of every primitive type, so a query can filter on a real value of each.
//
// The corpus's filters compared against `' '` -- a not-null guard -- and it took one parameter, a String,
// which lite never ran (docs/stress-corpus-feature-report-2026-09-29, sections 4.2 and 4.3). Real queries filter
// on typed values and take parameters, and a comparison is only worth asserting over values that make it
// discriminate: so every type here is seeded with NULLs, ties, a boundary and its neighbours, negatives,
// zero and extremes (scripts/corpus/seed.py, TYPED_VALUE). The services over it are generated by
// scripts/corpus/literals.py into 99-typed-services.pure (docs/STRESS_CORPUS_PLAN_2026_10_19.md, Phase 1).
//
// Each type appears twice, at [1] and at [0..1]: the required property over a NOT NULL column, the
// optional one over a column the seed nulls. The NULL rows are where a comparison's semantics show:
// Pure compares an absent value as false and `!=` as true (legend-pure's greaterThan documents it), so
// `!=` and `!` keep a row whose operand is absent where `==` and `>` drop it.
//
// The column types are the ones a reader would write: the Decimal holds 18 fractional digits, past what a
// double carries, and the optional Number reads a DECIMAL where the required one reads a DOUBLE. StrictTime
// and Byte have no relational column type in the grammar, so they read a VARCHAR and a TINYINT, and live on
// a class of their own over the same rows (TimeAndOctet below): legend-lite refuses a StrictTime over a
// VARCHAR when it compiles the class mapping, and on TypedValue that refusal would fail every service over
// it rather than only the services that ask about those two types.
Enum typedvalues::Grade
{
   PRIME,
   STANDARD,
   WATCH,
   DEFAULTED
}

Class typedvalues::TypedValue
{
   valueId: String[1];
   name: String[1];
   nameOpt: String[0..1];
   active: Boolean[1];
   activeOpt: Boolean[0..1];
   quantity: Integer[1];
   quantityOpt: Integer[0..1];
   rate: Float[1];
   rateOpt: Float[0..1];
   amount: Decimal[1];
   amountOpt: Decimal[0..1];
   metric: Number[1];
   metricOpt: Number[0..1];
   valueDate: Date[1];
   valueDateOpt: Date[0..1];
   tradeDate: StrictDate[1];
   tradeDateOpt: StrictDate[0..1];
   stampedAt: DateTime[1];
   stampedAtOpt: DateTime[0..1];
   grade: typedvalues::Grade[1];
   gradeOpt: typedvalues::Grade[0..1];
   // a groupBy key (the improvement plan's Phase 4): segment A holds the one row absent in every optional
   // column
   segment: String[1];
}

// The two types without a relational column type, over the same TYPED_VALUE rows.
Class typedvalues::TimeAndOctet
{
   valueId: String[1];
   cutoff: StrictTime[1];
   cutoffOpt: StrictTime[0..1];
   octet: Byte[1];
   octetOpt: Byte[0..1];
}

// The same values one hop from a trade. To-one both ways, keyed on the typed value's TRADE_ID: seven of the
// twenty trades have no typed value, so a navigation from them lands on nothing through the outer join --
// the second way a value is absent, beside a NULL column.
Association typedvalues::TradeTypedValue
{
   valuedTrade: trading::Trade[0..1];
   typedValue: typedvalues::TypedValue[0..1];
}

Association typedvalues::TradeTimeAndOctet
{
   timedTrade: trading::Trade[0..1];
   timeAndOctet: typedvalues::TimeAndOctet[0..1];
}

###Relational
// Its own store, included by store::DB (30-store.pure) the way a linked project's is, so the main
// connection seeds it and the join from TRADE is declared where both tables are visible.
Database typedvalues::TypedStore
(
    Table TYPED_VALUE (VALUE_ID VARCHAR(12) PRIMARY KEY, TRADE_ID VARCHAR(200), NAME VARCHAR(40) NOT NULL, NAME_OPT VARCHAR(40), ACTIVE BIT NOT NULL, ACTIVE_OPT BIT, QUANTITY INTEGER NOT NULL, QUANTITY_OPT INTEGER, RATE DOUBLE NOT NULL, RATE_OPT DOUBLE, AMOUNT DECIMAL(38, 18) NOT NULL, AMOUNT_OPT DECIMAL(38, 18), METRIC DOUBLE NOT NULL, METRIC_OPT DECIMAL(18, 4), VALUE_DATE DATE NOT NULL, VALUE_DATE_OPT DATE, TRADE_DATE DATE NOT NULL, TRADE_DATE_OPT DATE, STAMPED_AT TIMESTAMP NOT NULL, STAMPED_AT_OPT TIMESTAMP, CUTOFF VARCHAR(8) NOT NULL, CUTOFF_OPT VARCHAR(8), OCTET TINYINT NOT NULL, OCTET_OPT TINYINT, GRADE VARCHAR(2) NOT NULL, GRADE_OPT VARCHAR(2), SEGMENT VARCHAR(2) NOT NULL)
)

###Mapping
Mapping typedvalues::TypedValueMapping
(
   // Codes, not labels. 'Z' on GRADE_OPT has no entry, so it reads as absent, like a NULL code.
   typedvalues::Grade: EnumerationMapping GradeCodes
   {
      PRIME: ['P'],
      STANDARD: ['S'],
      WATCH: ['W'],
      DEFAULTED: ['D']
   }

   typedvalues::TypedValue: Relational
   {
      ~primaryKey ( [typedvalues::TypedStore]TYPED_VALUE.VALUE_ID )
      ~mainTable [typedvalues::TypedStore]TYPED_VALUE
      valueId: [typedvalues::TypedStore]TYPED_VALUE.VALUE_ID,
      name: [typedvalues::TypedStore]TYPED_VALUE.NAME,
      nameOpt: [typedvalues::TypedStore]TYPED_VALUE.NAME_OPT,
      active: [typedvalues::TypedStore]TYPED_VALUE.ACTIVE,
      activeOpt: [typedvalues::TypedStore]TYPED_VALUE.ACTIVE_OPT,
      quantity: [typedvalues::TypedStore]TYPED_VALUE.QUANTITY,
      quantityOpt: [typedvalues::TypedStore]TYPED_VALUE.QUANTITY_OPT,
      rate: [typedvalues::TypedStore]TYPED_VALUE.RATE,
      rateOpt: [typedvalues::TypedStore]TYPED_VALUE.RATE_OPT,
      amount: [typedvalues::TypedStore]TYPED_VALUE.AMOUNT,
      amountOpt: [typedvalues::TypedStore]TYPED_VALUE.AMOUNT_OPT,
      metric: [typedvalues::TypedStore]TYPED_VALUE.METRIC,
      metricOpt: [typedvalues::TypedStore]TYPED_VALUE.METRIC_OPT,
      valueDate: [typedvalues::TypedStore]TYPED_VALUE.VALUE_DATE,
      valueDateOpt: [typedvalues::TypedStore]TYPED_VALUE.VALUE_DATE_OPT,
      tradeDate: [typedvalues::TypedStore]TYPED_VALUE.TRADE_DATE,
      tradeDateOpt: [typedvalues::TypedStore]TYPED_VALUE.TRADE_DATE_OPT,
      stampedAt: [typedvalues::TypedStore]TYPED_VALUE.STAMPED_AT,
      stampedAtOpt: [typedvalues::TypedStore]TYPED_VALUE.STAMPED_AT_OPT,
      grade: EnumerationMapping GradeCodes: [typedvalues::TypedStore]TYPED_VALUE.GRADE,
      gradeOpt: EnumerationMapping GradeCodes: [typedvalues::TypedStore]TYPED_VALUE.GRADE_OPT,
      segment: [typedvalues::TypedStore]TYPED_VALUE.SEGMENT
   }

   typedvalues::TimeAndOctet: Relational
   {
      ~primaryKey ( [typedvalues::TypedStore]TYPED_VALUE.VALUE_ID )
      ~mainTable [typedvalues::TypedStore]TYPED_VALUE
      valueId: [typedvalues::TypedStore]TYPED_VALUE.VALUE_ID,
      cutoff: [typedvalues::TypedStore]TYPED_VALUE.CUTOFF,
      cutoffOpt: [typedvalues::TypedStore]TYPED_VALUE.CUTOFF_OPT,
      octet: [typedvalues::TypedStore]TYPED_VALUE.OCTET,
      octetOpt: [typedvalues::TypedStore]TYPED_VALUE.OCTET_OPT
   }

   // No set ids named: each end resolves to its class's default one (trading_Trade, typedvalues_TypedValue),
   // as the brokerage pack's associations do. Naming the class mapping's id without naming it here leaves
   // the engine with no mapping for the property ("can't find a mapping for the property
   // 'trading::Trade.typedValue'"), which the reader of this corpus does not check.
   typedvalues::TradeTypedValue: Relational
   {
      AssociationMapping
      (
         typedValue: [store::DB]@Trade_TypedValue,
         valuedTrade: [store::DB]@Trade_TypedValue
      )
   }

   typedvalues::TradeTimeAndOctet: Relational
   {
      AssociationMapping
      (
         timeAndOctet: [store::DB]@Trade_TypedValue,
         timedTrade: [store::DB]@Trade_TypedValue
      )
   }
)
