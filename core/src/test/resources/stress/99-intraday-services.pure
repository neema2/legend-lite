{
    pattern: '/stress/intraday/itmp_official';
    documentation: 'ITM_Official with both dates as parameters, a DateTime and a StrictDate.';
    execution: Single
    {
    query: {believedAt: DateTime[1], markDate: StrictDate[1]|intraday::MarkRevision.all($believedAt, $markDate)
        ->project(~[
            instrumentId:x|$x.instrumentId,
            price:x|$x.price,
            source:x|$x.source
        ])};
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    ITMP_Official_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 1 absent cells.
        expected_rows:
        {
          parameters:
          [
            believedAt = %2024-06-03T18:05:00,
            markDate = %2024-06-03
          ]
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"instrumentId":"INST-AAPL","price":190.25,"source":"OFFICIAL"},{"instrumentId":"INST-MSFT","price":415.5,"source":"OFFICIAL"},{"instrumentId":"INST-NESN","price":98.4,"source":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

