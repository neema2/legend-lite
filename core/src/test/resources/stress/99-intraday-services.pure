    documentation: 'Whether each check\'s book limit has no version overlapping 09:30 on 3 June to midnight: BK-CASH-EU\'s is recorded on the 5th, and three checks have no limit at all.';
    execution: Single
    {
    query: |intraday::LimitCheck.all()
        ->project(~[
            checkId:x|$x.checkId,
            none:x|$x.bookLimitAllVersionsInRange(%2024-06-03T09:30:00, %2024-06-04T00:00:00)->isEmpty()
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    ITN_NoLimitInRange_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 19 rows; 0 absent cells.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"checkId":"CHK-01","none":false},{"checkId":"CHK-02","none":false},{"checkId":"CHK-03","none":false},{"checkId":"CHK-04","none":false},{"checkId":"CHK-05","none":false},{"checkId":"CHK-06","none":false},{"checkId":"CHK-07","none":false},{"checkId":"CHK-08","none":false},{"checkId":"CHK-09","none":true},{"checkId":"CHK-10","none":true},{"checkId":"CHK-11","none":true},{"checkId":"CHK-12","none":false},{"checkId":"CHK-13","none":false},{"checkId":"CHK-14","none":false},{"checkId":"CHK-15","none":true},{"checkId":"CHK-16","none":true},{"checkId":"CHK-17","none":true},{"checkId":"CHK-18","none":false},{"checkId":"CHK-19","none":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

