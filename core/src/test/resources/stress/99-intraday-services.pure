Service stress::ITG_CheckLimit
{
    pattern: '/stress/intraday/itg_checklimit';
    documentation: 'Graph fetch of each check with its book limit at 09:21:00, the property keyed with its date as the engine serializes it.';
    execution: Single
    {
    query: |intraday::LimitCheck.all()
        ->graphFetch(#{
  intraday::LimitCheck
  {
    checkId,
    bookLimit(%2024-06-03T09:21:00)
    {
      limitAmount,
      revision
    }
  }
}#)
        ->serialize(#{
  intraday::LimitCheck
  {
    checkId,
    bookLimit(%2024-06-03T09:21:00)
    {
      limitAmount,
      revision
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    ITG_CheckLimit_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 19 rows; 9 absent cells.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"checkId":"CHK-01","bookLimit(2024-06-03T09:21:00+0000)":{"limitAmount":4000000.0,"revision":2}},{"checkId":"CHK-02","bookLimit(2024-06-03T09:21:00+0000)":{"limitAmount":4000000.0,"revision":2}},{"checkId":"CHK-03","bookLimit(2024-06-03T09:21:00+0000)":{"limitAmount":4000000.0,"revision":2}},{"checkId":"CHK-04","bookLimit(2024-06-03T09:21:00+0000)":null},{"checkId":"CHK-05","bookLimit(2024-06-03T09:21:00+0000)":null},{"checkId":"CHK-06","bookLimit(2024-06-03T09:21:00+0000)":{"limitAmount":4000000.0,"revision":2}},{"checkId":"CHK-07","bookLimit(2024-06-03T09:21:00+0000)":{"limitAmount":4000000.0,"revision":2}},{"checkId":"CHK-08","bookLimit(2024-06-03T09:21:00+0000)":{"limitAmount":4000000.0,"revision":2}},{"checkId":"CHK-09","bookLimit(2024-06-03T09:21:00+0000)":null},{"checkId":"CHK-10","bookLimit(2024-06-03T09:21:00+0000)":null},{"checkId":"CHK-11","bookLimit(2024-06-03T09:21:00+0000)":null},{"checkId":"CHK-12","bookLimit(2024-06-03T09:21:00+0000)":{"limitAmount":1000000.0,"revision":1}},{"checkId":"CHK-13","bookLimit(2024-06-03T09:21:00+0000)":{"limitAmount":1000000.0,"revision":1}},{"checkId":"CHK-14","bookLimit(2024-06-03T09:21:00+0000)":{"limitAmount":8000000.0,"revision":1}},{"checkId":"CHK-15","bookLimit(2024-06-03T09:21:00+0000)":null},{"checkId":"CHK-16","bookLimit(2024-06-03T09:21:00+0000)":null},{"checkId":"CHK-17","bookLimit(2024-06-03T09:21:00+0000)":null},{"checkId":"CHK-18","bookLimit(2024-06-03T09:21:00+0000)":null},{"checkId":"CHK-19","bookLimit(2024-06-03T09:21:00+0000)":{"limitAmount":25000000.0,"revision":1}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::ITG_LimitStatus
{
    pattern: '/stress/intraday/itg_limitstatus';
    documentation: 'Graph fetch of the book limits at 09:35 with each book\'s status, which takes the limit\'s date.';
    execution: Single
    {
    query: |intraday::BookLimit.all(%2024-06-03T09:35:00)
        ->graphFetch(#{
  intraday::BookLimit
  {
    bookId,
    limitAmount,
    status
    {
      state
    }
  }
}#)
        ->serialize(#{
  intraday::BookLimit
  {
    bookId,
    limitAmount,
    status
    {
      state
    }
  }
}#);
