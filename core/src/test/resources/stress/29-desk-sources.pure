// THE DESK'S SOURCES (docs/DESK_DATA_ROADMAP_2026_10_29.md A2; the design,
// docs/DEEPHAVEN_TABLES_AND_SOURCES_2026_10_29.md §4.1-4.2): where each table the trading desk reads comes from.
// The source systems' stores -- topics and masters' databases -- declare what each publishes; the ingests
// declare how it lands, and store::DB includes them (30-store.pure), so the domain mappings read the landing
// tables as they always did. Each landing table's columns are its source's, never written twice; position
// keeping drops files, so its two are written out (Legend's own form).

###Relational
// the ticker plant's topics: each table one topic, its columns a record's fields
Database tickerplant::Topics
(
    Table "tp.us-equities.trades.v3" (PRINT_ID VARCHAR(200) PRIMARY KEY, SEQUENCE_NUMBER INTEGER, PRINT_TIME TIMESTAMP, PRICE DOUBLE, QUANTITY DOUBLE, AGGRESSOR_SIDE VARCHAR(200), VENUE VARCHAR(200), TRADE_CONDITION VARCHAR(200), IS_OFF_EXCHANGE BIT, INSTRUMENT_ID VARCHAR(200))
    Table "tp.us-equities.nbbo.v2" (QUOTE_ID VARCHAR(200) PRIMARY KEY, QUOTE_TIME TIMESTAMP, BID DOUBLE, ASK DOUBLE, MID DOUBLE, LAST DOUBLE, VOLUME DOUBLE, OPEN_PRICE DOUBLE, HIGH_PRICE DOUBLE, LOW_PRICE DOUBLE, CLOSE_PRICE DOUBLE, SOURCE VARCHAR(200), IS_DELAYED BIT, SNAPSHOT_ID VARCHAR(200), INSTRUMENT_ID VARCHAR(200), BID_SIZE DOUBLE, ASK_SIZE DOUBLE)
    Table "tp.fx.spot.v1" (RATE_ID VARCHAR(200) PRIMARY KEY, CURRENCY_PAIR VARCHAR(200), SPOT_RATE DOUBLE, BID_RATE DOUBLE, ASK_RATE DOUBLE, RATE_DATE TIMESTAMP, SOURCE VARCHAR(200), MID_RATE DOUBLE, DAILY_CHANGE DOUBLE, DAILY_CHANGE_PCT DOUBLE, IS_OFFICIAL BIT, FIXING_TIME VARCHAR(200), SNAPSHOT_ID VARCHAR(200), BASE_CURRENCY_CODE VARCHAR(200))
)

// the news vendor's topic
Database newswire::Topics
(
    Table "vendor.newswire.stories.v1" (STORY_ID VARCHAR(200) PRIMARY KEY, PUBLISH_TIME TIMESTAMP, HEADLINE VARCHAR(200), BODY VARCHAR(200), SOURCE VARCHAR(200), CATEGORY VARCHAR(200), URGENCY VARCHAR(200), SENTIMENT DOUBLE, TICKERS VARCHAR(200), REGION VARCHAR(200), INSTRUMENT_ID VARCHAR(200), SECTOR_ID VARCHAR(200))
)

// the order system's drop-copy topics
Database oms::Topics
(
    Table "oms.equities.orders.v4" (ORDER_ID VARCHAR(200) PRIMARY KEY, ORDER_DATE DATE, SIDE VARCHAR(200), QUANTITY DOUBLE, FILLED_QUANTITY DOUBLE, REMAINING_QUANTITY DOUBLE, LIMIT_PRICE DOUBLE, STOP_PRICE DOUBLE, TIME_IN_FORCE VARCHAR(200), STATUS VARCHAR(200), PRIORITY INTEGER, CREATED_TIME TIMESTAMP, LAST_MODIFIED_TIME TIMESTAMP, EXPIRY_DATE DATE, IS_ALGO_ORDER BIT, ALGO_STRATEGY VARCHAR(200), INSTRUMENT_ID VARCHAR(200), TRADER_ID VARCHAR(200), BOOK_ID VARCHAR(200))
    Table "oms.equities.fills.v4" (EXECUTION_ID VARCHAR(200) PRIMARY KEY, EXECUTION_TIME TIMESTAMP, FILLED_QUANTITY DOUBLE, FILL_PRICE DOUBLE, VENUE VARCHAR(200), BROKER VARCHAR(200), COMMISSION DOUBLE, FILL_TYPE VARCHAR(200), EXECUTION_ALGO VARCHAR(200), ARRIVAL_PRICE DOUBLE, SLIPPAGE DOUBLE, MARKET_IMPACT DOUBLE, IS_PARTIAL_FILL BIT, SEQUENCE_NUMBER INTEGER, LAST_MARKET VARCHAR(200), ORDER_ID VARCHAR(200))
    Table "oms.equities.routes.v4" (ROUTE_ID VARCHAR(200) PRIMARY KEY, ROUTE_DATE TIMESTAMP, DESTINATION VARCHAR(200), ROUTE_QUANTITY DOUBLE, ROUTED_PRICE DOUBLE, STATUS VARCHAR(200), ROUTE_TYPE VARCHAR(200), PRIORITY INTEGER, LATENCY_MS INTEGER, IS_SMART_ROUTED BIT, REJECT_REASON VARCHAR(200), BROKER VARCHAR(200), ORDER_ID VARCHAR(200))
    Table "oms.fx.rfqs.v2" (RFQ_ID VARCHAR(200) PRIMARY KEY, REQUEST_TIME TIMESTAMP, CURRENCY_PAIR VARCHAR(200), SIDE VARCHAR(200), NOTIONAL DOUBLE, TENOR VARCHAR(200), QUOTED_RATE DOUBLE, SPREAD_BPS DOUBLE, STATUS VARCHAR(200), RESPONSE_TIME_MS INTEGER, IS_HIT BIT, COUNTERPARTY_ID VARCHAR(200), TRADER_ID VARCHAR(200))
)

// the security master's database: the views its team publishes
Database secmaster::DB
(
    Table INSTRUMENT_V (INSTRUMENT_ID VARCHAR(200) PRIMARY KEY, TICKER VARCHAR(200), NAME VARCHAR(200), ISIN VARCHAR(200), CUSIP VARCHAR(200), SEDOL VARCHAR(200), ASSET_CLASS VARCHAR(200), PRODUCT_TYPE VARCHAR(200), IS_ACTIVE BIT, LISTING_DATE DATE, MATURITY_DATE DATE, NOTIONAL_AMOUNT DOUBLE, CURRENCY VARCHAR(200), DESCRIPTION VARCHAR(200), ISSUE_DATE DATE, EQUITY_ID VARCHAR(200), BOND_ID VARCHAR(200), FUTURE_ID VARCHAR(200), FX_FORWARD_ID VARCHAR(200), SWAP_ID VARCHAR(200), CDS_ID VARCHAR(200), STRUCTURED_PRODUCT_ID VARCHAR(200), ETF_ID VARCHAR(200), CURRENCY_CODE VARCHAR(200), EXCHANGE_MIC VARCHAR(200), SECTOR_ID VARCHAR(200))
    Table EQUITY_V (EQUITY_ID VARCHAR(200) PRIMARY KEY, TICKER VARCHAR(200), COMPANY_NAME VARCHAR(200), SHARE_CLASS VARCHAR(200), MARKET_CAP DOUBLE, SHARES_OUTSTANDING DOUBLE, DIVIDEND_YIELD DOUBLE, PE_RATIO DOUBLE, BETA DOUBLE, PRIMARY_EXCHANGE VARCHAR(200), IS_ADR BIT, LOT_SIZE INTEGER, LAST_PRICE DOUBLE, PRICE_DATE DATE, INSTRUMENT_ID VARCHAR(200))
    Table OPTION_V (OPTION_ID VARCHAR(200) PRIMARY KEY, OPTION_TYPE VARCHAR(200), STRIKE_PRICE DOUBLE, EXPIRATION_DATE DATE, PREMIUM DOUBLE, IMPLIED_VOLATILITY DOUBLE, DELTA DOUBLE, GAMMA DOUBLE, THETA DOUBLE, VEGA DOUBLE, EXERCISE_STYLE VARCHAR(200), IS_IN_THE_MONEY BIT, UNDERLYING_PRICE DOUBLE, CONTRACT_SIZE INTEGER, OPEN_INTEREST INTEGER, UNDERLYING_ID VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
)

// the reference master's database
Database refmaster::DB
(
    Table EXCHANGE_V (MIC VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), CITY VARCHAR(200), TIMEZONE VARCHAR(200), OPEN_TIME VARCHAR(200), CLOSE_TIME VARCHAR(200), IS_ELECTRONIC BIT, OPERATING_MIC VARCHAR(200), WEBSITE VARCHAR(200), REGULATORY_BODY VARCHAR(200), COUNTRY_ID VARCHAR(200))
    Table SECTOR_V (SECTOR_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), GICS_CODE VARCHAR(200), LEVEL INTEGER, DESCRIPTION VARCHAR(200), IS_ACTIVE BIT, PARENT_SECTOR_ID VARCHAR(200), MARKET_CAP_WEIGHT DOUBLE, NUMBER_OF_COMPANIES INTEGER, LAST_UPDATED DATE)
)

// the organisation systems' database
Database hr::DB
(
    Table BUSINESS_UNIT_V (BU_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), HEAD VARCHAR(200), DIVISION VARCHAR(200), IS_ACTIVE BIT, HEADCOUNT INTEGER, BUDGET DOUBLE, COST_CENTER VARCHAR(200), REGION VARCHAR(200), ESTABLISHED_DATE DATE, DESCRIPTION VARCHAR(200), LEGAL_ENTITY_ID VARCHAR(200))
    Table DESK_V (DESK_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), DESK_TYPE VARCHAR(200), ASSET_CLASS VARCHAR(200), REGION VARCHAR(200), IS_ACTIVE BIT, HEAD_TRADER VARCHAR(200), COST_CENTER VARCHAR(200), FLOOR VARCHAR(200), BUILDING VARCHAR(200), PHONE VARCHAR(200), RISK_LIMIT DOUBLE, PNL_TARGET DOUBLE, BUSINESS_UNIT_ID VARCHAR(200))
    Table TRADER_V (TRADER_ID VARCHAR(200) PRIMARY KEY, FIRST_NAME VARCHAR(200), LAST_NAME VARCHAR(200), BADGE VARCHAR(200), EMAIL VARCHAR(200), HIRE_DATE DATE, SENIORITY VARCHAR(200), IS_ACTIVE BIT, SPECIALIZATION VARCHAR(200), LICENSE VARCHAR(200), MAX_NOTIONAL DOUBLE, PNL_YTD DOUBLE, PHONE VARCHAR(200), DESK_ID VARCHAR(200), MANAGER_ID VARCHAR(200))
)

// the client master's database
Database clientmaster::DB
(
    Table COUNTERPARTY_V (COUNTERPARTY_ID VARCHAR(200) PRIMARY KEY, LEGAL_NAME VARCHAR(200), SHORT_NAME VARCHAR(200), LEI VARCHAR(200), COUNTERPARTY_TYPE VARCHAR(200), DOMICILE VARCHAR(200), INCORPORATION_COUNTRY VARCHAR(200), IS_ACTIVE BIT, ONBOARD_DATE DATE, CREDIT_RATING VARCHAR(200), RATING_AGENCY VARCHAR(200), TIER VARCHAR(200), PARENT_ENTITY_ID VARCHAR(200), INDUSTRY VARCHAR(200), WEBSITE VARCHAR(200), CLASSIFICATION_ID VARCHAR(200), COUNTRY_CODE VARCHAR(200))
)

// the risk system's database
Database riskdb::DB
(
    Table RISK_LIMIT_V (LIMIT_ID VARCHAR(200) PRIMARY KEY, LIMIT_TYPE VARCHAR(200), LIMIT_AMOUNT DOUBLE, CURRENT_UTILIZATION DOUBLE, UTILIZATION_PCT DOUBLE, CURRENCY VARCHAR(200), EFFECTIVE_DATE DATE, EXPIRY_DATE DATE, STATUS VARCHAR(200), APPROVED_BY VARCHAR(200), APPROVAL_DATE DATE, WARNING_THRESHOLD DOUBLE, HARD_LIMIT DOUBLE, IS_ACTIVE BIT, DESK_ID VARCHAR(200))
)

###Lakehouse
// MARKET DATA, streamed from the ticker plant (the market data team)
Ingest marketdata::MarketDataFeed Stream
[
  MARKET_TRADE( |#>{tickerplant::Topics."tp.us-equities.trades.v3"}# ) pk=[ PRINT_ID ] writeMode=AppendOnly retention=Last('PT8H');
  MARKET_QUOTE( |#>{tickerplant::Topics."tp.us-equities.nbbo.v2"}# ) pk=[ QUOTE_ID ] writeMode=LatestByKey;
  FX_RATE( |#>{tickerplant::Topics."tp.fx.spot.v1"}# ) pk=[ RATE_ID ] writeMode=LatestByKey;
]
// NEWS, streamed from the vendor
Ingest marketdata::NewsFeed Stream
[
  NEWS_STORY( |#>{newswire::Topics."vendor.newswire.stories.v1"}# ) pk=[ STORY_ID ] writeMode=AppendOnly retention=Last('PT24H');
]
// THE ORDER SYSTEM, streamed from its drop copy
Ingest trading::OrderFlowFeed Stream
[
  TRADE_ORDER( |#>{oms::Topics."oms.equities.orders.v4"}# ) pk=[ ORDER_ID ] writeMode=LatestByKey;
  EXECUTION( |#>{oms::Topics."oms.equities.fills.v4"}# ) pk=[ EXECUTION_ID ] writeMode=AppendOnly;
  ORDER_ROUTE( |#>{oms::Topics."oms.equities.routes.v4"}# ) pk=[ ROUTE_ID ] writeMode=AppendOnly;
  RFQ( |#>{oms::Topics."oms.fx.rfqs.v2"}# ) pk=[ RFQ_ID ] writeMode=LatestByKey;
]
// THE SECURITY MASTER, pulled each morning (the security master's team)
Ingest products::SecurityMasterLoad Pull<Daily('06:00', 'America/New_York')> writeMode=LatestByKey
[
  INSTRUMENT( |#>{secmaster::DB.INSTRUMENT_V}# ) pk=[ INSTRUMENT_ID ];
  EQUITY( |#>{secmaster::DB.EQUITY_V}# ) pk=[ EQUITY_ID ];
  OPTION( |#>{secmaster::DB.OPTION_V}# ) pk=[ OPTION_ID ];
]
// THE REFERENCE MASTER: exchanges and sectors
Ingest refdata::MarketsLoad Pull<Daily('05:30', 'America/New_York')> writeMode=LatestByKey
[
  EXCHANGE( |#>{refmaster::DB.EXCHANGE_V}# ) pk=[ MIC ];
  SECTOR( |#>{refmaster::DB.SECTOR_V}# ) pk=[ SECTOR_ID ];
]
// THE ORGANISATION: business units, desks and traders
Ingest org::OrganisationLoad Pull<Daily('05:00', 'America/New_York')> writeMode=LatestByKey
[
  BUSINESS_UNIT( |#>{hr::DB.BUSINESS_UNIT_V}# ) pk=[ BU_ID ];
  DESK( |#>{hr::DB.DESK_V}# ) pk=[ DESK_ID ];
  TRADER( |#>{hr::DB.TRADER_V}# ) pk=[ TRADER_ID ];
]
// THE CLIENT MASTER
Ingest counterparty::ClientMasterLoad Pull<Daily('05:45', 'America/New_York')> writeMode=LatestByKey
[
  COUNTERPARTY( |#>{clientmaster::DB.COUNTERPARTY_V}# ) pk=[ COUNTERPARTY_ID ];
]
// RISK LIMITS, pulled every fifteen minutes
Ingest risk::LimitsLoad Pull<Every('PT15M')> writeMode=LatestByKey
[
  RISK_LIMIT( |#>{riskdb::DB.RISK_LIMIT_V}# ) pk=[ LIMIT_ID ];
]
// POSITIONS at the start of the day: position keeping drops its files
Ingest positions::StartOfDay Snapshot<Parquet> writeMode=LatestByKey
[
  POSITION( POSITION_ID: Varchar(200)[1], QUANTITY: Double, AVERAGE_COST: Double, MARKET_VALUE: Double, UNREALIZED_PN_L: Double, REALIZED_PN_L: Double, CURRENCY: Varchar(200), POSITION_DATE: StrictDate, DIRECTION: Varchar(200), COST_BASIS: Double, ACCRUED_INTEREST: Double, LAST_UPDATED: Timestamp, IS_OPEN: Boolean, SETTLEMENT_DATE: StrictDate, BOOK_ID: Varchar(200), PORTFOLIO_ID: Varchar(200), INSTRUMENT_ID: Varchar(200) ) pk=[ POSITION_ID ];
  BOOK( BOOK_ID: Varchar(200)[1], NAME: Varchar(200)[1], BOOK_TYPE: Varchar(200), CURRENCY: Varchar(200)[1], IS_ACTIVE: Boolean, OPEN_DATE: StrictDate, CLOSE_DATE: StrictDate, LEGAL_ENTITY: Varchar(200), STRATEGY: Varchar(200), PNL_YTD: Double, POSITION_COUNT: Int, RISK_LIMIT: Double, DESCRIPTION: Varchar(200), DESK_ID: Varchar(200) ) pk=[ BOOK_ID ];
]
