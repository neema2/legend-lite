// GENERATED by scripts/corpus/hier.py -- do not edit by hand.
//
// Connection, runtimes and seeded data for the hier:: feature domain. Its tables live in
// stores separate from store::DB, and test data is bound to a CONNECTION, so they need
// their own -- and each runtime needs its own connection ID, because two
// identifiedConnections sharing one inside a runtime is rejected outright.
###Connection
RelationalDatabaseConnection hier::HierConn
{
    type: DuckDB;
    specification: DuckDB { };
    auth: Test;
}


###Runtime
Runtime hier::HierRT
{
    mappings:
    [
        hier::HierMapping
    ];
    connections:
    [
        hier::HierDB: [ hierEnv: hier::HierConn ],
        hier::IssuerDB: [ issuerEnv: hier::HierConn ]
    ];
}

Runtime hier::IssuerRT
{
    mappings:
    [
        hier::IssuerMapping
    ];
    connections:
    [
        hier::HierDB: [ hierEnv: hier::HierConn ],
        hier::IssuerDB: [ issuerEnv: hier::HierConn ]
    ];
}


###Runtime
Runtime hier::IssuerProdRT
{
    mappings:
    [
        hier::IssuerMappingProd
    ];
    connections:
    [
        hier::IssuerDBProd: [ issuerProdEnv: hier::HierConn ]
    ];
}

