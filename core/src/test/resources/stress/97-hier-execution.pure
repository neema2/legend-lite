            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"issuerId":"HI-0001","profile_flagged":true},{"issuerId":"HI-0002","profile_flagged":false},{"issuerId":"HI-0003","profile_flagged":true},{"issuerId":"HI-0004","profile_flagged":false},{"issuerId":"HI-0005","profile_flagged":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

