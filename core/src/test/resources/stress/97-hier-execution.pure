Service stress::H_IssuerBinding
{
    pattern: '/stress/h_issuer_binding';
    documentation: 'Binding transformer over a JSON column on hier::Issuer. Every non-boolean leaf comes back as its raw JSON TOKEN rendered as a string (F27): a String arrives with its quotes, an Integer as "7" rather than 7. Quarantined.';
    execution: Single
    {
    query: |hier::Issuer.all()
        ->project(~[
            issuerId:x|$x.issuerId,
            profile_headquarters:x|$x.profile.headquarters,
            profile_sector:x|$x.profile.sector
        ])
        ->sort(~issuerId->ascending());
        mapping: hier::IssuerMapping;
        runtime: hier::IssuerRT;
    }
  testSuites:
  [
    H_IssuerBinding_suite:
    {
      data:
      [
        connections:
        [
          issuerEnv:
            Reference
            #{
              hier::IssuerData
            }#,
          hierEnv:
            Reference
            #{
              hier::InstrumentData
            }#
        ]
      ]
      tests:
      [
        // 3 columns over the hier:: feature mapping.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"issuerId":"HI-0001","profile_headquarters":"headquarters-001","profile_sector":"sector-001"},{"issuerId":"HI-0002","profile_headquarters":"headquarters-002","profile_sector":"sector-002"},{"issuerId":"HI-0003","profile_headquarters":"headquarters-003","profile_sector":"sector-003"},{"issuerId":"HI-0004","profile_headquarters":"headquarters-004","profile_sector":"sector-004"},{"issuerId":"HI-0005","profile_headquarters":null,"profile_sector":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::H_IssuerBindingBool
{
    pattern: '/stress/h_issuer_bindingbool';
    documentation: 'Binding transformer over a JSON column on hier::Issuer. The BOOLEAN leaves, which the engine reads back correctly -- a boolean\'s JSON token is already a boolean literal. Kept apart from the leaves F27 affects so the feature has a passing demonstration rather than only a pinned defect.';
    execution: Single
    {
    query: |hier::Issuer.all()
        ->project(~[
            issuerId:x|$x.issuerId,
            profile_flagged:x|$x.profile.flagged
