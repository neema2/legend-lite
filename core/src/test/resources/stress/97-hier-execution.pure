###Service
Service stress::H_Bond
{
    pattern: '/stress/h_bond';
    documentation: 'Executes the hier:: feature mapping for hier::Bond. Plain columns over the inheritance hierarchy\'s root set. Generated by scripts/corpus/hier.py -- the class list is derived from what the ORACLE can resolve, so a property the reader cannot model (a join chain, a Binding transformer) excludes its class automatically rather than being remembered in a list here.';
    execution: Single
    {
    query: |hier::Bond.all()
        ->project(~[
            instrumentId:x|$x.instrumentId,
            assetClass:x|$x.assetClass,
            coupon:x|$x.coupon,
            name:x|$x.name
        ])
        ->sort(~instrumentId->ascending());
        mapping: hier::HierMapping;
        runtime: hier::HierRT;
    }
  testSuites:
  [
    H_Bond_suite:
    {
      data:
      [
        connections:
        [
          hierEnv:
            Reference
            #{
              hier::InstrumentData
            }#,
          issuerEnv:
            Reference
            #{
              hier::IssuerData
            }#
        ]
      ]
      tests:
      [
        // 4 columns over the hier:: feature mapping.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

