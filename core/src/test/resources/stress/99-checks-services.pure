###Service
Service stress::CK_DeskChecked
{
    pattern: '/stress/checks/ck/deskchecked';
    documentation: 'Every desk, checked: a code\'s shape, a region in a list, an active desk\'s opening.';
    execution: Single
    {
    query: |checks::CkDesk.all()
        ->graphFetchChecked(#{
  checks::CkDesk
  {
    deskId,
    code,
    region
  }
}#)
        ->serialize(#{
  checks::CkDesk
  {
    deskId,
    code,
    region
  }
}#);
        mapping: checks::CheckMapping;
        runtime: checks::CheckRT;
    }
  testSuites:
  [
    CK_DeskChecked_suite:
    {
      data:
      [
        connections:
        [
          checkEnv:
            Reference
            #{
              checks::CheckData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 4 defects.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"defects":[],"value":{"deskId":"DSK1","code":"DSK-001","region":"EU"}},{"defects":[],"value":{"deskId":"DSK2","code":"DSK-002","region":"US"}},{"defects":[{"id":"deskCodeShape","externalId":null,"message":"Constraint :[deskCodeShape] violated in the Class CkDesk","enforcementLevel":"Error","ruleType":"ClassConstraint","ruleDefinerPath":"checks::CkDesk","path":[]}],"value":{"deskId":"DSK3","code":"DSX-003","region":"US"}},{"defects":[{"id":"deskCodeShape","externalId":null,"message":"Constraint :[deskCodeShape] violated in the Class CkDesk","enforcementLevel":"Error","ruleType":"ClassConstraint","ruleDefinerPath":"checks::CkDesk","path":[]}],"value":{"deskId":"DSK4","code":"DSK-0004","region":"APAC"}},{"defects":[{"id":"regionKnown","externalId":null,"message":"Constraint :[regionKnown] violated in the Class CkDesk","enforcementLevel":"Error","ruleType":"ClassConstraint","ruleDefinerPath":"checks::CkDesk","path":[]}],"value":{"deskId":"DSK5","code":"DSK-005","region":"LATAM"}},{"defects":[{"id":"activeDeskOpened","externalId":null,"message":"Constraint :[activeDeskOpened] violated in the Class CkDesk","enforcementLevel":"Error","ruleType":"ClassConstraint","ruleDefinerPath":"checks::CkDesk","path":[]}],"value":{"deskId":"DSK6","code":"DSK-006","region":"EU"}}]}';
                  }#;
