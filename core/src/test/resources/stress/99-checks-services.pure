Service stress::CKP_Deals
{
    pattern: '/stress/checks/ckp/deals';
    documentation: 'Every deal projected, the violators among them: a projection evaluates no constraint (F16).';
    execution: Single
    {
    query: |checks::CkDeal.all()
        ->project(~[
            dealId:x|$x.dealId,
            ref:x|$x.ref,
            state:x|$x.state,
            settleDate:x|$x.settleDate,
            tradeDate:x|$x.tradeDate
        ]);
        mapping: checks::CheckMapping;
        runtime: checks::CheckRT;
    }
  testSuites:
  [
    CKP_Deals_suite:
    {
      data:
      [
        connections:
        [
          checkEnv:
            Reference
            #{
              checks::CheckData
            }#
        ]
      ]
      tests:
      [
        // 15 rows; 0 defects.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"dealId":"D01","ref":"CK-0001","state":"OPEN","settleDate":"2024-06-05","tradeDate":"2024-06-03"},{"dealId":"D02","ref":"CK-0002","state":"OPEN","settleDate":"2024-06-03","tradeDate":"2024-06-05"},{"dealId":"D03","ref":"CK-0003","state":"CANCELLED","settleDate":"2024-06-05","tradeDate":"2024-06-03"},{"dealId":"D04","ref":"CK-0004","state":"CANCELLED","settleDate":"2024-06-05","tradeDate":"2024-06-03"},{"dealId":"D05","ref":"CK-0005","state":"OPEN","settleDate":"2024-06-05","tradeDate":"2024-06-03"},{"dealId":"D06","ref":"CK-0006","state":"OPEN","settleDate":"2024-06-05","tradeDate":"2024-06-03"},{"dealId":"D07","ref":"CK-0007","state":"OPEN","settleDate":"2024-06-05","tradeDate":"2024-06-03"},{"dealId":"D08","ref":"XK-0008","state":"OPEN","settleDate":"2024-06-05","tradeDate":"2024-06-03"},{"dealId":"D09","ref":"CK-00009","state":"OPEN","settleDate":"2024-06-05","tradeDate":"2024-06-03"},{"dealId":"D10","ref":"CK-0010","state":"OPEN","settleDate":"2024-06-05","tradeDate":"2024-06-03"},{"dealId":"D11","ref":"CK-0011","state":"OPEN","settleDate":"2024-06-05","tradeDate":"2024-06-03"},{"dealId":"D12","ref":"CK-0012","state":"SETTLED","settleDate":"2024-06-12","tradeDate":"2024-06-03"},{"dealId":"D13","ref":"CK-0013","state":"OPEN","settleDate":"2024-06-05","tradeDate":"2024-06-03"},{"dealId":"D14","ref":"CK-0014","state":"SETTLED","settleDate":"2024-06-07","tradeDate":"2024-06-03"},{"dealId":"D15","ref":"ck-0015","state":"CANCELLED","settleDate":"2024-06-05","tradeDate":"2024-06-03"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CKP_Baskets
{
    pattern: '/stress/checks/ckp/baskets';
    documentation: 'Every basket projected as a TDS with its desk\'s region, absent for B05 and B08.';
    execution: Single
    {
    query: |checks::CkBasket.all()
        ->project(
            [
                x|$x.basketId,
                x|$x.kind,
                x|$x.desk.region
            ],
            ['basketId', 'kind', 'deskRegion']
        );
        mapping: checks::CheckMapping;
        runtime: checks::CheckRT;
    }
  testSuites:
  [
    CKP_Baskets_suite:
    {
      data:
      [
        connections:
        [
          checkEnv:
            Reference
            #{
              checks::CheckData
            }#
        ]
      ]
      tests:
      [
        // 11 rows; 0 defects.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"basketId":"B01","kind":"CASH","deskRegion":"US"},{"basketId":"B02","kind":"CASH","deskRegion":"US"},{"basketId":"B03","kind":"CASH","deskRegion":"US"},{"basketId":"B04","kind":"SWAP","deskRegion":"US"},{"basketId":"B05","kind":"CASH","deskRegion":null},{"basketId":"B06","kind":"CASH","deskRegion":"EU"},{"basketId":"B07","kind":"SWAP","deskRegion":"EU"},{"basketId":"B08","kind":"CASH","deskRegion":null},{"basketId":"B09","kind":"CASH","deskRegion":"US"},{"basketId":"B10","kind":"CASH","deskRegion":"US"},{"basketId":"B11","kind":"CASH","deskRegion":"LATAM"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
