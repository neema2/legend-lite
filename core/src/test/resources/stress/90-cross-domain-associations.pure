    manager: org::PortfolioManager[1];
    portfolios: positions::Portfolio[*];
}

// ---- Positions ↔ Products ----
Association cross::Position_Instrument
{
    instrument: products::Instrument[1];
    positions: positions::Position[*];
}

// ---- Settlement ↔ Trading ----
Association cross::Settlement_Trade
{
    // [0..1], not [1]: a settlement can outlive the trade it settled (STL-9999 in the
    // seed points at a purged trade). Declaring [1] over data that has orphans makes the
    // model contradict the store, and it is that contradiction -- not the engines --
    // that makes "what is $s.trade.isSettled when there is no trade" unanswerable.
    trade: trading::Trade[0..1];
    settlements: settlement::Settlement[*];
}

