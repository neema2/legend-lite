      [
        // 8 rows; 14 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"bookId":"BK-CASH-US","name":"US Cash Equity","currency":"USD","isActive":true,"deskName":"Cash Equities","deskRegion":"Americas","tradeCount":10,"positionCount":2,"pnlCount":2},{"bookId":"BK-CASH-EU","name":"EMEA Cash Equity","currency":"EUR","isActive":true,"deskName":"Cash Equities","deskRegion":"Americas","tradeCount":5,"positionCount":2,"pnlCount":2},{"bookId":"BK-VOL-01","name":"Volatility Arb","currency":"USD","isActive":true,"deskName":"Equity Derivatives","deskRegion":"EMEA","tradeCount":5,"positionCount":1,"pnlCount":2},{"bookId":"BK-LEGACY","name":"Legacy Wind-down","currency":"GBP","isActive":false,"deskName":"Equity Derivatives","deskRegion":"EMEA","tradeCount":0,"positionCount":1,"pnlCount":0},{"bookId":"BK-EQ","name":"Equity derivatives","currency":"USD","isActive":true,"deskName":"Cash Equities","deskRegion":"Americas","tradeCount":0,"positionCount":0,"pnlCount":0},{"bookId":"BK-FX","name":"FX trading","currency":"USD","isActive":true,"deskName":"Cash Equities","deskRegion":"Americas","tradeCount":0,"positionCount":0,"pnlCount":0},{"bookId":"BK-RATES","name":"Rates trading","currency":"EUR","isActive":true,"deskName":"Cash Equities","deskRegion":"Americas","tradeCount":0,"positionCount":0,"pnlCount":0},{"bookId":"BK-CREDIT","name":"Credit trading","currency":"USD","isActive":false,"deskName":"Cash Equities","deskRegion":"Americas","tradeCount":0,"positionCount":0,"pnlCount":0}]';
