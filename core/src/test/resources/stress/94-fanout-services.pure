Service stress::DSLocal_CapitalGain
{
    pattern: '/stress/dslocal_capitalgain';
    documentation: 'A filter, a computed column, a composite sort and a limit stacked on tax::CapitalGain -- which cannot navigate anywhere, because its ends are inherited and F49 makes those unnavigable from a subtype\'s set. Depth being unavailable is not a reason to leave the query bare. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |tax::CapitalGain.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            gainId:x|$x.gainId,
            currency:x|$x.currency
        ])
        ->sort(~gainId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSLocal_CapitalGain_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"gainId":"CG-0002","currency":"GBP"},{"gainId":"CG-0003","currency":"EUR"},{"gainId":"CG-0004","currency":"USD"},{"gainId":"CG-0005","currency":"JPY"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

