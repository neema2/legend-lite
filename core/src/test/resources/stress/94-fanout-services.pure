                    data: '[{"recordId":"CSI-00001","bookRollupBookCurrency":null,"bookDeskBusinessUnitName":null,"bookRollupBookId":null,"notionalPerRiskPoint":1000000.0,"notionalInQ":625000.0},{"recordId":"CSI-00002","bookRollupBookCurrency":null,"bookDeskBusinessUnitName":null,"bookRollupBookId":null,"notionalPerRiskPoint":1666666.6666666667,"notionalInQ":1250000.0},{"recordId":"CSI-00003","bookRollupBookCurrency":null,"bookDeskBusinessUnitName":null,"bookRollupBookId":null,"notionalPerRiskPoint":2142857.1428571427,"notionalInQ":1875000.0},{"recordId":"CSI-00004","bookRollupBookCurrency":null,"bookDeskBusinessUnitName":null,"bookRollupBookId":null,"notionalPerRiskPoint":2500000.0,"notionalInQ":2500000.0},{"recordId":"CSI-00005","bookRollupBookCurrency":null,"bookDeskBusinessUnitName":null,"bookRollupBookId":null,"notionalPerRiskPoint":2777777.777777778,"notionalInQ":3125000.0},{"recordId":"CSI-00006","bookRollupBookCurrency":null,"bookDeskBusinessUnitName":null,"bookRollupBookId":null,"notionalPerRiskPoint":3000000.0,"notionalInQ":3750000.0},{"recordId":"CSI-00010","bookRollupBookCurrency":null,"bookDeskBusinessUnitName":null,"bookRollupBookId":null,"notionalPerRiskPoint":3571428.5714285714,"notionalInQ":6250000.0},{"recordId":"CSI-00011","bookRollupBookCurrency":null,"bookDeskBusinessUnitName":null,"bookRollupBookId":null,"notionalPerRiskPoint":3666666.6666666665,"notionalInQ":6875000.0},{"recordId":"CSI-00012","bookRollupBookCurrency":null,"bookDeskBusinessUnitName":null,"bookRollupBookId":null,"notionalPerRiskPoint":3750000.0,"notionalInQ":7500000.0},{"recordId":"CSI-00013","bookRollupBookCurrency":null,"bookDeskBusinessUnitName":null,"bookRollupBookId":null,"notionalPerRiskPoint":3823529.411764706,"notionalInQ":8125000.0},{"recordId":"CSI-00014","bookRollupBookCurrency":null,"bookDeskBusinessUnitName":null,"bookRollupBookId":null,"notionalPerRiskPoint":3888888.888888889,"notionalInQ":8750000.0},{"recordId":"CSI-00015","bookRollupBookCurrency":null,"bookDeskBu