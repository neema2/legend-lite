Service stress::DSAgg_PnlAccrualEntry
{
    pattern: '/stress/dsagg_pnlaccrualentry';
    documentation: 'groupBy on a local key of pnl::AccrualEntry with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |pnl::AccrualEntry.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            accrualId:x|$x.accrualId,
            dayCount:x|$x.dayCount
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.accrualId : agg|$agg->count(),
            total: x|$x.dayCount : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_PnlAccrualEntry_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"EUR","n":1,"total":null},{"currency":"GBP","n":1,"total":24},{"currency":"USD","n":2,"total":55}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

