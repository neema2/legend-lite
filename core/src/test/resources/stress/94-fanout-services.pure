              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"recordId":"CRP-00001","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00002","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00003","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00004","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00005","book":null},{"recordId":"CRP-00006","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00010","book":null},{"recordId":"CRP-00011","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00012","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00013","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00014","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00015","book":null},{"recordId":"CRP-00019","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00020","book":null},{"recordId":"CRP-00021","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00022","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00023","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00024","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00028","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00029","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00030","book":null},{"recordId":"CRP-00031","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00032","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00033","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00037","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00038","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00039","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":