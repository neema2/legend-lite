Service stress::DSAgg_DailyPnL
{
    pattern: '/stress/dsagg_dailypnl';
    documentation: 'groupBy on a local key of pnl::DailyPnL with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |pnl::DailyPnL.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            pnlId:x|$x.pnlId,
            version:x|$x.version
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.pnlId : agg|$agg->count(),
            total: x|$x.version : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_DailyPnL_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"USD","n":7,"total":7}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

