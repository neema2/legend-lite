                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"recordId":"BSI-00028","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"BSI-00029","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"BSI-00030","book":null}]}';
