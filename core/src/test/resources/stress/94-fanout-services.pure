    pattern: '/stress/cevx_corpactionsxstocksplit';
    documentation: 'corpactionsx::StockSplit only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |corpactionsx::StockSplit.all()
        ->project(~[
            recordId:x|$x.recordId,
            recordType:x|$x.recordType,
            notionalPerRiskPoint:x|$x.notionalPerRiskPoint,
            notionalGbp:x|$x.notionalIn(0.79),
            currency:x|$x.currency,
            maturityDate:x|$x.maturityDate,
            isActive:x|$x.isActive
        ])
        ->sort(~recordId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CEVX_CorpactionsxStockSplit_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"recordId":"CEV-00010","recordType":"STOCK_SPLIT","notionalPerRiskPoint":3571428.5714285714,"notionalGbp":9875000.0,"currency":"CHF","maturityDate":"2026-10-10","isActive":true},{"recordId":"CEV-00011","recordType":"STOCK_SPLIT","notionalPerRiskPoint":3666666.6666666665,"notionalGbp":10862500.0,"currency":"USD","maturityDate":"2027-11-11","isActive":false},{"recordId":"CEV-00012","recordType":"STOCK_SPLIT","notionalPerRiskPoint":3750000.0,"notionalGbp":11850000.0,"currency":"EUR","maturityDate":"2028-12-12","isActive":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

