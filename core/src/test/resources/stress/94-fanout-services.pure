    documentation: 'A filter, a computed column, a composite sort and a limit stacked on settlement::SettlementInstruction -- which cannot navigate anywhere, because its ends are inherited and F49 makes those unnavigable from a subtype\'s set. Depth being unavailable is not a reason to leave the query bare. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |settlement::SettlementInstruction.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            instructionId:x|$x.instructionId,
            currency:x|$x.currency
        ])
        ->sort(~instructionId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSLocal_SettlementSettlementInstruction_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"instructionId":"SI-0002","currency":"GBP"},{"instructionId":"SI-0003","currency":"EUR"},{"instructionId":"SI-0004","currency":"USD"},{"instructionId":"SI-0005","currency":"JPY"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

