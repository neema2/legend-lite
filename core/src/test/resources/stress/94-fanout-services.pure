Service stress::TM_CounterpartyCounterpartyEmpty
{
    pattern: '/stress/tm_counterpartycounterparty';
    documentation: 'Emptiness of 4 to-many association(s) on counterparty::Counterparty. Both `isEmpty` and `isNotEmpty` are projected for each end: asserting one alone would let a constant answer pass, and asserting both means the service is green only where the two disagree row by row. The corpus declares 177 to-many ends and traversed twelve; `count()` cannot carry the volume because F6 makes it return 1 over an empty set, and these predicates are correct there. Generated by scripts/corpus/tomany.py.';
    execution: Single
    {
    query: |counterparty::Counterparty.all()
        ->project(~[
            counterpartyId:x|$x.counterpartyId,
            accountsEmpty:x|$x.accounts->isEmpty(),
            accountsAny:x|$x.accounts->isNotEmpty(),
            agreementsEmpty:x|$x.agreements->isEmpty(),
            agreementsAny:x|$x.agreements->isNotEmpty(),
            beneficialOwnersEmpty:x|$x.beneficialOwners->isEmpty(),
            beneficialOwnersAny:x|$x.beneficialOwners->isNotEmpty(),
            collateralAgreementsEmpty:x|$x.collateralAgreements->isEmpty(),
            collateralAgreementsAny:x|$x.collateralAgreements->isNotEmpty()
        ])
        ->sort(~counterpartyId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TM_CounterpartyCounterpartyEmpty_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 20 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"counterpartyId":"CP-0001","accountsEmpty":false,"accountsAny":true,"agreementsEmpty":false,"agreementsAny":true,"beneficialOwnersEmpty":false,"beneficialOwnersAny":true,"collateralAgreementsEmpty":false,"collateralAgreementsAny":true},{"counterpartyId":"CP-0002","accountsEmpty":false,"accountsAny":true,"agreementsEmpty":false,"agreementsAny":true,"beneficialOwnersEmpty":false,"beneficialOwnersAny":true,"collateralAgreementsEmpty":false,"collateralAgreementsAny":true},{"counterpartyId":"CP-0003","accountsEmpty":false,"accountsAny":true,"agreementsEmpty":false,"agreementsAny":true,"beneficialOwnersEmpty":false,"beneficialOwnersAny":true,"collateralAgreementsEmpty":false,"collateralAgreementsAny":true},{"counterpartyId":"CP-0004","accountsEmpty":true,"accountsAny":false,"agreementsEmpty":true,"agreementsAny":false,"beneficialOwnersEmpty":true,"beneficialOwnersAny":false,"collateralAgreementsEmpty":true,"collateralAgreementsAny":false},{"counterpartyId":"CP-0005","accountsEmpty":true,"accountsAny":false,"agreementsEmpty":true,"agreementsAny":false,"beneficialOwnersEmpty":true,"beneficialOwnersAny":false,"collateralAgreementsEmpty":true,"collateralAgreementsAny":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

