Service stress::MKTX_All
{
    pattern: '/stress/mktx_all';
    documentation: 'Every row of marks::MarketDataPoint, unfiltered. The subtype services partition this same table by discriminator; this is the whole of it, and therefore the only service that would show a row whose type code matches no subtype at all. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |marks::MarketDataPoint.all()
        ->project(~[
            pointId:x|$x.pointId,
            dataType:x|$x.dataType,
            dailyChange:x|$x.dailyChange,
            source:x|$x.source,
            tenor:x|$x.tenor,
            isStale:x|$x.isStale
        ])
        ->sort(~pointId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MKTX_All_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 15 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"pointId":"MKT-00001","dataType":"SPOT_PRICE","dailyChange":0.0,"source":"Bloomberg","tenor":null,"isStale":true},{"pointId":"MKT-00002","dataType":"CLOSING_PRICE","dailyChange":0.85,"source":"Refinitiv","tenor":"5Y","isStale":false},{"pointId":"MKT-00004","dataType":"BID_PRICE","dailyChange":0.0,"source":"ICE","tenor":"2Y","isStale":false},{"pointId":"MKT-00005","dataType":"ASK_PRICE","dailyChange":0.85,"source":"Bloomberg","tenor":null,"isStale":false},{"pointId":"MKT-00007","dataType":"CREDIT_CURVE_POINT","dailyChange":0.0,"source":"INTERNAL","tenor":null,"isStale":false},{"pointId":"MKT-00008","dataType":"VOL_SURFACE_POINT","dailyChange":0.85,"source":"ICE","tenor":"5Y","isStale":true},{"pointId":"MKT-00010","dataType":"FX_FORWARD_POINT","dailyChange":0.0,"source":"Refinitiv","tenor":"2Y","isStale":false},{"pointId":"MKT-00011","dataType":"BASIS_SPREAD","dailyChange":0.85,"source":"INTERNAL","tenor":null,"isStale":false},{"pointId":"MKT-00013","dataType":"FIXING_RATE","dailyChange":0.0,"source":"Bloomberg","tenor":null,"isStale":false},{"pointId":"MKT-00014","dataType":"INFLATION_INDEX","dailyChange":0.85,"source":"Refinitiv","tenor":"5Y","isStale":false},{"pointId":"MKT-00016","dataType":"BORROW_RATE","dailyChange":0.0,"source":"ICE","tenor":"2Y","isStale":false},{"pointId":"MKT-00017","dataType":"RECOVERY_RATE","dailyChange":0.85,"source":"Bloomberg","tenor":null,"isStale":false},{"pointId":"MKT-00019","dataType":"COMMODITY_CURVE_POINT","dailyChange":0.0,"source":"INTERNAL","tenor":null,"isStale":false},{"pointId":"MKT-00020","dataType":"VOLATILITY_INDEX","dailyChange":0.85,"source":"ICE","tenor":"5Y","isStale":false},{"pointId":"MKT-00022","dataType":"SWAP_RATE","dailyChange":0.0,"source":"Refinitiv","tenor":"2Y","isStale":true}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

