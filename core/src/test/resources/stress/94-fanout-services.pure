Service stress::DSAgg_CgTimeZone
{
    pattern: '/stress/dsagg_cgtimezone';
    documentation: 'groupBy on a local key of core_geo::CgTimeZone with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |core_geo::CgTimeZone.all()
        ->filter({x|($x.abbreviation > ' ')})
        ->project(~[
            abbreviation:x|$x.abbreviation,
            timeZoneId:x|$x.timeZoneId,
            utcOffsetMinutes:x|$x.utcOffsetMinutes
        ])
        ->groupBy(~[abbreviation], ~[
            n: x|$x.timeZoneId : agg|$agg->count(),
            total: x|$x.utcOffsetMinutes : agg|$agg->sum()
        ])
        ->sort(~abbreviation->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_CgTimeZone_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"abbreviation":"CET","n":1,"total":60},{"abbreviation":"GMT","n":1,"total":0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

