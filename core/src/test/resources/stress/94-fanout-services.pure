    pattern: '/stress/dsagg_department';
    documentation: 'groupBy on a local key of org::Department with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |org::Department.all()
        ->filter({x|($x.name > ' ')})
        ->project(~[
            name:x|$x.name,
            departmentId:x|$x.departmentId,
            headcount:x|$x.headcount
        ])
        ->groupBy(~[name], ~[
            n: x|$x.departmentId : agg|$agg->count(),
            total: x|$x.headcount : agg|$agg->sum()
        ])
        ->sort(~name->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
