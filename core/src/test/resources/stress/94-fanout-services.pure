          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"measureId":"MEAS-00001","measureType":"HISTORICAL_VAR","confidence":0.99,"horizonDays":1,"measureValue":4185000.0,"modelName":"HS-520D","valueEur":3850200.0,"cobDate":"2024-06-28"},{"measureId":"MEAS-00002","measureType":"PARAMETRIC_VAR","confidence":0.99,"horizonDays":1,"measureValue":3920000.0,"modelName":"VCV-260D","valueEur":3606400.0,"cobDate":"2024-06-28"},{"measureId":"MEAS-00003","measureType":"MONTE_CARLO_VAR","confidence":0.99,"horizonDays":1,"measureValue":4310000.0,"modelName":"MC-10K","valueEur":3965200.0,"cobDate":"2024-06-28"},{"measureId":"MEAS-00004","measureType":"EXPECTED_SHORTFALL","confidence":0.975,"horizonDays":1,"measureValue":5240000.0,"modelName":"ES-520D","valueEur":4820800.0,"cobDate":"2024-06-28"},{"measureId":"MEAS-00005","measureType":"STRESSED_VAR","confidence":0.99,"horizonDays":10,"measureValue":11800000.0,"modelName":"SVAR-2008","valueEur":10856000.0,"cobDate":"2024-06-28"},{"measureId":"MEAS-00006","measureType":"CVA","confidence":null,"horizonDays":null,"measureValue":862000.0,"modelName":"XVA-2024.1","valueEur":793040.0,"cobDate":"2024-06-28"},{"measureId":"MEAS-00007","measureType":"DVA","confidence":null,"horizonDays":null,"measureValue":415000.0,"modelName":"XVA-2024.1","valueEur":381800.0,"cobDate":"2024-06-28"},{"measureId":"MEAS-00008","measureType":"FVA","confidence":null,"horizonDays":null,"measureValue":228000.0,"modelName":"XVA-2024.1","valueEur":209760.0,"cobDate":"2024-06-28"},{"measureId":"MEAS-00009","measureType":"PFE","confidence":0.95,"horizonDays":1825,"measureValue":18400000.0,"modelName":"CCR-2024.1","valueEur":16928000.0,"cobDate":"2024-06-28"},{"measureId":"MEAS-00010","measureType":"HISTORICAL_VAR","confidence":0.99,"horizonDays":1,"measureValue":1320000.0,"modelName":"HS-520D","valueEur":1214400.0,"cobDate":"2024-06-28"},{"measureId":"MEAS-00011","measureType":"HISTORICAL_VAR","confidence":0.99,"horizonDays":1,"measureValue":4092000.0,"modelName":"HS-520D","valueEur":3764640.0,"cobDate":"2024-06-27"}]';
