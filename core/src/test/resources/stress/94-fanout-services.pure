Service stress::DSDeep_CreditTotalReturnSwap
{
    pattern: '/stress/dsdeep_credittotalreturnswap';
    documentation: 'The deepest to-one reach creditstructures::CreditTotalReturnSwap offers, filtered on a NAVIGATED column rather than a local one, composite-sorted and limited. A predicate over a joined column has to be placed relative to the join, which a filter on the root never tests. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |creditstructures::CreditTotalReturnSwap.all()
        ->filter({x|($x.book.desk.businessUnit.legalEntity.jurisdiction > ' ')})
        ->project(~[
            recordId:x|$x.recordId,
            bookDeskBusinessUnitLegalEntityJurisdiction:x|$x.book.desk.businessUnit.legalEntity.jurisdiction,
            bookDeskBusinessUnitName:x|$x.book.desk.businessUnit.name,
            bookRollupBookId:x|$x.book.rollup.bookId,
            bookDeskName:x|$x.book.desk.name
        ])
        ->sort(~recordId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSDeep_CreditTotalReturnSwap_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 0 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

