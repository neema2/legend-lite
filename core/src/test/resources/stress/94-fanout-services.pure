Service stress::CRXX_All
{
    pattern: '/stress/crxx_all';
    documentation: 'Every row of creditstructures::CreditStructure, unfiltered. The subtype services partition this same table by discriminator; this is the whole of it, and therefore the only service that would show a row whose type code matches no subtype at all. Generated by scripts/corpus/taxonomy.py.';
