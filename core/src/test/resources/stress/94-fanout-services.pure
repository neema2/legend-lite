    pattern: '/stress/dssub_operationallosstolerance';
    documentation: 'Rooted at the SUBTYPE appetitemetrics::OperationalLossTolerance and navigating its OWN ends. 1828 class mappings in this corpus extend another set, and almost nothing has ever navigated out of one -- the services over them project local columns and stop. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |appetitemetrics::OperationalLossTolerance.all()
        ->filter({x|($x.book.desk.businessUnit.legalEntity.jurisdiction > ' ')})
        ->project(~[
            recordId:x|$x.recordId,
            bookDeskBusinessUnitLegalEntityJurisdiction:x|$x.book.desk.businessUnit.legalEntity.jurisdiction,
            bookDeskBusinessUnitName:x|$x.book.desk.businessUnit.name,
            bookRollupBookId:x|$x.book.rollup.bookId
        ])
        ->sort(~recordId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSSub_OperationalLossTolerance_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 0 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSLocal_RiskAppetiteMetric
{
    pattern: '/stress/dslocal_riskappetitemetric';
    documentation: 'A filter, a computed column, a composite sort and a limit stacked on appetitemetrics::RiskAppetiteMetric -- which cannot navigate anywhere, because its ends are inherited and F49 makes those unnavigable from a subtype\'s set. Depth being unavailable is not a reason to leave the query bare. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |appetitemetrics::RiskAppetiteMetric.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            recordId:x|$x.recordId,
            currency:x|$x.currency,
            notionalPerRiskPoint:x|$x.notionalPerRiskPoint
        ])
        ->sort(~recordId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSLocal_RiskAppetiteMetric_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 25 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"recordId":"RAP-00001","currency":"USD","notionalPerRiskPoint":1000000.0},{"recordId":"RAP-00002","currency":"EUR","notionalPerRiskPoint":1666666.6666666667},{"recordId":"RAP-00003","currency":"GBP","notionalPerRiskPoint":2142857.1428571427},{"recordId":"RAP-00004","currency":"JPY","notionalPerRiskPoint":2500000.0},{"recordId":"RAP-00005","currency":"CHF","notionalPerRiskPoint":2777777.777777778},{"recordId":"RAP-00006","currency":"USD","notionalPerRiskPoint":3000000.0},{"recordId":"RAP-00010","currency":"CHF","notionalPerRiskPoint":3571428.5714285714},{"recordId":"RAP-00011","currency":"USD","notionalPerRiskPoint":3666666.6666666665},{"recordId":"RAP-00012","currency":"EUR","notionalPerRiskPoint":3750000.0},{"recordId":"RAP-00013","currency":"GBP","notionalPerRiskPoint":3823529.411764706},{"recordId":"RAP-00014","currency":"JPY","notionalPerRiskPoint":3888888.888888889},{"recordId":"RAP-00015","currency":"CHF","notionalPerRiskPoint":3947368.4210526315},{"recordId":"RAP-00019","currency":"JPY","notionalPerRiskPoint":4130434.782608696},{"recordId":"RAP-00020","currency":"CHF","notionalPerRiskPoint":4166666.6666666665},{"recordId":"RAP-00021","currency":"USD","notionalPerRiskPoint":4200000.0},{"recordId":"RAP-00022","currency":"EUR","notionalPerRiskPoint":4230769.230769231},{"recordId":"RAP-00023","currency":"GBP","notionalPerRiskPoint":4259259.259259259},{"recordId":"RAP-00024","currency":"JPY","notionalPerRiskPoint":4285714.285714285},{"recordId":"RAP-00028","currency":"GBP","notionalPerRiskPoint":4375000.0},{"recordId":"RAP-00029","currency":"JPY","notionalPerRiskPoint":4393939.393939394},{"recordId":"RAP-00030","currency":"CHF","notionalPerRiskPoint":4411764.705882353},{"recordId":"RAP-00031","currency":"USD","notionalPerRiskPoint":4428571.428571428},{"recordId":"RAP-00032","currency":"EUR","notionalPerRiskPoint":4444444.444444444},{"recordId":"RAP-00033","currency":"GBP","notionalPerRiskPoint":4459459.459459459},{"recordId":"RAP-00037","currency":"EUR","notionalPerRiskPoint":4512195.12195122}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
