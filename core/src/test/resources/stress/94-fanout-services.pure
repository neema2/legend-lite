Service stress::IDNX_All
{
    pattern: '/stress/idnx_all';
    documentation: 'Every row of identifiers::InstrumentIdentifier, unfiltered. The subtype services partition this same table by discriminator; this is the whole of it, and therefore the only service that would show a row whose type code matches no subtype at all. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |identifiers::InstrumentIdentifier.all()
        ->project(~[
            recordId:x|$x.recordId,
            recordType:x|$x.recordType,
            notionalPerRiskPoint:x|$x.notionalPerRiskPoint,
            notionalGbp:x|$x.notionalIn(0.79),
            currency:x|$x.currency,
            maturityDate:x|$x.maturityDate,
            isActive:x|$x.isActive
        ])
        ->sort(~recordId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    IDNX_All_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 33 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"recordId":"IDN-00001","recordType":"ISIN","notionalPerRiskPoint":1000000.0,"notionalGbp":987500.0,"currency":"USD","maturityDate":null,"isActive":true},{"recordId":"IDN-00002","recordType":"ISIN","notionalPerRiskPoint":1666666.6666666667,"notionalGbp":1975000.0,"currency":"EUR","maturityDate":"2026-02-02","isActive":true},{"recordId":"IDN-00003","recordType":"ISIN","notionalPerRiskPoint":2142857.1428571427,"notionalGbp":2962500.0,"currency":"GBP","maturityDate":"2027-03-03","isActive":false},{"recordId":"IDN-00004","recordType":"CUSIP","notionalPerRiskPoint":2500000.0,"notionalGbp":3950000.0,"currency":"JPY","maturityDate":"2028-04-04","isActive":false},{"recordId":"IDN-00005","recordType":"CUSIP","notionalPerRiskPoint":2777777.777777778,"notionalGbp":4937500.0,"currency":"CHF","maturityDate":null,"isActive":true},{"recordId":"IDN-00006","recordType":"CUSIP","notionalPerRiskPoint":3000000.0,"notionalGbp":5925000.0,"currency":"USD","maturityDate":"2026-06-06","isActive":true},{"recordId":"IDN-00010","recordType":"FIGI","notionalPerRiskPoint":3571428.5714285714,"notionalGbp":9875000.0,"currency":"CHF","maturityDate":"2026-10-10","isActive":true},{"recordId":"IDN-00011","recordType":"FIGI","notionalPerRiskPoint":3666666.6666666665,"notionalGbp":10862500.0,"currency":"USD","maturityDate":"2027-11-11","isActive":false},{"recordId":"IDN-00012","recordType":"FIGI","notionalPerRiskPoint":3750000.0,"notionalGbp":11850000.0,"currency":"EUR","maturityDate":"2028-12-12","isActive":false},{"recordId":"IDN-00013","recordType":"RIC","notionalPerRiskPoint":3823529.411764706,"notionalGbp":12837500.0,"currency":"GBP","maturityDate":null,"isActive":true},{"recordId":"IDN-00014","recordType":"RIC","notionalPerRiskPoint":3888888.888888889,"notionalGbp":13825000.0,"currency":"JPY","maturityDate":"2026-02-14","isActive":true},{"recordId":"IDN-00015","recordType":"RIC","notionalPerRiskPoint":3947368.4210526315,"notionalGbp":14812500.0,"currency":"CHF","maturityDate":"2027-03-15","isActive":false},{"recordId":"IDN-00019","recordType":"LEI","notionalPerRiskPoint":4130434.782608696,"notionalGbp":18762500.0,"currency":"JPY","maturityDate":"2027-07-19","isActive":false},{"recordId":"IDN-00020","recordType":"LEI","notionalPerRiskPoint":4166666.6666666665,"notionalGbp":19750000.0,"currency":"CHF","maturityDate":"2028-08-20","isActive":false},{"recordId":"IDN-00021","recordType":"LEI","notionalPerRiskPoint":4200000.0,"notionalGbp":20737500.0,"currency":"USD","maturityDate":null,"isActive":true},{"recordId":"IDN-00022","recordType":"UPI","notionalPerRiskPoint":4230769.230769231,"notionalGbp":21725000.0,"currency":"EUR","maturityDate":"2026-10-22","isActive":true},{"recordId":"IDN-00023","recordType":"UPI","notionalPerRiskPoint":4259259.259259259,"notionalGbp":22712500.0,"currency":"GBP","maturityDate":"2027-11-23","isActive":false},{"recordId":"IDN-00024","recordType":"UPI","notionalPerRiskPoint":4285714.285714285,"notionalGbp":23700000.0,"currency":"JPY","maturityDate":"2028-12-24","isActive":false},{"recordId":"IDN-00028","recordType":"MIC","notionalPerRiskPoint":4375000.0,"notionalGbp":27650000.0,"currency":"GBP","maturityDate":"2028-04-01","isActive":false},{"recordId":"IDN-00029","recordType":"MIC","notionalPerRiskPoint":4393939.393939394,"notionalGbp":28637500.0,"currency":"JPY","maturityDate":null,"isActive":true},{"recordId":"IDN-00030","recordType":"MIC","notionalPerRiskPoint":4411764.705882353,"notionalGbp":29625000.0,"currency":"CHF","maturityDate":"2026-06-03","isActive":true},{"recordId":"IDN-00031","recordType":"CFI","notionalPerRiskPoint":4428571.428571428,"notionalGbp":30612500.0,"currency":"USD","maturityDate":"2027-07-04","isActive":false},{"recordId":"IDN-00032","recordType":"CFI","notionalPerRiskPoint":4444444.444444444,"notionalGbp":31600000.0,"currency":"EUR","maturityDate":"2028-08-05","isActive":false},{"recordId":"IDN-00033","recordType":"CFI","notionalPerRiskPoint":4459459.459459459,"notionalGbp":3258750