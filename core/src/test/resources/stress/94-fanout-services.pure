Service stress::DSAgg_ClientActivity
{
    pattern: '/stress/dsagg_clientactivity';
    documentation: 'groupBy on a local key of sales::ClientActivity with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |sales::ClientActivity.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            activityId:x|$x.activityId,
            tradeCount:x|$x.tradeCount
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.activityId : agg|$agg->count(),
            total: x|$x.tradeCount : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_ClientActivity_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"EUR","n":1,"total":38},{"currency":"GBP","n":1,"total":31},{"currency":"JPY","n":1,"total":null},{"currency":"USD","n":1,"total":45}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

