Service stress::DSAgg_ProductsOption
{
    pattern: '/stress/dsagg_productsoption';
    documentation: 'groupBy on a local key of products::Option with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |products::Option.all()
        ->filter({x|($x.exerciseStyle > ' ')})
        ->project(~[
            exerciseStyle:x|$x.exerciseStyle,
            optionId:x|$x.optionId,
            contractSize:x|$x.contractSize
        ])
        ->groupBy(~[exerciseStyle], ~[
            n: x|$x.optionId : agg|$agg->count(),
            total: x|$x.contractSize : agg|$agg->sum()
        ])
        ->sort(~exerciseStyle->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_ProductsOption_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"exerciseStyle":"EXERCISE-STYLE-001","n":1,"total":290},{"exerciseStyle":"EXERCISE-STYLE-003","n":1,"total":304},{"exerciseStyle":"EXERCISE-STYLE-004","n":1,"total":311},{"exerciseStyle":"EXERCISE-STYLE-005","n":1,"total":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

