Service stress::DSTree_LeverageRatioTarget
{
    pattern: '/stress/dstree_leverageratiotarget';
    documentation: 'A graphFetch 4 levels deep from appetitemetrics::LeverageRatioTarget. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
