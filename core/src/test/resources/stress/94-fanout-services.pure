Service stress::CV3_PillarNeighbours
{
    pattern: '/stress/cv3';
    documentation: 'For each pillar except the longest, how many pillars on the same curve and date sit further out. The join is a three-column self-join with an inequality on the third -- the join a forward rate is computed across, and the first thing in the corpus to put one under a composite primary key. The 30Y is filtered out because it has nothing longer than it and F6 makes count() over an empty to-many return 1.';
    execution: Single
    {
    query: |curves::CurvePoint.all()
        ->filter({x|($x.tenorLabel != '30Y')})
        ->project(~[
            curveId:x|$x.curveId,
            cobDate:x|$x.cobDate,
            tenorLabel:x|$x.tenorLabel,
            tenorDays:x|$x.tenorDays,
            zeroRate:x|$x.zeroRate,
            pillarsFurtherOut:x|$x.longerPillars->count()
        ])
        ->sort([~curveId->ascending(), ~cobDate->ascending(), ~tenorLabel->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CV3_PillarNeighbours_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 176 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"10Y","tenorDays":3653,"zeroRate":2.51,"pillarsFurtherOut":3},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"15Y","tenorDays":5479,"zeroRate":2.63,"pillarsFurtherOut":2},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"1M","tenorDays":30,"zeroRate":3.61,"pillarsFurtherOut":11},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"1Y","tenorDays":365,"zeroRate":3.24,"pillarsFurtherOut":8},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"20Y","tenorDays":7305,"zeroRate":2.66,"pillarsFurtherOut":1},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"2Y","tenorDays":730,"zeroRate":2.94,"pillarsFurtherOut":7},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"3M","tenorDays":91,"zeroRate":3.55,"pillarsFurtherOut":10},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"3Y","tenorDays":1095,"zeroRate":2.75,"pillarsFurtherOut":6},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"5Y","tenorDays":1826,"zeroRate":2.55,"pillarsFurtherOut":5},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"6M","tenorDays":182,"zeroRate":3.44,"pillarsFurtherOut":9},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"7Y","tenorDays":2556,"zeroRate":2.53,"pillarsFurtherOut":4},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"10Y","tenorDays":3653,"zeroRate":2.46,"pillarsFurtherOut":3},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"15Y","tenorDays":5479,"zeroRate":2.6,"pillarsFurtherOut":2},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"1M","tenorDays":30,"zeroRate":3.6,"pillarsFurtherOut":11},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"1Y","tenorDays":365,"zeroRate":3.2,"pillarsFurtherOut":8},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"20Y","tenorDays":7305,"zeroRate":2.64,"pillarsFurtherOut":1},{"curveI