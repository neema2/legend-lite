Service stress::TFIX_AvalisedDraft
{
    pattern: '/stress/tfix_avaliseddraft';
    documentation: 'tradefinance::AvalisedDraft only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |tradefinance::AvalisedDraft.all()
        ->project(~[
            recordId:x|$x.recordId,
            recordType:x|$x.recordType,
            notionalPerRiskPoint:x|$x.notionalPerRiskPoint,
            notionalGbp:x|$x.notionalIn(0.79),
            currency:x|$x.currency,
            maturityDate:x|$x.maturityDate,
            isActive:x|$x.isActive
        ])
        ->sort(~recordId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TFIX_AvalisedDraft_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"recordId":"TFI-00028","recordType":"AVALISED_DRAFT","notionalPerRiskPoint":4375000.0,"notionalGbp":27650000.0,"currency":"GBP","maturityDate":"2028-04-01","isActive":false},{"recordId":"TFI-00029","recordType":"AVALISED_DRAFT","notionalPerRiskPoint":4393939.393939394,"notionalGbp":28637500.0,"currency":"JPY","maturityDate":null,"isActive":true},{"recordId":"TFI-00030","recordType":"AVALISED_DRAFT","notionalPerRiskPoint":4411764.705882353,"notionalGbp":29625000.0,"currency":"CHF","maturityDate":"2026-06-03","isActive":true}]';
