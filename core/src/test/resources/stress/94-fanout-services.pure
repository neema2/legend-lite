                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"breakId":"BRK-00001","breakType":"ECONOMIC_BREAK","severity":"HIGH","status":"OPEN","ageDays":51,"resolvedDate":null,"fieldName":"STRIKE","ourValue":"1.0850","theirValue":"1.0855"},{"breakId":"BRK-00002","breakType":"CONFIRMATION_BREAK","severity":"MEDIUM","status":"OPEN","ageDays":144,"resolvedDate":null,"fieldName":null,"ourValue":null,"theirValue":null},{"breakId":"BRK-00003","breakType":"SETTLEMENT_BREAK","severity":"LOW","status":"RESOLVED","ageDays":4,"resolvedDate":"2024-02-06","fieldName":"SETTLEMENT_DATE","ourValue":"2024-02-01","theirValue":"2024-02-02"},{"breakId":"BRK-00004","breakType":"REFERENCE_DATA_BREAK","severity":"LOW","status":"RESOLVED","ageDays":3,"resolvedDate":"2024-03-25","fieldName":"REFERENCE_ENTITY","ourValue":"RED-8G836G","theirValue":"RED-8G836H"},{"breakId":"BRK-00005","breakType":"VALUATION_BREAK","severity":"HIGH","status":"ESCALATED","ageDays":2,"resolvedDate":null,"fieldName":"MTM","ourValue":"-482150.00","theirValue":"-511900.00"},{"breakId":"BRK-00006","breakType":"COLLATERAL_BREAK","severity":"MEDIUM","status":"OPEN","ageDays":1,"resolvedDate":null,"fieldName":"MARGIN_CALL","ourValue":"1250000.00","theirValue":"1180000.00"}]';
