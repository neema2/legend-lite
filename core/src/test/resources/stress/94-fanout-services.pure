Service stress::DSGroup_RiskAppetiteMetric
{
    pattern: '/stress/dsgroup_riskappetitemetric';
    documentation: 'The same reach as DSDeepRiskAppetiteMetric, then grouped on a NAVIGATED key with aggregates over it. The key came through a join, so a groupBy that grouped before the join would return the same columns and different numbers. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |appetitemetrics::RiskAppetiteMetric.all()
        ->filter({x|($x.book.desk.businessUnit.legalEntity.jurisdiction > ' ')})
        ->project(~[
            bookDeskBusinessUnitLegalEntityJurisdiction:x|$x.book.desk.businessUnit.legalEntity.jurisdiction,
            recordId:x|$x.recordId
        ])
        ->groupBy(~[bookDeskBusinessUnitLegalEntityJurisdiction], ~[
            n: x|$x.recordId : agg|$agg->count()
        ])
        ->sort(~bookDeskBusinessUnitLegalEntityJurisdiction->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSGroup_RiskAppetiteMetric_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 0 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

