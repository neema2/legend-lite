Service stress::DSAgg_TaxReclaim
{
    pattern: '/stress/dsagg_taxreclaim';
    documentation: 'groupBy on a local key of tax::TaxReclaim with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |tax::TaxReclaim.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            reclaimId:x|$x.reclaimId,
            ageInDays:x|$x.ageInDays
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.reclaimId : agg|$agg->count(),
            total: x|$x.ageInDays : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_TaxReclaim_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"EUR","n":1,"total":234},{"currency":"GBP","n":1,"total":227},{"currency":"USD","n":2,"total":241}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

