    documentation: 'A graphFetch 4 levels deep from bankingproducts::CurrentAccount. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |bankingproducts::CurrentAccount.all()
        ->graphFetch(#{
  bankingproducts::CurrentAccount
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  bankingproducts::CurrentAccount
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSTree_CurrentAccount_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"recordId":"BNK-00001","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"BNK-00002","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"BNK-00003","book":{"desk":{"businessUnit":{"legalEntity":null}}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

