Service stress::GG_ProductsInstrumentTree
{
    pattern: '/stress/gg_productsinstrument';
    documentation: 'Generated graph fetch on products::Instrument: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |products::Instrument.all()
        ->graphFetch(#{
  products::Instrument
  {
    instrumentId,
    assetClass,
    currency,
    cusip,
    exchange
    {
      mic,
      city,
      closeTime,
      country
      {
        countryCode,
        capitalCity
      }
    },
    instrumentCurrency
    {
      code,
      centralBank,
      fixingSource,
      country
      {
        countryCode,
        capitalCity
      }
    }
  }
}#)
        ->serialize(#{
  products::Instrument
  {
    instrumentId,
    assetClass,
    currency,
    cusip,
    exchange
    {
      mic,
      city,
      closeTime,
      country
      {
        countryCode,
        capitalCity
      }
    },
    instrumentCurrency
    {
      code,
      centralBank,
      fixingSource,
      country
      {
        countryCode,
        capitalCity
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_ProductsInstrumentTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"instrumentId":"INST-AAPL","assetClass":"EQUITY","currency":"USD","cusip":"037833100","exchange":{"mic":"XNAS","city":"New York","closeTime":"16:00","country":{"countryCode":"US","capitalCity":"Washington"}},"instrumentCurrency":{"code":"USD","centralBank":"Federal Reserve","fixingSource":"WMR","country":{"countryCode":"US","capitalCity":"Washington"}}},{"instrumentId":"INST-MSFT","assetClass":"EQUITY","currency":"USD","cusip":"594918104","exchange":{"mic":"XNAS","city":"New York","closeTime":"16:00","country":{"countryCode":"US","capitalCity":"Washington"}},"instrumentCurrency":{"code":"USD","centralBank":"Federal Reserve","fixingSource":"WMR","country":{"countryCode":"US","capitalCity":"Washington"}}},{"instrumentId":"INST-HSBA","assetClass":"EQUITY","currency":"GBP","cusip":null,"exchange":{"mic":"XLON","city":"London","closeTime":"16:30","country":{"countryCode":"GB","capitalCity":"London"}},"instrumentCurrency":{"code":"GBP","centralBank":"Bank of England","fixingSource":"WMR","country":{"countryCode":"GB","capitalCity":"London"}}},{"instrumentId":"INST-SAP","assetClass":"EQUITY","currency":"EUR","cusip":null,"exchange":{"mic":"XETR","city":"Frankfurt","closeTime":"17:30","country":{"countryCode":"DE","capitalCity":"Berlin"}},"instrumentCurrency":{"code":"EUR","centralBank":"European Central Bank","fixingSource":"ECB","country":{"countryCode":"DE","capitalCity":"Berlin"}}},{"instrumentId":"INST-GILT30","assetClass":"RATES","currency":"GBP","cusip":null,"exchange":{"mic":"XLON","city":"London","closeTime":"16:30","country":{"countryCode":"GB","capitalCity":"London"}},"instrumentCurrency":{"code":"GBP","centralBank":"Bank of England","fixingSource":"WMR","country":{"countryCode":"GB","capitalCity":"London"}}},{"instrumentId":"INST-NESN","assetClass":"EQUITY","currency":"EUR","cusip":null,"exchange":{"mic":"XETR","city":"Frankfurt","closeTime":"17:30","country":{"countryCode":"DE","capitalCity":"Berlin"}},"instrumentCurrency":{"code":"EUR","centralBank":"European Central Bank","fixingSource":"ECB","country":{"countryCode":"DE","capitalCity":"Berlin"}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

