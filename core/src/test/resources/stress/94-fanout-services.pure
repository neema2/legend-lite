Service stress::TX_All
{
    pattern: '/stress/tx_all';
    documentation: 'Every row of derivatives::OtcTrade, unfiltered. The subtype services partition this same table by discriminator; this is the whole of it, and therefore the only service that would show a row whose type code matches no subtype at all. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |derivatives::OtcTrade.all()
        ->project(~[
            otcId:x|$x.otcId,
            productType:x|$x.productType,
            tenorYears:x|$x.tenorYears,
            notionalGbp:x|$x.notionalIn(0.79),
            counterpartyId:x|$x.counterpartyId,
            noLegs:x|$x.legs->isEmpty(),
            noOptionTerms:x|$x.optionTerms->isEmpty()
