Service stress::DSGroup_DerivativeAsset
{
    pattern: '/stress/dsgroup_derivativeasset';
    documentation: 'The same reach as DSDeepDerivativeAsset, then grouped on a NAVIGATED key with aggregates over it. The key came through a join, so a groupBy that grouped before the join would return the same columns and different numbers. Generated by scripts/corpus/deepstack.py.';
