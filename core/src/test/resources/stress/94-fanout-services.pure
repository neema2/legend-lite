Service stress::DSAgg_CollateralAgreement
{
    pattern: '/stress/dsagg_collateralagreement';
    documentation: 'groupBy on a local key of collateral::CollateralAgreement with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |collateral::CollateralAgreement.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            agreementId:x|$x.agreementId,
            disputeResolutionDays:x|$x.disputeResolutionDays
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.agreementId : agg|$agg->count(),
            total: x|$x.disputeResolutionDays : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_CollateralAgreement_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"EUR","n":1,"total":5},{"currency":"GBP","n":1,"total":1},{"currency":"JPY","n":1,"total":10},{"currency":"USD","n":1,"total":2}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

