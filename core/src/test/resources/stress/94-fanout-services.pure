                    data: '[{"instructionId":"CUS-00001","instructionType":"SAFEKEEPING","daysLate":0,"custodian":"Euroclear","isUrgent":false,"settledOn":"2024-06-05"},{"instructionId":"CUS-00002","instructionType":"DELIVERY_VS_PAYMENT","daysLate":1,"custodian":"Clearstream","isUrgent":false,"settledOn":"2024-06-07"},{"instructionId":"CUS-00004","instructionType":"RECEIVE_VS_PAYMENT","daysLate":null,"custodian":"Euroclear","isUrgent":false,"settledOn":null},{"instructionId":"CUS-00005","instructionType":"INTERNAL_TRANSFER","daysLate":1,"custodian":"Clearstream","isUrgent":false,"settledOn":"2024-06-10"},{"instructionId":"CUS-00007","instructionType":"PLEDGE","daysLate":null,"custodian":"Euroclear","isUrgent":false,"settledOn":null},{"instructionId":"CUS-00008","instructionType":"RELEASE_PLEDGE","daysLate":null,"custodian":"Clearstream","isUrgent":false,"settledOn":null},{"instructionId":"CUS-00010","instructionType":"REDEMPTION_INSTR","daysLate":0,"custodian":"Euroclear","isUrgent":false,"settledOn":"2024-06-14"},{"instructionId":"CUS-00011","instructionType":"SWITCH","daysLate":null,"custodian":"Clearstream","isUrgent":false,"settledOn":null},{"instructionId":"CUS-00013","instructionType":"CORPORATE_ELECTION","daysLate":0,"custodian":"Euroclear","isUrgent":false,"settledOn":"2024-06-17"},{"instructionId":"CUS-00014","instructionType":"TAX_RECLAIM","daysLate":1,"custodian":"Clearstream","isUrgent":false,"settledOn":"2024-06-19"},{"instructionId":"CUS-00016","instructionType":"REGISTRATION","daysLate":null,"custodian":"Euroclear","isUrgent":false,"settledOn":null},{"instructionId":"CUS-00017","instructionType":"REREGISTRATION","daysLate":1,"custodian":"Clearstream","isUrgent":false,"settledOn":"2024-06-22"}]';
