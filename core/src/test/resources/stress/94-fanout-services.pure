  ]
}

Service stress::PL24_CountryWeightView
{
    pattern: '/stress/pl24';
    documentation: 'An aggregating VIEW whose grouping key is the foreign key into ANOTHER project, so the rollup is joined across the boundary and can then be walked up that project\'s own chain. Nothing seeds a view. One group\'s key is a country core-geo does not carry, so the join out of the aggregate lands on nothing; a rebalance with no constituents forms no group at all.';
    execution: Single
    {
    query: |index_core::IdxCountryWeight.all()
        ->project(~[
            rebalanceId:x|$x.rebalanceId,
            issuerCountryCode:x|$x.issuerCountryCode,
            totalWeightPct:x|$x.totalWeightPct,
            constituentCount:x|$x.constituentCount,
            countryName:x|$x.country.name,
            indexCode:x|$x.rebalance.index.code
        ])
        ->sort([~rebalanceId->ascending(), ~issuerCountryCode->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL24_CountryWeightView_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rebalanceId":"RB-EU50-2024Q2","issuerCountryCode":"DE","totalWeightPct":20.0,"constituentCount":1,"countryName":"Germany","indexCode":"NIS-EU50"},{"rebalanceId":"RB-EU50-2024Q2","issuerCountryCode":"GB","totalWeightPct":65.0,"constituentCount":2,"countryName":"United Kingdom","indexCode":"NIS-EU50"},{"rebalanceId":"RB-EU50-2024Q2","issuerCountryCode":"NZ","totalWeightPct":15.0,"constituentCount":1,"countryName":"New Zealand","indexCode":"NIS-EU50"},{"rebalanceId":"RB-GBAG-202406","issuerCountryCode":"FR","totalWeightPct":40.0,"constituentCount":1,"countryName":null,"indexCode":"AVB-GBAG"},{"rebalanceId":"RB-GBAG-202406","issuerCountryCode":"GB","totalWeightPct":60.0,"constituentCount":1,"countryName":"United Kingdom","indexCode":"AVB-GBAG"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL17_UnitConversionPair
{
    pattern: '/stress/pl17';
    documentation: 'A conversion and its inverse are two rows under a composite key on an ORDERED pair, and each reaches the unit table TWICE over two different joins -- once as the source unit and once as the target. The factors are NUMERIC(20,8), so a value that went through a double would differ in the eighth place; the temperature rows carry a non-zero offset, one of them negative, which a conversion written as a bare multiply gets wrong and nothing else does.';
    execution: Single
    {
    query: |core_units::CuConversion.all()
        ->project(~[
            fromUnitCode:x|$x.fromUnitCode,
            toUnitCode:x|$x.toUnitCode,
            factor:x|$x.factor,
            offsetValue:x|$x.offsetValue,
            fromName:x|$x.fromUnit.unitName,
            toName:x|$x.toUnit.unitName,
            converted:x|$x.convert(100.0)
        ])
        ->sort(~fromUnitCode->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL17_UnitConversionPair_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"fromUnitCode":"CEL","toUnitCode":"FAH","factor":1.8,"offsetValue":32.0,"fromName":"Celsius","toName":"Fahrenheit","converted":212.0},{"fromUnitCode":"FAH","toUnitCode":"CEL","factor":0.55555556,"offsetValue":-17.77777778,"fromName":"Fahrenheit","toName":"Celsius","converted":37.77777822},{"fromUnitCode":"KG","toUnitCode":"LB","factor":2.20462262,"offsetValue":0.0,"fromName":"Kilogram","toName":"Pound","converted":220.462262},{"fromUnitCode":"KG","toUnitCode":"G","factor":1000.0,"offsetValue":0.0,"fromName":"Kilogram","toName":"Gram","converted":100000.0},{"fromUnitCode":"LB","toUnitCode":"KG","factor":0.45359237,"offsetValue":0.0,"fromName":"Pound","toName":"Kilogram","converted":45.359237},{"fromUnitCode":"OZT","toUnitCode":"G","factor":31.1034768,"offsetValue":0.0,"fromName":"Troy ounce","toName":"Gram","converted":3110.34768}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL18_UnitLabels
{
    pattern: '/stress/pl18';
    documentation: 'Every unit with its label built by a qualified property that concatenates, its base-unit predicate, and a quantity converted to the base unit. The tables are in a SCHEMA rather than the default one, and the navigation to the quantity kind crosses out of it and back.';
    execution: Single
    {
    query: |core_units::CuUnit.all()
        ->project(~[
            unitCode:x|$x.unitCode,
            label:x|$x.label,
            isBaseUnit:x|$x.isBaseUnit,
            factorToBase:x|$x.factorToBase,
            inBase:x|$x.toBase(2.5),
            kindName:x|$x.quantityKind.kindName,
            isRatio:x|$x.quantityKind.isRatioScale
        ])
        ->sort(~unitCode->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL18_UnitLabels_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 8 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"unitCode":"BBL","label":"Barrel (bbl)","isBaseUnit":false,"factorToBase":158.98729493,"inBase":397.468237325,"kindName":"Volume","isRatio":true},{"unitCode":"CEL","label":"Celsius (degC)","isBaseUnit":true,"factorToBase":1.0,"inBase":2.5,"kindName":"Temperature","isRatio":false},{"unitCode":"FAH","label":"Fahrenheit (degF)","isBaseUnit":false,"factorToBase":0.55555556,"inBase":1.3888889,"kindName":"Temperature","isRatio":false},{"unitCode":"G","label":"Gram (g)","isBaseUnit":false,"factorToBase":0.001,"inBase":0.0025,"kindName":"Mass","isRatio":true},{"unitCode":"KG","label":"Kilogram (kg)","isBaseUnit":true,"factorToBase":1.0,"inBase":2.5,"kindName":"Mass","isRatio":true},{"unitCode":"L","label":"Litre (L)","isBaseUnit":true,"factorToBase":1.0,"inBase":2.5,"kindName":"Volume","isRatio":true},{"unitCode":"LB","label":"Pound (lb)","isBaseUnit":false,"factorToBase":0.45359237,"inBase":1.133980925,"kindName":"Mass","isRatio":true},{"unitCode":"OZT","label":"Troy ounce (ozt)","isBaseUnit":false,"factorToBase":0.03110348,"inBase":0.0777587,"kindName":"Mass","isRatio":true}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

