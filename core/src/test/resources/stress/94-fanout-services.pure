    documentation: 'A filter, a computed column, a composite sort and a limit stacked on core_geo::CgCity -- which cannot navigate anywhere, because its ends are inherited and F49 makes those unnavigable from a subtype\'s set. Depth being unavailable is not a reason to leave the query bare. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |core_geo::CgCity.all()
        ->filter({x|($x.name > ' ')})
        ->project(~[
            cityId:x|$x.cityId,
            name:x|$x.name,
            population:x|$x.population
        ])
        ->sort(~cityId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSLocal_CgCity_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"cityId":"CT-EDI","name":"Edinburgh","population":506520},{"cityId":"CT-FRA","name":"Frankfurt","population":764104},{"cityId":"CT-LON","name":"London","population":8982000},{"cityId":"CT-REY","name":"Reykjavik","population":139875}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSAgg_CgCity
{
    pattern: '/stress/dsagg_cgcity';
    documentation: 'groupBy on a local key of core_geo::CgCity with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |core_geo::CgCity.all()
        ->filter({x|($x.name > ' ')})
        ->project(~[
            name:x|$x.name,
            cityId:x|$x.cityId,
            population:x|$x.population
        ])
        ->groupBy(~[name], ~[
            n: x|$x.cityId : agg|$agg->count(),
            total: x|$x.population : agg|$agg->sum()
        ])
        ->sort(~name->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_CgCity_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"name":"Edinburgh","n":1,"total":506520},{"name":"Frankfurt","n":1,"total":764104},{"name":"London","n":1,"total":8982000},{"name":"Reykjavik","n":1,"total":139875}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSDeep_CgCity
{
    pattern: '/stress/dsdeep_cgcity';
    documentation: 'The deepest to-one reach core_geo::CgCity offers, filtered on a NAVIGATED column rather than a local one, composite-sorted and limited. A predicate over a joined column has to be placed relative to the join, which a filter on the root never tests. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |core_geo::CgCity.all()
        ->filter({x|($x.country.subRegion.macroRegion.name > ' ') && ($x.name > ' ')})
        ->project(~[
            cityId:x|$x.cityId,
            countrySubRegionMacroRegionName:x|$x.country.subRegion.macroRegion.name,
            countrySubRegionName:x|$x.country.subRegion.name,
            countryProfileCountryCode:x|$x.country.profile.countryCode,
            countryName:x|$x.country.name
        ])
        ->sort(~cityId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
