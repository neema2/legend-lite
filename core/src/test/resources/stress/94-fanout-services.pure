Service stress::DSTree_NonControllingInterest
{
    pattern: '/stress/dstree_noncontrollinginterest';
    documentation: 'A graphFetch 4 levels deep from balancesheet::NonControllingInterest. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
