Service stress::DSAgg_DebtSecurity
{
    pattern: '/stress/dsagg_debtsecurity';
    documentation: 'groupBy on a local key of fixedincome::DebtSecurity with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |fixedincome::DebtSecurity.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            securityId:x|$x.securityId,
            couponFrequency:x|$x.couponFrequency
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.securityId : agg|$agg->count(),
            total: x|$x.couponFrequency : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_DebtSecurity_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"EUR","n":1,"total":1},{"currency":"GBP","n":1,"total":1},{"currency":"USD","n":4,"total":8}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

