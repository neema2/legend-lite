Service stress::DSAgg_CashFlow
{
    pattern: '/stress/dsagg_cashflow';
    documentation: 'groupBy on a local key of funding::CashFlow with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |funding::CashFlow.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            cashFlowId:x|$x.cashFlowId,
            priority:x|$x.priority
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.cashFlowId : agg|$agg->count(),
            total: x|$x.priority : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_CashFlow_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"EUR","n":1,"total":101},{"currency":"GBP","n":1,"total":94},{"currency":"JPY","n":1,"total":115},{"currency":"USD","n":1,"total":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

