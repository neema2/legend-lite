                    contentType: 'application/json';
                    data: '[{"snapshotId":"PS-0001","currency":"USD","version":339},{"snapshotId":"PS-0002","currency":"GBP","version":null},{"snapshotId":"PS-0003","currency":"EUR","version":353},{"snapshotId":"PS-0005","currency":"JPY","version":367}]';
