Service stress::DSLocal_TradeReport
{
    pattern: '/stress/dslocal_tradereport';
    documentation: 'A filter, a computed column, a composite sort and a limit stacked on regulatory::TradeReport -- which cannot navigate anywhere, because its ends are inherited and F49 makes those unnavigable from a subtype\'s set. Depth being unavailable is not a reason to leave the query bare. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |regulatory::TradeReport.all()
        ->filter({x|($x.status > ' ')})
        ->project(~[
            reportId:x|$x.reportId,
            status:x|$x.status,
            retryCount:x|$x.retryCount
        ])
        ->sort(~reportId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
