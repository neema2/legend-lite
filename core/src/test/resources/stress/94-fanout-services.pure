Service stress::DSAgg_CtnTenorBucket
{
    pattern: '/stress/dsagg_ctntenorbucket';
    documentation: 'groupBy on a local key of core_tenor::CtnTenorBucket with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |core_tenor::CtnTenorBucket.all()
        ->filter({x|($x.label > ' ')})
        ->project(~[
            label:x|$x.label,
            bucketId:x|$x.bucketId,
            maxDays:x|$x.maxDays
        ])
        ->groupBy(~[label], ~[
            n: x|$x.bucketId : agg|$agg->count(),
            total: x|$x.maxDays : agg|$agg->sum()
        ])
        ->sort(~label->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_CtnTenorBucket_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 9 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"label":"0-7d","n":1,"total":8},{"label":"1-3m","n":1,"total":92},{"label":"1-3y","n":1,"total":1096},{"label":"10y+","n":1,"total":40000},{"label":"3-5y","n":1,"total":1827},{"label":"3-6m","n":1,"total":184},{"label":"5-10y","n":1,"total":3654},{"label":"6-12m","n":1,"total":366},{"label":"8-30d","n":1,"total":31}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

