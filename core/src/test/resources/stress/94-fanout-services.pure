Service stress::LE1_BandedExposures
{
    pattern: '/stress/le1';
    documentation: 'Each line with the threshold band its percentage falls in, reached by a RANGE join from a three-column key: `pct >= floor and pct < ceiling`, with no key to join on because which band applies is a property of the number. One line sits at exactly 0.0, the floor of the first band, which is the boundary a half-open range gets wrong first.';
    execution: Single
    {
    query: |largeexp::ExposureLine.all()
        ->project(~[
            reportId:x|$x.reportId,
            cobDate:x|$x.cobDate,
            lineNumber:x|$x.lineNumber,
            pctOfCapital:x|$x.pctOfCapital,
            bandId:x|$x.thresholdBand.bandId,
            bandName:x|$x.thresholdBand.bandName,
            isReportable:x|$x.thresholdBand.isReportable,
            isBreach:x|$x.thresholdBand.isBreach
        ])
        ->sort([~reportId->ascending(), ~cobDate->ascending(), ~lineNumber->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    LE1_BandedExposures_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 12 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"reportId":"LE-2024Q1-01","cobDate":"2024-03-28","lineNumber":1,"pctOfCapital":16.1,"bandId":"TH-MONITOR","bandName":"Monitored","isReportable":true,"isBreach":false},{"reportId":"LE-2024Q1-01","cobDate":"2024-03-28","lineNumber":2,"pctOfCapital":29.8,"bandId":"TH-BREACH","bandName":"Limit breach","isReportable":true,"isBreach":true},{"reportId":"LE-2024Q1-01","cobDate":"2024-03-28","lineNumber":3,"pctOfCapital":7.9,"bandId":"TH-REPORT","bandName":"Reportable","isReportable":true,"isBreach":false},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":1,"pctOfCapital":18.4,"bandId":"TH-MONITOR","bandName":"Monitored","isReportable":true,"isBreach":false},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":2,"pctOfCapital":9.2,"bandId":"TH-REPORT","bandName":"Reportable","isReportable":true,"isBreach":false},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":3,"pctOfCapital":31.7,"bandId":"TH-BREACH","bandName":"Limit breach","isReportable":true,"isBreach":true},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":4,"pctOfCapital":4.6,"bandId":"TH-NIL","bandName":"Below reporting threshold","isReportable":false,"isBreach":false},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":5,"pctOfCapital":71.3,"bandId":"TH-BREACH","bandName":"Limit breach","isReportable":true,"isBreach":true},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":6,"pctOfCapital":0.0,"bandId":"TH-NIL","bandName":"Below reporting threshold","isReportable":false,"isBreach":false},{"reportId":"LE-2024Q2-02","cobDate":"2024-06-28","lineNumber":1,"pctOfCapital":14.5,"bandId":"TH-MONITOR","bandName":"Monitored","isReportable":true,"isBreach":false},{"reportId":"LE-2024Q2-02","cobDate":"2024-06-28","lineNumber":2,"pctOfCapital":4.1,"bandId":"TH-NIL","bandName":"Below reporting threshold","isReportable":false,"isBreach":false},{"reportId":"LE-2024Q2-02","cobDate":"2024-06-28","lineNumber":3,"pctOfCapital":10.1,"bandId":"TH-MONITOR","bandName":"Monitored","isReportable":true,"isBreach":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::LE2_ExemptionMatches
{
    pattern: '/stress/le2';
    documentation: 'How many exemption rules reach each line, over a join that matches on counterparty OR on country. A rule carries one or the other and never both, so the `or` is a real disjunction. Quarantined under F6: five of the twelve lines match no rule at all and count() over an empty to-many returns 1. LE6 counts the same join from the rule side, where every rule reaches a line, and passes.';
    execution: Single
    {
    query: |largeexp::ExposureLine.all()
        ->project(~[
            reportId:x|$x.reportId,
            cobDate:x|$x.cobDate,
            lineNumber:x|$x.lineNumber,
            counterpartyId:x|$x.counterpartyId,
            countryCode:x|$x.countryCode,
            isExempt:x|$x.isExempt,
            matchingRules:x|$x.exemptionRules->count()
        ])
        ->sort([~reportId->ascending(), ~cobDate->ascending(), ~lineNumber->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    LE2_ExemptionMatches_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 12 rows; 6 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"reportId":"LE-2024Q1-01","cobDate":"2024-03-28","lineNumber":1,"counterpartyId":"CP-0001","countryCode":"US","isExempt":false,"matchingRules":0},{"reportId":"LE-2024Q1-01","cobDate":"2024-03-28","lineNumber":2,"counterpartyId":"CP-0003","countryCode":"DE","isExempt":false,"matchingRules":1},{"reportId":"LE-2024Q1-01","cobDate":"2024-03-28","lineNumber":3,"counterpartyId":"CP-0006","countryCode":"CH","isExempt":false,"matchingRules":1},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":1,"counterpartyId":"CP-0001","countryCode":"US","isExempt":false,"matchingRules":0},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":2,"counterpartyId":"CP-0002","countryCode":"GB","isExempt":false,"matchingRules":0},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":3,"counterpartyId":"CP-0003","countryCode":"DE","isExempt":false,"matchingRules":1},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":4,"counterpartyId":"CP-0004","countryCode":"FR","isExempt":false,"matchingRules":0},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":5,"counterpartyId":"CP-0005","countryCode":"JP","isExempt":true,"matchingRules":1},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","lineNumber":6,"counterpartyId":"CP-0001","countryCode":"US","isExempt":false,"matchingRules":0},{"reportId":"LE-2024Q2-02","cobDate":"2024-06-28","lineNumber":1,"counterpartyId":"CP-0007","countryCode":"IE","isExempt":false,"matchingRules":1},{"reportId":"LE-2024Q2-02","cobDate":"2024-06-28","lineNumber":2,"counterpartyId":"CP-0008","countryCode":"LU","isExempt":false,"matchingRules":0},{"reportId":"LE-2024Q2-02","cobDate":"2024-06-28","lineNumber":3,"counterpartyId":"CP-0009","countryCode":"SG","isExempt":false,"matchingRules":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::LE3_ReportableLines
{
    pattern: '/stress/le3';
