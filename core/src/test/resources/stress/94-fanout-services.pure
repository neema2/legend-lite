Service stress::GG_AccountingRuleTree
{
    pattern: '/stress/gg_accountingrule';
    documentation: 'Generated graph fetch on accounting::AccountingRule: 5 keys, 1 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |accounting::AccountingRule.all()
        ->graphFetch(#{
  accounting::AccountingRule
  {
    ruleId,
    condition,
    description,
    expiryDate,
    glAccount
    {
      accountId,
      closeDate,
      description
    }
  }
}#)
