Service stress::MSGX_All
{
    pattern: '/stress/msgx_all';
    documentation: 'Every row of messaging::InboundMessage, unfiltered. The subtype services partition this same table by discriminator; this is the whole of it, and therefore the only service that would show a row whose type code matches no subtype at all. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |messaging::InboundMessage.all()
        ->project(~[
            messageId:x|$x.messageId,
            messageType:x|$x.messageType,
            sizeKb:x|$x.sizeKb,
            protocol:x|$x.protocol,
            isDuplicate:x|$x.isDuplicate,
            errorDetail:x|$x.errorDetail
        ])
        ->sort(~messageId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MSGX_All_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 15 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"messageId":"MSG-00001","messageType":"MT103","sizeKb":0.5,"protocol":"SWIFT","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00002","messageType":"MT202","sizeKb":0.8291015625,"protocol":"ISO20022","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00004","messageType":"MT300","sizeKb":1.4873046875,"protocol":"FPML","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00005","messageType":"MT320","sizeKb":1.81640625,"protocol":"SWIFT","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00007","messageType":"MT536","sizeKb":2.474609375,"protocol":"FIX","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00008","messageType":"MT540","sizeKb":2.8037109375,"protocol":"FPML","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00010","messageType":"MT542","sizeKb":3.4619140625,"protocol":"ISO20022","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00011","messageType":"MT543","sizeKb":3.791015625,"protocol":"FIX","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00013","messageType":"MT950","sizeKb":4.44921875,"protocol":"SWIFT","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00014","messageType":"PACS008","sizeKb":4.7783203125,"protocol":"ISO20022","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00016","messageType":"CAMT053","sizeKb":5.4365234375,"protocol":"FPML","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00017","messageType":"CAMT054","sizeKb":5.765625,"protocol":"SWIFT","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00019","messageType":"FIX_EXEC_REPORT","sizeKb":6.423828125,"protocol":"FIX","isDuplicate":true,"errorDetail":null},{"messageId":"MSG-00020","messageType":"FIX_CANCEL","sizeKb":6.7529296875,"protocol":"FPML","isDuplicate":false,"errorDetail":null},{"messageId":"MSG-00022","messageType":"FIXML_ALLOC","sizeKb":7.4111328125,"protocol":"ISO20022","isDuplicate":false,"errorDetail":null}]';
                  }#;
