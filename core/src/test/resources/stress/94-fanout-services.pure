Service stress::DSLocal_CounterpartyAccount
{
    pattern: '/stress/dslocal_counterpartyaccount';
    documentation: 'A filter, a computed column, a composite sort and a limit stacked on counterparty::Account -- which cannot navigate anywhere, because its ends are inherited and F49 makes those unnavigable from a subtype\'s set. Depth being unavailable is not a reason to leave the query bare. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |counterparty::Account.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            accountId:x|$x.accountId,
            currency:x|$x.currency
        ])
        ->sort(~accountId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSLocal_CounterpartyAccount_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"accountId":"A-0001","currency":"USD"},{"accountId":"A-0002","currency":"GBP"},{"accountId":"A-0003","currency":"EUR"},{"accountId":"A-0005","currency":"JPY"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

