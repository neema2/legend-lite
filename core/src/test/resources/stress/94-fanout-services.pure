Service stress::DSTree_PositionSnapshot
{
    pattern: '/stress/dstree_positionsnapshot';
    documentation: 'A graphFetch 4 levels deep from positions::PositionSnapshot. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |positions::PositionSnapshot.all()
        ->graphFetch(#{
  positions::PositionSnapshot
  {
    snapshotId,
    position
    {
      book
      {
        desk
        {
          businessUnit
          {
            buId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  positions::PositionSnapshot
  {
    snapshotId,
    position
    {
      book
      {
        desk
        {
          businessUnit
          {
            buId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSTree_PositionSnapshot_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"snapshotId":"PS-0001","position":null},{"snapshotId":"PS-0002","position":null},{"snapshotId":"PS-0003","position":{"book":{"desk":{"businessUnit":{"buId":"BU-EQ"}}}}},{"snapshotId":"PS-0004","position":{"book":{"desk":{"businessUnit":{"buId":"BU-EQ"}}}}},{"snapshotId":"PS-0005","position":{"book":{"desk":{"businessUnit":{"buId":"BU-EQ"}}}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

