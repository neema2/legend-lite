Service stress::PL4_PillarsPerBand
{
    pattern: '/stress/pl4';
    documentation: 'How many curve pillars fall in each tenor band, and the rate range within it. The grouping key is a PROJECT attribute reached across the boundary, so this is a group-by whose key the corpus does not own. Two of the nine bands hold no pillar at all and are absent rather than zero.';
    execution: Single
    {
    query: |curves::CurvePoint.all()
        ->project(~[
            bandCode:x|$x.tenorBucket.band,
            zeroRate:x|$x.zeroRate
        ])
        ->groupBy(~[bandCode], ~[
            pillars: x|$x.zeroRate : agg|$agg->count(),
            highestRate: x|$x.zeroRate : agg|$agg->max(),
            lowestRate: x|$x.zeroRate : agg|$agg->min()
        ])
        ->sort(~bandCode->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL4_PillarsPerBand_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 8 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"bandCode":"D8_30","pillars":16,"highestRate":5.59,"lowestRate":0.08},{"bandCode":"M1_3","pillars":16,"highestRate":5.6,"lowestRate":0.11},{"bandCode":"M3_6","pillars":16,"highestRate":5.53,"lowestRate":0.18},{"bandCode":"M6_12","pillars":16,"highestRate":5.34,"lowestRate":0.31},{"bandCode":"Y10_PLUS","pillars":48,"highestRate":4.48,"lowestRate":1.3},{"bandCode":"Y1_3","pillars":32,"highestRate":4.88,"lowestRate":0.44},{"bandCode":"Y3_5","pillars":16,"highestRate":4.41,"lowestRate":0.63},{"bandCode":"Y5_10","pillars":32,"highestRate":4.35,"lowestRate":0.75}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL5_ConvertedNotional
{
    pattern: '/stress/pl5';
    documentation: 'Each trade\'s notional converted through a PROJECT\'s FX rate by a PROJECT\'s function, and converted back. The round trip is the assertion: a wrong rate or a wrong lowering gives a number that does not return to where it started, where a single conversion would just look plausible.';
    execution: Single
    {
    query: |projectlink::PricedTrade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            notional:x|$x.notional,
            fxMid:x|$x.fxMid,
            notionalConverted:x|$x.notionalConverted,
            backConverted:x|$x.backConverted
        ])
        ->sort(~tradeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL5_ConvertedNotional_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","notional":190500.0,"fxMid":1.0709,"notionalConverted":204006.44999999998,"backConverted":190500.0},{"tradeId":"TRD-0002","notional":477500.0,"fxMid":1.2661,"notionalConverted":604562.75,"backConverted":477500.0},{"tradeId":"TRD-0003","notional":250000.0,"fxMid":160.87,"notionalConverted":40217500.0,"backConverted":250000.0},{"tradeId":"TRD-0004","notional":250000.0,"fxMid":0.8965,"notionalConverted":224125.0,"backConverted":250000.0},{"tradeId":"TRD-0005","notional":250000.0,"fxMid":1.0704,"notionalConverted":267600.0,"backConverted":250000.0},{"tradeId":"TRD-0006","notional":250000.0,"fxMid":1.2661,"notionalConverted":316525.0,"backConverted":250000.0},{"tradeId":"TRD-0007","notional":282000.0,"fxMid":160.87,"notionalConverted":45365340.0,"backConverted":282000.0},{"tradeId":"TRD-0008","notional":18975.0,"fxMid":0.8965,"notionalConverted":17011.087499999998,"backConverted":18974.999999999996},{"tradeId":"TRD-0009","notional":576750.0,"fxMid":1.0709,"notionalConverted":617641.575,"backConverted":576750.0},{"tradeId":"TRD-0010","notional":498000.0,"fxMid":1.2661,"notionalConverted":630517.8,"backConverted":498000.00000000006},{"tradeId":"TRD-0011","notional":167300.0,"fxMid":160.87,"notionalConverted":26913551.0,"backConverted":167300.0},{"tradeId":"TRD-0012","notional":369000.0,"fxMid":0.8965,"notionalConverted":330808.5,"backConverted":369000.0},{"tradeId":"TRD-0013","notional":171250.0,"fxMid":1.0704,"notionalConverted":183306.0,"backConverted":171250.0},{"tradeId":"TRD-0014","notional":69000.0,"fxMid":1.2661,"notionalConverted":87360.9,"backConverted":69000.0},{"tradeId":"TRD-0015","notional":35000.0,"fxMid":160.87,"notionalConverted":5630450.0,"backConverted":35000.0},{"tradeId":"TRD-0016","notional":264600.0,"fxMid":0.8965,"notionalConverted":237213.9,"backConverted":264600.0},{"tradeId":"TRD-0017","notional":385000.0,"fxMid":1.0709,"notionalConverted":412296.5,"backConverted":385000.0},{"tradeId":"TRD-0018","notional":4912500.0,"fxMid":1.2661,"notionalConverted":6219716.25,"backConverted":4912500.0},{"tradeId":"TRD-0019","notional":1960000.0,"fxMid":160.87,"notionalConverted":315305200.0,"backConverted":1960000.0},{"tradeId":"TRD-0020","notional":975000.0,"fxMid":0.8965,"notionalConverted":874087.5,"backConverted":975000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL6_RatingsAsOf
{
    pattern: '/stress/pl6';
    documentation: 'Ratings as at 1 February, read from a MILESTONED class in another project. CP-0001 is A and CP-0003 is still investment grade at BBB-.';
    execution: Single
    {
    query: |core_ratings::RatingVersion.all(%2024-02-01)
        ->project(~[
            entityId:x|$x.entityId,
            rating:x|$x.rating,
            agency:x|$x.agency
        ])
        ->sort(~entityId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL6_RatingsAsOf_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"entityId":"CP-0001","rating":"A","agency":"SPGI"},{"entityId":"CP-0002","rating":"AA+","agency":"SPGI"},{"entityId":"CP-0003","rating":"BBB-","agency":"SPGI"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL7_RatingsAsOf
{
    pattern: '/stress/pl7';
    documentation: 'The SAME query six months later: CP-0001 is A- and CP-0003 has fallen to BB+. Nothing about the query changes but the date -- and if the boundary dropped the milestoning predicate, nothing about the ANSWER would change either, which is exactly what this pins.';
    execution: Single
    {
    query: |core_ratings::RatingVersion.all(%2024-08-01)
        ->project(~[
            entityId:x|$x.entityId,
            rating:x|$x.rating,
            agency:x|$x.agency
        ])
        ->sort(~entityId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL7_RatingsAsOf_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"entityId":"CP-0001","rating":"A-","agency":"SPGI"},{"entityId":"CP-0002","rating":"AA+","agency":"SPGI"},{"entityId":"CP-0003","rating":"BB+","agency":"SPGI"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL8_RatingsAsOf
{
