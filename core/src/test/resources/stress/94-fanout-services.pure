                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"ruleId":"AR-0001","condition":null,"description":"primary record","expiryDate":"2024-02-02","glAccount":null},{"ruleId":"AR-0002","condition":"CONDITION-002","description":null,"expiryDate":"2024-03-03","glAccount":null},{"ruleId":"AR-0003","condition":"CONDITION-003","description":"archived record","expiryDate":null,"glAccount":{"accountId":"GLA-0001","closeDate":"2024-02-02","description":"primary record"}},{"ruleId":"AR-0004","condition":"CONDITION-004","description":"pending review","expiryDate":"2024-05-05","glAccount":{"accountId":"GLA-0002","closeDate":null,"description":"secondary record"}},{"ruleId":"AR-0005","condition":"CONDITION-005","description":"closed","expiryDate":"2024-06-06","glAccount":{"accountId":"GLA-0003","closeDate":"2024-04-04","description":null}}]}';
