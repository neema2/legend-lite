Service stress::DSAgg_CurvePoint
{
    pattern: '/stress/dsagg_curvepoint';
    documentation: 'groupBy on a local key of curves::CurvePoint with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |curves::CurvePoint.all()
        ->filter({x|($x.sourceSeriesId > ' ')})
        ->project(~[
            sourceSeriesId:x|$x.sourceSeriesId,
            curveId:x|$x.curveId,
            tenorDays:x|$x.tenorDays
        ])
        ->groupBy(~[sourceSeriesId], ~[
            n: x|$x.curveId : agg|$agg->count(),
            total: x|$x.tenorDays : agg|$agg->sum()
        ])
        ->sort(~sourceSeriesId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_CurvePoint_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"sourceSeriesId":"DBR.10Y","n":2,"total":7306},{"sourceSeriesId":"EURIBOR.3M","n":2,"total":182},{"sourceSeriesId":"SOFR.ON","n":2,"total":60},{"sourceSeriesId":"UST.10Y","n":2,"total":7306}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

