            exceptionId:x|$x.exceptionId,
            ageInDays:x|$x.ageInDays
        ])
        ->groupBy(~[status], ~[
            n: x|$x.exceptionId : agg|$agg->count(),
            total: x|$x.ageInDays : agg|$agg->sum()
        ])
        ->sort(~status->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
