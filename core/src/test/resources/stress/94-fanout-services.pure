Service stress::DSLocal_LotPosition
{
    pattern: '/stress/dslocal_lotposition';
    documentation: 'A filter, a computed column, a composite sort and a limit stacked on positions::LotPosition -- which cannot navigate anywhere, because its ends are inherited and F49 makes those unnavigable from a subtype\'s set. Depth being unavailable is not a reason to leave the query bare. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |positions::LotPosition.all()
        ->filter({x|($x.lotType > ' ')})
        ->project(~[
            lotId:x|$x.lotId,
            lotType:x|$x.lotType,
            holdingPeriod:x|$x.holdingPeriod
        ])
        ->sort(~lotId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
