Service stress::DSGroup_CriticalFinding
{
    pattern: '/stress/dsgroup_criticalfinding';
    documentation: 'The same reach as DSDeepCriticalFinding, then grouped on a NAVIGATED key with aggregates over it. The key came through a join, so a groupBy that grouped before the join would return the same columns and different numbers. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |auditfindings::CriticalFinding.all()
        ->filter({x|($x.book.desk.businessUnit.legalEntity.jurisdiction > ' ')})
        ->project(~[
            bookDeskBusinessUnitLegalEntityJurisdiction:x|$x.book.desk.businessUnit.legalEntity.jurisdiction,
            recordId:x|$x.recordId
        ])
        ->groupBy(~[bookDeskBusinessUnitLegalEntityJurisdiction], ~[
            n: x|$x.recordId : agg|$agg->count()
        ])
        ->sort(~bookDeskBusinessUnitLegalEntityJurisdiction->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
