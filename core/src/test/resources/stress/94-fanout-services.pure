Service stress::DSAgg_Settlement
{
    pattern: '/stress/dsagg_settlement';
    documentation: 'groupBy on a local key of settlement::Settlement with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |settlement::Settlement.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            settlementId:x|$x.settlementId,
            priority:x|$x.priority
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.settlementId : agg|$agg->count(),
            total: x|$x.priority : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_Settlement_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"USD","n":18,"total":82}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

