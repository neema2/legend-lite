        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"name":"Fenwick","n":1,"total":192},{"name":"Kestrel","n":1,"total":null},{"name":"Northbridge","n":1,"total":171},{"name":"Thameside","n":1,"total":199}]';
