    {
    query: |core_geo::CgCity.all()
        ->project(~[
            cityId:x|$x.cityId,
            cityName:x|$x.name,
            timeZone:x|$x.timeZone.ianaName,
            country:x|$x.country.name,
            subRegion:x|$x.country.subRegion.name,
            macroRegion:x|$x.country.subRegion.macroRegion.name,
            incomeGroup:x|$x.country.profile.incomeGroup
        ])
        ->sort(~cityId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
