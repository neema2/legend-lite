                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"reportId":"RPT-0001","status":"ACCEPTED","retryCount":0},{"reportId":"RPT-0002","status":"ACCEPTED","retryCount":0},{"reportId":"RPT-0003","status":"ACCEPTED","retryCount":0},{"reportId":"RPT-0004","status":"REJECTED","retryCount":2},{"reportId":"RPT-0005","status":"ACCEPTED","retryCount":0},{"reportId":"RPT-0006","status":"ACCEPTED","retryCount":0},{"reportId":"RPT-0007","status":"ACCEPTED","retryCount":0},{"reportId":"RPT-0008","status":"REJECTED","retryCount":2},{"reportId":"RPT-0009","status":"ACCEPTED","retryCount":0},{"reportId":"RPT-0010","status":"ACCEPTED","retryCount":0},{"reportId":"RPT-0011","status":"ACCEPTED","retryCount":0},{"reportId":"RPT-0012","status":"REJECTED","retryCount":2},{"reportId":"RPT-0013","status":"ACCEPTED","retryCount":0},{"reportId":"RPT-0014","status":"ACCEPTED","retryCount":0}]';
                  }#;
              }#
          ]
