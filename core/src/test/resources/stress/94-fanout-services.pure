Service stress::DSAgg_IdxConstituent
{
    pattern: '/stress/dsagg_idxconstituent';
    documentation: 'groupBy on a local key of index_core::IdxConstituent with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |index_core::IdxConstituent.all()
        ->filter({x|($x.regionCode > ' ')})
        ->project(~[
            regionCode:x|$x.regionCode,
            constituentId:x|$x.constituentId,
            rankByWeight:x|$x.rankByWeight
        ])
        ->groupBy(~[regionCode], ~[
            n: x|$x.constituentId : agg|$agg->count(),
            total: x|$x.rankByWeight : agg|$agg->sum()
        ])
        ->sort(~regionCode->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_IdxConstituent_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"regionCode":"APAC","n":1,"total":4},{"regionCode":"EUR","n":5,"total":9}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

