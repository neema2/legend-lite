Service stress::OT1_SwapLegs
{
    pattern: '/stress/ot1';
    documentation: 'Swap legs with their parent\'s product type. Fixed legs carry a rate and no index; floating legs the reverse; a basis swap has floating on BOTH sides, so neither of its legs has a fixed rate.';
    execution: Single
    {
    query: |derivatives::SwapLeg.all()
        ->project(~[
            legId:x|$x.legId,
            legNumber:x|$x.legNumber,
            legType:x|$x.legType,
            payReceive:x|$x.payReceive,
            fixedRate:x|$x.fixedRate,
            floatingIndex:x|$x.floatingIndex,
            spreadBp:x|$x.spreadBp,
            dayCount:x|$x.dayCount,
            productType:x|$x.trade.productType,
            counterpartyId:x|$x.trade.counterpartyId
        ])
        ->sort(~legId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    OT1_SwapLegs_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 10 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"legId":"OTC-000001-1","legNumber":1,"legType":"FIXED","payReceive":"PAY","fixedRate":3.85,"floatingIndex":null,"spreadBp":null,"dayCount":"30/360","productType":"IRS","counterpartyId":"CP-0001"},{"legId":"OTC-000001-2","legNumber":2,"legType":"FLOATING","payReceive":"RECEIVE","fixedRate":null,"floatingIndex":"USD-SOFR","spreadBp":0.0,"dayCount":"ACT/360","productType":"IRS","counterpartyId":"CP-0001"},{"legId":"OTC-000002-1","legNumber":1,"legType":"FIXED","payReceive":"RECEIVE","fixedRate":4.1,"floatingIndex":null,"spreadBp":null,"dayCount":"ACT/360","productType":"OIS","counterpartyId":"CP-0002"},{"legId":"OTC-000002-2","legNumber":2,"legType":"FLOATING","payReceive":"PAY","fixedRate":null,"floatingIndex":"USD-SOFR-OIS","spreadBp":0.0,"dayCount":"ACT/360","productType":"OIS","counterpartyId":"CP-0002"},{"legId":"OTC-000003-1","legNumber":1,"legType":"FLOATING","payReceive":"PAY","fixedRate":null,"floatingIndex":"EUR-EURIBOR-3M","spreadBp":0.0,"dayCount":"ACT/360","productType":"BASIS_SWAP","counterpartyId":"CP-0001"},{"legId":"OTC-000003-2","legNumber":2,"legType":"FLOATING","payReceive":"RECEIVE","fixedRate":null,"floatingIndex":"EUR-EURIBOR-6M","spreadBp":-4.5,"dayCount":"ACT/360","productType":"BASIS_SWAP","counterpartyId":"CP-0001"},{"legId":"OTC-000011-1","legNumber":1,"legType":"EQUITY","payReceive":"RECEIVE","fixedRate":null,"floatingIndex":"SPX-TOTAL-RETURN","spreadBp":null,"dayCount":"ACT/365","productType":"EQUITY_SWAP","counterpartyId":"CP-0001"},{"legId":"OTC-000011-2","legNumber":2,"legType":"FLOATING","payReceive":"PAY","fixedRate":null,"floatingIndex":"USD-SOFR","spreadBp":35.0,"dayCount":"ACT/360","productType":"EQUITY_SWAP","counterpartyId":"CP-0001"},{"legId":"OTC-000013-1","legNumber":1,"legType":"FIXED","payReceive":"PAY","fixedRate":78.5,"floatingIndex":null,"spreadBp":null,"dayCount":"ACT/365","productType":"COMMODITY_SWAP","counterpartyId":"CP-0005"},{"legId":"OTC-000013-2","legNumber":2,"legType":"COMMODITY","payReceive":"RECEIVE","fixedRate":null,"floatingIndex":"WTI-NYMEX-FRONT","spreadBp":null,"dayCount":"ACT/365","productType":"COMMODITY_SWAP","counterpartyId":"CP-0005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::OT2_NotionalByAssetClass
{
    pattern: '/stress/ot2';
    documentation: 'Notional by asset class and clearing status: the roll-up a derivatives risk pack opens with.';
    execution: Single
    {
    query: |derivatives::OtcTrade.all()
        ->project(~[
            assetClass:x|$x.assetClass,
            clearingStatus:x|$x.clearingStatus,
            notional:x|$x.notional
        ])
        ->groupBy(~[assetClass, clearingStatus], ~[
            tradeCount: x|$x.notional : agg|$agg->count(),
            totalNotional: x|$x.notional : agg|$agg->sum(),
            largestTrade: x|$x.notional : agg|$agg->max()
        ])
        ->sort(~assetClass->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    OT2_NotionalByAssetClass_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 12 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"assetClass":"COMMODITY","clearingStatus":"BILATERAL","tradeCount":3,"totalNotional":114000000.0,"largestTrade":55000000.0},{"assetClass":"COMMODITY","clearingStatus":"CLEARED","tradeCount":1,"totalNotional":53000000.0,"largestTrade":53000000.0},{"assetClass":"CREDIT","clearingStatus":"CLEARED","tradeCount":3,"totalNotional":283000000.0,"largestTrade":250000000.0},{"assetClass":"CREDIT","clearingStatus":"BILATERAL","tradeCount":3,"totalNotional":73000000.0,"largestTrade":27000000.0},{"assetClass":"EQUITY","clearingStatus":"BILATERAL","tradeCount":7,"totalNotional":253000000.0,"largestTrade":49000000.0},{"assetClass":"EQUITY","clearingStatus":"CLEARED","tradeCount":2,"totalNotional":88000000.0,"largestTrade":47000000.0},{"assetClass":"FX","clearingStatus":"BILATERAL","tradeCount":4,"totalNotional":99000000.0,"largestTrade":33000000.0},{"assetClass":"FX","clearingStatus":"CLEARED","tradeCount":2,"totalNotional":64000000.0,"largestTrade":35000000.0},{"assetClass":"HYBRID","clearingStatus":"BILATERAL","tradeCount":2,"totalNotional":118000000.0,"largestTrade":61000000.0},{"assetClass":"HYBRID","clearingStatus":"CLEARED","tradeCount":1,"totalNotional":59000000.0,"largestTrade":59000000.0},{"assetClass":"RATES","clearingStatus":"CLEARED","tradeCount":6,"totalNotional":183000000.0,"largestTrade":75000000.0},{"assetClass":"RATES","clearingStatus":"BILATERAL","tradeCount":8,"totalNotional":233000000.0,"largestTrade":100000000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::OT3_InterestRateSwaps
{
    pattern: '/stress/ot3';
    documentation: 'Interest rate swaps only, with the DV01 a rates desk sizes them by. The discriminator is the point: if the ~filter were wrong this would return all thirteen OTC trades rather than the one that is an IRS.';
    execution: Single
    {
    query: |derivatives::InterestRateSwap.all()
        ->project(~[
            otcId:x|$x.otcId,
            productType:x|$x.productType,
            notional:x|$x.notional,
            tenorYears:x|$x.tenorYears,
            dv01:x|$x.dv01
        ])
        ->sort(~otcId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    OT3_InterestRateSwaps_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"otcId":"OTC-000001","productType":"IRS","notional":50000000.0,"tenorYears":5.002739726027397,"dv01":25013.698630136987}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::OT4_CreditProtection
{
    pattern: '/stress/ot4';
    documentation: 'Single-name CDS with loss-given-default at the standard 40% recovery. A different subtype, a different risk measure, the same base table.';
    execution: Single
    {
    query: |derivatives::CreditDefaultSwap.all()
        ->project(~[
            otcId:x|$x.otcId,
            counterpartyId:x|$x.counterpartyId,
            notional:x|$x.notional,
            lossGivenDefault:x|$x.lossGivenDefault
        ])
        ->sort(~otcId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    OT4_CreditProtection_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"otcId":"OTC-000007","counterpartyId":"CP-0001","notional":10000000.0,"lossGivenDefault":6000000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::OT5_UncollateralisedTrades
{
    pattern: '/stress/ot5';
    documentation: 'Uncollateralised OTC trades and whether they have option terms. The commodity swap has no clearing house and no master agreement -- three optional columns genuinely absent on one row.';
    execution: Single
    {
    query: |derivatives::OtcTrade.all()
        ->filter({x|($x.collateralised == false)})
        ->project(~[
            otcId:x|$x.otcId,
            productType:x|$x.productType,
            collateralised:x|$x.collateralised,
            masterAgreement:x|$x.masterAgreement,
            noOptionTerms:x|$x.optionTerms->isEmpty()
        ])
        ->sort(~otcId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    OT5_UncollateralisedTrades_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 19 rows; 2 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"otcId":"OTC-000006","productType":"CAP","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":false},{"otcId":"OTC-000010","productType":"FX_OPTION","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":false},{"otcId":"OTC-000012","productType":"VARIANCE_SWAP","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000013","productType":"COMMODITY_SWAP","collateralised":false,"masterAgreement":null,"noOptionTerms":true},{"otcId":"OTC-000014","productType":"CONSTANT_MATURITY_SWAP","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000016","productType":"ACCRETING_SWAP","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000018","productType":"CALLABLE_SWAP","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000020","productType":"MIDCURVE_SWAPTION","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000022","productType":"CDS_TRANCHE","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000024","productType":"CREDIT_LINKED_NOTE","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000026","productType":"FX_SWAP","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000028","productType":"FX_ACCUMULATOR","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000030","productType":"EQUITY_OPTION_OTC","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000032","productType":"REVERSE_CONVERTIBLE","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000034","productType":"RAINBOW_OPTION","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000036","productType":"EQUITY_REPO","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000038","productType":"WEATHER_DERIVATIVE","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000040","productType":"CALLABLE_RANGE_ACCRUAL","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000042","productType":"LONGEVITY_SWAP","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true}]';
                  }#;
              }#
