                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"instrumentId":"CI-BD-001","instrumentType":"BOND","subType":"GOVERNMENT","assetClass":"FIXED_INCOME","status":"ACTIVE","currency":"EUR"},{"instrumentId":"CI-BD-002","instrumentType":"BOND","subType":"CORPORATE","assetClass":"FIXED_INCOME","status":"ACTIVE","currency":"USD"},{"instrumentId":"CI-BD-003","instrumentType":"BOND","subType":"CONVERTIBLE","assetClass":"FIXED_INCOME","status":"ACTIVE","currency":"GBP"},{"instrumentId":"CI-DR-001","instrumentType":"DEPOSITARY_RECEIPT","subType":null,"assetClass":"EQUITY","status":"MATURED","currency":"USD"},{"instrumentId":"CI-EQ-001","instrumentType":"EQUITY","subType":"COMMON","assetClass":"EQUITY","status":"ACTIVE","currency":"USD"},{"instrumentId":"CI-EQ-002","instrumentType":"EQUITY","subType":"PREFERRED","assetClass":"EQUITY","status":"ACTIVE","currency":"USD"},{"instrumentId":"CI-EQ-003","instrumentType":"EQUITY","subType":null,"assetClass":"EQUITY","status":"SUSPENDED","currency":"GBP"},{"instrumentId":"CI-ET-001","instrumentType":"ETF","subType":null,"assetClass":"FUND","status":"ACTIVE","currency":"USD"},{"instrumentId":"CI-FU-001","instrumentType":"FUTURE","subType":"COMMODITY","assetClass":"LISTED_DERIVATIVE","status":"ACTIVE","currency":"USD"},{"instrumentId":"CI-FU-002","instrumentType":"FUTURE","subType":"EQUITY_INDEX","assetClass":"LISTED_DERIVATIVE","status":"ACTIVE","currency":"EUR"},{"instrumentId":"CI-OP-001","instrumentType":"OPTION","subType":null,"assetClass":"LISTED_DERIVATIVE","status":"ACTIVE","currency":"USD"},{"instrumentId":"CI-OP-002","instrumentType":"OPTION","subType":null,"assetClass":"LISTED_DERIVATIVE","status":"ACTIVE","currency":"USD"},{"instrumentId":"CI-SW-001","instrumentType":"SWAP","subType":"IRS","assetClass":"OTC_DERIVATIVE","status":"ACTIVE","currency":"USD"},{"instrumentId":"CI-SW-002","instrumentType":"SWAP","subType":"CDS","assetClass":"OTC_DERIVATIVE","status":"ACTIVE","currency":"USD"},{"instrumentId":"CI-SW-003","instrumentType":"SWAP","subType":"TRS","assetClass":"OTC_DERIVATIVE","status":"SUSPENDED","currency":"GBP"},{"instrumentId":"CI-WR-001","instrumentType":"WARRANT","subType":null,"assetClass":"STRUCTURED","status":"ACTIVE","currency":"USD"}]';
