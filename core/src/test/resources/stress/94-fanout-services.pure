Service stress::DSGroup_IdxCountryWeight
{
    pattern: '/stress/dsgroup_idxcountryweight';
    documentation: 'The same reach as DSDeepIdxCountryWeight, then grouped on a NAVIGATED key with aggregates over it. The key came through a join, so a groupBy that grouped before the join would return the same columns and different numbers. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |index_core::IdxCountryWeight.all()
        ->filter({x|($x.rebalance.index.family.provider.name > ' ')})
        ->project(~[
            rebalanceIndexFamilyProviderName:x|$x.rebalance.index.family.provider.name,
            rebalanceId:x|$x.rebalanceId,
            constituentCount:x|$x.constituentCount
        ])
        ->groupBy(~[rebalanceIndexFamilyProviderName], ~[
            n: x|$x.rebalanceId : agg|$agg->count(),
            total: x|$x.constituentCount : agg|$agg->sum()
        ])
        ->sort(~rebalanceIndexFamilyProviderName->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSGroup_IdxCountryWeight_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rebalanceIndexFamilyProviderName":"Aventine Benchmarks GmbH","n":2,"total":2},{"rebalanceIndexFamilyProviderName":"Northgate Index Services","n":3,"total":4}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

