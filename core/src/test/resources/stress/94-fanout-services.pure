Service stress::LEDX_All
{
    pattern: '/stress/ledx_all';
    documentation: 'Every row of ledger::AccountingEntry, unfiltered. The subtype services partition this same table by discriminator; this is the whole of it, and therefore the only service that would show a row whose type code matches no subtype at all. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |ledger::AccountingEntry.all()
        ->project(~[
            entryId:x|$x.entryId,
            entryType:x|$x.entryType,
            netMovement:x|$x.netMovement,
            accountCode:x|$x.accountCode,
            isReversal:x|$x.isReversal,
            sourceRef:x|$x.sourceRef
        ])
        ->sort(~entryId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    LEDX_All_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 16 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"entryId":"LED-00001","entryType":"TRADE_BOOKING","netMovement":12500.5,"accountCode":"1000-ASSET","isReversal":false,"sourceRef":null},{"entryId":"LED-00002","entryType":"SETTLEMENT_ENTRY","netMovement":-25001.0,"accountCode":"1010-LIAB","isReversal":true,"sourceRef":"OTC-000002"},{"entryId":"LED-00004","entryType":"REALISED_PNL","netMovement":-50002.0,"accountCode":"1030-ASSET","isReversal":false,"sourceRef":null},{"entryId":"LED-00005","entryType":"UNREALISED_PNL","netMovement":62502.5,"accountCode":"1040-LIAB","isReversal":false,"sourceRef":"OTC-000005"},{"entryId":"LED-00007","entryType":"ACCRUAL_REVERSAL","netMovement":87503.5,"accountCode":"1060-ASSET","isReversal":false,"sourceRef":null},{"entryId":"LED-00008","entryType":"FX_REVALUATION","netMovement":-100004.0,"accountCode":"1070-LIAB","isReversal":false,"sourceRef":"OTC-000008"},{"entryId":"LED-00010","entryType":"COMMISSION_ENTRY","netMovement":-125005.0,"accountCode":"1090-ASSET","isReversal":false,"sourceRef":null},{"entryId":"LED-00011","entryType":"FEE_ENTRY","netMovement":137505.5,"accountCode":"1100-LIAB","isReversal":false,"sourceRef":"OTC-000011"},{"entryId":"LED-00013","entryType":"INTEREST_ENTRY","netMovement":162506.5,"accountCode":"1120-ASSET","isReversal":false,"sourceRef":null},{"entryId":"LED-00014","entryType":"DIVIDEND_ENTRY","netMovement":-175007.0,"accountCode":"1130-LIAB","isReversal":false,"sourceRef":"OTC-000001"},{"entryId":"LED-00016","entryType":"COUPON_ENTRY","netMovement":-200008.0,"accountCode":"1150-ASSET","isReversal":true,"sourceRef":null},{"entryId":"LED-00017","entryType":"IMPAIRMENT","netMovement":212508.5,"accountCode":"1160-LIAB","isReversal":false,"sourceRef":"OTC-000004"},{"entryId":"LED-00019","entryType":"WRITE_OFF","netMovement":237509.5,"accountCode":"1180-ASSET","isReversal":false,"sourceRef":null},{"entryId":"LED-00020","entryType":"RECLASSIFICATION","netMovement":-250010.0,"accountCode":"1190-LIAB","isReversal":false,"sourceRef":"OTC-000007"},{"entryId":"LED-00022","entryType":"MANUAL_ADJUSTMENT","netMovement":-275011.0,"accountCode":"1210-ASSET","isReversal":false,"sourceRef":null},{"entryId":"LED-00023","entryType":"YEAR_END_CLOSE","netMovement":287511.5,"accountCode":"1220-LIAB","isReversal":true,"sourceRef":"OTC-000010"}]';
                  }#;
