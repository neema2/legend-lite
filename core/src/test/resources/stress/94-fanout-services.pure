Service stress::CV2_FittedPillars
{
    pattern: '/stress/cv2';
    documentation: 'Each pillar and the market-data series it was fitted to, where there is one. Four pillars of 192 have a source series, so the navigation is empty for 188 of them -- the majority case, not an edge case. Reached from a composite-key root, which is the combination nothing executed before.';
    execution: Single
    {
    query: |curves::CurvePoint.all()
        ->project(~[
            curveId:x|$x.curveId,
            cobDate:x|$x.cobDate,
            tenorLabel:x|$x.tenorLabel,
            sourceSeriesId:x|$x.sourceSeriesId,
            seriesName:x|$x.sourceSeries.seriesName,
            seriesFrequency:x|$x.sourceSeries.frequency,
            seriesAssetClass:x|$x.sourceSeries.assetClass
        ])
        ->sort([~curveId->ascending(), ~cobDate->ascending(), ~tenorLabel->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CV2_FittedPillars_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 192 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
