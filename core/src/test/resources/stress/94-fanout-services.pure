    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"cityId":"CT-EDI","countrySubRegionMacroRegionName":"Europe, Middle East and Africa","countrySubRegionName":"Northern Europe","countryProfileCountryCode":"GB","countryName":"United Kingdom"},{"cityId":"CT-FRA","countrySubRegionMacroRegionName":"Europe, Middle East and Africa","countrySubRegionName":"Western Europe","countryProfileCountryCode":"DE","countryName":"Germany"},{"cityId":"CT-LON","countrySubRegionMacroRegionName":"Europe, Middle East and Africa","countrySubRegionName":"Northern Europe","countryProfileCountryCode":"GB","countryName":"United Kingdom"},{"cityId":"CT-REY","countrySubRegionMacroRegionName":"Europe, Middle East and Africa","countrySubRegionName":"Northern Europe","countryProfileCountryCode":"IS","countryName":"Iceland"}]';
                  }#;
              }#
          ]
        }
      ]
    }
