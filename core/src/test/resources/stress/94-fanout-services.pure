Service stress::DSGroup_Book
{
    pattern: '/stress/dsgroup_book';
    documentation: 'The same reach as DSDeepBook, then grouped on a NAVIGATED key with aggregates over it. The key came through a join, so a groupBy that grouped before the join would return the same columns and different numbers. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |positions::Book.all()
        ->filter({x|($x.desk.businessUnit.legalEntity.region.name > ' ')})
        ->project(~[
