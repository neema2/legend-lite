Service stress::MD2_SeriesStatistics
{
    pattern: '/stress/md2';
    documentation: 'Per-series statistics over the observation history: how many prints, the high, the low and the mean. The count is the assertion that matters -- 14 for a daily series and 3 for a monthly one. A group-by that has collapsed into a table scan returns 191 everywhere and looks perfectly reasonable.';
    execution: Single
    {
    query: |timeseries::Observation.all()
        ->project(~[
            seriesId:x|$x.seriesId,
            obsValue:x|$x.obsValue
        ])
        ->groupBy(~[seriesId], ~[
            observations: x|$x.obsValue : agg|$agg->count(),
            high: x|$x.obsValue : agg|$agg->max(),
            low: x|$x.obsValue : agg|$agg->min(),
            mean: x|$x.obsValue : agg|$agg->average()
        ])
        ->sort(~seriesId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MD2_SeriesStatistics_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 16 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"seriesId":"BRENT.M1","observations":14,"high":85.33,"low":77.52,"mean":81.80428571428571},{"seriesId":"CPI.US.YOY","observations":3,"high":3.4,"low":3.0,"mean":3.2333333333333334},{"seriesId":"DBR.10Y","observations":14,"high":2.664,"low":2.362,"mean":2.5022142857142855},{"seriesId":"EURIBOR.3M","observations":14,"high":3.812,"low":3.699,"mean":3.745285714285714},{"seriesId":"EURUSD","observations":14,"high":1.0895,"low":1.0703,"mean":1.0781928571428572},{"seriesId":"GBPUSD","observations":14,"high":1.2797,"low":1.2661,"mean":1.2741214285714286},{"seriesId":"HICP.EA.YOY","observations":3,"high":2.6,"low":2.4,"mean":2.5},{"seriesId":"LME.CU3M","observations":14,"high":10122.5,"low":9583.5,"mean":9785.75},{"seriesId":"SOFR.ON","observations":14,"high":5.34,"low":5.32,"mean":5.331428571428572},{"seriesId":"SPX.CLOSE","observations":14,"high":5487.03,"low":5283.4,"mean":5396.375},{"seriesId":"UNRATE.US","observations":3,"high":4.1,"low":3.9,"mean":4.0},{"seriesId":"USDJPY","observations":14,"high":159.79,"low":155.66,"mean":157.3292857142857},{"seriesId":"UST.10Y","observations":14,"high":4.469,"low":4.212,"mean":4.313071428571429},{"seriesId":"VIX","observations":14,"high":13.28,"low":12.2,"mean":12.740714285714287},{"seriesId":"WTI.M1","observations":14,"high":81.57,"low":73.25,"mean":77.63785714285714},{"seriesId":"XAU.PM","observations":14,"high":2375.55,"low":2293.05,"mean":2326.4357142857143}]';
