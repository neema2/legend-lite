  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  clientreporting::ClientReport
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
