            bookId:x|$x.bookId,
            positionCount:x|$x.positionCount
        ])
        ->groupBy(~[deskBusinessUnitLegalEntityRegionName], ~[
            n: x|$x.bookId : agg|$agg->count(),
            total: x|$x.positionCount : agg|$agg->sum()
        ])
        ->sort(~deskBusinessUnitLegalEntityRegionName->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
