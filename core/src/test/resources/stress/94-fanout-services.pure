Service stress::BO0_PaymentBlotter
{
    pattern: '/stress/bo0';
    documentation: 'Payments with the instruction that routed each and the trade behind it. Failed, cancelled and pending payments have no settlement time and the failed one carries a reason.';
    execution: Single
    {
    query: |backoffice::Payment.all()
        ->project(~[
            paymentId:x|$x.paymentId,
            paymentType:x|$x.paymentType,
            direction:x|$x.direction,
            amount:x|$x.amount,
            signedAmount:x|$x.signedAmount,
            status:x|$x.status,
            settledAt:x|$x.settledAt,
            failReason:x|$x.failReason,
            correspondentBic:x|$x.instruction.correspondentBic
        ])
        ->sort(~paymentId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    BO0_PaymentBlotter_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"paymentId":"PMT-000001","paymentType":"SWIFT_MT202","direction":"OUT","amount":666400.0,"signedAmount":-666400.0,"status":"SETTLED","settledAt":"2024-06-19T09:12:00.000000000+0000","failReason":null,"correspondentBic":"CHASUS33"},{"paymentId":"PMT-000002","paymentType":"TARGET2","direction":"IN","amount":725812.5,"signedAmount":725812.5,"status":"SETTLED","settledAt":"2024-05-13T08:40:00.000000000+0000","failReason":null,"correspondentBic":"DEUTDEFF"},{"paymentId":"PMT-000003","paymentType":"SWIFT_MT202","direction":"OUT","amount":84500.0,"signedAmount":-84500.0,"status":"FAILED","settledAt":null,"failReason":"Beneficiary account closed","correspondentBic":"CHASUS33"},{"paymentId":"PMT-000004","paymentType":"BOOK_TRANSFER","direction":"IN","amount":112000.0,"signedAmount":112000.0,"status":"CANCELLED","settledAt":null,"failReason":"Underlying termination cancelled","correspondentBic":"BOFAUS3N"},{"paymentId":"PMT-000005","paymentType":"FEDWIRE","direction":"OUT","amount":41250.0,"signedAmount":-41250.0,"status":"PENDING","settledAt":null,"failReason":null,"correspondentBic":"BOFAUS3N"},{"paymentId":"PMT-000006","paymentType":"TARGET2","direction":"OUT","amount":312500.0,"signedAmount":-312500.0,"status":"SETTLED","settledAt":"2024-06-20T14:05:00.000000000+0000","failReason":null,"correspondentBic":"DEUTDEFF"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::BO1_Reconciliation
{
    pattern: '/stress/bo1';
    documentation: 'The nostro reconciliation. An unmatched STATEMENT item has no payment behind it and an unmatched LEDGER item has no movement, so the two null columns are the finding rather than missing data.';
    execution: Single
    {
    query: |backoffice::ReconciliationItem.all()
        ->project(~[
            reconId:x|$x.reconId,
            itemType:x|$x.itemType,
            amount:x|$x.amount,
            status:x|$x.status,
            assignedTo:x|$x.assignedTo,
            ageDays:x|$x.ageDays,
            paymentId:x|$x.paymentId,
            movementId:x|$x.movementId,
            accountName:x|$x.reconNostro.accountName
        ])
        ->sort(~reconId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    BO1_Reconciliation_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"reconId":"REC-00001","itemType":"MATCHED","amount":666400.0,"status":"CLOSED","assignedTo":null,"ageDays":0,"paymentId":"PMT-000001","movementId":"MOV-000001","accountName":"USD clearing - JPM"},{"reconId":"REC-00002","itemType":"MATCHED","amount":725812.5,"status":"CLOSED","assignedTo":null,"ageDays":0,"paymentId":"PMT-000002","movementId":"MOV-000002","accountName":"EUR clearing - DB"},{"reconId":"REC-00003","itemType":"UNMATCHED_STATEMENT","amount":9350.0,"status":"OPEN","assignedTo":"bo.recon.ny","ageDays":6,"paymentId":null,"movementId":"MOV-000003","accountName":"USD clearing - JPM"},{"reconId":"REC-00004","itemType":"UNMATCHED_LEDGER","amount":84500.0,"status":"OPEN","assignedTo":"bo.recon.ny","ageDays":44,"paymentId":"PMT-000003","movementId":null,"accountName":"USD clearing - JPM"},{"reconId":"REC-00005","itemType":"VALUE_DATE_MISMATCH","amount":312500.0,"status":"INVESTIGATING","assignedTo":"bo.recon.frankfurt","ageDays":6,"paymentId":"PMT-000006","movementId":"MOV-000004","accountName":"EUR clearing - DB"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::BO2_ValueDateBreaks
{
    pattern: '/stress/bo2';
    documentation: 'Value-date mismatches only: matched on money, broken on timing. The break an amount-only reconciliation misses entirely.';
    execution: Single
    {
    query: |backoffice::ValueDateMismatchItem.all()
        ->project(~[
            reconId:x|$x.reconId,
            amount:x|$x.amount,
            assignedTo:x|$x.assignedTo,
            ageDays:x|$x.ageDays
        ])
        ->sort(~reconId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    BO2_ValueDateBreaks_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"reconId":"REC-00005","amount":312500.0,"assignedTo":"bo.recon.frankfurt","ageDays":6}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::BO3_StandingInstructions
{
    pattern: '/stress/bo3';
    documentation: 'Standing settlement instructions. The superseded one carries an end date and the securities one has no currency -- it settles a position, not an amount.';
    execution: Single
    {
    query: |backoffice::SettlementInstruction.all()
        ->project(~[
            ssiId:x|$x.ssiId,
            currency:x|$x.currency,
            instrumentType:x|$x.instrumentType,
            correspondentBic:x|$x.correspondentBic,
            isDefault:x|$x.isDefault,
            effectiveTo:x|$x.effectiveTo,
            status:x|$x.status,
            legalName:x|$x.ssiCounterparty.legalName
        ])
        ->sort(~ssiId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    BO3_StandingInstructions_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ssiId":"SSI-EUR-CP0001","currency":"EUR","instrumentType":"CASH","correspondentBic":"DEUTDEFF","isDefault":true,"effectiveTo":null,"status":"ACTIVE","legalName":"Meridian Asset Management"},{"ssiId":"SSI-SEC-CP0003","currency":null,"instrumentType":"SECURITIES","correspondentBic":"ECLRLULL","isDefault":true,"effectiveTo":null,"status":"ACTIVE","legalName":"O\'Neill Capital Partners"},{"ssiId":"SSI-USD-CP0001","currency":"USD","instrumentType":"CASH","correspondentBic":"CHASUS33","isDefault":true,"effectiveTo":null,"status":"ACTIVE","legalName":"Meridian Asset Management"},{"ssiId":"SSI-USD-CP0002","currency":"USD","instrumentType":"CASH","correspondentBic":"BOFAUS3N","isDefault":true,"effectiveTo":null,"status":"ACTIVE","legalName":"Halberd Securities"},{"ssiId":"SSI-USD-CP0002-OLD","currency":"USD","instrumentType":"CASH","correspondentBic":"CITIUS33","isDefault":false,"effectiveTo":"2021-05-31","status":"SUPERSEDED","legalName":"Halberd Securities"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::BO4_CashByCurrency
{
    pattern: '/stress/bo4';
    documentation: 'Payments by currency and status: the treasury cash ladder.';
    execution: Single
    {
    query: |backoffice::Payment.all()
        ->project(~[
            currency:x|$x.currency,
            status:x|$x.status,
            amount:x|$x.amount
        ])
        ->groupBy(~[currency, status], ~[
            paymentCount: x|$x.amount : agg|$agg->count(),
            totalAmount: x|$x.amount : agg|$agg->sum(),
            largest: x|$x.amount : agg|$agg->max()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    BO4_CashByCurrency_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"EUR","status":"SETTLED","paymentCount":2,"totalAmount":1038312.5,"largest":725812.5},{"currency":"USD","status":"SETTLED","paymentCount":1,"totalAmount":666400.0,"largest":666400.0},{"currency":"USD","status":"FAILED","paymentCount":1,"totalAmount":84500.0,"largest":84500.0},{"currency":"USD","status":"CANCELLED","paymentCount":1,"totalAmount":112000.0,"largest":112000.0},{"currency":"USD","status":"PENDING","paymentCount":1,"totalAmount":41250.0,"largest":41250.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::BO5_NostroAccounts
{
    pattern: '/stress/bo5';
    documentation: 'Nostro accounts with whether anything is outstanding against them. The inactive GBP account has no movements and no reconciliation items, which is two empty to-manys on one row.';
    execution: Single
    {
    query: |backoffice::NostroAccount.all()
        ->project(~[
            nostroId:x|$x.nostroId,
            accountName:x|$x.accountName,
            isActive:x|$x.isActive,
            noMovements:x|$x.movements->isEmpty(),
            noReconItems:x|$x.reconItems->isEmpty()
        ])
        ->sort(~nostroId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    BO5_NostroAccounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 4 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"nostroId":"NOS-EUR-DEUT","accountName":"EUR clearing - DB","isActive":true,"noMovements":false,"noReconItems":false},{"nostroId":"NOS-GBP-BARC","accountName":"GBP clearing - Barclays","isActive":false,"noMovements":true,"noReconItems":true},{"nostroId":"NOS-USD-CHAS","accountName":"USD clearing - JPM","isActive":true,"noMovements":false,"noReconItems":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MD0_SeriesCatalogue
{
    pattern: '/stress/md0';
    documentation: 'The market-data catalogue: sixteen series across rates, FX, equity, commodity and macro, with the vendor ticker built from a caller-supplied vendor code and the derived daily/monthly flag.';
    execution: Single
    {
    query: |timeseries::TimeSeries.all()
        ->project(~[
            seriesId:x|$x.seriesId,
            seriesName:x|$x.seriesName,
            assetClass:x|$x.assetClass,
            frequency:x|$x.frequency,
            currency:x|$x.currency,
            decimalPlaces:x|$x.decimalPlaces,
            isDaily:x|$x.isDaily,
            bloombergTicker:x|$x.tickerOn('BBG')
        ])
        ->sort(~seriesId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MD0_SeriesCatalogue_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 16 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"seriesId":"BRENT.M1","seriesName":"Brent Crude Front Month","assetClass":"COMMODITY","frequency":"DAILY","currency":"USD","decimalPlaces":2,"isDaily":true,"bloombergTicker":"BBG/ICE:BRENT.M1"},{"seriesId":"CPI.US.YOY","seriesName":"US CPI All Items Year on Year","assetClass":"MACRO","frequency":"MONTHLY","currency":"USD","decimalPlaces":1,"isDaily":false,"bloombergTicker":"BBG/BLS:CPI.US.YOY"},{"seriesId":"DBR.10Y","seriesName":"German Bund 10 Year Yield","assetClass":"RATES","frequency":"DAILY","currency":"EUR","decimalPlaces":3,"isDaily":true,"bloombergTicker":"BBG/BUNDESBANK:DBR.10Y"},{"seriesId":"EURIBOR.3M","seriesName":"Euribor 3 Month","assetClass":"RATES","frequency":"DAILY","currency":"EUR","decimalPlaces":3,"isDaily":true,"bloombergTicker":"BBG/EMMI:EURIBOR.3M"},{"seriesId":"EURUSD","seriesName":"Euro US Dollar Spot","assetClass":"FX","frequency":"DAILY","currency":"USD","decimalPlaces":4,"isDaily":true,"bloombergTicker":"BBG/WMR16:EURUSD"},{"seriesId":"GBPUSD","seriesName":"Sterling US Dollar Spot","assetClass":"FX","frequency":"DAILY","currency":"USD","decimalPlaces":4,"isDaily":true,"bloombergTicker":"BBG/WMR16:GBPUSD"},{"seriesId":"HICP.EA.YOY","seriesName":"Euro Area HICP Year on Year","assetClass":"MACRO","frequency":"MONTHLY","currency":"EUR","decimalPlaces":1,"isDaily":false,"bloombergTicker":"BBG/EUROSTAT:HICP.EA.YOY"},{"seriesId":"LME.CU3M","seriesName":"LME Copper 3 Month","assetClass":"COMMODITY","frequency":"DAILY","currency":"USD","decimalPlaces":2,"isDaily":true,"bloombergTicker":"BBG/LME:LME.CU3M"},{"seriesId":"SOFR.ON","seriesName":"SOFR Overnight Financing Rate","assetClass":"RATES","frequency":"DAILY","currency":"USD","decimalPlaces":2,"isDaily":true,"bloombergTicker":"BBG/NYFED:SOFR.ON"},{"seriesId":"SPX.CLOSE","seriesName":"S&P 500 Index Close","assetClass":"EQUITY","frequency":"DAILY","currency":"USD","decimalPlaces":2,"isDaily":true,"bloombergTicker":"BBG/CBOE:SPX.CLOSE"},{"seriesId":"UNRATE.US","seriesName":"US Unemployment Rate","assetClass":"MACRO","frequency":"MONTHLY","currency":"USD","decimalPlaces":1,"isDaily":false,"bloombergTicker":"BBG/BLS:UNRATE.US"},{"seriesId":"USDJPY","seriesName":"US Dollar Japanese Yen Spot","assetClass":"FX","frequency":"DAILY","currency":"JPY","decimalPlaces":2,"isDaily":true,"bloombergTicker":"BBG/WMR16:USDJPY"},{"seriesId":"UST.10Y","seriesName":"US Treasury 10 Year Yield","assetClass":"RATES","frequency":"DAILY","currency":"USD","decimalPlaces":3,"isDaily":true,"bloombergTicker":"BBG/FEDH15:UST.10Y"},{"seriesId":"VIX","seriesName":"CBOE Volatility Index","assetClass":"EQUITY","frequency":"DAILY","currency":"USD","decimalPlaces":2,"isDaily":true,"bloombergTicker":"BBG/CBOE:VIX"},{"seriesId":"WTI.M1","seriesName":"WTI Crude Front Month","assetClass":"COMMODITY","frequency":"DAILY","currency":"USD","decimalPlaces":2,"isDaily":true,"bloombergTicker":"BBG/NYMEX:WTI.M1"},{"seriesId":"XAU.PM","seriesName":"Gold LBMA PM Fix","assetClass":"COMMODITY","frequency":"DAILY","currency":"USD","decimalPlaces":2,"isDaily":true,"bloombergTicker":"BBG/LBMA:XAU.PM"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MD1_ObservationHistory
{
    pattern: '/stress/md1';
    documentation: 'Every observation with the move since the previous print, in level and in basis points, plus the series it belongs to. Sixteen of the 191 rows are a series\' first observation and have no prior value: change is zero there because the discharge is orElse(obsValue), and would be the entire level if it were orElse(0.0).';
    execution: Single
    {
    query: |timeseries::Observation.all()
        ->project(~[
            obsId:x|$x.obsId,
            obsDate:x|$x.obsDate,
            obsValue:x|$x.obsValue,
            priorValue:x|$x.priorValue,
            change:x|$x.change,
            changeInBps:x|$x.changeInBps,
            status:x|$x.status,
            seriesName:x|$x.series.seriesName,
            assetClass:x|$x.series.assetClass
        ])
        ->sort(~obsId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MD1_ObservationHistory_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 191 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"obsId":"OBS-BRENT.M1-01","obsDate":"2024-06-03","obsValue":78.36,"priorValue":null,"change":0.0,"changeInBps":0.0,"status":"FINAL","seriesName":"Brent Crude Front Month","assetClass":"COMMODITY"},{"obsId":"OBS-BRENT.M1-02","obsDate":"2024-06-04","obsValue":77.52,"priorValue":78.36,"change":-0.84,"changeInBps":-84.0,"status":"FINAL","seriesName":"Brent Crude Front Month","assetClass":"COMMODITY"},{"obsId":"OBS-BRENT.M1-03","obsDate":"2024-06-05","obsValue":77.52,"priorValue":77.52,"change":0.0,"changeInBps":0.0,"status":"FINAL","seriesName":"Brent Crude Front Month","assetClass":"COMMODITY"},{"obsId":"OBS-BRENT.M1-04","obsDate":"2024-06-06","obsValue":79.87,"priorValue":77.52,"change":2.35,"changeInBps":235.0,"status":"FINAL","seriesName":"Brent Crude Front Month","assetClass":"COMMODITY"},{"obsId":"OBS-BRENT.M1-05","obsDate":"2024-06-07","obsValue":79.62,"priorValue":79.87,"change":-0.25,"changeInBps":-25.0,"status":"FINAL","seriesName":"Brent Crude Front Month","assetClass":"COMMODITY"},{"obsId":"OBS-BRENT.M1-06","obsDate":"2024-06-10","obsValue":82.63,"priorValue":79.62,"change":3.01,"changeInBps":301.0,"status":"FINAL","seriesName":"Brent Crude Front Month","assetClass":"COMMODITY"},{"obsId":"OBS-BRENT.M1-07","obsDate":"2024-06-11","obsValue":81.92,"priorValue":82.63,"change":-0.71,"changeInBps":-71.0,"status":"FINAL","seriesName":"Brent Crude Front Month","assetClass":"COMMODITY"},{"obsId":"OBS-BRENT.M1-08","obsDate":"2024-06-12","obsValue":82.75,"priorValue":81.92,"change":0.83,"changeInBps":83.0,"status":"FINAL","seriesName":"Brent Crude Front Month","assetClass":"COMMODITY"},{"obsId":"OBS-BRENT.M1-09","obsDate":"2024-06-13","obsValue":82.62,"priorValue":82.75,"change":-0.13,"changeInBps":-13.0,"status":"FINAL","seriesName":"Brent Crude Front Month","assetClass":"COMMODITY"},{"obsId":"OBS-BRENT.M1-10","obsDate":"2024-06-14","obsValue":82.56,"priorValue":82.62,"change":-0.06,"changeInBps":-6.0,"status":"FINAL","seriesName":"Brent C