Service stress::DSDeep_Book
{
    pattern: '/stress/dsdeep_book';
    documentation: 'The deepest to-one reach positions::Book offers, filtered on a NAVIGATED column rather than a local one, composite-sorted and limited. A predicate over a joined column has to be placed relative to the join, which a filter on the root never tests. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |positions::Book.all()
        ->filter({x|($x.desk.businessUnit.legalEntity.region.name > ' ') && ($x.currency > ' ')})
        ->project(~[
            bookId:x|$x.bookId,
            deskBusinessUnitLegalEntityRegionName:x|$x.desk.businessUnit.legalEntity.region.name,
            deskBusinessUnitLegalEntityJurisdiction:x|$x.desk.businessUnit.legalEntity.jurisdiction,
            deskBusinessUnitName:x|$x.desk.businessUnit.name,
            rollupBookId:x|$x.rollup.bookId
        ])
        ->sort(~bookId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
