Service stress::DSTree_CapitalInstrument
{
    pattern: '/stress/dstree_capitalinstrument';
    documentation: 'A graphFetch 4 levels deep from capitalinstruments::CapitalInstrument. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |capitalinstruments::CapitalInstrument.all()
        ->graphFetch(#{
  capitalinstruments::CapitalInstrument
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  capitalinstruments::CapitalInstrument
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
