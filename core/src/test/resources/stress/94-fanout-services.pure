Service stress::DSTree_RiskAppetiteMetric
{
    pattern: '/stress/dstree_riskappetitemetric';
    documentation: 'A graphFetch 4 levels deep from appetitemetrics::RiskAppetiteMetric. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |appetitemetrics::RiskAppetiteMetric.all()
        ->graphFetch(#{
  appetitemetrics::RiskAppetiteMetric
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  appetitemetrics::RiskAppetiteMetric
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSTree_RiskAppetiteMetric_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 33 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"recordId":"RAP-00001","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00002","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00003","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00004","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00005","book":null},{"recordId":"RAP-00006","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00010","book":null},{"recordId":"RAP-00011","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00012","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00013","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00014","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00015","book":null},{"recordId":"RAP-00019","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00020","book":null},{"recordId":"RAP-00021","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00022","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00023","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00024","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00028","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00029","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00030","book":null},{"recordId":"RAP-00031","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00032","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00033","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00037","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00038","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00039","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00040","book":null},{"recordId":"RAP-00041","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00042","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00046","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00047","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"RAP-00048","book":{"desk":{"businessUnit":{"legalEntity":null}}}}]}';
