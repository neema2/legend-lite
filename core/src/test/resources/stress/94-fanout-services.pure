        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"cityId":"CT-EDI","cityName":"Edinburgh","timeZone":"Europe/London","country":"United Kingdom","subRegion":"Northern Europe","macroRegion":"Europe, Middle East and Africa","incomeGroup":"HIGH"},{"cityId":"CT-FRA","cityName":"Frankfurt","timeZone":"Europe/Berlin","country":"Germany","subRegion":"Western Europe","macroRegion":"Europe, Middle East and Africa","incomeGroup":"HIGH"},{"cityId":"CT-LON","cityName":"London","timeZone":"Europe/London","country":"United Kingdom","subRegion":"Northern Europe","macroRegion":"Europe, Middle East and Africa","incomeGroup":"HIGH"},{"cityId":"CT-REY","cityName":"Reykjavik","timeZone":null,"country":"Iceland","subRegion":"Northern Europe","macroRegion":"Europe, Middle East and Africa","incomeGroup":"HIGH"}]';
