Service stress::DQRX_CompletenessRule
{
    pattern: '/stress/dqrx_completenessrule';
    documentation: 'dataquality::CompletenessRule only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |dataquality::CompletenessRule.all()
        ->project(~[
            recordId:x|$x.recordId,
            recordType:x|$x.recordType,
            notionalPerRiskPoint:x|$x.notionalPerRiskPoint,
            notionalGbp:x|$x.notionalIn(0.79),
            currency:x|$x.currency,
            maturityDate:x|$x.maturityDate,
            isActive:x|$x.isActive
        ])
        ->sort(~recordId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DQRX_CompletenessRule_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"recordId":"DQR-00001","recordType":"COMPLETENESS","notionalPerRiskPoint":1000000.0,"notionalGbp":987500.0,"currency":"USD","maturityDate":null,"isActive":true},{"recordId":"DQR-00002","recordType":"COMPLETENESS","notionalPerRiskPoint":1666666.6666666667,"notionalGbp":1975000.0,"currency":"EUR","maturityDate":"2026-02-02","isActive":true},{"recordId":"DQR-00003","recordType":"COMPLETENESS","notionalPerRiskPoint":2142857.1428571427,"notionalGbp":2962500.0,"currency":"GBP","maturityDate":"2027-03-03","isActive":false}]';
