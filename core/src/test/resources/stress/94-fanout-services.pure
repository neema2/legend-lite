Service stress::PL9_CounterpartyRatingCount
{
    pattern: '/stress/pl9';
    documentation: 'How many rating versions each counterparty has ever had, reaching a MILESTONED class in another project from a CORPUS root. Counted rather than projected because the navigation is to-many; two counterparties have no rating at all, which is F6\'s empty-set case and why they are filtered out rather than shown as zero.';
    execution: Single
    {
    query: |counterparty::Counterparty.all()
        ->filter({x|($x.counterpartyId < 'CP-0004')})
        ->project(~[
            counterpartyId:x|$x.counterpartyId,
            legalName:x|$x.legalName,
            versions:x|$x.ratingVersions(%2024-08-01)->count()
        ])
        ->sort(~counterpartyId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL9_CounterpartyRatingCount_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"counterpartyId":"CP-0001","legalName":"Meridian Asset Management","versions":1},{"counterpartyId":"CP-0002","legalName":"Halberd Securities","versions":1},{"counterpartyId":"CP-0003","legalName":"O\'Neill Capital Partners","versions":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL10_FeeScheduleTenorBand
{
    pattern: '/stress/pl10';
    documentation: 'Which core-tenor band each fee schedule falls in, resolved by a RANGE join declared in fee-core over a table it only includes -- a project-to-project edge executed. Every seeded tenor is a band boundary or outside every band, so an off-by-one in the half-open range changes an answer here. The last row matches no band at all and must read null rather than the nearest one.';
    execution: Single
    {
    query: |fee_core::FeeSchedule.all()
        ->project(~[
            productCode:x|$x.productCode,
            tierCode:x|$x.tierCode,
            effectiveDate:x|$x.effectiveDate,
            days:x|$x.daysToMaturity,
            bucketId:x|$x.bucket.bucketId,
            band:x|$x.bucket.band,
            bandLabel:x|$x.bucket.label
        ])
        ->sort(~productCode->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL10_FeeScheduleTenorBand_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 8 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"productCode":"FP-EQOPT","tierCode":"RETAIL","effectiveDate":"2024-03-15","days":366,"bucketId":"CTN-06","band":"Y1_3","bandLabel":"1-3y"},{"productCode":"FP-EQOPT","tierCode":"INST","effectiveDate":"2024-03-15","days":3654,"bucketId":"CTN-09","band":"Y10_PLUS","bandLabel":"10y+"},{"productCode":"FP-FXFWD","tierCode":"RETAIL","effectiveDate":"2024-01-01","days":8,"bucketId":"CTN-02","band":"D8_30","bandLabel":"8-30d"},{"productCode":"FP-FXFWD","tierCode":"INST","effectiveDate":"2024-01-01","days":365,"bucketId":"CTN-05","band":"M6_12","bandLabel":"6-12m"},{"productCode":"FP-IRS","tierCode":"RETAIL","effectiveDate":"2024-01-01","days":7,"bucketId":"CTN-01","band":"D0_7","bandLabel":"0-7d"},{"productCode":"FP-IRS","tierCode":"RETAIL","effectiveDate":"2024-07-01","days":7,"bucketId":"CTN-01","band":"D0_7","bandLabel":"0-7d"},{"productCode":"FP-IRS","tierCode":"INST","effectiveDate":"2024-01-01","days":7,"bucketId":"CTN-01","band":"D0_7","bandLabel":"0-7d"},{"productCode":"FP-RETIRED","tierCode":"PRIVATE","effectiveDate":"2024-02-01","days":40000,"bucketId":null,"band":null,"bandLabel":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL11_FeeScheduleGrossFee
{
    pattern: '/stress/pl11';
    documentation: 'A derived property and a qualified property TAKING AN ARGUMENT, both calling core_types::ctBasisPointsToRate across two project boundaries at once: the corpus links fee-core, and fee-core is why core-types is here at all. The oracle reimplements that function from core-types\' own source rather than reading the engine\'s answer back.';
    execution: Single
    {
    query: |fee_core::FeeSchedule.all()
        ->project(~[
            productCode:x|$x.productCode,
            tierCode:x|$x.tierCode,
            effectiveDate:x|$x.effectiveDate,
            bps:x|$x.rateBasisPoints,
            rate:x|$x.rate,
            grossOnMillion:x|$x.grossFee(1000000.0)
        ])
