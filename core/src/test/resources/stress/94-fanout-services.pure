Service stress::DSGroup_CgCity
{
    pattern: '/stress/dsgroup_cgcity';
    documentation: 'The same reach as DSDeepCgCity, then grouped on a NAVIGATED key with aggregates over it. The key came through a join, so a groupBy that grouped before the join would return the same columns and different numbers. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |core_geo::CgCity.all()
        ->filter({x|($x.country.subRegion.macroRegion.name > ' ')})
        ->project(~[
            countrySubRegionMacroRegionName:x|$x.country.subRegion.macroRegion.name,
            cityId:x|$x.cityId,
            population:x|$x.population
        ])
        ->groupBy(~[countrySubRegionMacroRegionName], ~[
            n: x|$x.cityId : agg|$agg->count(),
            total: x|$x.population : agg|$agg->sum()
        ])
        ->sort(~countrySubRegionMacroRegionName->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSGroup_CgCity_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"countrySubRegionMacroRegionName":"Europe, Middle East and Africa","n":4,"total":10392499}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSTree_CgCity
{
    pattern: '/stress/dstree_cgcity';
    documentation: 'A graphFetch 3 levels deep from core_geo::CgCity. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |core_geo::CgCity.all()
        ->graphFetch(#{
  core_geo::CgCity
  {
    cityId,
    country
    {
      subRegion
      {
        macroRegion
        {
          name,
          macroRegionId
        }
      }
    }
  }
}#)
        ->serialize(#{
  core_geo::CgCity
  {
    cityId,
    country
    {
      subRegion
      {
        macroRegion
        {
          name,
          macroRegionId
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSTree_CgCity_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"cityId":"CT-LON","country":{"subRegion":{"macroRegion":{"name":"Europe, Middle East and Africa","macroRegionId":"MR-EMEA"}}}},{"cityId":"CT-EDI","country":{"subRegion":{"macroRegion":{"name":"Europe, Middle East and Africa","macroRegionId":"MR-EMEA"}}}},{"cityId":"CT-FRA","country":{"subRegion":{"macroRegion":{"name":"Europe, Middle East and Africa","macroRegionId":"MR-EMEA"}}}},{"cityId":"CT-REY","country":{"subRegion":{"macroRegion":{"name":"Europe, Middle East and Africa","macroRegionId":"MR-EMEA"}}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

