Service stress::PL12_InstrumentTypeCensus
{
    pattern: '/stress/pl12';
    documentation: 'Every row of a project\'s instrument master through its UNFILTERED root set, with both enum transformers resolved. The asset class and the status are each seeded in both of their accepted source forms, because a many-to-one enumeration mapping that had lost half its entries reads as a null rather than as an error.';
    execution: Single
    {
    query: |core_instrument::Instrument.all()
        ->project(~[
            instrumentId:x|$x.instrumentId,
            instrumentType:x|$x.instrumentType,
            subType:x|$x.instrumentSubType,
            assetClass:x|$x.assetClass,
            status:x|$x.status,
            currency:x|$x.currency
        ])
        ->sort(~instrumentId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
