Service stress::DSAgg_Book
{
    pattern: '/stress/dsagg_book';
    documentation: 'groupBy on a local key of positions::Book with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |positions::Book.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            bookId:x|$x.bookId,
            positionCount:x|$x.positionCount
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.bookId : agg|$agg->count(),
            total: x|$x.positionCount : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_Book_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
