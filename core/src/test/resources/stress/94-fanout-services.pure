                  #{
                    contentType: 'application/json';
                    data: '[{"rebalanceId":"RB-EU50-2024Q2","issuerCountryCode":"DE","rebalanceIndexFamilyProviderName":"Northgate Index Services","rebalanceIndexFamilyName":"Europe equity","countrySubRegionMacroRegionName":"Europe, Middle East and Africa","rebalanceIndexCurrency":"EUR"},{"rebalanceId":"RB-EU50-2024Q2","issuerCountryCode":"GB","rebalanceIndexFamilyProviderName":"Northgate Index Services","rebalanceIndexFamilyName":"Europe equity","countrySubRegionMacroRegionName":"Europe, Middle East and Africa","rebalanceIndexCurrency":"EUR"},{"rebalanceId":"RB-EU50-2024Q2","issuerCountryCode":"NZ","rebalanceIndexFamilyProviderName":"Northgate Index Services","rebalanceIndexFamilyName":"Europe equity","countrySubRegionMacroRegionName":"Asia Pacific","rebalanceIndexCurrency":"EUR"},{"rebalanceId":"RB-GBAG-202406","issuerCountryCode":"FR","rebalanceIndexFamilyProviderName":"Aventine Benchmarks GmbH","rebalanceIndexFamilyName":"Global aggregate bond","countrySubRegionMacroRegionName":null,"rebalanceIndexCurrency":"USD"},{"rebalanceId":"RB-GBAG-202406","issuerCountryCode":"GB","rebalanceIndexFamilyProviderName":"Aventine Benchmarks GmbH","rebalanceIndexFamilyName":"Global aggregate bond","countrySubRegionMacroRegionName":"Europe, Middle East and Africa","rebalanceIndexCurrency":"USD"}]';
