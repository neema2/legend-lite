Service stress::D_CollateralScheduleItemDense
{
    pattern: '/stress/d_collateralscheduleitem';
    documentation: 'Dense stack on agencylending::CollateralScheduleItem: several distinct navigation chains plus whatever the model offers along them, with a filter, a sort and a limit. Generated from the model by scripts/corpus/stacks.py, so it deepens as the model does rather than needing a new hand-written service per domain.';
    execution: Single
    {
    query: |agencylending::CollateralScheduleItem.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            recordId:x|$x.recordId,
            bookRollupBookCurrency:x|$x.book.rollup.book.currency,
            bookDeskBusinessUnitName:x|$x.book.desk.businessUnit.name,
            bookRollupBookId:x|$x.book.rollup.bookId,
            notionalPerRiskPoint:x|$x.notionalPerRiskPoint,
            notionalInQ:x|$x.notionalIn(0.5)
        ])
        ->sort(~recordId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    D_CollateralScheduleItemDense_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
