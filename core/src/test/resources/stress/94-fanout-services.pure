Service stress::TXC_All
{
    pattern: '/stress/txc_all';
    documentation: 'Every row of corpactions::CorporateActionEvent, unfiltered. The subtype services partition this same table by discriminator; this is the whole of it, and therefore the only service that would show a row whose type code matches no subtype at all. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |corpactions::CorporateActionEvent.all()
        ->project(~[
            actionId:x|$x.actionId,
            actionType:x|$x.actionType,
            noticeDays:x|$x.noticeDays,
            isMandatory:x|$x.isMandatory,
            cashRate:x|$x.cashRate,
            payDate:x|$x.payDate
        ])
        ->sort(~actionId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TXC_All_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 22 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"actionId":"CA-00001","actionType":"CASH_DIVIDEND","noticeDays":2,"isMandatory":true,"cashRate":0.25,"payDate":"2024-02-05"},{"actionId":"CA-00002","actionType":"SPECIAL_DIVIDEND","noticeDays":2,"isMandatory":false,"cashRate":null,"payDate":"2024-03-06"},{"actionId":"CA-00004","actionType":"SCRIP_DIVIDEND","noticeDays":2,"isMandatory":true,"cashRate":null,"payDate":"2024-05-08"},{"actionId":"CA-00005","actionType":"DRIP","noticeDays":2,"isMandatory":false,"cashRate":0.45,"payDate":"2024-06-09"},{"actionId":"CA-00007","actionType":"REVERSE_SPLIT","noticeDays":2,"isMandatory":true,"cashRate":0.55,"payDate":"2024-02-11"},{"actionId":"CA-00008","actionType":"BONUS_ISSUE","noticeDays":2,"isMandatory":false,"cashRate":null,"payDate":"2024-03-12"},{"actionId":"CA-00010","actionType":"OPEN_OFFER","noticeDays":2,"isMandatory":true,"cashRate":null,"payDate":"2024-05-14"},{"actionId":"CA-00011","actionType":"MERGER","noticeDays":2,"isMandatory":false,"cashRate":0.75,"payDate":"2024-06-15"},{"actionId":"CA-00013","actionType":"SPINOFF","noticeDays":2,"isMandatory":true,"cashRate":0.85,"payDate":"2024-02-17"},{"actionId":"CA-00014","actionType":"DEMERGER","noticeDays":2,"isMandatory":false,"cashRate":null,"payDate":"2024-03-18"},{"actionId":"CA-00016","actionType":"EXCHANGE_OFFER","noticeDays":2,"isMandatory":true,"cashRate":null,"payDate":"2024-05-20"},{"actionId":"CA-00017","actionType":"SCHEME_OF_ARRANGEMENT","noticeDays":2,"isMandatory":false,"cashRate":1.05,"payDate":"2024-06-21"},{"actionId":"CA-00019","actionType":"RETURN_OF_CAPITAL","noticeDays":2,"isMandatory":true,"cashRate":1.15,"payDate":"2024-02-23"},{"actionId":"CA-00020","actionType":"REDEMPTION","noticeDays":2,"isMandatory":false,"cashRate":null,"payDate":"2024-03-24"},{"actionId":"CA-00022","actionType":"CALL","noticeDays":2,"isMandatory":true,"cashRate":null,"payDate":"2024-05-26"},{"actionId":"CA-00023","actionType":"PUT","noticeDays":2,"isMandatory":false,"cashRate":1.35,"payDate":"2024-06-27"},{"actionId":"CA-00025","actionType":"COUPON_PAYMENT","noticeDays":2,"isMandatory":true,"cashRate":1.45,"payDate":"2024-02-06"},{"actionId":"CA-00026","actionType":"NAME_CHANGE","noticeDays":-23,"isMandatory":false,"cashRate":null,"payDate":"2024-03-07"},{"actionId":"CA-00028","actionType":"DELISTING","noticeDays":4,"isMandatory":true,"cashRate":null,"payDate":"2024-05-09"},{"actionId":"CA-00029","actionType":"BANKRUPTCY","noticeDays":4,"isMandatory":false,"cashRate":1.65,"payDate":"2024-06-10"},{"actionId":"CA-00031","actionType":"CONSENT_SOLICITATION","noticeDays":4,"isMandatory":true,"cashRate":1.75,"payDate":"2024-02-12"},{"actionId":"CA-00032","actionType":"WARRANT_EXERCISE","noticeDays":4,"isMandatory":false,"cashRate":null,"payDate":"2024-03-13"}]';
                  }#;
