Service stress::DSTree_Greeks
{
    pattern: '/stress/dstree_greeks';
    documentation: 'A graphFetch 4 levels deep from risk::Greeks. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |risk::Greeks.all()
        ->graphFetch(#{
  risk::Greeks
  {
    greeksId,
    position
    {
      book
      {
        desk
        {
          businessUnit
          {
            buId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  risk::Greeks
  {
    greeksId,
    position
    {
      book
      {
        desk
        {
          businessUnit
          {
            buId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSTree_Greeks_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"greeksId":"GRK-0001","position":{"book":{"desk":{"businessUnit":{"buId":"BU-EQ"}}}}},{"greeksId":"GRK-0002","position":{"book":{"desk":{"businessUnit":{"buId":"BU-EQ"}}}}},{"greeksId":"GRK-0003","position":{"book":{"desk":{"businessUnit":{"buId":"BU-EQ"}}}}},{"greeksId":"GRK-0004","position":null}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSLocal_BreakResolution
{
    pattern: '/stress/dslocal_breakresolution';
    documentation: 'A filter, a computed column, a composite sort and a limit stacked on ops::BreakResolution -- which cannot navigate anywhere, because its ends are inherited and F49 makes those unnavigable from a subtype\'s set. Depth being unavailable is not a reason to leave the query bare. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |ops::BreakResolution.all()
        ->filter({x|($x.status > ' ')})
        ->project(~[
            resolutionId:x|$x.resolutionId,
            status:x|$x.status,
            timeTakenMinutes:x|$x.timeTakenMinutes
        ])
        ->sort(~resolutionId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSLocal_BreakResolution_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"resolutionId":"BR-0001","status":"ACTIVE","timeTakenMinutes":10},{"resolutionId":"BR-0003","status":"CLOSED","timeTakenMinutes":24},{"resolutionId":"BR-0004","status":"SUSPENDED","timeTakenMinutes":31},{"resolutionId":"BR-0005","status":"ACTIVE","timeTakenMinutes":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSAgg_BreakResolution
{
    pattern: '/stress/dsagg_breakresolution';
    documentation: 'groupBy on a local key of ops::BreakResolution with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |ops::BreakResolution.all()
        ->filter({x|($x.status > ' ')})
        ->project(~[
            status:x|$x.status,
            resolutionId:x|$x.resolutionId,
            timeTakenMinutes:x|$x.timeTakenMinutes
        ])
        ->groupBy(~[status], ~[
            n: x|$x.resolutionId : agg|$agg->count(),
            total: x|$x.timeTakenMinutes : agg|$agg->sum()
        ])
        ->sort(~status->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_BreakResolution_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"status":"ACTIVE","n":2,"total":10},{"status":"CLOSED","n":1,"total":24},{"status":"SUSPENDED","n":1,"total":31}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSDeep_BreakResolution
{
    pattern: '/stress/dsdeep_breakresolution';
    documentation: 'The deepest to-one reach ops::BreakResolution offers, filtered on a NAVIGATED column rather than a local one, composite-sorted and limited. A predicate over a joined column has to be placed relative to the join, which a filter on the root never tests. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |ops::BreakResolution.all()
        ->filter({x|($x.tradeException.trade.order.instrument.currency > ' ') && ($x.status > ' ')})
        ->project(~[
            resolutionId:x|$x.resolutionId,
            tradeExceptionTradeOrderInstrumentCurrency:x|$x.tradeException.trade.order.instrument.currency,
            tradeExceptionTradeInstrumentSectorName:x|$x.tradeException.trade.instrument.sector.name,
            tradeExceptionTradeInstrumentInstrumentCurrencyName:x|$x.tradeException.trade.instrument.instrumentCurrency.name,
            tradeExceptionTradeInstrumentExchangeName:x|$x.tradeException.trade.instrument.exchange.name
        ])
        ->sort(~resolutionId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSDeep_BreakResolution_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 0 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

