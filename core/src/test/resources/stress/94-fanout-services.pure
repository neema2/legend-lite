}#)
        ->serialize(#{
  combo::Scoped
  {
    r_b_nl1,
    r_b_nn1,
    r_bi_nl1,
    r_bi_nn1,
    r_c_nl1,
    r_c_nn1,
    r_de_nl1,
    r_de_nn1,
    r_dt_nl1,
    r_dt_nn1,
    r_f_nl1,
    r_f_nn1,
    r_i_nl1,
    r_i_nn1,
    r_s_nl1,
    r_s_nn1,
    r_si_nl1,
    r_si_nn1,
    rootId
  }
}#);
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    SP_ComboScopedGraph_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
