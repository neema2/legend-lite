                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"reportId":"LE-2024Q1-01","cobDate":"2024-03-28","returnRef":"LE-2024Q1-01US"},{"reportId":"LE-2024Q1-01","cobDate":"2024-03-28","returnRef":"LE-2024Q1-01DE"},{"reportId":"LE-2024Q1-01","cobDate":"2024-03-28","returnRef":"LE-2024Q1-01CH"},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","returnRef":"LE-2024Q2-01US"},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","returnRef":"LE-2024Q2-01GB"},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","returnRef":"LE-2024Q2-01DE"},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","returnRef":"LE-2024Q2-01FR"},{"reportId":"LE-2024Q2-01","cobDate":"2024-06-28","returnRef":"LE-2024Q2-01JP"},{"reportId":"LE-2024Q2-02","cobDate":"2024-06-28","returnRef":"LE-2024Q2-02IE"},{"reportId":"LE-2024Q2-02","cobDate":"2024-06-28","returnRef":"LE-2024Q2-02LU"},{"reportId":"LE-2024Q2-02","cobDate":"2024-06-28","returnRef":"LE-2024Q2-02SG"}]';
