        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"recordId":"CAP-00001","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00002","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00003","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00004","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00005","book":null},{"recordId":"CAP-00006","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00010","book":null},{"recordId":"CAP-00011","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00012","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00013","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00014","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00015","book":null},{"recordId":"CAP-00019","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00020","book":null},{"recordId":"CAP-00021","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00022","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00023","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00024","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00028","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00029","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00030","book":null},{"recordId":"CAP-00031","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00032","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00033","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00037","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00038","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00039","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":