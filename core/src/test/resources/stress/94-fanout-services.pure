    documentation: 'A filter, a computed column, a composite sort and a limit stacked on org::Desk -- which cannot navigate anywhere, because its ends are inherited and F49 makes those unnavigable from a subtype\'s set. Depth being unavailable is not a reason to leave the query bare. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |org::Desk.all()
        ->filter({x|($x.name > ' ')})
        ->project(~[
            deskId:x|$x.deskId,
            name:x|$x.name
        ])
        ->sort(~deskId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSLocal_Desk_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"deskId":"DSK-CASH","name":"Cash Equities"},{"deskId":"DSK-CREDIT","name":"Credit Trading"},{"deskId":"DSK-DERIV","name":"Equity Derivatives"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

