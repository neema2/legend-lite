Service stress::PL15_HolidayCountView
{
    pattern: '/stress/pl15';
    documentation: 'A VIEW with a ~groupBy, mapped as a class\'s ~mainTable and read across a project boundary. Nothing seeds it: the engine folds the GROUP BY into the SQL and the oracle aggregates the underlying rows independently. One calendar has holidays in two years, one in a single year, and one has none at all and so forms no group -- which is the difference between an aggregation and an outer join, and is invisible unless a seed contains the empty case.';
    execution: Single
    {
    query: |core_calendar::CcHolidayCount.all()
        ->project(~[
            calendarId:x|$x.calendarId,
            holidayYear:x|$x.holidayYear,
            holidayCount:x|$x.holidayCount,
            businessDays:x|$x->core_calendar::ccBusinessDaysInYear()
        ])
        ->sort(~calendarId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL15_HolidayCountView_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"calendarId":"GBLO","holidayYear":2025,"holidayCount":3,"businessDays":258},{"calendarId":"TARGET","holidayYear":2025,"holidayCount":2,"businessDays":259},{"calendarId":"USNY","holidayYear":2025,"holidayCount":3,"businessDays":258},{"calendarId":"USNY","holidayYear":2026,"holidayCount":1,"businessDays":260}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL16_SettlementCycleChain
{
    pattern: '/stress/pl16';
    documentation: 'Two hops of navigation entirely WITHIN a dependency, and two functions whose parameter is a class rather than a number. The settlement lag is read both as a column and through the project\'s own accessor, so a function that lowered wrongly would disagree with the column beside it.';
    execution: Single
    {
    query: |core_calendar::CcSettlementCycle.all()
        ->project(~[
            cycleId:x|$x.cycleId,
            assetClass:x|$x.assetClass,
            settlementDays:x|$x.settlementDays,
            mic:x|$x.market.mic,
            calendarId:x|$x.market.calendar.calendarId,
            centre:x|$x.market.calendar.financialCentre,
            lag:x|$x->core_calendar::ccSettlementLagDays(),
            isTPlusTwo:x|$x->core_calendar::ccIsTPlusTwo()
        ])
        ->sort(~cycleId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
