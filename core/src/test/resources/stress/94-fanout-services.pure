Service stress::DSAgg_PnLAttribution
{
    pattern: '/stress/dsagg_pnlattribution';
    documentation: 'groupBy on a local key of pnl::PnLAttribution with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |pnl::PnLAttribution.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            attributionId:x|$x.attributionId,
            version:x|$x.version
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.attributionId : agg|$agg->count(),
            total: x|$x.version : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_PnLAttribution_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"EUR","n":1,"total":318},{"currency":"GBP","n":1,"total":null},{"currency":"JPY","n":1,"total":332},{"currency":"USD","n":1,"total":325}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

