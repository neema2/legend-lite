Service stress::DSGroup_SettlementSettlementInstruction
{
    pattern: '/stress/dsgroup_settlementsettlementinstruction';
    documentation: 'The same reach as DSDeepSettlementSettlementInstruction, then grouped on a NAVIGATED key with aggregates over it. The key came through a join, so a groupBy that grouped before the join would return the same columns and different numbers. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |settlement::SettlementInstruction.all()
        ->filter({x|($x.settlement.trade.order.instrument.currency > ' ')})
        ->project(~[
            settlementTradeOrderInstrumentCurrency:x|$x.settlement.trade.order.instrument.currency,
            instructionId:x|$x.instructionId
        ])
        ->groupBy(~[settlementTradeOrderInstrumentCurrency], ~[
            n: x|$x.instructionId : agg|$agg->count()
        ])
        ->sort(~settlementTradeOrderInstrumentCurrency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSGroup_SettlementSettlementInstruction_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 0 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSTree_SettlementSettlementInstruction
{
    pattern: '/stress/dstree_settlementsettlementinstruction';
    documentation: 'A graphFetch 4 levels deep from settlement::SettlementInstruction. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |settlement::SettlementInstruction.all()
        ->graphFetch(#{
  settlement::SettlementInstruction
  {
    instructionId,
    settlement
    {
      trade
      {
        order
        {
          instrument
          {
            currency,
            instrumentId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  settlement::SettlementInstruction
  {
    instructionId,
    settlement
    {
      trade
      {
        order
        {
          instrument
          {
            currency,
            instrumentId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSTree_SettlementSettlementInstruction_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"instructionId":"SI-0001","settlement":null},{"instructionId":"SI-0002","settlement":null},{"instructionId":"SI-0003","settlement":{"trade":{"order":null}}},{"instructionId":"SI-0004","settlement":{"trade":{"order":null}}},{"instructionId":"SI-0005","settlement":{"trade":{"order":null}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

