Service stress::LE5_ReturnTotals
{
    pattern: '/stress/le5';
    documentation: 'Per return: how many lines, the largest single exposure, the total net and the mean percentage. Grouped over a schema-qualified composite-key table, and three of the twelve lines belong to no connected group at all -- the null a grouping rule has to survive.';
    execution: Single
    {
    query: |largeexp::ExposureLine.all()
        ->project(~[
            reportId:x|$x.reportId,
            netExposure:x|$x.netExposure
        ])
        ->groupBy(~[reportId], ~[
            lineCount: x|$x.netExposure : agg|$agg->count(),
            largestExposure: x|$x.netExposure : agg|$agg->max(),
            smallestExposure: x|$x.netExposure : agg|$agg->min(),
            totalNet: x|$x.netExposure : agg|$agg->sum(),
            meanNet: x|$x.netExposure : agg|$agg->average()
        ])
        ->sort(~reportId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    LE5_ReturnTotals_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"reportId":"LE-2024Q1-01","lineCount":3,"largestExposure":6550000000.0,"smallestExposure":1675000000.0,"totalNet":11425000000.0,"meanNet":3808333333.3333335},{"reportId":"LE-2024Q2-01","lineCount":6,"largestExposure":15200000000.0,"smallestExposure":0.0,"totalNet":28780000000.0,"meanNet":4796666666.666667},{"reportId":"LE-2024Q2-02","lineCount":3,"largestExposure":3100000000.0,"smallestExposure":880000000.0,"totalNet":6130000000.0,"meanNet":2043333333.3333333}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::LE6_ExemptionRules
{
    pattern: '/stress/le6';
    documentation: 'The exemption rules themselves. Each carries a counterparty or a country and never both, so exactly one of the two columns is null on every row -- which is what makes the join behind LE2 a disjunction rather than two conditions that happen to agree.';
    execution: Single
    {
    query: |largeexp::ExemptionRule.all()
        ->project(~[
            ruleId:x|$x.ruleId,
            exemptCounterpartyId:x|$x.exemptCounterpartyId,
            exemptCountryCode:x|$x.exemptCountryCode,
            basis:x|$x.basis,
            linesReached:x|$x.exemptedLines->count()
        ])
        ->sort(~ruleId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    LE6_ExemptionRules_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ruleId":"EX-CPTY-06","exemptCounterpartyId":"CP-0006","exemptCountryCode":null,"basis":"CENTRAL_BANK","linesReached":1},{"ruleId":"EX-CTY-DE","exemptCounterpartyId":null,"exemptCountryCode":"DE","basis":"INTRAGROUP_LOCAL","linesReached":2},{"ruleId":"EX-CTY-IE","exemptCounterpartyId":null,"exemptCountryCode":"IE","basis":"COVERED_BOND_RELIEF","linesReached":1},{"ruleId":"EX-CTY-SG","exemptCounterpartyId":null,"exemptCountryCode":"SG","basis":"TRADE_FINANCE_RELIEF","linesReached":1},{"ruleId":"EX-SOV-JP","exemptCounterpartyId":"CP-0005","exemptCountryCode":null,"basis":"SOVEREIGN_EXPOSURE","linesReached":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL0_TenorLadder
{
    pattern: '/stress/pl0';
    documentation: 'Every tenor bucket in the linked project\'s ladder, read from the corpus. The first service in this corpus rooted at a class that belongs to a PROJECT rather than to the corpus, and the first rows anything in projects/ has produced -- the graph is compile-only by design.';
    execution: Single
    {
    query: |core_tenor::CtnTenorBucket.all()
        ->project(~[
            bucketId:x|$x.bucketId,
            band:x|$x.band,
            label:x|$x.label,
            minDays:x|$x.minDays,
            maxDays:x|$x.maxDays,
            spanDays:x|$x.spanDays,
            sortOrder:x|$x.sortOrder
        ])
        ->sort(~bucketId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL0_TenorLadder_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 9 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"bucketId":"CTN-01","band":"D0_7","label":"0-7d","minDays":0,"maxDays":8,"spanDays":8,"sortOrder":1},{"bucketId":"CTN-02","band":"D8_30","label":"8-30d","minDays":8,"maxDays":31,"spanDays":23,"sortOrder":2},{"bucketId":"CTN-03","band":"M1_3","label":"1-3m","minDays":31,"maxDays":92,"spanDays":61,"sortOrder":3},{"bucketId":"CTN-04","band":"M3_6","label":"3-6m","minDays":92,"maxDays":184,"spanDays":92,"sortOrder":4},{"bucketId":"CTN-05","band":"M6_12","label":"6-12m","minDays":184,"maxDays":366,"spanDays":182,"sortOrder":5},{"bucketId":"CTN-06","band":"Y1_3","label":"1-3y","minDays":366,"maxDays":1096,"spanDays":730,"sortOrder":6},{"bucketId":"CTN-07","band":"Y3_5","label":"3-5y","minDays":1096,"maxDays":1827,"spanDays":731,"sortOrder":7},{"bucketId":"CTN-08","band":"Y5_10","label":"5-10y","minDays":1827,"maxDays":3654,"spanDays":1827,"sortOrder":8},{"bucketId":"CTN-09","band":"Y10_PLUS","label":"10y+","minDays":3654,"maxDays":40000,"spanDays":36346,"sortOrder":9}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL1_BucketLadder
{
    pattern: '/stress/pl1';
    documentation: 'Each bucket with the ladder it belongs to -- a navigation entirely INSIDE the linked project, executed from the corpus. The band is an enum resolved by the project\'s own EnumerationMapping, which until now had been compiled and never run.';
    execution: Single
    {
    query: |core_tenor::CtnTenorBucket.all()
        ->project(~[
            bucketId:x|$x.bucketId,
            band:x|$x.band,
            ladderName:x|$x.ladder.name,
            dayCount:x|$x.ladder.dayCountConvention
        ])
        ->sort(~bucketId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL1_BucketLadder_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 9 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"bucketId":"CTN-01","band":"D0_7","ladderName":"Standard swap ladder","dayCount":"ACT/365"},{"bucketId":"CTN-02","band":"D8_30","ladderName":"Standard swap ladder","dayCount":"ACT/365"},{"bucketId":"CTN-03","band":"M1_3","ladderName":"Standard swap ladder","dayCount":"ACT/365"},{"bucketId":"CTN-04","band":"M3_6","ladderName":"Standard swap ladder","dayCount":"ACT/365"},{"bucketId":"CTN-05","band":"M6_12","ladderName":"Standard swap ladder","dayCount":"ACT/365"},{"bucketId":"CTN-06","band":"Y1_3","ladderName":"Standard swap ladder","dayCount":"ACT/365"},{"bucketId":"CTN-07","band":"Y3_5","ladderName":"Standard swap ladder","dayCount":"ACT/365"},{"bucketId":"CTN-08","band":"Y5_10","ladderName":"Standard swap ladder","dayCount":"ACT/365"},{"bucketId":"CTN-09","band":"Y10_PLUS","ladderName":"Standard swap ladder","dayCount":"ACT/365"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::PL2_PillarTenorBand
{
    pattern: '/stress/pl2';
    documentation: 'Every curve pillar with the tenor band it falls in -- a CORPUS class reaching an attribute of a PROJECT class, across a range join. This is the query a dependency exists to allow, and the one a compile check cannot answer: a range that lowers wrongly returns the wrong band rather than nothing, which is a plausible number in the right shape.';
    execution: Single
    {
    query: |curves::CurvePoint.all()
        ->project(~[
            curveId:x|$x.curveId,
            cobDate:x|$x.cobDate,
            tenorLabel:x|$x.tenorLabel,
            tenorDays:x|$x.tenorDays,
            bandCode:x|$x.tenorBucket.band,
            bandLabel:x|$x.tenorBucket.label,
            bandMinDays:x|$x.tenorBucket.minDays,
            bandMaxDays:x|$x.tenorBucket.maxDays
        ])
        ->sort([~curveId->ascending(), ~cobDate->ascending(), ~tenorLabel->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    PL2_PillarTenorBand_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 192 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"10Y","tenorDays":3653,"bandCode":"Y5_10","bandLabel":"5-10y","bandMinDays":1827,"bandMaxDays":3654},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"15Y","tenorDays":5479,"bandCode":"Y10_PLUS","bandLabel":"10y+","bandMinDays":3654,"bandMaxDays":40000},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"1M","tenorDays":30,"bandCode":"D8_30","bandLabel":"8-30d","bandMinDays":8,"bandMaxDays":31},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"1Y","tenorDays":365,"bandCode":"M6_12","bandLabel":"6-12m","bandMinDays":184,"bandMaxDays":366},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"20Y","tenorDays":7305,"bandCode":"Y10_PLUS","bandLabel":"10y+","bandMinDays":3654,"bandMaxDays":40000},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"2Y","tenorDays":730,"bandCode":"Y1_3","bandLabel":"1-3y","bandMinDays":366,"bandMaxDays":1096},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"30Y","tenorDays":10958,"bandCode":"Y10_PLUS","bandLabel":"10y+","bandMinDays":3654,"bandMaxDays":40000},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"3M","tenorDays":91,"bandCode":"M1_3","bandLabel":"1-3m","bandMinDays":31,"bandMaxDays":92},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"3Y","tenorDays":1095,"bandCode":"Y1_3","bandLabel":"1-3y","bandMinDays":366,"bandMaxDays":1096},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"5Y","tenorDays":1826,"bandCode":"Y3_5","bandLabel":"3-5y","bandMinDays":1096,"bandMaxDays":1827},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"6M","tenorDays":182,"bandCode":"M3_6","bandLabel":"3-6m","bandMinDays":92,"bandMaxDays":184},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"7Y","tenorDays":2556,"bandCode":"Y5_10","bandLabel":"5-10y","bandMinDays":1827,"bandMaxDays":3654},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20