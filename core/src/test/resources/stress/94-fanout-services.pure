    pattern: '/stress/dssub_controloperatingdeficiency';
    documentation: 'Rooted at the SUBTYPE auditfindings::ControlOperatingDeficiency and navigating its OWN ends. 1828 class mappings in this corpus extend another set, and almost nothing has ever navigated out of one -- the services over them project local columns and stop. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |auditfindings::ControlOperatingDeficiency.all()
        ->filter({x|($x.book.desk.businessUnit.legalEntity.jurisdiction > ' ')})
        ->project(~[
            recordId:x|$x.recordId,
            bookDeskBusinessUnitLegalEntityJurisdiction:x|$x.book.desk.businessUnit.legalEntity.jurisdiction,
            bookDeskBusinessUnitName:x|$x.book.desk.businessUnit.name,
            bookRollupBookId:x|$x.book.rollup.bookId
        ])
        ->sort(~recordId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSSub_ControlOperatingDeficiency_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 0 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

