    pattern: '/stress/clsx_recordretentionstage';
    documentation: 'clientlifecycle::RecordRetentionStage only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |clientlifecycle::RecordRetentionStage.all()
        ->project(~[
            recordId:x|$x.recordId,
            recordType:x|$x.recordType,
            notionalPerRiskPoint:x|$x.notionalPerRiskPoint,
            notionalGbp:x|$x.notionalIn(0.79),
            currency:x|$x.currency,
            maturityDate:x|$x.maturityDate,
            isActive:x|$x.isActive
        ])
        ->sort(~recordId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CLSX_RecordRetentionStage_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"recordId":"CLS-00046","recordType":"RECORD_RETENTION","notionalPerRiskPoint":4600000.0,"notionalGbp":45425000.0,"currency":"USD","maturityDate":"2026-10-19","isActive":true},{"recordId":"CLS-00047","recordType":"RECORD_RETENTION","notionalPerRiskPoint":4607843.137254902,"notionalGbp":46412500.0,"currency":"EUR","maturityDate":"2027-11-20","isActive":false},{"recordId":"CLS-00048","recordType":"RECORD_RETENTION","notionalPerRiskPoint":4615384.615384615,"notionalGbp":47400000.0,"currency":"GBP","maturityDate":"2028-12-21","isActive":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

