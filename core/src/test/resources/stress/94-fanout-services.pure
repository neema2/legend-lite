Service stress::DSAgg_Core_instrumentInstrument
{
    pattern: '/stress/dsagg_core_instrumentinstrument';
    documentation: 'groupBy on a local key of core_instrument::Instrument with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |core_instrument::Instrument.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            instrumentId:x|$x.instrumentId,
            lotSize:x|$x.lotSize
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.instrumentId : agg|$agg->count(),
            total: x|$x.lotSize : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_Core_instrumentInstrument_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"EUR","n":2,"total":null},{"currency":"GBP","n":3,"total":1},{"currency":"USD","n":11,"total":201}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

