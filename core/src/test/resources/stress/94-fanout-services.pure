Service stress::LE4_ReturnHeaders
{
    pattern: '/stress/le4';
    documentation: 'The distinct (report, cob date) pairs, read ~distinct off the line table. Twelve rows collapse to three, and the reference beside them is built by a dynafunction in the mapping rather than stored.';
    execution: Single
    {
    query: |largeexp::ReturnHeader.all()
        ->project(~[
            reportId:x|$x.reportId,
            cobDate:x|$x.cobDate,
            returnRef:x|$x.returnRef
