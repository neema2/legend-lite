Service stress::CV9_CurveSummaries
{
    pattern: '/stress/cv9';
    documentation: 'Per curve and date, read from a VIEW whose ~groupBy aggregates in the store. CV4 computes the same highest and lowest rate with a query-level groupBy over the pillars; these must agree, and they are arrived at by completely different routes. The curve is navigated back from the summary, so a view row reaches a table row.';
    execution: Single
    {
    query: |curves::CurveSummary.all()
        ->project(~[
            curveId:x|$x.curveId,
            cobDate:x|$x.cobDate,
            pillarCount:x|$x.pillarCount,
            highestRate:x|$x.highestRate,
            lowestRate:x|$x.lowestRate,
            curveName:x|$x.summarised.curveName,
            interpolation:x|$x.summarised.interpolation
        ])
        ->sort([~curveId->ascending(), ~cobDate->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CV9_CurveSummaries_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 16 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","pillarCount":12,"highestRate":3.61,"lowestRate":2.51,"curveName":"German Bund Zero Curve","interpolation":"BOOTSTRAP"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","pillarCount":12,"highestRate":3.6,"lowestRate":2.46,"curveName":"German Bund Zero Curve","interpolation":"BOOTSTRAP"},{"curveId":"EUR.ESTR.OIS","cobDate":"2024-06-19","pillarCount":12,"highestRate":3.66,"lowestRate":2.5,"curveName":"EUR Euro Short Term Rate OIS","interpolation":"LINEAR_ZERO"},{"curveId":"EUR.ESTR.OIS","cobDate":"2024-06-20","pillarCount":12,"highestRate":3.65,"lowestRate":2.47,"curveName":"EUR Euro Short Term Rate OIS","interpolation":"LINEAR_ZERO"},{"curveId":"EUR.EURIBOR.6M","cobDate":"2024-06-19","pillarCount":12,"highestRate":3.79,"lowestRate":2.73,"curveName":"EUR 6M Euribor Swap","interpolation":"CUBIC_SPLINE"},{"curveId":"EUR.EURIBOR.6M","cobDate":"2024-06-20","pillarCount":12,"highestRate":3.78,"lowestRate":2.7,"curveName":"EUR 6M Euribor Swap","interpolation":"CUBIC_SPLINE"},{"curveId":"GBP.SONIA.OIS","cobDate":"2024-06-19","pillarCount":12,"highestRate":5.19,"lowestRate":3.55,"curveName":"GBP SONIA Overnight Index Swap","interpolation":"LINEAR_ZERO"},{"curveId":"GBP.SONIA.OIS","cobDate":"2024-06-20","pillarCount":12,"highestRate":5.19,"lowestRate":3.58,"curveName":"GBP SONIA Overnight Index Swap","interpolation":"LINEAR_ZERO"},{"curveId":"JPY.TONA.OIS","cobDate":"2024-06-19","pillarCount":12,"highestRate":1.87,"lowestRate":0.08,"curveName":"JPY TONA Overnight Index Swap","interpolation":"LINEAR_ZERO"},{"curveId":"JPY.TONA.OIS","cobDate":"2024-06-20","pillarCount":12,"highestRate":1.96,"lowestRate":0.08,"curveName":"JPY TONA Overnight Index Swap","interpolation":"LINEAR_ZERO"},{"curveId":"USD.LIBOR.3M","cobDate":"2024-06-19","pillarCount":12,"highestRate":5.6,"lowestRate":4.21,"curveName":"USD 3M LIBOR Swap (legacy)","interpolation":"CUBIC_SPLINE"},{"curveId":"USD.LIBOR.3M","cobDate":"2024-06-20","pillarCount":12,"highestRate":5.59,"lowestRate":4.23,"curveName":"USD 3M LIBOR Swap (legacy)","interpolation":"CUBIC_SPLINE"},{"curveId":"USD.SOFR.OIS","cobDate":"2024-06-19","pillarCount":12,"highestRate":5.34,"lowestRate":3.96,"curveName":"USD SOFR Overnight Index Swap","interpolation":"LINEAR_ZERO"},{"curveId":"USD.SOFR.OIS","cobDate":"2024-06-20","pillarCount":12,"highestRate":5.34,"lowestRate":3.98,"curveName":"USD SOFR Overnight Index Swap","interpolation":"LINEAR_ZERO"},{"curveId":"USD.UST.GOVT","cobDate":"2024-06-19","pillarCount":12,"highestRate":5.42,"lowestRate":4.29,"curveName":"US Treasury Zero Curve","interpolation":"BOOTSTRAP"},{"curveId":"USD.UST.GOVT","cobDate":"2024-06-20","pillarCount":12,"highestRate":5.43,"lowestRate":4.26,"curveName":"US Treasury Zero Curve","interpolation":"BOOTSTRAP"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CV10_PillarBenchmark
{
    pattern: '/stress/cv10';
    documentation: 'Each pillar, the series it was fitted to, and the series it EFFECTIVELY uses -- its own where one is recorded and the curve\'s benchmark where none is, which is a fallback and so an `or` in the join. Beside them, the curve\'s benchmark reached the long way: pillar to curve to series, two hops from a three-column key.';
    execution: Single
    {
    query: |curves::CurvePoint.all()
        ->project(~[
            curveId:x|$x.curveId,
            cobDate:x|$x.cobDate,
            tenorLabel:x|$x.tenorLabel,
            ownSeries:x|$x.sourceSeriesId,
            effectiveSeries:x|$x.effectiveSeries.seriesId,
            effectiveName:x|$x.effectiveSeries.seriesName,
            curveBenchmark:x|$x.curve.benchmarkSeries.seriesId
        ])
        ->sort([~curveId->ascending(), ~cobDate->ascending(), ~tenorLabel->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CV10_PillarBenchmark_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 192 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"10Y","ownSeries":"DBR.10Y","effectiveSeries":"DBR.10Y","effectiveName":"German Bund 10 Year Yield","curveBenchmark":"DBR.10Y"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"15Y","ownSeries":null,"effectiveSeries":"DBR.10Y","effectiveName":"German Bund 10 Year Yield","curveBenchmark":"DBR.10Y"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"1M","ownSeries":null,"effectiveSeries":"DBR.10Y","effectiveName":"German Bund 10 Year Yield","curveBenchmark":"DBR.10Y"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"1Y","ownSeries":null,"effectiveSeries":"DBR.10Y","effectiveName":"German Bund 10 Year Yield","curveBenchmark":"DBR.10Y"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"20Y","ownSeries":null,"effectiveSeries":"DBR.10Y","effectiveName":"German Bund 10 Year Yield","curveBenchmark":"DBR.10Y"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"2Y","ownSeries":null,"effectiveSeries":"DBR.10Y","effectiveName":"German Bund 10 Year Yield","curveBenchmark":"DBR.10Y"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"30Y","ownSeries":null,"effectiveSeries":"DBR.10Y","effectiveName":"German Bund 10 Year Yield","curveBenchmark":"DBR.10Y"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"3M","ownSeries":null,"effectiveSeries":"DBR.10Y","effectiveName":"German Bund 10 Year Yield","curveBenchmark":"DBR.10Y"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"3Y","ownSeries":null,"effectiveSeries":"DBR.10Y","effectiveName":"German Bund 10 Year Yield","curveBenchmark":"DBR.10Y"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"5Y","ownSeries":null,"effectiveSeries":"DBR.10Y","effectiveName":"German Bund 10 Year Yield","curveBenchmark":"DBR.10Y"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"6M","ownSeries":null,"effectiveSeries":"DBR.10Y","effectiveN