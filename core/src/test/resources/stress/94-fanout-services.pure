Service stress::TXO_All
{
    pattern: '/stress/txo_all';
    documentation: 'Every row of orders::OrderTicket, unfiltered. The subtype services partition this same table by discriminator; this is the whole of it, and therefore the only service that would show a row whose type code matches no subtype at all. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |orders::OrderTicket.all()
        ->project(~[
            ticketId:x|$x.ticketId,
            orderType:x|$x.orderType,
            fillRatio:x|$x.fillRatio,
            side:x|$x.side,
            limitPrice:x|$x.limitPrice,
            timeInForce:x|$x.timeInForce
        ])
        ->sort(~ticketId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TXO_All_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 17 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ticketId":"OT-00001","orderType":"MARKET","fillRatio":1.0,"side":"SELL","limitPrice":null,"timeInForce":"DAY"},{"ticketId":"OT-00002","orderType":"LIMIT","fillRatio":0.4,"side":"BUY","limitPrice":152.5,"timeInForce":"GTC"},{"ticketId":"OT-00004","orderType":"STOP_LIMIT","fillRatio":1.0,"side":"BUY","limitPrice":157.5,"timeInForce":"DAY"},{"ticketId":"OT-00005","orderType":"MARKET_ON_CLOSE","fillRatio":0.4,"side":"SELL","limitPrice":null,"timeInForce":"GTC"},{"ticketId":"OT-00007","orderType":"MARKET_ON_OPEN","fillRatio":1.0,"side":"SELL","limitPrice":null,"timeInForce":"DAY"},{"ticketId":"OT-00008","orderType":"ICEBERG","fillRatio":0.4,"side":"BUY","limitPrice":167.5,"timeInForce":"GTC"},{"ticketId":"OT-00010","orderType":"PEGGED","fillRatio":1.0,"side":"BUY","limitPrice":172.5,"timeInForce":"DAY"},{"ticketId":"OT-00011","orderType":"MIDPOINT_PEG","fillRatio":0.4,"side":"SELL","limitPrice":null,"timeInForce":"GTC"},{"ticketId":"OT-00013","orderType":"VWAP","fillRatio":1.0,"side":"SELL","limitPrice":null,"timeInForce":"DAY"},{"ticketId":"OT-00014","orderType":"POV","fillRatio":0.4,"side":"BUY","limitPrice":182.5,"timeInForce":"GTC"},{"ticketId":"OT-00016","orderType":"LIQUIDITY_SEEKING","fillRatio":1.0,"side":"BUY","limitPrice":187.5,"timeInForce":"DAY"},{"ticketId":"OT-00017","orderType":"DARK_AGGREGATOR","fillRatio":0.4,"side":"SELL","limitPrice":null,"timeInForce":"GTC"},{"ticketId":"OT-00019","orderType":"FILL_OR_KILL","fillRatio":1.0,"side":"SELL","limitPrice":null,"timeInForce":"DAY"},{"ticketId":"OT-00020","orderType":"IMMEDIATE_OR_CANCEL","fillRatio":0.4,"side":"BUY","limitPrice":197.5,"timeInForce":"GTC"},{"ticketId":"OT-00022","orderType":"GOOD_TILL_CANCELLED","fillRatio":1.0,"side":"BUY","limitPrice":202.5,"timeInForce":"DAY"},{"ticketId":"OT-00023","orderType":"GOOD_TILL_DATE","fillRatio":0.4,"side":"SELL","limitPrice":null,"timeInForce":"GTC"},{"ticketId":"OT-00025","orderType":"AT_THE_OPEN","fillRatio":1.0,"side":"SELL","limitPrice":null,"timeInForce":"DAY"}]';
                  }#;
              }#
