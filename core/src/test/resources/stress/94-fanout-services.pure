Service stress::ACCTX_All
{
    pattern: '/stress/acctx_all';
    documentation: 'Every row of accounts::AccountRecord, unfiltered. The subtype services partition this same table by discriminator; this is the whole of it, and therefore the only service that would show a row whose type code matches no subtype at all. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |accounts::AccountRecord.all()
        ->project(~[
            accountId:x|$x.accountId,
            accountType:x|$x.accountType,
