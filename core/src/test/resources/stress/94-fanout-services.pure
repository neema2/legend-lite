    documentation: 'A graphFetch 4 levels deep from index_core::IdxConstituent. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |index_core::IdxConstituent.all()
        ->graphFetch(#{
  index_core::IdxConstituent
  {
    constituentId,
    rebalance
    {
      index
      {
        family
        {
          provider
          {
            name,
            providerId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  index_core::IdxConstituent
  {
    constituentId,
    rebalance
    {
      index
      {
        family
        {
          provider
          {
            name,
            providerId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSTree_IdxConstituent_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"constituentId":"IDX-C-001","rebalance":{"index":{"family":{"provider":{"name":"Northgate Index Services","providerId":"PRV-NRT"}}}}},{"constituentId":"IDX-C-002","rebalance":{"index":{"family":{"provider":{"name":"Northgate Index Services","providerId":"PRV-NRT"}}}}},{"constituentId":"IDX-C-003","rebalance":{"index":{"family":{"provider":{"name":"Northgate Index Services","providerId":"PRV-NRT"}}}}},{"constituentId":"IDX-C-004","rebalance":{"index":{"family":{"provider":{"name":"Northgate Index Services","providerId":"PRV-NRT"}}}}},{"constituentId":"IDX-C-005","rebalance":{"index":{"family":{"provider":{"name":"Aventine Benchmarks GmbH","providerId":"PRV-AVN"}}}}},{"constituentId":"IDX-C-006","rebalance":{"index":{"family":{"provider":{"name":"Aventine Benchmarks GmbH","providerId":"PRV-AVN"}}}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSDeep_IdxCountryWeight
{
    pattern: '/stress/dsdeep_idxcountryweight';
    documentation: 'The deepest to-one reach index_core::IdxCountryWeight offers, filtered on a NAVIGATED column rather than a local one, composite-sorted and limited. A predicate over a joined column has to be placed relative to the join, which a filter on the root never tests. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |index_core::IdxCountryWeight.all()
        ->filter({x|($x.rebalance.index.family.provider.name > ' ')})
        ->project(~[
            rebalanceId:x|$x.rebalanceId,
            issuerCountryCode:x|$x.issuerCountryCode,
            rebalanceIndexFamilyProviderName:x|$x.rebalance.index.family.provider.name,
            rebalanceIndexFamilyName:x|$x.rebalance.index.family.name,
            countrySubRegionMacroRegionName:x|$x.country.subRegion.macroRegion.name,
            rebalanceIndexCurrency:x|$x.rebalance.index.currency
        ])
        ->sort([~rebalanceId->ascending(), ~issuerCountryCode->ascending()])
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
