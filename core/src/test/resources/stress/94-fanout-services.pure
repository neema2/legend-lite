Service stress::GG_FxRateTree
{
    pattern: '/stress/gg_fxrate';
    documentation: 'Generated graph fetch on marketdata::FxRate: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |marketdata::FxRate.all()
        ->graphFetch(#{
  marketdata::FxRate
  {
    rateId,
    askRate,
    bidRate,
    dailyChange,
    baseCurrency
    {
      code,
      centralBank,
      fixingSource,
      country
      {
        countryCode,
        capitalCity
      }
    },
    snapshot
    {
      snapshotId,
      description,
      processingTimeMs
    }
  }
}#)
        ->serialize(#{
  marketdata::FxRate
  {
    rateId,
    askRate,
    bidRate,
    dailyChange,
    baseCurrency
    {
      code,
      centralBank,
      fixingSource,
      country
      {
        countryCode,
        capitalCity
      }
    },
    snapshot
    {
      snapshotId,
      description,
      processingTimeMs
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_FxRateTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"rateId":"FR-0001","askRate":null,"bidRate":1150.0,"dailyChange":1150.0,"baseCurrency":null,"snapshot":null},{"rateId":"FR-0002","askRate":1187.5,"bidRate":1187.5,"dailyChange":1187.5,"baseCurrency":null,"snapshot":null},{"rateId":"FR-0003","askRate":1225.0,"bidRate":1225.0,"dailyChange":1225.0,"baseCurrency":{"code":"USD","centralBank":"Federal Reserve","fixingSource":"WMR","country":{"countryCode":"US","capitalCity":"Washington"}},"snapshot":{"snapshotId":"MDS-0001","description":"primary record","processingTimeMs":325}},{"rateId":"FR-0004","askRate":1262.5,"bidRate":1262.5,"dailyChange":1262.5,"baseCurrency":{"code":"GBP","centralBank":"Bank of England","fixingSource":"WMR","country":{"countryCode":"GB","capitalCity":"London"}},"snapshot":{"snapshotId":"MDS-0002","description":null,"processingTimeMs":332}},{"rateId":"FR-0005","askRate":1300.0,"bidRate":null,"dailyChange":null,"baseCurrency":{"code":"EUR","centralBank":"European Central Bank","fixingSource":"ECB","country":{"countryCode":"DE","capitalCity":"Berlin"}},"snapshot":{"snapshotId":"MDS-0003","description":"archived record","processingTimeMs":339}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::GG_MarketQuoteTree
{
    pattern: '/stress/gg_marketquote';
    documentation: 'Generated graph fetch on marketdata::MarketQuote: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |marketdata::MarketQuote.all()
        ->graphFetch(#{
  marketdata::MarketQuote
  {
    quoteId,
    closePrice,
    highPrice,
    last,
    instrument
    {
      instrumentId,
      assetClass,
      currency,
      exchange
      {
        mic,
        city
      }
    },
    snapshot
    {
      snapshotId,
      description,
      processingTimeMs
    }
  }
}#)
        ->serialize(#{
  marketdata::MarketQuote
  {
    quoteId,
    closePrice,
    highPrice,
    last,
    instrument
    {
      instrumentId,
      assetClass,
      currency,
      exchange
      {
        mic,
        city
      }
    },
    snapshot
    {
      snapshotId,
      description,
      processingTimeMs
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_MarketQuoteTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"quoteId":"MQ-0001","closePrice":1525.0,"highPrice":1525.0,"last":1525.0,"instrument":null,"snapshot":null},{"quoteId":"MQ-0002","closePrice":null,"highPrice":1562.5,"last":null,"instrument":null,"snapshot":null},{"quoteId":"MQ-0003","closePrice":1600.0,"highPrice":1600.0,"last":1600.0,"instrument":{"instrumentId":"INST-AAPL","assetClass":"EQUITY","currency":"USD","exchange":{"mic":"XNAS","city":"New York"}},"snapshot":{"snapshotId":"MDS-0001","description":"primary record","processingTimeMs":325}},{"quoteId":"MQ-0004","closePrice":1637.5,"highPrice":1637.5,"last":1637.5,"instrument":{"instrumentId":"INST-MSFT","assetClass":"EQUITY","currency":"USD","exchange":{"mic":"XNAS","city":"New York"}},"snapshot":{"snapshotId":"MDS-0002","description":null,"processingTimeMs":332}},{"quoteId":"MQ-0005","closePrice":1675.0,"highPrice":null,"last":1675.0,"instrument":{"instrumentId":"INST-HSBA","assetClass":"EQUITY","currency":"GBP","exchange":{"mic":"XLON","city":"London"}},"snapshot":{"snapshotId":"MDS-0003","description":"archived record","processingTimeMs":339}}]}';
                  }#;
              }#
          ]
        }
      ]
