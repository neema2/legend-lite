Service stress::DSAgg_StressScenario
{
    pattern: '/stress/dsagg_stressscenario';
    documentation: 'groupBy on a local key of risk::StressScenario with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |risk::StressScenario.all()
        ->filter({x|($x.name > ' ')})
        ->project(~[
            name:x|$x.name,
            scenarioId:x|$x.scenarioId,
            riskFactorCount:x|$x.riskFactorCount
        ])
        ->groupBy(~[name], ~[
            n: x|$x.scenarioId : agg|$agg->count(),
            total: x|$x.riskFactorCount : agg|$agg->sum()
        ])
        ->sort(~name->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
