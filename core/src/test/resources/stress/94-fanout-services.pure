      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"cycleId":"CY-XETR-EQ","assetClass":"EQUITY","settlementDays":2,"mic":"XETR","calendarId":"TARGET","centre":"Frankfurt","lag":2,"isTPlusTwo":true},{"cycleId":"CY-XLON-EQ","assetClass":"EQUITY","settlementDays":2,"mic":"XLON","calendarId":"GBLO","centre":"London","lag":2,"isTPlusTwo":true},{"cycleId":"CY-XNYS-BOND","assetClass":"BOND","settlementDays":2,"mic":"XNYS","calendarId":"USNY","centre":"New York","lag":2,"isTPlusTwo":true},{"cycleId":"CY-XNYS-EQ","assetClass":"EQUITY","settlementDays":1,"mic":"XNYS","calendarId":"USNY","centre":"New York","lag":1,"isTPlusTwo":false},{"cycleId":"CY-XTKS-JGB","assetClass":"BOND","settlementDays":1,"mic":"XTKS","calendarId":"JPTO","centre":"Tokyo","lag":1,"isTPlusTwo":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

