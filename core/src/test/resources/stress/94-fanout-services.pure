}

Service stress::DSTree_Book
{
    pattern: '/stress/dstree_book';
    documentation: 'A graphFetch 4 levels deep from positions::Book. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |positions::Book.all()
        ->graphFetch(#{
  positions::Book
  {
    bookId,
    desk
    {
      businessUnit
      {
        legalEntity
        {
          region
          {
            description,
            regionId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  positions::Book
  {
    bookId,
    desk
    {
      businessUnit
      {
        legalEntity
        {
          region
          {
            description,
            regionId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSTree_Book_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 8 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"bookId":"BK-CASH-US","desk":{"businessUnit":{"legalEntity":null}}},{"bookId":"BK-CASH-EU","desk":{"businessUnit":{"legalEntity":null}}},{"bookId":"BK-VOL-01","desk":{"businessUnit":{"legalEntity":null}}},{"bookId":"BK-LEGACY","desk":{"businessUnit":{"legalEntity":null}}},{"bookId":"BK-EQ","desk":{"businessUnit":{"legalEntity":null}}},{"bookId":"BK-FX","desk":{"businessUnit":{"legalEntity":null}}},{"bookId":"BK-RATES","desk":{"businessUnit":{"legalEntity":null}}},{"bookId":"BK-CREDIT","desk":{"businessUnit":{"legalEntity":null}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSLocal_SwapFinancing
{
    pattern: '/stress/dslocal_swapfinancing';
    documentation: 'A filter, a computed column, a composite sort and a limit stacked on prime::SwapFinancing -- which cannot navigate anywhere, because its ends are inherited and F49 makes those unnavigable from a subtype\'s set. Depth being unavailable is not a reason to leave the query bare. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |prime::SwapFinancing.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            financingId:x|$x.financingId,
            currency:x|$x.currency,
            dayCount:x|$x.dayCount
        ])
        ->sort(~financingId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSLocal_SwapFinancing_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"financingId":"SF-0001","currency":"USD","dayCount":157},{"financingId":"SF-0002","currency":"GBP","dayCount":null},{"financingId":"SF-0004","currency":"USD","dayCount":178},{"financingId":"SF-0005","currency":"JPY","dayCount":185}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSAgg_SwapFinancing
{
    pattern: '/stress/dsagg_swapfinancing';
    documentation: 'groupBy on a local key of prime::SwapFinancing with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |prime::SwapFinancing.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            financingId:x|$x.financingId,
            dayCount:x|$x.dayCount
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.financingId : agg|$agg->count(),
            total: x|$x.dayCount : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_SwapFinancing_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"GBP","n":1,"total":null},{"currency":"JPY","n":1,"total":185},{"currency":"USD","n":2,"total":335}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

