    pattern: '/stress/docx_certificateofincorporation';
    documentation: 'documents::CertificateOfIncorporation only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |documents::CertificateOfIncorporation.all()
        ->project(~[
            documentId:x|$x.documentId,
            documentType:x|$x.documentType,
            daysValid:x|$x.daysValid,
            governingLaw:x|$x.governingLaw,
            isExecuted:x|$x.isExecuted,
            custodyRef:x|$x.custodyRef
        ])
        ->sort(~documentId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DOCX_CertificateOfIncorporation_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"documentId":"DOC-00011","documentType":"CERTIFICATE_INCORPORATION","daysValid":null,"governingLaw":"NEW_YORK","isExecuted":false,"custodyRef":"VAULT-0110"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

