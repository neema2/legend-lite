      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"recordId":"BSI-00046","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"BSI-00047","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"BSI-00048","book":{"desk":{"businessUnit":{"legalEntity":null}}}}]}';
