Service stress::DSTree_DatedTier2
{
    pattern: '/stress/dstree_datedtier2';
    documentation: 'A graphFetch 4 levels deep from capitalinstruments::DatedTier2. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |capitalinstruments::DatedTier2.all()
        ->graphFetch(#{
  capitalinstruments::DatedTier2
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  capitalinstruments::DatedTier2
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSTree_DatedTier2_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"recordId":"CAP-00013","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00014","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CAP-00015","book":null}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

