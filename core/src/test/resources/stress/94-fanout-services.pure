Service stress::DSAgg_TradeReport
{
    pattern: '/stress/dsagg_tradereport';
    documentation: 'groupBy on a local key of regulatory::TradeReport with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |regulatory::TradeReport.all()
        ->filter({x|($x.status > ' ')})
        ->project(~[
            status:x|$x.status,
            reportId:x|$x.reportId,
            retryCount:x|$x.retryCount
        ])
        ->groupBy(~[status], ~[
            n: x|$x.reportId : agg|$agg->count(),
            total: x|$x.retryCount : agg|$agg->sum()
        ])
        ->sort(~status->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_TradeReport_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"status":"ACCEPTED","n":11,"total":0},{"status":"REJECTED","n":3,"total":6}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSDeep_TradeReport
{
    pattern: '/stress/dsdeep_tradereport';
    documentation: 'The deepest to-one reach regulatory::TradeReport offers, filtered on a NAVIGATED column rather than a local one, composite-sorted and limited. A predicate over a joined column has to be placed relative to the join, which a filter on the root never tests. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |regulatory::TradeReport.all()
        ->filter({x|($x.trade.order.instrument.sector.name > ' ') && ($x.status > ' ')})
        ->project(~[
            reportId:x|$x.reportId,
            tradeOrderInstrumentSectorName:x|$x.trade.order.instrument.sector.name,
            tradeOrderInstrumentInstrumentCurrencyName:x|$x.trade.order.instrument.instrumentCurrency.name,
            tradeOrderInstrumentExchangeName:x|$x.trade.order.instrument.exchange.name,
            tradeInstrumentInstrumentCurrencyCountryName:x|$x.trade.instrument.instrumentCurrency.country.name
        ])
        ->sort(~reportId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSDeep_TradeReport_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 0 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

