Service stress::PNLX_All
{
    pattern: '/stress/pnlx_all';
    documentation: 'Every row of bookclosure::PnlExplainItem, unfiltered. The subtype services partition this same table by discriminator; this is the whole of it, and therefore the only service that would show a row whose type code matches no subtype at all. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |bookclosure::PnlExplainItem.all()
        ->project(~[
            recordId:x|$x.recordId,
            recordType:x|$x.recordType,
            notionalPerRiskPoint:x|$x.notionalPerRiskPoint,
            notionalGbp:x|$x.notionalIn(0.79),
            currency:x|$x.currency,
            maturityDate:x|$x.maturityDate,
            isActive:x|$x.isActive
        ])
        ->sort(~recordId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
