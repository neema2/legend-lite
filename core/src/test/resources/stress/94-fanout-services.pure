Service stress::BMKX_All
{
    pattern: '/stress/bmkx_all';
    documentation: 'Every row of benchmarks::BenchmarkIndex, unfiltered. The subtype services partition this same table by discriminator; this is the whole of it, and therefore the only service that would show a row whose type code matches no subtype at all. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |benchmarks::BenchmarkIndex.all()
        ->project(~[
            indexId:x|$x.indexId,
            indexType:x|$x.indexType,
            dailyReturnPct:x|$x.dailyReturnPct,
            weightingScheme:x|$x.weightingScheme,
            constituentCount:x|$x.constituentCount,
            previousLevel:x|$x.previousLevel
        ])
