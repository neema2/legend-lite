    pattern: '/stress/dstree_attributionreport';
    documentation: 'A graphFetch 4 levels deep from clientreporting::AttributionReport. A sub-object that is wholly ABSENT and one whose every field is null are the same row in a projection and different objects in a tree, so this asserts something the DSDeep service over the same reach cannot. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |clientreporting::AttributionReport.all()
        ->graphFetch(#{
  clientreporting::AttributionReport
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  clientreporting::AttributionReport
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSTree_AttributionReport_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"recordId":"CRP-00019","book":{"desk":{"businessUnit":{"legalEntity":null}}}},{"recordId":"CRP-00020","book":null},{"recordId":"CRP-00021","book":{"desk":{"businessUnit":{"legalEntity":null}}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSSub_AttributionReport
{
    pattern: '/stress/dssub_attributionreport';
    documentation: 'Rooted at the SUBTYPE clientreporting::AttributionReport and navigating its OWN ends. 1828 class mappings in this corpus extend another set, and almost nothing has ever navigated out of one -- the services over them project local columns and stop. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |clientreporting::AttributionReport.all()
        ->filter({x|($x.book.desk.businessUnit.legalEntity.jurisdiction > ' ')})
        ->project(~[
            recordId:x|$x.recordId,
            bookDeskBusinessUnitLegalEntityJurisdiction:x|$x.book.desk.businessUnit.legalEntity.jurisdiction,
            bookDeskBusinessUnitName:x|$x.book.desk.businessUnit.name,
            bookRollupBookId:x|$x.book.rollup.bookId
        ])
        ->sort(~recordId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSSub_AttributionReport_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 0 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

