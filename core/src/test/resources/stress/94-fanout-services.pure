Service stress::DSAgg_CouponPeriod
{
    pattern: '/stress/dsagg_couponperiod';
    documentation: 'groupBy on a local key of fixedincome::CouponPeriod with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |fixedincome::CouponPeriod.all()
        ->filter({x|($x.securityId > ' ')})
        ->project(~[
            securityId:x|$x.securityId,
            periodId:x|$x.periodId,
            accrualDays:x|$x.accrualDays
        ])
        ->groupBy(~[securityId], ~[
            n: x|$x.periodId : agg|$agg->count(),
            total: x|$x.accrualDays : agg|$agg->sum()
        ])
        ->sort(~securityId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_CouponPeriod_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"securityId":"DE000A289N78","n":7,"total":2556},{"securityId":"US037833DX90","n":12,"total":2160},{"securityId":"US912810TM08","n":60,"total":10957},{"securityId":"US912828YY08","n":20,"total":3653},{"securityId":"XS1002801758","n":20,"total":3600},{"securityId":"XS2056430215","n":11,"total":4018}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

