Service stress::DSAgg_SettlementSettlementFail
{
    pattern: '/stress/dsagg_settlementsettlementfail';
    documentation: 'groupBy on a local key of settlement::SettlementFail with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |settlement::SettlementFail.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            currency:x|$x.currency,
            failId:x|$x.failId,
            ageInDays:x|$x.ageInDays
        ])
        ->groupBy(~[currency], ~[
            n: x|$x.failId : agg|$agg->count(),
            total: x|$x.ageInDays : agg|$agg->sum()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_SettlementSettlementFail_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"GBP","n":1,"total":402},{"currency":"JPY","n":1,"total":423},{"currency":"USD","n":2,"total":416}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

