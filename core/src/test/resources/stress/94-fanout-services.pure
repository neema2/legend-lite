    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#)
        ->serialize(#{
  balancesheet::NonControllingInterest
  {
    recordId,
    book
    {
      desk
      {
        businessUnit
        {
          legalEntity
          {
            leId
          }
        }
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
