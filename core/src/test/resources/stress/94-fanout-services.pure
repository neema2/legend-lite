        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"lotId":"LP-0001","lotType":"STANDARD","holdingPeriod":262},{"lotId":"LP-0003","lotType":"LEGACY","holdingPeriod":276},{"lotId":"LP-0004","lotType":"STANDARD","holdingPeriod":283},{"lotId":"LP-0005","lotType":"PREMIUM","holdingPeriod":290}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::DSAgg_LotPosition
{
    pattern: '/stress/dsagg_lotposition';
    documentation: 'groupBy on a local key of positions::LotPosition with two aggregates over it. The rows being grouped are the ones its ~filter selected, so a filter that selected the whole table shows up here as the wrong COUNT rather than as extra rows. Generated by scripts/corpus/deepstack.py.';
    execution: Single
    {
    query: |positions::LotPosition.all()
        ->filter({x|($x.lotType > ' ')})
        ->project(~[
            lotType:x|$x.lotType,
            lotId:x|$x.lotId,
            holdingPeriod:x|$x.holdingPeriod
        ])
        ->groupBy(~[lotType], ~[
            n: x|$x.lotId : agg|$agg->count(),
            total: x|$x.holdingPeriod : agg|$agg->sum()
        ])
        ->sort(~lotType->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    DSAgg_LotPosition_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"lotType":"LEGACY","n":1,"total":276},{"lotType":"PREMIUM","n":1,"total":290},{"lotType":"STANDARD","n":2,"total":545}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

