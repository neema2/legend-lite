          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"creditId":"SC-0001","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeBrokerageTierRateFraction":0.0008,"tradeBrokerageTierFeeOnQ":0.0004},{"creditId":"SC-0002","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeBrokerageTierRateFraction":0.0008,"tradeBrokerageTierFeeOnQ":0.0004},{"creditId":"SC-0003","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeBrokerageTierRateFraction":0.0008,"tradeBrokerageTierFeeOnQ":0.0004},{"creditId":"SC-0004","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"SELL","tradeBrokerageTierRateFraction":0.0008,"tradeBrokerageTierFeeOnQ":0.0004},{"creditId":"SC-0005","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeBrokerageTierRateFraction":0.0008,"tradeBrokerageTierFeeOnQ":0.0004},{"creditId":"SC-0006","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeBrokerageTierRateFraction":0.0008,"tradeBrokerageTierFeeOnQ":0.0004},{"creditId":"SC-0007","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeBrokerageTierRateFraction":0.0008,"tradeBrokerageTierFeeOnQ":0.0004},{"creditId":"SC-0008","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeBrokerageTierRateFraction":0.00125,"tradeBrokerageTierFeeOnQ":0.000625},{"creditId":"SC-0009","s