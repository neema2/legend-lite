      [
        // 10 rows of the TradeTopTwo feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0009","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-04T09:03:00.000000000+0000","quantity":3000.0,"price":192.25,"notional":576750.0,"place":1},{"tradeId":"TRD-0002","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:14:00.000000000+0000","quantity":2500.0,"price":191.0,"notional":477500.0,"place":2},{"tradeId":"TRD-0018","instrumentId":"INST-GILT30","bookId":"BK-VOL-01","createdTime":"2024-06-07T09:06:00.000000000+0000","quantity":5000000.0,"price":0.9825,"notional":4912500.0,"place":1},{"tradeId":"TRD-0019","instrumentId":"INST-GILT30","bookId":"BK-VOL-01","createdTime":"2024-06-07T09:13:00.000000000+0000","quantity":2000000.0,"price":0.98,"notional":1960000.0,"place":2},{"tradeId":"TRD-0013","instrumentId":"INST-HSBA","bookId":"BK-CASH-EU","createdTime":"2024-06-05T09:31:00.000000000+0000","quantity":25000.0,"price":6.85,"notional":171250.0,"place":1},{"tradeId":"TRD-0014","instrumentId":"INST-HSBA","bookId":"BK-CASH-EU","createdTime":"2024-06-05T09:38:00.000000000+0000","quantity":10000.0,"price":6.9,"notional":69000.0,"place":2},{"tradeId":"TRD-0010","instrumentId":"INST-MSFT","bookId":"BK-CASH-US","createdTime":"2024-06-04T09:10:00.000000000+0000","quantity":1200.0,"price":415.0,"notional":498000.0,"place":1},{"tradeId":"TRD-0012","instrumentId":"INST-MSFT","bookId":"BK-VOL-01","createdTime":"2024-06-05T09:24:00.000000000+0000","quantity":900.0,"price":410.0,"notional":369000.0,"place":2},{"tradeId":"TRD-0017","instrumentId":"INST-SAP","bookId":"BK-CASH-EU","createdTime":"2024-06-06T09:59:00.000000000+0000","quantity":2200.0,"price":175.0,"notional":385000.0,"place":1},{"tradeId":"TRD-0016","instrumentId":"INST-SAP","bookId":"BK-CASH-EU","createdTime":"2024-06-06T09:52:00.000000000+0000","quantity":1500.0,"price":176.4,"notional":264600.0,"place":2}]';
