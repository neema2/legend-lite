    }
  ]
}

Service stress::TF_TapeFifteenMinutesToTen
{
    pattern: '/stress/tf_tapefifteenminutestoten';
    documentation: 'Each name\'s prints between 09:35 and 09:50 on the 3rd, a fixed clock: volume, VWAP, high, low. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |marketdata::MarketTrade.all()
        ->filter({x|($x.printTime >= %2024-06-03T09:35:00) && ($x.printTime < %2024-06-03T09:50:00)})
        ->project(~[
            instrumentId:x|$x.instrument.instrumentId,
            price:x|$x.price,
            quantity:x|$x.quantity
        ])
        ->groupBy(~[instrumentId], ~[
            volume: x|$x.quantity : agg|$agg->sum(),
            vwap: x|meta::pure::functions::math::mathUtility::rowMapper($x.price, $x.quantity) : agg|$agg->wavg(),
            high: x|$x.price : agg|$agg->max(),
            low: x|$x.price : agg|$agg->min()
        ])
        ->sort(~instrumentId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TapeFifteenMinutesToTen_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows of the TapeFifteenMinutesToTen feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"instrumentId":"INST-AAPL","volume":2200.0,"vwap":190.12727272727273,"high":190.25,"low":189.95}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::TF_TapeLotSizes
{
    pattern: '/stress/tf_tapelotsizes';
    documentation: 'The commonest print size by aggressor side on the lit venues (Pure\'s mode over Float; neither side\'s is tied), with the side\'s distinct venues and its prints. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |marketdata::MarketTrade.all()
        ->filter({x|($x.printTime >= %2024-06-03T00:00:00) && ($x.printTime < %2024-06-06T00:00:00) && !$x.isOffExchange})
        ->project(~[
            aggressorSide:x|$x.aggressorSide,
            quantity:x|$x.quantity,
            venue:x|$x.venue,
            printId:x|$x.printId
        ])
        ->groupBy(~[aggressorSide], ~[
            usualSize: x|$x.quantity : agg|$agg->mode(),
            venues: x|$x.venue : agg|$agg->distinct()->count(),
            prints: x|$x.printId : agg|$agg->count()
        ])
        ->sort(~aggressorSide->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TapeLotSizes_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows of the TapeLotSizes feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"aggressorSide":"B","usualSize":300.0,"venues":5,"prints":13},{"aggressorSide":"S","usualSize":100.0,"venues":4,"prints":9}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::TF_TapeVenueShare
{
    pattern: '/stress/tf_tapevenueshare';
    documentation: 'Each name\'s volume by venue over the market\'s day, with its off-exchange prints among them. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |marketdata::MarketTrade.all()
        ->filter({x|($x.printTime >= %2024-06-03T00:00:00) && ($x.printTime < %2024-06-06T00:00:00)})
        ->project(~[
            instrumentId:x|$x.instrument.instrumentId,
            venue:x|$x.venue,
            quantity:x|$x.quantity,
            printId:x|$x.printId
        ])
        ->groupBy(~[instrumentId, venue], ~[
            volume: x|$x.quantity : agg|$agg->sum(),
            prints: x|$x.printId : agg|$agg->count()
        ])
        ->sort([~instrumentId->ascending(), ~venue->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TapeVenueShare_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 11 rows of the TapeVenueShare feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"instrumentId":"INST-AAPL","venue":"ARCX","volume":900.0,"prints":2},{"instrumentId":"INST-AAPL","venue":"BATS","volume":750.0,"prints":3},{"instrumentId":"INST-AAPL","venue":"FINRA","volume":2000.0,"prints":1},{"instrumentId":"INST-AAPL","venue":"IEXG","volume":1000.0,"prints":1},{"instrumentId":"INST-AAPL","venue":"XNAS","volume":3850.0,"prints":7},{"instrumentId":"INST-HSBA","venue":"CHIX","volume":8000.0,"prints":1},{"instrumentId":"INST-HSBA","venue":"XLON","volume":20000.0,"prints":3},{"instrumentId":"INST-MSFT","venue":"BATS","volume":100.0,"prints":1},{"instrumentId":"INST-MSFT","venue":"FINRA","volume":150.0,"prints":1},{"instrumentId":"INST-MSFT","venue":"IEXG","volume":500.0,"prints":1},{"instrumentId":"INST-MSFT","venue":"XNAS","volume":900.0,"prints":3}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::TF_TapePrevailingQuote
{
    pattern: '/stress/tf_tapeprevailingquote';
    documentation: 'Each print beside the quote prevailing at its instant: an as-of join on the name, the latest quote at or before the print (one print precedes every quote, two land on a quote\'s instant). Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |marketdata::MarketTrade.all()
        ->filter({x|($x.printTime >= %2024-06-03T00:00:00) && ($x.printTime < %2024-06-06T00:00:00)})
        ->project(~[
            printId:x|$x.printId,
            printInstrument:x|$x.instrument.instrumentId,
            printTime:x|$x.printTime,
            price:x|$x.price,
            quantity:x|$x.quantity
        ])
        ->asOfJoin(
            marketdata::MarketQuote.all()
                ->project(~[
                    quoteId:x|$x.quoteId,
                    quoteInstrument:x|$x.instrument.instrumentId,
                    quoteTime:x|$x.quoteTime,
                    bid:x|$x.bid,
                    ask:x|$x.ask,
                    mid:x|$x.mid
                ]),
            {a, b|$a.printTime >= $b.quoteTime},
            {a, b|$a.printInstrument == $b.quoteInstrument}
        )
        ->sort(~printId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
