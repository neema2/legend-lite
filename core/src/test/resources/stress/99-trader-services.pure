Service stress::TF_TapeCandles
{
    pattern: '/stress/tf_tapecandles';
    documentation: 'Five-minute candles over the market\'s day: open and close by sequence (minBy and maxBy), high, low, volume, VWAP and prints, per name and bucket (timeBucket). Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |marketdata::MarketTrade.all()
        ->filter({x|($x.printTime >= %2024-06-03T00:00:00) && ($x.printTime < %2024-06-06T00:00:00)})
        ->project(~[
            instrumentId:x|$x.instrument.instrumentId,
            bucket:x|timeBucket($x.printTime, 5, meta::pure::functions::date::DurationUnit.MINUTES),
            sequenceNumber:x|$x.sequenceNumber,
            price:x|$x.price,
            quantity:x|$x.quantity
        ])
        ->groupBy(~[instrumentId, bucket], ~[
            open: x|meta::pure::functions::math::mathUtility::rowMapper($x.price, $x.sequenceNumber) : agg|$agg->minBy(),
            close: x|meta::pure::functions::math::mathUtility::rowMapper($x.price, $x.sequenceNumber) : agg|$agg->maxBy(),
            high: x|$x.price : agg|$agg->max(),
            low: x|$x.price : agg|$agg->min(),
            volume: x|$x.quantity : agg|$agg->sum(),
            vwap: x|meta::pure::functions::math::mathUtility::rowMapper($x.price, $x.quantity) : agg|$agg->wavg(),
            prints: x|$x.price : agg|$agg->count()
        ])
        ->sort([~instrumentId->ascending(), ~bucket->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TapeCandles_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 17 rows of the TapeCandles feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"instrumentId":"INST-AAPL","bucket":"2024-06-03T08:55:00.000000000+0000","open":190.35,"close":190.35,"high":190.35,"low":190.35,"volume":100.0,"vwap":190.35,"prints":1},{"instrumentId":"INST-AAPL","bucket":"2024-06-03T09:00:00.000000000+0000","open":190.6,"close":190.55,"high":190.6,"low":190.55,"volume":500.0,"vwap":190.57,"prints":2},{"instrumentId":"INST-AAPL","bucket":"2024-06-03T09:05:00.000000000+0000","open":190.5,"close":190.55,"high":190.55,"low":190.5,"volume":1500.0,"vwap":190.53333333333333,"prints":2},{"instrumentId":"INST-AAPL","bucket":"2024-06-03T09:10:00.000000000+0000","open":191.0,"close":191.05,"high":191.05,"low":191.0,"volume":400.0,"vwap":191.01875,"prints":2},{"instrumentId":"INST-AAPL","bucket":"2024-06-03T09:15:00.000000000+0000","open":191.25,"close":191.25,"high":191.25,"low":191.25,"volume":400.0,"vwap":191.25,"prints":1},{"instrumentId":"INST-AAPL","bucket":"2024-06-03T09:20:00.000000000+0000","open":191.35,"close":191.35,"high":191.35,"low":191.35,"volume":2000.0,"vwap":191.35,"prints":1},{"instrumentId":"INST-AAPL","bucket":"2024-06-03T09:25:00.000000000+0000","open":190.95,"close":190.95,"high":190.95,"low":190.95,"volume":600.0,"vwap":190.95,"prints":1},{"instrumentId":"INST-AAPL","bucket":"2024-06-03T09:30:00.000000000+0000","open":190.75,"close":190.75,"high":190.75,"low":190.75,"volume":800.0,"vwap":190.75,"prints":1},{"instrumentId":"INST-AAPL","bucket":"2024-06-03T09:40:00.000000000+0000","open":190.25,"close":190.25,"high":190.25,"low":190.25,"volume":1200.0,"vwap":190.25,"prints":1},{"instrumentId":"INST-AAPL","bucket":"2024-06-03T09:45:00.000000000+0000","open":190.05,"close":189.95,"high":190.05,"low":189.95,"volume":1000.0,"vwap":189.98,"prints":2},{"instrumentId":"INST-HSBA","bucket":"2024-06-05T09:30:00.000000000+0000","open":6.86,"close":6.85,"high":6.86,"low":6.85,"volume":17000.0,"vwap":6.852941176470588,"prints":2},{"instrumentId":"INST-HSBA","bucket":"2024-06-05T09:35:00.000000000+0000","open":6.9,"close":6.89,"high":6.9,"low":6.89,"volume":11000.0,"vwap":6.897272727272727,"prints":2},{"instrumentId":"INST-MSFT","bucket":"2024-06-04T09:05:00.000000000+0000","open":415.1,"close":415.05,"high":415.1,"low":415.05,"volume":300.0,"vwap":415.0833333333333,"prints":2},{"instrumentId":"INST-MSFT","bucket":"2024-06-04T09:10:00.000000000+0000","open":415.2,"close":415.2,"high":415.2,"low":415.2,"volume":300.0,"vwap":415.2,"prints":1},{"instrumentId":"INST-MSFT","bucket":"2024-06-04T09:15:00.000000000+0000","open":416.25,"close":416.25,"high":416.25,"low":416.25,"volume":500.0,"vwap":416.25,"prints":1},{"instrumentId":"INST-MSFT","bucket":"2024-06-04T09:20:00.000000000+0000","open":416.3,"close":416.3,"high":416.3,"low":416.3,"volume":150.0,"vwap":416.3,"prints":1},{"instrumentId":"INST-MSFT","bucket":"2024-06-04T09:25:00.000000000+0000","open":417.85,"close":417.85,"high":417.85,"low":417.85,"volume":400.0,"vwap":417.85,"prints":1}]';
                  }#;
