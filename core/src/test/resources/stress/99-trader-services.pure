Service stress::TF_InstrumentMix
{
    pattern: '/stress/tf_instrumentmix';
    documentation: 'How each name traded: the distinct venues it executed on and the distinct books it was booked in. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            instrumentId:x|$x.instrument.instrumentId,
            epoch:x|toEpochValue($x.createdTime),
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            executionVenue:x|$x.executionVenue,
            bookId:x|$x.book.bookId
        ])
        ->groupBy(~[instrumentId], ~[
            venues: x|$x.executionVenue : agg|$agg->distinct()->count(),
            books: x|$x.bookId : agg|$agg->distinct()->count()
        ])
        ->sort(~instrumentId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
