                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"instrumentId":"INST-AAPL","pxQtyCorr":-0.461954,"pxQtyCovar":-48810.069444,"pxQtyCovarPop":-43386.728395},{"instrumentId":"INST-GILT30","pxQtyCorr":0.891042,"pxQtyCovar":7083.333333,"pxQtyCovarPop":4722.222222},{"instrumentId":"INST-HSBA","pxQtyCorr":-0.891042,"pxQtyCovar":-708.333333,"pxQtyCovarPop":-472.222222},{"instrumentId":"INST-MSFT","pxQtyCorr":-0.518491,"pxQtyCovar":-870.833333,"pxQtyCovarPop":-580.555556},{"instrumentId":"INST-SAP","pxQtyCorr":-1.0,"pxQtyCovar":-490.0,"pxQtyCovarPop":-245.0}]';
                  }#;
