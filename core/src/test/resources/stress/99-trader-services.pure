Service stress::TF_InstrumentVwap
{
    pattern: '/stress/tf_instrumentvwap';
    documentation: 'A watchlist\'s figures per name over the booked trades: the trades, the volume, the volume-weighted average price, and the first and last prices by time -- Pure\'s wavg, and minBy/maxBy over a rowMapper keyed by the trade\'s epoch seconds (toEpochValue). Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            instrumentId:x|$x.instrument.instrumentId,
            epoch:x|toEpochValue($x.createdTime),
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            executionVenue:x|$x.executionVenue,
            bookId:x|$x.book.bookId
        ])
        ->groupBy(~[instrumentId], ~[
            trades: x|$x.tradeId : agg|$agg->count(),
            volume: x|$x.quantity : agg|$agg->sum(),
            vwap: x|meta::pure::functions::math::mathUtility::rowMapper($x.price, $x.quantity) : agg|$agg->wavg(),
            firstPrice: x|meta::pure::functions::math::mathUtility::rowMapper($x.price, $x.epoch) : agg|$agg->minBy(),
            lastPrice: x|meta::pure::functions::math::mathUtility::rowMapper($x.price, $x.epoch) : agg|$agg->maxBy()
        ])
        ->sort(~instrumentId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_InstrumentVwap_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows of the InstrumentVwap feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"instrumentId":"INST-AAPL","trades":9,"volume":12650.0,"vwap":201.24308300395256,"firstPrice":190.5,"lastPrice":189.75},{"instrumentId":"INST-GILT30","trades":3,"volume":8000000.0,"vwap":0.9809375,"firstPrice":0.9825,"lastPrice":0.975},{"instrumentId":"INST-HSBA","trades":3,"volume":40000.0,"vwap":6.88125,"firstPrice":6.85,"lastPrice":7.0},{"instrumentId":"INST-MSFT","trades":3,"volume":2500.0,"vwap":413.72,"firstPrice":415.0,"lastPrice":410.0},{"instrumentId":"INST-SAP","trades":2,"volume":3700.0,"vwap":175.56756756756758,"firstPrice":176.4,"lastPrice":175.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::TF_InstrumentDispersion
{
    pattern: '/stress/tf_instrumentdispersion';
    documentation: 'The spread of each name\'s trade prices, to the precision a screen shows (a statistic is approximate in every database -- a streaming variance over three gilt prices within 0.0075 of each other is 178 units in the last place from the exact one -- so the service asks for six places, as a risk screen would): the sample and population standard deviations and variances, the median, and the ninetieth percentile of notional (continuous: interpolated between neighbours) to the cent. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            instrumentId:x|$x.instrument.instrumentId,
            epoch:x|toEpochValue($x.createdTime),
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            executionVenue:x|$x.executionVenue,
            bookId:x|$x.book.bookId
        ])
        ->groupBy(~[instrumentId], ~[
            pxStdDev: x|$x.price : agg|$agg->stdDevSample()->cast(@Float)->round(6),
            pxStdDevPop: x|$x.price : agg|$agg->stdDevPopulation()->cast(@Float)->round(6),
            pxVar: x|$x.price : agg|$agg->varianceSample()->cast(@Float)->round(6),
            pxVarPop: x|$x.price : agg|$agg->variancePopulation()->cast(@Float)->round(6),
            pxMedian: x|$x.price : agg|$agg->median(),
            notionalP90: x|$x.notional : agg|$agg->percentile(0.9)->toOne()->cast(@Float)->round(2)
        ])
        ->sort(~instrumentId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_InstrumentDispersion_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows of the InstrumentDispersion feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"instrumentId":"INST-AAPL","pxStdDev":111.51318,"pxStdDevPop":105.135634,"pxVar":12435.189236,"pxVarPop":11053.501543,"pxMedian":191.0,"notionalP90":497350.0},{"instrumentId":"INST-GILT30","pxStdDev":0.003819,"pxStdDevPop":0.003118,"pxVar":1.5e-05,"pxVarPop":1e-05,"pxMedian":0.98,"notionalP90":4322000.0},{"instrumentId":"INST-HSBA","pxStdDev":0.076376,"pxStdDevPop":0.062361,"pxVar":0.005833,"pxVarPop":0.003889,"pxMedian":6.9,"notionalP90":150800.0},{"instrumentId":"INST-MSFT","pxStdDev":4.155819,"pxStdDevPop":3.393212,"pxVar":17.270833,"pxVarPop":11.513889,"pxMedian":415.0,"notionalP90":472200.0},{"instrumentId":"INST-SAP","pxStdDev":0.989949,"pxStdDevPop":0.7,"pxVar":0.98,"pxVarPop":0.49,"pxMedian":175.7,"notionalP90":372960.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::TF_InstrumentCorrelation
{
    pattern: '/stress/tf_instrumentcorrelation';
    documentation: 'Whether size moves with price, per name, to six places: Pure\'s corr and the sample and population covariances of a trade\'s price and its quantity (each Number[0..1], so made one Float to be rounded). Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            instrumentId:x|$x.instrument.instrumentId,
            epoch:x|toEpochValue($x.createdTime),
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            executionVenue:x|$x.executionVenue,
            bookId:x|$x.book.bookId
        ])
        ->groupBy(~[instrumentId], ~[
            pxQtyCorr: x|meta::pure::functions::math::mathUtility::rowMapper($x.price, $x.quantity) : agg|$agg->corr()->toOne()->cast(@Float)->round(6),
            pxQtyCovar: x|meta::pure::functions::math::mathUtility::rowMapper($x.price, $x.quantity) : agg|$agg->covarSample()->toOne()->cast(@Float)->round(6),
            pxQtyCovarPop: x|meta::pure::functions::math::mathUtility::rowMapper($x.price, $x.quantity) : agg|$agg->covarPopulation()->toOne()->cast(@Float)->round(6)
        ])
        ->sort(~instrumentId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_InstrumentCorrelation_suite:
    {
