Service stress::TF_TradePrevailingQuote
{
    pattern: '/stress/tf_tradeprevailingquote';
    documentation: 'Transaction cost: each booked trade beside the market\'s quote strictly before it, and its price\'s distance from that quote\'s mid in basis points (none where the name has no quote before the trade). Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeInstrument:x|$x.instrument.instrumentId,
            createdTime:x|$x.createdTime,
            price:x|$x.price,
            quantity:x|$x.quantity
        ])
        ->asOfJoin(
            marketdata::MarketQuote.all()
                ->project(~[
                    quoteId:x|$x.quoteId,
                    quoteInstrument:x|$x.instrument.instrumentId,
                    quoteTime:x|$x.quoteTime,
                    bid:x|$x.bid,
                    ask:x|$x.ask,
                    mid:x|$x.mid
                ]),
            {a, b|$a.createdTime > $b.quoteTime},
            {a, b|$a.tradeInstrument == $b.quoteInstrument}
        )
        ->extend(~[slippageBps:x|($x.price - $x.mid) * 10000.0 / $x.mid])
        ->sort(~tradeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TradePrevailingQuote_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows of the TradePrevailingQuote feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
