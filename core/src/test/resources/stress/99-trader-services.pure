Service stress::TF_TapeRollingFiveMinutes
{
    pattern: '/stress/tf_taperollingfiveminutes';
    documentation: 'The last five minutes at each print (a time range frame over the print time; two prints share an instant, so the frame holds its peers): volume, high, low and prints. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |marketdata::MarketTrade.all()
        ->filter({x|($x.printTime >= %2024-06-03T00:00:00) && ($x.printTime < %2024-06-06T00:00:00)})
        ->project(~[
            printId:x|$x.printId,
            instrumentId:x|$x.instrument.instrumentId,
            sequenceNumber:x|$x.sequenceNumber,
            printTime:x|$x.printTime,
            price:x|$x.price,
            quantity:x|$x.quantity
        ])
        ->extend(over(~instrumentId, ~printTime->ascending(), _range(-5, DurationUnit.MINUTES, 0, DurationUnit.MINUTES)), ~[
            vol5m:{p,w,r|$r.quantity}:y|$y->sum(),
            hi5m:{p,w,r|$r.price}:y|$y->max(),
            lo5m:{p,w,r|$r.price}:y|$y->min(),
            prints5m:{p,w,r|$r.printId}:y|$y->count()
        ])
        ->sort(~printId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TapeRollingFiveMinutes_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
