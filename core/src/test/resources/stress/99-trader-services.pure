Service stress::TF_TradeRanks
{
    pattern: '/stress/tf_traderanks';
    documentation: 'Each trade\'s place in its book by notional, largest first: rank and denseRank (three trades tie at 250,000), percentRank and cumulativeDistribution, and over a tie-free order its row number and tercile. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            instrumentId:x|$x.instrument.instrumentId,
            bookId:x|$x.book.bookId,
            createdTime:x|$x.createdTime,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional
        ])
        ->extend(over(~bookId, ~notional->descending()), ~[
            rank:{p,w,r|$p->rank($w, $r)},
            denseRank:{p,w,r|$p->denseRank($w, $r)},
            pctRank:{p,w,r|$p->percentRank($w, $r)},
            cumeDist:{p,w,r|$p->cumulativeDistribution($w, $r)}
        ])
        ->extend(over(~bookId, [~notional->descending(), ~tradeId->ascending()]), ~[
            place:{p,w,r|$p->rowNumber($r)},
            tercile:{p,w,r|$p->ntile($r, 3)}
        ])
        ->sort(~tradeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TradeRanks_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows of the TradeRanks feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
