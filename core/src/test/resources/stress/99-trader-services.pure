Service stress::TF_TradeRunning
{
    pattern: '/stress/tf_traderunning';
    documentation: 'Each name\'s trades in time order with its running figures (SQL\'s default frame: the start to the current row): the running volume and notional, the trade\'s number, the prices before and after it, and the first price so far. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            instrumentId:x|$x.instrument.instrumentId,
            bookId:x|$x.book.bookId,
            createdTime:x|$x.createdTime,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional
        ])
        ->extend(over(~instrumentId, ~createdTime->ascending()), ~[
            cumQty:{p,w,r|$r.quantity}:y|$y->sum(),
            cumNotional:{p,w,r|$r.notional}:y|$y->sum()
        ])
        ->extend(over(~instrumentId, ~createdTime->ascending()), ~[
            tradeNo:{p,w,r|$p->rowNumber($r)},
            prevPrice:{p,w,r|$p->lag($r).price},
            nextPrice:{p,w,r|$p->lead($r).price},
            twoBack:{p,w,r|$p->lag($r, 2).price},
            openPrice:{p,w,r|$p->first($w, $r).price}
        ])
        ->sort(~tradeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TradeRunning_suite:
    {
