Service stress::TF_TapeTimeAndSales
{
    pattern: '/stress/tf_tapetimeandsales';
    documentation: 'Time and sales over the market\'s day: each print with its name\'s running volume, the price it ticked from (an uptick or a downtick on the screen) and the running high and low. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |marketdata::MarketTrade.all()
        ->filter({x|($x.printTime >= %2024-06-03T00:00:00) && ($x.printTime < %2024-06-06T00:00:00)})
        ->project(~[
            printId:x|$x.printId,
            instrumentId:x|$x.instrument.instrumentId,
            sequenceNumber:x|$x.sequenceNumber,
            printTime:x|$x.printTime,
            price:x|$x.price,
            quantity:x|$x.quantity
        ])
        ->extend(over(~instrumentId, ~sequenceNumber->ascending()), ~dayVolume:{p,w,r|$r.quantity}:y|$y->sum())
        ->extend(over(~instrumentId, ~sequenceNumber->ascending()), ~tickFrom:{p,w,r|$p->lag($r).price})
        ->extend(over(~instrumentId, ~sequenceNumber->ascending()), ~[
            dayHigh:{p,w,r|$r.price}:y|$y->max(),
            dayLow:{p,w,r|$r.price}:y|$y->min()
        ])
        ->sort(~printId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TapeTimeAndSales_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 24 rows of the TapeTimeAndSales feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
