Service stress::TF_TradeMoving
{
    pattern: '/stress/tf_trademoving';
    documentation: 'Moving figures over each name\'s last three trades (rows(-2, 0)) and a centred volume (rows(-1, 1)). Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            instrumentId:x|$x.instrument.instrumentId,
            bookId:x|$x.book.bookId,
            createdTime:x|$x.createdTime,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional
        ])
        ->extend(over(~instrumentId, ~createdTime->ascending(), rows(-2, 0)), ~[
            ma3:{p,w,r|$r.price}:y|$y->average(),
            hi3:{p,w,r|$r.price}:y|$y->max(),
            lo3:{p,w,r|$r.price}:y|$y->min(),
            n3:{p,w,r|$r.price}:y|$y->count()
        ])
        ->extend(over(~instrumentId, ~createdTime->ascending(), rows(-1, 1)), ~qtyAround:{p,w,r|$r.quantity}:y|$y->sum())
        ->sort(~tradeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TradeMoving_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows of the TradeMoving feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:07:00.000000000+0000","quantity":1000.0,"price":190.5,"notional":190500.0,"ma3":190.5,"hi3":190.5,"lo3":190.5,"n3":1,"qtyAround":3500.0},{"tradeId":"TRD-0002","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:14:00.000000000+0000","quantity":2500.0,"price":191.0,"notional":477500.0,"ma3":190.75,"hi3":191.0,"lo3":190.5,"n3":2,"qtyAround":4000.0},{"tradeId":"TRD-0003","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:21:00.000000000+0000","quantity":500.0,"price":500.0,"notional":250000.0,"ma3":293.8333333333333,"hi3":500.0,"lo3":190.5,"n3":3,"qtyAround":4250.0},{"tradeId":"TRD-0004","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:28:00.000000000+0000","quantity":1250.0,"price":200.0,"notional":250000.0,"ma3":297.0,"hi3":500.0,"lo3":191.0,"n3":3,"qtyAround":3750.0},{"tradeId":"TRD-0005","instrumentId":"INST-AAPL","bookId":"BK-VOL-01","createdTime":"2024-06-03T09:35:00.000000000+0000","quantity":2000.0,"price":125.0,"notional":250000.0,"ma3":275.0,"hi3":500.0,"lo3":125.0,"n3":3,"qtyAround":4050.0},{"tradeId":"TRD-0006","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:42:00.000000000+0000","quantity":800.0,"price":312.5,"notional":250000.0,"ma3":212.5,"hi3":312.5,"lo3":125.0,"n3":3,"qtyAround":4300.0},{"tradeId":"TRD-0007","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:49:00.000000000+0000","quantity":1500.0,"price":188.0,"notional":282000.0,"ma3":208.5,"hi3":312.5,"lo3":125.0,"n3":3,"qtyAround":5300.0},{"tradeId":"TRD-0008","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-04T09:56:00.000000000+0000","quantity":100.0,"price":189.75,"notional":18975.0,"ma3":190.0,"hi3":192.25,"lo3":188.0,"n3":3,"qtyAround":3100.0},{"tradeId":"TRD-0009","instrumentId":"INST-AAPL","bookId":"BK-CASH