Service stress::TF_PrintScalars
{
    pattern: '/stress/tf_printscalars';
    documentation: 'Time and sales\' computed columns over the market\'s day: the print\'s value, its price in ticks of a twentieth, its sequence as text, and its venue\'s first two letters. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |marketdata::MarketTrade.all()
        ->filter({x|($x.printTime >= %2024-06-03T00:00:00) && ($x.printTime < %2024-06-06T00:00:00)})
        ->project(~[
            printId:x|$x.printId,
            value:x|$x.price * $x.quantity,
            ticks:x|round($x.price * 20.0),
            sequenceText:x|toString($x.sequenceNumber),
            venueHead:x|substring($x.venue, 0, 2)
        ])
        ->sort(~printId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
