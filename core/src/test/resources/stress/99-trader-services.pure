Service stress::TF_TradeBookTotals
{
    pattern: '/stress/tf_tradebooktotals';
    documentation: 'Each trade beside its book\'s whole: the book\'s notional and its trades, an unordered window over the partition. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            instrumentId:x|$x.instrument.instrumentId,
            bookId:x|$x.book.bookId,
            createdTime:x|$x.createdTime,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional
        ])
        ->extend(over(~bookId), ~[
            bookNotional:{p,w,r|$r.notional}:y|$y->sum(),
            bookTrades:{p,w,r|$r.tradeId}:y|$y->count(),
            bookLargest:{p,w,r|$r.notional}:y|$y->max()
        ])
        ->sort(~tradeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TradeBookTotals_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows of the TradeBookTotals feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:07:00.000000000+0000","quantity":1000.0,"price":190.5,"notional":190500.0,"bookNotional":2961025.0,"bookTrades":10,"bookLargest":576750.0},{"tradeId":"TRD-0002","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:14:00.000000000+0000","quantity":2500.0,"price":191.0,"notional":477500.0,"bookNotional":2961025.0,"bookTrades":10,"bookLargest":576750.0},{"tradeId":"TRD-0003","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:21:00.000000000+0000","quantity":500.0,"price":500.0,"notional":250000.0,"bookNotional":2961025.0,"bookTrades":10,"bookLargest":576750.0},{"tradeId":"TRD-0004","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:28:00.000000000+0000","quantity":1250.0,"price":200.0,"notional":250000.0,"bookNotional":2961025.0,"bookTrades":10,"bookLargest":576750.0},{"tradeId":"TRD-0005","instrumentId":"INST-AAPL","bookId":"BK-VOL-01","createdTime":"2024-06-03T09:35:00.000000000+0000","quantity":2000.0,"price":125.0,"notional":250000.0,"bookNotional":8466500.0,"bookTrades":5,"bookLargest":4912500.0},{"tradeId":"TRD-0006","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:42:00.000000000+0000","quantity":800.0,"price":312.5,"notional":250000.0,"bookNotional":2961025.0,"bookTrades":10,"bookLargest":576750.0},{"tradeId":"TRD-0007","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:49:00.000000000+0000","quantity":1500.0,"price":188.0,"notional":282000.0,"bookNotional":2961025.0,"bookTrades":10,"bookLargest":576750.0},{"tradeId":"TRD-0008","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-04T09:56:00.000000000+0000","quantity":100.0,"price":189.75,"notional":18975.0,"bookNotional":2961025.0,"bookTrades":10,"bookLargest":576750.0},{"tradeId":"TRD-0009","instrumentId":"INST-AAPL","bookId":"BK-CA