Service stress::TF_TradeTopTwo
{
    pattern: '/stress/tf_tradetoptwo';
    documentation: 'Each name\'s two largest trades: a row number over the name by notional, kept where it is at most two (SQL\'s QUALIFY). Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            instrumentId:x|$x.instrument.instrumentId,
            bookId:x|$x.book.bookId,
            createdTime:x|$x.createdTime,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional
        ])
        ->extend(over(~instrumentId, [~notional->descending(), ~tradeId->ascending()]), ~place:{p,w,r|$p->rowNumber($r)})
        ->filter({x|($x.place <= 2)})
        ->sort([~instrumentId->ascending(), ~place->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TradeTopTwo_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
