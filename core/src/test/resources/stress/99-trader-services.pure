Service stress::TF_TapeNextQuote
{
    pattern: '/stress/tf_tapenextquote';
    documentation: 'Each print beside the first quote AFTER it (strictly): the as-of join\'s other direction, what a markout reads. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |marketdata::MarketTrade.all()
        ->filter({x|($x.printTime >= %2024-06-03T00:00:00) && ($x.printTime < %2024-06-06T00:00:00)})
        ->project(~[
            printId:x|$x.printId,
            printInstrument:x|$x.instrument.instrumentId,
            printTime:x|$x.printTime,
            price:x|$x.price,
            quantity:x|$x.quantity
        ])
        ->asOfJoin(
            marketdata::MarketQuote.all()
                ->project(~[
                    quoteId:x|$x.quoteId,
                    quoteInstrument:x|$x.instrument.instrumentId,
                    quoteTime:x|$x.quoteTime,
                    bid:x|$x.bid,
                    ask:x|$x.ask,
                    mid:x|$x.mid
                ]),
            {a, b|$a.printTime < $b.quoteTime},
            {a, b|$a.printInstrument == $b.quoteInstrument}
        )
        ->sort(~printId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
