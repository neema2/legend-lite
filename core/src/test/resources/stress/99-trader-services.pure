// The trader features as services over the one trading model: a screen's computed columns, its statistics, its
// moving figures, its candles and its as-of joins, over the hand-written trades and the market's hand-written day
// (scripts/corpus/tape.py). One feature family per service, so a target lacking one fails that service and no other.
// Every expectation is the reference evaluator's -- see scripts/corpus/features.py.
//
// GENERATED by scripts/corpus/build.py -- do not edit by hand.

###Service
Service stress::TF_TradeScalars
{
    pattern: '/stress/tf_tradescalars';
    documentation: 'A blotter\'s computed columns over the booked trades: a price converted at a fixed rate and rounded to the cent, the shares beyond whole lots of a thousand, the trade type\'s three-letter code, whether the status reads as an execution, and the quantity as text -- Pure\'s round with a scale, mod, substring (zero-based, the end exclusive: Java\'s contract), contains and toString. Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            priceEur:x|round($x.price * 0.9213, 2),
            oddLot:x|mod(round($x.quantity), 1000),
            typeCode:x|substring($x.tradeType, 0, 3),
            isExecution:x|contains($x.status, 'EXEC'),
            quantityText:x|toString(round($x.quantity))
        ])
        ->sort(~tradeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TradeScalars_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows of the TradeScalars feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","priceEur":175.51,"oddLot":0,"typeCode":"AGE","isExecution":true,"quantityText":"1000"},{"tradeId":"TRD-0002","priceEur":175.97,"oddLot":500,"typeCode":"AGE","isExecution":true,"quantityText":"2500"},{"tradeId":"TRD-0003","priceEur":460.65,"oddLot":500,"typeCode":"AGE","isExecution":true,"quantityText":"500"},{"tradeId":"TRD-0004","priceEur":184.26,"oddLot":250,"typeCode":"PRI","isExecution":true,"quantityText":"1250"},{"tradeId":"TRD-0005","priceEur":115.16,"oddLot":0,"typeCode":"AGE","isExecution":true,"quantityText":"2000"},{"tradeId":"TRD-0006","priceEur":287.91,"oddLot":800,"typeCode":"AGE","isExecution":true,"quantityText":"800"},{"tradeId":"TRD-0007","priceEur":173.2,"oddLot":500,"typeCode":"AGE","isExecution":true,"quantityText":"1500"},{"tradeId":"TRD-0008","priceEur":174.82,"oddLot":100,"typeCode":"AGE","isExecution":false,"quantityText":"100"},{"tradeId":"TRD-0009","priceEur":177.12,"oddLot":0,"typeCode":"AGE","isExecution":true,"quantityText":"3000"},{"tradeId":"TRD-0010","priceEur":382.34,"oddLot":200,"typeCode":"AGE","isExecution":true,"quantityText":"1200"},{"tradeId":"TRD-0011","priceEur":385.33,"oddLot":400,"typeCode":"AGE","isExecution":true,"quantityText":"400"},{"tradeId":"TRD-0012","priceEur":377.73,"oddLot":900,"typeCode":"AGE","isExecution":false,"quantityText":"900"},{"tradeId":"TRD-0013","priceEur":6.31,"oddLot":0,"typeCode":"PRI","isExecution":true,"quantityText":"25000"},{"tradeId":"TRD-0014","priceEur":6.36,"oddLot":0,"typeCode":"AGE","isExecution":true,"quantityText":"10000"},{"tradeId":"TRD-0015","priceEur":6.45,"oddLot":0,"typeCode":"AGE","isExecution":false,"quantityText":"5000"},{"tradeId":"TRD-0016","priceEur":162.52,"oddLot":500,"typeCode":"AGE","isExecution":true,"quantityText":"1500"},{"tradeId":"TRD-0017","priceEur":161.23,"oddLot":200,"typeCode":"PRI","isExecution":true,"quantityText":"2200"},{"tradeId":"TRD-0018","priceEur":0.91,"oddLot":0,"typeCode":"AGE","isExecution":true,"quantityText":"5000000"},{"tradeId":"TRD-0019","priceEur":0.9,"oddLot":0,"typeCode":"AGE","isExecution":true,"quantityText":"2000000"},{"tradeId":"TRD-0020","priceEur":0.9,"oddLot":0,"typeCode":"AGE","isExecution":false,"quantityText":"1000000"}]';
