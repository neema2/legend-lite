Service stress::TF_TradeLastFifteenMinutes
{
    pattern: '/stress/tf_tradelastfifteenminutes';
    documentation: 'Each name\'s volume and trades in the fifteen minutes up to each trade: a time range frame (_range(-15, MINUTES, 0, MINUTES)). Generated by scripts/corpus/features.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            instrumentId:x|$x.instrument.instrumentId,
            bookId:x|$x.book.bookId,
            createdTime:x|$x.createdTime,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional
        ])
        ->extend(over(~instrumentId, ~createdTime->ascending(), _range(-15, DurationUnit.MINUTES, 0, DurationUnit.MINUTES)), ~[
            qty15m:{p,w,r|$r.quantity}:y|$y->sum(),
            trades15m:{p,w,r|$r.tradeId}:y|$y->count()
        ])
        ->sort(~tradeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TF_TradeLastFifteenMinutes_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows of the TradeLastFifteenMinutes feature.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:07:00.000000000+0000","quantity":1000.0,"price":190.5,"notional":190500.0,"qty15m":1000.0,"trades15m":1},{"tradeId":"TRD-0002","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:14:00.000000000+0000","quantity":2500.0,"price":191.0,"notional":477500.0,"qty15m":3500.0,"trades15m":2},{"tradeId":"TRD-0003","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:21:00.000000000+0000","quantity":500.0,"price":500.0,"notional":250000.0,"qty15m":4000.0,"trades15m":3},{"tradeId":"TRD-0004","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:28:00.000000000+0000","quantity":1250.0,"price":200.0,"notional":250000.0,"qty15m":4250.0,"trades15m":3},{"tradeId":"TRD-0005","instrumentId":"INST-AAPL","bookId":"BK-VOL-01","createdTime":"2024-06-03T09:35:00.000000000+0000","quantity":2000.0,"price":125.0,"notional":250000.0,"qty15m":3750.0,"trades15m":3},{"tradeId":"TRD-0006","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:42:00.000000000+0000","quantity":800.0,"price":312.5,"notional":250000.0,"qty15m":4050.0,"trades15m":3},{"tradeId":"TRD-0007","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-03T09:49:00.000000000+0000","quantity":1500.0,"price":188.0,"notional":282000.0,"qty15m":4300.0,"trades15m":3},{"tradeId":"TRD-0008","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-04T09:56:00.000000000+0000","quantity":100.0,"price":189.75,"notional":18975.0,"qty15m":100.0,"trades15m":1},{"tradeId":"TRD-0009","instrumentId":"INST-AAPL","bookId":"BK-CASH-US","createdTime":"2024-06-04T09:03:00.000000000+0000","quantity":3000.0,"price":192.25,"notional":576750.0,"qty15m":3000.0,"trades15m":1},{"tradeId":"TRD-0010","instrumentId":"INST-MSFT","bookId":"BK-CASH-US","createdTime":"2024-06-04T09:10:00.000000000+0000","quantity