ice":175.0,"notional":385000.0,"ma3":175.7,"hi3":176.4,"lo3":175.0,"n3":2,"qtyAround":3700.0},{"tradeId":"TRD-0018","instrumentId":"INST-GILT30","bookId":"BK-VOL-01","createdTime":"2024-06-07T09:06:00.000000000+0000","quantity":5000000.0,"price":0.9825,"notional":4912500.0,"ma3":0.9825,"hi3":0.9825,"lo3":0.9825,"n3":1,"qtyAround":7000000.0},{"tradeId":"TRD-0019","instrumentId":"INST-GILT30","bookId":"BK-VOL-01","createdTime":"2024-06-07T09:13:00.000000000+0000","quantity":2000000.0,"price":0.98,"notional":1960000.0,"ma3":0.98125,"hi3":0.9825,"lo3":0.98,"n3":2,"qtyAround":8000000.0},{"tradeId":"TRD-0020","instrumentId":"INST-GILT30","bookId":"BK-VOL-01","createdTime":"2024-06-07T09:20:00.000000000+0000","quantity":1000000.0,"price":0.975,"notional":975000.0,"ma3":0.9791666666666666,"hi3":0.9825,"lo3":0.975,"n3":3,"qtyAround":3000000.0}]';
