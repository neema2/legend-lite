###Pure
Class demo::Person
{
  firstName: String[1];
  lastName: String[1];
  age: Integer[1];
  fullName() { $this.firstName + ' ' + $this.lastName }: String[1];
}

Class demo::Employee extends demo::Person
{
  salary: Float[1];
}

Class demo::Manager extends demo::Employee
{
  budget: Float[1];
}

Class demo::Firm
{
  legalName: String[1];
}

Association demo::Employment
{
  firm: demo::Firm[0..1];
  employees: demo::Person[*];
}

###Relational
Database demo::Db
(
  Table T_PERSON (ID INTEGER PRIMARY KEY, FIRST_NAME VARCHAR(100), LAST_NAME VARCHAR(100), AGE INTEGER, FIRM_ID INTEGER)
  Table T_EMPLOYEE (ID INTEGER PRIMARY KEY, FIRST_NAME VARCHAR(100), LAST_NAME VARCHAR(100), AGE INTEGER, SALARY DOUBLE, FIRM_ID INTEGER)
  Table T_MANAGER (ID INTEGER PRIMARY KEY, FIRST_NAME VARCHAR(100), LAST_NAME VARCHAR(100), AGE INTEGER, SALARY DOUBLE, BUDGET DOUBLE, FIRM_ID INTEGER)
  Table T_FIRM (ID INTEGER PRIMARY KEY, LEGAL_NAME VARCHAR(100))
  Join PersonFirm (T_PERSON.FIRM_ID = T_FIRM.ID)
  Join EmployeeFirm (T_EMPLOYEE.FIRM_ID = T_FIRM.ID)
  Join ManagerFirm (T_MANAGER.FIRM_ID = T_FIRM.ID)
)

###Mapping
Mapping demo::Map
(
  *demo::Person: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(p, e, m)
  }
  demo::Person[p]: Relational
  {
    ~mainTable [demo::Db] T_PERSON
    firstName: [demo::Db] T_PERSON.FIRST_NAME,
    lastName: [demo::Db] T_PERSON.LAST_NAME,
    age: [demo::Db] T_PERSON.AGE,
    firm: [demo::Db] @PersonFirm
  }
  demo::Employee[e]: Relational
  {
    ~mainTable [demo::Db] T_EMPLOYEE
    firstName: [demo::Db] T_EMPLOYEE.FIRST_NAME,
    lastName: [demo::Db] T_EMPLOYEE.LAST_NAME,
    age: [demo::Db] T_EMPLOYEE.AGE,
    salary: [demo::Db] T_EMPLOYEE.SALARY,
    firm: [demo::Db] @EmployeeFirm
  }
  demo::Manager[m]: Relational
  {
    ~mainTable [demo::Db] T_MANAGER
    firstName: [demo::Db] T_MANAGER.FIRST_NAME,
    lastName: [demo::Db] T_MANAGER.LAST_NAME,
    age: [demo::Db] T_MANAGER.AGE,
    salary: [demo::Db] T_MANAGER.SALARY,
    budget: [demo::Db] T_MANAGER.BUDGET,
    firm: [demo::Db] @ManagerFirm
  }
  demo::Firm: Relational
  {
    ~mainTable [demo::Db] T_FIRM
    legalName: [demo::Db] T_FIRM.LEGAL_NAME
  }
)

###Connection
RelationalDatabaseConnection demo::Conn
{
  type: DuckDB;
  specification: DuckDB { };
  auth: Test;
}

###Runtime
Runtime demo::Runtime
{
  mappings: [ demo::Map ];
  connections: [ demo::Db: [ environment: demo::Conn ] ];
}
