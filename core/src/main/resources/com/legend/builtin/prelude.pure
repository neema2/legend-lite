         | $expression + $direction->renderSortDirection(),
         | let resolvedDirection = $direction->defaultIfEmpty(meta::relational::metamodel::SortDirection.ASC)->toOne();
           let canonicalNullOrder = if($resolvedDirection == meta::relational::metamodel::SortDirection.DESC, | meta::relational::metamodel::NullOrder.FIRST, | meta::relational::metamodel::NullOrder.LAST);
           let resolvedNullOrder = $nullOrder->defaultIfEmpty($canonicalNullOrder)->toOne();

           if($nullOrder->isEmpty() && $this.nativeNullOrdering->eval($resolvedDirection) == $canonicalNullOrder,
              | $expression + $direction->renderSortDirection(),
              | $this.sortItemProcessor->eval($expression, $nullCheckExpression, $direction, $resolvedNullOrder)););
   }: String[1];
}

