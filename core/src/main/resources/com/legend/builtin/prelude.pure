Class meta::relational::functions::sqlQueryToString::NullOrderingSupport
{
   nativeNullOrdering: meta::pure::metamodel::function::Function<{meta::relational::metamodel::SortDirection[1] -> meta::relational::metamodel::NullOrder[1]}>[1];
   sortItemProcessor: meta::pure::metamodel::function::Function<{String[1], String[1], meta::relational::metamodel::SortDirection[0..1], meta::relational::metamodel::NullOrder[1] -> String[1]}>[1];

   processSortItem(expression:String[1], nullCheckExpression:String[1], direction:meta::relational::metamodel::SortDirection[0..1], nullOrder:meta::relational::metamodel::NullOrder[0..1], useDbNativeImplicitNullOrdering:Boolean[1])
   {
