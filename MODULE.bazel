module(name = "legend_lite", version = "1.0.0")

# THE UPSTREAM RELEASE — one number, everywhere: the source archives below AND the
# upstream jars in the artifact list. The pure release is DERIVED — the
# <legend.pure.version> the engine release's own pom declares, never chosen
# independently.
LEGEND_ENGINE_RELEASE = "4.145.0"
LEGEND_PURE_RELEASE = "5.99.0"

bazel_dep(name = "rules_java", version = "9.9.0")
# 7.x, NOT 6.10: 6.10 is broken on Bazel 9 (rules_android "CcInfo symbol has
# been removed") — docs/standard-build-audit-2026-09-22/feasibility.md Q3.
bazel_dep(name = "rules_jvm_external", version = "7.1")
# TESTONLY POOLS (Bazel workplan P1-25): third_party/rules_jvm_external_testonly_closure.patch marks every
# artifact that only testonly artifacts reach as testonly too, so a pool whose listed jars are all testonly is
# testonly as a whole and Bazel refuses any non-test rule that depends on it. Upstream issue
# bazel-contrib/rules_jvm_external#350 (open since 2020); the patch goes if a release carries a fix.
single_version_override(
    module_name = "rules_jvm_external",
    patch_strip = 1,
    patches = ["//third_party:rules_jvm_external_testonly_closure.patch"],
    version = "7.1",
)
# write_source_files: generated files that are COMMITTED (the reference-checkout
# tenet: core never builds from the upstream trees) are build outputs, written back
# by `bazel run //:update_generated` and held equal by the diff tests it makes.
bazel_dep(name = "bazel_lib", version = "3.7.2")

# THE DATACUBE APP (datacube/): TypeScript on Node. rules_js installs its npm
# packages from datacube/pnpm-lock.yaml (converted from npm's lock with
# `pnpm import`, same versions); Node is pinned here, not taken from the machine.
# 22.16: the app's tests run TypeScript directly (--experimental-strip-types).
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.16.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//datacube:pnpm-lock.yaml",
    # package.json's pnpm.onlyBuiltDependencies: NO package runs an install
    # script (every dependency ships prebuilt platform packages)
    data = ["//datacube:package.json"],
)
use_repo(npm, "npm")

# The Query app's own lock (docs/QUERY_APP_DESIGN_2026_09_30.md D6): its own repository, so
# neither app's dependency change moves the other's lock. Same pinned versions as DataCube's
# tools. Updated with: bazel run -- @pnpm//:pnpm --dir $PWD/query install --lockfile-only
npm.npm_translate_lock(
    name = "npm_query",
    pnpm_lock = "//query:pnpm-lock.yaml",
    data = ["//query:package.json"],
)
use_repo(npm, "npm_query")

# pnpm itself, pinned by rules_js: the lock file is updated through Bazel, never a machine's pnpm:
#   bazel run -- @pnpm//:pnpm --dir $PWD/datacube install --lockfile-only
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# ── THE JAR POOLS ───────────────────────────────────────────────────────────────
# One pool per OWNER, never one pool for the repository. A pool is resolved on its
# own, so nothing in one can move a version in another: the engine's BOM cannot
# touch core, and a compiler plugin cannot touch a test classpath.
#
# NEVER SHIPPED: @maven_upstream, @maven_runner and @maven_test are testonly as a
# whole (every listed jar is amended testonly below, and the testonly-closure patch
# marks whatever only they reach), so Bazel refuses any non-test RULE that depends on
# one of their jars, in any package, and .bazelrc's
# --incompatible_check_testonly_for_output_files extends that to generated files (a
# filegroup over a testonly binary's deploy jar), so nothing that ships can reach
# them through the pools' jar targets. //tools/deps:pools_list_test keeps each pool testonly as a whole.
# WHO MAY USE EACH POOL, test
# code included, is tools/deps/pools.bzl (Bazel workplan P1-25). Every pool has
# strict_visibility, so a BUILD file may name only the jars its pool LISTS below; a
# transitive jar is invisible until it is listed. Core reaches no outside jar at all
# (//tools/deps:core_closure_test). Pools may share coordinates (each
# resolves its own versions); //tools/guards:classpath_test fails on any runtime
# classpath that holds one coordinate at two versions (Bazel workplan P6-11).
#
#   @maven_core      core's JDBC drivers (the warehouse adds @maven_warehouse, the planner TeaVM's classlib)
#   @maven_warehouse DuckDB's JDBC driver, for the warehouse and the app on it
#   @maven_h2_modern H2 2.4.240, the alternative H2 one pct lane runs on
#   @maven_test      the test tooling every module's tests share
#   @maven_upstream  legend-engine / legend-pure, for the modules that referee
#                    lite against them (parser-equivalence, pct) — TEST ONLY
#   @maven_runner    legend-engine's execution stack, for tools/engine-runner only
#   @maven_tools     build tooling: compiler plugins, never on a classpath
#   @maven_teavm     the WebAssembly compiler and the class library it compiles against

# core's runtime jars: the JDBC drivers the SQL renderer targets, and nothing
# else. The planner needs none of them (java.base alone); they belong to the
# execution side, and shrink to zero when core's targets split planner | exec.
maven.install(
    name = "maven_core",
    artifacts = [
        "org.duckdb:duckdb_jdbc:1.4.4.0",
        "org.xerial:sqlite-jdbc:3.47.1.0",
        "com.h2database:h2:2.1.214",
        # the server's Postgres arm (ConnectionResolver: jdbc:postgresql://); the version the upstream
        # pool resolved before core owned it, so the repository keeps ONE Postgres driver
        "org.postgresql:postgresql:42.7.4",
    ],
    fail_if_repin_required = True,
    strict_visibility = True,
    lock_file = "//:maven_core_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)

# THE WAREHOUSE's DuckDB (docs/WAREHOUSE_W1_DESIGN_2026_09_26.md): 1.5.x, for
# chunked result fetching and host functions. Its own set, so the warehouse moves
# ahead without dragging core's 1.4.4 (core upgrades in its own leg).
maven.install(
    name = "maven_warehouse",
    artifacts = ["org.duckdb:duckdb_jdbc:1.5.5.1"],
    fail_if_repin_required = True,
    strict_visibility = True,
    lock_file = "//:maven_warehouse_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)

# THE MODERN H2, for the one lane that runs on it: pct's gate 7 (PCT relation on
# H2 2.4.240, the version the engine's own PCT H2 profile used). An ALTERNATIVE to core's
# 2.1.214, never beside it — the target that takes this one is given no other H2.
maven.install(
    name = "maven_h2_modern",
    artifacts = ["com.h2database:h2:2.4.240"],
    fail_if_repin_required = True,
    strict_visibility = True,
    lock_file = "//:maven_h2_modern_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)

# THE POSTGRES the Postgres lanes run on (tools/postgres/postgres.bzl): pinned Postgres 16 binaries, one
# repository per platform, unpacked by Bazel -- no Docker, no jar on a classpath -- and the hub
# @embedded_postgres that selects this platform's (Bazel workplan P1-15).
embedded_postgres = use_extension("//tools/postgres:extensions.bzl", "embedded_postgres")
use_repo(embedded_postgres, "embedded_postgres")

# test tooling, at legend-lite's own versions (root pom <junit.version>). JUnit's
# BOM keeps the Jupiter and Platform jars in step. tools/junit/JUnitMain drives the
# Platform Launcher itself (Bazel workplan P1-01): the launcher, the legacy XML
# reporter and the engines the console launcher's fat jar bundled (Jupiter, Vintage,
# Suite). The Vintage engine's JUnit 4 is excluded: the targets that run JUnit 3/4
# tests (pct, //tools/junit:runner_test) take the upstream pool's, and
# JUnitMain leaves the engine out where no JUnit 4 is on the classpath. One copy: the
# fat jar bundled a second (4.13.2) beside the upstream 4.13.1.
_TEST_ARTIFACTS = [
    "org.junit.jupiter:junit-jupiter:5.11.3",
    "org.junit.platform:junit-platform-launcher:1.11.3",
    "org.junit.platform:junit-platform-reporting:1.11.3",
    "org.junit.platform:junit-platform-suite-engine:1.11.3",
    "org.junit.vintage:junit-vintage-engine:5.11.3",
    "com.tngtech.archunit:archunit-junit5:1.3.0",

    # USED DIRECTLY by BUILD files, so declared: strict_visibility (Bazel workplan P1-25) makes an
    # undeclared transitive artifact invisible.
    "com.tngtech.archunit:archunit:1.3.0",
    "org.junit.jupiter:junit-jupiter-api:5.11.3",
    "org.junit.jupiter:junit-jupiter-engine:5.11.3",
    "org.junit.jupiter:junit-jupiter-params:5.11.3",
    "org.junit.platform:junit-platform-engine:1.11.3",
]

maven.install(
    name = "maven_test",
    artifacts = _TEST_ARTIFACTS,
    boms = ["org.junit:junit-bom:5.11.3"],
    excluded_artifacts = [
        "junit:junit",
        "org.hamcrest:hamcrest-core",
    ],
    resolver = "maven",
    fail_if_repin_required = True,
    strict_visibility = True,
    lock_file = "//:maven_test_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
# TEST ONLY: every jar this pool lists is testonly, and with the testonly-closure patch (above) so is every
# jar only they reach, which is the whole pool: Bazel refuses any non-test target that depends on one, or on a
# file generated from one (.bazelrc: --incompatible_check_testonly_for_output_files) (test tooling never ships).
[maven.amend_artifact(
    name = "maven_test",
    coordinates = coordinates,
    testonly = "true",
) for coordinates in _TEST_ARTIFACTS]


