module(name = "legend_lite", version = "1.0.0")

# THE UPSTREAM RELEASE — one number, everywhere: the source archives below AND the
# upstream jars in the artifact list. The pure release is DERIVED — the
# <legend.pure.version> the engine release's own pom declares, never chosen
# independently.
LEGEND_ENGINE_RELEASE = "4.145.0"
LEGEND_PURE_RELEASE = "5.99.0"

bazel_dep(name = "rules_java", version = "9.9.0")
# 7.x, NOT 6.10: 6.10 is broken on Bazel 9 (rules_android "CcInfo symbol has
# been removed") — docs/standard-build-audit-2026-09-22/feasibility.md Q3.
bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        # core's three production dependencies — the JDBC drivers the SQL
        # renderer targets. Versions are the root pom's.
        "org.duckdb:duckdb_jdbc:1.4.4.0",
        "org.xerial:sqlite-jdbc:3.47.1.0",
        "com.h2database:h2:2.1.214",
        # build tooling only — never on the runtime classpath
        "com.google.errorprone:error_prone_core:2.50.0",
        "com.uber.nullaway:nullaway:0.13.8",
        "org.jspecify:jspecify:1.0.0",
        # test tooling — the versions core/pom.xml and the root pom manage
        "org.junit.jupiter:junit-jupiter:5.11.3",
        "org.junit.platform:junit-platform-console-standalone:1.11.3",
        "com.tngtech.archunit:archunit-junit5:1.3.0",
        "junit:junit:4.13.1",

        # parser-equivalence: the reference parser and EVERY section grammar the
        # engine ships (parser-equivalence/pom.xml says why all of them), test only
        "org.finos.legend.engine:legend-engine-language-pure-grammar:" + LEGEND_ENGINE_RELEASE,
        "org.finos.legend.engine:legend-engine-xt-relationalStore-grammar:" + LEGEND_ENGINE_RELEASE,
        "org.finos.legend.engine:legend-engine-xt-diagram-grammar:" + LEGEND_ENGINE_RELEASE,
        "org.finos.legend.engine:legend-engine-extensions-collection-generation:" + LEGEND_ENGINE_RELEASE,
        "org.finos.legend.engine:legend-engine-xt-relationalStore-duckdb-grammar:" + LEGEND_ENGINE_RELEASE,
        "org.finos.legend.engine:legend-engine-xt-relationalStore-athena-grammar:" + LEGEND_ENGINE_RELEASE,
        "org.finos.legend.engine:legend-engine-xt-relationalStore-oracle-grammar:" + LEGEND_ENGINE_RELEASE,
        "org.finos.legend.engine:legend-engine-xt-relationalStore-aurora-grammar:" + LEGEND_ENGINE_RELEASE,
        "org.finos.legend.engine:legend-engine-xt-relationalStore-memsql-grammar:" + LEGEND_ENGINE_RELEASE,
        "org.finos.legend.pure:legend-pure-m3-core:" + LEGEND_PURE_RELEASE,

        # INV-5: the third-party versions the ENGINE release's own root pom manages
        # (root pom.xml dependencyManagement says why) — listed so `pinned` holds them
        "com.zaxxer:HikariCP:7.0.2",
        "org.apache.commons:commons-lang3:3.18.0",
        "org.apache.httpcomponents:httpcore:4.4.13",
    ],
    # ONE version of every artifact, for every package: what the root pom's
    # dependencyManagement and tools/classpath-convergence.sh police by hand, held
    # here by construction. Explicitly listed versions win.
    version_conflict_policy = "pinned",
    fail_if_repin_required = False,
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven", "unpinned_maven")

# ── THE UPSTREAM SOURCES ────────────────────────────────────────────────────────
# legend-engine / legend-pure at ONE release, pinned by content. Tests read these
# trees as the spec (see third_party/legend_*_src.BUILD). Measured 2026-09-22:
# 18.4 MB and 2.4 MB, 2.4 s and 0.7 s to fetch — once; Bazel caches them. The pure
# release is DERIVED: the <legend.pure.version> the engine release's own pom
# declares (it was never chosen independently; see tools/oracle-pins.env).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "legend_engine_src",
    build_file = "//third_party:legend_engine_src.BUILD",
    sha256 = "cf1c2524106c1cde0f98da7af23b943ddadf57e663945f6eb347d469e8e6d361",
    strip_prefix = "legend-engine-legend-engine-" + LEGEND_ENGINE_RELEASE,
    urls = ["https://github.com/finos/legend-engine/archive/refs/tags/legend-engine-" + LEGEND_ENGINE_RELEASE + ".tar.gz"],
)

http_archive(
    name = "legend_pure_src",
    build_file = "//third_party:legend_pure_src.BUILD",
    sha256 = "f216faaa4d414c55b2e9fb92cd25fcd8d934656775ea30d00a865e9cfdf26e8a",
    strip_prefix = "legend-pure-legend-pure-" + LEGEND_PURE_RELEASE,
    urls = ["https://github.com/finos/legend-pure/archive/refs/tags/legend-pure-" + LEGEND_PURE_RELEASE + ".tar.gz"],
)
