module(name = "legend_lite", version = "1.0.0")

# THE UPSTREAM RELEASE, and everything keyed on it: release.MODULE.bazel (//tools/bump rewrites its pins)
include("//:release.MODULE.bazel")

bazel_dep(name = "rules_java", version = "9.9.0")
# 7.x, NOT 6.10: 6.10 is broken on Bazel 9 (rules_android "CcInfo symbol has
# been removed") — docs/standard-build-audit-2026-09-22/feasibility.md Q3.
bazel_dep(name = "rules_jvm_external", version = "7.1")
# TESTONLY POOLS (Bazel workplan P1-25): third_party/rules_jvm_external_testonly_closure.patch marks every
# artifact that only testonly artifacts reach as testonly too, so a pool whose listed jars are all testonly is
# testonly as a whole and Bazel refuses any non-test rule that depends on it. Upstream issue
# bazel-contrib/rules_jvm_external#350 (open since 2020); the patch goes if a release carries a fix.
single_version_override(
    module_name = "rules_jvm_external",
    patch_strip = 1,
    patches = ["//third_party:rules_jvm_external_testonly_closure.patch"],
    version = "7.1",
)
# write_source_files: generated files that are COMMITTED (the reference-checkout
# tenet: core never builds from the upstream trees) are build outputs, written back
# by `bazel run //:update_generated` and held equal by the diff tests it makes.
bazel_dep(name = "bazel_lib", version = "3.7.2")

# THE DATACUBE APP (datacube/): TypeScript on Node. rules_js installs its npm
# packages from datacube/pnpm-lock.yaml (converted from npm's lock with
# `pnpm import`, same versions); Node is pinned here, not taken from the machine.
# 22.16: the app's tests run TypeScript directly (--experimental-strip-types).
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.16.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//datacube:pnpm-lock.yaml",
    # package.json's pnpm.onlyBuiltDependencies: NO package runs an install
    # script (every dependency ships prebuilt platform packages)
    data = ["//datacube:package.json"],
)
use_repo(npm, "npm")

# The Query app's own lock (docs/QUERY_APP_DESIGN_2026_09_30.md D6): its own repository, so
# neither app's dependency change moves the other's lock. Same pinned versions as DataCube's
# tools. Updated with: bazel run -- @pnpm//:pnpm --dir $PWD/query install --lockfile-only
npm.npm_translate_lock(
    name = "npm_query",
    pnpm_lock = "//query:pnpm-lock.yaml",
    data = ["//query:package.json"],
)
use_repo(npm, "npm_query")

# The Studio app's own lock (docs/STUDIO_DESIGN_2026_10_02.md S2, S3): Monaco plus Query's tools at
# Query's versions. Updated with: bazel run -- @pnpm//:pnpm --dir $PWD/studio install --lockfile-only
npm.npm_translate_lock(
    name = "npm_studio",
    pnpm_lock = "//studio:pnpm-lock.yaml",
    data = ["//studio:package.json"],
)
use_repo(npm, "npm_studio")

# The engine client's own lock (engine-client/: where a query runs, shared by DataCube, Query and Studio):
# Apache Arrow, at DataCube's version. Updated with:
#   bazel run -- @pnpm//:pnpm --dir $PWD/engine-client install --lockfile-only
npm.npm_translate_lock(
    name = "npm_engine_client",
    pnpm_lock = "//engine-client:pnpm-lock.yaml",
    data = ["//engine-client:package.json"],
)
use_repo(npm, "npm_engine_client")

# pnpm itself, pinned by rules_js: the lock file is updated through Bazel, never a machine's pnpm:
#   bazel run -- @pnpm//:pnpm --dir $PWD/datacube install --lockfile-only
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# ── THE JAR POOLS ───────────────────────────────────────────────────────────────
# One pool per OWNER, never one pool for the repository. A pool is resolved on its
# own, so nothing in one can move a version in another: the engine's BOM cannot
# touch core, and a compiler plugin cannot touch a test classpath.
#
# NEVER SHIPPED: @maven_upstream, @maven_runner and @maven_test are testonly as a
# whole (every listed jar is amended testonly below, and the testonly-closure patch
# marks whatever only they reach), so Bazel refuses any non-test RULE that depends on
# one of their jars, in any package, and .bazelrc's
# --incompatible_check_testonly_for_output_files extends that to generated files (a
# filegroup over a testonly binary's deploy jar), so nothing that ships can reach
# them through the pools' jar targets. //tools/deps:pools_list_test keeps each pool testonly as a whole.
# WHO MAY USE EACH POOL, test
# code included, is tools/deps/pools.bzl (Bazel workplan P1-25). Every pool has
# strict_visibility, so a BUILD file may name only the jars its pool LISTS below; a
# transitive jar is invisible until it is listed. Core reaches no outside jar at all
# (//tools/deps:core_closure_test). Pools may share coordinates (each
# resolves its own versions); //tools/guards:classpath_test fails on any runtime
# classpath that holds one coordinate at two versions (Bazel workplan P6-11).
#
#   @maven_test      the test tooling every module's tests share
#   @maven_upstream  legend-engine / legend-pure, for the modules that referee
#                    lite against them (parser-equivalence, pct) — TEST ONLY
#   @maven_runner    legend-engine's execution stack, for tools/engine-runner only
#   @maven_tools     build tooling: compiler plugins, never on a classpath
#   @maven_teavm     the WebAssembly compiler and the class library it compiles against

# THE PRODUCT'S JARS (core's JDBC drivers, the warehouse's DuckDB, PCT's modern H2): leaf jars, so rules_java's
# http_jar fetches each, pinned by sha256, with no Maven resolution (tools/deps/jars_table.bzl, the one table;
# docs/BUILD_REBUILD_DESIGN_2026_10_05.md, section 5b).
product_jars = use_extension("//tools/deps:jars.bzl", "product_jars")
use_repo(product_jars, "duckdb_jdbc", "duckdb_jdbc_warehouse", "h2", "h2_modern", "postgresql", "sqlite_jdbc")

# THE POSTGRES the Postgres lanes run on (tools/postgres/postgres.bzl): pinned Postgres 16 binaries, one
# repository per platform, unpacked by Bazel -- no Docker, no jar on a classpath -- and the hub
# @embedded_postgres that selects this platform's (Bazel workplan P1-15).
embedded_postgres = use_extension("//tools/postgres:extensions.bzl", "embedded_postgres")
use_repo(embedded_postgres, "embedded_postgres")

# test tooling, at legend-lite's own versions (root pom <junit.version>). JUnit's
# BOM keeps the Jupiter and Platform jars in step. tools/junit/JUnitMain drives the
# Platform Launcher itself (Bazel workplan P1-01): the launcher, the legacy XML
# reporter and the engines the console launcher's fat jar bundled (Jupiter, Vintage,
# Suite). The Vintage engine's JUnit 4 is excluded: the targets that run JUnit 3/4
# tests (pct, //tools/junit:runner_test) take the upstream pool's, and
# JUnitMain leaves the engine out where no JUnit 4 is on the classpath. One copy: the
# fat jar bundled a second (4.13.2) beside the upstream 4.13.1.
_TEST_ARTIFACTS = [
    "org.junit.jupiter:junit-jupiter:5.11.3",
    "org.junit.platform:junit-platform-launcher:1.11.3",
    "org.junit.platform:junit-platform-reporting:1.11.3",
    "org.junit.platform:junit-platform-suite-engine:1.11.3",
    "org.junit.vintage:junit-vintage-engine:5.11.3",
    "com.tngtech.archunit:archunit-junit5:1.3.0",
    # sdlc-server's judge of the git repository it writes by hand (Git.java): read back by JGit, at the version
    # legend-sdlc's own file-system backend uses (legend-sdlc-server-fs/pom.xml), never the machine's git
    # (2026-10-04, the Studio line; the Bazel program session's ruling: no host programs in tests)
    "org.eclipse.jgit:org.eclipse.jgit:6.3.0.202209071007-r",
    # held at the version the pool had before JGit (ArchUnit's): JGit 6.3 asks for 1.7.30, and the resolver's
    # nearest-wins would otherwise move the whole pool down to it (slf4j 2's API serves a 1.7 caller)
    "org.slf4j:slf4j-api:2.0.12",

    # USED DIRECTLY by BUILD files, so declared: strict_visibility (Bazel workplan P1-25) makes an
    # undeclared transitive artifact invisible.
    "com.tngtech.archunit:archunit:1.3.0",
    "org.junit.jupiter:junit-jupiter-api:5.11.3",
    "org.junit.jupiter:junit-jupiter-engine:5.11.3",
    "org.junit.jupiter:junit-jupiter-params:5.11.3",
    "org.junit.platform:junit-platform-engine:1.11.3",
]

maven.install(
    name = "maven_test",
    artifacts = _TEST_ARTIFACTS,
    boms = ["org.junit:junit-bom:5.11.3"],
    excluded_artifacts = [
        "junit:junit",
        "org.hamcrest:hamcrest-core",
    ],
    resolver = "maven",
    fail_if_repin_required = True,
    strict_visibility = True,
    lock_file = "//:maven_test_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
# TEST ONLY: every jar this pool lists is testonly, and with the testonly-closure patch (above) so is every
# jar only they reach, which is the whole pool: Bazel refuses any non-test target that depends on one, or on a
# file generated from one (.bazelrc: --incompatible_check_testonly_for_output_files) (test tooling never ships).
[maven.amend_artifact(
    name = "maven_test",
    coordinates = coordinates,
    testonly = "true",
) for coordinates in _TEST_ARTIFACTS]


# BUILD TOOLING: a compiler plugin's own dependencies (NullAway brings the Checker
# Framework's dataflow and guava) must never move a version on a classpath that
# runs. Error Prone itself is the one bundled with Bazel's Java toolchain; NullAway
# runs inside it as a plugin (core/BUILD.bazel).
maven.install(
    name = "maven_tools",
    artifacts = ["com.uber.nullaway:nullaway:0.13.8"],
    fail_if_repin_required = True,
    strict_visibility = True,
    lock_file = "//:maven_tools_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
# THE WASM COMPILER (//wasm): TeaVM, which compiles the planner ahead of time to a
# WebAssembly-GC module, and the class library it compiles AGAINST (classlib, jso).
# Build tooling like @maven_tools: its jars run inside a build action or sit on the
# boundary class's compile-time path (neverlink); none reaches a running classpath.
maven.install(
    name = "maven_teavm",
    artifacts = [
        "org.teavm:teavm-tooling:0.15.0",
        "org.teavm:teavm-classlib:0.15.0",
        "org.teavm:teavm-jso:0.15.0",

        # USED DIRECTLY by BUILD files, so declared: strict_visibility (Bazel workplan P1-25) makes an
        # undeclared transitive artifact invisible.
        "org.teavm:teavm-core:0.15.0",
    ],
    fail_if_repin_required = True,
    strict_visibility = True,
    lock_file = "//:maven_teavm_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven_teavm", "maven_test", "maven_tools")

# THE WAREHOUSE AS A NATIVE IMAGE (docs/WAREHOUSE_W1_DESIGN_2026_09_26.md, W1e): GraalVM's
# native-image run by Bazel over the server's own runtime class path, as //tools/teavm runs
# TeaVM -- never a script picking jars by hand (the 2026-09-26 break: a hand-listed //core jar
# went empty when core split, and the image shipped without core). rules_graalvm 0.12.0 carries
# GraalVM for JDK 25 and the Bazel 9 CcInfo fix; the registry stops at 0.11.1, so it is pinned
# here by its release archive's digest. GraalVM itself is fetched by Bazel. Only its
# native-image toolchain is registered: the repository's Java runtime stays rules_java's.
bazel_dep(name = "rules_graalvm", version = "0.12.0")
# The OS and CPU constraints the native targets select on. 1.1.0: what hermetic_launcher requires.
bazel_dep(name = "platforms", version = "1.1.0")
archive_override(
    module_name = "rules_graalvm",
    integrity = "sha256-2IktQqVOV09uZKsQztwY3rvJpeRjxWE4Stf1FxH/gCI=",
    # Two changes (third_party/rules_graalvm_sysroot.patch): a hermetic C toolchain's sysroot reaches
    # native-image (Bazel workplan P1-09, through //tools/graalvm:sysroot_native_image, no shell; P1-12
    # takes it upstream); and a Mac with Apple's Command Line Tools and no Xcode.app runs native-image
    # directly, since the rule's macOS path needs an Xcode Bazel knows.
    patch_strip = 1,
    patches = ["//third_party:rules_graalvm_sysroot.patch"],
    strip_prefix = "rules_graalvm-0.12.0",
    urls = ["https://github.com/sgammon/rules_graalvm/releases/download/v0.12.0/rules_graalvm-0.12.0.tar.gz"],
)

gvm = use_extension("@rules_graalvm//:extensions.bzl", "graalvm")
gvm.graalvm(
    name = "graalvm",
    distribution = "ce",
    java_version = "25",
    version = "25.0.2",
)
use_repo(gvm, "graalvm", "graalvm_toolchains")

register_toolchains("@graalvm_toolchains//:toolchain_gvm")

# THE HOST C TOOLCHAIN, macOS and Windows (Bazel workplan P1-10, P1-11; D1 revised, D5): Apple's Command Line
# Tools and Visual Studio's MSVC stay prerequisites of the machine, checked when a native target first needs
# one, failing with what to install. Linux needs none (the hermetic LLVM below).
host_c_toolchain = use_repo_rule("//tools/cc:host_cc.bzl", "host_c_toolchain")

host_c_toolchain(name = "host_cc")

# THE C TOOLCHAIN, LINUX (Bazel workplan P1-09; spike S3): native-image links with a HERMETIC C toolchain -- LLVM's own
# clang and lld from toolchains_llvm, against Chromium's published Debian bullseye sysroots that Bazel
# fetches, and zlib built from source. Nothing from the host's compiler, libc headers or zlib headers
# reaches the link (third_party/rules_graalvm_sysroot.patch). macOS keeps the Command Line Tools and
# Windows MSVC (D1 revised, D5), declared and checked by @host_cc (above).
bazel_dep(name = "toolchains_llvm", version = "1.11.0")
bazel_dep(name = "zlib", version = "1.3.2.bcr.2")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
# D7 (2026-10-04): LLVM's prebuilt ld.lld links libxml2.so.2, the one host library this toolchain needs on
# Linux. A recorded exception until P1-09's final form (D7 (b): an LLVM build without it), owed with P5-02's
# pinned CI image; CI's Linux lanes make sure it is there (gates-run.yml).
llvm.toolchain(llvm_version = "20.1.8")
llvm.sysroot(
    label = "@linux_sysroot_arm64//:sysroot",
    targets = ["linux-aarch64"],
)
llvm.sysroot(
    label = "@linux_sysroot_amd64//:sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")

# Registered for Linux only, in .bazelrc (common:linux --extra_toolchains): on a Windows host toolchains_llvm
# generates @llvm_toolchain empty, and a register_toolchains here would name targets that do not exist there.

sysroot_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# What a sysroot declares: headers and libraries. x86_64 alone has lib64/, where glibc's libc.so linker script
# names the dynamic loader (/lib64/ld-linux-x86-64.so.2); arm64's loader is under lib/, and an empty glob fails.
_SYSROOT_GLOB = '["usr/include/**", "usr/lib/**", "lib/**"%s], exclude = ["lib/systemd/**", "usr/lib/systemd/**"]'

_SYSROOT_BUILD_ARM64 = 'filegroup(name = "sysroot", srcs = glob(' + (_SYSROOT_GLOB % "") + '), visibility = ["//visibility:public"])'

_SYSROOT_BUILD_AMD64 = 'filegroup(name = "sysroot", srcs = glob(' + (_SYSROOT_GLOB % ', "lib64/**"') + '), visibility = ["//visibility:public"])'

sysroot_archive(
    name = "linux_sysroot_arm64",
    build_file_content = _SYSROOT_BUILD_ARM64,
    integrity = "sha256-xxdqTHqsv0a9pYoCnzn3mmgAjT3uZRjxVNz1FhpUhtg=",
    type = "tar.xz",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/c7176a4c7aacbf46bda58a029f39f79a68008d3dee6518f154dcf5161a5486d8"],
)

sysroot_archive(
    name = "linux_sysroot_amd64",
    build_file_content = _SYSROOT_BUILD_AMD64,
    integrity = "sha256-UtYdREb/6/qj3aLNAtpKtIdv8jeFP0bSc+f5tmZlLh0=",
    type = "tar.xz",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d"],
)


# `bazel run`'s launcher for the native warehouse on Windows (warehouse/defs.bzl, warehouse_run;
# docs/WINDOWS_APP_DESIGN_2026_10_02.md): a native stub with the server's arguments baked in, which
# starts the server with the caller's arguments intact -- where a .bat and Bazel's bash launcher
# split a Postgres URL at '&'. Released stubs: no Rust toolchain.
bazel_dep(name = "hermetic_launcher", version = "0.0.16")

# ── THE REPOSITORY INVENTORY ─────────────────────────────────────────────────────
# Every file and package of this repository, for the guards (tools/guards; Bazel workplan P6-00).
repo_inventory = use_repo_rule("//tools/guards:inventory.bzl", "repo_inventory")

repo_inventory(name = "repo_inventory")

# Pinned downloads (the upstream sources are release.MODULE.bazel's).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# react-icons at the version legend-studio pins (packages/legend-art/package.json), pinned by the npm
# registry's own sha512: the SVG paths query/src/ui/icons.ts is generated from (//query:icons_gen).
http_archive(
    name = "react_icons",
    build_file_content = 'exports_files(glob(["*/index.mjs"]))',
    integrity = "sha512-MEFcXdkP3dLo8uumGI5xN3lDFNsRtrjbOEKDLD7yv76v4wpnEq2Lt2qeHaQOr34I/wPN3s3+N08WkQ+CW37Xiw==",
    strip_prefix = "package",
    urls = ["https://registry.npmjs.org/react-icons/-/react-icons-5.5.0.tgz"],
)

# Upstream Legend's type (legend-art _fonts.scss): Roboto, Roboto Mono and Raleway, at the @fontsource version the
# apps used to take from npm (5.3.0), each pinned by the registry's own sha512. //legend-art:fonts serves the files
# the apps use (OFL-1.1, the LICENSE beside them); no font is checked in.
[http_archive(
    name = "fontsource_" + family.replace("-", "_"),
    build_file_content = 'exports_files(glob(["files/*.woff2"]) + ["LICENSE"])',
    integrity = integrity,
    strip_prefix = "package",
    urls = ["https://registry.npmjs.org/@fontsource/%s/-/%s-5.3.0.tgz" % (family, family)],
) for family, integrity in [
    ("raleway", "sha512-BTWr1I14Ji0DWpS/KCIq/CXcvxXWgMO73gynWpbYv7A5wlPhLevozgRmdPJvZmUf0fhH+Lju+F4nigJ6Ums24A=="),
    ("roboto", "sha512-BapRJOWYP+LZ21zp+wBQjfpPYKRoxc4LspJ/RLuI+HSMBD5u/X4O+ESDrSvEqDSy0rAl7GwBJ+09mdc16cVQ1Q=="),
    ("roboto-mono", "sha512-yhwplHMHW9dCk+1pZuERfcJe+K3rosGVZEoK0XktkxRSqQ9qsipSwwiuW2/8Qmtp9lzu3Ixa/ie4BMH3i8CkZQ=="),
]]

# DuckDB's postgres extension for the warehouse's DuckDB (1.5.5; it must match the library's version
# exactly), one per platform, pinned by content. `bazel run //warehouse:serve` puts it beside the server.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

[http_file(
    name = "duckdb_postgres_extension_" + platform,
    integrity = sha,
    urls = ["https://extensions.duckdb.org/v1.5.5/" + platform + "/postgres_scanner.duckdb_extension.gz"],
) for platform, sha in {
    "osx_arm64": "sha256-T7UHnmewDmZD5u6RVFo1UBAATR2tULQ/HAYN4Mt4nI4=",
    "osx_amd64": "sha256-uHZO1Ja+Y1+6w+Xmpsjj48Lb/KqGLOBCLCHK1vzGw1M=",
    "linux_amd64": "sha256-4PYxpVNfFlRovIogUB+LwUkK28h304/N/y+NBVMeHls=",
    "linux_arm64": "sha256-WYSeikvgD6DsjE2w0mcHmZBh0QO5Ar8yMi+lzeH8OT0=",
    "windows_amd64": "sha256-ZbMfACxwrF+BLSk7hVK5d9HA5nUtChEnF2RUyBhO0AE=",
}.items()]

# THE BROWSER the harnesses drive (Bazel workplan P1-14, spike S4): Playwright 1.63.0's
# chromium-headless-shell, revision 1243 = Chrome for Testing 153.0.8010.12 (the locked playwright-core's
# browsers.json; //tools/browser:revision_test holds them equal). One archive per platform, fetched by
# Bazel (tools/browser/extensions.bzl): nothing installed, nothing in $HOME.
chromium = use_extension("//tools/browser:extensions.bzl", "chromium")
chromium.pin(
    revision = "1243",
    integrity = {
        "linux-arm64": "sha256-1DPEUXLHg244Ek/lRfdnsCIQv7Q6YmLwiil0c6jpHJk=",
        "linux64": "sha256-qdoCiGGgz3if8lwv7UX18ar5ae2SR4NbanghpPevnR0=",
        "mac-arm64": "sha256-idgKbSbM0Mz9UeItnhKXKDhirysM2R3OB0WbNcoAWfI=",
        "mac-x64": "sha256-XC6qGq1iERu1pw3QiJ3TCT8xQid7j3iVeiOCV+6F8Ak=",
        "win64": "sha256-euyHLzCQ5jnEI3RnYk6oY8IP4oeJFMk6ZVa9u1KqbEw=",
    },
    version = "153.0.8010.12",
)
use_repo(
    chromium,
    "chromium_headless_shell_linux64",
    "chromium_headless_shell_linux_arm64",
    "chromium_headless_shell_mac_arm64",
    "chromium_headless_shell_mac_x64",
    "chromium_headless_shell_win64",
    "chromium_pin",
)

# PYTHON (Bazel workplan P1-07; decision D12: 3.12): one hermetic interpreter, never the machine's python3
# (binaries start from a bash stub: .bazelrc bootstrap_impl),
# and one locked pip hub. The lock changes only by `bazel run //tools/python:requirements.update`, and
# //tools/python:lock_matches_requirements checks it offline.
bazel_dep(name = "rules_python", version = "2.3.4")

# no implicit __init__.py: a module is a package only when it says so
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//tools/python:requirements_lock.txt",
)
use_repo(pip, "pypi")
