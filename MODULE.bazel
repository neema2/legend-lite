# BUILD TOOLING: a compiler plugin's own dependencies (NullAway brings the Checker
# Framework's dataflow and guava) must never move a version on a classpath that
# runs. Error Prone itself is the one bundled with Bazel's Java toolchain; NullAway
# runs inside it as a plugin (core/BUILD.bazel).
maven.install(
    name = "maven_tools",
    artifacts = ["com.uber.nullaway:nullaway:0.13.8"],
    fail_if_repin_required = True,
    strict_visibility = True,
    lock_file = "//:maven_tools_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
# THE WASM COMPILER (//wasm): TeaVM, which compiles the planner ahead of time to a
# WebAssembly-GC module, and the class library it compiles AGAINST (classlib, jso).
# Build tooling like @maven_tools: its jars run inside a build action or sit on the
# boundary class's compile-time path (neverlink); none reaches a running classpath.
maven.install(
    name = "maven_teavm",
    artifacts = [
        "org.teavm:teavm-tooling:0.15.0",
        "org.teavm:teavm-classlib:0.15.0",
        "org.teavm:teavm-jso:0.15.0",

        # USED DIRECTLY by BUILD files, so declared: strict_visibility (Bazel workplan P1-25) makes an
        # undeclared transitive artifact invisible.
        "org.teavm:teavm-core:0.15.0",
    ],
    fail_if_repin_required = True,
    strict_visibility = True,
    lock_file = "//:maven_teavm_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven_core", "maven_h2_modern", "maven_warehouse", "maven_runner", "maven_teavm", "maven_test", "maven_tools", "maven_upstream")

# THE WAREHOUSE AS A NATIVE IMAGE (docs/WAREHOUSE_W1_DESIGN_2026_09_26.md, W1e): GraalVM's
# native-image run by Bazel over the server's own runtime class path, as //tools/teavm runs
# TeaVM -- never a script picking jars by hand (the 2026-09-26 break: a hand-listed //core jar
# went empty when core split, and the image shipped without core). rules_graalvm 0.12.0 carries
# GraalVM for JDK 25 and the Bazel 9 CcInfo fix; the registry stops at 0.11.1, so it is pinned
# here by its release archive's digest. GraalVM itself is fetched by Bazel. Only its
# native-image toolchain is registered: the repository's Java runtime stays rules_java's.
bazel_dep(name = "rules_graalvm", version = "0.12.0")
# The OS and CPU constraints the native targets select on. 1.1.0: what hermetic_launcher requires.
bazel_dep(name = "platforms", version = "1.1.0")
archive_override(
    module_name = "rules_graalvm",
    integrity = "sha256-2IktQqVOV09uZKsQztwY3rvJpeRjxWE4Stf1FxH/gCI=",
    # Two changes (third_party/rules_graalvm_sysroot.patch): a hermetic C toolchain's sysroot reaches
    # native-image (Bazel workplan P1-09, through //tools/graalvm:sysroot_native_image, no shell; P1-12
    # takes it upstream); and a Mac with Apple's Command Line Tools and no Xcode.app runs native-image
    # directly, since the rule's macOS path needs an Xcode Bazel knows.
    patch_strip = 1,
    patches = ["//third_party:rules_graalvm_sysroot.patch"],
    strip_prefix = "rules_graalvm-0.12.0",
    urls = ["https://github.com/sgammon/rules_graalvm/releases/download/v0.12.0/rules_graalvm-0.12.0.tar.gz"],
)

gvm = use_extension("@rules_graalvm//:extensions.bzl", "graalvm")
gvm.graalvm(
    name = "graalvm",
    distribution = "ce",
    java_version = "25",
    version = "25.0.2",
)
use_repo(gvm, "graalvm", "graalvm_toolchains")

register_toolchains("@graalvm_toolchains//:toolchain_gvm")

# THE HOST C TOOLCHAIN, macOS and Windows (Bazel workplan P1-10, P1-11; D1 revised, D5): Apple's Command Line
# Tools and Visual Studio's MSVC stay prerequisites of the machine, checked when a native target first needs
# one, failing with what to install. Linux needs none (the hermetic LLVM below).
host_c_toolchain = use_repo_rule("//tools/cc:host_cc.bzl", "host_c_toolchain")

host_c_toolchain(name = "host_cc")

# THE C TOOLCHAIN, LINUX (Bazel workplan P1-09; spike S3): native-image links with a HERMETIC C toolchain -- LLVM's own
# clang and lld from toolchains_llvm, against Chromium's published Debian bullseye sysroots that Bazel
# fetches, and zlib built from source. Nothing from the host's compiler, libc headers or zlib headers
# reaches the link (third_party/rules_graalvm_sysroot.patch). macOS keeps the Command Line Tools and
# Windows MSVC (D1 revised, D5), declared and checked by @host_cc (above).
bazel_dep(name = "toolchains_llvm", version = "1.11.0")
bazel_dep(name = "zlib", version = "1.3.2.bcr.2")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
# D7 (2026-10-04): LLVM's prebuilt ld.lld links libxml2.so.2, the one host library this toolchain needs on
# Linux. A recorded exception until P1-09's final form (D7 (b): an LLVM build without it), owed with P5-02's
# pinned CI image; CI's Linux lanes make sure it is there (gates-run.yml).
llvm.toolchain(llvm_version = "20.1.8")
llvm.sysroot(
    label = "@linux_sysroot_arm64//:sysroot",
    targets = ["linux-aarch64"],
)
llvm.sysroot(
    label = "@linux_sysroot_amd64//:sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")

# Registered for Linux only, in .bazelrc (common:linux --extra_toolchains): on a Windows host toolchains_llvm
# generates @llvm_toolchain empty, and a register_toolchains here would name targets that do not exist there.

sysroot_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# What a sysroot declares: headers and libraries. x86_64 alone has lib64/, where glibc's libc.so linker script
# names the dynamic loader (/lib64/ld-linux-x86-64.so.2); arm64's loader is under lib/, and an empty glob fails.
_SYSROOT_GLOB = '["usr/include/**", "usr/lib/**", "lib/**"%s], exclude = ["lib/systemd/**", "usr/lib/systemd/**"]'

_SYSROOT_BUILD_ARM64 = 'filegroup(name = "sysroot", srcs = glob(' + (_SYSROOT_GLOB % "") + '), visibility = ["//visibility:public"])'

_SYSROOT_BUILD_AMD64 = 'filegroup(name = "sysroot", srcs = glob(' + (_SYSROOT_GLOB % ', "lib64/**"') + '), visibility = ["//visibility:public"])'

sysroot_archive(
    name = "linux_sysroot_arm64",
    build_file_content = _SYSROOT_BUILD_ARM64,
    integrity = "sha256-xxdqTHqsv0a9pYoCnzn3mmgAjT3uZRjxVNz1FhpUhtg=",
    type = "tar.xz",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/c7176a4c7aacbf46bda58a029f39f79a68008d3dee6518f154dcf5161a5486d8"],
)

sysroot_archive(
    name = "linux_sysroot_amd64",
    build_file_content = _SYSROOT_BUILD_AMD64,
    integrity = "sha256-UtYdREb/6/qj3aLNAtpKtIdv8jeFP0bSc+f5tmZlLh0=",
    type = "tar.xz",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d"],
)


# `bazel run`'s launcher for the native warehouse on Windows (warehouse/defs.bzl, warehouse_run;
