# legend-lite's strict JSON codec (com.legend.json.Json): RFC 8259 parser to a Node tree, a
# streaming writer, and THE JSON escape table. java.base and the null annotations only. Used by
# core's server shell and protocol emitter, and by the warehouse, which needs nothing else of
# core. Lived in core's server package until 2026-09-26.

load("//tools/junit:defs.bzl", "junit_test")
load("//tools/java:defs.bzl", "legend_java_library")

package(default_visibility = ["//visibility:public"])

legend_java_library(
    name = "json",
    srcs = glob(["src/main/java/com/legend/json/*.java"]),
    deps = ["//base"],
    visibility = ["//core:__pkg__", "//datacube:__pkg__", "//depot-server:__pkg__", "//sdlc-server:__pkg__", "//warehouse:__pkg__", "//wasm:__pkg__"],
)

junit_test(
    name = "tests",
    memory_mb = 768,
    size = "small",
    srcs = glob(["src/test/java/com/legend/json/*.java"]),
    select = ["--select-package=com.legend.json"],
    deps = [
        ":json",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
        "@maven_test//:org_junit_jupiter_junit_jupiter_params",
    ],
)
