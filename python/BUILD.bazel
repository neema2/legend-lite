        ":headless",
        ":legend_lite",
        "@pypi//pandas",
        "@pypi//polars",
        "@rules_python//python/runfiles",
    ],
)

# THE PACKAGE: `pip install legend-lite` (a wheel per platform, the library being native). legend_lite with what it
# finds beside itself when nothing points elsewhere (_library.py, datacube.py): the compiler's library in _native/ and
# DataCube's built site in _site/. Settled with the user (2026-10-08): macOS 14 and up (the library's minimum is pinned,
# //native:compiler), Python 3.12 and up (the version it is tested on), Linux by the glibc the library is measured to
# need (wheel_test reads it from the library itself). duckdb 1.5 and pyarrow as built against; pandas and polars are the
# person's own (extras).
copy_file(
    name = "wheel_library_macos",
    src = "//native:compiler",
    out = "legend_lite/_native/libcompiler.dylib",
    target_compatible_with = ["@platforms//os:macos"],
)

copy_file(
    name = "wheel_library_linux",
    src = "//native:compiler",
    out = "legend_lite/_native/libcompiler.so",
    target_compatible_with = ["@platforms//os:linux"],
)

copy_file(
    name = "wheel_library_windows",
    src = "//native:compiler",
    out = "legend_lite/_native/libcompiler.dll",
    target_compatible_with = ["@platforms//os:windows"],
)

# the engine page alone (DataCube's demo/engine.html, its bundle, its lazy chunks, its type) and a notebook's cube (the
# widget's loader, DataCube's module and its styles), not the site's in-tab app: no DuckDB-WASM and no compiler module,
# which neither loads (about 90 MB)
copy_to_directory(
    name = "wheel_site",
    srcs = ["//datacube:dist"],
    out = "legend_lite/_site",
    include_srcs_patterns = [
        "bundle-engine.js",
        "chunks-bundle-engine/**",
        "engine.html",
        "fonts.css",
        "vendor/fonts/**",
        # a notebook's cube (legend_lite/notebook.py): anywidget's script, and DataCube's module it fetches, its lazy
        # chunks too
        "widget-chunks/**",
        "widget-loader.js",
        "widget.css",
        "widget.js",
    ],
    root_paths = ["datacube/dist"],
)

# QUERY AND STUDIO SERVED BY PYTHON (docs/ONE_PLATFORM_PROGRAM_2026_10_12.md E: ll.query(), ll.studio()): each app's
# site as it is built, its tree kept (a page names ../src/ui/app.css), but DuckDB-WASM's builds, which a page whose
# engine is Python's never loads (Python's DuckDB runs its queries: about 75 MB), and the demo's own configuration and
# models (Python writes each app's config.json, pointing at itself). Studio's demo projects stay (84 KB): "Load demo
# projects" writes them into this Python's repository, where Query then opens them by name
_APP_SITE_LEFT_OUT = [
    "**/duckdb-*.wasm",
    "**/duckdb-browser-*.worker.js",
    "**/duckdb/**",
    "**/duckdb-extensions/**",
    "demo/config*.json",
    "demo/models/**",
]

copy_to_directory(
    name = "wheel_query_site",
    srcs = ["//query:site"],
    out = "legend_lite/_apps/query",
    # //datacube:python_engine_test serves it beside DataCube's page: a project loaded in Studio runs there (C5)
    visibility = ["//datacube:__pkg__"],
    exclude_srcs_patterns = _APP_SITE_LEFT_OUT,
    root_paths = ["query"],
)

copy_to_directory(
    name = "wheel_studio_site",
    srcs = ["//studio:site"],
    out = "legend_lite/_apps/studio",
    # //datacube:python_engine_test serves it beside DataCube's page: a class made there opens in Studio
    visibility = ["//datacube:__pkg__"],
    exclude_srcs_patterns = _APP_SITE_LEFT_OUT,
    root_paths = ["studio"],
)

# DUCKDB'S EXTENSIONS for Python's DuckDB, carried by the wheel and never downloaded where it runs (MODULE.bazel pins
# each per platform): httpfs, through which a page on Python reads a remote file
# (docs/DATACUBE_ONE_APP_DESIGN_2026_10_11.md, step 2b), and iceberg with the avro it reads manifests with, through
# which it reads an Iceberg table (docs/ONE_PLATFORM_PROGRAM_2026_10_12.md G5) -- only when every file the table's
# snapshot names is remote too, since its metadata names them by path (R4, engine.py).
# Gunzipped by the Java action the warehouse's postgres extension uses (//warehouse:postgres_extension: Bazel 9.2's own
# .gz unpacking fails on Windows), each into DuckDB's own extension folder layout (v1.5.5/<DuckDB's platform>/, the
# names DUCKDB_PLATFORMS gives: //tools/platforms), which Python points its DuckDB at (engine.py): DataCube's INSTALL
# then finds each installed, and LOAD loads it.
_DUCKDB_EXTENSIONS = ["httpfs", "iceberg", "avro"]

[java_run(
    name = "duckdb_" + extension + "_" + duckdb,
    srcs = ["@duckdb_" + extension + "_extension_" + duckdb + "//file"],
    outs = ["duckdb_extensions/v1.5.5/" + duckdb + "/" + extension + ".duckdb_extension"],
    arguments = [
        "$(execpath @duckdb_" + extension + "_extension_" + duckdb + "//file)",
        "{OUT}",
    ],
    main_class = "com.legend.tools.gunzip.Gunzip",
    mnemonic = "GunzipDuckdbExtension",
    target_compatible_with = compatible_with([bazel]),
    deps = ["//tools/gunzip"],
) for bazel, duckdb in DUCKDB_PLATFORMS.items() for extension in _DUCKDB_EXTENSIONS]

_DUCKDB_CARRIED, _DUCKDB_CARRIED_COMPATIBLE = platform_select(
    {
        bazel: [":duckdb_" + extension + "_" + duckdb for extension in _DUCKDB_EXTENSIONS]
        for bazel, duckdb in DUCKDB_PLATFORMS.items()
    },
    "DuckDB's httpfs, iceberg and avro extensions (MODULE.bazel, duckdb_*_extension_*)",
)

# the folder, as the package carries it (legend_lite/_duckdb) and as the tests are given it (LEGEND_LITE_DUCKDB_EXTENSIONS)
copy_to_directory(
    name = "wheel_duckdb",
    srcs = _DUCKDB_CARRIED,
    out = "legend_lite/_duckdb",
    root_paths = ["python/duckdb_extensions"],
    target_compatible_with = _DUCKDB_CARRIED_COMPATIBLE,
    visibility = ["//datacube:__pkg__"],
)

# DataCube's headless bundle (docs/DATACUBE_HEADLESS_PYTHON_DESIGN_2026_10_11.md, step 4), beside the package where
# legend_lite/_headless.py looks for it: about 1.3 MB of DataCube's own non-screen code, run in V8 by the `datacube`
# extra's mini-racer
copy_file(
    name = "wheel_datacube",
    src = "//datacube:headless_bundle",
    out = "legend_lite/_datacube/legend-lite-headless.js",
)

# every module of legend_lite, across its libraries (py_wheel takes a target's own files only)
py_package(
    name = "wheel_package",
    packages = ["python.legend_lite"],
    deps = [
        ":headless",
        ":legend_lite",
        ":notebook",
    ],
)

py_wheel(
    name = "wheel",
    abi = "none",
    # //datacube:jupyterlab_test installs it into a fresh environment, with JupyterLab
    visibility = ["//datacube:__pkg__"],
    description_file = "README.md",
    distribution = "legend-lite",
    # the licences, in the wheel's .dist-info: the project's (Apache-2.0), its NOTICE (legend-pure, legend-engine and
    # legend-studio credited, and the notices it carries), the third-party software it redistributes, and GraalVM Community Edition's, whose runtime is compiled into the library
    # (GPLv2 with the Classpath Exception, and its third parties')
    extra_distinfo_files = {
        "//:LICENSE": "LICENSE",
        "//:NOTICE": "NOTICE",
        "//:THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
        "@graalvm//:LICENSE.txt": "GRAALVM-LICENSE.txt",
        "@graalvm//:LICENSE_NATIVEIMAGE.txt": "GRAALVM-LICENSE-NATIVEIMAGE.txt",
        "@graalvm//:THIRD_PARTY_LICENSE.txt": "GRAALVM-THIRD-PARTY-LICENSE.txt",
    },
    # ONE PACKAGE, TWO THINGS (the user, 2026-10-15; legend_lite/_extra.py): the wheel alone is the compiler, which needs
    # only Python's standard library; its `datacube` extra is DataCube with everything it needs -- duckdb and pyarrow (the
    # frames), and V8 by mini-racer, which runs DataCube's own code, whose rules Python asks and never copies (mini-racer's
    # Linux wheels are manylinux_2_27, so DataCube needs glibc 2.27 where the compiler alone needs 2.17)
    extra_requires = {
        "datacube": [
            "duckdb>=1.5.5",
            "mini-racer>=0.14.1",
            "pyarrow>=23.0.1",
        ],
        # the cube under a notebook's cell (legend_lite/notebook.py): DataCube's, and anywidget
        "notebook": [
            "anywidget>=0.11.0",
            "duckdb>=1.5.5",
            "mini-racer>=0.14.1",
            "pyarrow>=23.0.1",
        ],
        "pandas": ["pandas>=3.0.6"],
        "polars": ["polars>=2.0.0"],
    },
    license = "Apache-2.0",
    platform = select({
        # glibc 2.17: the newest the library names, measured on CI's Linux runners (throwaway run 37867411489, both
        # architectures); //python:wheel_test holds the tag to what the library needs
        "//tools/platforms:linux_aarch64": "manylinux_2_17_aarch64",
        "//tools/platforms:linux_x86_64": "manylinux_2_17_x86_64",
        "//tools/platforms:macos_arm64": "macosx_14_0_arm64",
        "//tools/platforms:macos_x86_64": "macosx_14_0_x86_64",
        "//tools/platforms:windows_x86_64": "win_amd64",
    }, no_match_error = "the wheel is built where the compiler's library is (COMPILER_LIBRARY_PLATFORMS)"),
    python_requires = ">=3.12",
    python_tag = "py3",
    # the compiler alone: nothing beyond Python's own (the datacube extra brings DataCube's packages, above)
    requires = [],
    strip_path_prefixes = ["python"],
    summary = "Legend's compiler in Python, and DataCube on a dataframe (show(df))",
    target_compatible_with = _PLATFORMS,
    version = "0.1.0",
    deps = [
        ":wheel_datacube",
        ":wheel_duckdb",
        ":wheel_package",
        ":wheel_query_site",
        ":wheel_site",
        ":wheel_studio_site",
    ] + select({
        "@platforms//os:linux": [":wheel_library_linux"],
        "@platforms//os:macos": [":wheel_library_macos"],
        "@platforms//os:windows": [":wheel_library_windows"],
    }),
)

# the packages the wheel needs, pandas with its own, the datacube extra's (mini-racer) and the notebook extra's
# (anywidget, ipywidgets, IPython), as the test installs them (the pinned wheels, offline)
_WHEEL_TEST_PACKAGES = ["duckdb", "mini_racer", "numpy", "pandas", "pyarrow", "python_dateutil", "six", "tzdata"] + _NOTEBOOK_PACKAGES

# per system: the packages, and the test's settings naming their wheels
_WHEEL_TEST_PACKAGES_POSIX = _WHEEL_TEST_PACKAGES + _NOTEBOOK_PACKAGES_POSIX

_WHEEL_TEST_PACKAGES_WINDOWS = _WHEEL_TEST_PACKAGES + _NOTEBOOK_PACKAGES_WINDOWS

_WHEEL_TEST_ENV = {
    "LEGEND_LITE_WHEEL": "$(rlocationpath :wheel)",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUTF8": "1",
}

# THE WHEEL, AS A DEVELOPER INSTALLS IT: a fresh virtual environment of the repository's Python, the wheel and its
# packages installed offline from Bazel's own downloads, then show() and a query run with nothing pointing back into
# the repository -- the wheel stands alone. And its label told true: the library's minimum macOS, or the newest glibc it
# needs, read from the library itself, against the wheel's platform tag.
py_test(
    name = "wheel_test",
    size = "medium",
    srcs = [
        "tests/main.py",
        "tests/test_wheel.py",
    ],
    args = ["test_wheel"],
    data = [":wheel"] + select({
        "@platforms//os:windows": ["@pypi//%s:whl" % p for p in _WHEEL_TEST_PACKAGES_WINDOWS],
        "//conditions:default": ["@pypi//%s:whl" % p for p in _WHEEL_TEST_PACKAGES_POSIX],
    }),
    env = select({
        "@platforms//os:windows": _WHEEL_TEST_ENV | {
            "LEGEND_LITE_DEPENDENCY_WHEELS": " ".join(["$(rlocationpaths @pypi//%s:whl)" % p for p in _WHEEL_TEST_PACKAGES_WINDOWS]),
        },
        "//conditions:default": _WHEEL_TEST_ENV | {
            "LEGEND_LITE_DEPENDENCY_WHEELS": " ".join(["$(rlocationpaths @pypi//%s:whl)" % p for p in _WHEEL_TEST_PACKAGES_POSIX]),
        },
    }),
    main = "tests/main.py",
    target_compatible_with = _PLATFORMS,
    deps = [
        ":iceberg_table",
        "@rules_python//python/runfiles",
    ],
)

# the REPL built in a lane, so it does not rot unseen (as //tools/metrics:tools_build_test keeps its tool): everything
# it builds is built for engine_test, python_engine_test and headless_test (the bundle, the extensions) anyway, bar its
# own wrapper
build_test(
    name = "tools_build_test",
    targets = [":repl"],
    target_compatible_with = _PLATFORMS,
)

guards_package()

# THE ONE API LEDGERS (docs/DATACUBE_ONE_API_PLAN_2026_10_21.md §3): //datacube:one_api_ledger_test reads Python's
# sources (which command kinds Python makes), this package's ledger file (the register is held to every ledger) and
# its tests (L12: the tests each ability on the Python host is proved by), each copied to the output tree, where a
# JavaScript test reads its data (rules_js)
copy_to_bin(
    name = "legend_lite_sources",
    srcs = glob(["legend_lite/*.py"]),
    visibility = ["//datacube:__pkg__"],
)

copy_to_bin(
    name = "one_api_ledger",
    srcs = glob(["tests/test_*.py"]),
    visibility = ["//datacube:__pkg__"],
)
