# TRY IT: an interactive Python with legend_lite ready (repl.py): the repository's Python and pinned packages, the
# compiler's native library and DataCube's built site, by their runfiles paths -- `bazel run //python:repl`, then
# `cube = ll.show(trades)`. Where the library builds.
py_binary(
    name = "repl",
    srcs = ["repl.py"],
    # what the wheel carries beside the package, by their runfiles paths: DataCube's headless bundle (a page's files,
    # examples and remote files read by DataCube's own code; grid.view(), to_pandas()) and DuckDB's httpfs as the wheel
    # lays it out -- so the repl answers as `pip install 'legend-lite[datacube]'` does
    data = [
        ":wheel_duckdb",
        "//datacube:dist",
        "//datacube:headless_bundle",
        "//native:compiler",
    ],
    env = _HEADLESS_ENV | {
        "LEGEND_LITE_LIBRARY": "$(rlocationpath //native:compiler)",
        "LEGEND_LITE_SITE": "$(rlocationpath //datacube:dist)",
        "PYTHONDONTWRITEBYTECODE": "1",
