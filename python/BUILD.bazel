# The engine: legend-engine's pure/v1 API over frames, as DataCube's remote client calls it -- the compiler's answers
# through HTTP, execute in upstream's Arrow format with DuckDB's rows over the frame as it is then, the refusals in the
# engine's error shape, and only its own page answered (its token, a local Host, no cross-origin answer).
py_test(
    name = "engine_test",
    size = "medium",
    # 2026-10-29 (the result boundary program's PR #80): the suite ran 291 s on Windows at main's 9de4d3a8 (gates run
    # 2235) and timed out at the moderate ceiling, 300 s, on three of the branch's heads (the Windows warehouse lane);
    # the ceiling had 3% of headroom, so it is the flake, not the tests -- raised to long (900 s), the suite unchanged
    timeout = "long",
    srcs = [
        "tests/main.py",
        "tests/test_engine.py",
        "tests/test_keeper.py",
        "tests/test_one_api.py",
        "tests/test_page.py",
        "tests/test_show.py",
        "tests/test_warehouse.py",
    ],
    args = [
        "test_engine",
        "test_keeper",
        "test_one_api",
        "test_page",
        "test_show",
        "test_warehouse",
    ],
    data = [
        ":wheel_duckdb",
        "//datacube:headless_bundle",
        "//datacube:headless_tab_bundle",
        "//datacube:test/fixtures/chart-rules.json",
        "//datacube:test/fixtures/pages/trades.page.json",
        "//native:compiler",
        "//warehouse:sqlapi_corpus",
    ],
    # the warehouse's driver (legend_lite/warehouse.py), held to the one corpus its binding is (C3); a page's charts
    # judged by DataCube's own rules, headless (its bundle), and answered as chart-spec.ts is held to (test_page.py);
    # the tab's own functions (its history's diffs), which test_keeper.py's open page undoes by
    env = _ENV | _HEADLESS_ENV | {
        "LEGEND_LITE_TAB_HEADLESS": "$(rlocationpath //datacube:headless_tab_bundle)",
        "LEGEND_LITE_CHART_RULES": "$(rlocationpath //datacube:test/fixtures/chart-rules.json)",
        # the saved-page corpus's frame page, which Python loads and writes as DataCube does (test_page.py CorpusPage)
        "LEGEND_LITE_CORPUS_PAGE": "$(rlocationpath //datacube:test/fixtures/pages/trades.page.json)",
        "LEGEND_LITE_SQLAPI_CORPUS": "$(rlocationpath //warehouse:sqlapi_corpus)",
    },
    main = "tests/main.py",
    target_compatible_with = _PLATFORMS,
    deps = [
        ":legend_lite",
        "@pypi//pandas",
        "@rules_python//python/runfiles",
    ],
)

