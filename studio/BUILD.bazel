# Legend Studio, rebuilt light (docs/STUDIO_DESIGN_2026_10_02.md): plain TypeScript and DOM with Monaco,
# bundled by esbuild, tested with node's own runner. Its npm packages are its own lock (MODULE.bazel
# `npm_studio`). The SDLC and the compiler run in the page as WebAssembly (level 0) or on servers.
load("//tools/guards:defs.bzl", "guards_package")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("//tools/browser:defs.bzl", "browser_test")
load("//tools/js:defs.bzl", "node_test")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@npm_studio//:defs.bzl", "npm_link_all_packages")
load("@npm_studio//studio:esbuild/package_json.bzl", esbuild = "bin")
load("@npm_studio//studio:typescript/package_json.bzl", typescript = "bin")

npm_link_all_packages(name = "node_modules")

exports_files(["pnpm-lock.yaml", "package.json"])

js_library(
    name = "src",
    srcs = glob(["src/**/*.ts", "src/**/*.css"]) + ["package.json", "tsconfig.json"],
    deps = [
        "//depot-client:depot_client",
        "//legend-art:legend_art",
        "//sdlc-client:sdlc_client",
    ],
)

# the page and its two workers: Studio (with Monaco and its stylesheet), legend-lite's compiler, Monaco's
esbuild.esbuild(
    name = "bundle",
    srcs = glob(["demo/**/*.ts"]) + [":src", ":node_modules/monaco-editor"],
    outs = ["demo/bundle.js", "demo/bundle.css"],
    args = [
        "demo/main.ts",
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--loader:.ttf=dataurl",
        "--log-level=warning",
        "--outfile=demo/bundle.js",
    ],
    chdir = package_name(),
)

[esbuild.esbuild(
    name = "bundle_" + name,
    srcs = [":src", ":node_modules/monaco-editor"],
    outs = ["demo/" + out],
    args = [
        entry,
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--log-level=warning",
        "--outfile=demo/" + out,
    ],
    chdir = package_name(),
) for name, entry, out in [
    ("planner_worker", "src/backend/planner-worker.ts", "planner-worker.js"),
    ("editor_worker", "src/backend/editor-worker.ts", "editor.worker.js"),
]]

# The WebAssembly modules the page loads from ./vendor/: the compiler (vendor/planner/) and the SDLC
# (vendor/sdlc/), and the fonts.
copy_to_directory(
    name = "vendor",
    srcs = [
        "//legend-art:fonts",
        "//legend-art:styles",
        "//sdlc-server:page",
        "//wasm:planner",
    ],
    out = "demo/vendor",
    include_srcs_patterns = [
        "wasm/planner/classes.wasm",
        "wasm/planner/wasm-gc-module-runtime.js",
        "sdlc-server/page/classes.wasm",
        "sdlc-server/page/wasm-gc-module-runtime.js",
        "legend-art/fonts/roboto-latin-400-normal.woff2",
        "legend-art/fonts/roboto-latin-500-normal.woff2",
        "legend-art/fonts/roboto-latin-700-normal.woff2",
        "legend-art/fonts/roboto-mono-latin-400-normal.woff2",
        "legend-art/fonts/roboto-mono-latin-700-normal.woff2",
        "legend-art/fonts/raleway-latin-900-normal.woff2",
        "legend-art/fonts/LICENSE-*.txt",
        "legend-art/src/*.css",
    ],
    replace_prefixes = {
        "wasm/planner/": "planner/",
        "sdlc-server/page/": "sdlc/",
        "legend-art/fonts/": "fonts/",
        "legend-art/src/": "legend-art/",
    },
)

# Everything a browser fetches.
filegroup(
    name = "site",
    # served beside Query and DataCube from one origin (//site): they share the browser's stores (IndexedDB)
    visibility = ["//site:__pkg__"],
    srcs = glob([
        "demo/*.html",
        "demo/*.json",
        "demo/*.css",
        "demo/projects/**",
        "src/**/*.css",
    ]) + [":bundle", ":bundle_planner_worker", ":bundle_editor_worker", ":vendor"],
)

# `bazel run //studio:serve [-- --port 8200]`: the site, on loopback.
js_binary(
    name = "serve",
    data = [":site"],
    entry_point = "demo/serve.mjs",
)

# The whole loop in the pinned Chromium (//tools/browser), in the page alone and against the model home's
# server: CI's browser lane (gates-run.yml), and `bazel test //studio:verify_test` here.
browser_test(
    name = "verify_test",
    size = "large",
    data = [
        ":site",
        ":node_modules/playwright",
        "//sdlc-client:sdlc_server",
        "//sdlc-client:server_helper",
        "//sdlc-server:server",
    ],
    entry_point = "demo/verify.mjs",
    env = {"SDLC_SERVER": "$(rlocationpath //sdlc-client:sdlc_server)"},
)

# Studio's model over the real WebAssembly modules: the compiler (WASM_PLANNER) and the SDLC (SDLC_PAGE).
[node_test(
    name = t[len("test/"):-len(".test.ts")].replace("-", "_") + "_test",
    size = "small",
    data = [
        ":src",
        ":demo_projects",
        "demo/projects/manifest.json",
        "test/modules.ts",
        "//depot-client:depot_client",
        "//sdlc-server:page_dir",
    ],
    entry_point = t,
    env = {
        "SDLC_PAGE": "$(rlocationpath //sdlc-server:page_dir)",
        "STUDIO_PROJECTS_MANIFEST": "$(rlocationpath demo/projects/manifest.json)",
    },
    wasm = True,
) for t in glob(["test/*.test.ts"])]

# the demo projects (design S18), by runfiles path for the test that publishes them (STUDIO_PROJECTS_MANIFEST)
filegroup(
    name = "demo_projects",
    srcs = glob(["demo/projects/**"]),
)

typescript.tsc_test(
    name = "typecheck_test",
    size = "small",
    args = ["-p", package_name() + "/tsconfig.json"],
    data = glob([
        "src/**/*.ts",
        "test/**/*.ts",
        "demo/**/*.ts",
    ]) + [
        "package.json",
        "tsconfig.json",
        "//depot-client:depot_client",
        "//legend-art:legend_art",
        "//sdlc-client:sdlc_client",
        "//tools/js:runfiles",
        ":node_modules/@types/node",
        ":node_modules/monaco-editor",
    ],
)

# every test here but the browser harness (verify, tagged browser-ci): the local gate and CI run it
test_suite(
    name = "tests",
    tests = [
        ":demo_test",
        ":typecheck_test",
        ":workspace_test",
    ],
)

guards_package()
