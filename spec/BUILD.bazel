# spec — the tests that read the upstream sources as the SPEC: the generators'
# byte-parity checks (Maven gate 3) and the relational corpus lanes (gates 4, 5).

load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/generators:defs.bzl", "UPSTREAM_ROOTS", "UPSTREAM_TREES", "program_jvm_flags")
load("//tools/java:defs.bzl", "legend_java_library")
load("//tools/java_run:defs.bzl", "java_run")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/guards:defs.bzl", "guards_package")

# spec's sources, exported for core's guard tests that walk every module.
filegroup(
    name = "srcs",
    srcs = glob(["src/**"]),
    visibility = ["//core:__pkg__", "//parser-equivalence:__pkg__"],
)

# THE GENERATOR PROGRAMS (see "THE GENERATORS" below), in src/gen/java, out of the test tree (Bazel workplan P7-12):
# plain code, no test framework; a program reads its declared inputs and writes one file.
# SourceTree reads a source root as text; it needs no core, so both cores' generators share it.
legend_java_library(
    name = "source_tree",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = ["src/gen/java/com/legend/generators/SourceTree.java"],
)

legend_java_library(
    name = "generators",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = glob(
        ["src/gen/java/com/legend/generators/*.java"],
        exclude = ["src/gen/java/com/legend/generators/SourceTree.java"],
    ),
    deps = [
        ":claims",
        ":source_tree",
        "//core",
    ],
)

# Claims (and ClaimsGenerator, which writes its ledger) reads the COMPILED registries of the core it is compiled
# against, so the two are compiled once per core they read: here against //core, for ClaimRegistryTest (the committed core against the committed ledger) and the
# prelude generator; and in
# :claims_generator_lib against //core:core_next, for :gen_claims (the ledger of core as regenerated).
legend_java_library(
    name = "claims",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = [
        "src/gen/java/com/legend/claims/Claims.java",
        "src/gen/java/com/legend/claims/ClaimsGenerator.java",
    ],
    deps = [
        ":source_tree",
        "//core",
    ],
)

legend_java_library(
    name = "spec_tests_lib",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    testonly = True,
    srcs = glob(["src/test/java/**/*.java"]),
    resources = glob(["src/test/resources/**"]),
    runtime_deps = [
        "//core:drivers",
        "//core:shadow_binding",
    ],
    deps = [
        ":claims",
        ":generators",
        ":source_tree",
        "//core",
        "//testing",
        "@maven_test//:com_tngtech_archunit_archunit",
        "@maven_test//:com_tngtech_archunit_archunit_junit5",
        "@maven_core//:org_duckdb_duckdb_jdbc",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
        "@maven_test//:org_junit_jupiter_junit_jupiter_params",
    ],
)

# the generators' byte-parity checks read core's committed generated files
_INPUTS = [
    ":srcs",
    "//core:srcs",
]

# Maven gate 3: every spec test except the heavy corpus sweep.
junit_test(
    name = "spec_tests",
    memory_mb = 1024,
    data = _INPUTS,
    exclude_tags = ["heavy"],
    runtime_deps = [":spec_tests_lib"],
    select = ["--select-package=com.legend"],
    upstream = True,
)

# Maven gates 4 and 11, ONE target: the relational corpus against DuckDB under
# the HOST judge (gate 4) — run as the prerun, a child JVM, writing its per-assert
# ledger — then under the DATABASE judge, which joins the two per assert in the
# lane itself (MinimalCorpusTest.pinJudgeDifferential; gate 11). The host pass
# carries every gate-4 assertion (the judge mode defaults to host; the ledger is a
# write-only side effect), and a failing host pass fails the target before the
# database pass runs. Until 2026-09-23 gate 4 was also its own target, so every
# chain ran the host pass twice.
junit_test(
    name = "corpus_duckdb",
    memory_mb = 768,
    data = _INPUTS,
    jvm_flags = [
        "-Dlegend.prerun=legend.judge.mode=host,legend.judge.ledger=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-host.tsv",
        "-Dlegend.judge.mode=database",
        "-Dlegend.judge.ledger=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-database.tsv",
        "-Dlegend.judge.ledger.host=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-host.tsv",
    ],
    runtime_deps = [":spec_tests_lib"],
    select = ["--select-class=com.legend.rcorpus.MinimalCorpusTest"],
    upstream = True,
)

# W1c (docs/WAREHOUSE_W1_DESIGN_2026_09_26.md): :corpus_duckdb with every
# connection a session on the warehouse, spoken to through its JDBC driver. The
# harness starts the server (its deploy jar: DuckDB 1.5.5.1, its own classpath)
# as a child process. Not in the chain yet: its differences from :corpus_duckdb
# are the leg's rows.
junit_test(
    name = "corpus_warehouse",
    memory_mb = 768,
    # the warehouse it starts finds DuckDB's library in these runfiles (Bazel workplan P1-16)
    data = _INPUTS + [
        "//warehouse:duckdb_library",
        "//warehouse:server_deploy.jar",
    ],
    jvm_flags = [
        "-Drcorpus.warehouse.server=$(rootpath //warehouse:server_deploy.jar)",
        "-Dlegend.prerun=legend.judge.mode=host,legend.judge.ledger=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-host.tsv",
        "-Dlegend.judge.mode=database",
        "-Dlegend.judge.ledger=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-database.tsv",
        "-Dlegend.judge.ledger.host=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-host.tsv",
    ],
    runtime_deps = [
        ":spec_tests_lib",
        "//warehouse:client",
    ],
    select = ["--select-class=com.legend.rcorpus.MinimalCorpusTest"],
    tags = ["manual"],
    upstream = True,
)

# Maven gate 5, the same two passes on H2: the corpus under the HOST judge (the
# prerun, writing its ledger), then under the DATABASE judge, joined per assert —
# :corpus_duckdb's shape. The database pass was its own target until 2026-09-23,
# which ran the H2 database judge but never the join.
# memory_mb 4096, not the rule's 4864 (live peak 3235 MB, measured 2026-10-04): CI's 7 GB macOS runner runs this
# lane, and ran it green at -Xmx4g from 2026-09-23 to 2026-10-04 (Bazel workplan P1-21).
junit_test(
    name = "corpus_h2",
    memory_mb = 4096,
    data = _INPUTS,
    jvm_flags = [
        "-Drcorpus.backend=h2",
        "-Dlegend.prerun=legend.judge.mode=host,legend.judge.ledger=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-host.tsv",
        "-Dlegend.judge.mode=database",
        "-Dlegend.judge.ledger=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-database.tsv",
        "-Dlegend.judge.ledger.host=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-host.tsv",
    ],
    runtime_deps = [":spec_tests_lib"],
    select = ["--select-class=com.legend.rcorpus.MinimalCorpusTest"],
    upstream = True,
)

# THE REFERENCE LANE (execution plan W1.1): legend-pure's own compiler, from the pinned jars, against ours, call by
# call, over core_relational's closure. The reference side is a cached build output (//tools/reference:ref_dump); the
# test types our side, joins, and compares the whole report to its committed golden. Manual: in no CI
# lane; every front-end slice's GATES entry cites a run.
# The report: our side against the cached reference dump, joined (ReferenceLaneReport); its header's release from
# the oracle pins. Manual like the lane: with the dump it needs about 8 GB, so it must not join every `//...`.
java_run(
    name = "reference_lane_report",
    testonly = True,
    srcs = UPSTREAM_TREES + [
        "//tools:oracle-pins.env",
        "//tools/reference:ref_dump",
    ],
    outs = [
        "reference-lane/core_relational.txt",
        "reference-lane/core_relational-examples.tsv",
    ],
    arguments = [
        "$(execpath //tools/reference:ref_dump)",
        "$(execpath //tools:oracle-pins.env)",
        "{OUT_DIR}",
    ],
    jvm_flags = program_jvm_flags("spec") + ["-Xss16m"],
    main_class = "com.legend.generators.ReferenceLaneReport",
    memory_mb = 2048,
    mnemonic = "Generate",
    roots = UPSTREAM_ROOTS,
    tags = ["manual"],
    deps = [":spec_tests_lib"],
)

# The report against its golden; `bazel run //spec:update_reference_lane` re-blesses a deliberate change (the GATES
# entry says which lines moved and why).
write_source_files(
    name = "update_reference_lane",
    testonly = True,
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nThe reference lane moved -- a deliberate front-end change re-blesses it: bazel run //spec:update_reference_lane, with the GATES entry saying which lines moved and why",
    files = {"src/test/resources/reference-lane/core_relational.txt": ":reference-lane/core_relational.txt"},
    tags = ["manual"],
)

# The lane's invariant: every disagreement class in the report has a reason (reasons.tsv).
junit_test(
    name = "reference_lane",
    memory_mb = 768,
    data = [":reference-lane/core_relational.txt"],
    jvm_flags = ["-Dreference.report=$(rlocationpath :reference-lane/core_relational.txt)"],
    runtime_deps = [":spec_tests_lib"],
    select = ["--select-class=com.legend.generators.ReferenceLaneTest"],
    tags = ["manual"],
)

# THE CORPUS LANES and THE JUDGE LANES, one suite (was tools/corpus-both.sh and
# tools/judge-lanes.sh, whose suites held the same two targets; corpus_lanes deleted
# 2026-10-03, workplan P0-13; docs/DATABASE_MODE_HOMEWORK_2026_09_18.md):
# DuckDB and H2 under both judges, and the per-assert differential at zero
# unregistered disagreements. `bazel test //spec:judge_lanes`
test_suite(
    name = "judge_lanes",
    tests = [
        ":corpus_duckdb",
        ":corpus_h2",
    ],
)

# ── THE GENERATORS ──────────────────────────────────────────────────────────────
# Each generator is a PROGRAM: declared inputs (named upstream files and, where it
# splices one, the committed file), one output. Bazel runs it as a sandboxed build
# action, so an undeclared read fails and the result is cached.
# //core:update_generated writes the outputs into the checkout; its diff tests fail
# `bazel test` when a committed file is not its generator's output.
_ENGINE_COMPILE_CONTEXT = "@legend_engine_src//:legend-engine-core/legend-engine-core-base/legend-engine-core-language-pure/legend-engine-language-pure-compiler/src/main/java/org/finos/legend/engine/language/pure/compiler/toPureGraph/CompileContext.java"

# Each generator runs through java_run (//tools/java_run): its program is an
# ordinary TARGET-configuration library — compiled once, with core — run on the
# build machine's Java runtime. As a genrule tool it was an exec-configuration
# java_binary, which compiled core a second time for the tools (2026-09-23).
_ROOTS = UPSTREAM_ROOTS

# core's Java source root for the generators that read it as text, by label: Pure.java's directory, three package
# levels below it (P7-12; it was the hard-coded workspace path "core/src/main/java")
_CORE_SRC = {"//core:src/main/java/com/legend/builtin/Pure.java": "{CORE_BUILTIN}"}

# engine-handlers.tsv: the engine's Handlers.java registry — the bare-name
# function surface, each name with its signature ids and the platform's FQN
_ENGINE_HANDLERS = "@legend_engine_src//:legend-engine-core/legend-engine-core-base/legend-engine-core-language-pure/legend-engine-language-pure-compiler/src/main/java/org/finos/legend/engine/language/pure/compiler/toPureGraph/handlers/Handlers.java"

java_run(
    name = "gen_engine_handlers",
    srcs = [_ENGINE_HANDLERS],
    outs = ["generated/engine-handlers.tsv"],
    arguments = [
        "$(execpath %s)" % _ENGINE_HANDLERS,
        "{OUT}",
    ],
    main_class = "com.legend.generators.EngineHandlersGenerator",
    mnemonic = "Generate",
    visibility = ["//core:__pkg__"],
    deps = [":generators"],
)

# NameResolver.java's CORE_IMPORTS: the engine's META_IMPORTS sequence
java_run(
    name = "gen_imports",
    srcs = [
        _ENGINE_COMPILE_CONTEXT,
        "//core:src/main/java/com/legend/compiler/NameResolver.java",
    ],
    outs = ["generated/NameResolver.java"],
    arguments = [
        "$(execpath %s)" % _ENGINE_COMPILE_CONTEXT,
        "$(execpath //core:src/main/java/com/legend/compiler/NameResolver.java)",
        "{OUT}",
    ],
    main_class = "com.legend.generators.ImportsGenerator",
    mnemonic = "Generate",
    visibility = ["//core:__pkg__"],
    deps = [":generators"],
)

# DynaFn.java's members: the engine's dynafunction registries, every dialect
java_run(
    name = "gen_dynafn",
    srcs = UPSTREAM_TREES + [
        "//core:src/main/java/com/legend/builtin/DynaFn.java",
    ],
    outs = ["generated/DynaFn.java"],
    arguments = [
        "{ENGINE_ROOT}",
        "$(execpath //core:src/main/java/com/legend/builtin/DynaFn.java)",
        "{OUT}",
    ],
    main_class = "com.legend.generators.DynaFnGenerator",
    mnemonic = "Generate",
    roots = _ROOTS,
    visibility = ["//core:__pkg__"],
    deps = [":generators"],
)

# Pure.java's membership signatures: upstream's spelling of OUR membership rows.
# Runs on core AS COMMITTED (its parser and resolver) — the first link of the chain.
java_run(
    name = "gen_natives",
    srcs = UPSTREAM_TREES + [
        "//core:src/main/resources/com/legend/builtin/native-membership.tsv",
        "//core:src/main/java/com/legend/builtin/Pure.java",
    ],
    outs = ["generated/Pure.java"],
    arguments = [
        "{ENGINE_ROOT}",
        "{PURE_ROOT}",
        "$(execpath //core:src/main/resources/com/legend/builtin/native-membership.tsv)",
        "$(execpath //core:src/main/java/com/legend/builtin/Pure.java)",
        "{OUT}",
    ],
    main_class = "com.legend.generators.NativesGenerator",
    mnemonic = "Generate",
    roots = _ROOTS,
    visibility = ["//core:__pkg__"],
    deps = [":generators"],
)

# Every upstream declaration of a membership FQN (fqn, key, text, source file): what a re-keying leg reads.
# A build output (bazel build //spec:native_declarations), never a file in the tree (P2-17).
java_run(
    name = "native_declarations",
    srcs = UPSTREAM_TREES + [
        "//core:src/main/resources/com/legend/builtin/native-membership.tsv",
    ],
    outs = ["generated/native-declarations.tsv"],
    arguments = [
        "{ENGINE_ROOT}",
        "{PURE_ROOT}",
        "$(execpath //core:src/main/resources/com/legend/builtin/native-membership.tsv)",
        "{OUT}",
    ],
    main_class = "com.legend.generators.NativeDeclarations",
    mnemonic = "Generate",
    roots = _ROOTS,
    deps = [":generators"],
)

# A DRAFT of the hand-owned native-membership.tsv from Pure.java's compiled constants, for a person to finish:
# //core:draft_native_membership writes it (P2-17).
java_run(
    name = "native_membership_draft",
    outs = ["generated/native-membership.draft.tsv"],
    arguments = ["{OUT}"],
    main_class = "com.legend.generators.NativeMembershipDraft",
    mnemonic = "Generate",
    visibility = ["//core:__pkg__"],
    deps = [":generators"],
)

# prelude.pure: the spec shapes the platform and the corpus name. It reads core's
# Java SOURCES with Pure.java as :gen_natives wrote it (the chain: natives, then
# prelude), and runs on core as committed.
java_run(
    name = "gen_prelude",
    srcs = UPSTREAM_TREES + [
        ":gen_natives",
        "//core:main_java",
    ],
    outs = ["generated/com/legend/builtin/prelude.pure"],
    arguments = [
        "{ENGINE_ROOT}",
        "{PURE_ROOT}",
        "{CORE_BUILTIN}/../../..",  # core/src/main/java, from Pure.java's label (P7-12)
        "{OUT}",
        "com/legend/builtin/Pure.java=$(execpath :gen_natives)",
    ],
    main_class = "com.legend.generators.PreludeGenerator",
    mnemonic = "Generate",
    roots = _ROOTS | _CORE_SRC,
    visibility = ["//core:__pkg__"],
    deps = [":generators"],
)

# the claims generator reads the COMPILED registries, so it is compiled against,
# and runs on, //core:core_next — core as the generators above rewrite it — and
# never beside a second core
legend_java_library(
    name = "claims_generator_lib",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = [
        "src/gen/java/com/legend/claims/Claims.java",
        "src/gen/java/com/legend/claims/ClaimsGenerator.java",
    ],
    deps = [
        ":source_tree",
        "//base",
        "//core:core_next",
    ],
)

# native-claims.tsv: the implemented surface. The last link of the chain: it
# runs on core_next and reads core's sources with the three generated Java files.
java_run(
    name = "gen_claims",
    srcs = [
        ":gen_dynafn",
        ":gen_imports",
        ":gen_natives",
        "//core:main_java",
    ],
    outs = ["generated/native-claims.tsv"],
    arguments = [
        "{CORE_BUILTIN}/../../..",  # core/src/main/java, from Pure.java's label (P7-12)
        "{OUT}",
        "com/legend/builtin/DynaFn.java=$(execpath :gen_dynafn)",
        "com/legend/builtin/Pure.java=$(execpath :gen_natives)",
        "com/legend/compiler/NameResolver.java=$(execpath :gen_imports)",
    ],
    roots = _CORE_SRC,
    main_class = "com.legend.claims.ClaimsGenerator",
    mnemonic = "Generate",
    visibility = ["//core:__pkg__"],
    deps = [":claims_generator_lib"],
)

guards_package()
