# spec — the tests that read the upstream sources as the SPEC: the generators'
# byte-parity checks (Maven gate 3) and the relational corpus lanes (gates 4, 5).
load("@rules_java//java:defs.bzl", "java_library")
load("//tools/generators:defs.bzl", "UPSTREAM_ROOTS", "UPSTREAM_TREES")
load("//tools/java_run:defs.bzl", "java_run")
load("//tools/junit:defs.bzl", "junit_test")

# spec's sources, exported for core's guard tests that walk every module.
filegroup(
    name = "srcs",
    srcs = glob(["src/**"]),
    visibility = ["//core:__pkg__", "//parser-equivalence:__pkg__"],
)

# Compiled ONCE; every lane below runs from this library.
# THE GENERATOR PROGRAMS (see "THE GENERATORS" below): plain code, no test
# framework — a program reads its declared inputs and writes one file.
_GENERATOR_SRCS = [
    "src/test/java/com/legend/claims/Claims.java",
    "src/test/java/com/legend/claims/ClaimsGenerator.java",
    "src/test/java/com/legend/generators/DynaFnGenerator.java",
    "src/test/java/com/legend/generators/ImportsGenerator.java",
    "src/test/java/com/legend/generators/NativesGenerator.java",
    "src/test/java/com/legend/generators/PreludeGenerator.java",
    "src/test/java/com/legend/generators/SourceTree.java",
    "src/test/java/com/legend/generators/UpstreamFiles.java",
]

java_library(
    name = "generators",
    srcs = _GENERATOR_SRCS,
    deps = ["//core"],
)

java_library(
    name = "spec_tests_lib",
    testonly = True,
    srcs = glob(
        ["src/test/java/**/*.java"],
        exclude = _GENERATOR_SRCS,
    ),
    resources = glob(["src/test/resources/**"]),
    runtime_deps = ["//core:drivers"],
    deps = [
        ":generators",
        "//core",
        "//testing",
        "@maven_core//:com_h2database_h2",
        "@maven_test//:com_tngtech_archunit_archunit",
        "@maven_test//:com_tngtech_archunit_archunit_junit5",
        "@maven_core//:org_duckdb_duckdb_jdbc",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
        "@maven_test//:org_junit_jupiter_junit_jupiter_params",
    ],
)

# the generators' byte-parity checks read core's committed generated files
_INPUTS = [
    ":srcs",
    "//core:srcs",
]

# Maven gate 3: every spec test except the heavy corpus sweep.
junit_test(
    name = "spec_tests",
    data = _INPUTS,
    exclude_tags = ["heavy"],
    runtime_deps = [":spec_tests_lib"],
    select = ["--select-package=com.legend"],
    upstream = True,
)

# Maven gates 4 and 11, ONE target: the relational corpus against DuckDB under
# the HOST judge (gate 4) — run as the prerun, a child JVM, writing its per-assert
# ledger — then under the DATABASE judge, which joins the two per assert in the
# lane itself (MinimalCorpusTest.pinJudgeDifferential; gate 11). The host pass
# carries every gate-4 assertion (the judge mode defaults to host; the ledger is a
# write-only side effect), and a failing host pass fails the target before the
# database pass runs. Until 2026-09-23 gate 4 was also its own target, so every
# chain ran the host pass twice.
junit_test(
    name = "corpus_duckdb",
    data = _INPUTS,
    jvm_flags = [
        "-Dlegend.prerun=legend.judge.mode=host,legend.judge.ledger=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-host.tsv",
        "-Dlegend.judge.mode=database",
        "-Dlegend.judge.ledger=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-database.tsv",
        "-Dlegend.judge.ledger.host=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-host.tsv",
    ],
    runtime_deps = [":spec_tests_lib"],
    select = ["--select-class=com.legend.rcorpus.MinimalCorpusTest"],
    upstream = True,
)

# Maven gate 5, the same two passes on H2: the corpus under the HOST judge (the
# prerun, writing its ledger), then under the DATABASE judge, joined per assert —
# :corpus_duckdb's shape. The database pass was its own target until 2026-09-23,
# which ran the H2 database judge but never the join.
junit_test(
    name = "corpus_h2",
    data = _INPUTS,
    jvm_flags = [
        "-Drcorpus.backend=h2",
        "-Dlegend.prerun=legend.judge.mode=host,legend.judge.ledger=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-host.tsv",
        "-Dlegend.judge.mode=database",
        "-Dlegend.judge.ledger=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-database.tsv",
        "-Dlegend.judge.ledger.host=$${TEST_UNDECLARED_OUTPUTS_DIR}/judge-host.tsv",
    ],
    runtime_deps = [":spec_tests_lib"],
    select = ["--select-class=com.legend.rcorpus.MinimalCorpusTest"],
    upstream = True,
)

# THE MEASURE BEFORE ANY CHAIN (was tools/corpus-both.sh): the full corpus on both
# backends. `bazel test //spec:corpus_lanes`
test_suite(
    name = "corpus_lanes",
    tests = [
        ":corpus_duckdb",
        ":corpus_h2",
    ],
)

# THE JUDGE LANES (was tools/judge-lanes.sh; docs/DATABASE_MODE_HOMEWORK_2026_09_18.md):
# DuckDB and H2 under both judges, and the per-assert differential at zero
# unregistered disagreements. `bazel test //spec:judge_lanes`
test_suite(
    name = "judge_lanes",
    tests = [
        ":corpus_duckdb",
        ":corpus_h2",
    ],
)

# ── THE GENERATORS ──────────────────────────────────────────────────────────────
# Each generator is a PROGRAM: declared inputs (named upstream files and, where it
# splices one, the committed file), one output. Bazel runs it as a sandboxed build
# action, so an undeclared read fails and the result is cached.
# //core:update_generated writes the outputs into the checkout; its diff tests fail
# `bazel test` when a committed file is not its generator's output.
_ENGINE_COMPILE_CONTEXT = "@legend_engine_src//:legend-engine-core/legend-engine-core-base/legend-engine-core-language-pure/legend-engine-language-pure-compiler/src/main/java/org/finos/legend/engine/language/pure/compiler/toPureGraph/CompileContext.java"


# Each generator runs through java_run (//tools/java_run): its program is an
# ordinary TARGET-configuration library — compiled once, with core — run on the
# build machine's Java runtime. As a genrule tool it was an exec-configuration
# java_binary, which compiled core a second time for the tools (2026-09-23).
_ROOTS = UPSTREAM_ROOTS

# NameResolver.java's CORE_IMPORTS: the engine's META_IMPORTS sequence
java_run(
    name = "gen_imports",
    srcs = [
        _ENGINE_COMPILE_CONTEXT,
        "//core:src/main/java/com/legend/compiler/NameResolver.java",
    ],
    outs = ["generated/NameResolver.java"],
    arguments = [
        "$(execpath %s)" % _ENGINE_COMPILE_CONTEXT,
        "$(execpath //core:src/main/java/com/legend/compiler/NameResolver.java)",
        "{OUT}",
    ],
    main_class = "com.legend.generators.ImportsGenerator",
    mnemonic = "Generate",
    visibility = ["//core:__pkg__"],
    deps = [":generators"],
)

# DynaFn.java's members: the engine's dynafunction registries, every dialect
java_run(
    name = "gen_dynafn",
    srcs = UPSTREAM_TREES + [
        "//core:src/main/java/com/legend/builtin/DynaFn.java",
    ],
    outs = ["generated/DynaFn.java"],
    arguments = [
        "{ENGINE_ROOT}",
        "$(execpath //core:src/main/java/com/legend/builtin/DynaFn.java)",
        "{OUT}",
    ],
    main_class = "com.legend.generators.DynaFnGenerator",
    mnemonic = "Generate",
    roots = _ROOTS,
    visibility = ["//core:__pkg__"],
    deps = [":generators"],
)

# Pure.java's membership signatures: upstream's spelling of OUR membership rows.
# Runs on core AS COMMITTED (its parser and resolver) — the first link of the chain.
java_run(
    name = "gen_natives",
    srcs = UPSTREAM_TREES + [
        "//core:src/main/resources/com/legend/builtin/native-membership.tsv",
        "//core:src/main/java/com/legend/builtin/Pure.java",
    ],
    outs = ["generated/Pure.java"],
    arguments = [
        "{ENGINE_ROOT}",
        "{PURE_ROOT}",
        "$(execpath //core:src/main/resources/com/legend/builtin/native-membership.tsv)",
        "$(execpath //core:src/main/java/com/legend/builtin/Pure.java)",
        "{OUT}",
    ],
    main_class = "com.legend.generators.NativesGenerator",
    mnemonic = "Generate",
    roots = _ROOTS,
    visibility = ["//core:__pkg__"],
    deps = [":generators"],
)

# prelude.pure: the spec shapes the platform and the corpus name. It reads core's
# Java SOURCES with Pure.java as :gen_natives wrote it (the chain: natives, then
# prelude), and runs on core as committed.
java_run(
    name = "gen_prelude",
    srcs = UPSTREAM_TREES + [
        ":gen_natives",
        "//core:main_java",
    ],
    outs = ["generated/com/legend/builtin/prelude.pure"],
    arguments = [
        "{ENGINE_ROOT}",
        "{PURE_ROOT}",
        "core/src/main/java",
        "{OUT}",
        "com/legend/builtin/Pure.java=$(execpath :gen_natives)",
    ],
    main_class = "com.legend.generators.PreludeGenerator",
    mnemonic = "Generate",
    roots = _ROOTS,
    visibility = ["//core:__pkg__"],
    deps = [":generators"],
)

# the claims generator reads the COMPILED registries, so it is compiled against,
# and runs on, //core:core_next — core as the generators above rewrite it — and
# never beside a second core
java_library(
    name = "claims_generator_lib",
    srcs = [
        "src/test/java/com/legend/claims/Claims.java",
        "src/test/java/com/legend/claims/ClaimsGenerator.java",
        "src/test/java/com/legend/generators/SourceTree.java",
    ],
    deps = ["//core:core_next"],
)

# native-claims.tsv: the implemented surface. The last link of the chain: it
# runs on core_next and reads core's sources with the three generated Java files.
java_run(
    name = "gen_claims",
    srcs = [
        ":gen_dynafn",
        ":gen_imports",
        ":gen_natives",
        "//core:main_java",
    ],
    outs = ["generated/native-claims.tsv"],
    arguments = [
        "core/src/main/java",
        "{OUT}",
        "com/legend/builtin/DynaFn.java=$(execpath :gen_dynafn)",
        "com/legend/builtin/Pure.java=$(execpath :gen_natives)",
        "com/legend/compiler/NameResolver.java=$(execpath :gen_imports)",
    ],
    main_class = "com.legend.claims.ClaimsGenerator",
    mnemonic = "Generate",
    visibility = ["//core:__pkg__"],
    deps = [":claims_generator_lib"],
)

