# ONE SITE, EVERY APP (the user, 2026-10-01: "the private browser sharing mode with no server"; Studio joined
# 2026-10-05):
# Legend Query, DataCube and Studio from one origin -- /query/, /datacube/ and /studio/, each its own site exactly as
# it is built -- so the saved queries Query keeps in this browser (query-store, IndexedDB) are the
# ones DataCube opens, and the projects Studio keeps here (sdlc-client's legend-projects) are every app's. A
# browser keeps storage per origin: two ports would be two stores.
load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//tools/browser:defs.bzl", "browser_test")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//tools/guards:defs.bzl", "guards_package")

# `bazel build //site:dist`: the folder for any static host -- every app, no backend.
copy_to_directory(
    name = "dist",
    srcs = [
        "index.html",
        # the licence, the notice and the third-party software the apps redistribute, at the site's root
        "//:LICENSE",
        "//:NOTICE",
        "//:THIRD_PARTY_NOTICES.md",
        "//datacube:site",
        "//query:site",
        "//studio:site",
    ],
    out = "dist",
    visibility = ["//:__pkg__"],
)

# `bazel run //site:serve [-- --port 8200] [-- --host 0.0.0.0]`: that folder, on loopback.
# a hand tool: manual (2026-10-07, PHASE_8.md Gen-5), built by :tools_build_test
js_binary(
    name = "serve",
    data = [":dist"],
    entry_point = "serve.mjs",
    tags = ["manual"],
)

# THE ONE-ORIGIN PROMISE, AS A TEST (the build rebuild's L1b, 2026-10-07): saved in Query, opened in DataCube, one
# origin and no server, in the pinned Chromium. CI runs it on Linux only (the tag; gates-run.yml filters it on macOS
# and Windows); a desk runs it anywhere.
browser_test(
    name = "verify_test",
    size = "large",
    data = [
        ":dist",
        "//datacube:node_modules/playwright",
    ],
    entry_point = "verify.mjs",
    tags = ["ci-linux-only"],
)

# `bazel run //site:verify`: the same by hand (manual, 2026-10-07)
js_binary(
    name = "verify",
    data = [
        ":dist",
        "//datacube:node_modules/playwright",
        # it imports pinned-chromium.mjs first, a no-op under bazel run
        "//tools/browser:pinned_chromium",
    ],
    entry_point = "verify.mjs",
    tags = ["manual"],
)

# every hand tool of this package compiles (the build rebuild's L1b)
build_test(
    name = "tools_build_test",
    targets = [
        ":serve",
        ":verify",
    ],
)

guards_package()
