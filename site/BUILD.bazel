# ONE SITE, BOTH APPS (the user, 2026-10-01: "the private browser sharing mode with no server"):
# Legend Query and DataCube from one origin -- /query/ and /datacube/, each its own site exactly as
# it is built -- so the saved queries Query keeps in this browser (query-store, IndexedDB) are the
# ones DataCube opens. A browser keeps storage per origin: two ports would be two stores.
load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//tools/guards:defs.bzl", "guards_package")

# `bazel build //site:dist`: the folder for any static host -- both apps, no backend.
copy_to_directory(
    name = "dist",
    srcs = [
        "index.html",
        "//datacube:site",
        "//query:site",
    ],
    out = "dist",
)

# `bazel run //site:serve [-- --port 8200] [-- --host 0.0.0.0]`: that folder, on loopback.
js_binary(
    name = "serve",
    data = [":dist"],
    entry_point = "serve.mjs",
)

# `bazel run //site:verify`: saved in Query, opened in DataCube, one origin and no server (Chromium).
js_binary(
    name = "verify",
    data = [
        ":dist",
        "//datacube:node_modules/playwright",
    ],
    entry_point = "verify.mjs",
    tags = ["browser-ci"],
)

guards_package()
