load("//tools/java:defs.bzl", "legend_java_library")
load("//tools/guards:defs.bzl", "guards_package")

# the main sources, as files: core's database-name guards read them (the dialect program's Phase 7, 2026-10-18)
filegroup(
    name = "main_java",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//core:__pkg__"],
)

# Test support shared by every module's tests: Runfile, a declared input found through Bazel's
# runfiles library (Bazel workplan P1-03), and Repo/Upstream, which P1-05 and P3-33 retire.
legend_java_library(
    name = "testing",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    testonly = True,
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "@rules_java//java/runfiles",
        # EmbeddedMongoDb makes the lanes' user through the driver (2026-10-17, docs/MONGODB_PLAN_2026_10_16.md §5.3)
        "@bson//jar",
        "@mongodb_driver_core//jar",
        "@mongodb_driver_sync//jar",
    ],
    runtime_deps = ["@bson_record_codec//jar"],
)

guards_package()
