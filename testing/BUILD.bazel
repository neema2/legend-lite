load("@rules_java//java:defs.bzl", "java_library")

# Test support shared by every module's tests: com.legend.testing.Repo, where a
# test finds the repository's files under Maven and under Bazel. JDK only.
java_library(
    name = "testing",
    testonly = True,
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
)
