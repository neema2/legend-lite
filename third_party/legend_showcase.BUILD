# One upstream Legend showcase project (MODULE.bazel: http_archive), as TEST INPUT only: an SDLC project in its
# Pure-file layout, one element per .pure file under <module>/src/main/pure/, as Studio opens it.
filegroup(
    name = "pure",
    srcs = glob(["*/src/main/pure/**/*.pure"]),
    visibility = ["//visibility:public"],
)
