diff -ru a/internal/native_image/rules.bzl b/internal/native_image/rules.bzl
--- a/internal/native_image/rules.bzl
+++ b/internal/native_image/rules.bzl
@@ -136,7 +136,31 @@
     }
 
     graal_actions = _wrap_actions_for_graal(ctx.actions)
-    if is_macos:
+
+    # Xcode's DEVELOPER_DIR and SDKROOT reach the action only when Bazel knows an Xcode. A Mac
+    # with Apple's Command Line Tools alone has none, and apple_support's wrapper then fails on an
+    # unset DEVELOPER_DIR; there, native-image runs as it does on Linux and finds the C toolchain
+    # through xcrun itself.
+    xcode_config = ctx.attr._xcode_config[apple_common.XcodeVersionConfig] if is_macos else None
+
+    if native_toolchain.sysroot and not is_windows:
+        # A hermetic C toolchain carries its libc and headers in a sysroot, which the toolchain's own
+        # compile and link actions pass as a flag. native-image calls the compiler itself, with none of
+        # those flags, from its own temporary directory: the launcher passes the sysroot, made absolute
+        # where the action starts. No shell.
+        sysroot_params = dict(run_params)
+        graal_tool = sysroot_params.pop("executable")
+        sysroot_args = ctx.actions.args()
+        sysroot_args.add(graal_tool.executable.path)
+        sysroot_args.add(native_toolchain.sysroot)
+        graal_actions.run(
+            executable = ctx.executable._sysroot_launcher,
+            arguments = [sysroot_args, args],
+            tools = [graal_tool],
+            **sysroot_params
+        )
+
+    elif is_macos and xcode_config.xcode_version() != None:
         xcode_args = ctx.actions.args()
 
