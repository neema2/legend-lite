# SDLC-lite (design S1, S21): legend-sdlc's REST API and lite's text routes, its RULES written once in
# Java (com.legend.sdlc.Sdlc over a Storage) and run two ways -- by the model home's server (HTTP over a
# git repository, with Depot-lite beside it) and in the page, compiled to WebAssembly (:page). One
# conformance suite holds both (sdlc-client/test/conformance.ts). The rules depend on no Pure code: their two
# Pure questions are answered by //sdlc-server/grammar, the one SDLC package that may see the compiler, which the
# server and the page wire in (docs/PROTOCOL_PROGRAM_2026_10_05.md, leg 7). Never the reverse.
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//tools/guards:defs.bzl", "guards_package")
load("//tools/java:defs.bzl", "legend_java_binary", "legend_java_library")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/teavm:defs.bzl", "teavm_wasm")

# THE RULES: TeaVM-safe by rule (no files, sockets, threads, reflection, java.security), so the same
# classes compile into the page's module. No compiler: //core is not visible to this package.
legend_java_library(
    name = "rules",
    srcs = glob(["src/main/java/com/legend/sdlc/*.java"]),
    # Python's model home (//native: docs/ONE_PLATFORM_PROGRAM_2026_10_12.md B3) runs these rules too, a third build
    visibility = [
        "//native:__pkg__",
        "//sdlc-server/grammar:__pkg__",
    ],
    deps = [
        "//base",
        # Depot's interface and resolver: SDLC asks Depot (as upstream's does), never the reverse
        "//depot-server:rules",
        "//json",
    ],
)

# A git repository on disk as the rules' Storage (design S16): the server's, and Python's model home's (//native: the
# same keys on disk, docs/ONE_PLATFORM_PROGRAM_2026_10_12.md B3). Files and zlib only: no sockets, no git binary.
legend_java_library(
    name = "git_storage",
    srcs = ["src/main/java/com/legend/sdlc/server/GitStorage.java"],
    visibility = ["//native:__pkg__"],
    deps = [
        ":rules",
        "//base",
    ],
)

# THE SERVER (JVM only): the rules behind the JDK's HTTP server, over a git repository on disk.
legend_java_library(
    name = "server_lib",
    srcs = glob(
        ["src/main/java/com/legend/sdlc/server/*.java"],
        exclude = ["src/main/java/com/legend/sdlc/server/GitStorage.java"],
    ),
    deps = [
        ":git_storage",
        ":rules",
        "//base",
        "//depot-server:rules",
        "//json",
        "//sdlc-server/grammar",
    ],
)

# `bazel run //sdlc-server:server -- --port 6100 --repo DIR [--user id[:Name]]`
legend_java_binary(
    name = "server",
    main_class = "com.legend.sdlc.server.SdlcServer",
    visibility = [
        "//:__pkg__",
        "//depot-client:__pkg__",
        "//sdlc-client:__pkg__",
        "//studio:__pkg__",
    ],
    runtime_deps = [":server_lib"],
)

legend_java_library(
    name = "page_boundary",
    srcs = glob(["src/main/java/com/legend/sdlc/page/*.java"]),
    resource_strip_prefix = "sdlc-server/src/main/resources",
    resources = ["src/main/resources/META-INF/services/org.teavm.classlib.ResourceSupplier"],
    deps = [
        ":rules",
        "//depot-server:rules",
        "//json",
        "//sdlc-server/grammar",
        # TeaVM's annotations, at compile time only
        "//tools/teavm:api",
    ],
)

# The page's SDLC and Depot: the rules and all they reach, compiled to WebAssembly.
teavm_wasm(
    name = "page",
    main_class = "com.legend.sdlc.page.SdlcPage",
    visibility = [
        "//:__pkg__",
        "//datacube:__pkg__",
        "//depot-client:__pkg__",
        "//query:__pkg__",
        "//sdlc-client:__pkg__",
        "//studio:__pkg__",
    ],
    deps = [
        ":page_boundary",
        "@maven_teavm//:org_teavm_teavm_classlib",
        "@maven_teavm//:org_teavm_teavm_jso",
    ],
)

# The repository the server writes by hand is git's: JGit (legend-sdlc's own git library, from the test pool)
# reads back every object, ref, history and file -- never the machine's git (no host program in a test).
# THE VERSIONS A SITE RELEASES (docs/ONE_CONNECTION_DESK_2026_10_28.md D5): read from its files at lite's dialect,
# answered by Depot beside the SDLC's own, never a person's version at their coordinates
junit_test(
    name = "released_versions_test",
    memory_mb = 768,
    size = "small",
    srcs = ["src/test/java/com/legend/sdlc/ReleasedVersionsTest.java"],
    select = ["--select-class=com.legend.sdlc.ReleasedVersionsTest"],
    deps = [
        ":rules",
        "//depot-server:rules",
        "//json",
        "//sdlc-server/grammar",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

junit_test(
    name = "git_repository_test",
    memory_mb = 768,
    size = "small",
    srcs = ["src/test/java/com/legend/sdlc/server/GitRepositoryTest.java"],
    select = ["--select-class=com.legend.sdlc.server.GitRepositoryTest"],
    deps = [
        ":git_storage",
        ":rules",
        ":server_lib",
        "//json",
        "//sdlc-server/grammar",
        "@maven_test//:org_eclipse_jgit_org_eclipse_jgit",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# The page's module as ONE directory (classes.wasm beside its runtime), so a test names it with one
# $(rlocationpath) (Bazel workplan P1-24; as //wasm:planner_dir).
copy_to_directory(
    name = "page_dir",
    srcs = [":page"],
    root_paths = ["sdlc-server/page"],
    visibility = [
        "//depot-client:__pkg__",
        "//sdlc-client:__pkg__",
        "//studio:__pkg__",
    ],
)

guards_package()
