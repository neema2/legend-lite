load("//tools/java:defs.bzl", "legend_java_library")
# The bottom of the repository: the null annotations every Java module carries
# (com.legend.base.Nullable / NonNull, the vocabulary //tools/nullaway checks). No dependencies,
# ever. It lived inside core until 2026-09-26; everything depends on it, core included.

package(default_visibility = ["//visibility:public"])

legend_java_library(
    name = "base",
    srcs = glob(["src/main/java/com/legend/base/*.java"]),
    visibility = ["//core:__pkg__", "//json:__pkg__", "//spec:__pkg__", "//warehouse:__pkg__"],
)
