load("//tools/java:defs.bzl", "legend_java_library")
load("//tools/guards:defs.bzl", "guards_package")
# The bottom of the repository: the null annotations every Java module carries
# (com.legend.base.Nullable / NonNull, the vocabulary //tools/nullaway checks). No dependencies,
# ever. It lived inside core until 2026-09-26; everything depends on it, core included.
# RunScope (2026-11-05, the deep audit's runtime wall): JDK-only like the annotations; the one place both the plan
# runner and the planning libraries (the SQL renderer, the lowerer, the compiler) can see, so a run can refuse planning.

package(default_visibility = ["//visibility:public"])

legend_java_library(
    name = "base",
    srcs = glob(["src/main/java/com/legend/base/*.java"]),
    # //arrow_ipc (2026-10-29, the result boundary program's track A): the Arrow IPC framer, on java.base and these
    # annotations alone
    visibility = ["//arrow_ipc:__pkg__", "//core:__pkg__", "//depot-server:__pkg__", "//json:__pkg__", "//sdlc-server:__pkg__", "//spec:__pkg__", "//warehouse:__pkg__"],
)

guards_package()
