# The reference dump as a BUILD OUTPUT: it depends only on the pinned jars and RefResolutions.java, so Bazel caches
# it and a lane run pays only our side and the join (plan W1.1). Not byte-reproducible: two runs on the same inputs
# differ (as the genrule did; Bazel workplan P2-14), so it is cached, never compared. ~35 s when it does run;
# built only for the manual //spec:reference_lane.
java_run(
    name = "ref_dump",
    testonly = True,
    outs = ["ref-resolutions.tsv"],
    arguments = [
        "{OUT}",
        "/core_relational/",
        "/platform/",
        "/core_functions_",
        "/core/",
    ],
    # the compiler's diagnostics go to the action's stderr, and a failure fails the action (Bazel workplan P1-22)
    jvm_flags = ["-Xss16m"],
    main_class = "RefResolutions",
    # peaks at 3,072 MB live (-Xlog:gc, macOS arm64, 2026-10-04); the genrule's -Xmx12g was never measured
    memory_mb = 8192,
    mnemonic = "ReferenceDump",
    tags = ["manual"],
    visibility = ["//spec:__pkg__"],
    deps = [":ref_resolutions"],
)

guards_package()
