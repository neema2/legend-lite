# THE REFERENCE LANE's reference side (execution plan W1.1): legend-pure's own compiler, run from the pinned
# @maven_upstream jars (4.145.0 / 5.99.0), compiles core_relational's 27-module closure and dumps what every call
# resolved to. Test input only (the reference-checkout tenet): nothing in //core depends on this. The H3 spike
# (2026-09-29) proved it: 35 s, 5.3 GB.

load("//tools/java_run:defs.bzl", "java_run")
load("//tools/java:defs.bzl", "legend_java_library")
load("//tools/guards:defs.bzl", "guards_package")

legend_java_library(
    name = "ref_resolutions",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    testonly = True,
    srcs = ["RefResolutions.java"],
    deps = [
        "@maven_upstream//:org_eclipse_collections_eclipse_collections",
        "@maven_upstream//:org_eclipse_collections_eclipse_collections_api",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_code_compiled_core",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_data_space_pure_metamodel",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_diagram_pure_metamodel",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_json_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_postgresSqlModel_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_postgresSqlModel_extensions_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_postgresSqlParser_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_sqlDialectTranslation_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_h2_sqlDialectTranslation_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_sqlPlanning_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_functions_json_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_functions_relation_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_functions_standard_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_functions_unclassified_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_functions_variant_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_dsl_generation_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_core_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_dsl_service_pure",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m2_dsl_diagram_pure",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m2_dsl_graph_pure",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m2_dsl_mapping_pure",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m2_dsl_path_pure",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m2_dsl_store_pure",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m2_dsl_tds_pure",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m3_precisePrimitives",
