load("//tools/java:defs.bzl", "legend_java_binary", "legend_java_library")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/guards:defs.bzl", "guards_package")

# TeaVM as a build action (defs.bzl, teavm_wasm). The compiler's jars come from
# @maven_teavm, build tooling that runs here and nowhere else.
# HEAP: compiling //wasm:planner peaks at 889 MB live (-Xlog:gc, macOS arm64, 2026-10-04); 2 GB is its heap
# here and its scheduling memory in defs.bzl (_teavm_memory), the same on every machine (Bazel workplan
# P1-22: it ran under the global --host_jvmopt=-Xmx3g before; the JVM default is a quarter of the RAM).
# 2g -> 3g (2026-11-03, the host executors program, docs/HOST_EXECUTORS_PROGRAM_2026_11_02.md: the planner grew --
# the result writers, the Arrow reader, the edge writers -- and its live set after marking measured about 1.8 GB at
# -Xmx2g (-Xlog:gc, linux x86_64, a cloud session); under 2g the action failed with OutOfMemoryError four times in a
# row there and passed by hand once: no headroom. 3g, the heap it had before P1-22, gives it back.)
legend_java_binary(
    name = "compile",
    srcs = ["TeaVmCompile.java"],
    jvm_flags = ["-Xmx3g"],
    main_class = "com.legend.tools.teavm.TeaVmCompile",
    visibility = ["//visibility:public"],
    deps = [
        ":data_offsets",
        "@maven_teavm//:org_teavm_teavm_core",
        "@maven_teavm//:org_teavm_teavm_tooling",
    ],
)

# PARK-40 (docs/PARKED_WORK_LEDGER.md, 2026-10-26): TeaVM 0.15.0 writes a data segment's offset unsigned where the
# specification reads it signed, so a module whose string pool passes 1 MiB (the planner's, at the merge of main) fails
# to load. JDK-only; :compile runs it over the module TeaVM wrote. It goes with the bump to TeaVM 0.16.0, with its test.
legend_java_library(
    name = "data_offsets",
    srcs = ["WasmDataOffsets.java"],
)

# The fixer held to the specification's encoding, and PARK-40's anchor: MODULE.bazel still pins the TeaVM whose
# offsets it corrects, so the bump turns this red and the fixer, this test and the ledger's row leave together.
junit_test(
    name = "data_offsets_test",
    memory_mb = 768,
    size = "small",
    srcs = ["test/WasmDataOffsetsTest.java"],
    data = ["//:MODULE.bazel"],
    jvm_flags = ["-Dteavm.module=$(rlocationpath //:MODULE.bazel)"],
    select = ["--select-class=com.legend.tools.teavm.WasmDataOffsetsTest"],
    deps = [
        ":data_offsets",
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# THE TEAVM SURFACE A MODULE'S JAVA NAMES AT COMPILE TIME ONLY: @JSExport (jso) and the ResourceSupplier SPI (core,
# the compiler's). neverlink: on a JVM the annotation is inert and nothing loads the SPI, so no JVM classpath carries
# them. One library for every module whose Java names them (2026-10-13: the four copies, one per package, in wasm,
# sdlc-server, query-store and warehouse made this one; docs/build-inventory/area7_report.md, wiring cleanup 7).
# Visible to the pool's users that build a module (tools/deps/pools.bzl, maven_teavm): a package that gains one is
# added there, with its reason, and here.
legend_java_library(
    name = "api",
    neverlink = True,
    nullaway = False,  # no sources: only exports
    visibility = [
        "//query-store:__pkg__",
        "//sdlc-server:__pkg__",
        "//warehouse:__pkg__",
        "//wasm:__pkg__",
    ],
    exports = [
        "@maven_teavm//:org_teavm_teavm_core",
        "@maven_teavm//:org_teavm_teavm_jso",
    ],
)

guards_package()
