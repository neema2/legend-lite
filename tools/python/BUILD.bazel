load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("@rules_python//python:py_test.bzl", "py_test")

# THE PYTHON DEPENDENCIES (Bazel workplan P1-07): requirements.in names them; requirements_lock.txt pins
# every one with its hashes. `bazel run //tools/python:requirements.update` is the only way the lock
# changes. Its own check, :requirements.test, re-resolves against PyPI (rules_python tags it
# requires-network), so it is manual: run it when this directory changes. The gate's check is offline.
compile_pip_requirements(
    name = "requirements",
    src = "requirements.in",
    requirements_txt = "requirements_lock.txt",
    tags = ["manual"],
)

# The lock holds every pin of requirements.in, at the same version, with hashes: offline, in the checks lane.
py_test(
    name = "lock_matches_requirements",
    size = "small",
    srcs = ["lock_matches_requirements.py"],
    args = [
        "$(rlocationpath requirements.in)",
        "$(rlocationpath requirements_lock.txt)",
    ],
    data = [
        "requirements.in",
        "requirements_lock.txt",
    ],
    deps = ["@rules_python//python/runfiles"],
)
