load("@rules_python//python:py_test.bzl", "py_test")
load("//tools/guards:defs.bzl", "guards_package")

# THE PYTHON DEPENDENCIES (Bazel workplan P1-07): //:pyproject.toml names them; //:uv.lock pins every one with its
# hashes (uv's lock since 2026-11-23; requirements.in and pip-compile's requirements_lock.txt, here, before it).
# `bazel run //:uv_lock.update` is the only way the lock changes.

# The lock holds every pin of pyproject.toml, at the same version, with hashes: offline, in the checks lane
# (lock_matches_requirements until 2026-11-23, the same check of pip-compile's lock; that lock's own network
# re-resolution, :requirements.test, went with it: uv's rule makes no test, and `uv lock --check` is the manual run).
py_test(
    name = "lock_matches_pyproject",
    size = "small",
    srcs = ["lock_matches_pyproject.py"],
    args = [
        "$(rlocationpath //:pyproject.toml)",
        "$(rlocationpath //:uv.lock)",
    ],
    data = [
        "//:pyproject.toml",
        "//:uv.lock",
    ],
    deps = ["@rules_python//python/runfiles"],
)

guards_package()
