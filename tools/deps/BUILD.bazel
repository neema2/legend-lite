# Guards on the build graph itself: who may reach which jars (MODULE.bazel, THE JAR
# POOLS). Bazel-only by nature — they check what Bazel resolves and links.
load("//tools/junit:defs.bzl", "junit_test")

# Every external jar the product reaches: core itself (NullAway subtracted — a
# compiler plugin, on javac's processor path, never on a classpath) and the
# drivers a running core is given.
genquery(
    name = "core_closure",
    expression = "kind(jvm_import, deps(//core:core) except deps(//tools/nullaway:nullaway))",
    opts = ["--noimplicit_deps"],
    scope = ["//core:core"],
)

# NullAway subtracted as for core: //core:duckdb_load (the drivers' bulk loader)
# compiles with it, and a compiler plugin is on javac's processor path, never on a
# running core's classpath (2026-09-23: its jsr305 read as a driver)
genquery(
    name = "drivers_closure",
    expression = "kind(jvm_import, deps(//core:drivers) except deps(//tools/nullaway:nullaway))",
    opts = ["--noimplicit_deps"],
    scope = ["//core:drivers"],
)

# spec reads the pinned checkouts as FILES and imports no upstream Java (its
# SpecBoundaryTest bans the imports; this bans the jars) — the half of the old
# gate 2 convergence check that pools alone do not make true.
genquery(
    name = "spec_closure",
    expression = "kind(jvm_import, deps(//spec:spec_tests_lib))",
    opts = ["--noimplicit_deps"],
    scope = ["//spec:spec_tests_lib"],
)

junit_test(
    name = "core_closure_test",
    size = "small",
    srcs = ["CoreClosureTest.java"],
    data = [
        ":core_closure",
        ":drivers_closure",
        ":spec_closure",
    ],
    select = ["--select-class=com.legend.tools.deps.CoreClosureTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# Every Java library the warehouse's API, JDBC client and server reach: //base and //json, and
# no //core target (WarehouseClosureTest).
genquery(
    name = "warehouse_closure",
    expression = "kind(java_library, deps(//warehouse:sqlapi + //warehouse:client + //warehouse:server_lib))",
    scope = [
        "//warehouse:client",
        "//warehouse:server_lib",
        "//warehouse:sqlapi",
    ],
)

junit_test(
    name = "warehouse_closure_test",
    size = "small",
    srcs = ["WarehouseClosureTest.java"],
    data = [":warehouse_closure"],
    select = ["--select-class=com.legend.tools.deps.WarehouseClosureTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

junit_test(
    name = "pools_are_disjoint",
    size = "small",
    srcs = ["PoolsAreDisjointTest.java"],
    data = [
        "//:maven_core_install.json",
        "//:maven_h2_modern_install.json",
        "//:maven_test_install.json",
        "//:maven_upstream_install.json",
    ],
    select = ["--select-class=com.legend.tools.deps.PoolsAreDisjointTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# one release: MODULE.bazel and tools/oracle-pins.env agree (//tools/bump writes both)
junit_test(
    name = "one_release",
    size = "small",
    srcs = ["OneReleaseTest.java"],
    data = [
        "//:MODULE.bazel",
        "//tools:oracle-pins.env",
    ],
    select = ["--select-class=com.legend.tools.deps.OneReleaseTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

