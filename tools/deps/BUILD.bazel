# Guards on the build graph itself: who may reach which jars (MODULE.bazel, THE JAR
# POOLS). Bazel-only by nature — they check what Bazel resolves and links.
load("//tools/junit:defs.bzl", "junit_test")
load(":pools.bzl", "POOLS", "TESTONLY_POOLS")

# Every external jar the product reaches: core itself (NullAway subtracted — a
# compiler plugin, on javac's processor path, never on a classpath) and the
# drivers a running core is given.
genquery(
    name = "core_closure",
    expression = "kind(jvm_import, deps(//core:core) except deps(//tools/nullaway:nullaway))",
    opts = ["--noimplicit_deps"],
    scope = ["//core:core"],
)

# NullAway subtracted as for core: //core:duckdb_load (the drivers' bulk loader)
# compiles with it, and a compiler plugin is on javac's processor path, never on a
# running core's classpath (2026-09-23: its jsr305 read as a driver)
genquery(
    name = "drivers_closure",
    expression = "kind(jvm_import, deps(//core:drivers) except deps(//tools/nullaway:nullaway))",
    opts = ["--noimplicit_deps"],
    scope = ["//core:drivers"],
)

# spec reads the pinned checkouts as FILES and imports no upstream Java (its
# SpecBoundaryTest bans the imports; this bans the jars) — the half of the old
# gate 2 convergence check that pools alone do not make true.
genquery(
    name = "spec_closure",
    expression = "kind(jvm_import, deps(//spec:spec_tests_lib))",
    opts = ["--noimplicit_deps"],
    scope = ["//spec:spec_tests_lib"],
)

junit_test(
    name = "core_closure_test",
    memory_mb = 768,
    size = "small",
    srcs = ["CoreClosureTest.java"],
    data = [
        ":core_closure",
        ":drivers_closure",
        ":spec_closure",
    ],
    jvm_flags = ["-Dclosure.%s=$(rlocationpath :%s)" % (c, c) for c in ["core_closure", "drivers_closure", "spec_closure"]],
    select = ["--select-class=com.legend.tools.deps.CoreClosureTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# Every Java library the warehouse's API, JDBC client and server reach: //base and //json, and
# no //core target (WarehouseClosureTest).
genquery(
    name = "warehouse_closure",
    expression = "kind(java_library, deps(//warehouse:sqlapi + //warehouse:client + //warehouse:server_lib))",
    scope = [
        "//warehouse:client",
        "//warehouse:server_lib",
        "//warehouse:sqlapi",
    ],
)

junit_test(
    name = "warehouse_closure_test",
    memory_mb = 768,
    size = "small",
    srcs = ["WarehouseClosureTest.java"],
    data = [":warehouse_closure"],
    jvm_flags = ["-Dclosure.warehouse_closure=$(rlocationpath :warehouse_closure)"],
    select = ["--select-class=com.legend.tools.deps.WarehouseClosureTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

junit_test(
    name = "pools_are_disjoint",
    memory_mb = 768,
    size = "small",
    srcs = ["PoolsAreDisjointTest.java"],
    data = [
        "//:maven_core_install.json",
        "//:maven_h2_modern_install.json",
        "//:maven_test_install.json",
        "//:maven_upstream_install.json",
    ],
    jvm_flags = ["-Dlock.%s=$(rlocationpath //:maven_%s_install.json)" % (p, p) for p in ["core", "h2_modern", "test", "upstream"]],
    select = ["--select-class=com.legend.tools.deps.PoolsAreDisjointTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# one release: MODULE.bazel and tools/oracle-pins.env agree (//tools/bump writes both)
junit_test(
    name = "one_release",
    memory_mb = 768,
    size = "small",
    srcs = ["OneReleaseTest.java"],
    data = [
        "//:MODULE.bazel",
        "//tools:oracle-pins.env",
    ],
    jvm_flags = [
        "-Dmodule.bazel=$(rlocationpath //:MODULE.bazel)",
        "-Doracle.pins=$(rlocationpath //tools:oracle-pins.env)",
    ],
    select = ["--select-class=com.legend.tools.deps.OneReleaseTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# THE LAYERS OF //core (execution plan rule 0.12): each product library's direct dependencies, as Bazel resolves
# them, one genquery per target; CoreLayeringTest compares them with core-layers.txt.
_CORE_LAYERS = [
    "spi", "cache", "values", "error", "lexer", "sql", "protocol", "model", "parser", "builtin", "platform",
    "compiler_element_type", "sql_dialect", "database", "compiler", "normalizer", "lineage", "validation", "lowering", "plan",
    "resolver", "exec", "probe", "testdatagen", "driver", "ide", "test", "server_lib",
]

[genquery(
    name = "layer_" + t,
    expression = "labels(deps, //core:%s)" % t,
    scope = ["//core:" + t],
) for t in _CORE_LAYERS]

junit_test(
    name = "core_layering_test",
    memory_mb = 768,
    size = "small",
    srcs = ["CoreLayeringTest.java"],
    data = ["core-layers.txt"] + [":layer_" + t for t in _CORE_LAYERS],
    jvm_flags = [
        "-Dcore.layers=$(rlocationpath core-layers.txt)",
        "-Dcore.layer.files=" + ",".join(["$(rlocationpath :layer_%s)" % t for t in _CORE_LAYERS]),
    ],
    select = ["--select-class=com.legend.tools.deps.CoreLayeringTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# tools/deps/pools.bzl's pools are exactly MODULE.bazel's (Bazel workplan P1-25)
junit_test(
    name = "pools_list_test",
    memory_mb = 768,
    size = "small",
    srcs = ["PoolsListTest.java"],
    data = ["//:MODULE.bazel"],
    jvm_flags = [
        "-Dmodule.bazel=$(rlocationpath //:MODULE.bazel)",
        "-Dpools=" + ",".join(POOLS),
    ],
    select = ["--select-class=com.legend.tools.deps.PoolsListTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# WHAT SHIPS (Bazel workplan P1-25, tools/deps/pools.bzl layer 3): every jar the shipped roots reach, through every
# attribute and every select() branch. A new shipped binary is added here.
_SHIPPED = [
    "//core:core",
    "//core:drivers",
    "//core:server",
    "//datacube:app_posix",
    "//datacube:app_windows",
    "//warehouse:serve_posix",
    "//warehouse:serve_windows",
    "//warehouse:server",
    "//warehouse:server_native",
    "//wasm:planner",
]

genquery(
    name = "product_closure",
    expression = "kind(jvm_import, deps(%s))" % " + ".join(_SHIPPED),
    opts = ["--noimplicit_deps"],
    scope = _SHIPPED,
)

junit_test(
    name = "product_closure_test",
    memory_mb = 768,
    size = "small",
    srcs = ["ProductClosureTest.java"],
    data = [":product_closure"],
    jvm_flags = [
        "-Dclosure.product_closure=$(rlocationpath :product_closure)",
        "-Dforbidden.pools=" + ",".join(TESTONLY_POOLS + ["maven_test"]),
    ],
    select = ["--select-class=com.legend.tools.deps.ProductClosureTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)
