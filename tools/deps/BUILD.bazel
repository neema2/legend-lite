# Guards on the build graph itself: who may reach which jars (MODULE.bazel, THE JAR
# POOLS). Bazel-only by nature — they check what Bazel resolves and links.
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@repo_inventory//:packages.bzl", "PACKAGES")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/js:defs.bzl", "node_test")
load(":pools.bzl", "POOLS", "TESTONLY_POOLS")
load("//tools/guards:defs.bzl", "guards_package")

# Every external jar the product reaches: core itself (NullAway subtracted — a
# compiler plugin, on javac's processor path, never on a classpath) and the
# drivers a running core is given.
genquery(
    name = "core_closure",
    expression = "kind(\"jvm_import|java_import\", deps(//core:core) except deps(//tools/nullaway:nullaway))",
    opts = ["--noimplicit_deps"],
    scope = ["//core:core"],
)

# NullAway subtracted as for core: //core:duckdb_cells (the drivers' DuckDB cell types)
# compiles with it, and a compiler plugin is on javac's processor path, never on a
# running core's classpath (2026-09-23: its jsr305 read as a driver)
genquery(
    name = "drivers_closure",
    expression = "kind(\"jvm_import|java_import\", deps(//core:drivers) except deps(//tools/nullaway:nullaway))",
    opts = ["--noimplicit_deps"],
    scope = ["//core:drivers"],
)

# spec reads the pinned checkouts as FILES and imports no upstream Java (its
# SpecBoundaryTest bans the imports; this bans the jars) — the half of the old
# gate 2 convergence check that pools alone do not make true.
genquery(
    name = "spec_closure",
    expression = "kind(\"jvm_import|java_import\", deps(//spec:spec_tests_lib))",
    opts = ["--noimplicit_deps"],
    scope = ["//spec:spec_tests_lib"],
)

junit_test(
    name = "core_closure_test",
    memory_mb = 768,
    size = "small",
    srcs = ["CoreClosureTest.java"],
    data = [
        ":core_closure",
        ":drivers_closure",
        ":spec_closure",
    ],
    jvm_flags = ["-Dclosure.%s=$(rlocationpath :%s)" % (c, c) for c in ["core_closure", "drivers_closure", "spec_closure"]],
    select = ["--select-class=com.legend.tools.deps.CoreClosureTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# Every Java library the warehouse's API, JDBC client and server reach: //base and //json, and
# no //core target (WarehouseClosureTest).
genquery(
    name = "warehouse_closure",
    expression = "kind(java_library, deps(//warehouse:sqlapi + //warehouse:client + //warehouse:server_lib))",
    scope = [
        "//warehouse:client",
        "//warehouse:server_lib",
        "//warehouse:sqlapi",
    ],
)

junit_test(
    name = "warehouse_closure_test",
    memory_mb = 768,
    size = "small",
    srcs = ["WarehouseClosureTest.java"],
    data = [":warehouse_closure"],
    jvm_flags = ["-Dclosure.warehouse_closure=$(rlocationpath :warehouse_closure)"],
    select = ["--select-class=com.legend.tools.deps.WarehouseClosureTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# NO ARROW LIBRARY IN THE PRODUCT (the result boundary program's R9; track A, 2026-10-29): the planner's plan side, the
# WebAssembly planner's Java, the native library's Java and the warehouse server reach no external repository named
# for Arrow; the framer (//arrow_ipc) reaches //base alone (ArrowClosureTest).
[genquery(
    name = name + "_closure",
    # NullAway subtracted as for core's closure: a compiler plugin, on javac's processor path, never on a classpath
    expression = "kind(\"java_library|jvm_import|java_import|http_jar|.*_library\", deps(%s) except deps(//tools/nullaway:nullaway))" % target,
    opts = ["--noimplicit_deps"],
    scope = [target],
) for name, target in [
    ("plan_side", "//core:plan_side"),
    # the module: its entry class is :tab's (lite's own, planner.TabExports: the user's K2 ruling, 2026-11-18; :edge_tab's
    # from the census's A1, 2026-11-17, until then), so its closure is the module's
    ("wasm", "//wasm:tab"),
    # the engine module (K2, 2026-11-18): legend-engine's routes in the tab, its entry :edge_tab's -- the Arrow answer
    # written by lite's own framer there too
    ("wasm_engine", "//wasm:edge_tab"),
    ("native", "//native:entry"),
    ("native_image", "//warehouse:server_lib"),
    ("arrow_ipc", "//arrow_ipc"),
]]

junit_test(
    name = "arrow_closure_test",
    memory_mb = 768,
    size = "small",
    srcs = ["ArrowClosureTest.java"],
    data = [":%s_closure" % c for c in ["plan_side", "wasm", "wasm_engine", "native", "native_image", "arrow_ipc"]],
    jvm_flags = ["-Dclosure.%s_closure=$(rlocationpath :%s_closure)" % (c, c) for c in ["plan_side", "wasm", "wasm_engine", "native", "native_image", "arrow_ipc"]],
    select = ["--select-class=com.legend.tools.deps.ArrowClosureTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# THE LAYERS OF //core (execution plan rule 0.12): each product library's direct dependencies, as Bazel resolves
# them, one genquery per target; CoreLayeringTest compares them with core-layers.txt.
junit_test(
    name = "core_layering_test",
    memory_mb = 768,
    size = "small",
    srcs = ["CoreLayeringTest.java"],
    data = [
        "core-layers.txt",
        "//core:layer_queries",
    ],
    # every core library's layer query (core/layers.bzl), as a list: an environment variable keeps it one value
    env = {"CORE_LAYER_FILES": "$(rlocationpaths //core:layer_queries)"},
    jvm_flags = ["-Dcore.layers=$(rlocationpath core-layers.txt)"],
    select = ["--select-class=com.legend.tools.deps.CoreLayeringTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# THE APPS' LIBRARIES REACH NO RUN LAYER (the C5-T last round's T1, 2026-11-15): every target an app depends on directly
# that is no layer and no app -- the SDLC's client, the Depot's, the query store, the model writer, the art, the protocol
# and the npm packages -- with all it reaches, met with the run side: empty, or an app reaches the run side past its doors
# (TsLayeringTest.noLibraryOfAnAppReachesTheRunSide)
genquery(
    name = "app_libraries_run",
    expression = ("deps(labels(deps, //datacube:src_base + //query:src + //studio:src) except " +
                  "(//datacube:doors + //datacube:model + //datacube:planner + //datacube:records + //datacube:src + " +
                  "//engine-client:doors + //engine-client:planner + //engine-client:records + " +
                  "//query:src)) intersect (//engine-client:run + //datacube:run + //engine-client:engine_client + " +
                  "//engine-client:node_host)"),
    scope = [
        "//datacube:src",
        "//engine-client:engine_client",
        "//query:src",
        "//studio:src",
    ],
)

# THE EDGE IN NO APP (H11, 2026-11-17: lite's API v1 spec §6, "no product module depends on the edge"): legend-engine's
# API in TypeScript (//engine-client:edge) met with everything an app reaches, through a layer or a library: empty
# (TsLayeringTest.noAppReachesTheEdge)
genquery(
    name = "app_edge_reach",
    # (2026-11-17, H11, DataCube's half: and no app reaches DataCube's compat entry)
    expression = "deps(//datacube:src + //query:src + //studio:src) intersect (//engine-client:edge + //datacube:edge_entry)",
    scope = [
        "//datacube:edge_entry",
        "//datacube:src",
        "//engine-client:edge",
        "//query:src",
        "//studio:src",
    ],
)

_TS_LAYER_QUERIES = [
    "//datacube:layer_queries",
    "//engine-client:layer_queries",
    "//model-changes:layer_records",
    "//query:layer_src",
    "//sdlc-client:layer_records",
    "//studio:layer_src",
]

# THE LAYERS OF THE TYPESCRIPT HOSTS (C5-T, 2026-11-15): each TypeScript layer's direct deps, as Bazel resolves them,
# one genquery per layer beside it; TsLayeringTest compares them with ts-layers.txt, and holds a run layer to records
# and npm alone and a planner to nothing that executes.
junit_test(
    name = "ts_layering_test",
    memory_mb = 768,
    size = "small",
    srcs = ["TsLayeringTest.java"],
    data = ["ts-layers.txt", ":app_edge_reach", ":app_libraries_run"] + _TS_LAYER_QUERIES,
    # every layer's query, as a list: an environment variable keeps it one value
    env = {"TS_LAYER_FILES": " ".join(["$(rlocationpaths %s)" % q for q in _TS_LAYER_QUERIES])},
    jvm_flags = [
        "-Dts.layers=$(rlocationpath ts-layers.txt)",
        "-Dapp.libraries.run=$(rlocationpath :app_libraries_run)",
        "-Dapp.edge.reach=$(rlocationpath :app_edge_reach)",
    ],
    select = ["--select-class=com.legend.tools.deps.TsLayeringTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# EACH TYPESCRIPT LAYER ALONE (C5-T, 2026-11-15: the rule that replaces the interim run wall): a layer's closure, and
# nothing else, copied out and typechecked strict by the pinned compiler (layer-alone.test.ts) -- a module of the layer
# that imports one of a layer it may not reach fails by name (TS2307), a planted one proves it; none of those layers'
# files is in the closure; and a run or server layer opens no import door chosen at run time, a door layer only the
# vendor loads named (2026-11-15, the C5-T fold-in: the two vendor loads moved out of the run layer into their doors).
# The apps' own files, which no layer holds
_APPS = " + ".join(["//datacube:src", "//query:src", "//studio:src"])

# 2026-11-17 (H11): legend-engine's API, the edge (//engine-client:edge), in every layer's never-list -- no product
# layer's closure holds an edge file; the planner's and the server's expected files left with the files that moved
# (planning-client.ts and legend/engine.ts are the edge's): the planner's protocol and the server's planning half instead
_LAYERS_ALONE = {
    # name: (layer, kind, the layers it must never hold, its own files expected, the closure's floor, the planted
    # module, what the plant imports)
    "engine_client_run": (
        "//engine-client:run",
        "run",
        "//engine-client:planner + //engine-client:doors + //engine-client:node_host + //engine-client:edge",
        ["engine-client/src/plan-runner.ts", "engine-client/src/duckdb.ts", "engine-client/src/requests.ts", "pure-protocol/src/index.ts"],
        35,
        "engine-client/src/planted.ts",
        # 2026-11-15 (the C5-T audit's items 3 and 8): the planner's protocol and Grammar, and Node's require, planted too
        ["./legend/wasm-grammar.ts", "./legend/engine.ts", "./doors/tab-duckdb.ts", "./legend/planner-protocol.ts",
         "./legend/grammar.ts", "./node-require.ts"],
    ),
    "engine_client_planner": (
        "//engine-client:planner",
        "planner",
        # 2026-11-15 (the C5-T final audit's MUST 1): the engine's API too -- an engine's interface, the run frame
        "//engine-client:run + //engine-client:doors + //engine-client:engine_api + //engine-client:node_host + //engine-client:edge",
        ["engine-client/src/legend/wasm-grammar.ts", "engine-client/src/legend/planner-protocol.ts", "engine-client/src/requests.ts",
         "engine-client/src/plan-guard.ts"],
        25,
        "engine-client/src/legend/planted.ts",
        ["../plan-runner.ts", "./engine.ts", "../doors/project-data.ts", "../run-frame.ts", "../query-engine.ts"],
    ),
    # (2026-11-17, H11, DataCube's half: engine_client_server is deleted with the server layer -- its one file,
    # legend-engine's pure/v1 client, is the edge's, checked by the edge's own target)
    # 2026-11-15 (the same audit): the engine's API alone -- records and itself, no run module, planner, server or door
    "engine_client_engine_api": (
        "//engine-client:engine_api",
        "run",
        "//engine-client:run + //engine-client:planner + //engine-client:doors + //engine-client:node_host + //engine-client:edge",
        ["engine-client/src/query-engine.ts", "engine-client/src/run-frame.ts", "engine-client/src/plan-guard.ts"],
        10,
        "engine-client/src/planted.ts",
        ["./duckdb.ts", "./legend/wasm-grammar.ts", "./pure-v1.ts", "./doors/tab-duckdb.ts"],
    ),
    "datacube_run": (
        "//datacube:run",
        "run",
        "//engine-client:planner + //engine-client:doors + //engine-client:node_host + //datacube:planner + //datacube:doors + //datacube:model + //engine-client:edge",
        ["datacube/src/headless/connection.ts", "datacube/src/headless/calls.ts", "engine-client/src/plan-runner.ts"],
        35,
        "datacube/src/headless/planted.ts",
        ["../lite-planner.ts", "./host.ts", "../runner.ts", "../../../engine-client/src/legend/planner-protocol.ts"],
    ),
    # 2026-11-15 (the C5-T last round's T2): the door layers, checked alone too -- every layer below them, no app, and
    # no explicit any reaching a send
    "engine_client_doors": (
        "//engine-client:doors",
        "doors",
        "//engine-client:node_host + //datacube:src_base + //engine-client:edge",
        ["engine-client/src/doors/tab-duckdb.ts", "engine-client/src/snap.ts", "engine-client/src/plan-runner.ts"],
        60,
        "engine-client/src/doors/planted.ts",
        ["../../../datacube/src/cube.ts", "../../../query/src/app/run.ts", "../node-require.ts"],
    ),
    "datacube_doors": (
        "//datacube:doors",
        "doors",
        "//engine-client:node_host + //datacube:src_base + //engine-client:edge",
        ["datacube/src/runner.ts", "datacube/src/upload.ts", "engine-client/src/doors/host-operations.ts"],
        70,
        "datacube/src/planted.ts",
        ["./cube.ts", "./app.ts", "../../engine-client/src/node-require.ts"],
    ),
    "datacube_planner": (
        "//datacube:planner",
        "planner",
        "//engine-client:run + //engine-client:doors + //engine-client:engine_api + //datacube:run + //datacube:doors + //engine-client:edge",
        ["datacube/src/lite-planner.ts", "datacube/src/planner.ts", "engine-client/src/legend/planner-answer.ts"],
        30,
        "datacube/src/planted.ts",
        ["../../engine-client/src/plan-runner.ts", "./cube.ts", "./headless/connection.ts",
         "../../engine-client/src/run-frame.ts"],
    ),
}

[genquery(
    name = name + "_never",
    expression = "labels(srcs, %s + %s)" % (never, _APPS),
    scope = [label.strip() for label in (never + " + " + _APPS).split("+")],
) for name, (_, _, never, _, _, _, _) in _LAYERS_ALONE.items()]

# the computed-specifier scanner, one module that //tools/deps:layers_alone and //tools/deps:app_runs_test both read a
# door with (2026-11-15, the C5-T review's S1 and B5)
js_library(
    name = "computed_doors",
    srcs = ["computed-doors.mts"],
)

# the planner layers' and the doors' own files: a named computed load is a planner's or a door's by the target that
# holds its module (2026-11-15, the C5-T review's S1 and B1), never by a path's prefix
genquery(
    name = "planner_layer_srcs",
    expression = "labels(srcs, //engine-client:planner + //datacube:planner)",
    scope = [
        "//datacube:planner",
        "//engine-client:planner",
    ],
)

genquery(
    name = "door_layer_srcs",
    expression = "labels(srcs, //engine-client:doors + //datacube:doors)",
    scope = [
        "//datacube:doors",
        "//engine-client:doors",
    ],
)

# each layer's own files: a named computed load of one of them is read in that layer's closure, or the row is dead
# (2026-11-15, the C5-T review's B2)
[genquery(
    name = name + "_own",
    expression = "labels(srcs, %s)" % layer,
    scope = [layer],
) for name, (layer, _, _, _, _, _, _) in _LAYERS_ALONE.items()]

[node_test(
    name = name + "_alone_test",
    size = "small",
    data = [
        layer,
        ":%s_never" % name,
        ":%s_own" % name,
        ":computed_doors",
        ":door_layer_srcs",
        ":planner_layer_srcs",
        "//datacube:node_modules/@types/node",
        "//datacube:node_modules/typescript",
    ],
    entry_point = "layer-alone.test.ts",
    env = {
        "EXPECT_FILES": " ".join(expect),
        "KIND": kind,
        "LAYER": layer,
        "MIN_FILES": str(floor),
        "NOT_LAYER_SRCS": "$(rlocationpath :%s_never)" % name,
        "DOOR_SRCS": "$(rlocationpath :door_layer_srcs)",
        "OWN_SRCS": "$(rlocationpath :%s_own)" % name,
        "PLANNER_SRCS": "$(rlocationpath :planner_layer_srcs)",
        "PLANT_AT": plant,
        "PLANT_IMPORTS": " ".join(imports),
        # the package's link and the store's files it reaches: the test runs the link's bin/tsc
        "TYPESCRIPT": "$(rlocationpaths //datacube:node_modules/typescript)",
    },
) for name, (layer, kind, never, expect, floor, plant, imports) in _LAYERS_ALONE.items()]

test_suite(
    name = "layers_alone",
    tests = [":%s_alone_test" % name for name in _LAYERS_ALONE],
)

# THE APPS' PLAN-AND-RUN SITES, A SHRINK-ONLY CENSUS (the C5-T audit's MUST 2, 2026-11-15: the interim run wall's ratchet
# restored over what no layer holds): every site of DataCube's, Query's and Studio's own code that runs -- outside the
# doors' and the run targets' own files -- named by file and count, with its reason (app-runs.test.ts). A new app module
# that plans and runs fails here; each that remains is a call of a door.
genquery(
    name = "app_runs_layered",
    # 2026-11-15 (the C5-T final audit's MUST 1): engine-client's run side and doors too -- the census reads its records,
    # planner and server
    # 2026-11-17 (H11): and the edge, legend-engine's API, which asks its planner and runs as a door does
    # 2026-11-17 (H11, DataCube's half): and DataCube's compat entry, whose legend-engine planner runs by design
    expression = "labels(srcs, //datacube:run + //datacube:doors + //engine-client:run + //engine-client:doors + //engine-client:engine_api + //engine-client:node_host + //engine-client:edge + //datacube:edge_entry)",
    scope = [
        "//datacube:doors",
        "//datacube:edge_entry",
        "//datacube:run",
        "//engine-client:doors",
        "//engine-client:edge",
        "//engine-client:engine_api",
        "//engine-client:node_host",
        "//engine-client:run",
    ],
)

# the edge's own files (H11, 2026-11-17): legend-engine's API in TypeScript, which no product module reaches
# (//tools/deps:app_runs_test)
genquery(
    name = "edge_layer_srcs",
    # (2026-11-17, H11, DataCube's half: and DataCube's compat entry, edge-side -- no product module imports its files)
    expression = "labels(srcs, //engine-client:edge + //datacube:edge_entry)",
    scope = [
        "//datacube:edge_entry",
        "//engine-client:edge",
    ],
)

# the run layers' own files (the C5-T last round's T1): what no app module imports, nor reaches through a re-export
genquery(
    name = "run_layer_srcs",
    expression = "labels(srcs, //engine-client:run + //datacube:run)",
    scope = [
        "//datacube:run",
        "//engine-client:run",
    ],
)

node_test(
    name = "app_runs_test",
    size = "small",
    data = [
        ":app_runs_layered",
        ":computed_doors",
        ":edge_layer_srcs",
        ":planner_layer_srcs",
        ":run_layer_srcs",
        "//datacube:pages",
        "//datacube:sources",
        # the packages an app imports, so the re-export walk reads each module it follows (the C5-T final audit's item 6)
        "//depot-client:depot_client",
        "//engine-client:sources",
        "//legend-art:legend_art",
        "//model-changes:model_changes",
        "//model-changes:records",
        "//pure-protocol:pure_protocol",
        "//query:pages",
        "//query:src",
        "//query-store:query_store",
        "//sdlc-client:records",
        "//sdlc-client:sdlc_client",
        "//studio:pages",
        "//studio:src",
    ],
    entry_point = "app-runs.test.ts",
    env = {
        "EDGE_SRCS": "$(rlocationpath :edge_layer_srcs)",
        "LAYERED_SRCS": "$(rlocationpath :app_runs_layered)",
        "PLANNER_SRCS": "$(rlocationpath :planner_layer_srcs)",
        "RUN_SRCS": "$(rlocationpath :run_layer_srcs)",
        "SOURCES": "$(rlocationpaths //datacube:sources) $(rlocationpaths //engine-client:sources) $(rlocationpaths //query:src) $(rlocationpaths //studio:src) $(rlocationpaths //datacube:pages) $(rlocationpaths //query:pages) $(rlocationpaths //studio:pages) $(rlocationpaths //depot-client:depot_client) $(rlocationpaths //legend-art:legend_art) $(rlocationpaths //model-changes:model_changes) $(rlocationpaths //model-changes:records) $(rlocationpaths //pure-protocol:pure_protocol) $(rlocationpaths //query-store:query_store) $(rlocationpaths //sdlc-client:records) $(rlocationpaths //sdlc-client:sdlc_client)",
    },
)

# Every module a browser bundle reads is one it declares (2026-11-15, the C5-T final audit's finding from the Java
# worker's gate: //engine-client:planner_worker read a file it did not declare, which esbuild found outside the sandbox
# only when another action had copied it). Each bundle's metafile and declared files, from every package
# (guards_package's guard_bundles), so a new bundle is read without a list to update.
filegroup(
    name = "bundle_inputs",
    testonly = True,
    srcs = ["//%s:guard_bundles" % p for p in PACKAGES],
)

node_test(
    name = "bundle_inputs_test",
    size = "small",
    data = [":bundle_inputs"],
    entry_point = "bundle-inputs.test.ts",
    env = {"BUNDLE_INPUTS": "$(rlocationpaths :bundle_inputs)"},
)

# tools/deps/pools.bzl's pools are exactly MODULE.bazel's, and its testonly pools are testonly as a whole (Bazel workplan P1-25)
junit_test(
    name = "pools_list_test",
    memory_mb = 768,
    size = "small",
    srcs = ["PoolsListTest.java"],
    data = ["//:module_files"],
    env = {"MODULE_FILES": "$(rlocationpaths //:module_files)"},
    jvm_flags = [
        "-Dpools=" + ",".join(POOLS),
        "-Dtestonly.pools=" + ",".join(TESTONLY_POOLS),
    ],
    select = ["--select-class=com.legend.tools.deps.PoolsListTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

guards_package()

# THE PRODUCT'S TESTS REACH NO EDGE (Phase 7's build half, F's separation census lines A5/A6, 2026-11-17): every
# //core test target not tagged edge_test, with the product test library and its cases, and all they reach, met with
# the edge's targets -- empty (the closure is //core:product_test_targets_closure, made last in core/BUILD.bazel so a
# new product test target is covered unasked). The edge's own tests run in the targets tagged edge_test
# (core/edge_tests.bzl); EdgeSeparationClosureTest.productTestsReachNoEdge.
junit_test(
    name = "edge_separation_closure_test",
    memory_mb = 768,
    size = "small",
    srcs = ["EdgeSeparationClosureTest.java"],
    data = ["//core:product_test_targets_closure"],
