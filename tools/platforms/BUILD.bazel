# THE PLATFORMS (Bazel workplan P1-19): every platform config_setting the repository selects on lives here;
# tools/platforms/defs.bzl holds the selects over them.
load("//tools/guards:defs.bzl", "guards_package")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "windows_aarch64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

# A platform the native targets do not support (A25): Linux on s390x, which has a Java runtime (rules_js's
# esbuild choice is ambiguous on ppc64le). Every non-test target of //warehouse, //pct and //datacube must
# analyze for it, the native, DuckDB, pyarrow, Chromium and Postgres ones skipped as incompatible, never failing on a
# select. Tests are left out: Bazel 9 resolves a test's
# toolchain for a platform that can run it before it sees an incompatible dependency.
#   S='//warehouse/... + //pct/... + //datacube/...'
#   bazel build --nobuild --skip_incompatible_explicit_targets --platforms=//tools/platforms:unlisted_test \
#     $(bazel query "($S) except tests($S) except kind(test_suite, $S)" | grep -v '\.aspect_rules_js')
platform(
    name = "unlisted_test",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:s390x",
    ],
)

guards_package()
