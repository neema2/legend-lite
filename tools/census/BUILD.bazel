# THE RENDER CENSUS (README.md): every recorded case lowered once and rendered by each dialect, as a program over
# this checkout's core (Bazel workplan P3-17). One side of a comparison:
#   bazel run //tools/census:render_census -- <out.tsv> <cases.tsv>...
# run at each of two commits over the same cases, then diff the two outputs.

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//tools/java:defs.bzl", "legend_java_binary")
load("//tools/guards:defs.bzl", "guards_package")

# hand tools, run by a person: manual (2026-10-07, PHASE_8.md Gen-5), so a wildcard build does not build them; CI's
# product job still analyses them by name
legend_java_binary(
    name = "render_census",
    srcs = ["RenderCensus.java"],
    jvm_flags = ["-Xss16m"],
    main_class = "RenderCensus",
    tags = ["manual"],
    deps = ["//core"],
)

# The execution census, compared (README.md): two runs' lane logs as multisets of lines after removing run-to-run noise.
#   bazel run //tools/census:lanes_diff -- <base dir> <head dir> [examples]
py_binary(
    name = "lanes_diff",
    srcs = ["lanes_diff.py"],
    tags = ["manual"],
)

# the hand tools compile (the build rebuild's L1b): the checks lane builds them, nothing runs
build_test(
    name = "tools_build_test",
    targets = [
        ":lanes_diff",
        ":render_census",
    ],
)

guards_package()
