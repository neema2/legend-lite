load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/java:defs.bzl", "legend_java_binary", "legend_java_library")
load("//tools/java_run:defs.bzl", "java_run")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/guards:defs.bzl", "guards_package")

# The engine runner (README.md): the real legend-engine over .pure sources, beside
# legend-lite's core. Its jars are its own pool, @maven_runner (MODULE.bazel).
_RUNNER_RUNTIME = [
    "@maven_runner//:org_finos_legend_engine_legend_engine_language_pure_grammar",
    "@maven_runner//:org_finos_legend_engine_legend_engine_language_pure_compiler",
    "@maven_runner//:org_finos_legend_engine_legend_engine_language_pure_modelManager",
    "@maven_runner//:org_finos_legend_engine_legend_engine_executionPlan_generation",
    "@maven_runner//:org_finos_legend_engine_legend_engine_extensions_collection_generation",
    "@maven_runner//:org_finos_legend_engine_legend_engine_extensions_collection_execution",
    "@maven_runner//:org_finos_legend_engine_legend_engine_xt_relationalStore_executionPlan_connection",
    "@maven_runner//:com_h2database_h2",
    "@maven_runner//:org_finos_legend_engine_legend_engine_test_runner_mapping",
    "@maven_runner//:org_finos_legend_engine_legend_engine_test_runner_function",
    "@maven_runner//:org_finos_legend_engine_legend_engine_xt_relationalStore_duckdb_execution",
    "@maven_runner//:org_duckdb_duckdb_jdbc",
    "@maven_runner//:org_finos_legend_engine_legend_engine_xt_relationalStore_athena_grammar",
    "@maven_runner//:org_finos_legend_engine_legend_engine_xt_relationalStore_oracle_grammar",
    "@maven_runner//:org_finos_legend_engine_legend_engine_xt_relationalStore_aurora_grammar",
    "@maven_runner//:org_finos_legend_engine_legend_engine_xt_relationalStore_memsql_grammar",
]

_RUNNER_DEPS = [
    "@maven_runner//:org_finos_legend_engine_legend_engine_test_runner_service",
    "@maven_runner//:org_finos_legend_engine_legend_engine_language_pure_grammar",
    "@maven_runner//:org_finos_legend_engine_legend_engine_language_pure_compiler",
    "@maven_runner//:org_finos_legend_engine_legend_engine_protocol_pure",
    "@maven_runner//:org_finos_legend_engine_legend_engine_shared_core",
    "@maven_runner//:org_finos_legend_engine_legend_engine_testable",
    "@maven_runner//:org_finos_legend_engine_legend_engine_language_pure_dsl_service",
    "@maven_runner//:org_antlr_antlr4_runtime",
]

legend_java_library(
    name = "runner",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = glob(["src/main/java/**/*.java"], exclude = ["src/main/java/perf/TokenDump.java"]),
    # legend-engine's jars are testonly (MODULE.bazel), so this is: a test tool, never shipped; `bazel run` still works
    testonly = True,
    runtime_deps = _RUNNER_RUNTIME,
    deps = ["//core"] + _RUNNER_DEPS,
)

# TokenDump alone, over the runner's jars without core: it reads every jar on its class path, and ours carry no lexer
# vocabulary, so the record is the same and a core change never reruns it
legend_java_library(
    name = "token_dump",
    # not yet written to the null discipline (Bazel workplan P1-20), as :runner, whose file it was
    nullaway = False,
    srcs = ["src/main/java/perf/TokenDump.java"],
    testonly = True,
    runtime_deps = _RUNNER_RUNTIME,
    deps = _RUNNER_DEPS,
)

[legend_java_binary(
    name = name,
    testonly = True,
    main_class = "perf." + main,
    runtime_deps = [":runner"],
) for (name, main) in [
    ("testable", "TestableMain"),
    ("parse", "ParseMain"),
    ("lite_parse", "LiteParseMain"),
]]

# vocab.tsv: every literal token the runner's lexers know, at the pinned release (TokenDump over the runner's jars),
# kept as an upgrade's record. `bazel run //tools/engine-runner:update_vocab` writes it (Bazel workplan P2-18).
java_run(
    name = "vocab",
    testonly = True,
    outs = ["generated/vocab.tsv"],
    arguments = ["{OUT}"],
    main_class = "perf.TokenDump",
    mnemonic = "Generate",
    deps = [":token_dump"],
)

write_source_files(
    name = "update_vocab",
    testonly = True,
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nvocab.tsv is the runner's lexer vocabulary at the pinned release -- regenerate: bazel run //tools/engine-runner:update_vocab",
    files = {"vocab.tsv": ":vocab"},
    visibility = ["//:__pkg__"],
)

# The binaries, each run through its launcher on a one-class fixture (Bazel workplan P3-26): no test exercised them.
junit_test(
    name = "smoke_test",
    memory_mb = 768,
    size = "medium",
    srcs = ["src/test/java/perf/RunnerSmokeTest.java"],
    data = [
        "src/test/resources/smoke/person.pure",
        ":lite_parse",
        ":parse",
        ":testable",
    ],
    jvm_flags = [
        "-Drunner.smoke.fixture=$(rlocationpath src/test/resources/smoke/person.pure)",
        "-Drunner.parse=$(rlocationpath :parse)",
        "-Drunner.lite_parse=$(rlocationpath :lite_parse)",
        "-Drunner.testable=$(rlocationpath :testable)",
    ],
    select = ["--select-class=perf.RunnerSmokeTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

guards_package()
