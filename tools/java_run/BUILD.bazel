# java_run (defs.bzl): JVM programs as build actions over target-configuration jars.
load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("//tools/java:defs.bzl", "legend_java_library")

load(":defs.bzl", "java_run")
load("//tools/guards:defs.bzl", "guards_package")

# What a java_run action sees, held to pins.expected (Bazel workplan P0-10): removing a pin from
# defs.bzl changes the output, and the diff test fails.
legend_java_library(
    name = "print_pins",
    testonly = True,
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = ["pins/PrintPins.java"],
)

java_run(
    name = "pins",
    testonly = True,
    outs = ["pins.txt"],
    arguments = ["{OUT}"],
    main_class = "com.legend.tools.javarun.pins.PrintPins",
    deps = [":print_pins"],
)

diff_test(
    name = "pins_test",
    file1 = ":pins",
    file2 = "pins/pins.expected",
)

guards_package()
