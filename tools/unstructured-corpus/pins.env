# THE UNSTRUCTURED STUDY'S PINS: the stack every vector and every ledger row is computed on, each one fact. Plain
# KEY=VALUE, read by embed.py and tools/unstructured-oracle/judge.py, each of which refuses any other installed release
# or Python minor (VERSION, no fallback). requirements.txt names the same releases. The model is held by its Hugging Face
# commit and the weights file's sha256, so a re-uploaded file cannot move a vector unseen.
PYTHON_VERSION=3.12
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBED_MODEL_SHA256=3c9f31665447c8911517620762200d2245a2518d6e7208acc78cd9db317e21ad
EMBED_DIMENSIONS=384
# The model card's instruction for short-query-to-passage retrieval, on the query side only. Fixed before any result was seen.
EMBED_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages: 
SENTENCE_TRANSFORMERS_VERSION=6.2.0
TORCH_VERSION=2.15.0
TRANSFORMERS_VERSION=5.22.2
TOKENIZERS_VERSION=0.23.3
HUGGINGFACE_HUB_VERSION=2.4.0
SAFETENSORS_VERSION=0.8.0
NUMPY_VERSION=2.5.4
DUCKDB_VERSION=1.4.5
PSYCOPG_VERSION=3.3.8
PSYCOPG_BINARY_VERSION=3.3.8
PYYAML_VERSION=6.0.3
REQUESTS_VERSION=2.34.2
