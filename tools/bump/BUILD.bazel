load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("//tools/junit:defs.bzl", "junit_test")

java_library(
    name = "bump_lib",
    srcs = ["Bump.java"],
)

# `bazel run //tools/bump -- <engine release> [--pins]` — see Bump.java. It calls
# Bazel again (repin, //:update_generated, `bazel test //...`): a pin change takes
# effect only in the next Bazel invocation, never inside the one that made it.
java_binary(
    name = "bump",
    main_class = "com.legend.tools.bump.Bump",
    runtime_deps = [":bump_lib"],
)

# The bump's rewrites against the real MODULE.bazel and oracle-pins.env: a pin that moves in either file
# without the bump fails here, not at the next release (the integrity move, Bazel workplan P1-27, did).
junit_test(
    name = "bump_test",
    memory_mb = 768,
    size = "small",
    srcs = ["test/BumpTest.java"],
    data = [
        "//:MODULE.bazel",
        "//tools:oracle-pins.env",
    ],
    jvm_flags = [
        "-Dmodule.bazel=$(rlocationpath //:MODULE.bazel)",
        "-Doracle.pins=$(rlocationpath //tools:oracle-pins.env)",
    ],
    select = ["--select-class=com.legend.tools.bump.BumpTest"],
    deps = [
        ":bump_lib",
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)
