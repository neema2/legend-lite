load("//tools/java:defs.bzl", "legend_java_binary", "legend_java_library")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/guards:defs.bzl", "guards_package")

legend_java_library(
    name = "bump_lib",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = ["Bump.java"],
)

# `bazel run //tools/bump -- <engine release> [--pins]` — see Bump.java. It calls
# Bazel again (repin, //:update_generated, `bazel test //...`): a pin change takes
# effect only in the next Bazel invocation, never inside the one that made it.
legend_java_binary(
    name = "bump",
    main_class = "com.legend.tools.bump.Bump",
    runtime_deps = [":bump_lib"],
)

# The bump's rewrite of the real release.MODULE.bazel's PINS block: a block the bump could not rewrite whole fails
# here, not at the next release.
junit_test(
    name = "bump_test",
    memory_mb = 768,
    size = "small",
    srcs = ["test/BumpTest.java"],
    data = ["//:release.MODULE.bazel"],
    jvm_flags = ["-Drelease.segment=$(rlocationpath //:release.MODULE.bazel)"],
    select = ["--select-class=com.legend.tools.bump.BumpTest"],
    deps = [
        ":bump_lib",
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

guards_package()
