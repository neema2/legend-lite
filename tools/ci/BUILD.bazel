# The scripts CI's workflows source (.github/workflows): checked by shellcheck (//tools/guards:ci_scripts_test), as the
# workflows' own embedded shell is by actionlint.
load("//tools/guards:defs.bzl", "guards_package")

filegroup(
    name = "scripts",
    srcs = ["lane-flags.sh"],
    visibility = ["//tools/guards:__pkg__"],
)

# Bazel's downloader in CI: Maven Central, then Google's mirror of it (.bazelrc's `common:ci --downloader_config`)
exports_files(["downloader.cfg"])

guards_package()
