load("//tools/java:defs.bzl", "legend_java_library")
load("//tools/guards:defs.bzl", "guards_package")

# Compiles a Pure code repository to its PAR — see ParGenerator.java. The classpath
# is the one the Maven goal ran with in pct/pom.xml: the engine's compiled core
# and the TDS DSL, which hold the repositories a PAR may depend on.
# A library, run by java_run actions in the target configuration (Bazel workplan P1-22): no genrule, no shell.
legend_java_library(
    name = "par_generator",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = ["ParGenerator.java"],
    # legend-engine/pure jars are testonly (MODULE.bazel), so this is; and for //pct's adapter PAR alone (Bazel workplan P1-25)
    testonly = True,
    visibility = ["//pct:__pkg__"],
    runtime_deps = [
        "@maven_upstream//:org_finos_legend_engine_legend_engine_pure_code_compiled_core",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m2_dsl_tds_pure",
    ],
    deps = ["@maven_upstream//:org_finos_legend_pure_legend_pure_m3_core"],
)

guards_package()
