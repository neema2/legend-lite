# The release as the tests and generators read it (parser-equivalence's OraclePins): generated from
# release.MODULE.bazel's pins (@oracle_pins, tools/oracle_pins.bzl), here under its old name so every reader keeps
# one label. Nothing to hold equal any more: the pins are written once (Bazel workplan P2-10).
load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("//tools/guards:defs.bzl", "guards_package")

copy_file(
    name = "oracle_pins",
    src = "@oracle_pins//:oracle-pins.env",
    out = "oracle-pins.env",
    visibility = ["//visibility:public"],
)

guards_package()
