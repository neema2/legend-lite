# THE GS-QUANT ORACLE'S PINS (README.md): the stack every answer here is computed on, each one fact. Plain KEY=VALUE,
# as tools/oracle-pins.env. requirements.txt reads each (pip expands ${KEY}; snap.sh substitutes them for uv), snap.sh
# installs from requirements.txt, snap.py refuses any other installed release or Python minor and writes the whole
# set into every answer's hash and every ledger's header, and //core:ts_gsquant_parity_test reads this file. gs-quant
# declares only ranges for its numeric stack (numpy>1.17.0, pandas>=1.4, scipy>=1.2.0, statsmodels>=0.14.5): an
# answer is reproducible only with each held exactly.
GS_QUANT_VERSION=2.2.3
PANDAS_VERSION=3.1.1
NUMPY_VERSION=2.5.4
SCIPY_VERSION=1.18.1
STATSMODELS_VERSION=0.15.0
# TA-Lib: the reference for DataCube's own technicals gs-quant has no function for (atr, stochastic, obv, Keltner's and
# Donchian's channels; item 14f, step 4: the first oracle's references moved in, tools/ts-oracle's pin)
TA_LIB_VERSION=0.6.8
PYTHON_VERSION=3.12
