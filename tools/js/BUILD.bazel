load("@aspect_rules_js//js:defs.bzl", "js_library")
load(":defs.bzl", "node_test")
load("//tools/guards:defs.bzl", "guards_package")

# esbuild's native binary for the platform a bundle action runs on (tools/js/esbuild.bzl takes it in the exec
# configuration, so this select picks the exec platform's)
alias(
    name = "esbuild",
    actual = select({
        "//tools/platforms:linux_aarch64": "@esbuild_linux_arm64//:bin/esbuild",
        "//tools/platforms:linux_x86_64": "@esbuild_linux_x64//:bin/esbuild",
        "//tools/platforms:macos_arm64": "@esbuild_darwin_arm64//:bin/esbuild",
        "//tools/platforms:macos_x86_64": "@esbuild_darwin_x64//:bin/esbuild",
        "//tools/platforms:windows_x86_64": "@esbuild_windows_x64//:esbuild.exe",
    }),
    visibility = ["//visibility:public"],
)

# node_test's exit-code reporter (defs.bzl): every JavaScript test target runs it beside `spec`.
js_library(
    name = "strict_reporter",
    srcs = ["strict-reporter.mjs"],
    visibility = ["//visibility:public"],
)

# node_test's time zone, applied before the test runs (zone.mjs: Windows' launcher drops TZ).
js_library(
    name = "zone",
    srcs = ["zone.mjs"],
    visibility = ["//visibility:public"],
)

# A test's inputs through Bazel's runfiles (runfiles.mts; Bazel workplan P1-24): every node_test has it.
js_library(
    name = "runfiles",
    srcs = ["runfiles.mts"],
    visibility = ["//visibility:public"],
)

# Every package.json against its pnpm lock: a dependency edit without a relock fails here (Bazel workplan P1-26).
node_test(
    name = "lock_matches_package_json_test",
    size = "small",
    data = [
        "//datacube:package.json",
        "//datacube:pnpm-lock.yaml",
        "//query:package.json",
        "//query:pnpm-lock.yaml",
        "//studio:package.json",
        "//studio:pnpm-lock.yaml",
        "//engine-client:package.json",
        "//engine-client:pnpm-lock.yaml",
    ],
    entry_point = "lock-matches-package-json.test.ts",
    # other packages' sources, read as runfiles where they are (rules_js copies only its own package's to bin)
    no_copy_to_bin = [
        "//datacube:package.json",
        "//datacube:pnpm-lock.yaml",
        "//query:package.json",
        "//query:pnpm-lock.yaml",
        "//studio:package.json",
        "//studio:pnpm-lock.yaml",
        "//engine-client:package.json",
        "//engine-client:pnpm-lock.yaml",
    ],
    env = {
        "PACKAGE_JSONS": "$(rlocationpath //datacube:package.json) $(rlocationpath //query:package.json) $(rlocationpath //studio:package.json) $(rlocationpath //engine-client:package.json)",
        "PNPM_LOCKS": "$(rlocationpath //datacube:pnpm-lock.yaml) $(rlocationpath //query:pnpm-lock.yaml) $(rlocationpath //studio:pnpm-lock.yaml) $(rlocationpath //engine-client:pnpm-lock.yaml)",
    },
)

guards_package()
