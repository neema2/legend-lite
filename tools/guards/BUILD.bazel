# THE GUARDS (Bazel workplan Phase 6): tests over the repository itself. inventory.bzl lists every file and package
# (@repo_inventory); defs.bzl's guards_package gives each package an `all_files` the content guards read.
load("@bazel_skylib//rules:native_binary.bzl", "native_binary", "native_test")
load("@repo_inventory//:packages.bzl", "PACKAGES")
load(":compile_only.bzl", "action_kinds_report", "compile_only_validated_fixture")
load(":defs.bzl", "guards_package")
load(":workflows.bzl", "git_marker")
load("//tools/deps:pools.bzl", "POOLS")
load("//tools/java:defs.bzl", "legend_java_library")
load("//tools/java_run:defs.bzl", "java_run")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/platforms:defs.bzl", "COMPILER_LIBRARY_PLATFORMS", "platform_select")

# Every package's files (guards_package), from the inventory's package list: a package without guards_package()
# fails analysis here (G0, Bazel workplan P6-00).
filegroup(
    name = "repository_files",
    srcs = ["//%s:all_files" % p for p in PACKAGES],
)

# G0: the inventory is complete, and every file in it is in some package's all_files (Bazel workplan P6-00)
junit_test(
    name = "inventory_test",
    memory_mb = 768,
    size = "small",
    srcs = ["InventoryTest.java"],
    data = [
        ":repository_files",
        "@repo_inventory//:files.txt",
    ],
    jvm_flags = ["-Dinventory.files=$(rlocationpath @repo_inventory//:files.txt)"],
    select = ["--select-class=com.legend.tools.guards.InventoryTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# G10: every jar pool is locked (fail_if_repin_required) and strict (strict_visibility) (Bazel workplan P6-10)
junit_test(
    name = "locks_test",
    memory_mb = 768,
    size = "small",
    srcs = ["LocksTest.java"],
    data = ["//:module_files"],
    # the pools tools/deps/pools.bzl names: the maven.install calls found must be exactly these
    env = {
        "MODULE_FILES": "$(rlocationpaths //:module_files)",
        "POOLS": " ".join(POOLS),
    },
    select = ["--select-class=com.legend.tools.guards.LocksTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# G17 (Bazel workplan P6-17): no Markdown file of this repository is a test input, so prose cannot change a verdict
# (and CI's paths-ignore of **/*.md stays true): every package's guard_markdown report (guards_package), but this
# one's (the guards read every file by design).
filegroup(
    name = "markdown_reports",
    testonly = True,
    srcs = ["//%s:guard_markdown" % p for p in PACKAGES if p != "tools/guards"],
)

junit_test(
    name = "markdown_inputs_test",
    memory_mb = 768,
    size = "small",
    srcs = ["MarkdownInputsTest.java"],
    data = [":markdown_reports"],
    env = {"MARKDOWN_REPORTS": "$(rlocationpaths :markdown_reports)"},
    select = ["--select-class=com.legend.tools.guards.MarkdownInputsTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# G11 (Bazel workplan P6-11): no runtime classpath holds two versions of one Maven coordinate; every package's
# guard_classpaths report (guards_package) from the inventory's package list. Replaces pools_are_disjoint.
filegroup(
    name = "classpath_reports",
    testonly = True,
    srcs = ["//%s:guard_classpaths" % p for p in PACKAGES if p != "tools/guards"],  # the guards: no cycle
)

junit_test(
    name = "classpath_test",
    memory_mb = 768,
    size = "small",
    srcs = ["ClasspathTest.java"],
    data = [":classpath_reports"],
    # a list: an environment variable keeps it one value (in jvm_flags it would split into JVM arguments)
    env = {"CLASSPATH_REPORTS": "$(rlocationpaths :classpath_reports)"},
    select = ["--select-class=com.legend.tools.guards.ClasspathTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# THE BUILD IS ONLY COMPILES (docs/BUILD_REBUILD_DESIGN_2026_10_05.md, step 1): every kind of action the build targets
# perform (compile_only.bzl), and the test that holds them to compiling and file plumbing. The fixture tier is the
# test's proof that it still catches what it exists to catch.
_TIERS = {
    "//:java": "java",
    "//:native": "native",
    "//:wasm": "wasm",
    "//:web": "web",
    ":compile_only_fixture_genrule": "fixture",
    ":compile_only_fixture_generator": "fixture",
    ":compile_only_fixture_impostor": "fixture",
    ":compile_only_fixture_validated": "fixture",
}

action_kinds_report(
    name = "build_action_kinds",
    testonly = True,
    # the compiler as a native library (//native:compiler) shares the native tier: the same native-image compile and
    # zlib. Wherever it builds (COMPILER_LIBRARY_PLATFORMS: Windows on x86-64 too, since 2026-10-09), and not elsewhere:
    # an incompatible tier would make this report, and so the guard, incompatible there too
    tiers = select({
        "//tools/platforms:" + platform: _TIERS | {"//native:compiler": "native"}
        for platform in COMPILER_LIBRARY_PLATFORMS
    } | {"//conditions:default": _TIERS}),
)

junit_test(
    name = "compile_only_test",
    size = "small",
    srcs = ["CompileOnlyTest.java"],
    data = [":build_action_kinds"],
    env = {"BUILD_ACTION_KINDS": "$(rlocationpath :build_action_kinds)"},
    memory_mb = 512,
    select = ["--select-class=com.legend.tools.guards.CompileOnlyTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# compile_only_test's fixture tier: what a build target must never reach, each of which the test expects flagged
# exactly. They are never built (manual, and the report reads only the aspect's walk of them), so nothing runs.
genrule(
    name = "compile_only_fixture_genrule",
    testonly = True,
    outs = ["compile_only_fixture_genrule.txt"],
    cmd = "exit 1",
    tags = ["manual"],
)

# an empty library: java_run needs one, and it registers no action of its own
legend_java_library(
    name = "compile_only_fixture_library",
    testonly = True,
    nullaway = False,
    tags = ["manual"],
)

java_run(
    name = "compile_only_fixture_generator",
    testonly = True,
    outs = ["compile_only_fixture_generator.txt"],
    main_class = "Never",
    tags = ["manual"],
    deps = [":compile_only_fixture_library"],
)

# a program that calls itself Javac: its rule kind still gives it away
java_run(
    name = "compile_only_fixture_impostor",
    testonly = True,
    outs = ["compile_only_fixture_impostor.txt"],
    main_class = "Never",
    mnemonic = "Javac",
    tags = ["manual"],
    deps = [":compile_only_fixture_library"],
)

compile_only_validated_fixture(
    name = "compile_only_fixture_validated",
    testonly = True,
    tags = ["manual"],
)

# THE WORKFLOWS' LINTER (the build rebuild's first landing, PHASE_8.md CI-4; old G8's first half): actionlint over
# every workflow file (//:workflows), as the test that replaces gate.yml's `curl | tar` job, which fetched the
# binary with no checksum. The binary is the release archive for this platform, pinned in MODULE.bazel by the
# release's own checksums. The embedded shell is checked by shellcheck, pinned the same way and handed to actionlint
# by path (the old job used the runner image's shellcheck; a test runs nothing from the machine); pyflakes is off
# (no workflow embeds Python). The `.git` marker (workflows.bzl) makes the runfiles a project, so the call from
# gate.yml into gates-run.yml and its inputs are checked too.
_ACTIONLINT, _ACTIONLINT_PLATFORMS = platform_select({
    "linux_aarch64": "@actionlint_linux_arm64//:actionlint",
    "linux_x86_64": "@actionlint_linux_amd64//:actionlint",
    "macos_arm64": "@actionlint_darwin_arm64//:actionlint",
    "macos_x86_64": "@actionlint_darwin_amd64//:actionlint",
    "windows_x86_64": "@actionlint_windows_amd64//:actionlint.exe",
}, "actionlint")

_SHELLCHECK, _SHELLCHECK_PLATFORMS = platform_select({
    "linux_aarch64": "@shellcheck_linux_aarch64//:shellcheck",
    "linux_x86_64": "@shellcheck_linux_x86_64//:shellcheck",
    "macos_arm64": "@shellcheck_darwin_aarch64//:shellcheck",
    "macos_x86_64": "@shellcheck_darwin_x86_64//:shellcheck",
    "windows_x86_64": "@shellcheck_windows//:shellcheck.exe",
}, "shellcheck")

# shellcheck copied into this package, so its runfiles path is a plain `$(rootpath)` (an external file's is not,
# without the legacy external runfiles layout); native_binary names the copy after the target, `.exe` on Windows,
# which runs no extensionless file
native_binary(
    name = "shellcheck",
    testonly = True,
    src = _SHELLCHECK,
    target_compatible_with = _SHELLCHECK_PLATFORMS,
)

git_marker(
    name = "workflows_git_marker",
    testonly = True,
)

native_test(
    name = "workflows_test",
    size = "small",
    src = _ACTIONLINT,
    args = [
        "-shellcheck=$(rootpath :shellcheck)",
        "-pyflakes=",
        "$(rootpaths //:workflows)",
    ],
    data = [
        ":shellcheck",
        ":workflows_git_marker",
        "//:workflows",
    ],
    target_compatible_with = _SHELLCHECK_PLATFORMS,
)

# THE SCRIPTS THE WORKFLOWS SOURCE (//tools/ci): shellcheck over each, as actionlint checks the workflows' embedded
# shell; a sourced file actionlint does not follow, so it is checked here
native_test(
    name = "ci_scripts_test",
    size = "small",
    src = ":shellcheck",
    args = ["$(rootpaths //tools/ci:scripts)"],
    data = ["//tools/ci:scripts"],
    target_compatible_with = _SHELLCHECK_PLATFORMS,
)

guards_package()
