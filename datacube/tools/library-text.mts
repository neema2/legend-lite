// THE LIBRARY'S TEXT FOR THE PAGE (the platform step's B, docs/TIMESERIES_ON_THE_PLATFORM_2026_10_28.md: the library a Pure
// file the platform loads as it is, src/pure/datacube_ts.pure): that file written as datacube/src/pure-library-text.ts, the
// module a page fetches it in. The committed copy's diff test says to regenerate when the Pure file changes.
//
// Usage: library-text <datacube_ts.pure> <out.ts>
import { readFileSync, writeFileSync } from 'node:fs';

const [source, out] = process.argv.slice(2);
if (source === undefined || out === undefined) throw new Error('usage: library-text <datacube_ts.pure> <out.ts>');

const text = readFileSync(source, 'utf8');
if (!text.startsWith('###Pure\n')) throw new Error(`${source} is no ###Pure section`);
// a template literal of the text as it is: its backslashes, backticks and \${ written as themselves
const literal = text.replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\$\{/g, '\\${');

writeFileSync(out, `// GENERATED by datacube/tools/library-text.mts from src/pure/datacube_ts.pure (the library, a Pure file the platform
// loads as it is) -- DO NOT EDIT: edit the Pure file. Regenerate: bazel run //datacube:update_generated; its diff test
// fails the build if this copy drifts.
//
// DATACUBE'S PURE LIBRARY, its text (pure-library.ts says what it is and how a model takes it): a module of its own, so a
// page fetches it only where a query calls the library (pure-library.ts loadLibrary, a chunk of its own; the bundle
// budget, 2026-10-27) -- a timeseries tile's, or a person's own query naming datacube::ts.

/**
 * The library, as Pure text: a \`###Pure\` section a model takes after its own. Each function takes the table, a window
 * of it (its LINE -- the column the table has a line per value of: a symbol --, its ORDER, its frame) or the line and
 * the dates themselves, the column it reads (by \`read\`: the caller's own), its parameters and the column it writes;
 * every other column carried as it is, its working columns its own (docs/DATACUBE_TIMESERIES_DESIGN_2026_10_25.md §5.7).
 */
export const DATACUBE_LIBRARY = \`${literal}\`;
`);
