// THE LIBRARY'S OPTIONS, ONE SOURCE (the user, 2026-10-28: a library option's values were written three times -- the Pure
// enumerations, the catalog's words, the writer's check): each `Enum datacube::ts::X { a, b }` of the library's text,
// written as datacube/src/generated/library-enums.ts, which the catalog (timeseries-spec.ts) and the writer
// (timeseries-query.ts) read. The committed copy's diff test says to regenerate when the library changes an enumeration.
//
// Usage: library-enums <pure-library-text.ts> <out.ts>
import { readFileSync, writeFileSync } from 'node:fs';

const [source, out] = process.argv.slice(2);
if (source === undefined || out === undefined) throw new Error('usage: library-enums <pure-library-text.ts> <out.ts>');

const ENUM = /^Enum datacube::ts::([A-Za-z]\w*)\s*\{([^}]*)\}/gm;
const enums: [string, string[]][] = [];
for (const m of readFileSync(source, 'utf8').matchAll(ENUM)) {
  const values = m[2]!.split(',').map((v) => v.trim());
  for (const v of values) {
    if (!/^[A-Za-z_]\w*$/.test(v)) throw new Error(`datacube::ts::${m[1]!} has a value that is no name: ${JSON.stringify(v)}`);
  }
  if (enums.some(([name]) => name === m[1])) throw new Error(`datacube::ts::${m[1]!} is declared twice`);
  enums.push([m[1]!, values]);
}
if (enums.length === 0) throw new Error(`${source} declares no enumeration of datacube::ts`);

const lines = [
  '// GENERATED by datacube/tools/library-enums.mts from src/pure-library-text.ts (the library\'s own enumerations) -- DO',
  '// NOT EDIT. Regenerate: bazel run //datacube:update_generated; its diff test fails the build if this copy drifts from',
  '// the library.',
  '',
  '/** Each enumeration of datacube::ts by its name, its values in their declared order: the one source of an option\'s',
  ' *  values, which the catalog\'s words and the writer\'s check both read. */',
  'export const LIBRARY_ENUMS = {',
  ...enums.map(([name, values]) => `  ${name}: [${values.map((v) => `'${v}'`).join(', ')}],`),
  '} as const;',
  '',
  '/** An enumeration of datacube::ts. */',
  'export type LibraryEnum = keyof typeof LIBRARY_ENUMS;',
  '',
];
writeFileSync(out, lines.join('\n'));
