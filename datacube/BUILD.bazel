# ── THE DEMO SITE ───────────────────────────────────────────────────────────────
# Built where the pages expect it: rules_js lays sources and outputs side by side
# in bazel-bin/datacube, so demo/index.html finds ./bundle.js and ./vendor/ as it
# does in a checkout, and every harness in demo/ that serves this directory runs
# as it is written.

# entry point -> bundle
_BUNDLES = {
    "demo/main.ts": "demo/bundle.js",
    "demo/page.ts": "demo/bundle-page.js",
    "src/planner-worker.ts": "demo/planner-worker.js",
    "demo/remote-harness.ts": "demo/remote-bundle.js",
    "demo/stress.ts": "demo/stress.js",
}

# Split: what a page loads only when it needs it (ECharts, the first time a chart draws -- plan
# F7) is a chunk beside the bundle, in its own directory per bundle, fetched by the bundle itself.
# The planner's worker is one file: it loads nothing lazily, and a worker's imports are its own.
_UNSPLIT = ["src/planner-worker.ts"]

[esbuild.esbuild(
    name = "bundle_" + out[len("demo/"):-len(".js")].replace("-", "_"),
    # demo/boot.ts opens a saved query's project by name from Depot (the model home; design Phase 3)
    srcs = glob(["demo/**/*.ts"]) + [":src", "//depot-client:depot_client", "//sdlc-client:sdlc_client"],
    outs = [out],
    out_dirs = [] if entry in _UNSPLIT else ["demo/chunks-" + out[len("demo/"):-len(".js")]],
    args = [
        entry,
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--log-level=warning",
    ] + (["--outfile=" + out] if entry in _UNSPLIT else [
        "--splitting",
        "--outdir=demo",
        "--entry-names=" + out[len("demo/"):-len(".js")],
        "--chunk-names=chunks-" + out[len("demo/"):-len(".js")] + "/[name]-[hash]",
    ]),
    chdir = package_name(),
) for entry, out in _BUNDLES.items()]

# The two WebAssembly runtimes the page loads from ./vendor/: DuckDB's, from engine-client's
# npm package, and legend-lite's planner, from //wasm:planner; and the fonts, from legend-art (the pinned @fontsource).
copy_to_directory(
    name = "vendor",
    srcs = [
        "//engine-client:node_modules/@duckdb/duckdb-wasm",
        "//legend-art:fonts",
        "//sdlc-server:page",
        "//wasm:planner",
    ],
    out = "demo/vendor",
    include_srcs_patterns = [
        "legend-art/fonts/roboto-latin-400-normal.woff2",
        "legend-art/fonts/roboto-latin-ext-400-normal.woff2",
        "legend-art/fonts/roboto-latin-500-normal.woff2",
        "legend-art/fonts/roboto-latin-ext-500-normal.woff2",
        "legend-art/fonts/roboto-latin-700-normal.woff2",
        "legend-art/fonts/roboto-latin-ext-700-normal.woff2",
        "legend-art/fonts/LICENSE-roboto.txt",
        "**/dist/duckdb-mvp.wasm",
        "**/dist/duckdb-eh.wasm",
        "**/dist/duckdb-browser-mvp.worker.js",
        "**/dist/duckdb-browser-eh.worker.js",
        "wasm/planner/classes.wasm",
        "wasm/planner/wasm-gc-module-runtime.js",
        "sdlc-server/page/classes.wasm",
        "sdlc-server/page/wasm-gc-module-runtime.js",
    ],
    replace_prefixes = {
        "legend-art/fonts/": "fonts/",
        "**/dist/": "",
        "wasm/planner/": "",
        "sdlc-server/page/": "sdlc/",
    },
)

# The projects a saved query compiles against (config.json `projects[]`): the Query app's trading
# demo, its model and seed served as they are there, never copied into this package.
copy_to_directory(
    name = "projects",
    srcs = [
        "//query:demo/models/runtime-duckdb.pure",
        "//query:demo/models/trading-seed.sql",
        "//query:demo/models/trading.pure",
    ],
    out = "demo/projects/trading",
    root_paths = ["query/demo/models"],
)

filegroup(
    name = "site",
    # served beside the other app from one origin (//site): they share the browser's query store
    visibility = ["//site:__pkg__"],
    srcs = glob([
        "demo/*.css",
        "demo/*.html",
        "demo/*.json",
        "demo/*.pure",
        "src/**/*.css",
    ]) + [":bundle_" + out[len("demo/"):-len(".js")].replace("-", "_") for out in _BUNDLES.values()] + [":vendor", ":projects"],
)

# `bazel run //datacube:serve [-- --data FILE] [-- --open]`: the site, on loopback.
js_binary(
    name = "serve",
    data = [
        "demo/static-files.ts",
        ":site",
    ],
    entry_point = "demo/serve.mjs",
    node_options = [
        "--experimental-strip-types",
        "--disable-warning=ExperimentalWarning",
    ],
)

# THE APP (docs/DATACUBE_APP_PLAN_2026_10_02.md): the native warehouse serving this site, one user,
# the browser opened on the tables of the databases named (on Windows through hermetic-launcher:
# warehouse/defs.bzl):
#   bazel run //datacube:app -- postgresql://bob@db:5432/shop [--table sales.orders]
warehouse_run(
    name = "app",
    args_before = [
        "--single-user",
        "--open",
    ],
    library = "//warehouse:duckdb_library",
    server = "//warehouse:server_native",
    site = ":dist",
)

# `bazel build //datacube:dist`: the site as a folder for any static host — no
# backend; the planner is WebAssembly and so is DuckDB.
js_binary(
    name = "make_dist",
    entry_point = "demo/make-dist.mjs",
)

js_run_binary(
    name = "dist",
    srcs = [":site"],
    args = [
        package_name(),
        package_name() + "/dist",
    ],
    out_dirs = ["dist"],
    tool = ":make_dist",
)

# THE BROWSER HARNESSES: `bazel run //datacube:<name>`. Each drives the built site
# in headless Chromium (Playwright's own browser: `npx playwright install
# chromium` once — a browser binary is not something Bazel fetches here). Run by
# hand, not tests: several need a live engine as well (the script says which).
_HARNESS_HELPERS = [
    "demo/engine-cases.mjs",
    "demo/static-files.ts",
    "demo/grid-invariants.mjs",
    "demo/stress-corpus.ts",
    "demo/torture.pure",
    "demo/trades.pure",
    "demo/trades-h2.pure",
    "demo/typed-view.mjs",
    "demo/warehouse-source.mjs",
]

_HARNESSES = [
    "chaos",
    "make-sample",
    "measure-startup",
    "run-stress",
    "shots",
    "torture",
    "verify-calc-vocabulary",
    "verify-charts",
    "verify-cubes",
    "verify-engine",
    "verify-engine-differential",
    "verify-features",
    "verify-page",
    "verify-picker",
    "verify-real-data",
    "verify-remote",
    "verify-smoke",
    "verify-upload",
    "verify-wasm-browser",
]

# THE ONES CI RUNS (the `browser` lane, Linux only: .github/workflows/gates-run.yml): every
# harness that needs no server and no file of yours -- each exits non-zero on a failure. The
# lane runs whatever carries the tag, so the list is here, beside the harnesses, not in CI.
_CI_HARNESSES = [
    "run-stress",
    "verify-charts",
    "verify-cubes",
    "verify-features",
    "verify-page",
    # not verify-picker: it drives a site already served on :8000 (`bazel run //datacube:serve`)
    "verify-real-data",
    "verify-remote",
    # not verify-smoke: it is a test, :verify_smoke_test (Bazel workplan P1-14's pilot)
    "verify-upload",
    "verify-wasm-browser",
]

[js_binary(
    name = h.replace("-", "_"),
    data = _HARNESS_HELPERS + [
        ":node_modules/playwright",
        ":site",
        ":src",
    ] + (["//fixtures/saved-queries:records"] if h == "verify-features" else []) + (
        # it imports pinned-chromium.mjs first, a no-op under bazel run
        ["//tools/browser:pinned_chromium"] if h == "verify-smoke" else []
    ),
    entry_point = "demo/" + h + ".mjs",
    node_options = [
        "--experimental-strip-types",
        "--experimental-wasm-exnref",
        "--disable-warning=ExperimentalWarning",
    ],
    tags = ["browser-ci"] if h in _CI_HARNESSES else [],
) for h in _HARNESSES]

# THE SMOKE HARNESS AS A TEST (Bazel workplan P1-14, the pilot): against the Chromium Bazel fetched
# (//tools/browser), with no install step and nothing in $HOME. .
# The other harnesses follow in P4.
browser_test(
    name = "verify_smoke_test",
    size = "large",
    data = _HARNESS_HELPERS + [
        ":node_modules/playwright",
        ":site",
        ":src",
    ],
    entry_point = "demo/verify-smoke.mjs",
    wasm = True,
)

# `bazel run //datacube:verify_app` (manual; see demo/verify-app.mjs for its Postgres): the single-user app
# end to end -- the native warehouse serving :dist, started from the launch key.
js_binary(
    name = "verify_app",
    data = [
        ":dist",
        ":node_modules/playwright",
        # it imports pinned-chromium.mjs first, a no-op under bazel run
        "//tools/browser:pinned_chromium",
        "//warehouse:serve",
    ],
    entry_point = "demo/verify-app.mjs",
    # this platform's launcher (warehouse/defs.bzl): a script on Linux and macOS, an .exe on Windows
    env = {"WAREHOUSE_SERVE": "$(rlocationpath //warehouse:serve)"},
    tags = ["manual"],
)

# THE APP AGAINST POSTGRES, AS A TEST ON EVERY PLATFORM (Bazel workplan P1-14b, D11 revised): verify-app.mjs's
# checks with the Postgres it needs started inside the test -- :app_postgres, Postgres 16 from the pinned
# binaries loaded with the guide's sample over JDBC -- and the pinned Chromium. No psql, no host Postgres,
# no host browser. CI's app lane runs it on Linux, macOS and Windows: the Windows desk's own path.
browser_test(
    name = "verify_app_test",
    size = "large",
    data = [
        ":app_postgres",
        ":app_postgres_executable",
        ":dist",
        ":node_modules/playwright",
        "demo/sample-shop.sql",
        "//warehouse:serve",
    ],
    entry_point = "demo/verify-app.mjs",
    env = {
        "APP_POSTGRES": "$(rlocationpath :app_postgres_executable)",
        "SAMPLE_SQL": "$(rlocationpath demo/sample-shop.sql)",
        "WAREHOUSE_SERVE": "$(rlocationpath //warehouse:serve)",
    },
)

executable_of(
    name = "app_postgres_executable",
    testonly = True,
    binary = ":app_postgres",
)

# the test's Postgres (tools/apppostgres/AppPostgres.java): prints its port once the sample is in, and runs
# until its stdin closes
legend_java_binary(
    name = "app_postgres",
    # starts the embedded Postgres: skipped where no build is pinned (P1-15)
    target_compatible_with = EMBEDDED_POSTGRES_COMPATIBLE,
    testonly = True,
    srcs = ["tools/apppostgres/AppPostgres.java"],
    data = [
        "@embedded_postgres//:pg/PG_ROOT",
        "@embedded_postgres//:postgres",
    ],
    jvm_flags = ["-Dembedded.postgres.root=$(rlocationpath @embedded_postgres//:pg/PG_ROOT)"],
    main_class = "apppostgres.AppPostgres",
    runtime_deps = ["//core:drivers"],
    deps = ["//testing"],
)

# `bazel run //datacube:install_browser [-- --with-deps]`: the Chromium the harnesses drive, at
# the version the lock file pins.
js_binary(
    name = "install_browser",
    data = [":node_modules/playwright"],
    entry_point = "demo/install-browser.mjs",
)

guards_package()
