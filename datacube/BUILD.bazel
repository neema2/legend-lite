# The jsdom tests that drive a whole page through many gestures, each opening grids: past `small`'s 60 s on CI's
# Windows runner (PR #64's CI, 2026-10-22: one_api_gestures_test about 1.2 s a gesture there, cube_page_shell_test at
# the edge). Those get `medium` (300 s) too.
_SLOW_DOM_TESTS = [
    "one-api-gestures",
    "cube-page-shell",
    # three tabs and Python on one page, 24 seeds of 14 steps with the keeper's faults (2026-10-24): about 45 s on a desk
    "live-soak",
]

# the page's total diff over the saved-page corpus (D19 W2, 2026-10-24): 60 seeds of 8 steps on three pages, every pair
# of states both ways -- about a minute on a desk, past `small`'s 60 s under CI's load
_SLOW_WALK_TESTS = [
    "page-between",
]

# node:test files, each its own node_test (tools/js/defs.bzl: types stripped, the spec and strict reporters, a
# pinned locale and clock). Each finds its inputs through //tools/js:runfiles.
[node_test(
    name = t[len("test/"):-len(".test.ts")].replace("-", "_") + "_test",
    # The tests that load the WebAssembly planner compile it first: seconds on a desk (infer: 6 s), but past
    # `small`'s 60 s on CI's Windows runner while the same lane builds the native image (main's CI run
    # 37214692462, 2026-10-04). Those get `medium` (300 s); the rest stay `small`.
    size = "medium" if t[len("test/"):-len(".test.ts")] in _WASM_TESTS + _SLOW_DOM_TESTS + _SLOW_WALK_TESTS else "small",
    # a scanner reads every source; any other test, the files its imports reach (a test not yet in the generated
    # list takes them all until //datacube:update_generated adds it)
    data = [
        ":node_modules/jsdom",
        "test/fake-engine.ts",
        "test/fake-planner.ts",
    ] + _EXTRA_DATA.get(t[len("test/"):-len(".test.ts")], []) + [f for f in _SCANNED.get(t[len("test/"):-len(".test.ts")], []) if f != ":src"] + (
        [":src"] if t[len("test/"):-len(".test.ts")] in _SCANNED or t[len("test/"):-len(".test.ts")] not in TEST_IMPORTS else [":src_base"] + TEST_IMPORTS[t[len("test/"):-len(".test.ts")]]
    ) + (
        ["//engine-client:node_modules/@duckdb/duckdb-wasm"] if t[len("test/"):-len(".test.ts")] in _DUCKDB_USERS else []
    ) + (
        ["test/catalog-builder.ts", "test/lite-compiler.ts"] if t[len("test/"):-len(".test.ts")] in _WASM_TESTS else []
    ) + (
        # the test's host (package.json "imports", #test-host): in Node, the module in-thread and DuckDB-WASM
        ["test/host/node.ts"] if t[len("test/"):-len(".test.ts")] in _WASM_TESTS + _DUCKDB_USERS else []
    ),
    entry_point = t,
    env = _EXTRA_ENV.get(t[len("test/"):-len(".test.ts")], {}) | ({
        "SOURCES": " ".join(["$(rlocationpaths %s)" % f for f in _SCANNED[t[len("test/"):-len(".test.ts")]]]),
    } if t[len("test/"):-len(".test.ts")] in _SCANNED else {}),
    node_options = ["--experimental-wasm-exnref"] if t[len("test/"):-len(".test.ts")] in _BINDING_TESTS else [],
    wasm = t[len("test/"):-len(".test.ts")] in _WASM_TESTS,
) for t in _TESTS]

# DATACUBE HEADLESS (docs/DATACUBE_HEADLESS_PYTHON_DESIGN_2026_10_11.md): DataCube's own non-screen code in V8 inside
# Python -- its planner's worker answered by legend-lite's native library, its database Python's DuckDB, no WebAssembly.
#
# The product's bundle: src/headless/entry.ts as one script, its exports the global `legendLiteHeadless` (the wheel's
# `datacube` extra carries it, step 4). --platform=neutral: it imports nothing of Node, and a module that did would not
# bundle.
esbuild_bundle(
    name = "headless_bundle",
    srcs = [":src"],
    outs = ["headless/legend-lite-headless.js"],
    args = [
        "src/headless/entry.ts",
        "--bundle",
        "--format=iife",
        "--global-name=legendLiteHeadless",
        "--platform=neutral",
        "--main-fields=module,main",
        "--target=es2022",
        "--log-level=warning",
        "--outfile=headless/legend-lite-headless.js",
    ],
    visibility = ["//python:__pkg__"],
)

# THE TAB'S OWN FUNCTIONS FOR THE PYTHON TEST (test/headless-tab.ts: the two total diffs and the planned apply a tab's
# history is made of), one script the test loads into the headless engine it has, as the global `legendLiteHeadlessTab`.
# Not the product's bundle: Python's product asks none of them (the one API ledger's L8_UNASKED stays empty).
esbuild_bundle(
    name = "headless_tab_bundle",
    testonly = True,
    srcs = ["test/headless-tab.ts", ":src"],
    outs = ["headless-tab/legend-lite-headless-tab.js"],
    args = [
        "test/headless-tab.ts",
        "--bundle",
        "--format=iife",
        "--global-name=legendLiteHeadlessTab",
        "--platform=neutral",
        "--main-fields=module,main",
        "--target=es2022",
        "--log-level=warning",
        "--outfile=headless-tab/legend-lite-headless-tab.js",
    ],
    visibility = ["//python:__pkg__"],
)

