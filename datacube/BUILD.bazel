    "chart-echarts": "ECharts draws on a DOM canvas",
    "chart-kinds": "ECharts draws on a DOM canvas",
    "chart-maps": "ECharts draws on a DOM canvas",
    # a picked File read as a stream (Blob, TextDecoderStream: upload.ts fileParts) is the page's: headless reads a file
