# ── THE DEMO SITE ───────────────────────────────────────────────────────────────
# Built where the pages expect it: rules_js lays sources and outputs side by side
# in bazel-bin/datacube, so demo/index.html finds ./bundle.js and ./vendor/ as it
# does in a checkout, and every harness in demo/ that serves this directory runs
# as it is written.

# entry point -> bundle
_BUNDLES = {
    "demo/main.ts": "demo/bundle.js",
    "demo/remote-harness.ts": "demo/remote-bundle.js",
    "demo/stress.ts": "demo/stress.js",
    # DataCube's app on Python, every query Python's (docs/DATACUBE_ONE_APP_DESIGN_2026_10_11.md, step 2a)
    "demo/engine.ts": "demo/bundle-engine.js",
}

# the planner's worker: engine-client's own bundle (docs/ONE_PLATFORM_PROGRAM_2026_10_12.md C2: one planner
# protocol, one worker for every app that plans in a tab), served as the page's ./planner-worker.js, as Query's and
# Studio's are
copy_file(
    name = "planner_worker",
    src = "//engine-client:planner_worker",
    out = "demo/planner-worker.js",
)

# Split: what a page loads only when it needs it (ECharts, the first time a chart draws -- plan
# F7) is a chunk beside the bundle, in its own directory per bundle, fetched by the bundle itself.
# Minified, its names kept, as the notebook's module is (the user, 2026-10-15, "does minify buy anything if already
# zipped?": measured, a third off the gzipped download and about half off the text the browser parses -- a grid page's
# startup 405,798 -> 278,151 bytes gzipped, its script 764,104 bytes at 2d24022 -> 411,165). A minified file names no
# module it holds, so esbuild's record of each output's modules and imports (<bundle>-meta.json, beside it) is what
# test/bundle-budget.test.ts reads.
[esbuild_bundle(
    name = "bundle_" + out[len("demo/"):-len(".js")].replace("-", "_"),
    srcs = glob(["demo/**/*.ts"]) + [":src"],
    outs = [
        out,
        out[:-len(".js")] + "-meta.json",
    ],
    out_dirs = ["demo/chunks-" + out[len("demo/"):-len(".js")]],
    args = [
        entry,
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--minify",
        "--keep-names",
        "--log-level=warning",
        "--splitting",
        "--outdir=demo",
        "--entry-names=" + out[len("demo/"):-len(".js")],
        "--chunk-names=chunks-" + out[len("demo/"):-len(".js")] + "/[name]-[hash]",
        "--metafile=" + out[:-len(".js")] + "-meta.json",
    ],
) for entry, out in _BUNDLES.items()]

# A NOTEBOOK'S CUBE (legend_lite.notebook.DataCube; docs/DATACUBE_PYTHON_SHOW_DESIGN_2026_10_08.md, "In a notebook"):
# anywidget's script, a small loader (widget-loader.js), and DataCube's module, which the loader fetches over the
# widget's channel once per notebook page: widget.js, minified with its names kept, its lazy chunks beside it in
# widget-chunks/ (a chart's code, fetched over the channel the first time a chart draws: the loader rewrites a chunk's
# import, for a module imported from a blob URL resolves none), and widget.css, DataCube's styles (in the notebook's own
# type).
esbuild_bundle(
    name = "widget_loader",
    srcs = ["demo/widget-loader.ts"],
    outs = ["demo/widget-loader.js"],
    args = [
        "demo/widget-loader.ts",
        "--bundle",
        "--format=esm",
        "--target=es2022",
        # no build path in it (esbuild's per-module comment): anywidget sends it with every widget, and a notebook saved
        # with its widgets keeps it, so it is the same file whichever machine built it
        "--minify-whitespace",
        "--log-level=warning",
        "--outfile=demo/widget-loader.js",
    ],
)

esbuild_bundle(
    name = "widget",
    # DataCube's app over Python's services (src/app/, src/services/python-host.ts), and the libraries it reaches -- the
    # model home's Depot client among them, inlined here as everything is -- through :src
    srcs = [
        "demo/widget.ts",
        "demo/widget-loader.ts",
        "demo/widget-styles.css",
        ":src",
    ] + glob(["src/**/*.css"]),
    outs = [
        "demo/widget-meta.json",
        "demo/widget.css",
        "demo/widget.js",
    ],
    out_dirs = ["demo/widget-chunks"],
    args = [
        # two entry points, both named widget: the module (widget.js) and its styles (widget.css). The styles are their
        # own entry ON PURPOSE: widget.ts imports no CSS, for esbuild would write a JS entry's imported CSS to a sibling
        # widget.css, the same path as this entry's ("two output files share the same path")
        "widget=demo/widget.ts",
        "widget=demo/widget-styles.css",
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--minify",
        "--keep-names",
        "--log-level=warning",
        "--splitting",
        "--chunk-names=widget-chunks/[name]-[hash]",
        # esbuild's record of each output's imports: the loader's rewriting is held to it (test/bundle-budget.test.ts)
        "--metafile=demo/widget-meta.json",
        "--outdir=demo",
    ],
)

# THE BUNDLES DATACUBE SHIPS (//:web; docs/BUILD_REBUILD_DESIGN_2026_10_05.md, D10): the app, the page of one cube on an
# engine (engine.html: Python's engine serves it), and a notebook's cube (the widget's loader and DataCube's module).
# The planner's worker is engine-client's bundle (//engine-client:bundles, the program's C2); :planner_worker is only
# its copy into this site, as Studio's is. (The page of several cubes, demo/page.ts, went with the one-app design's
# step 1d: its checks run on the app, verify_page.) remote-bundle and stress are fixtures of their harnesses
# (verify_remote, run_stress), not product: they leave the site with D5.
filegroup(
    name = "bundles",
    srcs = [
        ":bundle_bundle",
        ":bundle_bundle_engine",
        ":widget",
        ":widget_loader",
    ],
    visibility = ["//:__pkg__"],
)

# The two WebAssembly runtimes the page loads from ./vendor/: DuckDB's, from engine-client's
# npm package, and legend-lite's planner, from //wasm:planner; and the fonts, from legend-art (the pinned @fontsource).
copy_to_directory(
    name = "vendor",
    srcs = [
        "//engine-client:node_modules/@duckdb/duckdb-wasm",
        # its extensions, pinned (MODULE.bazel): ICU for the session's time zone; JSON, Parquet and httpfs when a
        # page reads such a file
        "//engine-client:duckdb_extensions",
        "//legend-art:fonts",
        "//query-store:page",
        "//sdlc-server:page",
        "//warehouse:sqlapi_page",
        "//wasm:planner",
    ],
    out = "demo/vendor",
    include_srcs_patterns = [
        "legend-art/fonts/roboto-latin-400-normal.woff2",
        "legend-art/fonts/roboto-latin-ext-400-normal.woff2",
        "legend-art/fonts/roboto-latin-500-normal.woff2",
        "legend-art/fonts/roboto-latin-ext-500-normal.woff2",
        "legend-art/fonts/roboto-latin-700-normal.woff2",
        "legend-art/fonts/roboto-latin-ext-700-normal.woff2",
        "legend-art/fonts/LICENSE-roboto.txt",
        "engine-client/duckdb-extensions/**",
        "**/dist/duckdb-eh.wasm",
        "**/dist/duckdb-browser-eh.worker.js",
        "wasm/planner/classes.wasm",
        "wasm/planner/wasm-gc-module-runtime.js",
        "sdlc-server/page/classes.wasm",
        "sdlc-server/page/wasm-gc-module-runtime.js",
        # the saved queries' rules, compiled to WebAssembly (the program's B5)
        "query-store/page/classes.wasm",
        "query-store/page/wasm-gc-module-runtime.js",
        # the warehouse's API as the one binding speaks it (the program's C3)
        "warehouse/sqlapi_page/classes.wasm",
        "warehouse/sqlapi_page/wasm-gc-module-runtime.js",
    ],
    replace_prefixes = {
        "engine-client/duckdb-extensions/": "duckdb-extensions/",
        "legend-art/fonts/": "fonts/",
        "**/dist/": "",
        "wasm/planner/": "",
        "sdlc-server/page/": "sdlc/",
        "query-store/page/": "queries/",
        "warehouse/sqlapi_page/": "warehouse/",
    },
)

# The projects a saved query compiles against (config.json `projects[]`): the Query app's trading
# demo, its model and its Data rows served as they are there, never copied into this package.
copy_to_directory(
    name = "projects",
    srcs = [
        "//query:demo/models/runtime-duckdb.pure",
        "//query:demo/models/trading-data.pure",
        "//query:demo/models/trading.pure",
    ],
    out = "demo/projects/trading",
    root_paths = ["query/demo/models"],
)

# The trading rows' other two copies, for the test that holds them equal to the project's Data (saved-queries): the
# warehouse's fixture and the H2 connection's setup, copied as :projects is (a test's data is its own package's).
copy_to_directory(
    name = "trading_copies",
    testonly = True,
    srcs = [
        "//query:demo/models/runtime-h2.pure",
        "//query:demo/models/trading-seed.sql",
    ],
    out = "test/trading-copies",
    root_paths = ["query/demo/models"],
)

# Everything a browser fetches: pages, styles, models, bundles, runtimes.
filegroup(
    name = "site",
    # served beside the other app from one origin (//site): they share the browser's query store
    visibility = ["//site:__pkg__"],
    srcs = glob([
        "demo/*.css",
        "demo/*.html",
        "demo/*.json",
        "demo/*.pure",
        "src/**/*.css",
    ]) + [":bundle_" + out[len("demo/"):-len(".js")].replace("-", "_") for out in _BUNDLES.values()] + [
        ":planner_worker",
        ":projects",
        ":vendor",
        ":widget",
        ":widget_loader",
    ],
)

# Where a harness finds the site (harness.siteRoot): one of its files by runfiles path, never the harness's own
# location (Bazel workplan P4-01, G-07)
_SITE_ENV = {"SITE": "$(rlocationpath demo/index.html)"}

# `bazel run //datacube:serve [-- --data FILE] [-- --open]`: the site, on loopback. A hand tool: manual (2026-10-07,
# PHASE_8.md Gen-5), built by :tools_build_test.
js_binary(
