    # rows put in by DuckDB-WASM's Arrow reader (insertArrowFromIPCStream), the tab's: a headless host's database has
    # none
    "sample-trades": "the tab's Arrow reader",
    # DataCube's HTTP clients against a stubbed fetch: the host has no fetch API (nothing headless speaks HTTP: §3)
    "cancel-http": "the planner client's HTTP",
    "engine-remote-http": "the engine executor's HTTP",
    "planner-http": "the remote planner's HTTP",
    "warehouse-session-http": "the warehouse sign-in's HTTP",
