# DataCube: the browser app over legend-lite's planner (TypeScript on Node).
#
# Its npm packages come from pnpm-lock.yaml through rules_js (MODULE.bazel), with
# Node pinned there. Every test file is its own target — cached and run in
# parallel on its own, and `bazel test //datacube:<name>_test` runs one.
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary")
load("//tools/js:defs.bzl", "node_test")
load("//tools/java:defs.bzl", "legend_java_binary", "legend_java_library")
load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//tools/platforms:defs.bzl", "COMPILER_LIBRARY_PLATFORMS", "compatible_with")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/browser:defs.bzl", "browser_test")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//tools/runfiles:defs.bzl", "executable_of")
load("//tools/java_run:defs.bzl", "java_run")
load("//warehouse:defs.bzl", "warehouse_folder")
load("@tar.bzl", "tar")

load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/js:esbuild.bzl", "esbuild_bundle")
load("@npm//datacube:typescript/package_json.bzl", typescript = "bin")
load("//tools/postgres:defs.bzl", "EMBEDDED_POSTGRES_COMPATIBLE")
load("//tools/guards:defs.bzl", "guards_package")
load(":test_imports.bzl", "TEST_IMPORTS")

npm_link_all_packages(name = "node_modules")

# for //tools/js:lock_matches_package_json_test (P1-26) and //tools/browser:revision_test (P6-19)
exports_files(
    ["package.json", "pnpm-lock.yaml"],
    visibility = [
        "//tools/browser:__pkg__",
        "//tools/js:__pkg__",
    ],
)


# the app's sources as the tests read them; package.json carries
# "type": "module" (the sources are ES modules)
js_library(
    name = "src",
    srcs = glob(["src/**/*.ts"]),
    # the Query app runs its planned SQL on DataCube's engines (DuckDB-WASM, the warehouse)
    visibility = ["//query:__pkg__"],
    deps = [":src_base"],
)

# what every source file needs beside itself: the package's module settings and the libraries the sources import. A
# test takes this and the files its imports reach (TEST_IMPORTS, P3-34), not all of :src.
js_library(
    name = "src_base",
    srcs = [
        "package.json",
        "tsconfig.json",
    ],
    deps = [
        # the protocol library (T4b): the cube's queries built as protocol JSON
        "//pure-protocol:pure_protocol",
        # saved queries: the one client, and the store answered in the page (query-store/README.md)
        "//query-store:query_store",
        # where a query runs: the engine interface, results, the type reader, DuckDB, the warehouse,
        # pure/v1 (engine-client/README.md; moved out of here 2026-10-04)
        "//engine-client:engine_client",
        "//engine-client:node_modules/@duckdb/duckdb-wasm",
        # fflate: the share link's deflate WITH A PRESET DICTIONARY (src/share/link.ts), which the
        # browser's own CompressionStream cannot take. MIT, no dependencies of its own.
        ":node_modules/fflate",
        # Apache ECharts: the chart windows (src/chart-render.ts is its one importer; only
        # the charts and components used are registered, via echarts/core).
        ":node_modules/echarts",
    ],
)

# the cube's stylesheets, for the Query app, which shows its results in a CubeApp
filegroup(
    name = "styles",
    srcs = glob(["src/**/*.css"]),
    visibility = ["//query:__pkg__"],
)

_TESTS = glob(["test/*.test.ts"])

# THE SOURCE SCANNERS (Bazel workplan P3-29): the tests that read this package's sources as text. Each reads exactly
# the files named here, passed in SOURCES by $(rlocationpaths) and read through //tools/js:runfiles' Sources: no
# scanner walks a directory or reads from the working directory, and a file it should see is one it declares.
_SCANNED = {
    "config-readers": [":src"],
    # the shipped trees: the app, the engine client (DataCube's until 2026-10-04) and the demo, and the
    # differentials behind the second planner transport
    "guardrails": [
        ":src",
        "//engine-client:engine_client",
        ":scanned_demo",
        "test/wasm-differential/compare.ts",
        "//wasm:differential",
    ],
    "menu-ids": [":src"],
    # everything a build or a person runs from this package
    "portability": [":src", ":scanned_scripts"],
    "state-guardrail": [":src"],
    # the WASM list against the files that load the planner (A28)
    "wasm-flag": ["BUILD.bazel", ":scanned_tests"],
}

filegroup(
    name = "scanned_demo",
    srcs = glob(["demo/**/*.ts"]) + ["demo/index.html"],
)

filegroup(
    name = "scanned_scripts",
    srcs = glob(
        [
            "bench/**/*",
            "demo/**/*.mjs",
            "demo/**/*.ts",
            "test/**/*.ts",
            "tools/**/*",
        ],
        exclude = ["**/*.md"],
    ),
)

filegroup(
    name = "scanned_tests",
    srcs = glob(["test/*.test.ts"]),
)

# Each test's inputs by runfiles path ($(rlocationpath); tools/js/runfiles.mts), beside _EXTRA_DATA.
# THE SHARE LINK'S NEXT DICTIONARY VERSION (P2-08; see :cut_link_dictionary)
_NEXT_LINK_VERSION = "p2"

_NEXT_LINK_FILE = "src/share/link-%s.ts" % _NEXT_LINK_VERSION

_EXTRA_ENV = {
    "bundle-budget": {
        "BUNDLE": "$(rlocationpath :demo/bundle.js)",
        "ENGINE_BUNDLE": "$(rlocationpath :demo/bundle-engine.js)",
        "WIDGET": "$(rlocationpath :demo/widget.js)",
        "WIDGET_LOADER": "$(rlocationpath :demo/widget-loader.js)",
    },
    # every dictionary version in the tree, and the next one's name: each version needs its hash pinned, and the
    # next one is not cut yet
    "share-link": {
        "LINK_VERSIONS": " ".join([f[len("src/share/link-"):-len(".ts")] for f in glob(["src/share/link-*.ts"])]),
        "NEXT_LINK_VERSION": _NEXT_LINK_VERSION,
    },
    "saved-queries": {
        "SAVED_QUERIES": "$(rlocationpaths //fixtures/saved-queries:records)",
        "TRADING_PROJECT": "$(rlocationpath :projects)",
    },
}

# DuckDB-WASM's users load it from node_modules by name, so they declare it (DC-N3.6)
_DUCKDB_USERS = ["duckdb", "group-derived", "saved-queries", "sorting", "treeview", "upload"]

# What a test reads from disk beyond src/: the guardrails scan the demo
# entry points too (they ship), so they are declared, not assumed.
_EXTRA_DATA = {
    # the page's own bundle and its lazy chunks, measured against their budget (plan F7)
    "bundle-budget": [
        ":bundle_bundle",
        ":bundle_bundle_engine",
        ":demo/bundle-engine.js",
        ":demo/bundle.js",
        ":demo/widget-loader.js",
        ":demo/widget.css",
        ":demo/widget.js",
    ],
    # the saved queries Query writes, and the project they compile against
    "saved-queries": ["//fixtures/saved-queries:records", ":projects"],
    # the in-memory source the Ad Hoc Analysis tests query
    "adhoc-session": ["test/adhoc-fixture.ts"],
    "adhoc-mode": ["test/adhoc-fixture.ts"],
    "adhoc-transactions": ["test/adhoc-fixture.ts", "test/gate.ts"],
    # the cube as a person meets it, over a gated engine (Leg B's app-level tests)
    "cube-transactions": ["test/cube-fixture.ts", "test/gate.ts"],
    "cube-lifecycle": ["test/cube-fixture.ts", "test/gate.ts"],
    "cube-editors-app": ["test/cube-fixture.ts", "test/gate.ts"],
    "cube-adhoc-shell": ["test/cube-fixture.ts", "test/gate.ts"],
    "multi-cube": ["test/cube-fixture.ts", "test/gate.ts"],
    "chart-tiles": ["test/cube-fixture.ts", "test/gate.ts"],
}

# the tests that write a model from a table's columns ask the compiler (T2): legend-lite's
# own WASM module, loaded by test/catalog-builder.ts
_WASM_TESTS = [
    "calc-fix",
    "infer",
    "offer-facts",
    "upload",
    "treeview",
    "type-columns",
    "adhoc-query",
    "child-groups",
    "column-kind",
    "config",
    "drill",
    "escaping",
    "filter-editor",
    "fuzz",
    "group-derived",
    "pivot-total",
    "query",
    "sorting",
    "window-columns",
    "json-shape",
    "column-editor",
    "saved-queries",
]

# node:test files, each its own node_test (tools/js/defs.bzl: types stripped, the spec and strict reporters, a
# pinned locale and clock). Each finds its inputs through //tools/js:runfiles.
[node_test(
    name = t[len("test/"):-len(".test.ts")].replace("-", "_") + "_test",
    # The tests that load the WebAssembly planner compile it first: seconds on a desk (infer: 6 s), but past
    # `small`'s 60 s on CI's Windows runner while the same lane builds the native image (main's CI run
    # 37214692462, 2026-10-04). Those get `medium` (300 s); the rest stay `small`.
    size = "medium" if t[len("test/"):-len(".test.ts")] in _WASM_TESTS else "small",
    # a scanner reads every source; any other test, the files its imports reach (a test not yet in the generated
    # list takes them all until //datacube:update_generated adds it)
    data = [
        ":node_modules/jsdom",
        "test/fake-engine.ts",
        "test/fake-planner.ts",
    ] + _EXTRA_DATA.get(t[len("test/"):-len(".test.ts")], []) + [f for f in _SCANNED.get(t[len("test/"):-len(".test.ts")], []) if f != ":src"] + (
        [":src"] if t[len("test/"):-len(".test.ts")] in _SCANNED or t[len("test/"):-len(".test.ts")] not in TEST_IMPORTS else [":src_base"] + TEST_IMPORTS[t[len("test/"):-len(".test.ts")]]
    ) + (
        ["//engine-client:node_modules/@duckdb/duckdb-wasm"] if t[len("test/"):-len(".test.ts")] in _DUCKDB_USERS else []
    ) + (
        ["test/catalog-builder.ts", "test/lite-compiler.ts", "//pure-protocol:typescript_sources"] if t[len("test/"):-len(".test.ts")] in _WASM_TESTS else []
    ),
    entry_point = t,
    env = _EXTRA_ENV.get(t[len("test/"):-len(".test.ts")], {}) | ({
        "SOURCES": " ".join(["$(rlocationpaths %s)" % f for f in _SCANNED[t[len("test/"):-len(".test.ts")]]]),
    } if t[len("test/"):-len(".test.ts")] in _SCANNED else {}),
    wasm = t[len("test/"):-len(".test.ts")] in _WASM_TESTS,
) for t in _TESTS]

test_suite(
    name = "tests",
    tests = [t[len("test/"):-len(".test.ts")].replace("-", "_") + "_test" for t in _TESTS] + [
        ":typecheck_test",
        ":pivot_rows_test",
        ":json_read_test",
        ":cube_open_test",
        ":typed_values_test",
        ":typed_values_tokyo_test",
        ":typed_values_new_york_test",
        ":wasm_differential_test",
        # live against the Bazel-built native warehouse (it builds the native image; not on Windows ARM64)
        ":live_snap_test",
    ],
)

# THE TYPECHECK: tsc over everything tsconfig.json includes (src, test, bench,
# demo, tools), types only — the tests run the same files with types stripped, so
# without this a type error ships unnoticed.
typescript.tsc_test(
    name = "typecheck_test",
    size = "small",
    args = ["-p", package_name() + "/tsconfig.json"],
    data = glob([
        "src/**/*.ts",
        "test/**/*.ts",
        "demo/**/*.ts",
        "tools/**/*.ts",
    ]) + [
        "package.json",
        "tsconfig.json",
        "//engine-client:engine_client",
        "//engine-client:typescript_sources",
        "//depot-client:depot_client",
        "//sdlc-client:sdlc_client",
        "//pure-protocol:typescript_sources",
        "//tools/js:runfiles",
        "//query-store:typescript_sources",
        "//engine-client:node_modules/@duckdb/duckdb-wasm",
        ":node_modules/@types/jsdom",
        ":node_modules/echarts",
        ":node_modules/fflate",
        ":node_modules/@types/node",
        ":node_modules/jsdom",
        ":node_modules/playwright",
    ],
)

# LITE'S FACTS (decision D1) moved with the type reader to engine-client/ (2026-10-04):
# `bazel run //engine-client:update_generated`.

# WHAT A TYPE ACCEPTS (T5): DataCube's own queries -- each aggregate as a level's
# measure, each filter operator as a condition, over a column of every type -- written
# by the product's query builder (tools/offer-facts/emit.ts) and compiled by legend-lite
# (OfferFacts.java): the measure's type, or the functions a condition resolved to.
js_binary(
    name = "emit_offer_queries",
    data = [":src"],
    entry_point = "tools/offer-facts/emit.ts",
    node_options = [
        "--experimental-strip-types",
        "--disable-warning=ExperimentalWarning",
    ],
)

# THE SHARE LINK'S DICTIONARY (milestone 1b): made ONCE per version from the product's own
# vocabulary, then frozen in src/share/link-<version>.ts, pinned by its hash in test/share-link.test.ts
# (links made with it must open forever). The tool reads the LIVE vocabulary, which grows (p1 has no
# treemap mark), so a frozen version is held by its hash, never by re-running the tool (P2-08).
js_binary(
    name = "make_link_dictionary",
    data = [
        ":src",
        "tools/link-dictionary/make.ts",
    ],
    entry_point = "tools/link-dictionary/make.ts",
    node_options = [
        "--experimental-strip-types",
        "--disable-warning=ExperimentalWarning",
    ],
    # a hand tool: manual (2026-10-07, PHASE_8.md Gen-5), built by :tools_build_test
    tags = ["manual"],
)

# The next version, from today's vocabulary: a tool run on demand, so not part of //... (manual; the build only
# compiles, docs/BUILD_REBUILD_DESIGN_2026_10_05.md). To ship it, `bazel run //datacube:cut_link_dictionary` writes
# src/share/link-<version>.ts once (a DRAFT, the docs:draft_own_corpus_ledger pattern: no diff test, the hash pin is
# the freeze); then pin its hash in test/share-link.test.ts and move _NEXT_LINK_VERSION (above) on. share_link_test
# fails until both are done.
js_run_binary(
    name = "link_dictionary_next",
    args = [_NEXT_LINK_VERSION],
    stdout = "link-%s.gen.ts" % _NEXT_LINK_VERSION,
    tags = ["manual"],
    tool = ":make_link_dictionary",
)

write_source_files(
    name = "cut_link_dictionary",
    check_that_out_file_exists = False,
    diff_test = False,
    files = {_NEXT_LINK_FILE: ":link_dictionary_next"},
    tags = ["manual"],
)

js_run_binary(
    name = "offer_queries",
    srcs = ["tools/offer-facts/emit.ts"],
    outs = [
        "offer_model.pure",
        "offer_queries.tsv",
    ],
    args = [
        package_name() + "/offer_model.pure",
        package_name() + "/offer_queries.tsv",
    ],
    tool = ":emit_offer_queries",
)

legend_java_library(
    name = "offer_facts_main",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    srcs = ["tools/offer-facts/OfferFacts.java"],
    deps = [
        "//core:compiler",
        "//core:compiler_element_type",
        "//core:plan",
        "//core:planner",
        "//core:protocol",
    ],
)

java_run(
    name = "offer_facts",
    srcs = [
        "offer_model.pure",
        "offer_queries.tsv",
    ],
    outs = ["generated/offer-facts.gen.ts"],
    arguments = [
        "$(execpath offer_model.pure)",
        "$(execpath offer_queries.tsv)",
        "{OUT}",
    ],
    main_class = "offerfacts.OfferFacts",
    deps = [":offer_facts_main"],
)

# THE TESTS' IMPORT CLOSURES (P3-34): test_imports.bzl, generated from the imports themselves, diff-tested below
js_binary(
    name = "test_imports_tool",
    entry_point = "tools/test-imports.mts",
    node_options = [
        "--experimental-strip-types",
        "--disable-warning=ExperimentalWarning",
    ],
)

filegroup(
    name = "import_scan",
    srcs = glob(["src/**/*.ts", "test/**/*.ts"]),
)

js_run_binary(
    name = "test_imports",
    srcs = [":import_scan"],
    outs = ["test_imports_generated.bzl"],
    args = [
        package_name() + "/test_imports_generated.bzl",
        package_name(),
        "$(rootpaths :import_scan)",
    ],
    tool = ":test_imports_tool",
)

write_source_files(
    name = "update_generated",
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nlegend-lite changed a fact this cube mirrors — regenerate: bazel run //datacube:update_generated, then read the diff (a changed Pure kind or pivot separator changes what the grid shows; a changed offer fact changes what a column is offered)",
    files = {
        "src/generated/offer-facts.ts": ":offer_facts",
        "test_imports.bzl": ":test_imports",
    },
    visibility = ["//:__pkg__"],
)

# THE CUBE'S WASM DIFFERENTIAL: DataCube's serialiser writes the queries, the
# JVM answers them (a build output), and the test plans them through the
# product's WasmPlanner over //wasm:planner and compares.
js_binary(
    name = "emit_cube_queries",
    data = [":src"],
    entry_point = "test/wasm-differential/emit.ts",
    node_options = [
        "--experimental-strip-types",
        "--disable-warning=ExperimentalWarning",
    ],
)

js_run_binary(
    name = "cube_queries",
    testonly = True,
    srcs = [
        "test/wasm-differential/cases.ts",
        "test/wasm-differential/emit.ts",
    ],
    outs = [
        "cube_model.pure",
        "cube_queries.tsv",
    ],
    args = [
        package_name() + "/cube_model.pure",
        package_name() + "/cube_queries.tsv",
    ],
    tool = ":emit_cube_queries",
)

java_run(
    name = "cube_jvm_answers",
    testonly = True,
    srcs = [
        "cube_model.pure",
        "cube_queries.tsv",
    ],
    outs = ["cube_jvm_answers.txt"],
    arguments = [
        "$(execpath cube_model.pure)",
        "$(execpath cube_queries.tsv)",
        "trades::RT",
        "{OUT}",
        "json",
    ],
    main_class = "planner.JvmMain",
    deps = ["//wasm:jvm_main"],
)

node_test(
    name = "wasm_differential_test",
    wasm = True,
    # loads the WebAssembly planner, as _WASM_TESTS do: medium for the same reason (main's CI run 37214692462)
    size = "medium",
    data = [
        "test/wasm-differential/cases.ts",
        ":cube_jvm_answers",
        ":src",
    ],
    entry_point = "test/wasm-differential/compare.ts",
    env = {"CUBE_JVM_ANSWERS": "$(rlocationpath :cube_jvm_answers)"},
)

# PIVOTS JUDGED BY ROWS (docs/DATACUBE_CUBE_PLAN_DESIGN_2026_09_27.md): the real
