# THE APP (docs/DATACUBE_APP_PLAN_2026_10_02.md): one folder, bazel-bin/datacube/app -- the native warehouse beside
# DuckDB's library, its postgres extension and this site (warehouse_folder, warehouse/defs.bzl; the build rebuild's
# L1c, 2026-10-07) -- started with --app (the account running it is its one user; the site beside the executable is
# the page) and --open (the browser, on the tables of the databases named):
#   bazel run //datacube:app -- postgresql://bob@db:5432/shop [--table sales.orders]
# `bazel run` starts it in Bazel's runfiles folder, so a relative path among the arguments is relative to that: give
# absolute paths. The server knows nothing of Bazel; :app_package is the same folder as an archive.
warehouse_folder(
    name = "app",
    args = [
        "--app",
        "--open",
    ],
    extension = "//warehouse:postgres_extension",
    library = "//warehouse:duckdb_library",
    # what the app redistributes, and on what terms: ours, the notices we carry and GraalVM's (its runtime is compiled
    # into the server), in licenses/ -- the package is the folder, so it carries them too
    licenses = {
        "//:LICENSE": "LICENSE",
        "//:NOTICE": "NOTICE",
        "//:THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
        "@graalvm//:LICENSE.txt": "GRAALVM-LICENSE.txt",
        "@graalvm//:LICENSE_NATIVEIMAGE.txt": "GRAALVM-LICENSE-NATIVEIMAGE.txt",
        "@graalvm//:THIRD_PARTY_LICENSE.txt": "GRAALVM-THIRD-PARTY-LICENSE.txt",
    },
    server = "//warehouse:server_native",
    site = ":dist",
)

# the app's executable alone, for a test to name by $(rlocationpath); the folder around it is the app
executable_of(
    name = "app_executable",
    binary = ":app",
)

# THE PACKAGE: the app folder as datacube-app.tar.gz, its entries under datacube/app/ as built (bsdtar pinned by
# tar.bzl: no host tar). The folder's four entries only: not the runfiles tree Bazel keeps beside the executable
# (include_runfiles). Not renamed: tar.bzl's mutate runs gawk under a shell, and bsdtar's own -s leaves the empty
# parent entry behind (measured 2026-10-07); a Starlark mtree writer could rename, if a nicer path is ever wanted.
# Unpacked anywhere, `datacube/app/warehouse --app --open postgresql://...` is the app with no Bazel on the machine;
# that the folder works that way is :verify_app_test's finding, which starts it from a plain directory. CI's product
# job builds it; the datacube lane builds it again, for :package_test.
tar(
    name = "app_package",
    srcs = [":app"],
    compress = "gzip",
    include_runfiles = False,
    out = "datacube-app.tar.gz",
)

# THE PACKAGE'S ENTRIES, JUDGED (L1d, 2026-10-07): the app folder's four things and nothing else -- not the runfiles tree
# Bazel keeps beside the executable, which include_runfiles above leaves out and nothing else would notice coming back
# (the audit of L1c found the package at twice its size). Node reads the archive itself: no host tar.
node_test(
    name = "package_test",
    size = "medium",
    data = [":app_package"],
    entry_point = "test/package/entries.ts",
    env = {"APP_PACKAGE": "$(rlocationpath :app_package)"},
)

# `bazel build //datacube:dist`: the site as a folder for any static host — no
# backend; the planner is WebAssembly and so is DuckDB.
js_binary(
    name = "make_dist",
    entry_point = "demo/make-dist.mjs",
)

js_run_binary(
    name = "dist",
    srcs = [":site"],
    args = [
        package_name(),
        package_name() + "/dist",
    ],
    out_dirs = ["dist"],
    tool = ":make_dist",
    # //python:repl serves it with Python's engine (show())
    visibility = ["//python:__pkg__"],
)

# THE BROWSER HARNESSES, BY HAND: `bazel run //datacube:<name>`, the manual form of the browser_tests below
# (the same scripts; as tests they drive the Chromium Bazel fetches, by hand Playwright's own, installed once with
# :install_browser). Several need a live engine as well (the script says which) and are tools only.
_HARNESS_HELPERS = [
    "demo/engine-cases.mjs",
    # the one module every harness shares: its server, the site root, outputs and temp paths, checks (P4-01)
    "demo/harness.mjs",
    "demo/static-files.ts",
    "demo/grid-invariants.mjs",
    "demo/stress-corpus.ts",
    "demo/torture.pure",
    "demo/trades.pure",
    "demo/trades-h2.pure",
    "demo/typed-view.mjs",
    "demo/warehouse-source.mjs",
]

_HARNESSES = [
    "chaos",
    "make-sample",
    "measure-startup",
    "run-stress",
    "shots",
    "torture",
    # the screenshot tour (docs/DATACUBE_TOUR.md): each step checked and shot, a gallery beside the pictures
    "tour",
    "verify-calc-vocabulary",
    "verify-charts",
    "verify-class",
    "verify-cubes",
    "verify-engine",
    "verify-engine-differential",
    "verify-features",
    "verify-join",
    "verify-layout",
    "verify-page",
    "verify-picker",
    "verify-real-data",
    "verify-remote",
    "verify-smoke",
    "verify-upload",
    "verify-wasm-browser",
]

# the harnesses that start DuckDB in Node (engine-client's startNodeDuckDb)
_NODE_DUCKDB_HARNESSES = [
    "verify-real-data",
    "verify-remote",
]

# THE MECHANICAL HARNESSES AS TESTS (Bazel workplan P4-02): each against the pinned Chromium, with a result and a
# timeout; no fixed sleep in any of them (G-11). run-stress is the long one.
_BROWSER_TESTS = {
    "run-stress": "enormous",
    "verify-charts": "large",
    # Create a Class… (docs/DATACUBE_MODEL_DESIGN_2026_10_10.md §15.7): two classes of two grids, in the page's SDLC
    "verify-class": "large",
    "verify-cubes": "large",
    # Join… (docs/DATACUBE_MODEL_DESIGN_2026_10_10.md §17.5): two files joined, what it will do said first, saved and reopened
    "verify-join": "large",
    "verify-layout": "large",
    "verify-page": "large",
    "verify-upload": "large",
    "verify-wasm-browser": "large",
}

[js_binary(
    name = h.replace("-", "_"),
    # make-sample writes a CSV from the sources: it needs no site, no browser (P4-08)
    data = [":src"] if h == "make-sample" else _HARNESS_HELPERS + [
        # named itself: SITE is its runfiles path
        "demo/index.html",
        ":node_modules/playwright",
        ":site",
        ":src",
        # harness.mjs finds the site through it (a node_test has it already)
        "//tools/js:runfiles",
    ] + (["//fixtures/saved-queries:records"] if h == "verify-features" else []) + (
        # it imports pinned-chromium.mjs first, a no-op under bazel run
        ["//tools/browser:pinned_chromium"] if h in ["tour", "verify-smoke", "verify-remote", "verify-real-data", "verify-features"] or h in _BROWSER_TESTS else []
    ) + (
        # DuckDB in Node builds their fixture, its extensions the pinned ones (as node_test gives a test that takes it)
        ["//engine-client:duckdb_extensions"] if h in _NODE_DUCKDB_HARNESSES else []
    ),
    entry_point = "demo/" + h + ".mjs",
    env = {} if h == "make-sample" else _SITE_ENV | ({"SAVED_QUERIES": "$(rlocationpaths //fixtures/saved-queries:records)"} if h == "verify-features" else {}) | (
        {"DUCKDB_EXTENSIONS": "$(rlocationpaths //engine-client:duckdb_extensions)"} if h in _NODE_DUCKDB_HARNESSES else {}
    ),
    node_options = [
        "--experimental-strip-types",
        "--experimental-wasm-exnref",
        "--disable-warning=ExperimentalWarning",
    ],
    # hand tools, run by a person: manual (2026-10-07, PHASE_8.md Gen-5); CI runs the harnesses as the tests below,
    # and :tools_build_test keeps these compiling
    tags = ["manual"],
) for h in _HARNESSES]

# THE SMOKE HARNESS AS A TEST (Bazel workplan P1-14, the pilot): against the Chromium Bazel fetched
# (//tools/browser), with no install step and nothing in $HOME. .
# The other harnesses follow in P4.
browser_test(
    name = "verify_smoke_test",
    size = "large",
    # sharded by sample (verify-smoke.mjs: shard i takes every n-th): 16 samples, 4 each (P4-02)
    shard_count = 4,
    data = _HARNESS_HELPERS + [
        # named itself: SITE is its runfiles path
        "demo/index.html",
        ":node_modules/playwright",
        ":site",
        ":src",
    ],
    entry_point = "demo/verify-smoke.mjs",
    env = _SITE_ENV,
    wasm = True,
)

[browser_test(
    name = h.replace("-", "_") + "_test",
    size = size,
    data = _HARNESS_HELPERS + [
        "demo/index.html",
        ":node_modules/playwright",
        ":site",
        ":src",
    ],
    entry_point = "demo/" + h + ".mjs",
    env = _SITE_ENV,
    # CI runs these on Linux only (gates-run.yml filters the tag on macOS and Windows): the same on every platform,
    # and live-vs-snap already checks x86_64 against the arm64 desks (the build rebuild's L1b, 2026-10-07)
    tags = ["ci-linux-only"],
    wasm = True,
) for h, size in _BROWSER_TESTS.items()]

# the two remote-data harnesses as one test, a shard each (P4-03): demo/verify-remote-test.mjs
browser_test(
    name = "verify_remote_test",
    size = "large",
    shard_count = 2,
    data = _HARNESS_HELPERS + [
        "demo/index.html",
        "demo/verify-real-data.mjs",
        "demo/verify-remote.mjs",
        # the package moved to engine-client after bazel/exec branched (2026-10-04)
        "//engine-client:node_modules/@duckdb/duckdb-wasm",
        ":node_modules/playwright",
        ":site",
        ":src",
    ],
    entry_point = "demo/verify-remote-test.mjs",
    env = _SITE_ENV,
    tags = ["ci-linux-only"],
    wasm = True,
)

# the feature sweep, sharded by section (P4-04): each section from a fresh cube, so one can fail without hiding another
browser_test(
    name = "verify_features_test",
    size = "large",
    shard_count = 4,
    data = _HARNESS_HELPERS + [
        "demo/index.html",
        ":node_modules/playwright",
        ":site",
        ":src",
        "//fixtures/saved-queries:records",
    ],
    entry_point = "demo/verify-features.mjs",
    env = _SITE_ENV | {"SAVED_QUERIES": "$(rlocationpaths //fixtures/saved-queries:records)"},
    tags = ["ci-linux-only"],
    wasm = True,
)

# THE SCREENSHOT TOUR AS A TEST (the user, 2026-10-17; docs/DATACUBE_TOUR.md): every flow a person meets, each step
# checked and shot, the gallery (index.html and a picture per step) in the test's outputs. Manual, in //gates:heavy:
# run from time to time, and by hand before a DataCube change lands; the checks it makes are verify-*'s own, so no lane
# loses a check by its being manual.
browser_test(
    name = "tour_test",
    size = "large",
    data = _HARNESS_HELPERS + [
        "demo/index.html",
        ":node_modules/playwright",
        ":site",
        ":src",
    ],
    entry_point = "demo/tour.mjs",
    env = _SITE_ENV,
    tags = ["manual"],
    wasm = True,
)

# the browser tests' guard bites (tools/browser/pinned-chromium.mjs): a page cannot reach extensions.duckdb.org, under
# either of Playwright's launches; on every platform, a few seconds
browser_test(
    name = "browser_guard_test",
    data = [":node_modules/playwright"],
    entry_point = "test/browser-guard.mjs",
)

# every browser test of this package (P4-09's //:browser names it)
test_suite(
    name = "browser",
    tests = [
        ":browser_guard_test",
        ":verify_features_test",
        ":verify_remote_test",
        ":verify_smoke_test",
    ] + [":" + h.replace("-", "_") + "_test" for h in _BROWSER_TESTS],
)

# `bazel run //datacube:verify_app` (manual; see demo/verify-app.mjs for its Postgres): the single-user app
# end to end -- the app folder (:app) copied to a plain directory and started there, from the launch key.
js_binary(
    name = "verify_app",
    data = [
        ":app",
        ":app_executable",
        ":node_modules/playwright",
        # it imports pinned-chromium.mjs first, a no-op under bazel run
        "//tools/browser:pinned_chromium",
        "//tools/js:runfiles",
    ],
    entry_point = "demo/verify-app.mjs",
    # the app's executable by runfiles path; the folder around it is the app
    env = {"APP": "$(rlocationpath :app_executable)"},
    tags = ["manual"],
)

# THE APP AGAINST POSTGRES, AS A TEST ON EVERY PLATFORM (Bazel workplan P1-14b, D11 revised): verify-app.mjs's
# checks with the Postgres it needs started inside the test -- :app_postgres, Postgres 16 from the pinned
# binaries loaded with the guide's sample over JDBC -- and the pinned Chromium. No psql, no host Postgres,
# no host browser. CI's datacube lane runs it on Linux, macOS and Windows: the Windows desk's own path. Since L1c
# it starts the app folder from a plain directory, with none of Bazel's variables: a package's user's way.
browser_test(
    name = "verify_app_test",
    size = "large",
    data = [
        ":app",
        ":app_executable",
        ":app_postgres",
        ":app_postgres_executable",
        ":node_modules/playwright",
        "demo/sample-shop.sql",
    ],
    entry_point = "demo/verify-app.mjs",
    env = {
        "APP": "$(rlocationpath :app_executable)",
        "APP_POSTGRES": "$(rlocationpath :app_postgres_executable)",
        "SAMPLE_SQL": "$(rlocationpath demo/sample-shop.sql)",
    },
)

executable_of(
    name = "app_postgres_executable",
    testonly = True,
    binary = ":app_postgres",
)

# the test's Postgres (tools/apppostgres/AppPostgres.java): prints its port once the sample is in, and runs
# until its stdin closes
legend_java_binary(
    name = "app_postgres",
    # starts the embedded Postgres: skipped where no build is pinned (P1-15)
    target_compatible_with = EMBEDDED_POSTGRES_COMPATIBLE,
    testonly = True,
    srcs = ["tools/apppostgres/AppPostgres.java"],
    data = [
        "@embedded_postgres//:pg/PG_ROOT",
        "@embedded_postgres//:postgres",
    ],
    jvm_flags = ["-Dembedded.postgres.root=$(rlocationpath @embedded_postgres//:pg/PG_ROOT)"],
    main_class = "apppostgres.AppPostgres",
    runtime_deps = ["//core:drivers"],
    deps = ["//testing"],
)

# `bazel run //datacube:install_browser [-- --with-deps]`: Playwright's own Chromium, at the version the lock file
# pins, for a desk that runs the harnesses outside Bazel; no test needs it (every harness is a test on the Chromium
# Bazel fetches, since L1b). Manual (2026-10-07).
js_binary(
    name = "install_browser",
    data = [":node_modules/playwright"],
    entry_point = "demo/install-browser.mjs",
    tags = ["manual"],
)

# every hand tool of this package compiles (the build rebuild's L1b): the checks lane builds them, nothing runs
build_test(
    name = "tools_build_test",
    targets = [":" + h.replace("-", "_") for h in _HARNESSES] + [
        ":install_browser",
        ":link_dictionary_next",
        ":make_link_dictionary",
        ":serve",
        ":verify_app",
    ],
)

guards_package()
