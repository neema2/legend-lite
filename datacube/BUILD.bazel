# DATACUBE AGAINST PYTHON'S ENGINE (docs/DATACUBE_PYTHON_SHOW_DESIGN_2026_10_08.md), in the pinned Chromium as
# live_snap_test is: Python's engine (//python:engine_fixture) serves the site and the API, one origin; the page
# (test/python-engine/page.ts) runs the cube corpus through DataCube's remote-run path against it, and again in the tab
# on the same rows, and they must agree; it also reads legend-engine's own recorded Arrow answer. Where the compiler's
# library builds (//native:compiler: not Windows). In the warehouse lane (gates/BUILD.bazel), where that library's image
# is built before the tests, not here beside the planner's TeaVM build (the Bazel program session, 2026-10-08).
esbuild_bundle(
    name = "python_engine_page",
    testonly = True,
    srcs = [
        "test/python-engine/page.ts",
        "test/wasm-differential/cases.ts",
        ":src",
    ],
    outs = ["test/python-engine/python-engine.js"],
    args = [
        "test/python-engine/page.ts",
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--log-level=warning",
        "--outfile=test/python-engine/python-engine.js",
    ],
)

# Python's engine for the test (test/python-engine/engine_fixture.py): the cube corpus's rows as a Live frame, the site
# beside the API. It prints the engine's address, its token and the frame's model, then serves until its input closes;
# the library comes by LEGEND_LITE_LIBRARY from the test (a binary a test starts gets no BUILD env).
py_binary(
    name = "engine_fixture",
    testonly = True,
    srcs = ["test/python-engine/engine_fixture.py"],
    main = "test/python-engine/engine_fixture.py",
    # where the compiler's library and the Python wheels exist (//python's tests: the same platforms); elsewhere it is
    # skipped as incompatible, never analysed against a wheel there is none of (CI's A25 analysis, the product step)
    target_compatible_with = compatible_with(COMPILER_LIBRARY_PLATFORMS),
    deps = [
        "//python:legend_lite",
        "//python:notebook",
    ],
)

# legend-engine's own Arrow answer, recorded in core (upstream-api/): a file of this package, as rules_js's tests take
copy_file(
    name = "upstream_arrow_answer",
    testonly = True,
    src = "//core:src/test/resources/upstream-api/e8-arrow-groupby-sort.arrows.zst",
    out = "test/python-engine/upstream.arrows.zst",
)

browser_test(
    name = "python_engine_test",
    size = "medium",
    data = [
        "test/python-engine/python-engine.mjs",
        ":dist",
        ":node_modules/playwright",
        ":python_engine_page",
        ":engine_fixture",
        ":upstream_arrow_answer",
        "//native:compiler",
    ],
    entry_point = "test/python-engine/python-engine.mjs",
    env = {
        "DATACUBE_SITE": "$(rlocationpath :dist)",
        "ENGINE_FIXTURE": "$(rlocationpath :engine_fixture)",
        "LEGEND_LITE_LIBRARY": "$(rlocationpath //native:compiler)",
        "PYTHON_ENGINE_PAGE": "$(rlocationpath :python_engine_page)",
        "UPSTREAM_ARROW_ANSWER": "$(rlocationpath :upstream_arrow_answer)",
    },
)

# ── THE DEMO SITE ───────────────────────────────────────────────────────────────
# Built where the pages expect it: rules_js lays sources and outputs side by side
# in bazel-bin/datacube, so demo/index.html finds ./bundle.js and ./vendor/ as it
# does in a checkout, and every harness in demo/ that serves this directory runs
# as it is written.

# entry point -> bundle
_BUNDLES = {
    "demo/main.ts": "demo/bundle.js",
    "demo/page.ts": "demo/bundle-page.js",
    "src/planner-worker.ts": "demo/planner-worker.js",
    "demo/remote-harness.ts": "demo/remote-bundle.js",
    "demo/stress.ts": "demo/stress.js",
    # one cube on an engine that runs its queries (Python's: docs/DATACUBE_PYTHON_SHOW_DESIGN_2026_10_08.md)
    "demo/engine.ts": "demo/bundle-engine.js",
}

# Split: what a page loads only when it needs it (ECharts, the first time a chart draws -- plan
# F7) is a chunk beside the bundle, in its own directory per bundle, fetched by the bundle itself.
# The planner's worker is one file: it loads nothing lazily, and a worker's imports are its own.
_UNSPLIT = ["src/planner-worker.ts"]

[esbuild_bundle(
    name = "bundle_" + out[len("demo/"):-len(".js")].replace("-", "_"),
    # demo/boot.ts opens a saved query's project by name from Depot (the model home; design Phase 3)
    srcs = glob(["demo/**/*.ts"]) + [":src", "//depot-client:depot_client", "//sdlc-client:sdlc_client"],
    outs = [out],
    out_dirs = [] if entry in _UNSPLIT else ["demo/chunks-" + out[len("demo/"):-len(".js")]],
    args = [
        entry,
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--log-level=warning",
    ] + (["--outfile=" + out] if entry in _UNSPLIT else [
        "--splitting",
        "--outdir=demo",
        "--entry-names=" + out[len("demo/"):-len(".js")],
        "--chunk-names=chunks-" + out[len("demo/"):-len(".js")] + "/[name]-[hash]",
    ]),
) for entry, out in _BUNDLES.items()]

# A NOTEBOOK'S CUBE (legend_lite.notebook.DataCube; docs/DATACUBE_PYTHON_SHOW_DESIGN_2026_10_08.md, "In a notebook"):
# anywidget's script, a small loader (widget-loader.js), and DataCube's module, which the loader fetches over the
# widget's channel once per notebook page: widget.js, one file with no lazy chunks (a module imported from a blob URL
# loads none beside it), minified with its names kept, and widget.css, DataCube's styles (in the notebook's own type).
esbuild_bundle(
    name = "widget_loader",
    srcs = ["demo/widget-loader.ts"],
    outs = ["demo/widget-loader.js"],
    args = [
        "demo/widget-loader.ts",
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--log-level=warning",
        "--outfile=demo/widget-loader.js",
    ],
)

esbuild_bundle(
    name = "widget",
    srcs = [
        "demo/engine-cube.ts",
        "demo/widget.ts",
        "demo/widget-loader.ts",
        "demo/widget-styles.css",
        ":src",
    ] + glob(["src/**/*.css"]),
    outs = [
        "demo/widget.css",
        "demo/widget.js",
    ],
    args = [
        # two entry points, both named widget: the module (widget.js) and its styles (widget.css). The styles are their
        # own entry ON PURPOSE: widget.ts imports no CSS, for esbuild would write a JS entry's imported CSS to a sibling
        # widget.css, the same path as this entry's ("two output files share the same path")
        "widget=demo/widget.ts",
        "widget=demo/widget-styles.css",
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--minify",
        "--keep-names",
        "--log-level=warning",
        "--outdir=demo",
    ],
)

# THE BUNDLES DATACUBE SHIPS (//:web; docs/BUILD_REBUILD_DESIGN_2026_10_05.md, D10): the app, the embeddable page, the
# page of one cube on an engine (engine.html: Python's engine serves it), a notebook's cube (the widget's loader and
# DataCube's module) and the planner's worker. remote-bundle and stress are fixtures of their harnesses (verify_remote,
# run_stress), not product: they leave the site with D5.
filegroup(
    name = "bundles",
    srcs = [
        ":bundle_bundle",
        ":bundle_bundle_engine",
        ":bundle_bundle_page",
        ":bundle_planner_worker",
        ":widget",
        ":widget_loader",
    ],
    visibility = ["//:__pkg__"],
)

# The two WebAssembly runtimes the page loads from ./vendor/: DuckDB's, from engine-client's
# npm package, and legend-lite's planner, from //wasm:planner; and the fonts, from legend-art (the pinned @fontsource).
copy_to_directory(
    name = "vendor",
    srcs = [
        "//engine-client:node_modules/@duckdb/duckdb-wasm",
        "//legend-art:fonts",
        "//sdlc-server:page",
        "//wasm:planner",
    ],
    out = "demo/vendor",
    include_srcs_patterns = [
        "legend-art/fonts/roboto-latin-400-normal.woff2",
        "legend-art/fonts/roboto-latin-ext-400-normal.woff2",
        "legend-art/fonts/roboto-latin-500-normal.woff2",
        "legend-art/fonts/roboto-latin-ext-500-normal.woff2",
        "legend-art/fonts/roboto-latin-700-normal.woff2",
        "legend-art/fonts/roboto-latin-ext-700-normal.woff2",
        "legend-art/fonts/LICENSE-roboto.txt",
        "**/dist/duckdb-mvp.wasm",
        "**/dist/duckdb-eh.wasm",
        "**/dist/duckdb-browser-mvp.worker.js",
        "**/dist/duckdb-browser-eh.worker.js",
        "wasm/planner/classes.wasm",
        "wasm/planner/wasm-gc-module-runtime.js",
        "sdlc-server/page/classes.wasm",
        "sdlc-server/page/wasm-gc-module-runtime.js",
    ],
    replace_prefixes = {
        "legend-art/fonts/": "fonts/",
        "**/dist/": "",
        "wasm/planner/": "",
        "sdlc-server/page/": "sdlc/",
    },
)

# The projects a saved query compiles against (config.json `projects[]`): the Query app's trading
# demo, its model and seed served as they are there, never copied into this package.
copy_to_directory(
    name = "projects",
    srcs = [
        "//query:demo/models/runtime-duckdb.pure",
        "//query:demo/models/trading-seed.sql",
        "//query:demo/models/trading.pure",
    ],
    out = "demo/projects/trading",
    root_paths = ["query/demo/models"],
)

# Everything a browser fetches: pages, styles, models, bundles, runtimes.
filegroup(
    name = "site",
    # served beside the other app from one origin (//site): they share the browser's query store
    visibility = ["//site:__pkg__"],
    srcs = glob([
        "demo/*.css",
        "demo/*.html",
        "demo/*.json",
        "demo/*.pure",
        "src/**/*.css",
    ]) + [":bundle_" + out[len("demo/"):-len(".js")].replace("-", "_") for out in _BUNDLES.values()] + [
        ":projects",
        ":vendor",
        ":widget",
        ":widget_loader",
    ],
)

# Where a harness finds the site (harness.siteRoot): one of its files by runfiles path, never the harness's own
# location (Bazel workplan P4-01, G-07)
_SITE_ENV = {"SITE": "$(rlocationpath demo/index.html)"}

# `bazel run //datacube:serve [-- --data FILE] [-- --open]`: the site, on loopback. A hand tool: manual (2026-10-07,
# PHASE_8.md Gen-5), built by :tools_build_test.
js_binary(
    name = "serve",
    data = [
        "demo/harness.mjs",
        "demo/index.html",
        "demo/static-files.ts",
        ":site",
        "//tools/js:runfiles",
    ],
    entry_point = "demo/serve.mjs",
    env = _SITE_ENV,
    node_options = [
        "--experimental-strip-types",
        "--disable-warning=ExperimentalWarning",
    ],
    tags = ["manual"],
)

# THE APP (docs/DATACUBE_APP_PLAN_2026_10_02.md): one folder, bazel-bin/datacube/app -- the native warehouse beside
# DuckDB's library, its postgres extension and this site (warehouse_folder, warehouse/defs.bzl; the build rebuild's
# L1c, 2026-10-07) -- started with --app (the account running it is its one user; the site beside the executable is
# the page) and --open (the browser, on the tables of the databases named):
#   bazel run //datacube:app -- postgresql://bob@db:5432/shop [--table sales.orders]
# `bazel run` starts it in Bazel's runfiles folder, so a relative path among the arguments is relative to that: give
# absolute paths. The server knows nothing of Bazel; :app_package is the same folder as an archive.
warehouse_folder(
    name = "app",
    args = [
        "--app",
        "--open",
    ],
    extension = "//warehouse:postgres_extension",
    library = "//warehouse:duckdb_library",
    server = "//warehouse:server_native",
    site = ":dist",
)

# the app's executable alone, for a test to name by $(rlocationpath); the folder around it is the app
executable_of(
    name = "app_executable",
    binary = ":app",
)

# THE PACKAGE: the app folder as datacube-app.tar.gz, its entries under datacube/app/ as built (bsdtar pinned by
# tar.bzl: no host tar). The folder's four entries only: not the runfiles tree Bazel keeps beside the executable
# (include_runfiles). Not renamed: tar.bzl's mutate runs gawk under a shell, and bsdtar's own -s leaves the empty
# parent entry behind (measured 2026-10-07); a Starlark mtree writer could rename, if a nicer path is ever wanted.
# Unpacked anywhere, `datacube/app/warehouse --app --open postgresql://...` is the app with no Bazel on the machine;
# that the folder works that way is :verify_app_test's finding, which starts it from a plain directory. CI's product
# job builds it; the datacube lane builds it again, for :package_test.
tar(
    name = "app_package",
    srcs = [":app"],
    compress = "gzip",
    include_runfiles = False,
    out = "datacube-app.tar.gz",
)

# THE PACKAGE'S ENTRIES, JUDGED (L1d, 2026-10-07): the app folder's four things and nothing else -- not the runfiles tree
# Bazel keeps beside the executable, which include_runfiles above leaves out and nothing else would notice coming back
# (the audit of L1c found the package at twice its size). Node reads the archive itself: no host tar.
node_test(
    name = "package_test",
    size = "medium",
    data = [":app_package"],
    entry_point = "test/package/entries.ts",
    env = {"APP_PACKAGE": "$(rlocationpath :app_package)"},
)

# `bazel build //datacube:dist`: the site as a folder for any static host — no
# backend; the planner is WebAssembly and so is DuckDB.
js_binary(
    name = "make_dist",
    entry_point = "demo/make-dist.mjs",
)

js_run_binary(
    name = "dist",
    srcs = [":site"],
    args = [
        package_name(),
        package_name() + "/dist",
    ],
    out_dirs = ["dist"],
    tool = ":make_dist",
    # //python:repl serves it with Python's engine (show())
    visibility = ["//python:__pkg__"],
)

# THE BROWSER HARNESSES, BY HAND: `bazel run //datacube:<name>`, the manual form of the browser_tests below
# (the same scripts; as tests they drive the Chromium Bazel fetches, by hand Playwright's own, installed once with
# :install_browser). Several need a live engine as well (the script says which) and are tools only.
_HARNESS_HELPERS = [
    "demo/engine-cases.mjs",
    # the one module every harness shares: its server, the site root, outputs and temp paths, checks (P4-01)
    "demo/harness.mjs",
    "demo/static-files.ts",
    "demo/grid-invariants.mjs",
    "demo/stress-corpus.ts",
    "demo/torture.pure",
    "demo/trades.pure",
    "demo/trades-h2.pure",
    "demo/typed-view.mjs",
    "demo/warehouse-source.mjs",
]

_HARNESSES = [
    "chaos",
    "make-sample",
    "measure-startup",
    "run-stress",
    "shots",
    "torture",
    "verify-calc-vocabulary",
    "verify-charts",
    "verify-cubes",
    "verify-engine",
    "verify-engine-differential",
    "verify-features",
    "verify-page",
    "verify-picker",
    "verify-real-data",
    "verify-remote",
    "verify-smoke",
    "verify-upload",
    "verify-wasm-browser",
]

# THE MECHANICAL HARNESSES AS TESTS (Bazel workplan P4-02): each against the pinned Chromium, with a result and a
# timeout; no fixed sleep in any of them (G-11). run-stress is the long one.
_BROWSER_TESTS = {
    "run-stress": "enormous",
    "verify-charts": "large",
    "verify-cubes": "large",
    "verify-page": "large",
    "verify-upload": "large",
    "verify-wasm-browser": "large",
}

[js_binary(
    name = h.replace("-", "_"),
    # make-sample writes a CSV from the sources: it needs no site, no browser (P4-08)
    data = [":src"] if h == "make-sample" else _HARNESS_HELPERS + [
        # named itself: SITE is its runfiles path
        "demo/index.html",
        ":node_modules/playwright",
        ":site",
        ":src",
        # harness.mjs finds the site through it (a node_test has it already)
        "//tools/js:runfiles",
    ] + (["//fixtures/saved-queries:records"] if h == "verify-features" else []) + (
        # it imports pinned-chromium.mjs first, a no-op under bazel run
        ["//tools/browser:pinned_chromium"] if h in ["verify-smoke", "verify-remote", "verify-real-data", "verify-features"] or h in _BROWSER_TESTS else []
    ),
    entry_point = "demo/" + h + ".mjs",
    env = {} if h == "make-sample" else _SITE_ENV | ({"SAVED_QUERIES": "$(rlocationpaths //fixtures/saved-queries:records)"} if h == "verify-features" else {}),
    node_options = [
        "--experimental-strip-types",
        "--experimental-wasm-exnref",
        "--disable-warning=ExperimentalWarning",
    ],
    # hand tools, run by a person: manual (2026-10-07, PHASE_8.md Gen-5); CI runs the harnesses as the tests below,
    # and :tools_build_test keeps these compiling
    tags = ["manual"],
) for h in _HARNESSES]

# THE SMOKE HARNESS AS A TEST (Bazel workplan P1-14, the pilot): against the Chromium Bazel fetched
# (//tools/browser), with no install step and nothing in $HOME. .
# The other harnesses follow in P4.
browser_test(
    name = "verify_smoke_test",
    size = "large",
    # sharded by sample (verify-smoke.mjs: shard i takes every n-th): 16 samples, 4 each (P4-02)
    shard_count = 4,
    data = _HARNESS_HELPERS + [
        # named itself: SITE is its runfiles path
        "demo/index.html",
        ":node_modules/playwright",
        ":site",
        ":src",
    ],
    entry_point = "demo/verify-smoke.mjs",
    env = _SITE_ENV,
    wasm = True,
)

[browser_test(
    name = h.replace("-", "_") + "_test",
    size = size,
    data = _HARNESS_HELPERS + [
        "demo/index.html",
        ":node_modules/playwright",
        ":site",
        ":src",
    ],
    entry_point = "demo/" + h + ".mjs",
    env = _SITE_ENV,
    # CI runs these on Linux only (gates-run.yml filters the tag on macOS and Windows): the same on every platform,
    # and live-vs-snap already checks x86_64 against the arm64 desks (the build rebuild's L1b, 2026-10-07)
    tags = ["ci-linux-only"],
    wasm = True,
) for h, size in _BROWSER_TESTS.items()]

# the two remote-data harnesses as one test, a shard each (P4-03): demo/verify-remote-test.mjs
browser_test(
    name = "verify_remote_test",
    size = "large",
    shard_count = 2,
    data = _HARNESS_HELPERS + [
        "demo/index.html",
        "demo/verify-real-data.mjs",
        "demo/verify-remote.mjs",
        # the package moved to engine-client after bazel/exec branched (2026-10-04)
        "//engine-client:node_modules/@duckdb/duckdb-wasm",
        ":node_modules/playwright",
        ":site",
        ":src",
    ],
    entry_point = "demo/verify-remote-test.mjs",
    env = _SITE_ENV,
    tags = ["ci-linux-only"],
    wasm = True,
)

# the feature sweep, sharded by section (P4-04): each section from a fresh cube, so one can fail without hiding another
browser_test(
    name = "verify_features_test",
    size = "large",
    shard_count = 4,
    data = _HARNESS_HELPERS + [
        "demo/index.html",
        ":node_modules/playwright",
        ":site",
        ":src",
        "//fixtures/saved-queries:records",
    ],
    entry_point = "demo/verify-features.mjs",
    env = _SITE_ENV | {"SAVED_QUERIES": "$(rlocationpaths //fixtures/saved-queries:records)"},
    tags = ["ci-linux-only"],
    wasm = True,
)

# every browser test of this package (P4-09's //:browser names it)
test_suite(
    name = "browser",
    tests = [
        ":verify_features_test",
        ":verify_remote_test",
        ":verify_smoke_test",
    ] + [":" + h.replace("-", "_") + "_test" for h in _BROWSER_TESTS],
)

# `bazel run //datacube:verify_app` (manual; see demo/verify-app.mjs for its Postgres): the single-user app
# end to end -- the app folder (:app) copied to a plain directory and started there, from the launch key.
js_binary(
    name = "verify_app",
    data = [
        ":app",
        ":app_executable",
        ":node_modules/playwright",
        # it imports pinned-chromium.mjs first, a no-op under bazel run
        "//tools/browser:pinned_chromium",
        "//tools/js:runfiles",
    ],
    entry_point = "demo/verify-app.mjs",
    # the app's executable by runfiles path; the folder around it is the app
    env = {"APP": "$(rlocationpath :app_executable)"},
    tags = ["manual"],
)

# THE APP AGAINST POSTGRES, AS A TEST ON EVERY PLATFORM (Bazel workplan P1-14b, D11 revised): verify-app.mjs's
# checks with the Postgres it needs started inside the test -- :app_postgres, Postgres 16 from the pinned
# binaries loaded with the guide's sample over JDBC -- and the pinned Chromium. No psql, no host Postgres,
# no host browser. CI's datacube lane runs it on Linux, macOS and Windows: the Windows desk's own path. Since L1c
# it starts the app folder from a plain directory, with none of Bazel's variables: a package's user's way.
browser_test(
    name = "verify_app_test",
    size = "large",
    data = [
        ":app",
        ":app_executable",
        ":app_postgres",
        ":app_postgres_executable",
        ":node_modules/playwright",
        "demo/sample-shop.sql",
    ],
    entry_point = "demo/verify-app.mjs",
    env = {
        "APP": "$(rlocationpath :app_executable)",
        "APP_POSTGRES": "$(rlocationpath :app_postgres_executable)",
        "SAMPLE_SQL": "$(rlocationpath demo/sample-shop.sql)",
    },
)

executable_of(
    name = "app_postgres_executable",
    testonly = True,
    binary = ":app_postgres",
)

# the test's Postgres (tools/apppostgres/AppPostgres.java): prints its port once the sample is in, and runs
# until its stdin closes
legend_java_binary(
    name = "app_postgres",
    # starts the embedded Postgres: skipped where no build is pinned (P1-15)
    target_compatible_with = EMBEDDED_POSTGRES_COMPATIBLE,
    testonly = True,
    srcs = ["tools/apppostgres/AppPostgres.java"],
    data = [
        "@embedded_postgres//:pg/PG_ROOT",
        "@embedded_postgres//:postgres",
    ],
    jvm_flags = ["-Dembedded.postgres.root=$(rlocationpath @embedded_postgres//:pg/PG_ROOT)"],
    main_class = "apppostgres.AppPostgres",
    runtime_deps = ["//core:drivers"],
    deps = ["//testing"],
)

# `bazel run //datacube:install_browser [-- --with-deps]`: Playwright's own Chromium, at the version the lock file
# pins, for a desk that runs the harnesses outside Bazel; no test needs it (every harness is a test on the Chromium
# Bazel fetches, since L1b). Manual (2026-10-07).
js_binary(
    name = "install_browser",
    data = [":node_modules/playwright"],
    entry_point = "demo/install-browser.mjs",
    tags = ["manual"],
)

# every hand tool of this package compiles (the build rebuild's L1b): the checks lane builds them, nothing runs
build_test(
