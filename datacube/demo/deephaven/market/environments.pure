// THE TRADING DESK'S ENVIRONMENTS (docs/ONE_CONNECTION_DESK_2026_10_28.md D2): the third file of the desk's project,
// after the one trading model and the desk's own (market.pure). Each environment is a pair of connections -- the
// corpus's store `store::DB` and the world's status store `market::World` -- a runtime binding them, and an execution
// context of the desk's data space. A saved desk page names the data space and the context it runs on, and DataCube's
// Run on switches between them: the same queries, planned on the other runtime, on the engine its connections name.
// Another environment is another context here, its own named connections: no address is typed in or substituted.

###Connection
// IN THIS TAB: the tab's own DuckDB, the market's tables made in it and kept live by the Market data source
RelationalDatabaseConnection market::InTab
{
  store: store::DB;
  type: DuckDB;
  specification: DuckDB { };
  auth: Test;
}
RelationalDatabaseConnection market::InTabStatus
{
  store: market::World;
  type: DuckDB;
  specification: DuckDB { };
  auth: Test;
}

// DEEPHAVEN: a Deephaven server on this machine at Deephaven's own port, over TLS (its browser protocol is HTTP/2), its
// key the vault's -- never in the model
RelationalDatabaseConnection market::Deephaven
{
  store: store::DB;
  type: Deephaven;
  specification: Deephaven { host: 'localhost'; port: 10000; useTls: true; };
  auth: PreSharedKey { keyVaultReference: 'deephaven.psk'; };
}
RelationalDatabaseConnection market::DeephavenStatus
{
  store: market::World;
  type: Deephaven;
  specification: Deephaven { host: 'localhost'; port: 10000; useTls: true; };
  auth: PreSharedKey { keyVaultReference: 'deephaven.psk'; };
}

// THE TOPICS' BROKERS, on this machine: the market world behind legend-lite's own Kafka door (bazel run
// //datacube:market_feed, docs/DESK_DATA_ROADMAP_2026_10_29.md B1) -- one connection a cluster, no store: the
// deployment below says what it feeds (docs/DEPLOYMENT_DESIGN_2026_11_14.md §8). No runtime binds it: no query runs on
// a topic's brokers
RelationalDatabaseConnection market::Kafka
{
  type: Kafka;
  specification: Kafka { bootstrapServers: '127.0.0.1:19092'; };
  auth: Test;
}

// THE POSITIONS' DROP LOCATION, on this machine: where position keeping drops its start-of-day files, a dataset a file
// (docs/DEPLOYMENT_DESIGN_2026_11_14.md §11); no query runs on it
RelationalDatabaseConnection market::PositionsDrop
{
  type: Files;
  specification: Files { location: 'file:///tmp/legend-desk/positions/'; };
  auth: Test;
}

###Runtime
Runtime market::InTabRuntime
{
  mappings: [ stress::AllMapping ];
  connections: [ store::DB: [ live: market::InTab ], market::World: [ status: market::InTabStatus ] ];
}

Runtime market::DeephavenRuntime
{
  mappings: [ stress::AllMapping ];
  connections: [ store::DB: [ live: market::Deephaven ], market::World: [ status: market::DeephavenStatus ] ];
}

###Lakehouse
// WHAT LANDS ON THE DEEPHAVEN SERVER, from where, keeping how much (docs/DEPLOYMENT_DESIGN_2026_11_14.md §8): the
// desk's streams, the masters' reference data (each change a record of its keyed topic, §11) and the world's status,
// each read from its topic on the door's brokers; an appended table every row (a trader's day: the server keeps every
// trade), a milestoned one its current version a key. Rendered as data for lite's fixed loader (the planner's
// DeploymentPlanner; core/src/main/deephaven/legend-loader.groovy), applied when the server starts
Deployment market::DeskOnDeephaven
{
  deploys: [ marketdata::MarketDataFeed, marketdata::NewsFeed, trading::OrderFlowFeed, products::SecurityMasterLoad,
    refdata::MarketsLoad, org::OrganisationLoad, counterparty::ClientMasterLoad, risk::LimitsLoad, positions::StartOfDay,
    market::WorldStatus ];
  sources: [ market::Kafka: [ tickerplant::Topics, newswire::Topics, oms::Topics, secmaster::Topics, refmaster::Topics,
    hr::Topics, clientmaster::Topics, riskdb::Topics, market::WorldStatus ],
    market::PositionsDrop: [ positions::StartOfDay ] ];
  live: market::Deephaven keep [ appended: all, milestoned: current ];
}

###DataSpace
DataSpace market::TradingDesk
{
  executionContexts:
  [
    {
      name: 'In this tab';
      title: 'In this tab (DuckDB)';
      mappingProvider: desk::Desk.model;
      defaultRuntime: market::InTabRuntime;
    },
    {
      name: 'Deephaven';
      title: 'Deephaven (localhost:10000)';
      mappingProvider: desk::Desk.model;
      defaultRuntime: market::DeephavenRuntime;
    }
  ];
  defaultExecutionContext: 'In this tab';
  title: 'Trading desk';
  description: 'A trading floor on one page: the market, the bank\'s books, its orders, options and FX, live.';
}
