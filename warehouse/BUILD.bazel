# The warehouse: a DuckDB server behind the HTTP SQL API
# (docs/SERVER_PROGRAM_2026_09_26.md, docs/WAREHOUSE_W1_DESIGN_2026_09_26.md).
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//tools/java:defs.bzl", "legend_java_binary", "legend_java_library")
load("@rules_graalvm//graalvm:defs.bzl", "native_image")

load("@rules_python//python:py_binary.bzl", "py_binary")
load("//tools/runfiles:defs.bzl", "executable_of")
load("//tools/java_run:defs.bzl", "java_run")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/teavm:defs.bzl", "teavm_wasm")
load("//tools/platforms:defs.bzl", "compatible_with", "platform_select")
load(":defs.bzl", "POSTGRES_EXTENSION", "POSTGRES_EXTENSION_COMPATIBLE", "jar_entry", "warehouse_run")
load("//tools/postgres:defs.bzl", "EMBEDDED_POSTGRES_COMPATIBLE")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/guards:defs.bzl", "guards_package")

# DuckDB's native library for this platform, out of its JDBC jar (//tools/platforms; Bazel workplan P1-19)
_DUCKDB_LIBRARY, _DUCKDB_LIBRARY_COMPATIBLE = platform_select({
    "macos_arm64": "libduckdb_java.so_osx_universal",
    "macos_x86_64": "libduckdb_java.so_osx_universal",
    "linux_x86_64": "libduckdb_java.so_linux_amd64",
    "linux_aarch64": "libduckdb_java.so_linux_arm64",
    "windows_x86_64": "libduckdb_java.so_windows_amd64",
}, "native library in DuckDB's JDBC jar")

package(default_visibility = ["//visibility:public"])

# THE API, on java.base alone: records, the JSON codec, the bindings. It must
# compile into the WebAssembly module beside the planner (program ruling 7), so
# it names no java.sql, no java.net, no JDK server. It depends on //base and //json only:
# nothing in the warehouse reaches core (//tools/deps:warehouse_closure_test).
legend_java_library(
    name = "sqlapi",
    srcs = glob(["src/main/java/com/legend/warehouse/sqlapi/**/*.java"]),
    deps = [
        "//base",
        "//json",
    ],
)

# The JVM client: the java.net.http driver for a binding, and a JDBC driver over
# it (jdbc:warehouse:http://host:port/catalog) whose values are the SAME Java
# objects DuckDB's own driver returns -- legend-lite's executor runs unchanged.
legend_java_library(
    name = "client",
    srcs = glob(["src/main/java/com/legend/warehouse/client/**/*.java"]),
    resources = ["src/main/resources/META-INF/services/java.sql.Driver"],
    resource_strip_prefix = "warehouse/src/main/resources",
    deps = [
        ":sqlapi",
        "//base",
        "//json",
    ],
    visibility = ["//spec:__pkg__"],
)

# The process: the JDK's HTTP server, DuckDB 1.5.5.1 (its own Maven set).
legend_java_library(
    name = "server_lib",
    srcs = glob(["src/main/java/com/legend/warehouse/server/**/*.java"]),
    deps = [
        "@rules_java//java/runfiles",
        ":sqlapi",
        "//base",
        "//json",
    ],
    # No DuckDB jar here: the server calls DuckDB's C API through java.lang.foreign and uses no JDBC class
    # (docs/WAREHOUSE_FFM_HOMEWORK_2026_09_26.md), and its native library is :duckdb_library, never extracted
    # from the jar at run time (Bazel workplan P1-16).
    # What a native image of the server needs to know ahead of time (W1e): its FFM call shapes and
    # upcalls, the JDK's HTTP server and crypto providers. Recorded by GraalVM's agent under the
    # warehouse test suite; native-image reads it from the jar.
    resource_strip_prefix = "warehouse/src/main/resources",
    resources = glob(["src/main/resources/**"]),
)

# `bazel run //warehouse:server -- --user alice:secret --data /tmp/wh`
legend_java_binary(
    name = "server",
    # DuckDB's library and the postgres extension, found in the server's runfiles by their paths
    # (<repo>/warehouse/<library>, <repo>/warehouse/duckdb_extensions/...; ServerRunfiles, Bazel workplan P1-16)
    data = [
        ":duckdb_extensions",
        ":duckdb_library",
    ],
    # DuckDB's library is loaded through FFM: allowed, so the JDK prints no warning (Bazel workplan P3-21)
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    main_class = "com.legend.warehouse.server.WarehouseServer",
    runtime_deps = [":server_lib"],
)

# the test sources, as files: core's skip census walks them (Bazel workplan P3-14)
filegroup(
    name = "test_java",
    srcs = glob(["src/test/java/**/*.java"]),
    visibility = ["//core:__pkg__"],
)

legend_java_library(
    name = "tests_lib",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    testonly = True,
    # launcher/ is :launcher_test's alone: it needs the launcher and a Postgres in its runfiles
    srcs = glob(
        ["src/test/java/**/*.java"],
        exclude = [
            "src/test/java/com/legend/warehouse/launcher/**",
            # the WebAssembly compile's entry and its test are :sqlapi_wasm's and :sqlapi_wasm_build_test's (P3-24)
            "src/test/java/com/legend/warehouse/sqlapi/**",
        ],
    ),
    deps = [
        ":client",
        ":server_lib",
        ":sqlapi",
        "//base",
        "//json",
        "//testing",
        "@maven_warehouse//:org_duckdb_duckdb_jdbc",
        "@maven_test//:org_junit_jupiter_junit_jupiter",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# THE ARROW CHECK'S READER (Bazel workplan P1-08): pyarrow, the standard Arrow reader, compares the warehouse's
# Arrow chunks with its JSON rows. A py_binary on the hermetic interpreter and the locked pip hub
# (//tools/python), started from a bash stub (.bazelrc bootstrap_impl): never the host's python3, never a skip.
py_binary(
    name = "arrow_matches_json",
    testonly = True,
    srcs = ["src/test/python/arrow_matches_json.py"],
    # the platforms with a cp312 pyarrow wheel: skipped elsewhere (Windows on Arm, for one), never a source build
    target_compatible_with = compatible_with(["linux_aarch64", "linux_x86_64", "macos_arm64", "macos_x86_64", "windows_x86_64"]),
    deps = ["@pypi//pyarrow"],
)

executable_of(
    name = "arrow_matches_json_executable",
    testonly = True,
    binary = ":arrow_matches_json",
)

_ARROW_COMPARATOR = "-Dwarehouse.arrow.comparator=$(rlocationpath :arrow_matches_json_executable)"

# DuckDB's library, for the in-process servers and DuckLibrary's own tests (Bazel workplan P1-16)
_DUCKDB_LIBRARY_FLAG = "-Dwarehouse.duckdb.library=$(rlocationpath :duckdb_library)"

# every warehouse test JVM loads DuckDB's library through FFM (Bazel workplan P3-21)
_NATIVE_ACCESS = "--enable-native-access=ALL-UNNAMED"

# the suite that drives a server over HTTP (TestServer): what :tests_native judges the BINARY by, nothing else
_HTTP_SUITE = [
    "WarehouseArrowTest",
    "WarehouseCorsTest",
    "WarehouseEntitlementsTest",
    "WarehouseJdbcTest",
    "WarehouseServerTest",
]

junit_test(
    name = "tests",
    memory_mb = 768,
    size = "medium",
    data = [
        ":arrow_matches_json",
        ":arrow_matches_json_executable",
        ":duckdb_library",
    ],
    jvm_flags = [
        _ARROW_COMPARATOR,
        _DUCKDB_LIBRARY_FLAG,
        _NATIVE_ACCESS,
        # a principal from the machine's account name is host-dependent (AppModeTest); every host is "tester"
        "-Duser.name=tester",
    ],
    # the live Postgres test is :postgres_live's alone (it needs a DSN): left out by selection, not by a skip
    select = [
        "--select-package=com.legend.warehouse",
        "--exclude-classname=.*\\.WarehousePostgresLiveTest",
    ],
    runtime_deps = [":tests_lib"],
)

# THE SERVER AS A NATIVE IMAGE (W1e): GraalVM's native-image over :server_lib's runtime class
# path, which Bazel supplies -- the same jars `bazel run //warehouse:server` runs. Everything
# must link when the image is built (--link-at-build-time): a class missing from the class
# path fails the build, where native-image's default compiles each method that names it into a
# NoSuchMethodError at run time (the 2026-09-26 break). On Windows it links with Visual Studio's
# MSVC, which Bazel's C++ toolchain finds (docs/WINDOWS_APP_DESIGN_2026_10_02.md).
native_image(
    name = "server_native",
    extra_args = [
        "--link-at-build-time",
        "--enable-native-access=ALL-UNNAMED",
    ],
    # the host C toolchain, checked before native-image runs (macOS: the CLT; Windows: MSVC; P1-10, P1-11)
    data = ["@host_cc//:present"],
    main_class = "com.legend.warehouse.server.WarehouseServer",
    # zlib from source (Bazel workplan P1-09; the rule uses it on Linux only): -lz finds this static
    # libz.a, never a host zlib1g-dev.
    static_zlib = "@zlib",
    # link with LLVM's lld, beside the hermetic clang, never the host's ld. Linux only: macOS keeps Apple's
    # Command Line Tools (D1 revised) and Windows MSVC (D5), both checked by @host_cc.
    c_compiler_option = select({
        "@platforms//os:linux": ["-fuse-ld=lld"],
        "//conditions:default": [],
    }),
    # the platforms DuckDB's JDBC jar carries a native library for: the image loads it
    target_compatible_with = _DUCKDB_LIBRARY_COMPATIBLE,
    deps = [":server_lib"],
)

# A Postgres catalog against a LIVE Postgres (leg P0 of docs/POSTGRES_DIALECT_HOMEWORK_2026_10_01.md): the embedded
# one, which the test starts from the pinned binaries, and DuckDB's postgres extension (Bazel workplan P3-22).
_POSTGRES_LIVE_DATA = [
    ":arrow_matches_json",
    ":arrow_matches_json_executable",
    ":duckdb_extensions",
    ":duckdb_library",
    "@embedded_postgres//:pg/PG_ROOT",
    "@embedded_postgres//:postgres",
]

_POSTGRES_LIVE_FLAGS = [
    _ARROW_COMPARATOR,
    _DUCKDB_LIBRARY_FLAG,
    _NATIVE_ACCESS,
    "-Dembedded.postgres.root=$(rlocationpath @embedded_postgres//:pg/PG_ROOT)",
    "-Dwarehouse.postgres.extension=$(rlocationpath :duckdb_extensions)",
]

junit_test(
    name = "postgres_live",
    memory_mb = 768,
    size = "medium",
    data = _POSTGRES_LIVE_DATA,
    jvm_flags = _POSTGRES_LIVE_FLAGS,
    select = ["--select-class=com.legend.warehouse.WarehousePostgresLiveTest"],
    target_compatible_with = EMBEDDED_POSTGRES_COMPATIBLE + POSTGRES_EXTENSION_COMPATIBLE,
    runtime_deps = [":tests_lib"],
)

# The same, judging the native binary.
junit_test(
    name = "postgres_live_native",
    memory_mb = 768,
    size = "medium",
    jvm_flags = _POSTGRES_LIVE_FLAGS,
    data = _POSTGRES_LIVE_DATA + [":server_native"],
    env = {
        "WAREHOUSE_BINARY": "$(rlocationpath :server_native)",
        "WAREHOUSE_DUCKDB_LIBRARY": "$(rlocationpath :duckdb_library)",
    },
    select = ["--select-class=com.legend.warehouse.WarehousePostgresLiveTest"],
    target_compatible_with = EMBEDDED_POSTGRES_COMPATIBLE + POSTGRES_EXTENSION_COMPATIBLE + _DUCKDB_LIBRARY_COMPATIBLE,
    runtime_deps = [":tests_lib"],
)

# DuckDB's native library for this platform, out of its JDBC jar: what the image loads.
# DO NOT RENAME: the server finds this output in its runfiles by its path (ServerRunfiles, Bazel workplan P1-16).
jar_entry(
    name = "duckdb_library",
    entry = _DUCKDB_LIBRARY,
    jar = "@maven_warehouse//:org_duckdb_duckdb_jdbc",
    target_compatible_with = _DUCKDB_LIBRARY_COMPATIBLE,
)

# The same suite, judging the native binary instead of an in-process server (TestServer).
junit_test(
    name = "tests_native",
    memory_mb = 768,
    size = "medium",
    jvm_flags = [
        _ARROW_COMPARATOR,
        _DUCKDB_LIBRARY_FLAG,
        _NATIVE_ACCESS,
    ],
    data = [
        ":arrow_matches_json",
        ":arrow_matches_json_executable",
        ":duckdb_library",
        ":server_native",
    ],
    env = {
        "WAREHOUSE_BINARY": "$(rlocationpath :server_native)",
        "WAREHOUSE_DUCKDB_LIBRARY": "$(rlocationpath :duckdb_library)",
    },
    # the HTTP suite only: the binary is what this target judges (Bazel workplan P3-21)
    select = ["--select-class=com.legend.warehouse." + c for c in _HTTP_SUITE],
    runtime_deps = [":tests_lib"],
)

# THE WAREHOUSE, BUILT AND RUN IN ONE STEP: the native server, DuckDB's library and DuckDB's postgres
# extension (pinned per platform in MODULE.bazel), all from Bazel. Flags pass through:
#   bazel run //warehouse:serve -- --postgres shop='host=db dbname=shop user=reader password=secret'
# A relative --data, the default `warehouse-data` among them, is where `bazel run` was started, on every
# platform: the server resolves it against BUILD_WORKING_DIRECTORY (on Windows the launcher starts it in
# the runfiles folder, which `bazel clean` removes).
warehouse_run(
    name = "serve",
    library = ":duckdb_library",
    server = ":server_native",
)

# The launcher as //datacube:app has it -- a site and fixed arguments before the caller's -- without
# the app's --open (no browser in a test) and without building the DataCube site: :launcher_test's.
copy_to_directory(
    name = "launcher_test_site",
    testonly = True,
    srcs = ["src/test/launcher-site/index.html"],
    root_paths = ["warehouse/src/test/launcher-site"],
)

warehouse_run(
    name = "launcher_test_serve_site",
    args_before = ["--single-user"],
    library = ":duckdb_library",
    server = ":server_native",
    site = ":launcher_test_site",
    testonly = True,
)

# THE LAUNCHER, JUDGED (docs/WINDOWS_APP_DESIGN_2026_10_02.md, §3): //warehouse:serve as `bazel run`
# starts it, on every platform -- the caller's arguments intact, the exit code back, and the server and
# the postgres extension's directory resolved through it, attaching the Postgres 16 that gate 7P starts
# (@embedded_postgres, //testing EmbeddedPostgres); and :launcher_test_serve_site, the app's shape: the
# site's directory resolved through the launcher and served, the fixed arguments reaching the server.
# DuckDB's library is passed too, but the native server would also find it beside itself (DuckLibrary),
# where Bazel puts it, so this test does not judge that flag on its own.
junit_test(
    name = "launcher_test",
    # starts the embedded Postgres: skipped where no build is pinned (P1-15)
    target_compatible_with = EMBEDDED_POSTGRES_COMPATIBLE,
    memory_mb = 768,
    size = "medium",
    srcs = ["src/test/java/com/legend/warehouse/launcher/LauncherTest.java"],
    data = [
        ":launcher_test_serve_site",
        ":serve",
        "@embedded_postgres//:pg/PG_ROOT",
        "@embedded_postgres//:postgres",
    ],
    env = {
        "WAREHOUSE_SERVE": "$(rlocationpath :serve)",
        "WAREHOUSE_SERVE_SITE": "$(rlocationpath :launcher_test_serve_site)",
    },
    jvm_flags = ["-Dembedded.postgres.root=$(rlocationpath @embedded_postgres//:pg/PG_ROOT)"],
    select = ["--select-class=com.legend.warehouse.launcher.LauncherTest"],
    deps = [
        "//base",
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# DuckDB's postgres extension, gunzipped by a Java action (Bazel workplan P1-17): no shell, no host gzip. Bazel's own
# fetch-time unpacking of a .gz (http_archive) would be simpler, but Bazel 9.2 sets the unpacked file's modification
# time 1000x too far in the future (GzFunction multiplies milliseconds by 1000), which Windows refuses: the fetch
# fails "(Permission denied)" (throwaway CI run 37224856941, 2026-10-04). Revisit once a Bazel release fixes it.
# warehouse_run's launchers copy this one file into their extension directories.
alias(
    name = "duckdb_extension_gz",
    actual = POSTGRES_EXTENSION,
    target_compatible_with = POSTGRES_EXTENSION_COMPATIBLE,
)

# DO NOT RENAME: the server finds this output in its runfiles by its path (ServerRunfiles, Bazel workplan P1-16).
java_run(
    name = "duckdb_extensions",
    srcs = [":duckdb_extension_gz"],
    outs = ["duckdb_extensions/postgres_scanner.duckdb_extension"],
    arguments = [
        "$(execpath :duckdb_extension_gz)",
        "{OUT}",
    ],
    main_class = "com.legend.tools.gunzip.Gunzip",
    mnemonic = "GunzipDuckdbExtension",
    target_compatible_with = POSTGRES_EXTENSION_COMPATIBLE,
    deps = ["//tools/gunzip"],
)

# THE NATIVE IMAGE'S REACHABILITY METADATA, generated whole (ReachabilityMetadata; Bazel workplan P2-09, A23): the FFM
# section from Duck.DOWNCALLS and AuthenticatedUser.UPCALLS, the callbacks' reflection from the same table, and the JDK
# services and resources the server reaches by name, declared with why. A new signature or service fails //:generated
# until `bazel run //warehouse:update_reachability_metadata` writes it.
java_run(
    name = "reachability_metadata",
    testonly = True,
    outs = ["generated/reachability-metadata.json"],
    arguments = ["{OUT}"],
    main_class = "com.legend.warehouse.server.duck.ReachabilityMetadata",
    mnemonic = "Generate",
    deps = [":tests_lib"],
)

write_source_files(
    name = "update_reachability_metadata",
    testonly = True,
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nthe native image's metadata moved (an FFM signature, or a declared JDK service) -- bazel run //warehouse:update_reachability_metadata",
    files = {"src/main/resources/META-INF/native-image/com.legend/warehouse/reachability-metadata.json": ":reachability_metadata"},
    visibility = ["//:__pkg__"],
)

# THE SQL API IN WEBASSEMBLY (Bazel workplan P3-24): WasmEntry reaches the binding, the JSON codec and the Arrow
# reader, and TeaVM compiles it, so a class the API reaches that TeaVM's class library lacks fails the build. The
# test's data is the module: building the test is the compile.
legend_java_library(
    name = "sqlapi_wasm_entry",
    testonly = True,
    srcs = ["src/test/java/com/legend/warehouse/sqlapi/WasmEntry.java"],
    deps = [":sqlapi"],
)

teavm_wasm(
    name = "sqlapi_wasm",
    testonly = True,
    main_class = "com.legend.warehouse.sqlapi.WasmEntry",
    deps = [
        ":sqlapi_wasm_entry",
        "@maven_teavm//:org_teavm_teavm_classlib",
        "@maven_teavm//:org_teavm_teavm_jso",
    ],
)

junit_test(
    name = "sqlapi_wasm_build_test",
    memory_mb = 256,
    size = "small",
    srcs = ["src/test/java/com/legend/warehouse/sqlapi/WasmBuildTest.java"],
    data = [":sqlapi_wasm"],
    # the module's files (classes.wasm and its runtime) by runfiles path
    env = {"SQLAPI_WASM": "$(rlocationpaths :sqlapi_wasm)"},
    select = ["--select-class=com.legend.warehouse.sqlapi.WasmBuildTest"],
    deps = [
        "//testing",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    ],
)

guards_package()
