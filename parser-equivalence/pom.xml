<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.legend</groupId>
        <artifactId>legend-lite</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>legend-lite-parser-equivalence</artifactId>
    <packaging>jar</packaging>
    <name>Legend Lite - Parser Equivalence Harness</name>
    <description>
        Differential harness: runs legend-lite's parser and legend-engine's over the same input and
        compares the emitted PureModelContextData bytes.

        The upstream artifacts are TEST SCOPE and live only here. core/ must never depend on
        org.finos.legend.engine — that invariant is the whole point of the clean-room protocol, and
        this module exists so the reference can be generated without breaking it.
    </description>

    <!-- legend.engine.version / legend.pure.version come from the ROOT pom
         (one release, tools/oracle-pins.env). The oracle jars are the SAME
         release as the source checkouts gate 8 sweeps — so a construct the
         oracle refuses and the checkout carries is a lite bug or an
         adjudicated row, never "version skew" (docs/version-skew-claims.tsv
         is shrink-only and was the rent of a non-tag source pin). -->

    <dependencies>
        <dependency>
            <groupId>com.legend</groupId>
            <artifactId>legend-lite-core</artifactId>
        </dependency>

        <!-- the reference parser, and the DSL extensions that let it read non-Pure sections -->
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-language-pure-grammar</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- the SECOND reference grammar: legend-pure's own M3Parser
             adjudicates the m3-dialect rows of the refusal-asymmetry
             report mechanically (HARNESS_SIMPLIFICATION_PLAN Phase 4;
             calibrated 98.9% agreement on engine-accepted section-free
             files, AUDIT_FINDINGS_FOR_LEG1.md) -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-m3-core</artifactId>
            <version>${legend.pure.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- junit4 is compile-support for the recording shims only; it
             carries no legend ServiceLoader registrations, so the oracle
             stays production-shaped. Version managed by the root pom at the
             engine release's own junit (INV-5). -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-xt-relationalStore-grammar</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-xt-diagram-grammar</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            EVERY section grammar the engine ships (33 modules), not the three
            we happened to list. With only core+relational+diagram on the
            classpath the oracle REFUSED any file using ###Service,
            ###Persistence, ###DataSpace and the rest — and a file the oracle
            refuses produces no elements, so it left the denominator silently
            instead of counting against us. That is how 2,270 files
            disappeared, and why ###Diagram looked like the last unbuilt
            section when it was merely the last one this pom could see.
            The goal is to parse everything legend-engine parses, so the
            oracle has to be the whole engine (audit fix #6).
        -->
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-extensions-collection-generation</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- PRODUCTION store extension the collection does not bundle: the
             DuckDB connection grammar (main-scoped, published) — the oracle
             stays production-shaped, and our own tests' DuckDB connections
             become oracle-verifiable (conform-to-engine migration) -->
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-xt-relationalStore-duckdb-grammar</artifactId>
            <version>${legend.engine.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- HARVEST-ONLY classpath (mvn ... -Pengine-fixture-harvest):
             the engine's published tests-jars are FIXTURE SOURCES for
             ZEngineFixtureHarvest — and they carry test-scoped
             ServiceLoader registrations that would ALTER the oracle
             (gate 8 caught exactly that: a stale error pin + 3 corpus
             rows flipping to oracle-accepted). Quarantined here so the
             gates' oracle stays production-shaped; the committed
             fixture snapshot is what the gates consume. -->
        <profile>
            <id>engine-fixture-harvest</id>
            <dependencies>
                <dependency>
                    <groupId>org.finos.legend.engine</groupId>
                    <artifactId>legend-engine-language-pure-grammar</artifactId>
                    <version>${legend.engine.version}</version>
                    <classifier>tests</classifier>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.finos.legend.engine</groupId>
                    <artifactId>legend-engine-language-pure-compiler</artifactId>
                    <version>${legend.engine.version}</version>
                    <classifier>tests</classifier>
                    <scope>test</scope>
                </dependency>
                <!-- tier 2 (ZTier2FixtureHarvest): the checkout's extension
                     grammar tests are COMPILED by tools/bump.sh against this
                     profile's classpath; relationalStore-grammar's
                     TestRelationFunctions asserts through json-unit, at the
                     engine's own version (its root pom, jsonunit.version) -->
                <dependency>
                    <groupId>net.javacrumbs.json-unit</groupId>
                    <artifactId>json-unit</artifactId>
                    <version>2.17.0</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
