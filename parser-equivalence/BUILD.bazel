# parser-equivalence — legend-lite's parser and legend-engine's over the same input,
# compared byte for byte (Maven gate 8). The upstream jars are TEST inputs only and
# live only here: core must never see org.finos.legend.

load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/java:defs.bzl", "legend_java_binary", "legend_java_library")
load("//tools/generators:defs.bzl", "ENGINE_ROOT", "ENGINE_TREE", "UPSTREAM_ROOTS", "UPSTREAM_TREES", "program_jvm_flags")
load("//tools/java_run:defs.bzl", "java_run")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/jars:defs.bzl", "file_list", "java_jars")
load("//tools/guards:defs.bzl", "guards_package")

# the test sources as files: parser-equivalence's own corpus is the Pure snippets they embed (InlineSnippets reads
# src/test/**/*.java and nothing else; Bazel workplan P3-07)
filegroup(
    name = "test_java",
    srcs = glob(["src/test/**/*.java"]),
)

# the sibling parser's fixtures, listed as files (FixtureCorpusParityTest, MutationFuzzTest)
filegroup(
    name = "sibling_corpus",
    srcs = glob(["src/test/resources/sibling-corpus/**"]),
)

# sources exported for core's guard tests that walk every module
filegroup(
    name = "srcs",
    srcs = glob(["src/**"]),
    visibility = ["//core:__pkg__"],
)

# THE HARVEST'S RECORDING SHIMS (Bazel workplan P3-31): legend-engine's own test base classes, re-declared in their
# namespace so the engine's tests-jars record every fixture they parse; with FixtureRecorder, the one class they call.
# Only the harvest links them, AHEAD of the tests-jars (:harvest_lib), and FixtureHarvestGenerator refuses to run when
# a shim is not the class that loads.
_HARVEST_SHIMS = [
    "src/test/java/org/finos/legend/engine/language/pure/compiler/test/TestCompilationFromGrammar.java",
    "src/test/java/org/finos/legend/engine/language/pure/grammar/test/TestGrammarParser.java",
    "src/test/java/org/finos/legend/engine/language/pure/grammar/test/TestGrammarRoundtrip.java",
    "src/test/java/com/legend/equivalence/harvest/FixtureRecorder.java",
]

# The corpus machinery the generators share, in a library of its own, so gen_fixtures and gen_manifest run without
# the parity tests, core or their own committed outputs (closure: Corpus -> InlineSnippets, OraclePins;
# InlineSnippets -> Corpus, ModuleFiles; ModuleFiles -> Corpus; ManifestGenerator -> Corpus).
_CORPUS = ["src/test/java/com/legend/equivalence/%s.java" % c for c in [
    "Corpus",
    "InlineSnippets",
    "ManifestGenerator",
    "ModuleFiles",
    "OraclePins",
]]

# the harvest's own program (it reaches the shims and FixtureRecorder by name, at run time)
_HARVEST_PROGRAM = ["src/test/java/com/legend/equivalence/harvest/%s.java" % c for c in [
    "FixtureHarvest",
    "FixtureHarvestGenerator",
]]

# the engine's side of the parity programs' class path, ONE list, so the parity tests and the harvest see the same
# engine: what the tests compile against, and the grammar extensions the engine finds by ServiceLoader
_ENGINE_COMPILE = [
    "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_compiler",
    "@maven_upstream//:org_finos_legend_engine_legend_engine_protocol_pure",
    "@maven_upstream//:org_finos_legend_engine_legend_engine_shared_core",
    "@maven_upstream//:com_fasterxml_jackson_core_jackson_annotations",
    "@maven_upstream//:com_fasterxml_jackson_core_jackson_databind",
    "@maven_upstream//:junit_junit",
    "@maven_upstream//:org_antlr_antlr4_runtime",
    "@maven_upstream//:org_eclipse_collections_eclipse_collections",
    "@maven_upstream//:org_eclipse_collections_eclipse_collections_api",
    "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_grammar",
    "@maven_upstream//:org_finos_legend_pure_legend_pure_m3_core",
]

_ENGINE_EXTENSIONS = [
    "@maven_upstream//:org_finos_legend_engine_legend_engine_extensions_collection_generation",
    "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_diagram_grammar",
    "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_athena_grammar",
    "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_aurora_grammar",
    "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_duckdb_grammar",
    "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_grammar",
    "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_memsql_grammar",
    "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_oracle_grammar",
]

_JUNIT5 = [
    "@maven_test//:org_junit_jupiter_junit_jupiter_api",
    "@maven_test//:org_junit_jupiter_junit_jupiter_params",
]

# the protocol's reachable classes (an upstream record) and the worklist joined with our roster, each its own program
_PMCD = ["src/test/java/com/legend/equivalence/%s.java" % c for c in ["PmcdReachability", "PmcdWorklist"]]

legend_java_library(
    name = "pe_corpus",
    # not yet written to the null discipline (Bazel workplan P1-20)
    nullaway = False,
    testonly = True,
    srcs = _CORPUS,
    deps = [
        # Corpus.load's corpus-containing switch (inert in the generators)
        "//core:diagnostics",
        "//testing",
        "@maven_upstream//:com_fasterxml_jackson_core_jackson_databind",
    ],
)

legend_java_library(
    name = "harvest_program",
    # not yet written to the null discipline (Bazel workplan P1-20)
    nullaway = False,
    testonly = True,
    srcs = _HARVEST_PROGRAM,
    deps = [
        "//testing",
        "@maven_upstream//:com_fasterxml_jackson_core_jackson_databind",
        "@maven_upstream//:junit_junit",
    ],
)

legend_java_library(
    name = "pe_tests_lib",
    # not yet written to the null discipline (Bazel workplan P1-20: NullAway forced on everywhere, 2026-10-04, found 792 errors in the first wave)
    nullaway = False,
    testonly = True,
    # the recording shims are :harvest_shims' alone: no parity test sees an engine class re-declared; the corpus
    # machinery is :pe_corpus' and the harvest's program :harvest_program's
    srcs = glob(["src/test/java/**/*.java"], exclude = _HARVEST_SHIMS + _HARVEST_PROGRAM + _CORPUS + _PMCD),
    # not the two generated records: no class reads them from the class path (the tests read the snapshot by its
    # path), so a bump's rewrite of them reruns no parity program
    resources = glob(
        ["src/test/resources/**"],
        exclude = [
            "src/test/resources/corpus-manifest.tsv",
            "src/test/resources/engine-grammar-fixtures.jsonl",
        ],
    ),
    deps = [
        ":pe_corpus",
        "//core",
        "//testing",
    ] + _ENGINE_COMPILE + _JUNIT5,
    runtime_deps = _ENGINE_EXTENSIONS,
)

# What the parity tests read besides the upstream trees: committed ledgers in docs/,
# the pins file, and — for the own-corpus censuses, which harvest the Pure snippets
# every module's tests embed — the other modules' sources.
# THE ENGINE JARS the protocol roster and grammar coverage read
# (every jar :pe_tests_lib runs with), DECLARED: the BUILD says which jars, a
# program never re-derives them from its class path (tools/jars/defs.bzl). The
# tests take runfiles paths; the roster generator action takes execroot paths and
# the jars themselves as inputs.
java_jars(
    name = "engine_jars",
    testonly = True,
    rlocation_paths = True,
    deps = [":pe_tests_lib"],
)

java_jars(
    name = "engine_jars_exec",
    testonly = True,
    exec_paths = True,
    deps = [":pe_tests_lib"],
)

filegroup(
    name = "engine_jar_files",
    testonly = True,
    srcs = [":engine_jars_exec"],
    output_group = "jars",
)

_ENGINE_JARS_FLAG = "-Dlegend.engine.jars.rlocation=$(rlocationpath :engine_jars)"

# the repository files the parity tests read, as one declared list (ModuleFiles, SourceFiles; Bazel workplan
# P3-27b): no test walks a directory
file_list(
    name = "parity_sources",
    testonly = True,
    srcs = [
        ":sibling_corpus",
        ":test_java",
        "//core:test_java",
        "//pct:test_java",
        "//spec:test_java",
    ],
)

_SOURCES_FLAG = "-Dlegend.sources=$(rlocationpath :parity_sources)"

_INPUTS = [
    # what the parity tests read as files (Bazel workplan P3-07): every module's test sources (the own corpus:
    # InlineSnippets reads src/test/**/*.java), this module's sibling corpus, and the oracle pins
    ":sibling_corpus",
    ":test_java",
    "//core:test_java",
    "//pct:test_java",
    "//spec:test_java",
    "//tools:oracle-pins.env",
]

# The ledgers and resources the tests read as files, each by its runfiles path (Bazel workplan P1-05):
# -Dledger.<name> for docs/<name>.tsv.
_LEDGERS = [
    "c12-known-diffs",
    "c12-walls",
    "g4-keyword-snapshot",
    "model-refuse-allowlist",
    "own-corpus-protocol-diffs",
    "parser-surface-exclusions",
    "protocol-roster",
    "refusal-allowlist",
    "version-skew-claims",
]

_FILE_DATA = ["//docs:%s.tsv" % l for l in _LEDGERS] + [
    "src/test/resources/corpus-manifest.tsv",
    "src/test/resources/engine-grammar-fixtures.jsonl",
]

# the oracle pins (OraclePins, through ProgramPaths): a test's by its runfiles path, an action's by its exec path
_PINS_TEST_FLAG = "-Doracle.pins.rlocation=$(rlocationpath //tools:oracle-pins.env)"

_PINS_ACTION_FLAG = "-Doracle.pins=$(execpath //tools:oracle-pins.env)"

_FILE_FLAGS = [_PINS_TEST_FLAG] + ["-Dledger.%s.rlocation=$(rlocationpath //docs:%s.tsv)" % (l, l) for l in _LEDGERS] + [
    "-Dpe.engine.fixtures.rlocation=$(rlocationpath src/test/resources/engine-grammar-fixtures.jsonl)",
]


# The asserting census run on its trigger, never as part of the gate (//parser-equivalence:diagnostics). The
# measuring ones are report actions (:diagnostics_reports) and the benchmark a binary (:parse_speed_benchmark):
# Bazel workplan P3-17.
_DIAGNOSTICS = [
    "GrammarCoverageCensusTest",
]

# Gate 8: every asserting parity class. Selected by PACKAGE, so a new test is in the
# gate the moment it exists: no hand-kept roster of class names to go stale.
junit_test(
    name = "parser_parity",
    memory_mb = 2816,
    data = _INPUTS + _FILE_DATA + [
        ":engine_jars",
        ":parity_sources",
    ],
    jvm_flags = [
        _ENGINE_JARS_FLAG,
        _SOURCES_FLAG,
    ] + _FILE_FLAGS,
    exclude_tags = [],
    runtime_deps = [":pe_tests_lib"],
    select = ["--select-package=com.legend.equivalence"] + [
        "--exclude-classname=.*\\." + c for c in _DIAGNOSTICS
    ],
    upstream = True,
)

junit_test(
    name = "diagnostics",
    memory_mb = 2048,
    data = _INPUTS + _FILE_DATA + [
        ":engine_jars",
        ":parity_sources",
    ],
    jvm_flags = [
        _ENGINE_JARS_FLAG,
        _SOURCES_FLAG,
    ] + _FILE_FLAGS,
    runtime_deps = [":pe_tests_lib"],
    select = ["--select-class=com.legend.equivalence." + c for c in _DIAGNOSTICS],
    tags = ["manual"],
    upstream = True,
)

# ── THE GENERATORS ──────────────────────────────────────────────────────────────
# Programs run as build actions over declared inputs; //parser-equivalence:
# update_generated writes their outputs into the checkout and diff-tests them.
# The corpus machinery they share reads the files each action names (ProgramPaths), or
# walks its declared inputs, which sit at their repository paths under the action's
# working directory (ModuleFiles).
# The fixture harvest's shims (P3-31): the upstream classes of the same names, replaced, in a library of their own
# so :harvest_lib can put them first.
legend_java_library(
    name = "harvest_shims",
    # not yet written to the null discipline (Bazel workplan P1-20)
    nullaway = False,
    testonly = True,
    srcs = _HARVEST_SHIMS,
    deps = [
        # FixtureRecorder stamps the dump with the pinned release (Corpus, OraclePins)
        ":pe_corpus",
        "@maven_upstream//:com_fasterxml_jackson_core_jackson_databind",
        "@maven_upstream//:org_antlr_antlr4_runtime",
        "@maven_upstream//:org_eclipse_collections_eclipse_collections",
        "@maven_upstream//:org_eclipse_collections_eclipse_collections_api",
        "@maven_upstream//:junit_junit",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_compiler",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_grammar",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_protocol_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_shared_core",
    ],
)

# THE FIXTURE HARVEST's classpath: the shims first (:harvest_shims), then its program, the engine's side of the
# parity class path (_ENGINE_COMPILE, _ENGINE_EXTENSIONS, _JUNIT5), and the engine's grammar and compiler tests-jars
# (grammar before compiler — the order the snapshot's dedup is minted in) and json-unit. No jar of ours but the
# corpus machinery the shims stamp the dump with. QUARANTINED: nothing else depends on the tests-jars, whose
# test-scoped registrations would alter the oracle.
legend_java_library(
    name = "harvest_lib",
    testonly = True,
    runtime_deps = [
        # the shims FIRST: ahead of the tests-jars' own classes of the same names
        ":harvest_shims",
        ":harvest_program",
    ] + _ENGINE_COMPILE + _ENGINE_EXTENSIONS + _JUNIT5 + [
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_grammar_tests",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_compiler_tests",
        "@maven_upstream//:net_javacrumbs_json_unit_json_unit",
    ],
)

# the two tests-jars the harvest enumerates, grammar before compiler, DECLARED
java_jars(
    name = "harvest_tests_jars",
    testonly = True,
    exec_paths = True,
    transitive = False,
    deps = [
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_grammar_tests",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_compiler_tests",
    ],
)

filegroup(
    name = "harvest_tests_jar_files",
    testonly = True,
    srcs = [":harvest_tests_jars"],
    output_group = "jars",
)

# engine-grammar-fixtures.jsonl: corpus tier C6, harvested from the pinned release
java_run(
    name = "gen_fixtures",
    testonly = True,
    # legend-engine's tree alone (three modules' test sources, tier 2): it reads no legend-pure source
    srcs = ENGINE_TREE + [
        ":harvest_tests_jar_files",
        ":harvest_tests_jars",
        "//tools:oracle-pins.env",
    ],
    outs = ["generated/engine-grammar-fixtures.jsonl"],
    arguments = ["{OUT}"],
    jvm_flags = program_jvm_flags("parser-equivalence", pure = False) + [_PINS_ACTION_FLAG] + [
        "-Dlegend.harvest.jars=$(execpath :harvest_tests_jars)",
    ],
    main_class = "com.legend.equivalence.harvest.FixtureHarvestGenerator",
    mnemonic = "Generate",
    roots = ENGINE_ROOT,
    deps = [":harvest_lib"],
)

# the corpus's two consumers of the fixture snapshot read the harvest's OUTPUT, so
# a bump regenerates them from the new snapshot, never the committed one
_NEW_FIXTURES = "-Dlegend.engine.fixtures=$(execpath :gen_fixtures)"

# pmcd-reachable.tsv: the protocol classes reachable from PureModelContextData (fields, generics, Jackson subtypes) over
# the engine's jars alone, an upstream record that only an upgrade moves (GENERATORS.md section 2 row 10). Committed at
# the package root, outside the test resources, so no test library carries it.
legend_java_library(
    name = "pmcd_reachability_lib",
    # not yet written to the null discipline (Bazel workplan P1-20)
    nullaway = False,
    testonly = True,
    srcs = ["src/test/java/com/legend/equivalence/PmcdReachability.java"],
    runtime_deps = _ENGINE_EXTENSIONS,
    deps = ["//testing"] + _ENGINE_COMPILE,
)

# the jars it walks are exactly its class path: the parity tests' engine side
java_jars(
    name = "pmcd_jars_exec",
    testonly = True,
    exec_paths = True,
    deps = [":pmcd_reachability_lib"],
)

filegroup(
    name = "pmcd_jar_files",
    testonly = True,
    srcs = [":pmcd_jars_exec"],
    output_group = "jars",
)

java_run(
    name = "pmcd_reachability",
    testonly = True,
    srcs = [
        ":pmcd_jar_files",
        ":pmcd_jars_exec",
    ],
    outs = ["generated/pmcd-reachable.tsv"],
    arguments = ["{OUT}"],
    jvm_flags = ["-Dlegend.engine.jars=$(execpath :pmcd_jars_exec)"],
    main_class = "com.legend.equivalence.PmcdReachability",
    memory_mb = 2048,
    mnemonic = "Generate",
    deps = [":pmcd_reachability_lib"],
)

# the fixture worklist: the roster's uncovered tags against the record, a measurement asked for by name (in
# :diagnostics_reports)
legend_java_library(
    name = "pmcd_worklist_lib",
    # not yet written to the null discipline (Bazel workplan P1-20)
    nullaway = False,
    testonly = True,
    srcs = ["src/test/java/com/legend/equivalence/PmcdWorklist.java"],
    deps = ["//testing"],
)

java_run(
    name = "pmcd_worklist",
    testonly = True,
    srcs = [
        "pmcd-reachable.tsv",
        ":gen_roster",
    ],
    outs = [
        "pmcd_worklist/pmcd-worklist.txt",
        "pmcd_worklist/run.log",
    ],
    arguments = ["{OUT_DIR}"],
    jvm_flags = [
        "-Dpe.reachable=$(execpath pmcd-reachable.tsv)",
        "-Dpe.roster=$(execpath :gen_roster)",
    ],
    main_class = "com.legend.equivalence.PmcdWorklist",
    mnemonic = "Measure",
    tags = ["manual"],
    deps = [":pmcd_worklist_lib"],
)

# corpus-manifest.tsv: the corpus as data — every distinct source, hashed
java_run(
    name = "gen_manifest",
    testonly = True,
    srcs = UPSTREAM_TREES + [
        ":gen_fixtures",
        "//tools:oracle-pins.env",
    ],
    outs = ["generated/corpus-manifest.tsv"],
    arguments = ["{OUT}"],
    jvm_flags = program_jvm_flags("parser-equivalence") + [_PINS_ACTION_FLAG] + [_NEW_FIXTURES],
    main_class = "com.legend.equivalence.ManifestGenerator",
    mnemonic = "Generate",
    roots = UPSTREAM_ROOTS,
    deps = [":pe_corpus"],
)

# docs/protocol-roster.tsv: every protocol subtype tag, COVERED or UNCOVERED by
# the corpus, the fixtures and our own test snippets (core/spec/pct test trees)
java_run(
    name = "gen_roster",
    testonly = True,
    srcs = UPSTREAM_TREES + [
        ":engine_jar_files",
        ":engine_jars_exec",
        ":gen_fixtures",
        "//core:srcs",
        "//pct:srcs",
        "//spec:srcs",
        "//tools:oracle-pins.env",
    ],
    outs = ["generated/protocol-roster.tsv"],
    arguments = ["{OUT}"],
    jvm_flags = program_jvm_flags("parser-equivalence") + [_PINS_ACTION_FLAG] + [
        _NEW_FIXTURES,
        "-Dlegend.engine.jars=$(execpath :engine_jars_exec)",
    ],
    main_class = "com.legend.equivalence.RosterGenerator",
    mnemonic = "Generate",
    roots = UPSTREAM_ROOTS,
    visibility = ["//docs:__pkg__"],
    deps = [":pe_tests_lib"],
)

# GENERATED FILES in this package: `bazel run //:update_generated` writes them;
# `bazel test` fails when a committed copy differs, naming the command.
write_source_files(
    name = "update_generated",
    testonly = True,
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nThis file is generated from the pinned upstream release — regenerate: bazel run //:update_generated",
    # the writers are numbered in this order (_0, _1, _2): new records go last, so a number keeps its meaning
    files = {
        "src/test/resources/corpus-manifest.tsv": ":gen_manifest",
        "src/test/resources/engine-grammar-fixtures.jsonl": ":gen_fixtures",
        "pmcd-reachable.tsv": ":pmcd_reachability",
    },
    visibility = ["//visibility:public"],
)

# PARSER-EQUIVALENCE'S MEASURED RATCHET VALUES (PeRatchets; Bazel workplan P2-16, D9): the own-corpus elements that
# match the oracle and the mutant deck's size, measured into ratchets.tsv; the tests compare their live values with the
# committed copy.
java_run(
    name = "ratchets",
    testonly = True,
    srcs = UPSTREAM_TREES + [
        ":srcs",
        "//core:srcs",
        "//pct:srcs",
        "//spec:srcs",
        "//tools:oracle-pins.env",
    ],
    outs = ["generated/ratchets.tsv"],
    arguments = ["{OUT}"],
    jvm_flags = program_jvm_flags("parser-equivalence") + [_PINS_ACTION_FLAG],
    main_class = "com.legend.equivalence.PeRatchets",
    mnemonic = "Generate",
    roots = UPSTREAM_ROOTS,
    deps = [":pe_tests_lib"],
)

write_source_files(
    name = "update_ratchets",
    testonly = True,
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nA measured parser-equivalence ratchet moved -- bazel run //parser-equivalence:update_ratchets, and give the reason in the commit",
    files = {"src/test/resources/com/legend/equivalence/ratchets.tsv": ":ratchets"},
    visibility = ["//:__pkg__"],
)

# a DRAFT of docs/own-corpus-protocol-diffs.tsv (//docs:draft_own_corpus_ledger):
# current diffs, reasons kept, new rows marked for a human. Run when the ledger needs it, never part of //... (manual);
# OwnCorpusParityTest is the check
java_run(
    name = "gen_own_corpus_draft",
    testonly = True,
    srcs = UPSTREAM_TREES + [
        "//core:srcs",
        "//docs:own-corpus-protocol-diffs.tsv",
        "//pct:srcs",
        "//spec:srcs",
        "//tools:oracle-pins.env",
    ],
    outs = ["generated/own-corpus-protocol-diffs.tsv"],
    arguments = [
        "$(execpath //docs:own-corpus-protocol-diffs.tsv)",
        "{OUT}",
    ],
    jvm_flags = program_jvm_flags("parser-equivalence") + [_PINS_ACTION_FLAG],
    main_class = "com.legend.equivalence.OwnCorpusLedgerDraft",
    mnemonic = "Generate",
    roots = UPSTREAM_ROOTS,
    tags = ["manual"],
    visibility = ["//docs:__pkg__"],
    deps = [":pe_tests_lib"],
)

# THE MEASUREMENTS (Bazel workplan P3-17): each census a program over declared inputs, its report a cached build
# output in bazel-bin/parser-equivalence/<name>/. Manual: a measurement is asked for, never part of `//...`:
#   bazel build //parser-equivalence:diagnostics_reports
_REPORTS = {
    "corpus_census": ("CorpusCensus", ["corpus-census.txt", "corpus-census-defects.txt"]),
    "grammar_keyword_census": ("GrammarKeywordCensus", ["grammar-keyword-census.txt"]),
}

[java_run(
    name = name,
    testonly = True,
    srcs = _INPUTS + UPSTREAM_TREES + [
        ":engine_jar_files",
        ":engine_jars_exec",
        ":gen_fixtures",
        ":gen_roster",
    ],
    outs = [name + "/" + f for f in files + ["run.log"]],
    arguments = ["{OUT_DIR}"],
    jvm_flags = program_jvm_flags("parser-equivalence") + [
        _PINS_ACTION_FLAG,
        _NEW_FIXTURES,
        "-Dlegend.engine.jars=$(execpath :engine_jars_exec)",
        "-Dpe.roster=$(execpath :gen_roster)",
    ],
    main_class = "com.legend.equivalence." + main,
    memory_mb = 2048,
    mnemonic = "Measure",
    roots = UPSTREAM_ROOTS,
    tags = ["manual"],
    deps = [":pe_tests_lib"],
) for name, (main, files) in _REPORTS.items()]

filegroup(
    name = "diagnostics_reports",
    testonly = True,
    srcs = [":" + name for name in _REPORTS] + [":pmcd_worklist"],
    tags = ["manual"],
)

# The parse-speed benchmark: a timing is the machine's, so it is run, never cached.
#   bazel run //parser-equivalence:parse_speed_benchmark [-- --out FILE]
legend_java_binary(
    name = "parse_speed_benchmark",
    testonly = True,
    data = _INPUTS + _FILE_DATA + UPSTREAM_TREES,
    jvm_flags = _FILE_FLAGS + [
        "-Dlegend.engine.root.rlocation=$(rlocationpath @legend_engine_src//:pom.xml)",
        "-Dlegend.pure.root.rlocation=$(rlocationpath @legend_pure_src//:pom.xml)",
    ],
    main_class = "com.legend.equivalence.ParseSpeedBenchmark",
    tags = ["manual"],
    runtime_deps = [":pe_tests_lib"],
)

# THE PROBES, run on demand (Bazel workplan P3-17): instruments that print what they find, each its own binary.
#   bazel run //parser-equivalence:probe_wire_shapes [-- --out FILE]       the reference parser's bytes for constructs
#   bazel run //parser-equivalence:z_fixture_adjudication_probe -- --out DIR [--fixtures FILE]
#   bazel run //parser-equivalence:fixture_sweep -- [--out FILE] DIR...     a fixture directory against both parsers
[legend_java_binary(
    name = name,
    testonly = True,
    # the ledgers and resources the parity code reads, as the tests have them
    data = _INPUTS + _FILE_DATA + [":parity_sources"],
    jvm_flags = _FILE_FLAGS + [_SOURCES_FLAG],
    main_class = "com.legend.equivalence." + main,
    tags = ["manual"],
    runtime_deps = [":pe_tests_lib"],
) for name, main in [
    ("fixture_sweep", "FixtureSweep"),
    ("probe_wire_shapes", "ProbeWireShapes"),
    ("z_fixture_adjudication_probe", "harvest.ZFixtureAdjudicationProbe"),
]]

guards_package()
