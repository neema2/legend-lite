# parser-equivalence — legend-lite's parser and legend-engine's over the same input,
# compared byte for byte (Maven gate 8). The upstream jars are TEST inputs only and
# live only here: core must never see org.finos.legend.
load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/generators:defs.bzl", "UPSTREAM_TREES", "program_flags")
load("//tools/junit:defs.bzl", "junit_test")
load("//tools/jars:defs.bzl", "java_jars")

# sources exported for core's guard tests that walk every module
filegroup(
    name = "srcs",
    srcs = glob(["src/**"]),
    visibility = ["//core:__pkg__"],
)

java_library(
    name = "pe_tests_lib",
    testonly = True,
    srcs = glob(["src/test/java/**/*.java"]),
    resources = glob(["src/test/resources/**"]),
    deps = [
        "//core",
        "//testing",
        # the engine-namespace recording shims (org/finos/legend/...) compile against the compiler
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_compiler",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_protocol_pure",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_shared_core",
        "@maven_upstream//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven_upstream//:com_fasterxml_jackson_core_jackson_databind",
        "@maven_upstream//:junit_junit",
        "@maven_upstream//:org_antlr_antlr4_runtime",
        "@maven_upstream//:org_eclipse_collections_eclipse_collections",
        "@maven_upstream//:org_eclipse_collections_eclipse_collections_api",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_grammar",
        "@maven_upstream//:org_finos_legend_pure_legend_pure_m3_core",
        "@maven_test//:org_junit_jupiter_junit_jupiter_api",
        "@maven_test//:org_junit_jupiter_junit_jupiter_params",
    ],
    runtime_deps = [
        "@maven_upstream//:org_finos_legend_engine_legend_engine_extensions_collection_generation",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_diagram_grammar",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_athena_grammar",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_aurora_grammar",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_duckdb_grammar",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_grammar",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_memsql_grammar",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_xt_relationalStore_oracle_grammar",
    ],
)

# What the parity tests read besides the upstream trees: committed ledgers in docs/,
# the pins file, and — for the own-corpus censuses, which harvest the Pure snippets
# every module's tests embed — the other modules' sources.
# THE ENGINE JARS the protocol roster, PMCD reachability and grammar coverage read
# (every jar :pe_tests_lib runs with), DECLARED: the BUILD says which jars, a
# program never re-derives them from its class path (tools/jars/defs.bzl). The
# tests take runfiles paths; the roster generator action takes execroot paths and
# the jars themselves as inputs.
java_jars(
    name = "engine_jars",
    testonly = True,
    deps = [":pe_tests_lib"],
)

java_jars(
    name = "engine_jars_exec",
    testonly = True,
    exec_paths = True,
    deps = [":pe_tests_lib"],
)

filegroup(
    name = "engine_jar_files",
    testonly = True,
    srcs = [":engine_jars_exec"],
    output_group = "jars",
)

_ENGINE_JARS_FLAG = "-Dlegend.engine.jars=$(rootpath :engine_jars)"

_INPUTS = [
    ":srcs",
    "//core:srcs",
    "//docs:ledgers",
    "//pct:srcs",
    "//spec:srcs",
    "//tools:oracle-pins.env",
]

# The measurement battery (tools/diagnostics.sh): censuses and a benchmark, run on
# their triggers, never as part of the gate.
_DIAGNOSTICS = [
    "ParseSpeedBenchmarkTest",
    "CorpusCensusTest",
    "GrammarKeywordCensusTest",
    "PmcdReachabilityCensusTest",
    "GrammarCoverageCensusTest",
    "MigrationSizingTest",
]

# Maven gate 8: every asserting parity class. Selected by PACKAGE, so a new test is
# in the gate the moment it exists — the rename-goes-red roster tools/allgates.sh
# keeps by hand is not needed when nothing is selected by name.
junit_test(
    name = "parser_parity",
    data = _INPUTS + [":engine_jars"],
    jvm_flags = [_ENGINE_JARS_FLAG],
    exclude_tags = [],
    runtime_deps = [":pe_tests_lib"],
    select = ["--select-package=com.legend.equivalence"] + [
        "--exclude-classname=.*\\." + c for c in _DIAGNOSTICS
    ],
    upstream = True,
)

junit_test(
    name = "diagnostics",
    data = _INPUTS + [":engine_jars"],
    jvm_flags = [_ENGINE_JARS_FLAG],
    runtime_deps = [":pe_tests_lib"],
    select = ["--select-class=com.legend.equivalence." + c for c in _DIAGNOSTICS + ["ProtocolRosterCensusTest"]],
    tags = ["manual"],
    upstream = True,
)

# ── THE GENERATORS ──────────────────────────────────────────────────────────────
# Programs run as build actions over declared inputs; //parser-equivalence:
# update_generated writes their outputs into the checkout and diff-tests them.
# The corpus machinery they share finds files through Repo, which a build action
# points at its own inputs (-Dlegend.repo.root: the action's working directory,
# where declared inputs sit at their repository paths).
# THE FIXTURE HARVEST's classpath: the shims first (:pe_tests_lib), then the
# engine's grammar and compiler tests-jars (grammar before compiler — the order
# the snapshot's dedup is minted in) and json-unit. QUARANTINED: nothing else
# depends on these jars, whose test-scoped registrations would alter the oracle.
java_library(
    name = "harvest_lib",
    testonly = True,
    runtime_deps = [
        ":pe_tests_lib",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_grammar_tests",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_compiler_tests",
        "@maven_upstream//:net_javacrumbs_json_unit_json_unit",
    ],
)

# the two tests-jars the harvest enumerates, grammar before compiler, DECLARED
java_jars(
    name = "harvest_tests_jars",
    testonly = True,
    exec_paths = True,
    transitive = False,
    deps = [
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_grammar_tests",
        "@maven_upstream//:org_finos_legend_engine_legend_engine_language_pure_compiler_tests",
    ],
)

filegroup(
    name = "harvest_tests_jar_files",
    testonly = True,
    srcs = [":harvest_tests_jars"],
    output_group = "jars",
)

java_binary(
    name = "harvest_generator",
    testonly = True,
    main_class = "com.legend.equivalence.harvest.FixtureHarvestGenerator",
    runtime_deps = [":harvest_lib"],
)

# engine-grammar-fixtures.jsonl: corpus tier C6, harvested from the pinned release
genrule(
    name = "gen_fixtures",
    testonly = True,
    srcs = UPSTREAM_TREES + [
        ":harvest_tests_jar_files",
        ":harvest_tests_jars",
        "//tools:oracle-pins.env",
    ],
    outs = ["generated/engine-grammar-fixtures.jsonl"],
    cmd = " ".join(["$(location :harvest_generator)"] + program_flags("parser-equivalence", pure = False) + [
        "--jvm_flag=-Dlegend.harvest.jars=$(execpath :harvest_tests_jars)",
        "$@",
    ]),
    tools = [":harvest_generator"],
)

java_binary(
    name = "manifest_generator",
    testonly = True,
    main_class = "com.legend.equivalence.ManifestGenerator",
    runtime_deps = [":pe_tests_lib"],
)

java_binary(
    name = "roster_generator",
    testonly = True,
    main_class = "com.legend.equivalence.RosterGenerator",
    runtime_deps = [":pe_tests_lib"],
)

# the corpus's two consumers of the fixture snapshot read the harvest's OUTPUT, so
# a bump regenerates them from the new snapshot, never the committed one
_NEW_FIXTURES = "--jvm_flag=-Dlegend.engine.fixtures=$(location :gen_fixtures)"

# corpus-manifest.tsv: the corpus as data — every distinct source, hashed
genrule(
    name = "gen_manifest",
    testonly = True,
    srcs = UPSTREAM_TREES + [
        ":gen_fixtures",
        "//tools:oracle-pins.env",
    ],
    outs = ["generated/corpus-manifest.tsv"],
    cmd = " ".join(["$(location :manifest_generator)"] + program_flags("parser-equivalence") +
                   [_NEW_FIXTURES, "$@"]),
    tools = [":manifest_generator"],
)

# docs/protocol-roster.tsv: every protocol subtype tag, COVERED or UNCOVERED by
# the corpus, the fixtures and our own test snippets (core/spec/pct test trees)
genrule(
    name = "gen_roster",
    testonly = True,
    srcs = UPSTREAM_TREES + [
        ":engine_jar_files",
        ":engine_jars_exec",
        ":gen_fixtures",
        "//core:srcs",
        "//pct:srcs",
        "//spec:srcs",
        "//tools:oracle-pins.env",
    ],
    outs = ["generated/protocol-roster.tsv"],
    cmd = " ".join(["$(location :roster_generator)"] + program_flags("parser-equivalence") + [
        _NEW_FIXTURES,
        "--jvm_flag=-Dlegend.engine.jars=$(execpath :engine_jars_exec)",
        "$@",
    ]),
    tools = [":roster_generator"],
    visibility = ["//docs:__pkg__"],
)

# GENERATED FILES in this package: `bazel run //:update_generated` writes them;
# `bazel test` fails when a committed copy differs, naming the command.
write_source_files(
    name = "update_generated",
    testonly = True,
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nThis file is generated from the pinned upstream release — regenerate: bazel run //:update_generated",
    files = {
        "src/test/resources/corpus-manifest.tsv": ":gen_manifest",
        "src/test/resources/engine-grammar-fixtures.jsonl": ":gen_fixtures",
    },
    visibility = ["//visibility:public"],
)

java_binary(
    name = "own_corpus_ledger_draft",
    testonly = True,
    main_class = "com.legend.equivalence.OwnCorpusLedgerDraft",
    runtime_deps = [":pe_tests_lib"],
)

# a DRAFT of docs/own-corpus-protocol-diffs.tsv (//docs:draft_own_corpus_ledger):
# current diffs, reasons kept, new rows marked for a human
genrule(
    name = "gen_own_corpus_draft",
    testonly = True,
    srcs = UPSTREAM_TREES + [
        "//core:srcs",
        "//docs:own-corpus-protocol-diffs.tsv",
        "//pct:srcs",
        "//spec:srcs",
        "//tools:oracle-pins.env",
    ],
    outs = ["generated/own-corpus-protocol-diffs.tsv"],
    cmd = " ".join(["$(location :own_corpus_ledger_draft)"] + program_flags("parser-equivalence") +
                   ["$(location //docs:own-corpus-protocol-diffs.tsv)", "$@"]),
    tools = [":own_corpus_ledger_draft"],
    visibility = ["//docs:__pkg__"],
)

