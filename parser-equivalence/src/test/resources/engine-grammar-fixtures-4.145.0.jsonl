n      addressName: $src.addressName\n   }\n   test::Firm_Person: XStore {\n      employer[p, f]: $this.firmName == $that.name\n   }\n\n)\n\n","kind":"compile","origin":"org.finos.legend.engine.language.pure.compiler.test.fromGrammar.TestMappingCompilationFromGrammar#testCrossStoreMultiMappingWithLocalProperties"}
