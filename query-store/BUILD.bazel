# The query store (README.md): upstream's saved-query records, ONE typed client over a fetch, and the
# same /api/pure/v1/query answered in the page from IndexedDB. Plain TypeScript with no npm
# dependency, for every app here that saves or opens queries (Query writes, DataCube reads).
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//tools/js:defs.bzl", "node_test")
load("//tools/runfiles:defs.bzl", "executable_of")
load("//tools/guards:defs.bzl", "guards_package")
load("//tools/java:defs.bzl", "legend_java_library")
load("//tools/teavm:defs.bzl", "teavm_wasm")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

# THE SAVED QUERIES IN THE PAGE (docs/ONE_PLATFORM_PROGRAM_2026_10_12.md B5): core's rules (//core:saved_queries,
# the ones legend-lite's server and Python's native library answer with) compiled to WebAssembly, the page's records
# handed in with each call (java/.../QueriesPage.java), which src/wasm-server.ts writes back to IndexedDB.
legend_java_library(
    name = "page_entry",
    srcs = ["java/com/legend/queries/page/QueriesPage.java"],
    deps = [
        "//core:saved_queries",
        "//json",
        # TeaVM's annotations, at compile time only
        "//tools/teavm:api",
    ],
)

teavm_wasm(
    name = "page",
    main_class = "com.legend.queries.page.QueriesPage",
    visibility = [
        "//datacube:__pkg__",
        "//query:__pkg__",
    ],
    deps = [
        ":page_entry",
        "@maven_teavm//:org_teavm_teavm_classlib",
        "@maven_teavm//:org_teavm_teavm_jso",
    ],
)

js_library(
    name = "query_store",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    visibility = ["//visibility:public"],
)

# The page's module as ONE directory (classes.wasm beside its runtime), so a test names it with one $(rlocationpath)
# (as //sdlc-server:page_dir): this package's and DataCube's saved pages' (the same module, B6)
copy_to_directory(
    name = "page_dir",
    srcs = [":page"],
    root_paths = ["query-store/page"],
    visibility = ["//datacube:__pkg__"],
)

# The one suite against the page's own store: legend-lite's rules in WebAssembly over the page's records.
node_test(
    name = "wasm_test",
    # medium: it loads the page's module (WebAssembly), as sdlc-client's wasm_test does
    size = "medium",
    data = [
        ":page_dir",
        ":query_store",
        "test/conformance.ts",
        "test/wasm.test.ts",
    ],
    entry_point = "test/wasm.test.ts",
    env = {"QUERIES_PAGE": "$(rlocationpath :page_dir)"},
    node_options = ["--experimental-wasm-exnref"],  # the flag only: this test loads the page's module, not the planner
)

# A saved query's share link, round trip over the shared fixture records.
node_test(
    name = "share_test",
    size = "small",
    data = [
        ":query_store",
        "test/share.test.ts",
        "//fixtures/saved-queries:records",
    ],
    entry_point = "test/share.test.ts",
    env = {"SAVED_QUERIES": "$(rlocationpaths //fixtures/saved-queries:records)"},
)

# The same suite against legend-lite's server, started here with a fresh store.
node_test(
    name = "lite_test",
    # starts a JVM server: past `small`'s 60 s on a loaded runner (Bazel workplan P3-16)
    size = "medium",
    data = [
        ":query_store",
        "test/conformance.ts",
        "test/lite.test.ts",
        # the server started for the file (test/lite-server.ts, with the server's runfiles); its launcher named here,
        # as $(rlocationpath) needs it
        ":lite_server",
        ":legend_server",
    ],
    entry_point = "test/lite.test.ts",
    env = {"LEGEND_SERVER": "$(rlocationpath :legend_server)"},
)

# The one suite, one target: the page's module, legend-lite's server and Python's saved queries (the native library's,
# from DataCube's test: docs/ONE_PLATFORM_PROGRAM_2026_10_12.md B5) are each held to it the same way
js_library(
    name = "conformance",
    testonly = True,
    srcs = ["test/conformance.ts"],
    visibility = ["//datacube:__pkg__"],
    deps = [":query_store"],
)

# legend-lite's server started for a test file (test/lite-server.ts): lite_test's, and DataCube's saved pages' suite on
# the server (docs/ONE_PLATFORM_PROGRAM_2026_10_12.md B6). It brings the server with it (its launcher and the server's
# runfiles); a test names the launcher, LEGEND_SERVER, by :legend_server.
js_library(
    name = "lite_server",
    testonly = True,
    srcs = ["test/lite-server.ts"],
    data = [
        ":legend_server",
        "//core:server",
    ],
    visibility = ["//datacube:__pkg__"],
)

# Every TypeScript file here, for the apps' typechecks (strict tsc: no npm dependency of its own).
js_library(
    name = "typescript_sources",
    srcs = glob(["src/**/*.ts", "test/**/*.ts"]) + ["package.json"],
    visibility = [
        "//datacube:__pkg__",
        "//query:__pkg__",
    ],
)

# the legend-lite server's launcher, exactly one file, for lite_test to start by runfiles path (Bazel workplan P1-24)
executable_of(
    name = "legend_server",
    testonly = True,
    binary = "//core:server",
    visibility = ["//datacube:__pkg__"],
)

# the page's query store's conformance run, which //datacube:one_api_ledger_test (L12) names as half of the proof that the two
# builds of it (the page's WebAssembly, Python's native library) answer alike, so reads it (copied to the output tree,
# where a JavaScript test reads its data: rules_js)
copy_to_bin(
    name = "wasm_test_source",
    srcs = ["test/wasm.test.ts"],
    visibility = ["//datacube:__pkg__"],
)

guards_package()
