+                // XK PROTOTYPE (scratch, never merges): a ###Relational = or != is marked by a position whose source is
+                // xk:relop, so the lowering's disjoint-kinds rule can leave it the database's comparison
+                if (cmp.op() == ComparisonOp.EQ || cmp.op() == ComparisonOp.NEQ) {
