diff --git a/core/src/main/java/com/legend/lowering/XkScope.java b/core/src/main/java/com/legend/lowering/XkScope.java
new file mode 100644
index 00000000..d2d69f60
--- /dev/null
+++ b/core/src/main/java/com/legend/lowering/XkScope.java
@@ -0,0 +1,38 @@
+// Copyright 2026 Legend Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package com.legend.lowering;
+
+import com.legend.compiler.spec.typed.TypedNativeCall;
+
+/**
+ * XK PROTOTYPE (scratch, never merges): which disjoint-kinds equalities the rule answers. A call is RELOP (a
+ * ###Relational = or !=, marked by the normalizer), PROGRAM (a call with the program's own source position) or LITE (a
+ * call lite built, no position). {@code -Dxk.scope}: all, relop (every one but RELOP; the default), program (PROGRAM
+ * only). Each distinct site is logged once: {@code [XK] <category> <applied|kept> <type>/<type> at <source>}.
+ */
+final class XkScope {
+
+    private static final String SCOPE = System.getProperty("xk.scope", "relop");
+    private static final java.util.Set<String> SEEN = java.util.concurrent.ConcurrentHashMap.newKeySet();
+
+    private XkScope() {
+    }
+
+    static boolean applies(TypedNativeCall n) {
+        com.legend.protocol.SourceInfo p = n.pos();
+        String cat = p == null ? "LITE" : "xk:relop".equals(p.sourceId()) ? "RELOP" : "PROGRAM";
+        boolean applied = switch (SCOPE) {
+            case "all" -> true;
+            case "program" -> cat.equals("PROGRAM");
+            default -> !cat.equals("RELOP");
+        };
+        String where = p == null ? "-" : p.sourceId() + ":" + p.startLine() + ":" + p.startColumn();
+        String line = "[XK] " + cat + " " + (applied ? "applied" : "kept") + " "
+                + n.args().get(0).info().type() + "/" + n.args().get(1).info().type() + " at " + where;
+        if (SEEN.add(line)) {
+            System.err.println(line);
+        }
+        return applied;
+    }
+}
