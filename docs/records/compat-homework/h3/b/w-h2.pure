###Relational
Database w::DB
(
    Schema S
    (
        Table W
        (
            id INTEGER,
            f DOUBLE,
            expected VARCHAR(400)
        )
    )
)

###Connection
RelationalDatabaseConnection w::Conn
{
    store: w::DB;
    type: H2;
    specification: LocalH2
    {
        testDataSetupSqls: [
            'DROP SCHEMA IF EXISTS S CASCADE;',
            'CREATE SCHEMA S;',
            'CREATE TABLE S.W (id INTEGER, f DOUBLE, expected VARCHAR(400));',
            'INSERT INTO S.W VALUES (1, CAST(3.14 AS DOUBLE), \'3.14\'), (2, CAST(3.14159 AS DOUBLE), \'3.14159\'), (3, CAST(17.0 AS DOUBLE), \'17.0\'), (4, CAST(0.01 AS DOUBLE), \'0.01\'), (5, CAST(134.21e6 AS DOUBLE), \'134210000.0\'), (6, CAST(1.3421e-8 AS DOUBLE), \'0.000000013421\'), (7, CAST(2.5E7 AS DOUBLE), \'25000000.0\'), (8, CAST(0.1 AS DOUBLE), \'0.1\'), (9, CAST(0.3333333333333333 AS DOUBLE), \'0.3333333333333333\'), (10, CAST(-1.5 AS DOUBLE), \'-1.5\'), (11, CAST(0.0 AS DOUBLE), \'0.0\'), (12, CAST(\'-0.0\' AS DOUBLE), \'0.0\'), (13, CAST(1e15 AS DOUBLE), \'1000000000000000.0\'), (14, CAST(1e16 AS DOUBLE), \'10000000000000000.0\'), (15, CAST(1e17 AS DOUBLE), \'100000000000000000.0\'), (16, CAST(1.0E20 AS DOUBLE), \'100000000000000000000.0\'), (17, CAST(1e22 AS DOUBLE), \'10000000000000000000000.0\'), (18, CAST(1.0E-5 AS DOUBLE), \'0.00001\'), (19, CAST(1e-7 AS DOUBLE), \'0.0000001\'), (20, CAST(1e-17 AS DOUBLE), \'0.00000000000000001\'), (21, CAST(1e-20 AS DOUBLE), \'0.00000000000000000001\'), (22, CAST(123456789.123 AS DOUBLE), \'123456789.123\'), (23, CAST(9007199254740993 AS DOUBLE), \'9007199254740992.0\'), (24, CAST(0.1e-3 AS DOUBLE), \'0.0001\'), (25, CAST(1.7976931348623157E308 AS DOUBLE), \'.0\'), (26, CAST(4.9E-324 AS DOUBLE), \'0.\');'
        ];
    };
    auth: DefaultH2;
}

###Runtime
Runtime w::RT
{
    mappings: [];
    connections:
    [
        w::DB: [ c1: w::Conn ]
    ];
}
