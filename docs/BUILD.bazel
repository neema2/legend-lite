load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//tools/guards:defs.bzl", "guards_package")

# docs/ is prose, except for the committed LEDGERS some tests compare against (the protocol roster, the refusal
# allowlists, the skew claims, ...). Each is a label of its own, and a test names the ones it reads, each by
# $(rlocationpath) (parser-equivalence's _LEDGERS): no blanket filegroup, so no test carries a ledger it never
# reads (Bazel workplan P2-18). The other TSVs here are frozen snapshots or measurements no build reads.
exports_files(glob(["*.tsv"]))

# THE ONE API PLAN's register (§4), which //datacube:one_api_ledger_test holds every ledger to (copied to the output
# tree, where a JavaScript test reads its data: rules_js)
copy_to_bin(
    name = "one_api_plan",
    srcs = ["DATACUBE_ONE_API_PLAN_2026_10_21.md"],
    visibility = ["//datacube:__pkg__"],
)

# GENERATED ledgers in docs/ (see //:update_generated)
write_source_files(
    name = "update_generated",
    testonly = True,
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nThis file is generated from the pinned upstream release — regenerate: bazel run //:update_generated",
    files = {
        # the engine's dynafunction registries, dialect by dialect: reference data (the dialect program's D10, 2026-10-18)
        "engine-dynafunctions.tsv": "//spec:gen_engine_dynafunctions",
        "protocol-roster.tsv": "//parser-equivalence:gen_roster",
    },
    visibility = ["//visibility:public"],
)

# THE CAPABILITY MATRIX (//core:capability_matrix): what every dialect does with every function and aggregate,
# generated from the dialects' own sources. Its measured reach (reach.tsv, //core:capability_reach) is its input.
exports_files(
    ["dialect-capability/reach.tsv"],
    visibility = ["//core:__pkg__"],
)

# The matrix as data: every row of its pages, diff-tested (a dialect's table moved and the matrix was not
# regenerated). Writing it writes the pages too.
write_source_files(
    name = "update_dialect_capability",
    testonly = True,
    additional_update_targets = [":update_dialect_capability_pages"],
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nThe capability matrix is generated from the dialects' own tables -- a dialect's table moved: regenerate with bazel run //docs:update_dialect_capability, and read the diff",
    files = {"dialect-capability/matrix.tsv": "//core:dialect-capability/matrix.tsv"},
    visibility = ["//visibility:public"],
)

# The matrix's pages, made from the same rows as matrix.tsv and written with it. No diff test of their own: prose is
# never a test input (G17, //tools/guards:markdown_inputs_test), and the data's test covers every row they hold.
write_source_files(
    name = "update_dialect_capability_pages",
    testonly = True,
    diff_test = False,
    files = {
        "dialect-capability/%s.md" % f: "//core:dialect-capability/%s.md" % f
        for f in [
            "README",
            "functions",
            "aggregates",
        ]
    },
)

# NOT a generated file: the own-corpus protocol ledger's reasons are written by a
# person. This writes a DRAFT (current diffs, surviving reasons kept, new rows
# "TODO: adjudicate") for that person to finish; OwnCorpusParityTest is the check.
# Deliberately outside //:update_generated, and with no diff test of its own. (Exported with
# every ledger, above.)

write_source_files(
    name = "draft_own_corpus_ledger",
    testonly = True,
    diff_test = False,
    files = {
        "own-corpus-protocol-diffs.tsv": "//parser-equivalence:gen_own_corpus_draft",
    },
    tags = ["manual"],
)

guards_package()
