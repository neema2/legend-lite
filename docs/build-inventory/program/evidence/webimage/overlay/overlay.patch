+            case com.legend.protocol.TypeExpression.Generic g -> g.name() + "<"
+                    + g.arguments().stream().map(SystemMetamodel::spelling)
+                            .collect(java.util.stream.Collectors.joining(",")) + ">";
+            default -> String.valueOf(t);
+        };
+    }
